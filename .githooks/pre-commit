#!/usr/bin/env bash
# Pre-commit: the guarded files on every commit (ticket 322: an expected value of the gold Builds or a held user fact
# changes only with a `User approved:` line in the ticket's file), with the guard's own test when it changes; then fmt
# and clippy, only when the commit touches Rust or its build files. Those check the working tree, not just what's
# staged. Enabled per clone with `git config core.hooksPath .githooks`; `git commit --no-verify` skips it.
set -euo pipefail

scripts/guarded-files.sh
# Not `grep -q`: it can stop reading early, and `pipefail` would take git's SIGPIPE for no match.
if git diff --cached --name-only | grep '^scripts/guarded-files' >/dev/null; then
    scripts/guarded-files-test.sh >/dev/null
fi

if ! git diff --cached --name-only | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|^rustfmt\.toml$|^rust-toolchain\.toml$'; then
    exit 0
fi
cargo fmt --all --check || {
    echo "pre-commit: run cargo fmt --all" >&2
    exit 1
}
# A test file no `main.rs` declares never compiles.
scripts/test-modules.sh
# Not `-q`: cargo's progress shows why a commit is slow, if one is. Warm, this takes about a second and prints one
# "Finished" line; a slow run shows its "Compiling …" lines, or "Blocking waiting for file lock" while another cargo
# (a running `cargo leptos watch`, say) holds the build directory.
cargo clippy --workspace --all-targets -- -D warnings
