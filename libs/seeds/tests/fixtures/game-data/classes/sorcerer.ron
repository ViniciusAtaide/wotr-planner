// Hand-written test fixture: small and simplified, not checked against the guide. Every shape of an option with
// rows by option level (tickets 30, 31, 33 and 35).
Class(
    key: "sorcerer",
    name: "Sorcerer",
    guide: "sorcerer",
    skill_points: 2,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    spontaneous: true,
    class_skills: ["knowledge-arcana"],
    features: [
        (key: "sorcerer/bloodline/abyssal/claws", name: "Claws", guide: "character-creation#grow-claws-abyssal"),
        (
            key: "sorcerer/bloodline/abyssal/strength-of-the-abyss",
            name: "Strength of the Abyss",
            guide: "character-creation#strength-of-the-abyss",
            ability_bonuses: [Fixed(ability: Strength, amount: 2)],
        ),
        (key: "sorcerer/bloodline/draconic/arcana", name: "Draconic Arcana", guide: "character-creation#draconic-bloodline-arcana"),
        (key: "sorcerer/bloodline/draconic/claws", name: "Claws", guide: "character-creation#grow-claws-draconic"),
        (
            key: "sorcerer/bloodline-ascendance",
            name: "Bloodline Ascendance",
            guide: "mythic-paths#bloodline-ascendance",
            option_row: (selection: "sorcerer/bloodline", level: 3),
        ),
        (key: "sorcerer/mixed-bloodline", name: "Mixed Bloodline", guide: "bloodrager#mixed-bloodline", daily_choice: true),
    ],
    selections: [
        (
            key: "sorcerer/bloodline",
            name: "Bloodline",
            guide: "character-creation#bloodlines",
            option_levels: ["fighter", "sorcerer"],
            options: [
                (
                    key: "sorcerer/bloodline/abyssal",
                    name: "Abyssal",
                    guide: "sorcerer#abyssal",
                    pool: "sorcerer/abyssal-powers",
                    levels: [
                        (level: 1, features: ["sorcerer/bloodline/abyssal/claws"], feat_list: "sorcerer/bloodline/abyssal-feats", class_skills: ["athletics"]),
                        (level: 3, features: ["sorcerer/bloodline/abyssal/strength-of-the-abyss"], feats: ["toughness"], selections: ["sorcerer/school"]),
                    ],
                ),
                (
                    key: "sorcerer/bloodline/draconic-red",
                    name: "Draconic (Red)",
                    guide: "sorcerer#draconic",
                    prerequisite: All([NoOptionFrom("sorcerer/bloodline"), NoOtherOptionOfGroup(Draconic)]),
                    group: Draconic,
                    arcana: "sorcerer/bloodline/draconic/arcana",
                    levels: [
                        (level: 1, features: ["sorcerer/bloodline/draconic/arcana", "sorcerer/bloodline/draconic/claws"]),
                        (level: 3, feat_slots: [CombatFeat, OneOf(list: "sorcerer/bloodline/abyssal-feats")]),
                        (level: 9, class_skills: ["mobility", "persuasion"]),
                    ],
                ),
            ],
        ),
        (
            key: "sorcerer/school",
            name: "School",
            guide: "character-creation#school-power",
            level_from: GrantingOption,
            options: [
                (key: "sorcerer/school/evocation", name: "Evocation", guide: "character-creation#school-power"),
                (
                    key: "sorcerer/school/necromancy",
                    name: "Necromancy",
                    guide: "character-creation#school-power",
                    prerequisite: Any([Not(PickedThrough("sorcerer/school")), Alignment(NeutralEvil)]),
                ),
            ],
        ),
        (
            key: "sorcerer/abyssal-powers",
            name: "Abyssal Powers",
            guide: "sorcerer#abyssal",
            level_from: OtherOptions,
            // Ticket 35: an option held elsewhere counts beside the other options (a Living Deity's way).
            level_also_from: "sorcerer/seeker/choice/power",
            options: [
                (key: "sorcerer/abyssal-powers/rage", name: "Rage", guide: "sorcerer#abyssal"),
                (key: "sorcerer/abyssal-powers/fear", name: "Fear", guide: "sorcerer#abyssal"),
                (
                    key: "sorcerer/abyssal-powers/mastery",
                    name: "Mastery",
                    guide: "sorcerer#abyssal",
                    chosen_feat: "weapon-focus",
                    levels: [(level: 3, chosen_feats: ["weapon-specialization"], feats: ["toughness"])],
                ),
            ],
        ),
        (
            key: "sorcerer/power",
            name: "Power",
            guide: "sorcerer",
            pool_of: "sorcerer/bloodline",
            option_levels: ["sorcerer"],
            options: [(key: "sorcerer/power/surge", name: "Surge", guide: "sorcerer")],
