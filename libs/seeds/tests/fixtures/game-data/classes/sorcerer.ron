                (
                    key: "sorcerer/seeker/second-bloodline",
                    name: "Second Bloodline (Seeker)",
                    guide: "sorcerer#crossblooded",
                    shared_options: ["sorcerer/bloodline/abyssal"],
                    option_levels: ["sorcerer"],
                    feat_lists_only: true,
