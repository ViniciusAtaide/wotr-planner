// Hand-written test fixture: small and simplified, not checked against the guide.
Class(
    key: "monk",
    name: "Monk",
    summary: "Unarmed martial class whose bonus feats come from its own list.",
    guide: "monk",
    skill_points: 4,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Good,
    will: Good,
    class_skills: ["mobility", "athletics"],
    feat_lists: [
        (key: "monk/bonus-feats", name: "Monk Bonus Feats", guide: "monk#monk-bonus-feats", ignores_prerequisites: true, feats: ["crane-style", "dodge"]),
    ],
    levels: [
        // A granted feat, held with no pick whatever its prerequisites; and a bonus-list slot: Crane Style is on
        // the monk's list, so a monk can take it without Dodge.
        (level: 1, feats: ["improved-unarmed-strike"], feat_slots: [OneOf(list: "monk/bonus-feats")]),
        (level: 2, feat_slots: [OneOf(list: "monk/bonus-feats")]),
        (level: 3),
    ],
)
