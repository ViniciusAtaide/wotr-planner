// Hand-written test fixture: small and simplified, not checked against the guide.
[
    (
        key: "power-attack",
        name: "Power Attack",
        category: Weapon,
        summary: "Trade attack bonus for damage.",
        guide: "feats#power-attack",
        prerequisite: AbilityScore(ability: Strength, score: 13),
    ),
    (
        key: "combat-expertise",
        name: "Combat Expertise",
        category: CombatManoeuvres,
        guide: "feats#combat-expertise",
        prerequisite: AbilityScore(ability: Intelligence, score: 13),
    ),
    (
        key: "two-weapon-fighting",
        name: "Two-Weapon Fighting",
        category: Weapon,
        guide: "feats#two-weapon-fighting",
        prerequisite: AbilityScore(ability: Dexterity, score: 15),
    ),
    (
        key: "improved-two-weapon-fighting",
        name: "Improved Two-Weapon Fighting",
        category: Weapon,
        guide: "feats#improved-two-weapon-fighting",
        prerequisite: All([
            AbilityScore(ability: Dexterity, score: 17),
            Feat("two-weapon-fighting"),
            BaseAttackBonus(6),
        ]),
    ),
    (
        key: "cornugon-smash",
        name: "Cornugon Smash",
        category: Weapon,
        guide: "feats#cornugon-smash",
        prerequisite: All([
            Feat("power-attack"),
            SkillRanks(skill: "persuasion", ranks: 6),
        ]),
    ),
    (
        // "Combat Expertise or Kinetic Warrior + Intelligence 13", read as A or (B and C).
        key: "dirty-trick",
        name: "Dirty Trick",
        category: CombatManoeuvres,
        guide: "feats#dirty-trick",
        prerequisite: Any([
            Feat("combat-expertise"),
            All([
                Feature(feature: "rogue/sneak-attack", count: 1),
                AbilityScore(ability: Intelligence, score: 13),
            ]),
        ]),
    ),
    (
        // "Two of: ..." plus a class level, with a nested choice.
        key: "critical-mastery",
        name: "Critical Mastery",
        category: Weapon,
        guide: "feats#critical-mastery",
        prerequisite: All([
            AtLeast(2, [
                Feat("power-attack"),
                Feat("dirty-trick"),
                Any([
                    Feat("cornugon-smash"),
                    ClassLevel(class: "rogue", level: 3),
                ]),
            ]),
            ClassLevel(class: "fighter", level: 2),
        ]),
    ),
    (
        key: "breadth-of-experience",
        name: "Breadth of Experience",
        category: Skill,
        guide: "feats#breadth-of-experience",
        prerequisite: All([
            Any([Race("elf"), Race("dwarf")]),
            CharacterLevel(2),
        ]),
    ),
    (
        key: "arcane-strike",
        name: "Arcane Strike",
        category: Magic,
        guide: "feats#arcane-strike",
        prerequisite: SpellLevel(spell_type: Arcane, level: 1),
    ),
    (
        key: "outflank",
        name: "Outflank",
        category: Teamwork,
        guide: "feats#outflank",
        prerequisite: All([BaseAttackBonus(4), CasterLevel(1), Alignment(LawfulGood)]),
    ),
    (
        key: "armiger-drill",
        name: "Armiger Drill",
        category: Class,
        guide: "feats#armiger-drill",
        prerequisite: Archetype("fighter/armiger"),
    ),
    (
        key: "toughness",
        name: "Toughness",
        category: Miscellaneous,
        guide: "feats#toughness",
    ),
    (
        key: "dodge",
        name: "Dodge",
        category: Miscellaneous,
        guide: "feats#dodge",
        prerequisite: AbilityScore(ability: Dexterity, score: 13),
    ),
    (
        // Simplified: the game's Crane Style also needs Improved Unarmed Strike.
        key: "crane-style",
        name: "Crane Style",
        category: UnarmedCombat,
        guide: "feats#crane-style",
        prerequisite: Feat("dodge"),
    ),
    (
        // The monk grants it at level 1, so a monk without Dexterity 13 holds it anyway.
        key: "improved-unarmed-strike",
        name: "Improved Unarmed Strike",
        category: UnarmedCombat,
        guide: "feats#improved-unarmed-strike",
        prerequisite: AbilityScore(ability: Dexterity, score: 13),
    ),
    (
        key: "crane-wing",
        name: "Crane Wing",
        category: UnarmedCombat,
        guide: "feats#crane-wing",
        prerequisite: All([Feat("crane-style"), Feat("dodge")]),
    ),
    (
        // Taken for a weapon, once per weapon.
        key: "weapon-focus",
        name: "Weapon Focus",
        category: Weapon,
        guide: "feats#weapon-focus",
        parameter: Weapon,
        repeat: PerValue,
        prerequisite: BaseAttackBonus(1),
    ),
    (
        // "Choose a single weapon for which you have already selected Weapon Focus."
        key: "weapon-specialization",
        name: "Weapon Specialization",
        category: Weapon,
        guide: "feats#weapon-specialization",
        parameter: Weapon,
        repeat: PerValue,
        prerequisite: All([FeatForSameValue("weapon-focus"), ClassLevel(class: "fighter", level: 4)]),
    ),
    (
        key: "aldori-dueling-mastery",
        name: "Aldori Dueling Mastery",
        category: Weapon,
        guide: "feats#aldori-dueling-mastery",
        prerequisite: FeatFor(feat: "weapon-focus", value: Weapon("dueling-sword")),
    ),
    (
        key: "exotic-weapon-proficiency",
        name: "Exotic Weapon Proficiency",
        category: Weapon,
        guide: "feats#exotic-weapon-proficiency",
        parameter: ExoticWeapon,
        prerequisite: BaseAttackBonus(1),
    ),
    (
        key: "skill-focus",
        name: "Skill Focus",
        category: Skill,
        guide: "feats#skill-focus",
        parameter: Skill,
        repeat: PerValue,
    ),
    (
        key: "acrobatic-spellcaster",
        name: "Acrobatic Spellcaster",
        category: Magic,
        guide: "feats#acrobatic-spellcaster",
        prerequisite: FeatFor(feat: "skill-focus", value: Skill("mobility")),
    ),
    (
        // Taken once: the value is a school.
        key: "spell-focus",
        name: "Spell Focus",
        category: Magic,
        guide: "feats#spell-focus",
        parameter: SpellSchool,
    ),
    (
        key: "augment-summoning",
        name: "Augment Summoning",
        category: Magic,
        guide: "feats#augment-summoning",
        prerequisite: FeatFor(feat: "spell-focus", value: SpellSchool(Conjuration)),
    ),
    (
        key: "elemental-focus",
        name: "Elemental Focus",
        category: Magic,
        guide: "feats#elemental-focus",
        parameter: Energy,
    ),
    (
        key: "greater-elemental-focus",
        name: "Greater Elemental Focus",
        category: Magic,
        guide: "feats#greater-elemental-focus",
        parameter: Energy,
        prerequisite: FeatForSameValue("elemental-focus"),
    ),
    (
        key: "armor-focus",
        name: "Armor Focus",
        category: ArmourAndShield,
        guide: "feats#armor-focus",
        parameter: ArmourType,
        repeat: PerValue,
        // Ticket 32: the proficiency of the armour type the pick names.
        prerequisite: All([
            FeatIfValue(value: ArmourType(Light), feat: "dodge"),
            FeatIfValue(value: ArmourType(Heavy), feat: "toughness"),
        ]),
    ),
    (
        key: "extra-rage",
        name: "Extra Rage",
        category: Class,
        guide: "feats#extra-rage",
        repeat: Times(3),
    ),
    (
        key: "extra-ki",
        name: "Extra Ki",
        category: Class,
        guide: "feats#extra-ki",
        repeat: Unlimited,
    ),
]
