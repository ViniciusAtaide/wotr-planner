(key: "shifters-edge", blueprint: "0e7ec9a341ca46fcaf4d49759e047c83", name: "Shifter\'s Edge", summary: "Adds half your class level to damage on attacks that use Dex to hit but not Dex for damage; can't be combined with Mythic Finesse.", category: Class, guide: "feats#shifters-edge", prerequisite: All([Any([Feature(feature: "shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter-claws-1d10", count: 1), Feature(feature: "shifter-claws-1d6", count: 1), Feature(feature: "shifter-claws-1d8", count: 1), Feature(feature: "shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/shifter-claws", count: 1)]), Feat("weapon-finesse"), AbilityScore(ability: Dexterity, score: 13)]))
