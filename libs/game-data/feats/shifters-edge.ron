(key: "shifters-edge", blueprint: "0e7ec9a341ca46fcaf4d49759e047c83", name: "Shifter\'s Edge", summary: "Adds half your class level to damage on attacks that use Dex to hit but not Dex for damage; can't be combined with Mythic Finesse.", category: Class, guide: "feats#shifters-edge", components: [Requires(condition: Has(Feature("shifter-claws-1-crit-multiplier")), group: Any), Requires(condition: Has(Feature("shifter-claws-1d10")), group: Any), Requires(condition: Has(Feature("shifter-claws-1d6")), group: Any), Requires(condition: Has(Feature("shifter-claws-1d8")), group: Any), Requires(condition: Has(Feature("shifter-claws-adamantine-and-universal")), group: Any), Requires(condition: Has(Feature("shifter-claws-cold-iron-magic-and-silver")), group: Any), Requires(condition: Has(Feature("shifter/shifter-claws")), group: Any), Requires(condition: Has(Feat("weapon-finesse"))), Requires(condition: Stat(stat: Ability(Dexterity), value: 13))])
