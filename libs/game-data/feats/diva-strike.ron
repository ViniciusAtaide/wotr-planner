(key: "diva-strike", blueprint: "3306f4c6913d4d429358b907cdb4ffd1", name: "Diva Strike", summary: "Once a round in Diva Style, a foe denied its Dex bonus takes your Cha modifier as extra precision damage.", category: Class, guide: "feats#diva-strike", components: [Requires(condition: Has(Feat("combat-expertise"))), Requires(condition: Has(Feat("diva-style"))), Requires(condition: Has(Feat("feint"))), Requires(condition: ClassLevel("bard", 7)), Requires(condition: Stat(stat: Ability(Charisma), value: 15))])
