(key: "raging-brutality", blueprint: "c002fad1506842abb2da5bcedacc358e", name: "Raging Brutality", summary: "While raging with Power Attack, a swift action adds your Con bonus (1.5x two-handed) to melee and thrown damage that turn, not on crits.", category: Class, guide: "feats#raging-brutality", components: [Requires(condition: Stat(stat: Ability(Strength), value: 13)), Requires(condition: Has(Feat("power-attack"))), Requires(condition: Stat(stat: BaseAttack, value: 12)), Requires(condition: AtLeast(1, [Feature("barbarian/instinctual-warrior/focused-rage"), Feature("barbarian/rage"), Feature("demon/demonic-rage"), Feature("shifter/rageshaper/devastating-form"), Feature("skald/inspired-rage")]))])
