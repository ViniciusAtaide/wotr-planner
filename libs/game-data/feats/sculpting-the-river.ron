(key: "sculpting-the-river", blueprint: "57c3ea6b05da4226aaeeb21da04e82ea", name: "Sculpting the River", summary: "Each unarmed hit on a foe you already hurt this round gives it a stacking -1 to attack others, until it misses or your next turn.", category: UnarmedCombat, guide: "feats#sculpting-the-river", prerequisite: All([Any([ClassLevel(class: "monk", level: 6), BaseAttackBonus(6)]), Feat("dodge"), Feat("improved-unarmed-strike")]))
