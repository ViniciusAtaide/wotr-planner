(key: "critical-mastery", blueprint: "fc85925cd241dd0408ab2f4cb171b7e3", name: "Critical Mastery", summary: "Your critical hits apply two of your critical feats' effects at once.", category: Weapon, guide: "feats#critical-mastery", components: [Requires(condition: AtLeast(2, [Feat("blinding-critical"), Feat("exhausting-critical"), Feat("flaying-critical"), Feat("sickening-critical"), Feat("staggering-critical"), Feat("stunning-critical"), Feat("tiring-critical")])), Requires(condition: Has(Feat("critical-focus"))), Requires(condition: ClassLevel("fighter", 14))])
