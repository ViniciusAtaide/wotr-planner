(key: "dragon-roar", blueprint: "3fca938ad6a5b8348a8523794127c5bc", name: "Dragon Roar", summary: "One more Stunning Fist use; spend two to roar in a 15 ft cone for unarmed damage and shaken 1d4 rounds (Fort DC 10 + half level + Wis).", category: UnarmedCombat, guide: "feats#dragon-roar", components: [Requires(condition: Has(Feat("improved-unarmed-strike"))), Requires(condition: Has(Feat("dragon-style"))), Requires(condition: Any([Has(Feat("stunning-fist")), Has(Feature("monk/stunning-fist"))])), Requires(condition: Stat(stat: Ability(Strength), value: 15)), Requires(condition: Stat(stat: Skill("mobility"), value: 8))])
