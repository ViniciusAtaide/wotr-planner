(key: "extra-arcana", blueprint: "00727883edf145e2a6bce9ad176ecfd8", name: "Extra Arcana", summary: "One more magus arcana whose prerequisites you meet; up to 3 times.", category: Class, guide: "feats#extra-arcana", repeat: Times(3), selection: "magus/extra-arcana", components: [Requires(condition: All([ClassLevel("magus", 6), Has(Archetype("magus/hexcrafter"))]), group: Any), Requires(condition: Has(Option("magus/magus-arcana/arcane-accuracy")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/bane-blade-level-15")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/devoted-blade-level-12")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/dimension-strike-level-9")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/empowered-magic-level-6")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/enduring-blade-level-6")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/extended-magic")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/ghost-blade-level-9")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/hasted-assault-level-9")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/maximized-magic-level-12")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/prescient-attack-level-6")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/quickened-magic-level-15")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/reach-magic")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/wand-mastery")), group: Any), Requires(condition: Has(Option("magus/magus-arcana/wand-wielder")), group: Any)])
