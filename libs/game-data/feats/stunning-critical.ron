(key: "stunning-critical", blueprint: "7fb3023bda2f42728e76cf269f5a2fa0", name: "Stunning Critical", summary: "Your crits stun the target 1d4 rounds, or stagger it 1d4 rounds on a Fort save (DC 10 + your BAB); further crits add duration.", category: Weapon, guide: "feats#stunning-critical", prerequisite: All([Feat("critical-focus"), Feat("staggering-critical"), BaseAttackBonus(17)]))
