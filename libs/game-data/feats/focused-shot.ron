(key: "focused-shot", blueprint: "f979ed68d1e74d21962edc66f0a1d169", name: "Focused Shot", summary: "Adds Int to damage on a standard-action ranged attack at 30 ft or less; foes immune to crits or sneak attacks ignore the bonus.", category: Ranged, guide: "feats#focused-shot", components: [Requires(condition: Has(Feat("point-blank-shot"))), Requires(condition: Has(Feat("precise-shot"))), Requires(condition: Stat(stat: Ability(Intelligence), value: 13))])
