(key: "frightful-shape", blueprint: "8e8a34c754d649aa9286fe8ee5cc3f10", name: "Frightful Shape", summary: "Attacking while shifted shakes foes within 30 ft with fewer HD than you for rounds equal to level (Will negates); 4 HD or less are frightened.", category: Class, guide: "feats#frightful-shape", components: [Requires(condition: Any([Has(Feature("wild-shape-wolf")), Has(Feature("warpriest/feral-champion/wild-shape-wolf"))]), group: Any), Requires(condition: Has(Feature("major-form")), group: Any), Requires(condition: Stat(stat: Ability(Wisdom), value: 19))])
