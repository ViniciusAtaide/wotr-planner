(key: "trip", blueprint: "0f15c6f70d8fb2b49aa6cc24239cc5fa", name: "Trip", summary: "Instead of a melee attack, knock a foe prone (harder per extra leg; not fliers or legless); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#trip", components: [Requires(condition: All([Has(Feature("kineticist/kinetic-knight/kinetic-warrior")), Stat(stat: Ability(Intelligence), value: 13)]), group: Any), Requires(condition: Has(Feat("combat-expertise")), group: Any)])
