            (key: "aasimar/plumekith", name: "Aasimar (Plumekith)", summary: "Resist acid, cold and electricity 5 and +2 vs blinding and dazzling; +2 Athletics and Mobility; Invisibility once a day.", guide: "character-creation#aasimar-plumekith", ability_modifiers: [Fixed(ability: Dexterity, amount: 2), Fixed(ability: Wisdom, amount: 2)]),
