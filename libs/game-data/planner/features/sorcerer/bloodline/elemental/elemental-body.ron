(
    why: "The game has one blueprint per dragon colour, element, energy, form or bloodline, none of them primary; the planner holds one entry for whichever is held.",
    entry: (key: "sorcerer/bloodline/elemental/elemental-body", name: "Elemental Body", summary: "At 20th level, you become immune to your bloodline's element, to critical hits and to sneak attacks.", guide: "character-creation#elemental-body"),
