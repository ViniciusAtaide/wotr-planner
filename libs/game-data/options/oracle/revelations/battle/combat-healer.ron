(key: "oracle/revelations/battle/combat-healer", blueprint: "db1d9829383e78841a6f1145411a54b4", name: "Combat Healer", summary: "From 7th level, spend two slots to cast a cure spell as a swift action; 1/day, +1 every four levels after 7th.", guide: "oracle#combat-healer", components: [Requires(condition: Any([Has(Option("oracle/mystery/battle")), Has(Option("oracle/mystery/life"))])), Requires(condition: Any([ClassLevel("arcanist", 7), ClassLevel("oracle", 7)]))], aliases: ["oracle/revelations/life/combat-healer-life"])
