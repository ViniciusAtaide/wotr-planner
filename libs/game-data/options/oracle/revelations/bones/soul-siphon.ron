(key: "oracle/revelations/bones/soul-siphon", blueprint: "226c053a75fd7c34cab1b493f5847787", name: "Soul Siphon", summary: "From 7th level, a ranged touch within 30 feet gives a negative level for Cha modifier minutes and heals you class level HP; 1/day, more later.", guide: "oracle#soul-siphon", prerequisite: All([SelectionOption("oracle/mystery/bones"), Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])]))
