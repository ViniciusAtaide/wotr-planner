(key: "sorcerer/overwhelming-mage/overwhelming-spell", blueprint: "90bc32b5e7a141c1b20e5596772115e7", name: "Overwhelming Spell", summary: "From 6th level, sacrifice a 3rd-level or higher slot to raise the DC of your next spell within 2 rounds by a third of its level.", guide: "sorcerer#overwhelming-spell")
