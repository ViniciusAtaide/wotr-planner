(key: "inquisitor/living-grimoire/blessed-script", blueprint: "42559d1923644932bea28da3795a0db5", name: "Blessed Script", summary: "From 5th level, book hits raise your next spell's caster level and DC by +1 (+2 at 10th, +3 at 16th); spells give the book bane for 2 rounds.", guide: "inquisitor#blessed-script")
