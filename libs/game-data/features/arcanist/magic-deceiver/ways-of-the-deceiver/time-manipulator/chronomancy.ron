(key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/chronomancy", blueprint: "47ac3e4aa5054963bf1f521b292d17fc", name: "Chronomancy", summary: "From 4th level, outside combat, refresh your or an ally's spells and abilities as if rested, at -1 DC until a real rest; 1/day +1 per four levels.", guide: "arcanist#chronomancy")
