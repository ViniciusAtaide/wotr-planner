    (key: "spellcasters-onslaught", blueprint: "a4d2dc95084d4769b2f9dfa90d0f4297", name: "Spellcaster\'s Onslaught", summary: "Casting a spell gives +MR/2 attack and damage to your next weapon attack.", group: Class, guide: "mythic-paths#spellcasters-onslaught"),
    (key: "the-bigger-they-are", blueprint: "91a3a658f82ee5044a7c1eaaf756aa50", name: "The Bigger They Are", summary: "Ranged attacks gain a bonus equal to the target\'s size penalty to AC.", group: Ranged, guide: "mythic-paths#the-bigger-they-are"),
    (key: "throw-elixir", blueprint: "fd1f99a42ff74d74f95c50cfc632cd69", name: "Throw Elixir", summary: "An Alchemist\'s extracts reach close range instead of touch.", group: Class, guide: "mythic-paths#throw-elixir", prerequisite: SelectionOption("alchemist/discovery/infusion")),
    (key: "thundering-blows", blueprint: "8081c981b95ad9f49a421e7345c8c6f6", name: "Thundering Blows", summary: "Once a round, missing in melee blasts enemies within 10 ft for 2d6 + 1d6 per two mythic ranks sonic damage.", group: Melee, guide: "mythic-paths#thundering-blows"),
    (key: "unrelenting-assault", blueprint: "b0db6bc8548257a40b055c37d7cbc3e0", name: "Unrelenting Assault", summary: "Each turn you make a melee attack, gain a stacking +2 melee damage (up to +10) for the rest of combat.", group: Melee, guide: "mythic-paths#unrelenting-assault"),
