[
    (key: "abundant-arcane-pool", blueprint: "8acebba92ada26043873cae5b92cef7b", name: "Abundant Arcane Pool", summary: "Arcane Pool (or Eldritch Pool) grows by your mythic rank in points.", group: Class, guide: "mythic-paths#abundant-arcane-pool", prerequisite: Any([Any([Feature(feature: "magus/arcane-pool", count: 1), Feature(feature: "magus/armored-battlemage/arcane-pool-armored-battlemage", count: 1)]), Feature(feature: "magus/eldritch-scion/eldritch-pool", count: 1)])),
    (key: "abundant-bane", blueprint: "1af20285c6d179e41a0d1fec3868fe5f", name: "Abundant Bane", summary: "Bane lasts one more round a day per mythic rank.", group: Class, guide: "mythic-paths#abundant-bane", prerequisite: Feature(feature: "inquisitor/bane", count: 1)),
    (key: "abundant-casting", blueprint: "cf594fa8871332a4ba861c6002480ec2", name: "Abundant Casting", summary: "+4 daily spell slots at each of spell levels 1, 2 and 3.", group: Magic, guide: "mythic-paths#abundant-casting"),
    (key: "abundant-ki-pool", blueprint: "e8752f9126d986748b10d0bdac693264", name: "Abundant Ki Pool", summary: "Ki Pool grows by your mythic rank in points.", group: Class, guide: "mythic-paths#abundant-ki-pool", prerequisite: Feature(feature: "monk/ki-pool", count: 1)),
    (key: "abundant-smite-smite-chaos", blueprint: "7e5b63faeca24474db0bfd019167dda4", name: "Abundant Smite / Smite Chaos", summary: "Use Smite Evil or Smite Chaos MR/2 more times per day.", group: Class, guide: "mythic-paths#abundant-smite-smite-chaos", prerequisite: Any([Any([Feature(feature: "paladin/hospitaler/smite-evil-hospitaler", count: 1), Feature(feature: "paladin/smite-evil", count: 1)]), Feature(feature: "hellknight/smite-chaos", count: 1)])),
    (key: "always-a-chance", blueprint: "d57301613ad6a5140b2fdac40fa368e3", name: "Always a Chance", summary: "A natural 1 on an attack roll is no longer an automatic miss.", group: Melee, guide: "mythic-paths#always-a-chance"),
    (key: "any-means-necessary", blueprint: "a0a814897cd33ed4ea6ffca4b0e1197a", name: "Any Means Necessary", summary: "Damage reduction treats your attacks as good-aligned.", group: Class, guide: "mythic-paths#any-means-necessary", prerequisite: ClassLevel(class: "hellknight", level: 1)),
    (key: "archmage-armor", blueprint: "c3ef5076c0feb3c4f90c229714e62cd0", name: "Archmage Armor", summary: "Mage Armor you cast on yourself gives an extra armor bonus equal to your mythic rank; not from items or other casters.", group: Magic, guide: "mythic-paths#archmage-armor"),
    (key: "ascendant-element", blueprint: "535d4e5d8a5664f4797560c280941782", name: "Ascendant Element", summary: "Pick acid, cold, electricity, fire, sonic or negative energy: enemies\' resistance and immunity no longer stop it.", group: Magic, guide: "mythic-paths#ascendant-element", parameter: Element),
    (key: "ascendant-summons", blueprint: "fcdd46e2ead3d904cb9311c56112ce5f", name: "Ascendant Summons", summary: "Your summons gain MR/2+1 to Str, Dex, Con, Wis and Cha, and their attacks ignore all DR except universal.", group: Magic, guide: "mythic-paths#ascendant-summons"),
    (key: "battle-meditation", blueprint: "3f12027f9152f484b8fde69d2c87c8cc", name: "Battle Meditation", summary: "Standard action: allies within 30 ft gain +1 (+1 per 3 MR) morale to attack, damage and saves vs. fear; you can\'t move and lose Dex to AC.", group: Miscellaneous, guide: "mythic-paths#battle-meditation"),
    (key: "beneficial-curse", blueprint: "2dda67424ee8e0b4d83ef01a73ca6bff", name: "Beneficial Curse", summary: "Gain an extra Oracle curse with no penalties.", group: Class, guide: "mythic-paths#beneficial-curse", prerequisite: Any([SelectionOption("oracle/oracles-curse/blackened"), SelectionOption("oracle/oracles-curse/demonic"), SelectionOption("oracle/oracles-curse/hellbound"), SelectionOption("oracle/oracles-curse/lame"), SelectionOption("oracle/oracles-curse/plagued"), SelectionOption("oracle/oracles-curse/powerless-prophecy"), SelectionOption("oracle/oracles-curse/pranked"), SelectionOption("oracle/oracles-curse/wasting"), SelectionOption("oracle/oracles-curse/wolf-scarred-face")]), selections: ["oracle/oracles-curse"]),
    (key: "best-jokes", blueprint: "ec739ff2292290f43b20689ff32de112", name: "Best Jokes", summary: "Hideous Laughter chains: each enemy that fails the save passes it to a random enemy within 30 ft, until one of them saves.", group: Magic, guide: "mythic-paths#best-jokes"),
    (key: "bloodline-ascendance", blueprint: "ce85aee1726900641ab53ede61ac5c19", name: "Bloodline Ascendance", summary: "Gain your sorcerer bloodline\'s 20th-level power.", group: Class, guide: "mythic-paths#bloodline-ascendance", prerequisite: ClassLevel(class: "sorcerer", level: 1), features: ["sorcerer/bloodline-ascendance"]),
    (key: "boundless-healing", blueprint: "c8bbb330aaecaf54dbc7570200653f8c", name: "Boundless Healing", summary: "Healing spells act as if Reach metamagic were applied, and no spell\'s caster level is capped.", group: Healing, guide: "mythic-paths#boundless-healing"),
    (key: "brutality-incarnate", blueprint: "3ac26dec060aa67409171e6e631a2942", name: "Brutality Incarnate", summary: "Only DR/- still reduces the damage of your natural attacks.", group: Melee, guide: "mythic-paths#brutality-incarnate"),
    (key: "cleaving-shot", blueprint: "b3fb61cecd4de98419d82e465bc588f2", name: "Cleaving Shot", summary: "A ranged critical hit or kill deals your weapon damage to every other enemy within 10 ft.", group: Ranged, guide: "mythic-paths#cleaving-shot"),
    (key: "corruptor", blueprint: "55c364c3f02e4fdc8a63125b5a4c256c", name: "Corruptor", summary: "Creatures immune to poison or disease are not immune to yours.", group: Miscellaneous, guide: "mythic-paths#corruptor"),
    (key: "defensive-study", blueprint: "ec041312142ba1f48a0044521f68fc0a", name: "Defensive Study", summary: "Studied Target\'s attack bonus also applies to your AC.", group: Class, guide: "mythic-paths#defensive-study", prerequisite: Any([Feature(feature: "hunter/tandem-executioner/studied-target", count: 1), Feature(feature: "hunter/tandem-executioner/studied-target-swift", count: 1), Feature(feature: "inquisitor/sanctified-slayer/studied-target", count: 1), Feature(feature: "inquisitor/sanctified-slayer/studied-target-swift", count: 1), Feature(feature: "paladin/divine-scion/studied-target", count: 1), Feature(feature: "paladin/divine-scion/studied-target-swift", count: 1), Feature(feature: "slayer/studied-target", count: 1), Feature(feature: "slayer/studied-target-swift", count: 1)])),
    (key: "dimensional-retribution", blueprint: "939f49ad995ee8d4fad03ad0c7f655d1", name: "Dimensional Retribution", summary: "Being targeted by a spell lets you, for 2 rounds, teleport next to that caster as a move action.", group: Miscellaneous, guide: "mythic-paths#dimensional-retribution"),
    (key: "distracting-shots", blueprint: "ad686f07a3deaf94ba91f97369156000", name: "Distracting Shots", summary: "A ranged hit gives the enemy an AC penalty of MR/2 against melee attacks for 1 round.", group: Ranged, guide: "mythic-paths#distracting-shots"),
    (key: "domain-zealot", blueprint: "2de64f6a1f2baee4f9b7e52e3f046ec5", name: "Domain Zealot", summary: "Domain powers take only a swift action.", group: Class, guide: "mythic-paths#domain-zealot", prerequisite: Any([SelectionOption("cleric/domain/air"), SelectionOption("cleric/domain/animal"), SelectionOption("cleric/domain/artifice"), SelectionOption("cleric/domain/chaos"), SelectionOption("cleric/domain/charm"), SelectionOption("cleric/domain/community"), SelectionOption("cleric/domain/darkness"), SelectionOption("cleric/domain/death"), SelectionOption("cleric/domain/destruction"), SelectionOption("cleric/domain/earth"), SelectionOption("cleric/domain/evil"), SelectionOption("cleric/domain/fire"), SelectionOption("cleric/domain/glory"), SelectionOption("cleric/domain/good"), SelectionOption("cleric/domain/healing"), SelectionOption("cleric/domain/ice"), SelectionOption("cleric/domain/knowledge"), SelectionOption("cleric/domain/law"), SelectionOption("cleric/domain/liberation"), SelectionOption("cleric/domain/luck"), SelectionOption("cleric/domain/madness"), SelectionOption("cleric/domain/magic"), SelectionOption("cleric/domain/murder"), SelectionOption("cleric/domain/nobility"), SelectionOption("cleric/domain/plant"), SelectionOption("cleric/domain/protection"), SelectionOption("cleric/domain/repose"), SelectionOption("cleric/domain/rune"), SelectionOption("cleric/domain/scalykind"), SelectionOption("cleric/domain/strength"), SelectionOption("cleric/domain/sun"), SelectionOption("cleric/domain/travel"), SelectionOption("cleric/domain/trickery"), SelectionOption("cleric/domain/undead"), SelectionOption("cleric/domain/war"), SelectionOption("cleric/domain/water"), SelectionOption("cleric/domain/weather")])),
    (key: "elemental-barrage", blueprint: "da56a1b21032a374783fdf46e1a92adb", name: "Elemental Barrage", summary: "A creature hit by spell energy damage is marked; another energy type from your spells within 3 rounds adds 1d6 divine per MR.", group: Magic, guide: "mythic-paths#elemental-barrage"),
    (key: "emergency-help", blueprint: "22ce17c5253183b42845a5bfc54f8afa", name: "Emergency Help", summary: "3/day, teleport as a move action to an ally under 30 HP; your first healing spell before next round ends is empowered and maximized.", group: Healing, guide: "mythic-paths#emergency-help"),
    (key: "enduring-spells", blueprint: "2f206e6d292bdfb4d981e99dcf08153f", name: "Enduring Spells", summary: "Any spell with a duration over 1 hour and under 24 hours now lasts a full day.", group: Magic, guide: "mythic-paths#enduring-spells"),
    (key: "enforced-vigor", blueprint: "29d7f1e36132b874084402c207847ad1", name: "Enforced Vigor", summary: "Allies you damage gain +2 mythic bonus to attack and damage and +1 to saves for MR/2 rounds.", group: Miscellaneous, guide: "mythic-paths#enforced-vigor"),
    (key: "ever-ready", blueprint: "8161528d5b98b3e4a8a6a0ed327c3b6a", name: "Ever Ready", summary: "Attacks of opportunity get +MR/2 to attack and damage, and you can make 2 more of them each round.", group: Melee, guide: "mythic-paths#ever-ready"),
    (key: "everlasting-judgement", blueprint: "4a6dc772c9a7fe742a65820007107f03", name: "Everlasting Judgement", summary: "No daily limit on Judgment.", group: Class, guide: "mythic-paths#everlasting-judgement", prerequisite: Any([Feature(feature: "hunter/divine-hound/judgment", count: 1), SelectionOption("inquisitor/judgment/judgement-resiliency"), SelectionOption("inquisitor/judgment/judgement-resistance"), SelectionOption("inquisitor/judgment/judgment-destruction"), SelectionOption("inquisitor/judgment/judgment-healing"), SelectionOption("inquisitor/judgment/judgment-justice"), SelectionOption("inquisitor/judgment/judgment-piercing"), SelectionOption("inquisitor/judgment/judgment-protection"), SelectionOption("inquisitor/judgment/judgment-purity"), SelectionOption("inquisitor/judgment/judgment-smiting")])),
    (key: "explosives-expert", blueprint: "8a551fcca93446f0adfbe5e57e5bc636", name: "Explosives Expert", summary: "Bombs deal +1d6 damage, and each throw has a 50% chance to give the reagents back.", group: Class, guide: "mythic-paths#explosives-expert", prerequisite: Any([Feature(feature: "alchemist/bomb", count: 1), Feature(feature: "alchemist/reanimator/bomb-reanimator", count: 1)])),
    (key: "expose-vulnerability", blueprint: "8ce3c4b3c1ad24f4dbb6cb4c72e1ec53", name: "Expose Vulnerability", summary: "Every third ranged hit on the same enemy deals an extra 1d6 divine damage per two mythic ranks.", group: Ranged, guide: "mythic-paths#expose-vulnerability"),
    (key: "favorite-metamagic", blueprint: "503fb196aa222b24cb6cfdc9a284e838", name: "Favorite Metamagic", summary: "The chosen metamagic costs one spell level less.", group: Magic, guide: "mythic-paths#favorite-metamagic", parameter: Metamagic),
    (key: "full-reservoir", blueprint: "b3f5fd67399a2a54ea4ddd97206b4c82", name: "Full Reservoir", summary: "After resting, your arcane reservoir refills by your class level + 3.", group: Class, guide: "mythic-paths#full-reservoir", prerequisite: Any([Feature(feature: "arcanist/arcane-reservoir", count: 1), Feature(feature: "slayer/arcane-enforcer/arcane-reservoir", count: 1), Feature(feature: "wizard/exploiter-wizard/arcane-reservoir", count: 1)])),
    (key: "greater-abundant-casting", blueprint: "db5be78901afbfa4e8ea5b399a88b92d", name: "Greater Abundant Casting", summary: "+4 daily spell slots at each of spell levels 7, 8 and 9.", group: Magic, guide: "mythic-paths#greater-abundant-casting", prerequisite: MythicAbility("improved-abundant-casting")),
    (key: "greater-enduring-spells", blueprint: "13f9269b3b48ae94c896f0371ce5e23c", name: "Greater Enduring Spells", summary: "Any spell with a duration over 5 minutes and under 24 hours now lasts a full day.", group: Magic, guide: "mythic-paths#greater-enduring-spells"),
    (key: "impossible-domain", blueprint: "213a8480d22206b45acbfa0619ca5aaf", name: "Impossible Domain", summary: "Choose any domain.", group: Class, guide: "mythic-paths#impossible-domain", prerequisite: Any([ClassLevel(class: "cleric", level: 1), ClassLevel(class: "inquisitor", level: 1), Archetype("hunter/divine-hunter"), SelectionOption("arcanist/magic-deceiver/ways-of-the-deceiver/living-deity"), SelectionOption("hellknight/disciplines/pentamic-faith")]), selections: ["cleric/impossible-domain"]),
    (key: "improved-abundant-casting", blueprint: "37046a54739ed4844b8e8307bbbeece2", name: "Improved Abundant Casting", summary: "+4 daily spell slots at each of spell levels 4, 5 and 6.", group: Magic, guide: "mythic-paths#improved-abundant-casting", prerequisite: MythicAbility("abundant-casting")),
    (key: "inspirational-leader", blueprint: "ffa9a8b8ea27b2a48b3638e20673a687", name: "Inspirational Leader", summary: "Initiative, saves and concentration of allies within 50 ft improve by MR/2+1.", group: Miscellaneous, guide: "mythic-paths#inspirational-leader"),
    (key: "kinetic-overcharge", blueprint: "4236ca275c6fa9b4a9945b2645262616", name: "Kinetic Overcharge", summary: "Gather Power cuts one more point of burn from kinetic blasts.", group: Class, guide: "mythic-paths#kinetic-overcharge", prerequisite: Feature(feature: "kineticist/gather-power", count: 1)),
    (key: "last-stand", blueprint: "d25326011c45a5942bc12f5d4401d4ae", name: "Last Stand", summary: "Once a day, for 2 rounds, no damage can knock you out.", group: Miscellaneous, guide: "mythic-paths#last-stand"),
    (key: "leading-strike", blueprint: "dff1e0b0b0db0f442bb5c93997cf6a43", name: "Leading Strike", summary: "Your melee hits mark the target; the next ally to hit it deals +1d6 divine damage per mythic rank.", group: Melee, guide: "mythic-paths#leading-strike"),
    (key: "limitless-rage", blueprint: "5cb58e6e406525342842a073fb70d068", name: "Limitless Rage", summary: "Rage, Focused Rage or Bloodrage for unlimited rounds per day; fatigue still applies until you have Tireless Rage.", group: Class, guide: "mythic-paths#limitless-rage", prerequisite: Any([Feature(feature: "barbarian/instinctual-warrior/focused-rage", count: 1), Feature(feature: "barbarian/rage", count: 1), Feature(feature: "bloodrager/bloodrage", count: 1)])),
    (key: "magic-nullification", blueprint: "3b17eb0294898cf409dc6afdb3d278cf", name: "Magic Nullification", summary: "A toggled ability that makes you immune to magic and dispels spells on you, friendly ones included.", group: Magic, guide: "mythic-paths#magic-nullification"),
    (key: "master-shapeshifter", blueprint: "934670ef88b281b4da5596db8b00df2f", name: "Master Shapeshifter", summary: "+4 to physical ability scores whenever you are polymorphed, and unlimited uses of Wild Shape.", group: Miscellaneous, guide: "mythic-paths#master-shapeshifter"),
    (key: "mythic-charge", blueprint: "3d1a968428c9b3d4d9d4d27e656b65a8", name: "Mythic Charge", summary: "Charges deal 1d6 more divine damage for each mythic rank.", group: Melee, guide: "mythic-paths#mythic-charge"),
    (key: "mythic-inspiration", blueprint: "69fad80df0d44dfea19aef513db959c2", name: "Mythic Inspiration", summary: "Your inspiration abilities, such as Inspire Courage or Inspired Rage, grant +1 more, plus 1 per 3 mythic ranks above 1st.", group: Class, guide: "mythic-paths#mythic-inspiration"),
    (key: "mythical-beast", blueprint: "89096871a6fdadd43ad31f5046696727", name: "Mythical Beast", summary: "Your animal companion gains MR/2+1 to Str, Dex and Con, and its attacks are ghost touch and ignore all DR except universal.", group: Class, guide: "mythic-paths#mythical-beast", prerequisite: Any([Feature(feature: "barbarian/mad-dog/animal-companion", count: 1), Feature(feature: "cavalier/animal-companion", count: 1), Feature(feature: "cavalier/beast-rider/animal-companion-beast-rider", count: 1), Feature(feature: "cavalier/standard-bearer/animal-companion-standard-bearer", count: 1), Feature(feature: "cleric/domain/animal/animal-companion", count: 1), Feature(feature: "cleric/domain/scalykind/animal-companion", count: 1), Feature(feature: "druid/drovier/animal-companion", count: 1), Feature(feature: "druid/primal-druid/animal-companion-primal-druid", count: 1), Feature(feature: "hunter/animal-companion", count: 1), Feature(feature: "hunter/divine-hound/animal-companion-divine-hound", count: 1), Feature(feature: "hunter/urban-hunter/animal-companion-urban-hunter", count: 1), Feature(feature: "inquisitor/sacred-huntsmaster/animal-companion", count: 1), Feature(feature: "ranger/nomad/animal-companion", count: 1), Feature(feature: "shaman/wildland-shaman/animal-companion", count: 1), Feature(feature: "sorcerer/sylvan-sorcerer/animal-companion", count: 1), SelectionOption("druid/nature-bond/animal-companion"), SelectionOption("oracle/revelations/nature/animal-companion")])),
    (key: "over-infused-blasts", blueprint: "7410cc35ae6aa9d4a82f1d23c081a1ac", name: "Over-Infused Blasts", summary: "Apply two substance infusions to a kinetic blast at once.", group: Class, guide: "mythic-paths#over-infused-blasts"),
    (key: "perfect-cavalry", blueprint: "97c71b36353340ae84eb4c16eda43926", name: "Perfect Cavalry", summary: "Moving while mounted provokes no attacks of opportunity.", group: Class, guide: "mythic-paths#perfect-cavalry"),
    (key: "powerful-shadows", blueprint: "6a9448ec047c642408af6debb8536c38", name: "Powerful Shadows", summary: "Shadow spells gain 20% more reality.", group: Magic, guide: "mythic-paths#powerful-shadows"),
    (key: "ranging-shots", blueprint: "2b558167862b05d47b8472d176257f82", name: "Ranging Shots", summary: "Each ranged miss gives a stacking +1 attack bonus up to your mythic rank; each hit removes 1.", group: Ranged, guide: "mythic-paths#ranging-shots"),
    (key: "rupture-restraints", blueprint: "99631ee151e86684db2b5f33dddfb7a2", name: "Rupture Restraints", summary: "3/day, shake off being confused, dazed, shaken, frightened, paralysed, sickened, nauseated, staggered or stunned automatically.", group: Miscellaneous, guide: "mythic-paths#rupture-restraints"),
