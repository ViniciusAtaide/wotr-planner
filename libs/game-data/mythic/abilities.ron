[
    (key: "abundant-arcane-pool", name: "Abundant Arcane Pool", summary: "Your Arcane Pool (or Eldritch Pool) gains points equal to your mythic rank.", group: Class, guide: "mythic-paths#abundant-arcane-pool", prerequisite: Any([Any([Feature(feature: "magus/arcane-pool", count: 1), Feature(feature: "magus/armored-battlemage/arcane-pool-armored-battlemage", count: 1)]), Feature(feature: "magus/eldritch-scion/eldritch-pool", count: 1)])),
    (key: "abundant-bane", name: "Abundant Bane", summary: "Use Bane for extra rounds per day equal to your mythic rank.", group: Class, guide: "mythic-paths#abundant-bane", prerequisite: Feature(feature: "inquisitor/bane", count: 1)),
    (key: "abundant-casting", name: "Abundant Casting", summary: "Cast four more spells per day of each of 1st, 2nd and 3rd level.", group: Magic, guide: "mythic-paths#abundant-casting"),
    (key: "abundant-ki-pool", name: "Abundant Ki Pool", summary: "Your Ki Pool gains points equal to your mythic rank.", group: Class, guide: "mythic-paths#abundant-ki-pool", prerequisite: Feature(feature: "monk/ki-pool", count: 1)),
    (key: "abundant-smite-smite-chaos", name: "Abundant Smite / Smite Chaos", summary: "Use Smite Evil or Smite Chaos MR/2 more times per day.", group: Class, guide: "mythic-paths#abundant-smite-smite-chaos", prerequisite: Any([Any([Feature(feature: "paladin/hospitaler/smite-evil-hospitaler", count: 1), Feature(feature: "paladin/smite-evil", count: 1)]), Feature(feature: "hellknight/smite-chaos", count: 1)])),
    (key: "always-a-chance", name: "Always a Chance", summary: "A natural 1 on an attack roll is no longer an automatic miss.", group: Melee, guide: "mythic-paths#always-a-chance"),
    (key: "any-means-necessary", name: "Any Means Necessary", summary: "Your attacks count as good-aligned for overcoming damage reduction.", group: Class, guide: "mythic-paths#any-means-necessary", prerequisite: ClassLevel(class: "hellknight", level: 1)),
    (key: "archmage-armor", name: "Archmage Armor", summary: "Mage Armor you cast on yourself gives an extra armor bonus equal to your mythic rank; not from items or other casters.", group: Magic, guide: "mythic-paths#archmage-armor"),
    (key: "ascendant-element", name: "Ascendant Element", summary: "One chosen element (acid, cold, electricity, fire, sonic or negative energy) ignores enemy resistance and immunity.", group: Magic, guide: "mythic-paths#ascendant-element"),
    (key: "ascendant-summons", name: "Ascendant Summons", summary: "Your summons gain MR/2+1 to Str, Dex, Con, Wis and Cha, and their attacks ignore all DR except universal.", group: Magic, guide: "mythic-paths#ascendant-summons"),
    (key: "battle-meditation", name: "Battle Meditation", summary: "Standard action: allies within 30 ft gain +1 (+1 per 3 MR) morale to attack, damage and saves vs. fear; you can\'t move and lose Dex to AC.", group: Miscellaneous, guide: "mythic-paths#battle-meditation"),
    (key: "beneficial-curse", name: "Beneficial Curse", summary: "Gain an extra Oracle curse with no penalties.", group: Class, guide: "mythic-paths#beneficial-curse", prerequisite: Any([SelectionOption("oracle/oracles-curse/blackened"), SelectionOption("oracle/oracles-curse/demonic"), SelectionOption("oracle/oracles-curse/hellbound"), SelectionOption("oracle/oracles-curse/lame"), SelectionOption("oracle/oracles-curse/plagued"), SelectionOption("oracle/oracles-curse/powerless-prophecy"), SelectionOption("oracle/oracles-curse/pranked"), SelectionOption("oracle/oracles-curse/wasting"), SelectionOption("oracle/oracles-curse/wolf-scarred-face")]), selections: ["oracle/oracles-curse"]),
    (key: "best-jokes", name: "Best Jokes", summary: "When an enemy fails its save against Hideous Laughter, the effect jumps to a random enemy within 30 ft, and on while saves keep failing.", group: Magic, guide: "mythic-paths#best-jokes"),
    (key: "bloodline-ascendance", name: "Bloodline Ascendance", summary: "Gain your sorcerer bloodline\'s 20th-level power.", group: Class, guide: "mythic-paths#bloodline-ascendance", prerequisite: ClassLevel(class: "sorcerer", level: 1), features: ["sorcerer/bloodline-ascendance"]),
    (key: "boundless-healing", name: "Boundless Healing", summary: "Healing spells act as if Reach metamagic were applied, and no spell\'s caster level is capped.", group: Healing, guide: "mythic-paths#boundless-healing"),
    (key: "brutality-incarnate", name: "Brutality Incarnate", summary: "Your natural attacks ignore all damage reduction except DR/-.", group: Melee, guide: "mythic-paths#brutality-incarnate"),
    (key: "cleaving-shot", name: "Cleaving Shot", summary: "A ranged critical hit or kill deals your weapon damage to every other enemy within 10 ft.", group: Ranged, guide: "mythic-paths#cleaving-shot"),
    (key: "corruptor", name: "Corruptor", summary: "Your poisons and diseases ignore immunity.", group: Miscellaneous, guide: "mythic-paths#corruptor"),
    (key: "defensive-study", name: "Defensive Study", summary: "Studied Target also gives you an AC bonus equal to its attack bonus.", group: Class, guide: "mythic-paths#defensive-study", prerequisite: Any([Feature(feature: "hunter/tandem-executioner/studied-target", count: 1), Feature(feature: "hunter/tandem-executioner/studied-target-swift", count: 1), Feature(feature: "inquisitor/sanctified-slayer/studied-target", count: 1), Feature(feature: "inquisitor/sanctified-slayer/studied-target-swift", count: 1), Feature(feature: "paladin/divine-scion/studied-target", count: 1), Feature(feature: "paladin/divine-scion/studied-target-swift", count: 1), Feature(feature: "slayer/studied-target", count: 1), Feature(feature: "slayer/studied-target-swift", count: 1)])),
    (key: "dimensional-retribution", name: "Dimensional Retribution", summary: "After a spell targets you, you can teleport to its caster as a move action for the next 2 rounds.", group: Miscellaneous, guide: "mythic-paths#dimensional-retribution"),
    (key: "distracting-shots", name: "Distracting Shots", summary: "A ranged hit gives the enemy an AC penalty of MR/2 against melee attacks for 1 round.", group: Ranged, guide: "mythic-paths#distracting-shots"),
    (key: "domain-zealot", name: "Domain Zealot", summary: "Use domain powers as a swift action.", group: Class, guide: "mythic-paths#domain-zealot", prerequisite: Any([SelectionOption("cleric/domain/air"), SelectionOption("cleric/domain/animal"), SelectionOption("cleric/domain/artifice"), SelectionOption("cleric/domain/chaos"), SelectionOption("cleric/domain/charm"), SelectionOption("cleric/domain/community"), SelectionOption("cleric/domain/darkness"), SelectionOption("cleric/domain/death"), SelectionOption("cleric/domain/destruction"), SelectionOption("cleric/domain/earth"), SelectionOption("cleric/domain/evil"), SelectionOption("cleric/domain/fire"), SelectionOption("cleric/domain/glory"), SelectionOption("cleric/domain/good"), SelectionOption("cleric/domain/healing"), SelectionOption("cleric/domain/ice"), SelectionOption("cleric/domain/knowledge"), SelectionOption("cleric/domain/law"), SelectionOption("cleric/domain/liberation"), SelectionOption("cleric/domain/luck"), SelectionOption("cleric/domain/madness"), SelectionOption("cleric/domain/magic"), SelectionOption("cleric/domain/murder"), SelectionOption("cleric/domain/nobility"), SelectionOption("cleric/domain/plant"), SelectionOption("cleric/domain/protection"), SelectionOption("cleric/domain/repose"), SelectionOption("cleric/domain/rune"), SelectionOption("cleric/domain/scalykind"), SelectionOption("cleric/domain/strength"), SelectionOption("cleric/domain/sun"), SelectionOption("cleric/domain/travel"), SelectionOption("cleric/domain/trickery"), SelectionOption("cleric/domain/undead"), SelectionOption("cleric/domain/war"), SelectionOption("cleric/domain/water"), SelectionOption("cleric/domain/weather")])),
    (key: "elemental-barrage", name: "Elemental Barrage", summary: "A creature hit by spell energy damage is marked; another energy type from your spells within 3 rounds adds 1d6 divine per MR.", group: Magic, guide: "mythic-paths#elemental-barrage"),
    (key: "emergency-help", name: "Emergency Help", summary: "3/day, teleport as a move action to an ally under 30 HP; your first healing spell before next round ends is empowered and maximized.", group: Healing, guide: "mythic-paths#emergency-help"),
    (key: "enduring-spells", name: "Enduring Spells", summary: "Spells lasting more than 1 hour but less than 24 hours last 24 hours.", group: Magic, guide: "mythic-paths#enduring-spells"),
    (key: "enforced-vigor", name: "Enforced Vigor", summary: "Allies you damage gain +2 mythic bonus to attack and damage and +1 to saves for MR/2 rounds.", group: Miscellaneous, guide: "mythic-paths#enforced-vigor"),
    (key: "ever-ready", name: "Ever Ready", summary: "Attacks of opportunity get +MR/2 to attack and damage, and you can make 2 more of them each round.", group: Melee, guide: "mythic-paths#ever-ready"),
    (key: "everlasting-judgement", name: "Everlasting Judgement", summary: "Use Judgment any number of times per day.", group: Class, guide: "mythic-paths#everlasting-judgement", prerequisite: Any([Feature(feature: "hunter/divine-hound/judgment", count: 1), SelectionOption("inquisitor/judgment/judgement-resiliency"), SelectionOption("inquisitor/judgment/judgement-resistance"), SelectionOption("inquisitor/judgment/judgment-destruction"), SelectionOption("inquisitor/judgment/judgment-healing"), SelectionOption("inquisitor/judgment/judgment-justice"), SelectionOption("inquisitor/judgment/judgment-piercing"), SelectionOption("inquisitor/judgment/judgment-protection"), SelectionOption("inquisitor/judgment/judgment-purity"), SelectionOption("inquisitor/judgment/judgment-smiting")])),
    (key: "explosives-expert", name: "Explosives Expert", summary: "Bombs deal +1d6 damage, and each throw has a 50% chance to give the reagents back.", group: Class, guide: "mythic-paths#explosives-expert", prerequisite: Any([Feature(feature: "alchemist/bomb", count: 1), Feature(feature: "alchemist/reanimator/bomb-reanimator", count: 1)])),
    (key: "expose-vulnerability", name: "Expose Vulnerability", summary: "Every third ranged hit on the same enemy deals an extra 1d6 divine damage per two mythic ranks.", group: Ranged, guide: "mythic-paths#expose-vulnerability"),
    (key: "favorite-metamagic", name: "Favorite Metamagic", summary: "The chosen metamagic costs one spell level less.", group: Magic, guide: "mythic-paths#favorite-metamagic"),
    (key: "full-reservoir", name: "Full Reservoir", summary: "After resting, your arcane reservoir refills by your class level + 3.", group: Class, guide: "mythic-paths#full-reservoir", prerequisite: Any([Feature(feature: "arcanist/arcane-reservoir", count: 1), Feature(feature: "slayer/arcane-enforcer/arcane-reservoir", count: 1), Feature(feature: "wizard/exploiter-wizard/arcane-reservoir", count: 1)])),
    (key: "greater-abundant-casting", name: "Greater Abundant Casting", summary: "Cast four more spells per day of each of 7th, 8th and 9th level.", group: Magic, guide: "mythic-paths#greater-abundant-casting", prerequisite: MythicAbility("improved-abundant-casting")),
    (key: "greater-enduring-spells", name: "Greater Enduring Spells", summary: "Spells lasting more than 5 minutes but less than 24 hours last 24 hours.", group: Magic, guide: "mythic-paths#greater-enduring-spells"),
    (key: "impossible-domain", name: "Impossible Domain", summary: "Choose any domain.", group: Class, guide: "mythic-paths#impossible-domain", prerequisite: Any([ClassLevel(class: "cleric", level: 1), ClassLevel(class: "inquisitor", level: 1), Archetype("hunter/divine-hunter"), SelectionOption("arcanist/magic-deceiver/ways-of-the-deceiver/living-deity"), SelectionOption("hellknight/disciplines/pentamic-faith")]), selections: ["cleric/impossible-domain"]),
    (key: "improved-abundant-casting", name: "Improved Abundant Casting", summary: "Cast four more spells per day of each of 4th, 5th and 6th level.", group: Magic, guide: "mythic-paths#improved-abundant-casting", prerequisite: MythicAbility("abundant-casting")),
    (key: "inspirational-leader", name: "Inspirational Leader", summary: "Allies within 50 ft gain MR/2+1 to initiative, saving throws and concentration checks.", group: Miscellaneous, guide: "mythic-paths#inspirational-leader"),
    (key: "kinetic-overcharge", name: "Kinetic Overcharge", summary: "Gather Power cuts one more point of burn from kinetic blasts.", group: Class, guide: "mythic-paths#kinetic-overcharge", prerequisite: Feature(feature: "kineticist/gather-power", count: 1)),
    (key: "last-stand", name: "Last Stand", summary: "Once a day, for 2 rounds, no damage can knock you out.", group: Miscellaneous, guide: "mythic-paths#last-stand"),
    (key: "leading-strike", name: "Leading Strike", summary: "Your melee hits mark the target; the next ally to hit it deals +1d6 divine damage per mythic rank.", group: Melee, guide: "mythic-paths#leading-strike"),
    (key: "limitless-rage", name: "Limitless Rage", summary: "Rage, Focused Rage or Bloodrage for unlimited rounds per day; fatigue still applies until you have Tireless Rage.", group: Class, guide: "mythic-paths#limitless-rage", prerequisite: Any([Feature(feature: "barbarian/instinctual-warrior/focused-rage", count: 1), Feature(feature: "barbarian/rage", count: 1), Feature(feature: "bloodrager/bloodrage", count: 1)])),
    (key: "magic-nullification", name: "Magic Nullification", summary: "A toggled ability that makes you immune to magic and dispels spells on you, friendly ones included.", group: Magic, guide: "mythic-paths#magic-nullification"),
    (key: "master-shapeshifter", name: "Master Shapeshifter", summary: "+4 to physical ability scores whenever you are polymorphed, and unlimited uses of Wild Shape.", group: Miscellaneous, guide: "mythic-paths#master-shapeshifter"),
    (key: "mythic-charge", name: "Mythic Charge", summary: "Charge attacks deal an extra 1d6 divine damage per mythic rank.", group: Melee, guide: "mythic-paths#mythic-charge"),
    (key: "mythic-inspiration", name: "Mythic Inspiration", summary: "Your inspiration abilities, such as Inspire Courage or Inspired Rage, grant +1 more, plus 1 per 3 mythic ranks above 1st.", group: Class, guide: "mythic-paths#mythic-inspiration"),
    (key: "mythical-beast", name: "Mythical Beast", summary: "Your animal companion gains MR/2+1 to Str, Dex and Con, and its attacks are ghost touch and ignore all DR except universal.", group: Class, guide: "mythic-paths#mythical-beast", prerequisite: Any([Feature(feature: "barbarian/mad-dog/animal-companion", count: 1), Feature(feature: "cavalier/animal-companion", count: 1), Feature(feature: "cavalier/beast-rider/animal-companion-beast-rider", count: 1), Feature(feature: "cavalier/standard-bearer/animal-companion-standard-bearer", count: 1), Feature(feature: "cleric/domain/animal/animal-companion", count: 1), Feature(feature: "cleric/domain/scalykind/animal-companion", count: 1), Feature(feature: "druid/drovier/animal-companion", count: 1), Feature(feature: "druid/primal-druid/animal-companion-primal-druid", count: 1), Feature(feature: "hunter/animal-companion", count: 1), Feature(feature: "hunter/divine-hound/animal-companion-divine-hound", count: 1), Feature(feature: "hunter/urban-hunter/animal-companion-urban-hunter", count: 1), Feature(feature: "inquisitor/sacred-huntsmaster/animal-companion", count: 1), Feature(feature: "ranger/nomad/animal-companion", count: 1), Feature(feature: "shaman/wildland-shaman/animal-companion", count: 1), Feature(feature: "sorcerer/sylvan-sorcerer/animal-companion", count: 1), SelectionOption("druid/nature-bond/animal-companion"), SelectionOption("oracle/revelations/nature/animal-companion")])),
    (key: "over-infused-blasts", name: "Over-Infused Blasts", summary: "Apply two substance infusions to a kinetic blast at once.", group: Class, guide: "mythic-paths#over-infused-blasts"),
    (key: "perfect-cavalry", name: "Perfect Cavalry", summary: "Moving while mounted provokes no attacks of opportunity.", group: Class, guide: "mythic-paths#perfect-cavalry"),
    (key: "powerful-shadows", name: "Powerful Shadows", summary: "Your Shadow spells are 20% more real.", group: Magic, guide: "mythic-paths#powerful-shadows"),
    (key: "ranging-shots", name: "Ranging Shots", summary: "Each ranged miss gives a stacking +1 attack bonus up to your mythic rank; each hit removes 1.", group: Ranged, guide: "mythic-paths#ranging-shots"),
    (key: "rupture-restraints", name: "Rupture Restraints", summary: "3/day, automatically dispel effects that make you confused, dazed, shaken, frightened, paralysed, sickened, nauseated, staggered or stunned.", group: Miscellaneous, guide: "mythic-paths#rupture-restraints"),
    (key: "school-tolerance", name: "School Tolerance", summary: "No more penalties from your opposition schools.", group: Class, guide: "mythic-paths#school-tolerance"),
    (key: "second-bloodline", name: "Second Bloodline", summary: "Take a second sorcerer bloodline with all its benefits; not a second Draconic one.", group: Class, guide: "mythic-paths#second-bloodline", prerequisite: ClassLevel(class: "sorcerer", level: 1), selections: ["sorcerer/bloodline"]),
    (key: "second-bloodrager-bloodline", name: "Second Bloodrager Bloodline", summary: "Take a second bloodrager bloodline with all its benefits.", group: Class, guide: "mythic-paths#second-bloodrager-bloodline", prerequisite: ClassLevel(class: "bloodrager", level: 1), selections: ["bloodrager/bloodline"]),
    (key: "second-mystery", name: "Second Mystery", summary: "Gain a second Oracle mystery.", group: Class, guide: "mythic-paths#second-mystery", prerequisite: Any([SelectionOption("oracle/mystery/ancestor"), SelectionOption("oracle/mystery/battle"), SelectionOption("oracle/mystery/bones"), SelectionOption("oracle/mystery/flame"), SelectionOption("oracle/mystery/life"), SelectionOption("oracle/mystery/nature"), SelectionOption("oracle/mystery/stone"), SelectionOption("oracle/mystery/waves"), SelectionOption("oracle/mystery/wind")]), selections: ["oracle/second-mystery"]),
    (key: "second-spirit", name: "Second Spirit", summary: "Gain a second Shaman spirit.", group: Class, guide: "mythic-paths#second-spirit", prerequisite: Any([SelectionOption("shaman/spirit/battle"), SelectionOption("shaman/spirit/bones"), SelectionOption("shaman/spirit/flame"), SelectionOption("shaman/spirit/frost"), SelectionOption("shaman/spirit/life"), SelectionOption("shaman/spirit/nature"), SelectionOption("shaman/spirit/stone"), SelectionOption("shaman/spirit/waves"), SelectionOption("shaman/spirit/wind")]), selections: ["shaman/spirit"]),
    (key: "spellcasters-onslaught", name: "Spellcaster\'s Onslaught", summary: "After you cast a spell, your next weapon attack gets +MR/2 to attack and damage.", group: Class, guide: "mythic-paths#spellcasters-onslaught"),
    (key: "the-bigger-they-are", name: "The Bigger They Are", summary: "Ranged attacks gain a bonus equal to the target\'s size penalty to AC.", group: Ranged, guide: "mythic-paths#the-bigger-they-are"),
    (key: "throw-elixir", name: "Throw Elixir", summary: "An Alchemist\'s extracts reach close range instead of touch.", group: Class, guide: "mythic-paths#throw-elixir", prerequisite: SelectionOption("alchemist/discovery/infusion")),
    (key: "thundering-blows", name: "Thundering Blows", summary: "Once a round, a melee miss deals 2d6 + 1d6 per two mythic ranks sonic damage to enemies within 10 ft.", group: Melee, guide: "mythic-paths#thundering-blows"),
    (key: "unrelenting-assault", name: "Unrelenting Assault", summary: "Each turn you make a melee attack, gain a stacking +2 melee damage (up to +10) for the rest of combat.", group: Melee, guide: "mythic-paths#unrelenting-assault"),
    (key: "unstoppable", name: "Unstoppable", summary: "Paralysis becomes staggered, nausea becomes sickened, and frightened becomes shaken.", group: Miscellaneous, guide: "mythic-paths#unstoppable"),
