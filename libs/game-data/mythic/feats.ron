[
    (key: "bull-rush-mythic", blueprint: "50f13705c167bfa43ad4e1a7da95c491", name: "Bull Rush (Mythic)", summary: "+MR/2 to CMB and CMD for bull rushes, and an attack of opportunity on anyone who tries to bull rush you.", group: CombatManoeuvre, guide: "mythic-paths#bull-rush-mythic", prerequisite: Feat("bull-rush")),
    (key: "dazzling-display-mythic", blueprint: "885a1e422b3033b47a654343704ccafc", name: "Dazzling Display (Mythic)", summary: "Dazzling Display gets faster at a Persuasion cost: standard action -5, move action -10, swift action -20.", group: Melee, guide: "mythic-paths#dazzling-display-mythic", prerequisite: Feat("dazzling-display")),
    (key: "deadly-aim-mythic", blueprint: "ec661a003088c174ca3d477b51d35e03", name: "Deadly Aim (Mythic)", summary: "Deadly Aim\'s damage bonus rises to +3.", group: Ranged, guide: "mythic-paths#deadly-aim-mythic", prerequisite: Feat("deadly-aim")),
    (key: "defensive-combat-training-mythic", blueprint: "479ee593a2a9cad4db68468c39a623ba", name: "Defensive Combat Training (Mythic)", summary: "CMD +MR/2.", group: CombatManoeuvre, guide: "mythic-paths#defensive-combat-training-mythic", prerequisite: Feat("defensive-combat-training")),
    (key: "destiny-beyond-birth", blueprint: "325f078c584318849bfe3da9ea245b9d", name: "Destiny Beyond Birth", summary: "Removes your race\'s ability score penalty.", group: Miscellaneous, guide: "mythic-paths#destiny-beyond-birth", removes_racial_penalty: true, prerequisite: Any([Race("dhampir"), Race("dwarf"), Race("elf"), Race("gnome"), Race("halfling"), Race("kitsune"), Race("oread"), Race("tiefling")])),
    (key: "destructive-shockwave", blueprint: "263a65c1e92dd964192ba7d41a76b4e3", name: "Destructive Shockwave", summary: "Missed melee attacks still deal your Strength modifier in damage to the target.", group: Melee, guide: "mythic-paths#destructive-shockwave"),
    (key: "dirty-trick-mythic", blueprint: "06816910f76f55c4fbad0d19a0c37bcc", name: "Dirty Trick (Mythic)", summary: "+MR/2 to CMB and CMD for dirty tricks, and an attack of opportunity on anyone who tries one on you.", group: CombatManoeuvre, guide: "mythic-paths#dirty-trick-mythic", prerequisite: Feat("dirty-trick")),
    (key: "disarm-mythic", blueprint: "0a6cfb36ad681df449d19b1bc9968941", name: "Disarm (Mythic)", summary: "+MR/2 to CMB and CMD for disarms, and an attack of opportunity on anyone who tries to disarm you.", group: CombatManoeuvre, guide: "mythic-paths#disarm-mythic", prerequisite: Feat("disarm")),
    (key: "dodge-mythic", blueprint: "3812d9ca1377c014c97fb3ac421ba9e6", name: "Dodge (Mythic)", summary: "+1 more dodge AC; and each round, the first attack on you faces an extra dodge bonus of your mythic rank.", group: Miscellaneous, guide: "mythic-paths#dodge-mythic", prerequisite: Feat("dodge")),
    (key: "emergency-potion", blueprint: "977018f481c10eb41b0b085d43a7d423", name: "Emergency Potion", summary: "Potions take only a swift action to drink.", group: Miscellaneous, guide: "mythic-paths#emergency-potion"),
    (key: "expanded-arsenal", blueprint: "f137089c48364014aa3ec3b92ccaf2e2", name: "Expanded Arsenal", summary: "Pick a school: your Spell Focus bonuses from one other school also apply to it.", group: Magic, guide: "mythic-paths#expanded-arsenal", parameter: SpellSchool, repeat: PerValue),
    (key: "extra-feat", blueprint: "e10c4f18a6c8b4342afe6954bde0587b", name: "Extra Feat", summary: "Gain one normal feat of your choice.", group: Miscellaneous, guide: "mythic-paths#extra-feat", extra_pick: Feat),
    (key: "extra-mythic-ability", blueprint: "8a6a511c55e67d04db328cc49aaad2b8", name: "Extra Mythic Ability", summary: "Gain one more mythic ability.", group: Miscellaneous, guide: "mythic-paths#extra-mythic-ability", extra_pick: MythicAbility),
    (key: "flawless-attacks", blueprint: "d1683a4035c05c64b9e42993f19be24b", name: "Flawless Attacks", summary: "Iterative attacks take a -4 penalty each instead of -5.", group: Melee, guide: "mythic-paths#flawless-attacks"),
    (key: "great-fortitude-mythic", blueprint: "8bc4dbea992b6bd489ac5b66fd41e380", name: "Great Fortitude (Mythic)", summary: "Roll Fortitude saves twice and keep the better result.", group: Miscellaneous, guide: "mythic-paths#great-fortitude-mythic", prerequisite: Feat("great-fortitude")),
    (key: "improved-critical-mythic", blueprint: "8bc0190a4ec04bd489eec290aeaa6d07", name: "Improved Critical (Mythic)", summary: "Your chosen weapon\'s critical multiplier rises by 1.", group: Melee, guide: "mythic-paths#improved-critical-mythic", parameter: Weapon, repeat: PerValue, prerequisite: FeatForSameValue("improved-critical")),
    (key: "improved-initiative-mythic", blueprint: "25f4cb387ba4ab94d944fdef3da9ab97", name: "Improved Initiative (Mythic)", summary: "Initiative +MR.", group: Miscellaneous, guide: "mythic-paths#improved-initiative-mythic", prerequisite: Feat("improved-initiative")),
    (key: "improved-unarmed-strike-mythic", blueprint: "e086a07dae105244291fb11e05d0715f", name: "Improved Unarmed Strike (Mythic)", summary: "Unarmed strikes deal extra damage equal to half your mythic rank.", group: Melee, guide: "mythic-paths#improved-unarmed-strike-mythic", prerequisite: Feat("improved-unarmed-strike")),
    (key: "iron-will-mythic", blueprint: "952147d43befd5b4ba853f24cd1368ee", name: "Iron Will (Mythic)", summary: "Roll Will saves twice and keep the better result.", group: Miscellaneous, guide: "mythic-paths#iron-will-mythic", prerequisite: Feat("iron-will")),
    (key: "lightning-reflexes-mythic", blueprint: "4e56fcc942a9f0645a2e01c071453647", name: "Lightning Reflexes (Mythic)", summary: "Roll Reflex saves twice and keep the better result.", group: Miscellaneous, guide: "mythic-paths#lightning-reflexes-mythic", prerequisite: Feat("lightning-reflexes")),
    (key: "mythic-armor-focus-heavy-armor-assault", blueprint: "037c3fde2ad14767a92768c9aa6d6de2", name: "Mythic Armor Focus (Heavy Armor) - Assault", summary: "In heavy armor, your melee hits deal an extra 1d6 slashing plus your armor\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-heavy-armor-assault", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Heavy))),
    (key: "mythic-armor-focus-heavy-armor-avoidance", blueprint: "9b83bd09e7154b5f9c22a172efaaef4e", name: "Mythic Armor Focus (Heavy Armor) - Avoidance", summary: "In heavy armor, half your Strength bonus replaces Dexterity in your AC, with no cap from the armor.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-heavy-armor-avoidance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Heavy))),
    (key: "mythic-armor-focus-heavy-armor-endurance", blueprint: "b28a0e962e3c40ee84411cccef31d4d0", name: "Mythic Armor Focus (Heavy Armor) - Endurance", summary: "In heavy armor, gain DR/- equal to half your armor\'s AC, stacking with other DR.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-heavy-armor-endurance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Heavy))),
    (key: "mythic-armor-focus-light-armor-assault", blueprint: "48168449f8ba465fab2843ba2dada063", name: "Mythic Armor Focus (Light Armor) - Assault", summary: "Light armor plus a finesse-capable weapon: attack rolls gain half the armor\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-light-armor-assault", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Light))),
    (key: "mythic-armor-focus-light-armor-avoidance", blueprint: "40be409a44084b2998eda225dd9c544a", name: "Mythic Armor Focus (Light Armor) - Avoidance", summary: "In light armor, your maximum Dexterity bonus rises by your mythic rank, and attacks on you miss 5% (+5% at ranks 4, 7 and 10).", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-light-armor-avoidance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Light))),
    (key: "mythic-armor-focus-light-armor-endurance", blueprint: "3260cacb9fa64d3bba6f179cfb026abd", name: "Mythic Armor Focus (Light Armor) - Endurance", summary: "In light armor, gain spell resistance equal to your armor\'s AC, stacking with other spell resistance.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-light-armor-endurance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Light))),
    (key: "mythic-armor-focus-medium-armor-assault", blueprint: "6c6b8ba0ad1141df9316ab0ee28cbb77", name: "Mythic Armor Focus (Medium Armor) - Assault", summary: "In medium armor, your melee hits deal an extra 1d6 piercing plus your armor\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-medium-armor-assault", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Medium))),
    (key: "mythic-armor-focus-medium-armor-avoidance", blueprint: "b152e7fdfc6a452c8c47dd76de83e1aa", name: "Mythic Armor Focus (Medium Armor) - Avoidance", summary: "In medium armor, your Constitution modifier raises the armor\'s Dexterity cap.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-medium-armor-avoidance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Medium))),
    (key: "mythic-armor-focus-medium-armor-endurance", blueprint: "4243c96836bf4b54aa4b36e1ab0c7fb1", name: "Mythic Armor Focus (Medium Armor) - Endurance", summary: "In medium armor, your speed isn\'t reduced and you gain an armor bonus to AC equal to half the armor\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-medium-armor-endurance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Medium))),
    (key: "mythic-brew-potions", blueprint: "a155dc95e3fb2d44481c76bc4aea26b9", name: "Mythic Brew Potions", summary: "Craft potions of up to 6th level while camping.", group: Magic, guide: "mythic-paths#mythic-brew-potions", prerequisite: Feat("brew-potions")),
    (key: "mythic-buckler-flying-shield-style", blueprint: "874cd4a453cb44e595c6ee34e97feafd", name: "Mythic Buckler - Flying Shield Style", summary: "Carrying a buckler grants allies within 15 ft your shield\'s AC as a shield bonus.", group: ArmourAndShield, guide: "mythic-paths#mythic-buckler-flying-shield-style", prerequisite: Feat("shield-focus")),
    (key: "mythic-channeling", blueprint: "0e8d5acbc4a937f4a9566001df959bea", name: "Mythic Channeling", summary: "Channel energy heals or harms an extra amount equal to twice your Charisma bonus.", group: Magic, guide: "mythic-paths#mythic-channeling", prerequisite: Feat("selective-channel")),
    (key: "mythic-heavy-shield-aggressive-block", blueprint: "6449dd91423645ddb2f9eb86aaeabfcf", name: "Mythic Heavy Shield - Aggressive Block", summary: "With a heavy shield, foes hitting you with non-reach melee, natural or unarmed attacks take bludgeoning equal to shield AC + Strength bonus.", group: ArmourAndShield, guide: "mythic-paths#mythic-heavy-shield-aggressive-block", prerequisite: Feat("shield-focus")),
    (key: "mythic-light-shield-deflection", blueprint: "baae60e30c1f45cd889ea41459205a84", name: "Mythic Light Shield - Deflection", summary: "Carrying a light shield adds its AC to your Reflex saves as a shield bonus.", group: ArmourAndShield, guide: "mythic-paths#mythic-light-shield-deflection", prerequisite: Feat("shield-focus")),
    (key: "mythic-resolve", blueprint: "3ae0668ab9c707440b6b26d591f15147", name: "Mythic Resolve", summary: "Saving throws +1, and hit points + mythic rank.", group: Miscellaneous, guide: "mythic-paths#mythic-resolve"),
    (key: "mythic-sneak-attack", blueprint: "d0a53bf03b978634890e5ebab4a90ecb", name: "Mythic Sneak Attack", summary: "+1d6 sneak attack damage.", group: Miscellaneous, guide: "mythic-paths#mythic-sneak-attack", prerequisite: Any([Feature(feature: "alchemist/vivisectionist/sneak-attack", count: 1), Feature(feature: "arcane-trickster/sneak-attack", count: 1), Feature(feature: "assassin/sneak-attack", count: 1), Feature(feature: "inquisitor/sanctified-slayer/sneak-attack", count: 1), Feature(feature: "paladin/divine-scion/sneak-attack", count: 1), Feature(feature: "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel", count: 1), Feature(feature: "rogue/master-of-all/sneak-attack-master-of-all", count: 1), Feature(feature: "rogue/sneak-attack", count: 1), Feature(feature: "shaman/shadow-shaman/sneak-attack", count: 1), Feature(feature: "skald/inciter/sneak-attack", count: 1), Feature(feature: "slayer/imitator/sneak-attack-imitator", count: 1), Feature(feature: "slayer/sneak-attack", count: 1), Feature(feature: "trickster/sneak-attack", count: 1), Feature(feature: "warpriest/cult-leader/sneak-attack", count: 1)])),
    (key: "mythic-tower-shield-fortress", blueprint: "f69f36e4a9bc410c8219094b18856e53", name: "Mythic Tower Shield - Fortress", summary: "A tower shield in hand grants DR/- equal to its AC, stacking with other DR.", group: ArmourAndShield, guide: "mythic-paths#mythic-tower-shield-fortress", prerequisite: Feat("shield-focus")),
    (key: "piranha-strike-mythic", blueprint: "0d7884d730fa20a40a9d41bbba1ea4b5", name: "Piranha Strike (Mythic)", summary: "Piranha Strike\'s damage bonus rises to +3.", group: Melee, guide: "mythic-paths#piranha-strike-mythic", prerequisite: Feat("piranha-strike")),
    (key: "point-blank-shot-mythic", blueprint: "b651baa5f6faba646b7e3082929dfaf5", name: "Point-Blank Shot (Mythic)", summary: "Point-Blank Shot\'s attack and damage bonus rises to +2.", group: Ranged, guide: "mythic-paths#point-blank-shot-mythic", prerequisite: Feat("point-blank-shot")),
    (key: "power-attack-mythic", blueprint: "d3ff895f7a79a764f9e16c588c781ab5", name: "Power Attack (Mythic)", summary: "Power Attack\'s damage bonus rises to +3, or +5 with two-handed grips or primary natural attacks that add 1.5x Strength.", group: Melee, guide: "mythic-paths#power-attack-mythic", prerequisite: Feat("power-attack")),
    (key: "rapid-shot-mythic", blueprint: "e332694d67066f24da821f119201b5c7", name: "Rapid Shot (Mythic)", summary: "Rapid Shot no longer gives a -2 attack penalty.", group: Ranged, guide: "mythic-paths#rapid-shot-mythic", prerequisite: Feat("rapid-shot")),
    (key: "school-mastery", blueprint: "ac830015569352b458efcdfae00a948c", name: "School Mastery", summary: "Pick a school: your spells from it gain +1 caster level.", group: Magic, guide: "mythic-paths#school-mastery", parameter: SpellSchool, repeat: PerValue),
    (key: "shield-focus-mythic", blueprint: "502434c044c16304a92901a0b25d5216", name: "Shield Focus (Mythic)", summary: "Touch AC includes your shield bonus plus the shield\'s enhancement bonus.", group: ArmourAndShield, guide: "mythic-paths#shield-focus-mythic", prerequisite: Feat("shield-focus")),
    (key: "skill-focus-mythic", blueprint: "a224819b9492019428c220754208ba3a", name: "Skill Focus (Mythic)", summary: "Take 10 on every check with one skill you have Skill Focus in.", group: Miscellaneous, guide: "mythic-paths#skill-focus-mythic", parameter: Skill, repeat: PerValue, prerequisite: FeatForSameValue("skill-focus")),
    (key: "sorcerous-reflex", blueprint: "f6f9f99993f9a92438bd4ffbfbb71837", name: "Sorcerous Reflex", summary: "Your first spell can be cast swiftly when it is 1st level or two or more levels under your best; cantrips excluded.", group: Magic, guide: "mythic-paths#sorcerous-reflex"),
    (key: "spell-focus-mythic", blueprint: "41fa2470ab50ff441b4cfbb2fc725109", name: "Spell Focus (Mythic)", summary: "Spells from one school you have Spell Focus in gain +1 DC.", group: Magic, guide: "mythic-paths#spell-focus-mythic", parameter: SpellSchool, repeat: PerValue, prerequisite: FeatForSameValue("spell-focus")),
    (key: "spell-penetration-mythic", blueprint: "51b6b22ff184eef46a675449e837365d", name: "Spell Penetration (Mythic)", summary: "Add MR/2 to caster level checks against spell resistance, or your full mythic rank with Greater Spell Penetration.", group: Magic, guide: "mythic-paths#spell-penetration-mythic", prerequisite: Feat("spell-penetration")),
    (key: "stunning-fist-mythic", blueprint: "31b963575ee4a92409216ce534c99dd4", name: "Stunning Fist (Mythic)", summary: "Stunning Fist\'s DC rises by half your mythic rank.", group: Melee, guide: "mythic-paths#stunning-fist-mythic", prerequisite: Any([Feat("stunning-fist"), Feature(feature: "monk/stunning-fist", count: 1)])),
    (key: "sunder-armor-mythic", blueprint: "3b19ac096f4de324daf40590e274102a", name: "Sunder Armor (Mythic)", summary: "+MR/2 to CMB and CMD for sundering armor, and an attack of opportunity on anyone who tries to sunder yours.", group: CombatManoeuvre, guide: "mythic-paths#sunder-armor-mythic", prerequisite: Feat("sunder-armor")),
    (key: "toughness-mythic", blueprint: "d8df8f8ad7149824e8e60dd3453557d2", name: "Toughness (Mythic)", summary: "Toughness gives twice the hit points, and you gain DR 10/epic while below 0 HP.", group: Miscellaneous, guide: "mythic-paths#toughness-mythic", prerequisite: Feat("toughness")),
    (key: "trip-mythic", blueprint: "4cd2697479a5e0c489362533b8465afd", name: "Trip (Mythic)", summary: "+MR/2 to CMB and CMD for trips, and an attack of opportunity on anyone who tries to trip you.", group: CombatManoeuvre, guide: "mythic-paths#trip-mythic", prerequisite: Feat("trip")),
    (key: "two-weapon-fighting-mythic", blueprint: "c6afbb8c1a36a704a8041f35498f41a4", name: "Two-Weapon Fighting (Mythic)", summary: "Two-weapon fighting attack penalties drop by 2.", group: Melee, guide: "mythic-paths#two-weapon-fighting-mythic", prerequisite: Feat("two-weapon-fighting")),
    (key: "vital-strike-mythic", blueprint: "e07bcb271ecefec44be314e1c807c798", name: "Vital Strike (Mythic)", summary: "Vital Strike also multiplies your Strength bonus, weapon enhancement and other bonuses that a critical hit multiplies.", group: Melee, guide: "mythic-paths#vital-strike-mythic", prerequisite: Feat("vital-strike")),
    (key: "weapon-finesse-mythic", blueprint: "d791af1bc179e0e44a0ca1fa6c418993", name: "Weapon Finesse (Mythic)", summary: "Add your Dexterity modifier to damage rolls.", group: Melee, guide: "mythic-paths#weapon-finesse-mythic", prerequisite: Feat("weapon-finesse")),
    (key: "weapon-focus-mythic", blueprint: "74eb201774bccb9428ba5ac8440bf990", name: "Weapon Focus (Mythic)", summary: "Doubles the attack bonus from Weapon Focus and Greater Weapon Focus.", group: Melee, guide: "mythic-paths#weapon-focus-mythic", prerequisite: Feat("weapon-focus")),
    (key: "weapon-specialization-mythic", blueprint: "d84ac5b1931bc504a98bfefaa419e34f", name: "Weapon Specialization (Mythic)", summary: "Damage +MR/2 on top of Weapon Specialization.", group: Melee, guide: "mythic-paths#weapon-specialization-mythic", prerequisite: Feat("weapon-specialization")),
]
