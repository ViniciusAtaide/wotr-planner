[
    (key: "bull-rush-mythic", name: "Bull Rush (Mythic)", summary: "+MR/2 to CMB and CMD for bull rushes, and an attack of opportunity on anyone who tries to bull rush you.", group: CombatManoeuvre, guide: "mythic-paths#bull-rush-mythic", prerequisite: Feat("bull-rush")),
    (key: "dazzling-display-mythic", name: "Dazzling Display (Mythic)", summary: "Use Dazzling Display as a standard action at -5 Persuasion, a move action at -10, or a swift action at -20.", group: Melee, guide: "mythic-paths#dazzling-display-mythic", prerequisite: Feat("dazzling-display")),
    (key: "deadly-aim-mythic", name: "Deadly Aim (Mythic)", summary: "Deadly Aim\'s damage bonus rises to +3.", group: Ranged, guide: "mythic-paths#deadly-aim-mythic", prerequisite: Feat("deadly-aim")),
    (key: "defensive-combat-training-mythic", name: "Defensive Combat Training (Mythic)", summary: "Add half your mythic rank to your CMD.", group: CombatManoeuvre, guide: "mythic-paths#defensive-combat-training-mythic", prerequisite: Feat("defensive-combat-training")),
    (key: "destiny-beyond-birth", name: "Destiny Beyond Birth", summary: "Removes your race\'s ability score penalty.", group: Miscellaneous, guide: "mythic-paths#destiny-beyond-birth", removes_racial_penalty: true, prerequisite: Any([Race("dhampir"), Race("dwarf"), Race("elf"), Race("gnome"), Race("halfling"), Race("kitsune"), Race("oread"), Race("tiefling")])),
    (key: "destructive-shockwave", name: "Destructive Shockwave", summary: "When you miss with a melee attack, the target still takes damage equal to your Strength modifier.", group: Melee, guide: "mythic-paths#destructive-shockwave"),
    (key: "dirty-trick-mythic", name: "Dirty Trick (Mythic)", summary: "+MR/2 to CMB and CMD for dirty tricks, and an attack of opportunity on anyone who tries one on you.", group: CombatManoeuvre, guide: "mythic-paths#dirty-trick-mythic", prerequisite: Feat("dirty-trick")),
    (key: "disarm-mythic", name: "Disarm (Mythic)", summary: "+MR/2 to CMB and CMD for disarms, and an attack of opportunity on anyone who tries to disarm you.", group: CombatManoeuvre, guide: "mythic-paths#disarm-mythic", prerequisite: Feat("disarm")),
    (key: "dodge-mythic", name: "Dodge (Mythic)", summary: "Another +1 dodge bonus to AC, plus a dodge bonus equal to your mythic rank against the first attack on you each round.", group: Miscellaneous, guide: "mythic-paths#dodge-mythic", prerequisite: Feat("dodge")),
    (key: "emergency-potion", name: "Emergency Potion", summary: "Drink a potion as a swift action.", group: Miscellaneous, guide: "mythic-paths#emergency-potion"),
    (key: "expanded-arsenal", name: "Expanded Arsenal", summary: "Pick a school: your Spell Focus bonuses from one other school also apply to it.", group: Magic, guide: "mythic-paths#expanded-arsenal", parameter: SpellSchool, repeat: PerValue),
    (key: "extra-feat", name: "Extra Feat", summary: "Gain one normal feat of your choice.", group: Miscellaneous, guide: "mythic-paths#extra-feat", extra_pick: Feat),
    (key: "extra-mythic-ability", name: "Extra Mythic Ability", summary: "Gain one more mythic ability.", group: Miscellaneous, guide: "mythic-paths#extra-mythic-ability", extra_pick: MythicAbility),
    (key: "flawless-attacks", name: "Flawless Attacks", summary: "Iterative attacks take a -4 penalty each instead of -5.", group: Melee, guide: "mythic-paths#flawless-attacks"),
    (key: "great-fortitude-mythic", name: "Great Fortitude (Mythic)", summary: "Roll Fortitude saves twice and keep the better result.", group: Miscellaneous, guide: "mythic-paths#great-fortitude-mythic", prerequisite: Feat("great-fortitude")),
    (key: "improved-critical-mythic", name: "Improved Critical (Mythic)", summary: "Your chosen weapon\'s critical multiplier rises by 1.", group: Melee, guide: "mythic-paths#improved-critical-mythic", parameter: Weapon, repeat: PerValue, prerequisite: FeatForSameValue("improved-critical")),
    (key: "improved-initiative-mythic", name: "Improved Initiative (Mythic)", summary: "Add your mythic rank to initiative.", group: Miscellaneous, guide: "mythic-paths#improved-initiative-mythic", prerequisite: Feat("improved-initiative")),
    (key: "improved-unarmed-strike-mythic", name: "Improved Unarmed Strike (Mythic)", summary: "Unarmed strikes deal extra damage equal to half your mythic rank.", group: Melee, guide: "mythic-paths#improved-unarmed-strike-mythic", prerequisite: Feat("improved-unarmed-strike")),
    (key: "iron-will-mythic", name: "Iron Will (Mythic)", summary: "Roll Will saves twice and keep the better result.", group: Miscellaneous, guide: "mythic-paths#iron-will-mythic", prerequisite: Feat("iron-will")),
    (key: "lightning-reflexes-mythic", name: "Lightning Reflexes (Mythic)", summary: "Roll Reflex saves twice and keep the better result.", group: Miscellaneous, guide: "mythic-paths#lightning-reflexes-mythic", prerequisite: Feat("lightning-reflexes")),
    (key: "mythic-armor-focus-heavy-armor-assault", name: "Mythic Armor Focus (Heavy Armor) - Assault", summary: "In heavy armor, your melee hits deal an extra 1d6 slashing plus your armor\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-heavy-armor-assault", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Heavy))),
    (key: "mythic-armor-focus-heavy-armor-avoidance", name: "Mythic Armor Focus (Heavy Armor) - Avoidance", summary: "In heavy armor, add half your Strength bonus to AC in place of Dexterity, ignoring the armor\'s maximum Dexterity bonus.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-heavy-armor-avoidance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Heavy))),
    (key: "mythic-armor-focus-heavy-armor-endurance", name: "Mythic Armor Focus (Heavy Armor) - Endurance", summary: "In heavy armor, gain DR/- equal to half your armor\'s AC, stacking with other DR.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-heavy-armor-endurance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Heavy))),
    (key: "mythic-armor-focus-light-armor-assault", name: "Mythic Armor Focus (Light Armor) - Assault", summary: "In light armor with a finesse-capable weapon, gain a bonus to attack rolls equal to half your armor\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-light-armor-assault", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Light))),
    (key: "mythic-armor-focus-light-armor-avoidance", name: "Mythic Armor Focus (Light Armor) - Avoidance", summary: "In light armor, your maximum Dexterity bonus rises by your mythic rank, and attacks on you miss 5% (+5% at ranks 4, 7 and 10).", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-light-armor-avoidance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Light))),
    (key: "mythic-armor-focus-light-armor-endurance", name: "Mythic Armor Focus (Light Armor) - Endurance", summary: "In light armor, gain spell resistance equal to your armor\'s AC, stacking with other spell resistance.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-light-armor-endurance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Light))),
    (key: "mythic-armor-focus-medium-armor-assault", name: "Mythic Armor Focus (Medium Armor) - Assault", summary: "In medium armor, your melee hits deal an extra 1d6 piercing plus your armor\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-medium-armor-assault", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Medium))),
    (key: "mythic-armor-focus-medium-armor-avoidance", name: "Mythic Armor Focus (Medium Armor) - Avoidance", summary: "In medium armor, add your Constitution modifier to the armor\'s maximum Dexterity bonus.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-medium-armor-avoidance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Medium))),
    (key: "mythic-armor-focus-medium-armor-endurance", name: "Mythic Armor Focus (Medium Armor) - Endurance", summary: "In medium armor, your speed isn\'t reduced and you gain an armor bonus to AC equal to half the armor\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-armor-focus-medium-armor-endurance", prerequisite: FeatFor(feat: "armor-focus", value: ArmourType(Medium))),
    (key: "mythic-brew-potions", name: "Mythic Brew Potions", summary: "Craft potions of up to 6th level while camping.", group: Magic, guide: "mythic-paths#mythic-brew-potions", prerequisite: Feat("brew-potions")),
    (key: "mythic-buckler-flying-shield-style", name: "Mythic Buckler - Flying Shield Style", summary: "With a buckler, allies within 15 ft gain a shield bonus to AC equal to your shield\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-buckler-flying-shield-style", prerequisite: Feat("shield-focus")),
    (key: "mythic-channeling", name: "Mythic Channeling", summary: "Channel energy heals or harms an extra amount equal to twice your Charisma bonus.", group: Magic, guide: "mythic-paths#mythic-channeling", prerequisite: Feat("selective-channel")),
    (key: "mythic-heavy-shield-aggressive-block", name: "Mythic Heavy Shield - Aggressive Block", summary: "With a heavy shield, foes hitting you with non-reach melee, natural or unarmed attacks take bludgeoning equal to shield AC + Strength bonus.", group: ArmourAndShield, guide: "mythic-paths#mythic-heavy-shield-aggressive-block", prerequisite: Feat("shield-focus")),
    (key: "mythic-light-shield-deflection", name: "Mythic Light Shield - Deflection", summary: "With a light shield, gain a shield bonus to Reflex saves equal to your shield\'s AC.", group: ArmourAndShield, guide: "mythic-paths#mythic-light-shield-deflection", prerequisite: Feat("shield-focus")),
    (key: "mythic-resolve", name: "Mythic Resolve", summary: "+1 to saving throws and extra hit points equal to your mythic rank.", group: Miscellaneous, guide: "mythic-paths#mythic-resolve"),
    (key: "mythic-sneak-attack", name: "Mythic Sneak Attack", summary: "Your sneak attacks deal an extra 1d6 damage.", group: Miscellaneous, guide: "mythic-paths#mythic-sneak-attack", prerequisite: Any([Feature(feature: "alchemist/vivisectionist/sneak-attack", count: 1), Feature(feature: "arcane-trickster/sneak-attack", count: 1), Feature(feature: "assassin/sneak-attack", count: 1), Feature(feature: "inquisitor/sanctified-slayer/sneak-attack", count: 1), Feature(feature: "paladin/divine-scion/sneak-attack", count: 1), Feature(feature: "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel", count: 1), Feature(feature: "rogue/master-of-all/sneak-attack-master-of-all", count: 1), Feature(feature: "rogue/sneak-attack", count: 1), Feature(feature: "shaman/shadow-shaman/sneak-attack", count: 1), Feature(feature: "skald/inciter/sneak-attack", count: 1), Feature(feature: "slayer/imitator/sneak-attack-imitator", count: 1), Feature(feature: "slayer/sneak-attack", count: 1), Feature(feature: "trickster/sneak-attack", count: 1), Feature(feature: "warpriest/cult-leader/sneak-attack", count: 1)])),
    (key: "mythic-tower-shield-fortress", name: "Mythic Tower Shield - Fortress", summary: "With a tower shield, gain DR/- equal to your shield\'s AC, stacking with other DR.", group: ArmourAndShield, guide: "mythic-paths#mythic-tower-shield-fortress", prerequisite: Feat("shield-focus")),
    (key: "piranha-strike-mythic", name: "Piranha Strike (Mythic)", summary: "Piranha Strike\'s damage bonus rises to +3.", group: Melee, guide: "mythic-paths#piranha-strike-mythic", prerequisite: Feat("piranha-strike")),
    (key: "point-blank-shot-mythic", name: "Point-Blank Shot (Mythic)", summary: "Point-Blank Shot\'s attack and damage bonus rises to +2.", group: Ranged, guide: "mythic-paths#point-blank-shot-mythic", prerequisite: Feat("point-blank-shot")),
    (key: "power-attack-mythic", name: "Power Attack (Mythic)", summary: "Power Attack\'s damage bonus rises to +3, or +5 with two-handed grips or primary natural attacks that add 1.5x Strength.", group: Melee, guide: "mythic-paths#power-attack-mythic", prerequisite: Feat("power-attack")),
    (key: "rapid-shot-mythic", name: "Rapid Shot (Mythic)", summary: "Rapid Shot no longer gives a -2 attack penalty.", group: Ranged, guide: "mythic-paths#rapid-shot-mythic", prerequisite: Feat("rapid-shot")),
    (key: "school-mastery", name: "School Mastery", summary: "Pick a school: your spells from it gain +1 caster level.", group: Magic, guide: "mythic-paths#school-mastery", parameter: SpellSchool, repeat: PerValue),
    (key: "shield-focus-mythic", name: "Shield Focus (Mythic)", summary: "Add your shield bonus and the shield\'s enhancement bonus to touch AC.", group: ArmourAndShield, guide: "mythic-paths#shield-focus-mythic", prerequisite: Feat("shield-focus")),
    (key: "skill-focus-mythic", name: "Skill Focus (Mythic)", summary: "Take 10 on every check with one skill you have Skill Focus in.", group: Miscellaneous, guide: "mythic-paths#skill-focus-mythic", parameter: Skill, repeat: PerValue, prerequisite: FeatForSameValue("skill-focus")),
    (key: "sorcerous-reflex", name: "Sorcerous Reflex", summary: "Cast your first spell as a swift action if it is 1st level or at least two levels below your highest; not cantrips.", group: Magic, guide: "mythic-paths#sorcerous-reflex"),
    (key: "spell-focus-mythic", name: "Spell Focus (Mythic)", summary: "Spells from one school you have Spell Focus in gain +1 DC.", group: Magic, guide: "mythic-paths#spell-focus-mythic", parameter: SpellSchool, repeat: PerValue, prerequisite: FeatForSameValue("spell-focus")),
    (key: "spell-penetration-mythic", name: "Spell Penetration (Mythic)", summary: "Add MR/2 to caster level checks against spell resistance, or your full mythic rank with Greater Spell Penetration.", group: Magic, guide: "mythic-paths#spell-penetration-mythic", prerequisite: Feat("spell-penetration")),
    (key: "stunning-fist-mythic", name: "Stunning Fist (Mythic)", summary: "Stunning Fist\'s DC rises by half your mythic rank.", group: Melee, guide: "mythic-paths#stunning-fist-mythic", prerequisite: Any([Feat("stunning-fist"), Feature(feature: "monk/stunning-fist", count: 1)])),
    (key: "sunder-armor-mythic", name: "Sunder Armor (Mythic)", summary: "+MR/2 to CMB and CMD for sundering armor, and an attack of opportunity on anyone who tries to sunder yours.", group: CombatManoeuvre, guide: "mythic-paths#sunder-armor-mythic", prerequisite: Feat("sunder-armor")),
    (key: "toughness-mythic", name: "Toughness (Mythic)", summary: "Toughness gives twice the hit points, and you gain DR 10/epic while below 0 HP.", group: Miscellaneous, guide: "mythic-paths#toughness-mythic", prerequisite: Feat("toughness")),
    (key: "trip-mythic", name: "Trip (Mythic)", summary: "+MR/2 to CMB and CMD for trips, and an attack of opportunity on anyone who tries to trip you.", group: CombatManoeuvre, guide: "mythic-paths#trip-mythic", prerequisite: Feat("trip")),
    (key: "two-weapon-fighting-mythic", name: "Two-Weapon Fighting (Mythic)", summary: "Two-weapon fighting attack penalties drop by 2.", group: Melee, guide: "mythic-paths#two-weapon-fighting-mythic", prerequisite: Feat("two-weapon-fighting")),
    (key: "vital-strike-mythic", name: "Vital Strike (Mythic)", summary: "Vital Strike also multiplies your Strength bonus, weapon enhancement and other bonuses that a critical hit multiplies.", group: Melee, guide: "mythic-paths#vital-strike-mythic", prerequisite: Feat("vital-strike")),
    (key: "weapon-finesse-mythic", name: "Weapon Finesse (Mythic)", summary: "Add your Dexterity modifier to damage rolls.", group: Melee, guide: "mythic-paths#weapon-finesse-mythic", prerequisite: Feat("weapon-finesse")),
    (key: "weapon-focus-mythic", name: "Weapon Focus (Mythic)", summary: "Doubles the attack bonus from Weapon Focus and Greater Weapon Focus.", group: Melee, guide: "mythic-paths#weapon-focus-mythic", prerequisite: Feat("weapon-focus")),
    (key: "weapon-specialization-mythic", name: "Weapon Specialization (Mythic)", summary: "Extra damage equal to half your mythic rank.", group: Melee, guide: "mythic-paths#weapon-specialization-mythic", prerequisite: Feat("weapon-specialization")),
]
