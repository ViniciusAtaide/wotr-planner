            options: [
                (key: "azata/superpowers/all-skilled", blueprint: "f3bc6f9c855b2fb4e9aea364b8163aca", name: "All-skilled", summary: "+MR on all skill checks, rolled twice taking the better, and proficiency with every weapon and armor.", guide: "azata#all-skilled", feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "exotic-weapon-proficiency", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"]),
                (key: "azata/superpowers/favorable-magic", blueprint: "afcee6925a6eadf43820d12e0d966ebe", name: "Favorable Magic", summary: "Enemies roll saves against your spells twice and keep the worse; you roll concentration and spell penetration twice; half-damage saves cut only 25%.", guide: "azata#favorable-magic"),
                (key: "azata/superpowers/incredible-might", blueprint: "eef8d23a7e4acfe4d834a5de844c8c7c", name: "Incredible Might", summary: "+MR morale to attack and damage; charges and crits force a Fortitude save or a random effect from stun to death; or give allies +1 per 2 MR.", guide: "azata#incredible-might"),
                (
                    key: "azata/superpowers/life-bonding-friendship",
                    blueprint: "cfad18f581584ac4ba066df067956477",
                    name: "Life-Bonding Friendship",
                    summary: "Gain a teamwork feat now and next rank, share teamwork feats within 50 ft; allies below 0 HP fight on, then die after combat or Cha-mod hits.",
                    guide: "azata#life-bonding-friendship",
                    levels: [
                        (level: 1, feat_slots: [Category(Teamwork)]),
                        (level: 2, feat_slots: [Category(Teamwork)]),
                    ],
                ),
                (key: "azata/superpowers/marvelous-endurance", blueprint: "40c43d4d27ebde647b796f9faf4f0299", name: "Marvelous Endurance", summary: "Fast healing of MR/2 plus 5 per rank above 4; crits on you give 1d6 temporary HP per MR, and DR 10/- below 25% HP.", guide: "azata#marvelous-endurance"),
                (key: "azata/superpowers/supersonic-speed", blueprint: "505456aa17dd18a4e8bd8172811a4fdc", name: "Supersonic Speed", summary: "Permanent Haste in combat; weapon attacks against you miss 20% of the time and spells 10%, and area damage to you is halved, even after a save.", guide: "azata#supersonic-speed"),
                (key: "azata/superpowers/zippy-magic", blueprint: "30b4200f897ba25419ba3a292aed4053", name: "Zippy Magic", summary: "Single-target spells also hit another creature within 30 ft, and enemies they target take 2d6 + MR more damage; spells only, not spell-like abilities.", guide: "azata#zippy-magic"),
            ],
        ),
