MythicPath(
    key: "azata",
    name: "Azata",
    guide: "azata",
    features: [
        (key: "azata/bypass-epic-damage-reduction", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "azata/dragon-companion", name: "Dragon Companion", summary: "From rank 3, a dragon companion that grows as your mythic rank rises.", guide: "azata#dragon-companion"),
        (key: "azata/freedoms-child", name: "Freedom\'s Child", summary: "At rank 2, gain electricity resistance 20 and +4 on saves against mind-affecting effects.", guide: "azata#freedoms-child"),
        (key: "azata/hard-to-kill", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "azata/instrument-of-freedom", name: "Instrument of Freedom", summary: "A bolt, 3/day +1 per MR above 1: an ally\'s weapons gain +2d6 holy and count as good for 2 + MR rounds, or an enemy takes 4d6 + 2d6 per MR.", guide: "azata#instrument-of-freedom"),
        (key: "azata/song-of-broken-chains", name: "Song of Broken Chains", summary: "Rank 5+: while you perform, allies within 50 ft have freedom of movement and can\'t be affected by compulsion spells or spell-like abilities.", guide: "azata#song-of-broken-chains"),
        (key: "azata/song-of-courageous-defender", name: "Song of Courageous Defender", summary: "From rank 7, a companion gains DR 5/- and fear immunity, and enemies within 50 ft that fail a Will save must attack it.", guide: "azata#song-of-courageous-defender"),
        (key: "azata/song-of-defiance", name: "Song of Defiance", summary: "Rank 6+: while you perform, allies within 50 ft have DR 5/lawful and regeneration 5/lawful.", guide: "azata#song-of-defiance"),
        (key: "azata/song-of-heroic-resolve", name: "Song of Heroic Resolve", summary: "From rank 3, allies within 50 ft gain a luck bonus of MR/2 on saves and heal 2d6 + MR whenever they make a save.", guide: "azata#song-of-heroic-resolve"),
        (key: "azata/summon-astral-deva", name: "Summon Astral Deva", summary: "From rank 6, summon an Astral Deva for 1 minute.", guide: "azata#summon-astral-deva"),
        (key: "azata/summon-astral-devas", name: "Summon Astral Devas", summary: "From rank 7, summon two Astral Devas for 1 minute.", guide: "azata#summon-astral-devas"),
        (key: "azata/summon-azata-bralani", name: "Summon Azata Bralani", summary: "From rank 2, summon a Bralani azata for 1 minute.", guide: "azata#summon-azata-bralani"),
        (key: "azata/summon-azata-ghael", name: "Summon Azata Ghael", summary: "From rank 5, summon a Ghael azata for 1 minute.", guide: "azata#summon-azata-ghael"),
        (key: "azata/summon-azata-ghaels-and-astral-devas", name: "Summon Azata Ghaels and Astral Devas", summary: "From rank 8, summon 1d3+1 Ghael azatas and two Astral Devas for 1 minute.", guide: "azata#summon-azata-ghaels-and-astral-devas"),
        (key: "azata/summon-hamadryads", name: "Summon Hamadryads", summary: "From rank 9, summon 1d3+1 Hamadryads for 1 minute.", guide: "azata#summon-hamadryads"),
        (key: "azata/summon-mastodon", name: "Summon Mastodon", summary: "From rank 3, summon a Mastodon for 1 minute.", guide: "azata#summon-mastodon"),
        (key: "azata/summon-movanic-deva", name: "Summon Movanic Deva", summary: "From rank 4, summon a Movanic Deva for 1 minute.", guide: "azata#summon-movanic-deva"),
    ],
    selections: [
        (
            key: "azata/superpowers",
            name: "Superpowers",
            summary: "From rank 4, choose a superpower.",
            guide: "azata#superpowers",
            level_from: MythicRanks,
            options: [
                (key: "azata/superpowers/all-skilled", name: "All-skilled", summary: "+MR on all skill checks, rolled twice taking the better, and proficiency with every weapon and armor.", guide: "azata#all-skilled", feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "exotic-weapon-proficiency", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"]),
                (key: "azata/superpowers/favorable-magic", name: "Favorable Magic", summary: "Enemies roll saves against your spells twice and keep the worse; you roll concentration and spell penetration twice; half-damage saves cut only 25%.", guide: "azata#favorable-magic"),
                (key: "azata/superpowers/incredible-might", name: "Incredible Might", summary: "+MR morale to attack and damage; charges and crits force a Fortitude save or a random effect from stun to death; or give allies +1 per 2 MR.", guide: "azata#incredible-might"),
                (
                    key: "azata/superpowers/life-bonding-friendship",
                    name: "Life-Bonding Friendship",
                    summary: "Gain a teamwork feat now and next rank, share teamwork feats within 50 ft; allies below 0 HP fight on, then die after combat or Cha-mod hits.",
                    guide: "azata#life-bonding-friendship",
                    levels: [
                        (level: 1, feat_slots: [Category(Teamwork)]),
                        (level: 2, feat_slots: [Category(Teamwork)]),
                    ],
                ),
                (key: "azata/superpowers/marvelous-endurance", name: "Marvelous Endurance", summary: "Fast healing of MR/2 plus 5 per rank above 4; crits on you give 1d6 temporary HP per MR, and DR 10/- below 25% HP.", guide: "azata#marvelous-endurance"),
                (key: "azata/superpowers/supersonic-speed", name: "Supersonic Speed", summary: "Permanent Haste in combat; weapon attacks against you miss 20% of the time and spells 10%, and area damage to you is halved, even after a save.", guide: "azata#supersonic-speed"),
                (key: "azata/superpowers/zippy-magic", name: "Zippy Magic", summary: "Single-target spells also hit another creature within 30 ft, and enemies they target take 2d6 + MR more damage; spells only, not spell-like abilities.", guide: "azata#zippy-magic"),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["azata/bypass-epic-damage-reduction", "azata/instrument-of-freedom"]),
        (rank: 2, features: ["azata/freedoms-child", "azata/summon-azata-bralani", "azata/hard-to-kill"]),
        (rank: 3, features: ["azata/dragon-companion", "azata/song-of-heroic-resolve", "azata/summon-mastodon"]),
        (rank: 4, features: ["azata/summon-movanic-deva"], selections: ["azata/superpowers"]),
        (rank: 5, features: ["azata/song-of-broken-chains", "azata/summon-azata-ghael"]),
        (rank: 6, features: ["azata/song-of-defiance", "azata/summon-astral-deva"], selections: ["azata/superpowers"]),
        (rank: 7, features: ["azata/song-of-courageous-defender", "azata/summon-astral-devas"]),
        (rank: 8, features: ["azata/summon-azata-ghaels-and-astral-devas"], selections: ["azata/superpowers"]),
        (rank: 9, features: ["azata/summon-hamadryads"]),
        (rank: 10, selections: ["azata/superpowers"]),
    ],
)
