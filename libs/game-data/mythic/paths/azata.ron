MythicPath(
    key: "azata",
    blueprint: "9a3b2c63afa79744cbca46bea0da9a16",
    name: "Azata",
    guide: "azata",
    features: [
        (key: "azata/bypass-epic-damage-reduction", blueprint: "c60933cc085132b49970cbc4a4b8338f", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "azata/dragon-companion", blueprint: "cf36f23d60987224696f03be70351928", name: "Dragon Companion", summary: "From rank 3, a dragon companion that grows as your mythic rank rises.", guide: "azata#dragon-companion"),
        (key: "azata/freedoms-child", blueprint: "164511ae9ccec854b94b5def9d9cf0e8", name: "Freedom\'s Child", summary: "At rank 2, gain electricity resistance 20 and +4 on saves against mind-affecting effects.", guide: "azata#freedoms-child"),
        (key: "azata/hard-to-kill", blueprint: "bef12729fa3f9b34488634f61751e295", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "azata/instrument-of-freedom", blueprint: "d2cfbbb941e07b04299b617017e369f1", name: "Instrument of Freedom", summary: "A bolt, 3/day +1 per MR above 1: an ally\'s weapons gain +2d6 holy and count as good for 2 + MR rounds, or an enemy takes 4d6 + 2d6 per MR.", guide: "azata#instrument-of-freedom"),
        (key: "azata/song-of-broken-chains", blueprint: "31a8a71445f21a044b01eb877b8540db", name: "Song of Broken Chains", summary: "Rank 5+: while you perform, allies within 50 ft have freedom of movement and can\'t be affected by compulsion spells or spell-like abilities.", guide: "azata#song-of-broken-chains"),
        (key: "azata/song-of-courageous-defender", blueprint: "a1dd79df6909b0142915a3a88df4837d", name: "Song of Courageous Defender", summary: "From rank 7, a companion gains DR 5/- and fear immunity, and enemies within 50 ft that fail a Will save must attack it.", guide: "azata#song-of-courageous-defender"),
        (key: "azata/song-of-defiance", blueprint: "c2be02bc2014d4c4cbaf7c442a7f076f", name: "Song of Defiance", summary: "Rank 6+: while you perform, allies within 50 ft have DR 5/lawful and regeneration 5/lawful.", guide: "azata#song-of-defiance"),
        (key: "azata/song-of-heroic-resolve", blueprint: "90185ba04ff485845bbac7512e2c3c73", name: "Song of Heroic Resolve", summary: "From rank 3, allies within 50 ft gain a luck bonus of MR/2 on saves and heal 2d6 + MR whenever they make a save.", guide: "azata#song-of-heroic-resolve"),
        (key: "azata/summon-astral-deva", blueprint: "edc2d236d6993814fb4f09fb8d2b6c17", name: "Summon Astral Deva", summary: "From rank 6, summon an Astral Deva for 1 minute.", guide: "azata#summon-astral-deva"),
        (key: "azata/summon-astral-devas", blueprint: "ab8e798732dc2284eb7ae2b1c48b09c6", name: "Summon Astral Devas", summary: "From rank 7, summon two Astral Devas for 1 minute.", guide: "azata#summon-astral-devas"),
        (key: "azata/summon-azata-bralani", blueprint: "62ece3b9b2126a44faa276bbb5bd1014", name: "Summon Azata Bralani", summary: "From rank 2, summon a Bralani azata for 1 minute.", guide: "azata#summon-azata-bralani"),
        (key: "azata/summon-azata-ghael", blueprint: "60d146d694f1d9142b8a48e977c8e3b4", name: "Summon Azata Ghael", summary: "From rank 5, summon a Ghael azata for 1 minute.", guide: "azata#summon-azata-ghael"),
        (key: "azata/summon-azata-ghaels-and-astral-devas", blueprint: "b4ce3e07c9d974f4fa748af0e8a0a77b", name: "Summon Azata Ghaels and Astral Devas", summary: "From rank 8, summon 1d3+1 Ghael azatas and two Astral Devas for 1 minute.", guide: "azata#summon-azata-ghaels-and-astral-devas"),
        (key: "azata/summon-hamadryads", blueprint: "8403a6cec131de949b42cfa329963736", name: "Summon Hamadryads", summary: "From rank 9, summon 1d3+1 Hamadryads for 1 minute.", guide: "azata#summon-hamadryads"),
        (key: "azata/summon-mastodon", blueprint: "6190d39083ffc6b4386f86ac73a47e1f", name: "Summon Mastodon", summary: "From rank 3, summon a Mastodon for 1 minute.", guide: "azata#summon-mastodon"),
        (key: "azata/summon-movanic-deva", blueprint: "d779bcb070a85ec47a49a2723b00f79f", name: "Summon Movanic Deva", summary: "From rank 4, summon a Movanic Deva for 1 minute.", guide: "azata#summon-movanic-deva"),
    ],
    selections: [
