MythicPath(
    key: "demon",
    name: "Demon",
    guide: "demon",
    features: [
        (key: "demon/bypass-epic-damage-reduction", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "demon/close-to-the-abyss", name: "Close to the Abyss", summary: "Gain a 1d8 piercing gore as a secondary attack; it overcomes cold iron and magic damage reduction.", guide: "demon#close-to-the-abyss"),
        (key: "demon/deadly-natural-weapons", name: "Deadly Natural Weapons", summary: "Rank 7: your natural attacks bypass demon DR, act as +2 weapons and are all treated as primary attacks.", guide: "demon#deadly-natural-weapons"),
        (key: "demon/demonic-charge", name: "Demonic Charge", summary: "Rank 3+: a move-action teleport to a foe; enemies within 10 ft of where you leave and where you land take 2d6 unholy per mythic rank.", guide: "demon#demonic-charge"),
        (key: "demon/demonic-claws", name: "Demonic Claws", summary: "Rank 3+: claws at will, primary 1d8 attacks; holding a main-hand weapon makes the off-hand claw secondary.", guide: "demon#demonic-claws"),
        (key: "demon/demonic-rage", name: "Demonic Rage", summary: "From rank 3, a free-action rage 3/day: +2 attack, damage, caster level checks, Reflex and DCs; +1 use and +1 bonus at ranks 6 and 9.", guide: "demon#demonic-rage"),
        (key: "demon/demonkind", name: "Demonkind", summary: "At rank 2, gain electricity resistance 20 and immunity to poison.", guide: "demon#demonkind"),
        (key: "demon/extra-minor-aspect", name: "Extra Minor Aspect", summary: "At ranks 5 and 8, keep one more minor demonic aspect active at the same time.", guide: "demon#extra-minor-aspect"),
        (key: "demon/hard-to-kill", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "demon/oolooddroo", name: "Oolooddroo", guide: "demon"),
        (key: "demon/paianjai", name: "Paianjai", guide: "demon"),
        (key: "demon/summon-babau", name: "Summon Babau", summary: "From rank 2, summon a Babau for 1 minute.", guide: "demon#summon-babau"),
        (key: "demon/summon-balor", name: "Summon Balor", summary: "From rank 9, summon a Balor for 1 minute.", guide: "demon#summon-balor"),
        (key: "demon/summon-gibrileth", name: "Summon Gibrileth", summary: "From rank 4, summon a Gibrileth for 1 minute.", guide: "demon#summon-gibrileth"),
        (key: "demon/summon-lilitu", name: "Summon Lilitu", summary: "From rank 7, summon a Lilitu for 1 minute.", guide: "demon#summon-lilitu"),
        (key: "demon/summon-vrock", name: "Summon Vrock", summary: "From rank 3, summon a Vrock for 1 minute.", guide: "demon#summon-vrock"),
        (key: "demon/summon-vrolikai", name: "Summon Vrolikai", summary: "From rank 8, summon a Vrolikai for 1 minute.", guide: "demon#summon-vrolikai"),
        (key: "demon/true-demonkind", name: "True Demonkind", summary: "At rank 5, become immune to poison and electricity.", guide: "demon#true-demonkind"),
        (key: "demon/wings", name: "Wings", guide: "demon"),
    ],
    selections: [
        (
            key: "demon/demon-lord-aspect",
            name: "Demon Lord Aspect",
            summary: "From rank 9, while raging you can take on the aspect of a demon lord.",
            guide: "demon#demon-lord-aspect",
            options: [
                (key: "demon/demon-lord-aspect/aspect-of-areshkagal", name: "Aspect of Areshkagal", summary: "Attacks against you have a 50% miss chance.", guide: "demon#aspect-of-areshkagal"),
                (key: "demon/demon-lord-aspect/aspect-of-deskari", name: "Aspect of Deskari", summary: "Energy damage you deal turns unholy; your physical hits get past physical DR and creatures\' immunity to damage.", guide: "demon#aspect-of-deskari"),
                (key: "demon/demon-lord-aspect/aspect-of-kabriri", name: "Aspect of Kabriri", summary: "Every kill heals you.", guide: "demon#aspect-of-kabriri"),
                (key: "demon/demon-lord-aspect/aspect-of-nocticula", name: "Aspect of Nocticula", summary: "Each rage, one ally can share your Demonic Rage, with your active aspects and major aspects.", guide: "demon#aspect-of-nocticula"),
                (key: "demon/demon-lord-aspect/aspect-of-pazuzu", name: "Aspect of Pazuzu", summary: "+30 ft speed and one extra attack that stacks with rage.", guide: "demon#aspect-of-pazuzu"),
                (key: "demon/demon-lord-aspect/aspect-of-socothbenoth", name: "Aspect of Socothbenoth", summary: "Targets of your spells and abilities roll their saves twice and keep the worse result.", guide: "demon#aspect-of-socothbenoth"),
            ],
        ),
        (
            key: "demon/demonic-aspect",
            name: "Demonic Aspect",
            summary: "From rank 4, while raging you can take on a demon\'s aspect: skill bonuses plus a combat effect.",
            guide: "demon#demonic-aspect",
            options: [
                (key: "demon/demonic-aspect/aspect-of-babau", name: "Aspect of Babau", summary: "+MR/2+1 to Mobility, Trickery, Stealth; +2d6 sneak damage and 2d6 acid to non-reach melee attackers, each +1d6 at ranks 6 and 9.", guide: "demon#aspect-of-babau"),
                (key: "demon/demonic-aspect/aspect-of-brimorak", name: "Aspect of Brimorak", summary: "+MR/2+1 Mobility, Trickery, UMD; damage spells +2 per die, non-reach melee attackers take 2d6 fire; both rise at ranks 6 and 9.", guide: "demon#aspect-of-brimorak"),
                (key: "demon/demonic-aspect/aspect-of-incubus", name: "Aspect of Incubus", summary: "+MR/2+1 Athletics, Lore (Nature), Persuasion; +1 spell DCs and +4 damage, rising by 1 and 2 at ranks 6 and 9.", guide: "demon#aspect-of-incubus"),
                (key: "demon/demonic-aspect/aspect-of-kalavakus", name: "Aspect of Kalavakus", summary: "+2 CMB, CMD and natural armor (+1 at ranks 6, 9), a free attack after a successful manoeuvre, a free disarm on charges, and skill bonuses.", guide: "demon#aspect-of-kalavakus"),
                (key: "demon/demonic-aspect/aspect-of-nabasu", name: "Aspect of Nabasu", summary: "+2 on saves (+1 at ranks 6, 9); enemies within 30 ft take -1 to Fortitude and attacks, growing at 6 and 9; plus skill bonuses.", guide: "demon#aspect-of-nabasu"),
                (key: "demon/demonic-aspect/aspect-of-schir", name: "Aspect of Schir", summary: "+2 melee attack (+1 at ranks 6, 9) and Powerful Charge: two more weapon dice and an extra 1.5x Strength damage on charges; skill bonuses.", guide: "demon#aspect-of-schir"),
                (key: "demon/demonic-aspect/aspect-of-succubus", name: "Aspect of Succubus", summary: "Enemies within 30 ft take -1 Will and attack, allies gain +1 and compulsion and fear immunity; rising at ranks 6, 9; skill bonuses.", guide: "demon#aspect-of-succubus"),
                (key: "demon/demonic-aspect/aspect-of-vrock", name: "Aspect of Vrock", summary: "+2 ranged attack and -1 Reflex to enemies within 30 ft, both +1 at ranks 6 and 9; spells and abilities gain Reach; those enemies move as in difficult terrain.", guide: "demon#aspect-of-vrock"),
            ],
        ),
        (
            key: "demon/major-demonic-aspect",
            name: "Major Demonic Aspect",
            summary: "From rank 5, while raging you can take on the aspect of a major demon.",
            guide: "demon#major-demonic-aspect",
            options: [
                (key: "demon/major-demonic-aspect/aspect-of-balor", name: "Aspect of Balor", summary: "+MR/2+1 Constitution, and allies within 50 ft enter Demonic Rage with you.", guide: "demon#aspect-of-balor"),
                (key: "demon/major-demonic-aspect/aspect-of-coloxus", name: "Aspect of Coloxus", summary: "+MR/2+1 Intelligence, and you cast spells and use abilities as move actions.", guide: "demon#aspect-of-coloxus"),
                (key: "demon/major-demonic-aspect/aspect-of-omox", name: "Aspect of Omox", summary: "DR equal to MR/2+1 (bypassed by nothing); your attacks and abilities grapple targets that fail a Reflex save.", guide: "demon#aspect-of-omox"),
                (key: "demon/major-demonic-aspect/aspect-of-shadow-demon", name: "Aspect of Shadow Demon", summary: "+MR/2+1 Wisdom, and you become incorporeal.", guide: "demon#aspect-of-shadow-demon"),
                (key: "demon/major-demonic-aspect/aspect-of-vavakia", name: "Aspect of Vavakia", summary: "+MR/2+1 Strength; enemies within 50 ft take 1 + MR/3 (rounded up) unholy damage each round.", guide: "demon#aspect-of-vavakia"),
                (key: "demon/major-demonic-aspect/aspect-of-vrolikai", name: "Aspect of Vrolikai", summary: "Fast healing equal to MR/2+1; your melee attacks and spells give a negative level to enemies that fail a Will save.", guide: "demon#aspect-of-vrolikai"),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["demon/bypass-epic-damage-reduction", "demon/close-to-the-abyss"]),
        (rank: 2, features: ["demon/demonkind", "demon/summon-babau", "demon/hard-to-kill"]),
        (rank: 3, features: ["demon/demonic-charge", "demon/demonic-claws", "demon/demonic-rage", "demon/summon-vrock"]),
        (rank: 4, features: ["demon/summon-gibrileth"], selections: ["demon/demonic-aspect"]),
        (rank: 5, features: ["demon/extra-minor-aspect", "demon/oolooddroo", "demon/true-demonkind"], selections: ["demon/demonic-aspect", "demon/major-demonic-aspect", "demon/major-demonic-aspect"]),
        (rank: 6, features: ["demon/paianjai"], selections: ["demon/demonic-aspect"]),
        (rank: 7, features: ["demon/deadly-natural-weapons", "demon/summon-lilitu"], selections: ["demon/demonic-aspect", "demon/major-demonic-aspect"]),
        (rank: 8, features: ["demon/extra-minor-aspect", "demon/summon-vrolikai", "demon/wings"], selections: ["demon/demonic-aspect"]),
        (rank: 9, features: ["demon/summon-balor"], selections: ["demon/demon-lord-aspect", "demon/demonic-aspect"]),
        (rank: 10, selections: ["demon/demon-lord-aspect", "demon/demonic-aspect"]),
    ],
)
