MythicPath(
    key: "swarm-that-walks",
    name: "Swarm That Walks",
    summary: "A path taken at mythic rank 8 that drops your rank 3-7 path powers and all companions; its powers grow with the swarm size you devour.",
    guide: "other-mythic-paths#swarm-that-walks",
    switch: (kept_through_rank: 7, path_kept_through_rank: 2, further_ascensions: true),
    features: [
        (key: "swarm-that-walks/devour", name: "Devour", summary: "Eat corpses to grow your swarm: each size step costs 100 x the next size in devoured CR (12,000 CR in all for size 15).", guide: "other-mythic-paths#devour"),
        (key: "swarm-that-walks/eye-of-the-swarm", name: "Eye of the Swarm", summary: "Rank 9: swarm DR; immune to AoO, poison, disease, paralysis, stun; Str, Dex +4 + size; Swarm Form adds 4 + size damage and 4d6 (+1d6/size) to melee attackers.", guide: "other-mythic-paths#eye-of-the-swarm", ability_bonuses: [Fixed(ability: Strength, amount: 4), Fixed(ability: Dexterity, amount: 4)]),
        (key: "swarm-that-walks/host-of-the-great-swarm", name: "Host of the Great Swarm", summary: "Fast healing and extra hit points that scale with your swarm size.", guide: "other-mythic-paths#host-of-the-great-swarm"),
        (key: "swarm-that-walks/swarm-clone", name: "Swarm Clone", summary: "Make clones with your abilities and their own gear: 1 per 3 swarm size, at most 1 at rank 8, 2 at rank 9 and 5 at rank 10.", guide: "other-mythic-paths#swarm-clone"),
        (key: "swarm-that-walks/swarm-feast", name: "Swarm Feast", summary: "Enemies within 50 ft take 4d6 (+1d6 per swarm size) a round and are devoured if they die; ranged attacks on you miss 50%; ends Form and Infest.", guide: "other-mythic-paths#swarm-feast"),
        (key: "swarm-that-walks/swarm-form", name: "Swarm Form", summary: "DR 5/- plus swarm size and +4 plus swarm size natural armor; ends Swarm Feast and Swarm Infest.", guide: "other-mythic-paths#swarm-form"),
        (key: "swarm-that-walks/swarm-infest", name: "Swarm Infest", summary: "Blinds a foe for 8d8 (+2d8/size) a round, Will DC 15 + 2x MR or panicked; kills devoured; ends Form/Feast; Swarm Form ending it heals you by the damage dealt.", guide: "other-mythic-paths#swarm-infest"),
        (key: "swarm-that-walks/the-swarm", name: "The Swarm", summary: "Rank 10: +4 + swarm size to Int, Wis and Cha, spell resistance 25 + swarm size, and immunity to most harmful conditions.", guide: "other-mythic-paths#the-swarm", ability_bonuses: [Fixed(ability: Intelligence, amount: 4), Fixed(ability: Wisdom, amount: 4), Fixed(ability: Charisma, amount: 4)]),
    ],
    ranks: [
        (rank: 8, features: ["swarm-that-walks/devour", "swarm-that-walks/host-of-the-great-swarm", "swarm-that-walks/swarm-clone", "swarm-that-walks/swarm-feast", "swarm-that-walks/swarm-form", "swarm-that-walks/swarm-infest"]),
        (rank: 9, features: ["swarm-that-walks/eye-of-the-swarm"]),
        (rank: 10, features: ["swarm-that-walks/the-swarm"]),
    ],
)
