        (key: "gold-dragon/gold-dragon-form", blueprint: "2ef40c078a0a4e829ce53781c4089299", name: "Gold Dragon Form", summary: "From rank 9, become a Gold Dragon: +10 Str, +8 Con, +8 natural armor, 60 ft blindsense, and bite, claw, wing and tail attacks.", guide: "gold-dragon#gold-dragon-form"),
        (key: "gold-dragon/perfect-body", blueprint: "040bb87b39e4a7f4a8ddc011c5a50523", name: "Perfect Body", summary: "Immune to poison, disease, fear and more; energy resistance level + MR/2; saves at least 5 + MR; scores at least 14, +4 top; d12 HD; spell dice d6+; +5 weapons.", guide: "gold-dragon#perfect-body", ability_bonuses: [Highest(amount: 4), AtLeast(score: 14)]),
        (key: "gold-dragon/perfect-mind", blueprint: "d1f01519ffbe9144dac703b579a0c073", name: "Perfect Mind", summary: "Rank 9: mind-affecting immunity, SR level + MR/2, BAB at least 15 + MR (the game's code; its text says 15), all skills class skills, totals counting ranks at least MR, scores at least 18, +2 top; spell dice d8+.", guide: "gold-dragon#perfect-mind", ability_bonuses: [Highest(amount: 2), AtLeast(score: 18)], bab_at_least_mythic_rank_plus: Some(15), skill_ranks_at_least_mythic_rank: true),
        (key: "gold-dragon/perfect-soul", blueprint: "f1631a20b6f14e58924a32c81da95840", name: "Perfect Soul", summary: "Rank 10: immune to acid, cold, electricity, fire, energy drain, negative energy; all damage holy; spell dice at least d10 (else +1/die); +2 top score.", guide: "gold-dragon#perfect-soul", ability_bonuses: [Highest(amount: 2)]),
        (key: "gold-dragon/wings", blueprint: "6929bac6c67ae194c8c8446e3d593953", name: "Wings", guide: "gold-dragon"),
    ],
