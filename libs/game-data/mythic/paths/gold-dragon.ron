MythicPath(
    key: "gold-dragon",
    name: "Gold Dragon",
    guide: "gold-dragon",
    switch: (kept_through_rank: 7, path_kept_through_rank: 2, further_ascensions: true),
    features: [
        (key: "gold-dragon/gold-dragon-breath", name: "Gold Dragon Breath", summary: "A 50 ft cone of holy damage, 1d8 x (level + MR/2), Reflex half, and -1 attack (-2 on a failed save); every 1d4 rounds, 1d2 at rank 9, every round at 10.", guide: "gold-dragon#gold-dragon-breath"),
        (key: "gold-dragon/gold-dragon-form", name: "Gold Dragon Form", summary: "From rank 9, become a Gold Dragon: +10 Str, +8 Con, +8 natural armor, 60 ft blindsense, and bite, claw, wing and tail attacks.", guide: "gold-dragon#gold-dragon-form"),
        (key: "gold-dragon/perfect-body", name: "Perfect Body", summary: "Immune to poison, disease, fear and more; energy resistance of level + MR/2, saves at least 5 + MR, scores at least 14, +4 to the highest, d12 HD, +5 weapons.", guide: "gold-dragon#perfect-body", ability_bonuses: [Highest(amount: 4), AtLeast(score: 14)]),
        (key: "gold-dragon/perfect-mind", name: "Perfect Mind", summary: "Rank 9: mind-affecting immunity, SR level + MR/2, BAB at least 15, all class skills, scores at least 18, +2 to the highest; spell dice rise.", guide: "gold-dragon#perfect-mind", ability_bonuses: [Highest(amount: 2), AtLeast(score: 18)], bab_floor: Some(15), skill_ranks_at_least_mythic_rank: true),
        (key: "gold-dragon/perfect-soul", name: "Perfect Soul", summary: "Rank 10: immune to cold, fire, electricity, acid, energy drain and negative energy; all damage is holy; spell dice rise; another +2 to the top score.", guide: "gold-dragon#perfect-soul", ability_bonuses: [Highest(amount: 2)]),
        (key: "gold-dragon/wings", name: "Wings", guide: "gold-dragon"),
    ],
    selections: [
        (
            key: "gold-dragon/improved-gold-dragon-breath",
            name: "Improved Gold Dragon Breath",
            summary: "Pick an extra breath effect at each mythic rank, and three at rank 10.",
            guide: "gold-dragon#improved-gold-dragon-breath",
            options: [
                (key: "gold-dragon/improved-gold-dragon-breath/annihilating-breath", name: "Annihilating Breath", summary: "Rank 9, Vow of Dahak: living enemies hit also take negative energy damage equal to the breath\'s damage, Fortitude half.", guide: "gold-dragon#annihilating-breath", prerequisite: All([MythicRank(9), Story(VowOfDahak)])),
                (key: "gold-dragon/improved-gold-dragon-breath/decaying-breath", name: "Decaying Breath", summary: "Rank 9, Vow of Dahak: living enemies hit take 1d4 + MR/2 Constitution damage, Fortitude half.", guide: "gold-dragon#decaying-breath", prerequisite: All([MythicRank(9), Story(VowOfDahak)])),
                (key: "gold-dragon/improved-gold-dragon-breath/disrupting-breath", name: "Disrupting Breath", summary: "Undead hit also take positive energy damage equal to the breath\'s damage, Fortitude half.", guide: "gold-dragon#disrupting-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/empowered-breath", name: "Empowered Breath", summary: "The breath deals one more damage die per mythic rank.", guide: "gold-dragon#empowered-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/enlightening-breath", name: "Enlightening Breath", summary: "Rank 9, uncorrupted: the breath removes negative levels and all ability damage from allies in the area.", guide: "gold-dragon#enlightening-breath", prerequisite: All([MythicRank(9), Story(Uncorrupted)])),
                (key: "gold-dragon/improved-gold-dragon-breath/mind-clearing-breath", name: "Mind-Clearing Breath", summary: "The breath ends enemies\' mind-affecting effects on allies in the area and all mind-affecting effects on enemies hit.", guide: "gold-dragon#mind-clearing-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/overwhelming-breath", name: "Overwhelming Breath", summary: "+2x MR to the breath\'s save DC.", guide: "gold-dragon#overwhelming-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/rejuvenating-breath", name: "Rejuvenating Breath", summary: "Rank 9, uncorrupted: the breath heals allies in the area by its damage.", guide: "gold-dragon#rejuvenating-breath", prerequisite: All([MythicRank(9), Story(Uncorrupted)])),
                (key: "gold-dragon/improved-gold-dragon-breath/scorching-breath", name: "Scorching Breath", summary: "Enemies that fail the save catch fire, taking the breath\'s damage each round until they pass a Reflex save.", guide: "gold-dragon#scorching-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/spellbane-breath", name: "Spellbane Breath", summary: "Enemies hit take -MR/2 to their spell save DCs for 1d4+1 rounds.", guide: "gold-dragon#spellbane-breath"),
            ],
        ),
    ],
    feat_lists: [
        (key: "gold-dragon/dragon-feats", name: "Dragon Feats", guide: "gold-dragon#dragon-feats", ignores_prerequisites: true, every_feat: true),
    ],
    ranks: [
        (rank: 8, features: ["gold-dragon/gold-dragon-breath", "gold-dragon/perfect-body", "gold-dragon/wings"], selections: ["gold-dragon/improved-gold-dragon-breath"]),
        (rank: 9, features: ["gold-dragon/gold-dragon-form", "gold-dragon/perfect-mind"], feat_slots: [OneOf(list: "gold-dragon/dragon-feats"), OneOf(list: "gold-dragon/dragon-feats"), OneOf(list: "gold-dragon/dragon-feats")], selections: ["gold-dragon/improved-gold-dragon-breath"]),
        (rank: 10, features: ["gold-dragon/perfect-soul"], selections: ["gold-dragon/improved-gold-dragon-breath", "gold-dragon/improved-gold-dragon-breath", "gold-dragon/improved-gold-dragon-breath"]),
    ],
)
