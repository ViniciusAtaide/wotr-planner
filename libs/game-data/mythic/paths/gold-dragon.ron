                (key: "gold-dragon/improved-gold-dragon-breath/decaying-breath", blueprint: "c606a6897125480ebde14b63bb8fb18e", name: "Decaying Breath", summary: "Rank 9, Vow of Dahak: the breath deals 1d4 + MR/2 Constitution damage to living foes, Fortitude half.", guide: "gold-dragon#decaying-breath", prerequisite: All([MythicRank(9), Story(VowOfDahak)])),
                (key: "gold-dragon/improved-gold-dragon-breath/disrupting-breath", blueprint: "eb26e9df19a54ae2a634828f1cb7a708", name: "Disrupting Breath", summary: "Undead hit also take positive energy damage equal to the breath\'s damage, Fortitude half.", guide: "gold-dragon#disrupting-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/empowered-breath", blueprint: "d6fa1c8aead34a2ba2c18fc7a41a649c", name: "Empowered Breath", summary: "The breath deals one more damage die per mythic rank.", guide: "gold-dragon#empowered-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/enlightening-breath", blueprint: "0351c6c95adc48b3b39073167094cd19", name: "Enlightening Breath", summary: "Rank 9, uncorrupted: the breath removes negative levels and all ability damage from allies in the area.", guide: "gold-dragon#enlightening-breath", prerequisite: All([MythicRank(9), Story(Uncorrupted)])),
                (key: "gold-dragon/improved-gold-dragon-breath/mind-clearing-breath", blueprint: "a9ce14a6601c4bd1aea5d29d41e9162d", name: "Mind-Clearing Breath", summary: "The breath ends enemies\' mind-affecting effects on allies in the area and all mind-affecting effects on enemies hit.", guide: "gold-dragon#mind-clearing-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/overwhelming-breath", blueprint: "9266dd19a70f44068929107484dc1250", name: "Overwhelming Breath", summary: "+2x MR to the breath\'s save DC.", guide: "gold-dragon#overwhelming-breath"),
                (key: "gold-dragon/improved-gold-dragon-breath/rejuvenating-breath", blueprint: "ef3690c36872422d9bfadeb276b5c3fe", name: "Rejuvenating Breath", summary: "Rank 9, uncorrupted: allies caught in the breath regain hit points equal to the damage it deals.", guide: "gold-dragon#rejuvenating-breath", prerequisite: All([MythicRank(9), Story(Uncorrupted)])),
                (key: "gold-dragon/improved-gold-dragon-breath/scorching-breath", blueprint: "0cc6e15e961b4bb9b4328002cbc57388", name: "Scorching Breath", summary: "Enemies that fail the save catch fire, taking the breath\'s damage each round until they pass a Reflex save.", guide: "gold-dragon#scorching-breath"),
