MythicPath(
    key: "devil",
    name: "Devil",
    summary: "A path taken at mythic rank 8 after Aeon or Azata; Azatas lose their dragon and Aeons their gazes.",
    guide: "other-mythic-paths#devil",
    switch: (from: ["aeon", "azata"], kept_through_rank: 7, path_kept_through_rank: 7, dropped_features: ["aeon/enforcing-gaze-extra-gaze", "azata/dragon-companion"], dropped_selections: ["aeon/enforcing-gaze"], further_ascensions: true),
    features: [
        (key: "devil/hells-authority", name: "Hell\'s Authority", summary: "3/day, use Sword of Heaven with one improvement or Demonic Rage with one aspect for 10 minutes.", guide: "other-mythic-paths#hells-authority"),
        (key: "devil/hells-dominance", name: "Hell\'s Dominance", summary: "Dominate Monster at will as a spell-like ability, fire resistance 20 and +4 on saves against poison.", guide: "other-mythic-paths#hells-dominance"),
        (key: "devil/hells-rule", name: "Hell\'s Rule", summary: "Overwhelming Presence and Power Word: Kill as spell-like abilities at will.", guide: "other-mythic-paths#hells-rule"),
        (key: "devil/hells-vengeance", name: "Hell\'s Vengeance", summary: "Hellfire Ray and Power Word: Stun at will, fire immunity, acid and cold resistance 10, and weapons count as lawful and evil against DR.", guide: "other-mythic-paths#hells-vengeance"),
        (key: "devil/wings", name: "Wings", guide: "other-mythic-paths#devil"),
    ],
    selections: [
        (
            key: "devil/hells-decree",
            name: "Hell\'s Decree",
            summary: "Issue decrees MR times a day; any save is DC 10 + twice your mythic rank.",
            guide: "other-mythic-paths#hells-decree",
            options: [
                (key: "devil/hells-decree/decree-of", name: "Decree of <SCHOOL>", summary: "An ally may cast spells of only one school, and their DCs rise by your mythic rank.", guide: "other-mythic-paths#decree-of"),
                (key: "devil/hells-decree/decree-of-hells-fires", name: "Decree of Hell\'s Fires", summary: "Enemies within 50 ft take 2d10 + MR half fire, half holy; those under 10x MR hit points must pass a Fortitude save or die.", guide: "other-mythic-paths#decree-of-hells-fires"),
                (key: "devil/hells-decree/decree-of-hunt", name: "Decree of Hunt", summary: "Mark an ally as hunter and an enemy as quarry: the hunter gains +MR attack and damage but leaves your control.", guide: "other-mythic-paths#decree-of-hunt"),
                (key: "devil/hells-decree/decree-of-neverending-war", name: "Decree of Neverending War", summary: "Enemies within 50 ft that fail a Will save start attacking anyone nearby.", guide: "other-mythic-paths#decree-of-neverending-war"),
                (key: "devil/hells-decree/decree-of-vengeance", name: "Decree of Vengeance", summary: "An ally attacks indiscriminately with 10x MR temporary HP; each kill adds DR 5/good, +2 CMD and +2 vs. movement effects, up to 5 times.", guide: "other-mythic-paths#decree-of-vengeance"),
            ],
        ),
        (
            key: "devil/hells-seal",
            name: "Hell\'s Seal",
            summary: "Place a seal on an ally MR times a day; each ally can hold only one seal at a time.",
            guide: "other-mythic-paths#hells-seal",
            options: [
                (key: "devil/hells-seal/seal-of-burning-flames", name: "Seal of Burning Flames", summary: "When the ally drops below 15x MR hit points, enemies take 1d8 per MR and, failing Reflex, burn for 2d6 a round.", guide: "other-mythic-paths#seal-of-burning-flames"),
                (key: "devil/hells-seal/seal-of-devouring-flames", name: "Seal of Devouring Flames", summary: "When the ally drops below 5x MR hit points, they die and deal 2d10 per MR to enemies within 30 ft.", guide: "other-mythic-paths#seal-of-devouring-flames"),
                (key: "devil/hells-seal/seal-of-fear-eater", name: "Seal of Fear Eater", summary: "Instead of being shaken or frightened, the ally gains Heroic Invocation and Rage for MR rounds.", guide: "other-mythic-paths#seal-of-fear-eater"),
                (key: "devil/hells-seal/seal-of-fire-eating", name: "Seal of Fire Eating", summary: "Fire damage heals the ally 3d6 per MR, and their attacks deal +2d6 unholy damage for MR rounds.", guide: "other-mythic-paths#seal-of-fire-eating"),
                (key: "devil/hells-seal/seal-of-reflective-mind", name: "Seal of Reflective Mind", summary: "The ally automatically saves against enchantments and illusions and reflects them at the caster with DC + MR/2.", guide: "other-mythic-paths#seal-of-reflective-mind"),
            ],
        ),
    ],
    ranks: [
        (rank: 8, features: ["devil/hells-dominance", "devil/wings"], selections: ["devil/hells-decree"]),
        (rank: 9, features: ["devil/hells-vengeance"], selections: ["devil/hells-seal"]),
        (rank: 10, features: ["devil/hells-authority", "devil/hells-rule"]),
    ],
)
