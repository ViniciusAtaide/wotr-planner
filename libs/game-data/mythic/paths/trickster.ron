MythicPath(
    key: "trickster",
    name: "Trickster",
    guide: "trickster",
    features: [
        (key: "trickster/bit-of-fun", name: "Bit of Fun", summary: "3/day, create three illusory copies of yourself that last 1 minute per mythic rank.", guide: "trickster#bit-of-fun"),
        (key: "trickster/bypass-epic-damage-reduction", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "trickster/creative-approach", name: "Creative Approach", summary: "At rank 2, gain a +3 circumstance bonus on all skill checks.", guide: "trickster#creative-approach"),
        (key: "trickster/hard-to-kill", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "trickster/sneak-attack", name: "Sneak Attack", summary: "+2d6 sneak attack at rank 3, plus 1d6 more at ranks 5, 7 and 9.", guide: "trickster#sneak-attack"),
        (key: "trickster/sneaky-quack", name: "Sneaky Quack", summary: "From rank 3, your healing spells on an ally denied their Dexterity bonus restore 1d6 more per sneak attack die; you count as an ally.", guide: "trickster#sneaky-quack"),
        (key: "trickster/summon-nixie-prankster", name: "Summon Nixie Prankster", summary: "From rank 3, summon a Nixie Prankster for 1 minute.", guide: "trickster#summon-nixie-prankster"),
        (key: "trickster/summon-redcaps", name: "Summon Redcaps", summary: "From rank 4, summon a group of Redcaps for 1 minute.", guide: "trickster#summon-redcaps"),
        (key: "trickster/summon-wild-hunt-archer", name: "Summon Wild Hunt Archer", summary: "From rank 5, summon a Wild Hunt Archer for 1 minute.", guide: "trickster#summon-wild-hunt-archer"),
        (key: "trickster/summon-wild-hunt-i", name: "Summon Wild Hunt (I)", summary: "From rank 7, summon a Wild Hunt Archer and a Wild Hunt Scout for 1 minute.", guide: "trickster#summon-wild-hunt-i"),
        (key: "trickster/summon-wild-hunt-ii", name: "Summon Wild Hunt (II)", summary: "From rank 9, summon a Wild Hunt battle party for 1 minute.", guide: "trickster#summon-wild-hunt-ii"),
        (key: "trickster/summon-wild-hunt-monarch", name: "Summon Wild Hunt Monarch", summary: "From rank 8, summon a Wild Hunt Monarch for 1 minute.", guide: "trickster#summon-wild-hunt-monarch"),
        (key: "trickster/summon-wild-hunt-scout", name: "Summon Wild Hunt Scout", summary: "From rank 6, summon a Wild Hunt Scout for 1 minute.", guide: "trickster#summon-wild-hunt-scout"),
        (key: "trickster/summon-will-o-wisp", name: "Summon Will-o\'-Wisp", summary: "From rank 2, summon a Will-o\'-Wisp for 1 minute.", guide: "trickster#summon-will-o-wisp"),
    ],
    selections: [
        (
            key: "trickster/greater-mythic-trick",
            name: "Greater Mythic Trick",
            summary: "At ranks 7 and 10, raise one of your second-tier mythic tricks to its third tier.",
            guide: "trickster#greater-mythic-trick",
            options: [
                (key: "trickster/greater-mythic-trick/athletics-iii", name: "Athletics III", summary: "BAB can\'t be lower than your Athletics ranks (Athletics + 5 when BAB already equals your character level).", guide: "trickster#athletics-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/athletics-ii")),
                (key: "trickster/greater-mythic-trick/knowledge-arcana-iii", name: "Knowledge (Arcana) III", summary: "Each item you identify gains one more random major effect.", guide: "trickster#knowledge-arcana-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/knowledge-arcana-ii")),
                (key: "trickster/greater-mythic-trick/knowlege-world-iii", name: "Knowlege (World) III", summary: "Feat prerequisites stop applying to you and your allies at level-up.", guide: "trickster#knowlege-world-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/knowledge-world-ii")),
                (key: "trickster/greater-mythic-trick/lore-nature-iii", name: "Lore (Nature) III", summary: "Each hunt turns up random magic items.", guide: "trickster#lore-nature-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/lore-nature-ii")),
                (key: "trickster/greater-mythic-trick/lore-religion-iii", name: "Lore (Religion) III", summary: "Choose two more domains.", guide: "trickster#lore-religion-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/lore-religion-ii")),
                (key: "trickster/greater-mythic-trick/mobility-iii", name: "Mobility III", summary: "When hit, roll Mobility at -10 against the attack roll; if you beat it, the attack misses.", guide: "trickster#mobility-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/mobility-ii")),
                (key: "trickster/greater-mythic-trick/perception-iii", name: "Perception III", summary: "Gain two first-tier mythic tricks that you can swap each day.", guide: "trickster#perception-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/perception-ii")),
                (key: "trickster/greater-mythic-trick/persuasion-iii", name: "Persuasion III", summary: "Enemies that fail their save against your demoralise spend their first round attempting a coup de grace on themselves.", guide: "trickster#persuasion-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/persuasion-ii")),
                (key: "trickster/greater-mythic-trick/stealth-iii", name: "Stealth III", summary: "SR of Stealth bonus - 10.", guide: "trickster#stealth-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/stealth-ii")),
                (key: "trickster/greater-mythic-trick/trickery-iii", name: "Trickery III", summary: "Disable a living creature: on a failed Fortitude save (DC 15 + Trickery ranks), it dies.", guide: "trickster#trickery-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/trickery-ii")),
                (key: "trickster/greater-mythic-trick/use-magic-device-iii", name: "Use Magic Device III", summary: "A spellbook of your own: scroll spells can be scribed into it as by a wizard of your character level.", guide: "trickster#use-magic-device-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/reuse-magic-device")),
            ],
        ),
        (
            key: "trickster/improved-mythic-trick",
            name: "Improved Mythic Trick",
            summary: "At ranks 4, 6, 8 and 9, raise one of your first-tier mythic tricks to its second tier.",
            guide: "trickster#improved-mythic-trick",
            options: [
                (key: "trickster/improved-mythic-trick/athletics-ii", name: "Athletics II", summary: "After a failed save, an Athletics check against the save DC + 20 turns it into a success.", guide: "trickster#athletics-ii", prerequisite: SelectionOption("trickster/mythic-trick/athletics-i")),
                (key: "trickster/improved-mythic-trick/knowledge-arcana-ii", name: "Knowledge (Arcana) II", summary: "Each item you identify gains one more random minor effect.", guide: "trickster#knowledge-arcana-ii", prerequisite: SelectionOption("trickster/mythic-trick/knowledge-arcana-i")),
                (key: "trickster/improved-mythic-trick/knowledge-world-ii", name: "Knowledge (World) II", summary: "A natural 1 on a d20 by you or an ally counts as a 20.", guide: "trickster#knowledge-world-ii", prerequisite: SelectionOption("trickster/mythic-trick/knowledge-world-i")),
                (key: "trickster/improved-mythic-trick/lore-nature-ii", name: "Lore (Nature) II", summary: "Hunting also brings in gold, potions, scrolls and other loot.", guide: "trickster#lore-nature-ii", prerequisite: SelectionOption("trickster/mythic-trick/lore-nature-i")),
                (key: "trickster/improved-mythic-trick/lore-religion-ii", name: "Lore (Religion) II", summary: "Choose two domains: gain their powers and cast their spells of levels below your mythic rank once a day each.", guide: "trickster#lore-religion-ii", prerequisite: SelectionOption("trickster/mythic-trick/lore-religion-i")),
                (key: "trickster/improved-mythic-trick/mobility-ii", name: "Mobility II", summary: "Dodging an attack of opportunity with Mobility lets you make one back, and the enemy is flat-footed.", guide: "trickster#mobility-ii", prerequisite: SelectionOption("trickster/mythic-trick/mobility-i")),
                (key: "trickster/improved-mythic-trick/perception-ii", name: "Perception II", summary: "Stealthy creatures are always noticed, and the Trickster feat list opens to you and your companions.", guide: "trickster#perception-ii", prerequisite: SelectionOption("trickster/mythic-trick/perception-i")),
                (key: "trickster/improved-mythic-trick/persuasion-ii", name: "Persuasion II", summary: "Demoralised enemies are paralysed unless they pass a Will save (DC 10 + Persuasion ranks), retrying each round.", guide: "trickster#persuasion-ii", prerequisite: SelectionOption("trickster/mythic-trick/persuasion-i")),
                (key: "trickster/improved-mythic-trick/reuse-magic-device", name: "Reuse Magic Device", summary: "Wands use no charges, and you can equip any magic item regardless of its requirements.", guide: "trickster#reuse-magic-device", prerequisite: SelectionOption("trickster/mythic-trick/infuse-magic-device")),
                (key: "trickster/improved-mythic-trick/stealth-ii", name: "Stealth II", summary: "Stealth in combat acts as Greater Invisibility.", guide: "trickster#stealth-ii", prerequisite: SelectionOption("trickster/mythic-trick/stealth-i")),
                (key: "trickster/improved-mythic-trick/trickery-ii", name: "Trickery II", summary: "A Trickery check at -20 stands in for the caster level check to Greater Dispel Magic everything on a target or area.", guide: "trickster#trickery-ii", prerequisite: SelectionOption("trickster/mythic-trick/trickery-i")),
            ],
        ),
        (
            key: "trickster/mythic-trick",
            name: "Mythic Trick",
            summary: "From rank 3, at every rank, gain a creative use of one of your skills.",
            guide: "trickster#mythic-trick",
            options: [
                (key: "trickster/mythic-trick/athletics-i", name: "Athletics I", summary: "Each round, try an Athletics check (original save DC + 15) to shake off a negative condition.", guide: "trickster#athletics-i"),
                (key: "trickster/mythic-trick/infuse-magic-device", name: "Infuse Magic Device", summary: "Abilities of magic items you use gain your mythic rank to their caster level.", guide: "trickster#infuse-magic-device"),
                (key: "trickster/mythic-trick/knowledge-arcana-i", name: "Knowledge (Arcana) I", summary: "When you are the one identifying an item, its enhancement bonus goes up by 1.", guide: "trickster#knowledge-arcana-i"),
                (key: "trickster/mythic-trick/knowledge-world-i", name: "Knowledge (World) I", summary: "You and allies within 50 ft add half your mythic rank to skill checks.", guide: "trickster#knowledge-world-i"),
                (key: "trickster/mythic-trick/lore-nature-i", name: "Lore (Nature) I", summary: "After each rest you find one random potion, one random scroll and ingredients for a beneficial meal.", guide: "trickster#lore-nature-i"),
                (key: "trickster/mythic-trick/lore-religion-i", name: "Lore (Religion) I", summary: "Treat Affliction removes every negative condition, not just poisons and diseases.", guide: "trickster#lore-religion-i"),
                (key: "trickster/mythic-trick/mobility-i", name: "Mobility I", summary: "Your movement speed rises by half.", guide: "trickster#mobility-i"),
                (key: "trickster/mythic-trick/perception-i", name: "Perception I", summary: "See Invisibility is always on.", guide: "trickster#perception-i"),
                (key: "trickster/mythic-trick/persuasion-i", name: "Persuasion I", summary: "Enemies that start combat against you are demoralised automatically.", guide: "trickster#persuasion-i"),
                (key: "trickster/mythic-trick/stealth-i", name: "Stealth I", summary: "Stealth takes only a move action, and creatures that fail Perception against you treat you as totally concealed.", guide: "trickster#stealth-i"),
                (key: "trickster/mythic-trick/trickery-i", name: "Trickery I", summary: "Dispel effects on a target or area as Dispel Magic, using a Trickery check at -10 for the caster level check; not at range.", guide: "trickster#trickery-i"),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["trickster/bypass-epic-damage-reduction", "trickster/bit-of-fun"]),
        (rank: 2, features: ["trickster/hard-to-kill", "trickster/creative-approach", "trickster/summon-will-o-wisp"]),
        (rank: 3, features: ["trickster/sneak-attack", "trickster/sneak-attack", "trickster/sneaky-quack", "trickster/summon-nixie-prankster"], selections: ["trickster/mythic-trick"]),
        (rank: 4, features: ["trickster/summon-redcaps"], selections: ["trickster/improved-mythic-trick", "trickster/mythic-trick"]),
        (rank: 5, features: ["trickster/sneak-attack", "trickster/summon-wild-hunt-archer"], selections: ["trickster/mythic-trick"]),
        (rank: 6, features: ["trickster/summon-wild-hunt-scout"], selections: ["trickster/improved-mythic-trick", "trickster/mythic-trick"]),
        (rank: 7, features: ["trickster/sneak-attack", "trickster/summon-wild-hunt-i"], selections: ["trickster/greater-mythic-trick", "trickster/mythic-trick"]),
        (rank: 8, features: ["trickster/summon-wild-hunt-monarch"], selections: ["trickster/improved-mythic-trick", "trickster/mythic-trick"]),
        (rank: 9, features: ["trickster/sneak-attack", "trickster/summon-wild-hunt-ii"], selections: ["trickster/improved-mythic-trick", "trickster/mythic-trick"]),
        (rank: 10, selections: ["trickster/greater-mythic-trick", "trickster/mythic-trick"]),
    ],
)
