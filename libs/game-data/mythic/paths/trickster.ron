MythicPath(
    key: "trickster",
    blueprint: "8df873a8c6e48294abdb78c45834aa0a",
    name: "Trickster",
    guide: "trickster",
    features: [
        (key: "trickster/bit-of-fun", blueprint: "2df27c2ac48abd949bdf891c6adb625e", name: "Bit of Fun", summary: "3/day, create three illusory copies of yourself that last 1 minute per mythic rank.", guide: "trickster#bit-of-fun"),
        (key: "trickster/bypass-epic-damage-reduction", blueprint: "c60933cc085132b49970cbc4a4b8338f", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "trickster/creative-approach", blueprint: "4cd530e060eccbc4b99f232abbf9c3f1", name: "Creative Approach", summary: "At rank 2, gain a +3 circumstance bonus on all skill checks.", guide: "trickster#creative-approach"),
        (key: "trickster/hard-to-kill", blueprint: "bef12729fa3f9b34488634f61751e295", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "trickster/sneak-attack", blueprint: "9b9eac6709e1c084cb18c3a366e0ec87", name: "Sneak Attack", summary: "+2d6 sneak attack at rank 3, plus 1d6 more at ranks 5, 7 and 9.", guide: "trickster#sneak-attack"),
        (key: "trickster/sneaky-quack", blueprint: "bf41d492ff138ae4e9775e6fd9c8011e", name: "Sneaky Quack", summary: "From rank 3, your healing spells on an ally denied their Dexterity bonus restore 1d6 more per sneak attack die; you count as an ally.", guide: "trickster#sneaky-quack"),
        (key: "trickster/summon-nixie-prankster", blueprint: "512e77595f0524147bb3381247a55eec", name: "Summon Nixie Prankster", summary: "From rank 3, summon a Nixie Prankster for 1 minute.", guide: "trickster#summon-nixie-prankster"),
        (key: "trickster/summon-redcaps", blueprint: "e45e74f729caae944a06cbfa5794478f", name: "Summon Redcaps", summary: "From rank 4, summon a group of Redcaps for 1 minute.", guide: "trickster#summon-redcaps"),
        (key: "trickster/summon-wild-hunt-archer", blueprint: "f9b6ab05321dd7c41b8f575d3e56fc2a", name: "Summon Wild Hunt Archer", summary: "From rank 5, summon a Wild Hunt Archer for 1 minute.", guide: "trickster#summon-wild-hunt-archer"),
        (key: "trickster/summon-wild-hunt-i", blueprint: "b09dffefcb537a74083459167444c927", name: "Summon Wild Hunt (I)", summary: "From rank 7, summon a Wild Hunt Archer and a Wild Hunt Scout for 1 minute.", guide: "trickster#summon-wild-hunt-i"),
        (key: "trickster/summon-wild-hunt-ii", blueprint: "47b2a61348ebd554eb0adf10d17f8b18", name: "Summon Wild Hunt (II)", summary: "From rank 9, summon a Wild Hunt battle party for 1 minute.", guide: "trickster#summon-wild-hunt-ii"),
        (key: "trickster/summon-wild-hunt-monarch", blueprint: "982deaae08d0c9741a827cdf21aecd80", name: "Summon Wild Hunt Monarch", summary: "From rank 8, summon a Wild Hunt Monarch for 1 minute.", guide: "trickster#summon-wild-hunt-monarch"),
        (key: "trickster/summon-wild-hunt-scout", blueprint: "d09c2e6528a24a54db9e20dfd2363af5", name: "Summon Wild Hunt Scout", summary: "From rank 6, summon a Wild Hunt Scout for 1 minute.", guide: "trickster#summon-wild-hunt-scout"),
        (key: "trickster/summon-will-o-wisp", blueprint: "8963c914c07ccd0489d1d34a8d1a5865", name: "Summon Will-o\'-Wisp", summary: "From rank 2, summon a Will-o\'-Wisp for 1 minute.", guide: "trickster#summon-will-o-wisp"),
    ],
    selections: [
        (
            key: "trickster/greater-mythic-trick",
            blueprint: "446f4a8b32019f5478a8dfeddac74710",
            name: "Greater Mythic Trick",
            summary: "At ranks 7 and 10, raise one of your second-tier mythic tricks to its third tier.",
            guide: "trickster#greater-mythic-trick",
            options: [
                (key: "trickster/greater-mythic-trick/athletics-iii", blueprint: "e45bf795c4f84c3b8a83c011f8580491", name: "Athletics III", summary: "BAB can\'t be lower than your Athletics ranks (Athletics + 5 when BAB already equals your character level).", guide: "trickster#athletics-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/athletics-ii"), bab_from_ranks: Some((skill: "athletics", extra_at_full_bab: 5))),
                (key: "trickster/greater-mythic-trick/knowledge-arcana-iii", blueprint: "5e26c673173e423881e318d2f0ae84f0", name: "Knowledge (Arcana) III", summary: "Each item you identify gains one more random major effect.", guide: "trickster#knowledge-arcana-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/knowledge-arcana-ii")),
                (key: "trickster/greater-mythic-trick/knowlege-world-iii", blueprint: "26691ec239c84568bd27b055a1528912", name: "Knowlege (World) III", summary: "Feat prerequisites stop applying to you and your allies at level-up.", guide: "trickster#knowlege-world-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/knowledge-world-ii")),
                (key: "trickster/greater-mythic-trick/lore-nature-iii", blueprint: "b88ca3a5476ebcc4ea63d5c1e92ce222", name: "Lore (Nature) III", summary: "Each hunt turns up random magic items.", guide: "trickster#lore-nature-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/lore-nature-ii")),
                (key: "trickster/greater-mythic-trick/lore-religion-iii", blueprint: "eb196db561554341a571acb3216fc1dc", name: "Lore (Religion) III", summary: "Choose two more domains.", guide: "trickster#lore-religion-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/lore-religion-ii")),
                (key: "trickster/greater-mythic-trick/mobility-iii", blueprint: "6db3651d9af54f28b5a3a5570f49f349", name: "Mobility III", summary: "When hit, roll Mobility at -10 against the attack roll; if you beat it, the attack misses.", guide: "trickster#mobility-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/mobility-ii")),
                (key: "trickster/greater-mythic-trick/perception-iii", blueprint: "c785d2718021449f895a960c7840b4d0", name: "Perception III", summary: "Gain two first-tier mythic tricks that you can swap each day.", guide: "trickster#perception-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/perception-ii")),
                (key: "trickster/greater-mythic-trick/persuasion-iii", blueprint: "9f677bc314b84cc388044c3786148fd9", name: "Persuasion III", summary: "A demoralised foe that fails its save wastes its first round trying to coup de grace itself.", guide: "trickster#persuasion-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/persuasion-ii")),
                (key: "trickster/greater-mythic-trick/stealth-iii", blueprint: "74d23b6698554e36974711eacc386290", name: "Stealth III", summary: "SR of Stealth bonus - 10.", guide: "trickster#stealth-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/stealth-ii")),
                (key: "trickster/greater-mythic-trick/trickery-iii", blueprint: "64131f0ac1e2497a806856461bdcfe4e", name: "Trickery III", summary: "Disable a living creature: on a failed Fortitude save (DC 15 + Trickery ranks), it dies.", guide: "trickster#trickery-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/trickery-ii")),
                (key: "trickster/greater-mythic-trick/use-magic-device-iii", blueprint: "9d1446e4947544429a64e5fa20906ebf", name: "Use Magic Device III", summary: "A spellbook of your own: scroll spells can be scribed into it as by a wizard of your character level.", guide: "trickster#use-magic-device-iii", prerequisite: SelectionOption("trickster/improved-mythic-trick/reuse-magic-device")),
            ],
        ),
        (
            key: "trickster/improved-mythic-trick",
            blueprint: "5cd96c3460844fc458dc3e1656dafa42",
            name: "Improved Mythic Trick",
            summary: "At ranks 4, 6, 8 and 9, raise one of your first-tier mythic tricks to its second tier.",
            guide: "trickster#improved-mythic-trick",
            options: [
                (key: "trickster/improved-mythic-trick/athletics-ii", blueprint: "198b6abf58a36404f8189787a082fa02", name: "Athletics II", summary: "After a failed save, an Athletics check against the save DC + 20 turns it into a success.", guide: "trickster#athletics-ii", prerequisite: SelectionOption("trickster/mythic-trick/athletics-i")),
                (key: "trickster/improved-mythic-trick/knowledge-arcana-ii", blueprint: "7bbd9f681440a294382b527a554e419d", name: "Knowledge (Arcana) II", summary: "Each item you identify gains one more random minor effect.", guide: "trickster#knowledge-arcana-ii", prerequisite: SelectionOption("trickster/mythic-trick/knowledge-arcana-i")),
                (key: "trickster/improved-mythic-trick/knowledge-world-ii", blueprint: "8b6fe337865492645892cc8db5dd0e01", name: "Knowledge (World) II", summary: "A natural 1 on a d20 by you or an ally counts as a 20.", guide: "trickster#knowledge-world-ii", prerequisite: SelectionOption("trickster/mythic-trick/knowledge-world-i")),
                (key: "trickster/improved-mythic-trick/lore-nature-ii", blueprint: "9c437a5ba123619448322642ffbdc9e1", name: "Lore (Nature) II", summary: "Hunting also brings in gold, potions, scrolls and other loot.", guide: "trickster#lore-nature-ii", prerequisite: SelectionOption("trickster/mythic-trick/lore-nature-i")),
                (key: "trickster/improved-mythic-trick/lore-religion-ii", blueprint: "fd158d5f035346288776f18e76f6721e", name: "Lore (Religion) II", summary: "Choose two domains: gain their powers and cast their spells of levels below your mythic rank once a day each.", guide: "trickster#lore-religion-ii", prerequisite: SelectionOption("trickster/mythic-trick/lore-religion-i")),
                (key: "trickster/improved-mythic-trick/mobility-ii", blueprint: "d6bf5da423ddc7d4cb9cf46c5dbb7eb3", name: "Mobility II", summary: "Dodging an attack of opportunity with Mobility lets you make one back, and the enemy is flat-footed.", guide: "trickster#mobility-ii", prerequisite: SelectionOption("trickster/mythic-trick/mobility-i")),
                (key: "trickster/improved-mythic-trick/perception-ii", blueprint: "e9298851786c5334dba1398e9635a83d", name: "Perception II", summary: "Stealthy creatures are always noticed, and the Trickster feat list opens to you and your companions.", guide: "trickster#perception-ii", prerequisite: SelectionOption("trickster/mythic-trick/perception-i")),
                (key: "trickster/improved-mythic-trick/persuasion-ii", blueprint: "420bd51aa7d96fc4a8d3cc3bd7cddaa1", name: "Persuasion II", summary: "Demoralised enemies are paralysed unless they pass a Will save (DC 10 + Persuasion ranks), retrying each round.", guide: "trickster#persuasion-ii", prerequisite: SelectionOption("trickster/mythic-trick/persuasion-i")),
                (key: "trickster/improved-mythic-trick/reuse-magic-device", blueprint: "1383f21534d8b6a45bdbdc8ddce7a187", name: "Reuse Magic Device", summary: "Wands use no charges, and you can equip any magic item regardless of its requirements.", guide: "trickster#reuse-magic-device", prerequisite: SelectionOption("trickster/mythic-trick/infuse-magic-device")),
                (key: "trickster/improved-mythic-trick/stealth-ii", blueprint: "0d1071f085c5c4f408cd2bf1ec4f6adc", name: "Stealth II", summary: "Stealth in combat acts as Greater Invisibility.", guide: "trickster#stealth-ii", prerequisite: SelectionOption("trickster/mythic-trick/stealth-i")),
                (key: "trickster/improved-mythic-trick/trickery-ii", blueprint: "1b8271896e4a3e14389729f3df6a847e", name: "Trickery II", summary: "A Trickery check at -20 stands in for the caster level check to Greater Dispel Magic everything on a target or area.", guide: "trickster#trickery-ii", prerequisite: SelectionOption("trickster/mythic-trick/trickery-i")),
            ],
        ),
        (
            key: "trickster/mythic-trick",
            blueprint: "4fbc563529717de4d92052048143e0f1",
            name: "Mythic Trick",
            summary: "From rank 3, at every rank, gain a creative use of one of your skills.",
            guide: "trickster#mythic-trick",
            options: [
                (key: "trickster/mythic-trick/athletics-i", blueprint: "b7de8e5e4d67faf4791866966afc0a43", name: "Athletics I", summary: "Each round, try an Athletics check (original save DC + 15) to shake off a negative condition.", guide: "trickster#athletics-i"),
                (key: "trickster/mythic-trick/infuse-magic-device", blueprint: "647c848dd47b93d42bd3000bce93dff6", name: "Infuse Magic Device", summary: "Abilities of magic items you use gain your mythic rank to their caster level.", guide: "trickster#infuse-magic-device"),
                (key: "trickster/mythic-trick/knowledge-arcana-i", blueprint: "c7bb946de7454df4380c489a8350ba38", name: "Knowledge (Arcana) I", summary: "When you are the one identifying an item, its enhancement bonus goes up by 1.", guide: "trickster#knowledge-arcana-i"),
                (key: "trickster/mythic-trick/knowledge-world-i", blueprint: "06983a66bd6bac04db3996cd3064d9f0", name: "Knowledge (World) I", summary: "You and allies within 50 ft add half your mythic rank to skill checks.", guide: "trickster#knowledge-world-i"),
                (key: "trickster/mythic-trick/lore-nature-i", blueprint: "cb232b9ed5c216242a667e95527ad8e1", name: "Lore (Nature) I", summary: "After each rest you find one random potion, one random scroll and ingredients for a beneficial meal.", guide: "trickster#lore-nature-i"),
                (key: "trickster/mythic-trick/lore-religion-i", blueprint: "04177c4ddec20ae4ca04388f9cf23518", name: "Lore (Religion) I", summary: "Treat Affliction removes every negative condition, not just poisons and diseases.", guide: "trickster#lore-religion-i"),
                (key: "trickster/mythic-trick/mobility-i", blueprint: "6079a3c329989a64cad3fbd4076d5fb9", name: "Mobility I", summary: "Your movement speed rises by half.", guide: "trickster#mobility-i"),
                (key: "trickster/mythic-trick/perception-i", blueprint: "8bc2f9b88a0cf704ea72d86c2a3e2aef", name: "Perception I", summary: "See Invisibility is always on.", guide: "trickster#perception-i"),
                (key: "trickster/mythic-trick/persuasion-i", blueprint: "4eefa883f5908a347a0b0a891fb859dd", name: "Persuasion I", summary: "Enemies that start combat against you are demoralised automatically.", guide: "trickster#persuasion-i"),
                (key: "trickster/mythic-trick/stealth-i", blueprint: "4e1948fed4201cf46b88836457c3bad8", name: "Stealth I", summary: "Stealth takes only a move action, and creatures that fail Perception against you treat you as totally concealed.", guide: "trickster#stealth-i"),
                (key: "trickster/mythic-trick/trickery-i", blueprint: "90bc71f1d8482184a9ede0bda4773d94", name: "Trickery I", summary: "Dispel effects on a target or area as Dispel Magic, using a Trickery check at -10 for the caster level check; not at range.", guide: "trickster#trickery-i"),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["trickster/bypass-epic-damage-reduction", "trickster/bit-of-fun"]),
        (rank: 2, features: ["trickster/hard-to-kill", "trickster/creative-approach", "trickster/summon-will-o-wisp"]),
        (rank: 3, features: ["trickster/sneak-attack", "trickster/sneak-attack", "trickster/sneaky-quack", "trickster/summon-nixie-prankster"], selections: ["trickster/mythic-trick"]),
        (rank: 4, features: ["trickster/summon-redcaps"], selections: ["trickster/improved-mythic-trick", "trickster/mythic-trick"]),
        (rank: 5, features: ["trickster/sneak-attack", "trickster/summon-wild-hunt-archer"], selections: ["trickster/mythic-trick"]),
        (rank: 6, features: ["trickster/summon-wild-hunt-scout"], selections: ["trickster/improved-mythic-trick", "trickster/mythic-trick"]),
        (rank: 7, features: ["trickster/sneak-attack", "trickster/summon-wild-hunt-i"], selections: ["trickster/greater-mythic-trick", "trickster/mythic-trick"]),
        (rank: 8, features: ["trickster/summon-wild-hunt-monarch"], selections: ["trickster/improved-mythic-trick", "trickster/mythic-trick"]),
        (rank: 9, features: ["trickster/sneak-attack", "trickster/summon-wild-hunt-ii"], selections: ["trickster/improved-mythic-trick", "trickster/mythic-trick"]),
        (rank: 10, selections: ["trickster/greater-mythic-trick", "trickster/mythic-trick"]),
    ],
)
