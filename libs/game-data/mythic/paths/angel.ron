MythicPath(
    key: "angel",
    blueprint: "a5a9fe8f663d701488bd1db8ea40484e",
    name: "Angel",
    guide: "angel",
    features: [
        (key: "angel/angelic-halo", blueprint: "bdddaa78f8795024081f2d1eb8b4bd78", name: "Angelic Halo", summary: "Allies within 50 ft gain 1 + MR/2 to AC and saves against attacks by evil creatures.", guide: "angel#angelic-halo"),
        (key: "angel/astral-devas-x4", blueprint: "978dcee934c76484f97f82e937c7789b", name: "Astral Devas x4", guide: "angel"),
        (key: "angel/bypass-epic-damage-reduction", blueprint: "c60933cc085132b49970cbc4a4b8338f", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "angel/close-to-the-heavens", blueprint: "58abcd052187a264aba9b0ce285c49f4", name: "Close to the Heavens", summary: "A ray of light, 3/day +1 per MR above 1: heals an ally 4d6 + 2d6 per MR, or deals that much to an enemy as a ranged touch attack.", guide: "angel#close-to-the-heavens"),
        (key: "angel/halos-holy-aura", blueprint: "682842f73285df1439f1741f00e98d1b", name: "Halo\'s Holy Aura", summary: "From rank 7, Angelic Halo also gives the Holy Aura spell\'s effect, with spell resistance 20 + MR.", guide: "angel#halos-holy-aura"),
        (key: "angel/hard-to-kill", blueprint: "bef12729fa3f9b34488634f61751e295", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "angel/heavens-breath", blueprint: "45c7c2ad6792fe44582d47ccdf71bfce", name: "Heaven\'s Breath", summary: "Rank 2: petrification immunity plus 20 resistance to both acid and cold.", guide: "angel#heavens-breath"),
        (key: "angel/summon-astral-deva", blueprint: "e09826de98d995448aeff3b6b0a61851", name: "Summon Astral Deva", summary: "From rank 6, summon an Astral Deva for 1 minute.", guide: "angel#summon-astral-deva"),
        (key: "angel/summon-astral-devas", blueprint: "7e374dcfb85d51f4a94acda1b59582a4", name: "Summon Astral Devas", summary: "Summon two Astral Devas for 1 minute from rank 7, and four from rank 8.", guide: "angel#summon-astral-devas"),
        (key: "angel/summon-movanic-deva", blueprint: "494113cf886b0f742b364287ee12f2f3", name: "Summon Movanic Deva", summary: "From rank 4, summon a Movanic Deva for 1 minute.", guide: "angel#summon-movanic-deva"),
        (key: "angel/summon-movanic-devas", blueprint: "84cb19143748e55498394ecd1984f061", name: "Summon Movanic Devas", summary: "From rank 5, summon two Movanic Devas for 1 minute.", guide: "angel#summon-movanic-devas"),
        (key: "angel/summon-spirit-guardian", blueprint: "0b046ccad447a54468bd749ab2459c1a", name: "Summon Spirit Guardian", summary: "From rank 9, summon a Spirit Guardian.", guide: "angel#summon-spirit-guardian"),
        (key: "angel/summon-spirit-guardians", blueprint: "7676079dc14c88446a7879f4ac256e80", name: "Summon Spirit Guardians", summary: "From rank 10, summon three Spirit Guardians.", guide: "angel#summon-spirit-guardians"),
        (key: "angel/summon-spirit-paladin", blueprint: "4bd30ab53ce6ee24791fb60f82e7811e", name: "Summon Spirit Paladin", summary: "From rank 2, summon a Spirit Paladin for 1 minute.", guide: "angel#summon-spirit-paladin"),
        (key: "angel/summon-spirit-paladins", blueprint: "295a0d23a64a85b4a9e99e05041a3f8c", name: "Summon Spirit Paladins", summary: "From rank 3, summon two Spirit Paladins for 1 minute.", guide: "angel#summon-spirit-paladins"),
        (key: "angel/sword-of-heaven", blueprint: "7a6080461eaa278428fe3f12df75c8d0", name: "Sword of Heaven", summary: "From rank 3, imbue your weapons 1 + MR/2 times a day: +2d6 holy damage, and spells cast while holding them deal or heal 2 more dice.", guide: "angel#sword-of-heaven"),
        (key: "angel/sword-of-holy-healing", blueprint: "1ba857f62f91768468f6d89fbc758d53", name: "Sword of Holy Healing", summary: "At rank 10, activating Sword of Heaven heals 10 HP and ability damage and removes many conditions, from blindness to stun, and Feeblemind.", guide: "angel#sword-of-holy-healing"),
        (key: "angel/wings", blueprint: "d9bd0fde6deb2e44a93268f2dfb3e169", name: "Wings", guide: "angel"),
    ],
    selections: [
        (
            key: "angel/greater-sword-of-heaven",
            blueprint: "e0ce40968bf0007408b11089a10f36cf",
            name: "Greater Sword of Heaven",
            summary: "At ranks 8 and 10, add a stronger improvement to Sword of Heaven on top of the earlier ones.",
            guide: "angel#greater-sword-of-heaven",
            options: [
                (key: "angel/greater-sword-of-heaven/heavenly-host", blueprint: "131fc914b66b62c49b9f9b5f750998f5", name: "Heavenly Host", summary: "Needs Bestow the Divine: Sword of Heaven\'s benefits extend to every ally within 50 ft.", guide: "angel#heavenly-host", prerequisite: SelectionOption("angel/improved-sword-of-heaven/bestow-the-divine")),
                (key: "angel/greater-sword-of-heaven/overwhelming-flames", blueprint: "477fcaa2b00a1964da43472ddbc3c7de", name: "Overwhelming Flames", summary: "Sword of Heaven attacks deal their weapon damage to every enemy within 5 ft.", guide: "angel#overwhelming-flames"),
                (key: "angel/greater-sword-of-heaven/speed-of-light", blueprint: "826e402bae1aca242bfe9919da8d94d7", name: "Speed of Light", summary: "Holding Sword of Heaven keeps you hasted for 2 extra attacks and quickens your spells of 7th level and below.", guide: "angel#speed-of-light"),
            ],
        ),
        (
            key: "angel/improved-angelic-halo",
            blueprint: "bdbc41e2bad92a640bd58acf74e2af8b",
            name: "Improved Angelic Halo",
            summary: "At ranks 5, 7 and 9, add one improvement to Angelic Halo.",
            guide: "angel#improved-angelic-halo",
            options: [
                (key: "angel/improved-angelic-halo/blinding-light", blueprint: "67b80136595b60245b787d688f47b346", name: "Blinding Light", summary: "An enemy attacking you for the first time is blinded 1d4+1 rounds on a failed Fortitude save, or dazzled 1 minute if it saves.", guide: "angel#blinding-light"),
                (key: "angel/improved-angelic-halo/burning-bright", blueprint: "1faccd51363ce0c4798e3f74c4fa2d8e", name: "Burning Bright", summary: "Demons and undead in the halo take 2d6 + MR holy damage each round.", guide: "angel#burning-bright"),
                (key: "angel/improved-angelic-halo/flame-of-life", blueprint: "7ee3fe3528c7d7d429c5e1dd1c913c1b", name: "Flame of Life", summary: "With the halo active, a damaged ally gets 1 round of fast healing equal to your mythic rank.", guide: "angel#flame-of-life"),
                (key: "angel/improved-angelic-halo/piercing-rays", blueprint: "0042d02f5a4d9374e94b5e9d4c2d36b3", name: "Piercing Rays", summary: "Enemies in the halo lose 1 + MR/2 spell resistance and half that amount on saving throws.", guide: "angel#piercing-rays"),
                (key: "angel/improved-angelic-halo/solar-winds", blueprint: "066213b574290694c815f3b2a491839f", name: "Solar Winds", summary: "Allies gain resistance per mythic rank: 5 acid, cold, electricity, fire; 3 sonic, negative; 1 divine, force, holy, unholy.", guide: "angel#solar-winds"),
                (key: "angel/improved-angelic-halo/unfailing-beacon", blueprint: "6cc656805710b8247b27bbfc696e2cac", name: "Unfailing Beacon", summary: "Allies\' area spells don\'t harm you; when you are their main target, the spell is empowered with +2 DC.", guide: "angel#unfailing-beacon"),
            ],
        ),
        (
            key: "angel/improved-sword-of-heaven",
            blueprint: "c4a7679515ae2374eb634dd8087faf47",
            name: "Improved Sword of Heaven",
            summary: "At ranks 4 and 6, add one improvement to Sword of Heaven.",
            guide: "angel#improved-sword-of-heaven",
            options: [
                (key: "angel/improved-sword-of-heaven/abolish-disease", blueprint: "f02537712cd2af34c93ce979599f7b12", name: "Abolish Disease", summary: "Disease immunity while wielding it; your healing spells cure disease, fatigue, exhaustion, sickness and nausea; diseasing attackers take +50% holy damage.", guide: "angel#abolish-disease"),
                (key: "angel/improved-sword-of-heaven/abolish-guile", blueprint: "ebcda8f579e7d494a8befda94279968f", name: "Abolish Guile", summary: "Compulsion immunity while wielding it; your healing spells end mind-affecting effects; compulsion users take +50% holy damage from you.", guide: "angel#abolish-guile"),
                (key: "angel/improved-sword-of-heaven/abolish-poison", blueprint: "b35e4f149f17d924c97fbd27e30e948b", name: "Abolish Poison", summary: "Poison immunity while wielding it; healing spells cure poison and ability damage and drain; poisonous attackers take +50% holy damage.", guide: "angel#abolish-poison"),
                (key: "angel/improved-sword-of-heaven/abolish-undeath", blueprint: "317c795278362f84581f7cf35023a19f", name: "Abolish Undeath", summary: "Wielding it shields you from death effects and energy drain; your healing cures paralysis and negative levels; undead take +50% holy damage.", guide: "angel#abolish-undeath"),
                (key: "angel/improved-sword-of-heaven/bestow-the-divine", blueprint: "432c96835aee50341a4ff0b364cdb85a", name: "Bestow the Divine", summary: "You can imbue an ally\'s weapons with Sword of Heaven\'s holy power.", guide: "angel#bestow-the-divine"),
                (key: "angel/improved-sword-of-heaven/everlasting-flame", blueprint: "0b082785884d35c4c8f252d93b8f3616", name: "Everlasting Flame", summary: "Sword of Heaven\'s duration becomes 1 minute per mythic rank; Greater Enduring Spells doesn\'t extend it.", guide: "angel#everlasting-flame"),
                (key: "angel/improved-sword-of-heaven/grand-blessing", blueprint: "84f001f9aaaa73c479659edfa87f4782", name: "Grand Blessing", summary: "Sword of Heaven\'s extra damage and healing are maximised.", guide: "angel#grand-blessing"),
                (key: "angel/improved-sword-of-heaven/guide-the-faithful", blueprint: "3b27bebe971f9484f93f72e3d05182ee", name: "Guide the Faithful", summary: "Hitting with the imbued weapon marks a foe for 1 minute: it is revealed and suffers -40 Stealth and -4 AC.", guide: "angel#guide-the-faithful"),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["angel/bypass-epic-damage-reduction", "angel/close-to-the-heavens"]),
        (rank: 2, features: ["angel/heavens-breath", "angel/summon-spirit-paladin", "angel/hard-to-kill"]),
        (rank: 3, features: ["angel/angelic-halo", "angel/summon-spirit-paladins", "angel/sword-of-heaven"]),
        (rank: 4, features: ["angel/summon-movanic-deva"], selections: ["angel/improved-sword-of-heaven"]),
        (rank: 5, features: ["angel/summon-movanic-devas"], selections: ["angel/improved-angelic-halo"]),
        (rank: 6, features: ["angel/summon-astral-deva"], selections: ["angel/improved-sword-of-heaven"]),
        (rank: 7, features: ["angel/halos-holy-aura", "angel/summon-astral-devas"], selections: ["angel/improved-angelic-halo"]),
        (rank: 8, features: ["angel/astral-devas-x4", "angel/wings"], selections: ["angel/greater-sword-of-heaven"]),
        (rank: 9, features: ["angel/summon-spirit-guardian"], selections: ["angel/improved-angelic-halo"]),
        (rank: 10, features: ["angel/summon-spirit-guardians", "angel/sword-of-holy-healing"], selections: ["angel/greater-sword-of-heaven"]),
    ],
)
