MythicPath(
    key: "angel",
    name: "Angel",
    guide: "angel",
    features: [
        (key: "angel/angelic-halo", name: "Angelic Halo", summary: "Allies within 50 ft gain 1 + MR/2 to AC and saves against attacks by evil creatures.", guide: "angel#angelic-halo"),
        (key: "angel/astral-devas-x4", name: "Astral Devas x4", guide: "angel"),
        (key: "angel/bypass-epic-damage-reduction", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "angel/close-to-the-heavens", name: "Close to the Heavens", summary: "A ray of light, 3/day +1 per MR above 1: heals an ally 4d6 + 2d6 per MR, or deals that much to an enemy as a ranged touch attack.", guide: "angel#close-to-the-heavens"),
        (key: "angel/halos-holy-aura", name: "Halo\'s Holy Aura", summary: "From rank 7, Angelic Halo also gives the Holy Aura spell\'s effect, with spell resistance 20 + MR.", guide: "angel#halos-holy-aura"),
        (key: "angel/hard-to-kill", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "angel/heavens-breath", name: "Heaven\'s Breath", summary: "At rank 2, gain acid and cold resistance 20 and immunity to petrification.", guide: "angel#heavens-breath"),
        (key: "angel/summon-astral-deva", name: "Summon Astral Deva", summary: "From rank 6, summon an Astral Deva for 1 minute.", guide: "angel#summon-astral-deva"),
        (key: "angel/summon-astral-devas", name: "Summon Astral Devas", summary: "Summon two Astral Devas for 1 minute from rank 7, and four from rank 8.", guide: "angel#summon-astral-devas"),
        (key: "angel/summon-movanic-deva", name: "Summon Movanic Deva", summary: "From rank 4, summon a Movanic Deva for 1 minute.", guide: "angel#summon-movanic-deva"),
        (key: "angel/summon-movanic-devas", name: "Summon Movanic Devas", summary: "From rank 5, summon two Movanic Devas for 1 minute.", guide: "angel#summon-movanic-devas"),
        (key: "angel/summon-spirit-guardian", name: "Summon Spirit Guardian", summary: "From rank 9, summon a Spirit Guardian.", guide: "angel#summon-spirit-guardian"),
        (key: "angel/summon-spirit-guardians", name: "Summon Spirit Guardians", summary: "From rank 10, summon three Spirit Guardians.", guide: "angel#summon-spirit-guardians"),
        (key: "angel/summon-spirit-paladin", name: "Summon Spirit Paladin", summary: "From rank 2, summon a Spirit Paladin for 1 minute.", guide: "angel#summon-spirit-paladin"),
        (key: "angel/summon-spirit-paladins", name: "Summon Spirit Paladins", summary: "From rank 3, summon two Spirit Paladins for 1 minute.", guide: "angel#summon-spirit-paladins"),
        (key: "angel/sword-of-heaven", name: "Sword of Heaven", summary: "From rank 3, imbue your weapons 1 + MR/2 times a day: +2d6 holy damage, and spells cast while holding them deal or heal 2 more dice.", guide: "angel#sword-of-heaven"),
        (key: "angel/sword-of-holy-healing", name: "Sword of Holy Healing", summary: "At rank 10, activating Sword of Heaven heals 10 HP and ability damage and removes many conditions, from blindness to stun, and Feeblemind.", guide: "angel#sword-of-holy-healing"),
        (key: "angel/wings", name: "Wings", guide: "angel"),
    ],
    selections: [
        (
            key: "angel/greater-sword-of-heaven",
            name: "Greater Sword of Heaven",
            summary: "At ranks 8 and 10, add a stronger improvement to Sword of Heaven on top of the earlier ones.",
            guide: "angel#greater-sword-of-heaven",
            options: [
                (key: "angel/greater-sword-of-heaven/heavenly-host", name: "Heavenly Host", summary: "Needs Bestow the Divine: every ally within 50 ft gets the benefits of Sword of Heaven.", guide: "angel#heavenly-host", prerequisite: SelectionOption("angel/improved-sword-of-heaven/bestow-the-divine")),
                (key: "angel/greater-sword-of-heaven/overwhelming-flames", name: "Overwhelming Flames", summary: "Sword of Heaven attacks deal their weapon damage to every enemy within 5 ft.", guide: "angel#overwhelming-flames"),
                (key: "angel/greater-sword-of-heaven/speed-of-light", name: "Speed of Light", summary: "While wielding Sword of Heaven you are hasted, with 2 extra attacks, and spells of 7th level or lower are quickened.", guide: "angel#speed-of-light"),
            ],
        ),
        (
            key: "angel/improved-angelic-halo",
            name: "Improved Angelic Halo",
            summary: "At ranks 5, 7 and 9, add one improvement to Angelic Halo.",
            guide: "angel#improved-angelic-halo",
            options: [
                (key: "angel/improved-angelic-halo/blinding-light", name: "Blinding Light", summary: "An enemy attacking you for the first time is blinded 1d4+1 rounds on a failed Fortitude save, or dazzled 1 minute if it saves.", guide: "angel#blinding-light"),
                (key: "angel/improved-angelic-halo/burning-bright", name: "Burning Bright", summary: "Demons and undead in the halo take 2d6 + MR holy damage each round.", guide: "angel#burning-bright"),
                (key: "angel/improved-angelic-halo/flame-of-life", name: "Flame of Life", summary: "While the halo is up, an ally who takes damage gains fast healing equal to your mythic rank for 1 round.", guide: "angel#flame-of-life"),
                (key: "angel/improved-angelic-halo/piercing-rays", name: "Piercing Rays", summary: "Enemies in the halo lose 1 + MR/2 spell resistance and half that amount on saving throws.", guide: "angel#piercing-rays"),
                (key: "angel/improved-angelic-halo/solar-winds", name: "Solar Winds", summary: "Allies gain resistance per mythic rank: 5 acid, cold, electricity, fire; 3 sonic, negative; 1 divine, force, holy, unholy.", guide: "angel#solar-winds"),
                (key: "angel/improved-angelic-halo/unfailing-beacon", name: "Unfailing Beacon", summary: "Allies\' area spells don\'t harm you; when you are their main target, the spell is empowered with +2 DC.", guide: "angel#unfailing-beacon"),
            ],
        ),
        (
            key: "angel/improved-sword-of-heaven",
            name: "Improved Sword of Heaven",
            summary: "At ranks 4 and 6, add one improvement to Sword of Heaven.",
            guide: "angel#improved-sword-of-heaven",
            options: [
                (key: "angel/improved-sword-of-heaven/abolish-disease", name: "Abolish Disease", summary: "Disease immunity while wielding it; your healing spells cure disease and fatigue-type conditions; diseased attackers take +50% holy damage.", guide: "angel#abolish-disease"),
                (key: "angel/improved-sword-of-heaven/abolish-guile", name: "Abolish Guile", summary: "Compulsion immunity while wielding it; your healing spells end mind-affecting effects; compulsion users take +50% holy damage from you.", guide: "angel#abolish-guile"),
                (key: "angel/improved-sword-of-heaven/abolish-poison", name: "Abolish Poison", summary: "Poison immunity while wielding it; healing spells cure poison and ability damage and drain; poisonous attackers take +50% holy damage.", guide: "angel#abolish-poison"),
                (key: "angel/improved-sword-of-heaven/abolish-undeath", name: "Abolish Undeath", summary: "Immune to death effects and energy drain while wielding it; healing ends paralysis and negative levels; undead take +50% holy damage.", guide: "angel#abolish-undeath"),
                (key: "angel/improved-sword-of-heaven/bestow-the-divine", name: "Bestow the Divine", summary: "You can imbue an ally\'s weapons with Sword of Heaven\'s holy power.", guide: "angel#bestow-the-divine"),
                (key: "angel/improved-sword-of-heaven/everlasting-flame", name: "Everlasting Flame", summary: "Sword of Heaven lasts 1 minute per mythic rank; this doesn\'t combine with Greater Enduring Spells.", guide: "angel#everlasting-flame"),
                (key: "angel/improved-sword-of-heaven/grand-blessing", name: "Grand Blessing", summary: "Sword of Heaven\'s extra damage and healing are maximised.", guide: "angel#grand-blessing"),
                (key: "angel/improved-sword-of-heaven/guide-the-faithful", name: "Guide the Faithful", summary: "Hits with the imbued weapon mark the target for 1 minute: revealed, -40 Stealth and -4 AC.", guide: "angel#guide-the-faithful"),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["angel/bypass-epic-damage-reduction", "angel/close-to-the-heavens"]),
        (rank: 2, features: ["angel/heavens-breath", "angel/summon-spirit-paladin", "angel/hard-to-kill"]),
        (rank: 3, features: ["angel/angelic-halo", "angel/summon-spirit-paladins", "angel/sword-of-heaven"]),
        (rank: 4, features: ["angel/summon-movanic-deva"], selections: ["angel/improved-sword-of-heaven"]),
        (rank: 5, features: ["angel/summon-movanic-devas"], selections: ["angel/improved-angelic-halo"]),
        (rank: 6, features: ["angel/summon-astral-deva"], selections: ["angel/improved-sword-of-heaven"]),
        (rank: 7, features: ["angel/halos-holy-aura", "angel/summon-astral-devas"], selections: ["angel/improved-angelic-halo"]),
        (rank: 8, features: ["angel/astral-devas-x4", "angel/wings"], selections: ["angel/greater-sword-of-heaven"]),
        (rank: 9, features: ["angel/summon-spirit-guardian"], selections: ["angel/improved-angelic-halo"]),
        (rank: 10, features: ["angel/summon-spirit-guardians", "angel/sword-of-holy-healing"], selections: ["angel/greater-sword-of-heaven"]),
    ],
)
