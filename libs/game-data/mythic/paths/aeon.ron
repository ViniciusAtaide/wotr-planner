MythicPath(
    key: "aeon",
    blueprint: "15a85e67b7d69554cab9ed5830d0268e",
    name: "Aeon",
    guide: "aeon",
    features: [
        (key: "aeon/aeon-bane", blueprint: "0b25e8d8b0488c84c9b5714e9ca0a204", name: "Aeon Bane", summary: "From rank 4, Bane on your weapons for 2 rounds/day per MR, +MR spell penetration, and each hit dispels like Dispel Magic; stacks with Inquisitor Bane.", guide: "aeon#aeon-bane"),
        (key: "aeon/aeon-companion-immunities", blueprint: "afa3b2a4db84e0540b3e503de3fabfd2", name: "Aeon Companion Immunities", summary: "At rank 7, allies within 30 ft become immune to poison, disease and confusion; at rank 9, also to mind-affecting effects.", guide: "aeon#aeon-companion-immunities"),
        (key: "aeon/aeon-immunities", blueprint: "2be3d3d82e6ced345ac3c5e0c0fa3e50", name: "Aeon Immunities", summary: "Immune to poison, disease, confusion (rank 3), bleed, mind-affecting, ability damage (5), curse, death, energy drain (7); anti-chaos powers at 10.", guide: "aeon#aeon-immunities"),
        (key: "aeon/bypass-epic-damage-reduction", blueprint: "c60933cc085132b49970cbc4a4b8338f", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "aeon/enforcing-gaze-extra-gaze", blueprint: "9b3399bb6cea0044faa42cd61169cc29", name: "Enforcing Gaze - Extra Gaze", summary: "Keep two enforcing gazes active at once from rank 6, and three at rank 10.", guide: "aeon#enforcing-gaze-extra-gaze"),
        (key: "aeon/enforcing-gaze-perpetual", blueprint: "a2f5852d76a165f4d8d6fe670e8013fb", name: "Enforcing Gaze - Perpetual", summary: "From rank 8, Enforcing Gaze has no daily limit.", guide: "aeon#enforcing-gaze-perpetual"),
        (key: "aeon/force-reality", blueprint: "11744000c915c6144ac6be7ceca03521", name: "Force Reality", summary: "3 + MR/day: greater dispel of illusions on enemies within 30 ft (CL = level + MR); from rank 2, also dispel negative effects on allies.", guide: "aeon#force-reality"),
        (key: "aeon/greater-aeons-bane", blueprint: "0a7482fd7b0479c44b51d7cd6c33e5c4", name: "Greater Aeon\'s Bane", summary: "At rank 9, Aeon Bane adds another +1 attack and 2d6+1 damage, your first hit each round dispels, and spells and abilities take a move action.", guide: "aeon#greater-aeons-bane"),
        (key: "aeon/hard-to-kill", blueprint: "bef12729fa3f9b34488634f61751e295", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "aeon/improved-aeons-bane", blueprint: "bbf227fe76f1eaa418a95e6095145ce8", name: "Improved Aeon\'s Bane", summary: "At rank 6, Aeon Bane adds +1 attack and 2d6+1 damage, hits dispel like Greater Dispel Magic, and your summons share the bonus.", guide: "aeon#improved-aeons-bane"),
        (key: "aeon/mythic-suppression", blueprint: "c62280cbab88eb7458b867ff899cea3e", name: "Mythic Suppression", summary: "Rank 5: standard action, mythic demons failing a Will save (+4 if not distorted) lose their powers; rank 7: distorted can\'t save, no +4; rank 9: none save.", guide: "aeon#mythic-suppression"),
        (key: "aeon/summon-adamantine-golem", blueprint: "8c5e6396cab06d3448eea6ece94ab5fe", name: "Summon Adamantine Golem", summary: "From rank 8, summon an Adamantine Golem for 1 minute.", guide: "aeon#summon-adamantine-golem"),
        (key: "aeon/summon-adamantine-golems", blueprint: "eb5f2d4ebcf12b746b380b2bd9956598", name: "Summon Adamantine Golems", summary: "From rank 9, summon two Adamantine Golems for 1 minute.", guide: "aeon#summon-adamantine-golems"),
        (key: "aeon/summon-axiomite", blueprint: "6c999087fd82ca9499cee45f107e9831", name: "Summon Axiomite", summary: "From rank 3, summon an Axiomite for 1 minute.", guide: "aeon#summon-axiomite"),
        (key: "aeon/summon-gold-golem", blueprint: "246f83789576bc8409cc5a956797c5d4", name: "Summon Gold Golem", summary: "From rank 6, summon a Gold Golem for 1 minute.", guide: "aeon#summon-gold-golem"),
        (key: "aeon/summon-gold-golems", blueprint: "5fe2c48d929f50342930ae038334c58b", name: "Summon Gold Golems", summary: "From rank 7, summon two Gold Golems for 1 minute.", guide: "aeon#summon-gold-golems"),
        (key: "aeon/summon-iron-golem", blueprint: "b23ecd3f962fd8e4b8a52af89cf65294", name: "Summon Iron Golem", summary: "From rank 5, summon an Iron Golem for 1 minute.", guide: "aeon#summon-iron-golem"),
        (key: "aeon/summon-stone-golem", blueprint: "1ac8412551ba48c4a9958deab64f1829", name: "Summon Stone Golem", summary: "From rank 4, summon a Stone Golem for 1 minute.", guide: "aeon#summon-stone-golem"),
        (key: "aeon/summon-wood-golem", blueprint: "0efe2a9ef673ebe4181356748c88fbe9", name: "Summon Wood Golem", summary: "From rank 2, summon a Wood Golem for 1 minute.", guide: "aeon#summon-wood-golem"),
    ],
    selections: [
        (
            key: "aeon/enforcing-gaze",
            blueprint: "7e468a5266235454e9dcefee315ee6d5",
            name: "Enforcing Gaze",
            summary: "From rank 3, one gaze per rank that lasts the combat, aiding allies and hindering foes failing a Will save (chaotic -2); 1 + MR uses/day.",
            guide: "aeon#enforcing-gaze",
            options: [
                (key: "aeon/enforcing-gaze/enforcing-gaze-area-effects", blueprint: "39d8ae51c0034adbb8394210c51901e2", name: "Enforcing Gaze - Area Effects", summary: "Rank 5: allies are immune to your side\'s lasting area effects and can dispel enemy ones they enter (1d20 + level/2 + MR).", guide: "aeon#enforcing-gaze-area-effects", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-attack", blueprint: "e0cc4134510b074468b3d1185970c697", name: "Enforcing Gaze - Attack", summary: "Allies gain +1 attack, plus 1 per two mythic ranks; enemies that fail the save take the same penalty.", guide: "aeon#enforcing-gaze-attack"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-attacks-of-opportunity", blueprint: "653831e19515438b948764291689dc3a", name: "Enforcing Gaze - Attacks of Opportunity", summary: "All allied attacks of opportunity gain +MR attack and damage, and allies with several get one more; failing enemies lose extras and take -MR.", guide: "aeon#enforcing-gaze-attacks-of-opportunity"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-caster-level", blueprint: "911be6cfed6bb71449cbf6d1173f4dc2", name: "Enforcing Gaze - Caster Level", summary: "Allies gain +1 caster level, plus 1 per three mythic ranks; enemies that fail the save lose as much.", guide: "aeon#enforcing-gaze-caster-level"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-combat-maneuvers", blueprint: "dbabd88e7cd24b619dbf413ae7ce0033", name: "Enforcing Gaze - Combat Maneuvers", summary: "Allies gain 1 + MR/2 to CMB on combat manoeuvres; enemies that fail the save lose as much CMB.", guide: "aeon#enforcing-gaze-combat-maneuvers"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-concentration", blueprint: "2eae9b2c25a969641a2cf230acdca478", name: "Enforcing Gaze - Concentration", summary: "Rank 5: allies gain +MR on concentration checks; enemies that fail the save must make a concentration check for every spell.", guide: "aeon#enforcing-gaze-concentration", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-damage", blueprint: "741cde744a64425e9feb6b1eaef53eba", name: "Enforcing Gaze - Damage", summary: "Allies gain +1 damage, plus 1 per two mythic ranks; enemies that fail the save take the same penalty.", guide: "aeon#enforcing-gaze-damage"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-damage-reduction", blueprint: "f102b11d85a11d14c811569c0ffcaa6e", name: "Enforcing Gaze - Damage Reduction", summary: "Allies gain DR/chaotic equal to twice your mythic rank; enemies that fail the save lose that much DR.", guide: "aeon#enforcing-gaze-damage-reduction"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-energy-shield", blueprint: "bb283854ec4242babbf0463bc3050264", name: "Enforcing Gaze - Energy Shield", summary: "Allies gain acid, cold, electricity, fire and sonic resistance of 5x MR; enemies that fail the save lose that much.", guide: "aeon#enforcing-gaze-energy-shield"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-hit-points", blueprint: "bb6ac47cdff935d4e8ebf3ba8c5fdcda", name: "Enforcing Gaze - Hit Points", summary: "Rank 5: allies gain temporary HP of 2x MR; failing enemies take 1d6 per three mythic ranks whenever they hit an ally.", guide: "aeon#enforcing-gaze-hit-points", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-normalize-size", blueprint: "c90b37a7f4894ac5a27f506aba5760b5", name: "Enforcing Gaze - Normalize Size", summary: "Rank 5: allies become Medium, dropping size penalties but keeping bonuses except reach; failing enemies become Medium and lose size bonuses.", guide: "aeon#enforcing-gaze-normalize-size", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-power-of-law", blueprint: "8c84573701184f6db5b7b7543ee64227", name: "Enforcing Gaze - Power of Law", summary: "Rank 5: ally rolls of 1 + MR/2 or less count as 2 + MR/2; a failing enemy\'s roll above 21 - MR/2 drops to 20 - MR/2; save DC 15 + MR.", guide: "aeon#enforcing-gaze-power-of-law", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-primordial-magic", blueprint: "da5cbbd3b9a14a86b90555e7d3ed4451", name: "Enforcing Gaze - Primordial Magic", summary: "Rank 5: allies\' spells deal +MR damage and heal +2x MR, and friendly-only spells can be cast as a second spell (move action); enemies suffer the reverse.", guide: "aeon#enforcing-gaze-primordial-magic", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-relativity-of-space", blueprint: "24856f367261454b8d5070da0e774053", name: "Enforcing Gaze - Relativity of Space", summary: "Rank 5: attacks on your party have a 5% miss chance per MR, and miss chances on your attacks drop by 5% per MR.", guide: "aeon#enforcing-gaze-relativity-of-space", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-save-dc", blueprint: "7d3707bec182f5d428c444d7b7ead812", name: "Enforcing Gaze - Save DC", summary: "Allies\' spell DCs rise by 1, plus 1 per three mythic ranks; enemies that fail the save lose as much.", guide: "aeon#enforcing-gaze-save-dc"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-summoners-gaze", blueprint: "22b8e9508bce5474588e34168089ad69", name: "Enforcing Gaze - Summoner\'s Gaze", summary: "Rank 5: allied summons gain MR/2 to Strength, Dexterity and Constitution; enemy summons that fail the save are banished.", guide: "aeon#enforcing-gaze-summoners-gaze", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-temporal-jump", blueprint: "72514d0dcd054d1f8bb9abd4ddb9711c", name: "Enforcing Gaze - Temporal Jump", summary: "Rank 8: once a round an ally may reroll a miss and keep the better; a failing enemy that hits must reroll and keep the worse.", guide: "aeon#enforcing-gaze-temporal-jump", prerequisite: MythicRank(8)),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["aeon/bypass-epic-damage-reduction", "aeon/force-reality"]),
        (rank: 2, features: ["aeon/force-reality", "aeon/summon-wood-golem", "aeon/hard-to-kill"]),
        (rank: 3, features: ["aeon/aeon-immunities", "aeon/summon-axiomite"], selections: ["aeon/enforcing-gaze"]),
        (rank: 4, features: ["aeon/aeon-bane", "aeon/summon-stone-golem"], selections: ["aeon/enforcing-gaze"]),
        (rank: 5, features: ["aeon/aeon-immunities", "aeon/mythic-suppression", "aeon/summon-iron-golem"], selections: ["aeon/enforcing-gaze"]),
        (rank: 6, features: ["aeon/enforcing-gaze-extra-gaze", "aeon/improved-aeons-bane", "aeon/summon-gold-golem"], selections: ["aeon/enforcing-gaze"]),
        (rank: 7, features: ["aeon/aeon-companion-immunities", "aeon/aeon-immunities", "aeon/mythic-suppression", "aeon/summon-gold-golems"], selections: ["aeon/enforcing-gaze"]),
        (rank: 8, features: ["aeon/enforcing-gaze-perpetual", "aeon/summon-adamantine-golem"], selections: ["aeon/enforcing-gaze"]),
        (rank: 9, features: ["aeon/aeon-companion-immunities", "aeon/greater-aeons-bane", "aeon/mythic-suppression", "aeon/summon-adamantine-golems"], selections: ["aeon/enforcing-gaze"]),
        (rank: 10, features: ["aeon/aeon-immunities", "aeon/enforcing-gaze-extra-gaze"], selections: ["aeon/enforcing-gaze"]),
    ],
)
