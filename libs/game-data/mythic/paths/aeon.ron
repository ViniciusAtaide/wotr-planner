MythicPath(
    key: "aeon",
    name: "Aeon",
    guide: "aeon",
    features: [
        (key: "aeon/aeon-bane", name: "Aeon Bane", summary: "From rank 4, Bane on your weapons for 2 rounds/day per MR, +MR spell penetration, and each hit dispels like Dispel Magic; stacks with Inquisitor Bane.", guide: "aeon#aeon-bane"),
        (key: "aeon/aeon-companion-immunities", name: "Aeon Companion Immunities", summary: "At rank 7, allies within 30 ft become immune to poison, disease and confusion; at rank 9, also to mind-affecting effects.", guide: "aeon#aeon-companion-immunities"),
        (key: "aeon/aeon-immunities", name: "Aeon Immunities", summary: "Immune to poison, disease, confusion (rank 3), bleed, mind-affecting, ability damage (5), curse, death, energy drain (7); anti-chaos powers at 10.", guide: "aeon#aeon-immunities"),
        (key: "aeon/bypass-epic-damage-reduction", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "aeon/enforcing-gaze-extra-gaze", name: "Enforcing Gaze - Extra Gaze", summary: "Keep two enforcing gazes active at once from rank 6, and three at rank 10.", guide: "aeon#enforcing-gaze-extra-gaze"),
        (key: "aeon/enforcing-gaze-perpetual", name: "Enforcing Gaze - Perpetual", summary: "From rank 8, Enforcing Gaze has no daily limit.", guide: "aeon#enforcing-gaze-perpetual"),
        (key: "aeon/force-reality", name: "Force Reality", summary: "3 + MR/day: greater dispel of illusions on enemies within 30 ft (CL = level + MR); from rank 2, also dispel negative effects on allies.", guide: "aeon#force-reality"),
        (key: "aeon/greater-aeons-bane", name: "Greater Aeon\'s Bane", summary: "At rank 9, Aeon Bane adds another +1 attack and 2d6+1 damage, your first hit each round dispels, and spells and abilities take a move action.", guide: "aeon#greater-aeons-bane"),
        (key: "aeon/hard-to-kill", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "aeon/improved-aeons-bane", name: "Improved Aeon\'s Bane", summary: "At rank 6, Aeon Bane adds +1 attack and 2d6+1 damage, hits dispel like Greater Dispel Magic, and your summons share the bonus.", guide: "aeon#improved-aeons-bane"),
        (key: "aeon/mythic-suppression", name: "Mythic Suppression", summary: "From rank 5, a standard action that suppresses mythic demons\' powers on a failed Will save; their save weakens at rank 7 and is gone at rank 9.", guide: "aeon#mythic-suppression"),
        (key: "aeon/summon-adamantine-golem", name: "Summon Adamantine Golem", summary: "From rank 8, summon an Adamantine Golem for 1 minute.", guide: "aeon#summon-adamantine-golem"),
        (key: "aeon/summon-adamantine-golems", name: "Summon Adamantine Golems", summary: "From rank 9, summon two Adamantine Golems for 1 minute.", guide: "aeon#summon-adamantine-golems"),
        (key: "aeon/summon-axiomite", name: "Summon Axiomite", summary: "From rank 3, summon an Axiomite for 1 minute.", guide: "aeon#summon-axiomite"),
        (key: "aeon/summon-gold-golem", name: "Summon Gold Golem", summary: "From rank 6, summon a Gold Golem for 1 minute.", guide: "aeon#summon-gold-golem"),
        (key: "aeon/summon-gold-golems", name: "Summon Gold Golems", summary: "From rank 7, summon two Gold Golems for 1 minute.", guide: "aeon#summon-gold-golems"),
        (key: "aeon/summon-iron-golem", name: "Summon Iron Golem", summary: "From rank 5, summon an Iron Golem for 1 minute.", guide: "aeon#summon-iron-golem"),
        (key: "aeon/summon-stone-golem", name: "Summon Stone Golem", summary: "From rank 4, summon a Stone Golem for 1 minute.", guide: "aeon#summon-stone-golem"),
        (key: "aeon/summon-wood-golem", name: "Summon Wood Golem", summary: "From rank 2, summon a Wood Golem for 1 minute.", guide: "aeon#summon-wood-golem"),
    ],
    selections: [
        (
            key: "aeon/enforcing-gaze",
            name: "Enforcing Gaze",
            summary: "From rank 3, one gaze per rank that lasts the combat, aiding allies and hindering foes failing a Will save (chaotic -2); 1 + MR uses/day.",
            guide: "aeon#enforcing-gaze",
            options: [
                (key: "aeon/enforcing-gaze/enforcing-gaze-area-effects", name: "Enforcing Gaze - Area Effects", summary: "Rank 5: allies are immune to your side\'s lasting area effects and can dispel enemy ones they enter (1d20 + level/2 + MR).", guide: "aeon#enforcing-gaze-area-effects", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-attack", name: "Enforcing Gaze - Attack", summary: "Allies gain +1 attack, plus 1 per two mythic ranks; enemies that fail the save take the same penalty.", guide: "aeon#enforcing-gaze-attack"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-attacks-of-opportunity", name: "Enforcing Gaze - Attacks of Opportunity", summary: "Allies with several attacks of opportunity get one more, all at +MR attack and damage; failing enemies lose extras and take -MR.", guide: "aeon#enforcing-gaze-attacks-of-opportunity"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-caster-level", name: "Enforcing Gaze - Caster Level", summary: "Allies gain +1 caster level, plus 1 per three mythic ranks; enemies that fail the save lose as much.", guide: "aeon#enforcing-gaze-caster-level"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-combat-maneuvers", name: "Enforcing Gaze - Combat Maneuvers", summary: "Allies gain 1 + MR/2 to CMB on combat manoeuvres; enemies that fail the save lose as much CMB.", guide: "aeon#enforcing-gaze-combat-maneuvers"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-concentration", name: "Enforcing Gaze - Concentration", summary: "Rank 5: allies gain +MR on concentration checks; enemies that fail the save must make a concentration check for every spell.", guide: "aeon#enforcing-gaze-concentration", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-damage", name: "Enforcing Gaze - Damage", summary: "Allies gain +1 damage, plus 1 per two mythic ranks; enemies that fail the save take the same penalty.", guide: "aeon#enforcing-gaze-damage"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-damage-reduction", name: "Enforcing Gaze - Damage Reduction", summary: "Allies gain DR/chaotic equal to twice your mythic rank; enemies that fail the save lose that much DR.", guide: "aeon#enforcing-gaze-damage-reduction"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-energy-shield", name: "Enforcing Gaze - Energy Shield", summary: "Allies gain acid, cold, electricity, fire and sonic resistance of 5x MR; enemies that fail the save lose that much.", guide: "aeon#enforcing-gaze-energy-shield"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-hit-points", name: "Enforcing Gaze - Hit Points", summary: "Rank 5: allies gain temporary HP of 2x MR; failing enemies take 1d6 per three mythic ranks whenever they hit an ally.", guide: "aeon#enforcing-gaze-hit-points", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-normalize-size", name: "Enforcing Gaze - Normalize Size", summary: "Rank 5: allies become Medium, dropping size penalties but keeping bonuses except reach; failing enemies become Medium and lose size bonuses.", guide: "aeon#enforcing-gaze-normalize-size", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-power-of-law", name: "Enforcing Gaze - Power of Law", summary: "Rank 5: allies\' low rolls (up to 1 + MR/2) become 2 + MR/2; failing enemies\' high rolls are capped at 20 - MR/2; save DC 15 + MR.", guide: "aeon#enforcing-gaze-power-of-law", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-primordial-magic", name: "Enforcing Gaze - Primordial Magic", summary: "Rank 5: allies\' spells deal +MR damage and heal +2x MR, and friendly-only spells can be cast as a second spell (move action); enemies suffer the reverse.", guide: "aeon#enforcing-gaze-primordial-magic", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-relativity-of-space", name: "Enforcing Gaze - Relativity of Space", summary: "Rank 5: attacks on your party have a 5% miss chance per MR, and miss chances on your attacks drop by 5% per MR.", guide: "aeon#enforcing-gaze-relativity-of-space", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-save-dc", name: "Enforcing Gaze - Save DC", summary: "Allies\' spell DCs rise by 1, plus 1 per three mythic ranks; enemies that fail the save lose as much.", guide: "aeon#enforcing-gaze-save-dc"),
                (key: "aeon/enforcing-gaze/enforcing-gaze-summoners-gaze", name: "Enforcing Gaze - Summoner\'s Gaze", summary: "Rank 5: allied summons gain MR/2 to Strength, Dexterity and Constitution; enemy summons that fail the save are banished.", guide: "aeon#enforcing-gaze-summoners-gaze", prerequisite: MythicRank(5)),
                (key: "aeon/enforcing-gaze/enforcing-gaze-temporal-jump", name: "Enforcing Gaze - Temporal Jump", summary: "Rank 8: once a round an ally may reroll a miss and keep the better; a failing enemy that hits must reroll and keep the worse.", guide: "aeon#enforcing-gaze-temporal-jump", prerequisite: MythicRank(8)),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["aeon/bypass-epic-damage-reduction", "aeon/force-reality"]),
        (rank: 2, features: ["aeon/force-reality", "aeon/summon-wood-golem", "aeon/hard-to-kill"]),
        (rank: 3, features: ["aeon/aeon-immunities", "aeon/summon-axiomite"], selections: ["aeon/enforcing-gaze"]),
        (rank: 4, features: ["aeon/aeon-bane", "aeon/summon-stone-golem"], selections: ["aeon/enforcing-gaze"]),
        (rank: 5, features: ["aeon/aeon-immunities", "aeon/mythic-suppression", "aeon/summon-iron-golem"], selections: ["aeon/enforcing-gaze"]),
        (rank: 6, features: ["aeon/enforcing-gaze-extra-gaze", "aeon/improved-aeons-bane", "aeon/summon-gold-golem"], selections: ["aeon/enforcing-gaze"]),
        (rank: 7, features: ["aeon/aeon-companion-immunities", "aeon/aeon-immunities", "aeon/mythic-suppression", "aeon/summon-gold-golems"], selections: ["aeon/enforcing-gaze"]),
        (rank: 8, features: ["aeon/enforcing-gaze-perpetual", "aeon/summon-adamantine-golem"], selections: ["aeon/enforcing-gaze"]),
        (rank: 9, features: ["aeon/aeon-companion-immunities", "aeon/greater-aeons-bane", "aeon/mythic-suppression", "aeon/summon-adamantine-golems"], selections: ["aeon/enforcing-gaze"]),
        (rank: 10, features: ["aeon/aeon-immunities", "aeon/enforcing-gaze-extra-gaze"], selections: ["aeon/enforcing-gaze"]),
    ],
)
