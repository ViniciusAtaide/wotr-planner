MythicPath(
    key: "lich",
    name: "Lich",
    guide: "lich",
    features: [
        (key: "lich/bypass-epic-damage-reduction", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "lich/danse-macabre", name: "Danse Macabre", summary: "Channel negative energy: living creatures within 30 ft take 2d6 + 1d6 per MR (Will half), and undead in the area are healed.", guide: "lich#danse-macabre"),
        (key: "lich/dark-rites", name: "Dark Rites", summary: "At rank 5, you and allies within 30 ft gain +2 effective caster level.", guide: "lich#dark-rites"),
        (key: "lich/hard-to-kill", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "lich/lord-beyond-the-grave", name: "Lord Beyond the Grave", summary: "From rank 4, Command Undead at will; your undead gain MR/2+1 to Str, Dex and Cha, and their attacks ignore DR other than DR/-.", guide: "lich#lord-beyond-the-grave"),
        (key: "lich/negative-energy-insight", name: "Negative Energy Insight", summary: "At rank 2, +2 on saves vs. death effects, and +2 AC, saves, attack, damage and class ability DCs against negative-energy-affinity creatures.", guide: "lich#negative-energy-insight"),
        (key: "lich/summon-ecorche", name: "Summon Ecorche", summary: "From rank 6, summon an Ecorche for 1 minute.", guide: "lich#summon-ecorche"),
        (key: "lich/summon-fallen", name: "Summon Fallen", summary: "From rank 3, summon a Fallen for 1 minute.", guide: "lich#summon-fallen"),
        (key: "lich/summon-nightshade-nightcrawler", name: "Summon Nightshade Nightcrawler", summary: "From rank 7, summon a Nightshade Nightcrawler for 1 minute.", guide: "lich#summon-nightshade-nightcrawler"),
        (key: "lich/summon-nightshade-nightcrawler-and-ecorche", name: "Summon Nightshade Nightcrawler and Ecorche", summary: "From rank 8, summon a Nightshade Nightcrawler and an Ecorche for 1 minute.", guide: "lich#summon-nightshade-nightcrawler-and-ecorche"),
        (key: "lich/summon-plague-beast-mastodon", name: "Summon Plague Beast Mastodon", summary: "From rank 4, summon a Plague Beast Mastodon for 1 minute.", guide: "lich#summon-plague-beast-mastodon"),
        (key: "lich/summon-plague-beast-mastodons", name: "Summon Plague Beast Mastodons", summary: "From rank 5, summon two Plague Beast Mastodons for 1 minute.", guide: "lich#summon-plague-beast-mastodons"),
        (key: "lich/summon-ravener-dragon", name: "Summon Ravener Dragon", summary: "From rank 9, summon a Ravener Dragon for 1 minute.", guide: "lich#summon-ravener-dragon"),
        (key: "lich/summon-spectre", name: "Summon Spectre", summary: "From rank 2, summon a Spectre for 1 minute.", guide: "lich#summon-spectre"),
    ],
    selections: [
        (
            key: "lich/lich-powers",
            name: "Lich Powers",
            summary: "At ranks 3, 6 and 9, choose a Lich power.",
            guide: "lich#lich-powers",
            options: [
                (key: "lich/lich-powers/deadly-magic", name: "Deadly Magic", summary: "3 rounds a day, your spells ignore spell resistance, and creatures they affect can\'t cast for 1d3+1 rounds.", guide: "lich#deadly-magic"),
                (key: "lich/lich-powers/death-of-elements", name: "Death of Elements", summary: "Turn your elemental damage into negative energy, and for 1 round per 2 MR turn incoming elemental damage into negative energy.", guide: "lich#death-of-elements"),
                (key: "lich/lich-powers/death-rush", name: "Death Rush", summary: "Hits when charging or making a combat manoeuvre deal an extra 1d6 per mythic rank.", guide: "lich#death-rush"),
                (key: "lich/lich-powers/decaying-touch", name: "Decaying Touch", summary: "Touch, unarmed and natural attacks deal +1d6 + MR unholy and 1 Strength damage a hit; plants take another 2d6 + MR.", guide: "lich#decaying-touch"),
                (key: "lich/lich-powers/eclipse-chill", name: "Eclipse Chill", summary: "3 rounds a day, imbued spells blind foes failing Fortitude, deal 2d8 + MR cold and leave them vulnerable to cold and negative energy.", guide: "lich#eclipse-chill"),
                (key: "lich/lich-powers/fear-control", name: "Fear Control", summary: "+4 attack and +1 per MR damage against frightened or mind-affected foes; enemies within 10 ft that fail a Will save are shaken all combat.", guide: "lich#fear-control"),
                (key: "lich/lich-powers/indestructible-bones", name: "Indestructible Bones", summary: "DR 10/-, and an enemy that hits you takes a -2 attack penalty (not stacking) for the rest of combat.", guide: "lich#indestructible-bones"),
                (key: "lich/lich-powers/magic-devourer", name: "Magic Devourer", summary: "Spell resistance 25 + MR; when an enemy fails to beat it, your next spell or kinetic blast is quickened.", guide: "lich#magic-devourer"),
                (key: "lich/lich-powers/negative-energy-mastery", name: "Negative Energy Mastery", summary: "Kinetic blasts and alchemist bombs deal +1d6 + MR negative energy damage and give the target a negative level.", guide: "lich#negative-energy-mastery"),
                (key: "lich/lich-powers/tainted-sneak-attack", name: "Tainted Sneak Attack", summary: "Sneak attacks force a Fortitude save or the target becomes vulnerable to weapon and elemental damage and takes -2 attack and damage all combat.", guide: "lich#tainted-sneak-attack"),
                (key: "lich/lich-powers/undead-mount", name: "Undead Mount", summary: "Your animal companion gains undead traits, DR 10/good and spell resistance 15.", guide: "lich#undead-mount"),
                (key: "lich/lich-powers/weapon-of-death", name: "Weapon of Death", summary: "Give your weapons Living Bane; a kill makes creatures within 15 ft take -MR on caster level checks against spell resistance for the combat.", guide: "lich#weapon-of-death"),
                (key: "lich/lich-powers/withering-life", name: "Withering Life", summary: "Living creatures hurt by your spells also take 1 point each of Str, Dex and Con damage, or of Int, Wis and Cha.", guide: "lich#withering-life"),
            ],
        ),
        (
            key: "lich/skeletal-champion",
            name: "Skeletal Champion",
            summary: "From rank 3, a Skeletal Champion companion in one of four fighting styles.",
            guide: "lich#skeletal-champion",
            options: [
                (key: "lich/skeletal-champion/skeletal-assassin", name: "Skeletal Assassin", summary: "Your skeletal champion fights with two weapons.", guide: "lich#skeletal-assassin"),
                (key: "lich/skeletal-champion/skeletal-executioner", name: "Skeletal Executioner", summary: "Your skeletal champion fights with a two-handed weapon.", guide: "lich#skeletal-executioner"),
                (key: "lich/skeletal-champion/skeletal-marksman", name: "Skeletal Marksman", summary: "Your skeletal champion is an archer.", guide: "lich#skeletal-marksman"),
                (key: "lich/skeletal-champion/skeletal-vanguard", name: "Skeletal Vanguard", summary: "Your skeletal champion focuses on defence.", guide: "lich#skeletal-vanguard"),
            ],
        ),
        (
            key: "lich/skeleton-upgrade",
            name: "Skeleton Upgrade",
            summary: "At ranks 4, 8 and 10, upgrade your skeletal champion with a class\'s abilities.",
            guide: "lich#skeleton-upgrade",
            options: [
                (key: "lich/skeleton-upgrade/skeletal-barbarian-i", name: "Skeletal Barbarian I", summary: "Your skeletal champion gains Rage, Fast Movement and 2 rage powers.", guide: "lich#skeletal-barbarian-i"),
                (key: "lich/skeleton-upgrade/skeletal-bard-i", name: "Skeletal Bard I", summary: "Your skeletal champion gains Dirge of Doom, Lingering Performance and some spells of levels 1-4.", guide: "lich#skeletal-bard-i"),
                (key: "lich/skeleton-upgrade/skeletal-cleric-i", name: "Skeletal Cleric I", summary: "Your skeletal champion channels negative energy, gains the Death and Destruction domains and knows every Cleric spell.", guide: "lich#skeletal-cleric-i"),
                (key: "lich/skeleton-upgrade/skeletal-fighter-i", name: "Skeletal Fighter I", summary: "Your skeletal champion gains a bonus combat feat, armor training, weapon training and BAB equal to its Hit Dice.", guide: "lich#skeletal-fighter-i"),
                (key: "lich/skeleton-upgrade/skeletal-inquisitor-i", name: "Skeletal Inquisitor I", summary: "Your skeletal champion gains Judgment twice a day, Bane and a teamwork feat.", guide: "lich#skeletal-inquisitor-i"),
                (key: "lich/skeleton-upgrade/skeletal-magus-i", name: "Skeletal Magus I", summary: "Your skeletal champion gains an Arcane Pool, Spell Combat and Magus spells up to 3rd level.", guide: "lich#skeletal-magus-i"),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["lich/bypass-epic-damage-reduction", "lich/danse-macabre"]),
        (rank: 2, features: ["lich/negative-energy-insight", "lich/summon-spectre", "lich/hard-to-kill"]),
        (rank: 3, features: ["lich/summon-fallen"], selections: ["lich/lich-powers", "lich/skeletal-champion"]),
        (rank: 4, features: ["lich/lord-beyond-the-grave", "lich/summon-plague-beast-mastodon"], selections: ["lich/skeleton-upgrade"]),
        (rank: 5, features: ["lich/dark-rites", "lich/summon-plague-beast-mastodons"]),
        (rank: 6, features: ["lich/summon-ecorche"], selections: ["lich/lich-powers"]),
        (rank: 7, features: ["lich/summon-nightshade-nightcrawler"]),
        (rank: 8, features: ["lich/summon-nightshade-nightcrawler-and-ecorche"], selections: ["lich/skeleton-upgrade"]),
        (rank: 9, features: ["lich/summon-ravener-dragon"], selections: ["lich/lich-powers"]),
        (rank: 10, selections: ["lich/skeleton-upgrade"]),
    ],
)
