MythicPath(
    key: "lich",
    blueprint: "5d501618a28bdc24c80007a5c937dcb7",
    name: "Lich",
    guide: "lich",
    features: [
        (key: "lich/bypass-epic-damage-reduction", blueprint: "c60933cc085132b49970cbc4a4b8338f", name: "Bypass Epic Damage Reduction", summary: "From mythic rank 1, your attacks get past epic damage reduction.", guide: "mythic-paths#bypass-epic-damage-reduction"),
        (key: "lich/danse-macabre", blueprint: "4457101b8eca5a546a5a0bdb651bd003", name: "Danse Macabre", summary: "Channel negative energy: living creatures within 30 ft take 2d6 + 1d6 per MR (Will half), and undead in the area are healed.", guide: "lich#danse-macabre"),
        (key: "lich/dark-rites", blueprint: "9703d79082dc75e4aaaa4387b9c95229", name: "Dark Rites", summary: "At rank 5, you and allies within 30 ft gain +2 effective caster level.", guide: "lich#dark-rites"),
        (key: "lich/hard-to-kill", blueprint: "bef12729fa3f9b34488634f61751e295", name: "Hard to Kill", summary: "From rank 2, you die only when your negative hit points reach twice your Constitution.", guide: "mythic-paths#hard-to-kill"),
        (key: "lich/lord-beyond-the-grave", blueprint: "eea98a8c70c68ff489967c6f9cf1876c", name: "Lord Beyond the Grave", summary: "From rank 4, Command Undead at will; your undead gain MR/2+1 to Str, Dex and Cha, and their attacks ignore DR other than DR/-.", guide: "lich#lord-beyond-the-grave"),
        (key: "lich/negative-energy-insight", blueprint: "b1a295adfe8c94444a2b433913fb7a01", name: "Negative Energy Insight", summary: "At rank 2, +2 on saves vs. death effects, and +2 AC, saves, attack, damage and class ability DCs against negative-energy-affinity creatures.", guide: "lich#negative-energy-insight"),
        (key: "lich/summon-ecorche", blueprint: "67a89bc88735c2140b905a28753e0b9a", name: "Summon Ecorche", summary: "From rank 6, summon an Ecorche for 1 minute.", guide: "lich#summon-ecorche"),
        (key: "lich/summon-fallen", blueprint: "e90f6b00a7f34ab458d2fb780859e267", name: "Summon Fallen", summary: "From rank 3, summon a Fallen for 1 minute.", guide: "lich#summon-fallen"),
        (key: "lich/summon-nightshade-nightcrawler", blueprint: "0d3d4e7c7128eb740a9ecb34d607044d", name: "Summon Nightshade Nightcrawler", summary: "From rank 7, summon a Nightshade Nightcrawler for 1 minute.", guide: "lich#summon-nightshade-nightcrawler"),
        (key: "lich/summon-nightshade-nightcrawler-and-ecorche", blueprint: "42efe07b222f84147b745f7178bdf31f", name: "Summon Nightshade Nightcrawler and Ecorche", summary: "From rank 8, summon a Nightshade Nightcrawler and an Ecorche for 1 minute.", guide: "lich#summon-nightshade-nightcrawler-and-ecorche"),
        (key: "lich/summon-plague-beast-mastodon", blueprint: "c430a28663771444aaa27015c8d7b7b2", name: "Summon Plague Beast Mastodon", summary: "From rank 4, summon a Plague Beast Mastodon for 1 minute.", guide: "lich#summon-plague-beast-mastodon"),
        (key: "lich/summon-plague-beast-mastodons", blueprint: "d577689cc2c31b6459644de459baf968", name: "Summon Plague Beast Mastodons", summary: "From rank 5, summon two Plague Beast Mastodons for 1 minute.", guide: "lich#summon-plague-beast-mastodons"),
        (key: "lich/summon-ravener-dragon", blueprint: "27cb42d0d83c73849b9b6d76ae004984", name: "Summon Ravener Dragon", summary: "From rank 9, summon a Ravener Dragon for 1 minute.", guide: "lich#summon-ravener-dragon"),
        (key: "lich/summon-spectre", blueprint: "506b4aeb2b7bb36448cf3858c943d5bb", name: "Summon Spectre", summary: "From rank 2, summon a Spectre for 1 minute.", guide: "lich#summon-spectre"),
    ],
    selections: [
        (
            key: "lich/lich-powers",
            blueprint: "1f646b820a37d3d4a8ab116a24ee0022",
            name: "Lich Powers",
            summary: "At ranks 3, 6 and 9, choose a Lich power.",
            guide: "lich#lich-powers",
            options: [
                (key: "lich/lich-powers/deadly-magic", blueprint: "47a8a7fa7d4198f449db71cdbe4b8d3e", name: "Deadly Magic", summary: "3 rounds a day, your spells ignore spell resistance, and creatures they affect can\'t cast for 1d3+1 rounds.", guide: "lich#deadly-magic"),
                (key: "lich/lich-powers/death-of-elements", blueprint: "2743491c52185344fba589754590d909", name: "Death of Elements", summary: "Your elemental damage can become negative energy, and for 1 round per 2 MR so can elemental damage dealt to you.", guide: "lich#death-of-elements"),
                (key: "lich/lich-powers/death-rush", blueprint: "ef847913c29a3cf44825eb30ae6f7c38", name: "Death Rush", summary: "Hits when charging or making a combat manoeuvre deal an extra 1d6 per mythic rank.", guide: "lich#death-rush"),
                (key: "lich/lich-powers/decaying-touch", blueprint: "3eb8922c8a9e25048b6689322c5ae131", name: "Decaying Touch", summary: "Touch, unarmed and natural attacks deal +1d6 + MR unholy and 1 Strength damage a hit; plants take another 2d6 + MR.", guide: "lich#decaying-touch"),
                (key: "lich/lich-powers/eclipse-chill", blueprint: "731bebb09171d5748b6f08cbe88f8af7", name: "Eclipse Chill", summary: "3 rounds a day, imbued spells blind foes failing Fortitude, deal 2d8 + MR cold and leave them vulnerable to cold and negative energy.", guide: "lich#eclipse-chill"),
                (key: "lich/lich-powers/fear-control", blueprint: "16c499797605dd244a365fc73f475e11", name: "Fear Control", summary: "+4 attack and +1 per MR damage against frightened or mind-affected foes; enemies within 10 ft that fail a Will save are shaken all combat.", guide: "lich#fear-control"),
                (key: "lich/lich-powers/indestructible-bones", blueprint: "42274a4428cb43b40acf771a7f5ddfac", name: "Indestructible Bones", summary: "DR 10/-, and an enemy that hits you takes a -2 attack penalty (not stacking) for the rest of combat.", guide: "lich#indestructible-bones"),
                (key: "lich/lich-powers/magic-devourer", blueprint: "5e89a8a186bed88488356e8c58dfed50", name: "Magic Devourer", summary: "Spell resistance 25 + MR; when an enemy fails to beat it, your next spell or kinetic blast is quickened.", guide: "lich#magic-devourer"),
                (key: "lich/lich-powers/negative-energy-mastery", blueprint: "588a9725462266441993dfa94d8da578", name: "Negative Energy Mastery", summary: "Kinetic blasts and alchemist bombs add 1d6 + MR negative energy damage and leave the target with one negative level.", guide: "lich#negative-energy-mastery"),
                (key: "lich/lich-powers/tainted-sneak-attack", blueprint: "e6ce101a94ac9034b8b55c546e74b9dd", name: "Tainted Sneak Attack", summary: "Sneak attacks force a Fortitude save or the target becomes vulnerable to weapon and elemental damage and takes -2 attack and damage all combat.", guide: "lich#tainted-sneak-attack"),
                (key: "lich/lich-powers/undead-mount", blueprint: "a46d64cfd32fc3749a5897657247a680", name: "Undead Mount", summary: "Your animal companion takes on undead traits and gets spell resistance 15 and DR 10/good.", guide: "lich#undead-mount"),
                (key: "lich/lich-powers/weapon-of-death", blueprint: "8d28d96d3fad9d640b1b55f76ee11885", name: "Weapon of Death", summary: "Give your weapons Living Bane; a kill makes creatures within 15 ft take -MR on caster level checks against spell resistance for the combat.", guide: "lich#weapon-of-death"),
                (key: "lich/lich-powers/withering-life", blueprint: "715ba496673489045a74dfcbddf876c2", name: "Withering Life", summary: "Living creatures hurt by your spells also take 1 point each of Str, Dex and Con damage, or of Int, Wis and Cha.", guide: "lich#withering-life"),
            ],
        ),
        (
            key: "lich/skeletal-champion",
            blueprint: "a9b91b7f3fd9bbd49a942a4b2e98cb11",
            name: "Skeletal Champion",
            summary: "From rank 3, a Skeletal Champion companion in one of four fighting styles.",
            guide: "lich#skeletal-champion",
            options: [
                (key: "lich/skeletal-champion/skeletal-assassin", blueprint: "d4583662450245446ae3a56e07232e6f", name: "Skeletal Assassin", summary: "Your skeletal champion fights with two weapons.", guide: "lich#skeletal-assassin"),
                (key: "lich/skeletal-champion/skeletal-executioner", blueprint: "f984e621943c532478d9df0e79c49a78", name: "Skeletal Executioner", summary: "Your skeletal champion fights with a two-handed weapon.", guide: "lich#skeletal-executioner"),
                (key: "lich/skeletal-champion/skeletal-marksman", blueprint: "0cebe3b375b6397438909ac9752d9792", name: "Skeletal Marksman", summary: "Your skeletal champion is an archer.", guide: "lich#skeletal-marksman"),
                (key: "lich/skeletal-champion/skeletal-vanguard", blueprint: "048456cce79943f4c9c9eec1aa5ce9a0", name: "Skeletal Vanguard", summary: "Your skeletal champion focuses on defence.", guide: "lich#skeletal-vanguard"),
            ],
        ),
        (
            key: "lich/skeleton-upgrade",
            blueprint: "a434dddab8026e947bc16eb36d18a783",
            name: "Skeleton Upgrade",
            summary: "At ranks 4, 8 and 10, upgrade your skeletal champion with a class\'s abilities.",
            guide: "lich#skeleton-upgrade",
            options: [
                (key: "lich/skeleton-upgrade/skeletal-barbarian-i", blueprint: "f8b516bea12d4a6daa5e72e2898d2467", name: "Skeletal Barbarian I", summary: "Barbarian upgrade for the skeletal champion: Rage, Fast Movement and two rage powers.", guide: "lich#skeletal-barbarian-i"),
                (key: "lich/skeleton-upgrade/skeletal-bard-i", blueprint: "0bc53f33005d08146b916b1c400998d6", name: "Skeletal Bard I", summary: "Your skeletal champion gains Dirge of Doom, Lingering Performance and some spells of levels 1-4.", guide: "lich#skeletal-bard-i"),
                (key: "lich/skeleton-upgrade/skeletal-cleric-i", blueprint: "4033008a4c7fc814aad708e80cf50c37", name: "Skeletal Cleric I", summary: "Your skeletal champion channels negative energy, gains the Death and Destruction domains and knows every Cleric spell.", guide: "lich#skeletal-cleric-i"),
                (key: "lich/skeleton-upgrade/skeletal-fighter-i", blueprint: "c871a3847e860504a806e1b21ab12a48", name: "Skeletal Fighter I", summary: "Fighter upgrade for the skeletal champion: a bonus combat feat, armor and weapon training, and full BAB for its Hit Dice.", guide: "lich#skeletal-fighter-i"),
                (key: "lich/skeleton-upgrade/skeletal-inquisitor-i", blueprint: "c237f25a4541d784b971d260c88f2f14", name: "Skeletal Inquisitor I", summary: "Inquisitor upgrade for the skeletal champion: Judgment 2/day, Bane and a teamwork feat.", guide: "lich#skeletal-inquisitor-i"),
                (key: "lich/skeleton-upgrade/skeletal-magus-i", blueprint: "1192b090d635b74448eceb313435d437", name: "Skeletal Magus I", summary: "Magus upgrade for the skeletal champion: Arcane Pool, Spell Combat and Magus spells through 3rd level.", guide: "lich#skeletal-magus-i"),
            ],
        ),
    ],
    ranks: [
        (rank: 1, features: ["lich/bypass-epic-damage-reduction", "lich/danse-macabre"]),
        (rank: 2, features: ["lich/negative-energy-insight", "lich/summon-spectre", "lich/hard-to-kill"]),
        (rank: 3, features: ["lich/summon-fallen"], selections: ["lich/lich-powers", "lich/skeletal-champion"]),
        (rank: 4, features: ["lich/lord-beyond-the-grave", "lich/summon-plague-beast-mastodon"], selections: ["lich/skeleton-upgrade"]),
        (rank: 5, features: ["lich/dark-rites", "lich/summon-plague-beast-mastodons"]),
        (rank: 6, features: ["lich/summon-ecorche"], selections: ["lich/lich-powers"]),
        (rank: 7, features: ["lich/summon-nightshade-nightcrawler"]),
        (rank: 8, features: ["lich/summon-nightshade-nightcrawler-and-ecorche"], selections: ["lich/skeleton-upgrade"]),
        (rank: 9, features: ["lich/summon-ravener-dragon"], selections: ["lich/lich-powers"]),
        (rank: 10, selections: ["lich/skeleton-upgrade"]),
    ],
)
