// The flat bonuses items give while held (tickets 119 and 120), each with the item that gives it: `rules::ItemBonus`.
// The caster line and the totals (initiative, saves, skills) sum the ones a character holds. Only what the guide (or,
// for backgrounds, the user's list) states without a condition the Build can't fix: gear, buffs, abilities switched
// on in a fight, bonuses against one kind of effect or for one use of a skill, and bonuses that grow with class level
// stay out (the caster line's and the totals' `leaves_out`). A race's bonus counts without a subrace, a subrace's in
// place of its race's.
[
    // Spell save DCs.
    (item: Feat("spell-focus"), target: SpellDc(Value), amount: Flat(1)),
    (item: Feat("greater-spell-focus"), target: SpellDc(Value), amount: Flat(1)),
    (item: MythicFeat("spell-focus-mythic"), target: SpellDc(Value), amount: Flat(1)),
    // "Any bonuses from Spell Focus feats for another school": Spell Focus, Greater and Mythic, of one school.
    (item: MythicFeat("expanded-arsenal"), target: SpellDc(Value), amount: SpellFocusOfAnotherSchool),
    (item: Feat("elemental-focus"), target: SpellDc(Value), amount: Flat(1)),
    (item: Feat("greater-elemental-focus"), target: SpellDc(Value), amount: Flat(1)),
    (item: Feat("improved-elven-immunities"), target: SpellDc(School(Enchantment)), amount: Flat(1)),
    (item: Race("kitsune"), target: SpellDc(School(Enchantment)), amount: Flat(1)),
    (item: Subrace("kitsune/keen-kitsune"), target: SpellDc(School(Enchantment)), amount: Flat(1)),
    (item: Race("gnome"), target: SpellDc(School(Illusion)), amount: Flat(1)),
    (item: Subrace("gnome/traveler"), target: SpellDc(School(Illusion)), amount: Flat(1)),
    (item: Subrace("gnome/pyromaniac"), target: SpellDc(Energy(Fire)), amount: Flat(1)),
    (item: Race("oread"), target: SpellDc(Energy(Acid)), amount: Flat(1)),
    (item: Subrace("oread/gemsoul"), target: SpellDc(Energy(Acid)), amount: Flat(1)),
    (item: Subrace("oread/ironsoul"), target: SpellDc(Energy(Acid)), amount: Flat(1)),
    (item: Subrace("tiefling/spitespawn"), target: SpellDc(School(Enchantment)), amount: Flat(1)),
    (item: Feature("sorcerer/bloodline/arcane/arcane-arcana"), target: SpellDc(Metamagic), amount: Flat(1)),
    (item: Feature("sorcerer/sage-sorcerer/arcane-arcana"), target: SpellDc(Metamagic), amount: Flat(1)),
    (item: Feature("sorcerer/bloodline/fey/fey-arcana"), target: SpellDc(Subschool(Compulsion)), amount: Flat(2)),
    (item: Feature("sorcerer/bloodline/infernal/infernal-arcana"), target: SpellDc(Subschool(Charm)), amount: Flat(2)),
    (item: SelectionOption("sorcerer/bloodline/arcane/school-power/abjuration"), target: SpellDc(School(Abjuration)), amount: Flat(2)),
    (item: SelectionOption("sorcerer/bloodline/arcane/school-power/conjuration"), target: SpellDc(School(Conjuration)), amount: Flat(2)),
    (item: SelectionOption("sorcerer/bloodline/arcane/school-power/divination"), target: SpellDc(School(Divination)), amount: Flat(2)),
    (item: SelectionOption("sorcerer/bloodline/arcane/school-power/enchantment"), target: SpellDc(School(Enchantment)), amount: Flat(2)),
    (item: SelectionOption("sorcerer/bloodline/arcane/school-power/evocation"), target: SpellDc(School(Evocation)), amount: Flat(2)),
    (item: SelectionOption("sorcerer/bloodline/arcane/school-power/illusion"), target: SpellDc(School(Illusion)), amount: Flat(2)),
    (item: SelectionOption("sorcerer/bloodline/arcane/school-power/necromancy"), target: SpellDc(School(Necromancy)), amount: Flat(2)),
    (item: SelectionOption("sorcerer/bloodline/arcane/school-power/transmutation"), target: SpellDc(School(Transmutation)), amount: Flat(2)),

    // Caster level checks against spell resistance.
    (item: Feat("spell-penetration"), target: SpellPenetration, amount: Flat(2)),
    (item: Feat("greater-spell-penetration"), target: SpellPenetration, amount: Flat(2)),
    // Half the Mythic rank, or the full rank with Greater Spell Penetration.
    (item: MythicFeat("spell-penetration-mythic"), target: SpellPenetration, amount: HalfMythicRank, requires: Not(Feat("greater-spell-penetration"))),
    (item: MythicFeat("spell-penetration-mythic"), target: SpellPenetration, amount: MythicRank, requires: Feat("greater-spell-penetration")),
    (item: Race("elf"), target: SpellPenetration, amount: Flat(2)),
    (item: Subrace("half-elf/dual-heritage"), target: SpellPenetration, amount: Flat(2)),
    (item: Feat("elven-spirit"), target: SpellPenetration, amount: Flat(2)),
    (item: Feat("arcane-focus"), target: SpellPenetration, amount: Flat(1)),
    (item: Feature("sorcerer/bloodline/fey/fey-magic"), target: SpellPenetration, amount: Flat(2)),

    // Concentration checks.
    (item: Feat("combat-casting"), target: Concentration, amount: Flat(4)),
    (item: Feat("warrior-priest"), target: Concentration, amount: Flat(2)),

    // Initiative (ticket 120).
    (item: Feat("improved-initiative"), target: Initiative, amount: Flat(4)),
    (item: MythicFeat("improved-initiative-mythic"), target: Initiative, amount: MythicRank),
    (item: Feat("warrior-priest"), target: Initiative, amount: Flat(1)),
    (item: Background("pickpocket"), target: Initiative, amount: Flat(2)),
    (item: Subrace("halfling/hasty"), target: Initiative, amount: Flat(2)),
    (item: Feature("duelist/improved-reaction"), target: Initiative, amount: Flat(2), requires: Not(ClassLevel(class: "duelist", level: 8))),
    (item: Feature("duelist/improved-reaction"), target: Initiative, amount: Flat(4), requires: ClassLevel(class: "duelist", level: 8)),
    (item: SelectionOption("oracle/oracles-curse/powerless-prophecy"), target: Initiative, amount: Flat(4), requires: ClassLevel(class: "oracle", level: 5)),
    (item: Feature("oracle/possessed-oracle/powerless-prophecy"), target: Initiative, amount: Flat(4), requires: ClassLevel(class: "oracle", level: 5)),
    (item: SelectionOption("oracle/oracles-curse/pranked"), target: Initiative, amount: Flat(-4)),
    // "Adds both Wisdom and Dexterity": Wisdom beside the Dexterity every initiative counts.
    (item: Feature("inquisitor/cunning-initiative"), target: Initiative, amount: AbilityModifier(Wisdom)),
    (item: Feature("barbarian/instinctual-warrior/fervent-reflexes"), target: Initiative, amount: AbilityModifier(Wisdom)),
    (item: Feature("magus/sword-saint/lightning-draw"), target: Initiative, amount: AbilityModifier(Intelligence)),
    // Stat Focus's initiative, Fortitude, Reflex or Will.
    (item: Feat("stat-focus"), target: Held, amount: Flat(1)),

    // Saving throws (ticket 120). The mythic Great Fortitude, Iron Will and Lightning Reflexes are rerolls.
    (item: Feat("great-fortitude"), target: Save(Fortitude), amount: Flat(2)),
    (item: Feat("improved-great-fortitude"), target: Save(Fortitude), amount: Flat(2)),
    (item: Feat("iron-will"), target: Save(Will), amount: Flat(2)),
    (item: Feat("improved-iron-will"), target: Save(Will), amount: Flat(2)),
    (item: Feat("lightning-reflexes"), target: Save(Reflex), amount: Flat(2)),
    (item: Feat("improved-lightning-reflexes"), target: Save(Reflex), amount: Flat(2)),
    (item: MythicFeat("mythic-resolve"), target: AllSaves, amount: Flat(1)),
    (item: Race("halfling"), target: AllSaves, amount: Flat(1)),
    (item: Subrace("halfling/hasty"), target: AllSaves, amount: Flat(1)),
    (item: Subrace("halfling/craven"), target: Save(Reflex), amount: Flat(2)),
    (item: Subrace("half-orc/tribal"), target: AllSaves, amount: Flat(1)),
    (item: Subrace("half-elf/dual-heritage"), target: Save(Will), amount: Flat(2)),
    (item: Subrace("dwarf/unstoppable-dwarf"), target: Save(Fortitude), amount: Flat(1)),
    // The user's list: +1 Fortitude for the four, +1 Reflex for the Varisian Explorer.
    (item: Background("farmhand"), target: Save(Fortitude), amount: Flat(1)),
    (item: Background("lumberjack"), target: Save(Fortitude), amount: Flat(1)),
    (item: Background("miner"), target: Save(Fortitude), amount: Flat(1)),
    (item: Background("smith"), target: Save(Fortitude), amount: Flat(1)),
    (item: Background("varisian-explorer"), target: Save(Reflex), amount: Flat(1)),
    (item: SelectionOption("loremaster/secret/fortitude-secret"), target: Save(Fortitude), amount: Flat(2)),
    (item: SelectionOption("loremaster/secret/reflex-secret"), target: Save(Reflex), amount: Flat(2)),
    (item: SelectionOption("loremaster/secret/will-secret"), target: Save(Will), amount: Flat(2)),
    (item: Feature("duelist/grace"), target: Save(Reflex), amount: Flat(2)),
    (item: Feature("paladin/divine-grace"), target: AllSaves, amount: AbilityModifier(Charisma)),
    (item: Feature("oracle/mystery/ancestor/ancestor-final-revelation"), target: Save(Will), amount: AbilityModifier(Charisma)),
    (item: Feature("oracle/enlightened-philosopher/final-revelation-enlightened-philosopher"), target: AllSaves, amount: AbilityModifier(Charisma)),

    // Skills (ticket 120): feats.
    (item: Feat("skill-focus"), target: Held, amount: TenRanks(amount: 3, with_ten_ranks: 6)),
    (item: Feat("alertness"), target: Skill("perception"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("deceitful"), target: Skill("persuasion"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("deceitful"), target: Skill("trickery"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("deft-hands"), target: Skill("trickery"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("deft-hands"), target: Skill("use-magic-device"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("persuasive"), target: Skill("persuasion"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("persuasive"), target: Skill("perception"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("stealthy"), target: Skill("mobility"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("stealthy"), target: Skill("stealth"), amount: TenRanks(amount: 2, with_ten_ranks: 4)),
    (item: Feat("breadth-of-experience"), target: Skill("knowledge-arcana"), amount: Flat(2)),
    (item: Feat("breadth-of-experience"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Feat("breadth-of-experience"), target: Skill("lore-nature"), amount: Flat(2)),
    (item: Feat("breadth-of-experience"), target: Skill("lore-religion"), amount: Flat(2)),
    (item: Feat("discerning-eye"), target: Skill("use-magic-device"), amount: Flat(2)),
    (item: Feat("elven-spirit"), target: Skill("knowledge-arcana"), amount: Flat(2)),
    (item: Feat("endurance"), target: Skill("athletics"), amount: Flat(2)),
    (item: Feat("stony-step"), target: Skill("mobility"), amount: Flat(2)),

    // Skills: races and subraces ("Persuasion when used for diplomacy, bluff or to intimidate" stays out).
    (item: Race("elf"), target: Skill("perception"), amount: Flat(2)),
    (item: Race("elf"), target: Skill("knowledge-arcana"), amount: Flat(2)),
    (item: Subrace("elf/blightborn"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("elf/loremaster"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("elf/loremaster"), target: Skill("knowledge-arcana"), amount: Flat(2)),
    (item: Subrace("elf/loremaster"), target: Skill("use-magic-device"), amount: Flat(2)),
    (item: Race("dwarf"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("dwarf/barrow-dwarf"), target: Skill("lore-religion"), amount: Flat(2)),
    (item: Race("gnome"), target: Skill("perception"), amount: Flat(2)),
    (item: Race("gnome"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Subrace("gnome/pyromaniac"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("gnome/pyromaniac"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Subrace("gnome/traveler"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("gnome/traveler"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Subrace("gnome/traveler"), target: Skill("lore-nature"), amount: Flat(2)),
    (item: Race("halfling"), target: Skill("athletics"), amount: Flat(2)),
    (item: Race("halfling"), target: Skill("mobility"), amount: Flat(2)),
    (item: Race("halfling"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("halfling/craven"), target: Skill("athletics"), amount: Flat(2)),
    (item: Subrace("halfling/craven"), target: Skill("mobility"), amount: Flat(2)),
    (item: Subrace("halfling/craven"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("halfling/hasty"), target: Skill("perception"), amount: Flat(2)),
    (item: Race("half-elf"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("half-elf/dual-heritage"), target: Skill("knowledge-arcana"), amount: Flat(2)),
    (item: Race("half-orc"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("half-orc/human-raised"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("half-orc/tribal"), target: Skill("lore-nature"), amount: Flat(2)),
    (item: Race("aasimar"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("aasimar/angelkin"), target: Skill("lore-religion"), amount: Flat(2)),
    (item: Subrace("aasimar/angelkin"), target: Skill("use-magic-device"), amount: Flat(2)),
    (item: Subrace("aasimar/emberkin"), target: Skill("lore-religion"), amount: Flat(2)),
    (item: Subrace("aasimar/emberkin"), target: Skill("knowledge-arcana"), amount: Flat(2)),
    (item: Subrace("aasimar/idyllkin"), target: Skill("lore-nature"), amount: Flat(2)),
    (item: Subrace("aasimar/idyllkin"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("aasimar/lawbringer"), target: Skill("persuasion"), amount: Flat(2)),
    (item: Subrace("aasimar/lawbringer"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("aasimar/musetouched"), target: Skill("persuasion"), amount: Flat(2)),
    (item: Subrace("aasimar/musetouched"), target: Skill("mobility"), amount: Flat(2)),
    (item: Subrace("aasimar/plumekith"), target: Skill("athletics"), amount: Flat(2)),
    (item: Subrace("aasimar/plumekith"), target: Skill("mobility"), amount: Flat(2)),
    (item: Race("tiefling"), target: Skill("stealth"), amount: Flat(2)),
    (item: Subrace("tiefling/beastbrood"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("tiefling/faultspawn"), target: Skill("knowledge-arcana"), amount: Flat(2)),
    (item: Subrace("tiefling/faultspawn"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Subrace("tiefling/foulspawn"), target: Skill("lore-religion"), amount: Flat(2)),
    (item: Subrace("tiefling/grimspawn"), target: Skill("trickery"), amount: Flat(2)),
    (item: Subrace("tiefling/hellspawn"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("tiefling/hungerseed"), target: Skill("persuasion"), amount: Flat(2)),
    (item: Subrace("tiefling/motherless"), target: Skill("lore-nature"), amount: Flat(2)),
    (item: Subrace("tiefling/motherless"), target: Skill("mobility"), amount: Flat(2)),
    (item: Subrace("tiefling/pitborn"), target: Skill("trickery"), amount: Flat(2)),
    (item: Subrace("tiefling/pitborn"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("tiefling/shackleborn"), target: Skill("mobility"), amount: Flat(2)),
    (item: Subrace("tiefling/spitespawn"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Race("oread"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("oread/gemsoul"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("oread/ironsoul"), target: Skill("perception"), amount: Flat(2)),
    (item: Race("dhampir"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("dhampir/ru-shi"), target: Skill("mobility"), amount: Flat(2)),
    (item: Subrace("dhampir/ru-shi"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Subrace("dhampir/svetocher"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Subrace("dhampir/ancient-born"), target: Skill("athletics"), amount: Flat(2)),
    (item: Subrace("dhampir/ancient-born"), target: Skill("lore-nature"), amount: Flat(2)),
    (item: Subrace("dhampir/sacred-ancestry"), target: Skill("knowledge-world"), amount: Flat(2)),
    (item: Subrace("dhampir/ajibachana"), target: Skill("stealth"), amount: Flat(2)),
    (item: Subrace("dhampir/ajibachana"), target: Skill("use-magic-device"), amount: Flat(2)),
    (item: Race("kitsune"), target: Skill("perception"), amount: Flat(2)),
    (item: Race("kitsune"), target: Skill("mobility"), amount: Flat(2)),
    (item: Subrace("kitsune/keen-kitsune"), target: Skill("perception"), amount: Flat(2)),
    (item: Subrace("kitsune/keen-kitsune"), target: Skill("mobility"), amount: Flat(2)),

    // Skills: backgrounds (the user's list; the Andoran Diplomat's diplomacy stays out).
    (item: Background("nexian-scholar"), target: Skill("knowledge-arcana"), amount: Flat(2)),
    (item: Background("osirian-historian"), target: Skill("knowledge-world"), amount: Flat(2)),

    // Skills: class, prestige and mythic features.
    (item: Feature("druid/nature-sense"), target: Skill("lore-nature"), amount: Flat(2)),
    (item: Feature("hunter/nature-sense"), target: Skill("lore-nature"), amount: Flat(2)),
    (item: SelectionOption("rogue/rogue-talents/canny-observer"), target: Skill("perception"), amount: Flat(4)),
    (item: Feature("warpriest/cult-leader/well-hidden"), target: Skill("stealth"), amount: Flat(2)),
    (item: Feature("hellknight-signifer/diabolic-harbinger"), target: Skill("persuasion"), amount: Flat(2)),
    (item: Feature("paladin/divine-scion/divine-insight"), target: Skill("knowledge-arcana"), amount: AbilityModifier(Charisma)),
    (item: Feature("paladin/divine-scion/divine-insight"), target: Skill("knowledge-world"), amount: AbilityModifier(Charisma)),
    (item: Feature("paladin/divine-scion/divine-insight"), target: Skill("lore-nature"), amount: AbilityModifier(Charisma)),
    (item: Feature("paladin/divine-scion/divine-insight"), target: Skill("lore-religion"), amount: AbilityModifier(Charisma)),
    (item: Feature("trickster/creative-approach"), target: AllSkills, amount: Flat(3)),
    // "When you or an ally within 50' make a skill check": the character's own checks count.
    (item: SelectionOption("trickster/mythic-trick/knowledge-world-i"), target: AllSkills, amount: HalfMythicRank),
    (item: SelectionOption("azata/superpowers/all-skilled"), target: AllSkills, amount: MythicRank),
]
