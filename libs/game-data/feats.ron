[
    (key: "ability-focus-bombs", blueprint: "f864101ab0cdb4b418c7d62d2b24eee5", name: "Ability Focus - Bombs", summary: "+2 to the save DCs of your bombs.", category: Class, guide: "feats#ability-focus-bombs", prerequisite: Any([Any([Feature(feature: "alchemist/bomb", count: 1), Feature(feature: "alchemist/reanimator/bomb-reanimator", count: 1)]), Feature(feature: "wizard/arcane-bomber/arcane-bombs", count: 1)])),
    (key: "accomplished-sneak-attacker", blueprint: "9f0187869dc23744292c0e5bb364464e", name: "Accomplished Sneak Attacker", summary: "Sneak attack gains a die (1d6), up to a cap of half your character level in dice.", category: Class, guide: "feats#accomplished-sneak-attacker", prerequisite: Any([Feature(feature: "alchemist/vivisectionist/sneak-attack", count: 1), Feature(feature: "arcane-trickster/sneak-attack", count: 1), Feature(feature: "assassin/sneak-attack", count: 1), Feature(feature: "inquisitor/sanctified-slayer/sneak-attack", count: 1), Feature(feature: "paladin/divine-scion/sneak-attack", count: 1), Feature(feature: "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel", count: 1), Feature(feature: "rogue/master-of-all/sneak-attack-master-of-all", count: 1), Feature(feature: "rogue/sneak-attack", count: 1), Feature(feature: "shaman/shadow-shaman/sneak-attack", count: 1), Feature(feature: "skald/inciter/sneak-attack", count: 1), Feature(feature: "slayer/imitator/sneak-attack-imitator", count: 1), Feature(feature: "slayer/sneak-attack", count: 1), Feature(feature: "trickster/sneak-attack", count: 1), Feature(feature: "warpriest/cult-leader/sneak-attack", count: 1)])),
    (key: "acrobatic-spellcaster", blueprint: "7ba4b4023a7748669098c479dd9e8de6", name: "Acrobatic Spellcaster", summary: "Lets a Mobility check prevent the attack of opportunity you'd provoke by botching a defensive-casting concentration check.", category: Magic, guide: "feats#acrobatic-spellcaster", prerequisite: All([Feat("combat-casting"), FeatFor(feat: "skill-focus", value: Skill("mobility"))])),
    (key: "advanced-weapon-training", blueprint: "3aa4cbdd4af5ba54888b0dc7f07f80c4", name: "Advanced Weapon Training", summary: "Pick one Weapon Training option: Armed Bravery, CMD, Effortless Dual Wielding, Fighter's Finesse, Reflexes or Tactics, or Trained Initiative.", category: Weapon, guide: "feats#advanced-weapon-training", prerequisite: All([Any([Feature(feature: "cavalier/disciple-of-the-pike/weapon-training-spears-polearms", count: 1), Feature(feature: "fighter/weapon-training", count: 1), Feature(feature: "monk/sohei/weapon-training", count: 1)]), ClassLevel(class: "fighter", level: 5)])),
    (key: "agile-maneuvers", blueprint: "197306972c98bb843af738dc7529a7ac", name: "Agile Maneuvers", summary: "Your CMB is based on Dexterity rather than Strength.", category: CombatManoeuvres, guide: "feats#agile-maneuvers", prerequisite: Any([Feat("bull-rush"), Feat("dirty-trick"), Feat("sunder-armor"), Feat("trip")])),
    (key: "aldori-dueling-mastery", blueprint: "c3a66c1bbd2fb65498b130802d5f183a", name: "Aldori Dueling Mastery", summary: "With a dueling sword: +2 initiative and +2 shield AC without a shield or off-hand weapon; it counts as piercing for Duelist abilities.", category: Weapon, guide: "feats#aldori-dueling-mastery", prerequisite: All([Feat("weapon-finesse"), FeatFor(feat: "weapon-focus", value: Weapon("dueling-sword")), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "alertness", blueprint: "1c04fe9a13a22bc499ffac03e6f79153", name: "Alertness", summary: "+2 to Perception, or +4 with 10 or more ranks.", category: Skill, guide: "feats#alertness"),
    (key: "allied-spellcaster", blueprint: "9093ceeefe9b84746a5993d619d7c86f", name: "Allied Spellcaster", summary: "Next to an ally with this feat: +2 to concentration checks and caster level checks against spell resistance.", category: Teamwork, guide: "feats#allied-spellcaster"),
    (key: "ambuscading-spells", blueprint: "2fb48bed3746431bb3080c34f11597da", name: "Ambuscading Spells", summary: "Your spells are harder to resist for flat-footed foes: -2 on their saves.", category: Magic, guide: "feats#ambuscading-spells"),
    (key: "arcane-armor-mastery", blueprint: "453f5181a5ed3a445abfa3bcd3f4ac0c", name: "Arcane Armor Mastery", summary: "Cuts arcane spell failure from armour by another 10% (20% with Arcane Armor Training).", category: Magic, guide: "feats#arcane-armor-mastery", prerequisite: Feat("arcane-armor-training")),
    (key: "arcane-armor-training", blueprint: "1a0298abacb6e0f45b7e28553e99e76c", name: "Arcane Armor Training", summary: "Cuts arcane spell failure from armour by 10%.", category: Magic, guide: "feats#arcane-armor-training"),
    (key: "arcane-focus", blueprint: "f12795ec2c204d428738bbe1bfcad8fb", name: "Arcane Focus", summary: "Casting defensively gets +2 concentration, and beating spell resistance gets +1 caster level.", category: Racial, guide: "feats#arcane-focus", prerequisite: Race("elf")),
    (key: "arcane-spirit", blueprint: "e55e2c96ae974bc9ac9fda8b3a56e432", name: "Arcane Spirit", summary: "Swift action: a Persuasion (Bluff) check vs a creature's Perception within 30 ft gives it -2 on saves against your next spell.", category: Magic, guide: "feats#arcane-spirit"),
    (key: "arcane-strike", blueprint: "0ab2f21a922feee4dab116238e3150b4", name: "Arcane Strike", summary: "A swift action grants your weapons +1 damage and magic status for a round; the bonus rises by 1 per 5 caster levels, reaching +5.", category: Magic, guide: "feats#arcane-strike", prerequisite: SpellLevel(spell_type: Arcane, level: 1)),
    (key: "armor-focus", blueprint: "76d4885a395976547a13c5d6bf95b482", name: "Armor Focus", summary: "+1 AC while wearing the chosen armour type (light, medium or heavy).", category: ArmourAndShield, guide: "feats#armor-focus", parameter: ArmourType, repeat: PerValue, prerequisite: All([FeatIfValue(value: ArmourType(Light), feat: "armor-proficiency-light-armor"), FeatIfValue(value: ArmourType(Medium), feat: "armor-proficiency-medium-armor"), FeatIfValue(value: ArmourType(Heavy), feat: "armor-proficiency-heavy-armor"), BaseAttackBonus(1)])),
    (key: "armor-proficiency-heavy-armor", blueprint: "1b0f68188dcc435429fb87a022239681", name: "Armor Proficiency (Heavy Armor)", summary: "Proficiency with heavy armour.", category: ArmourAndShield, guide: "feats#armor-proficiency-heavy-armor", prerequisite: Feat("armor-proficiency-medium-armor")),
    (key: "armor-proficiency-heavy-barding", blueprint: "aed0b33e17a3b3d44a718852e87305bd", name: "Armor Proficiency (Heavy Barding)", summary: "Your animal companion gains heavy barding proficiency.", category: ArmourAndShield, guide: "feats#armor-proficiency-heavy-barding", prerequisite: Feat("armor-proficiency-medium-barding")),
    (key: "armor-proficiency-light-armor", blueprint: "6d3728d4e9c9898458fe5e9532951132", name: "Armor Proficiency (Light Armor)", summary: "Proficiency with light armour.", category: ArmourAndShield, guide: "feats#armor-proficiency-light-armor"),
    (key: "armor-proficiency-light-barding", blueprint: "c62ba548b1a34b94b9802925b35737c2", name: "Armor Proficiency (Light Barding)", summary: "Your animal companion gains light barding proficiency.", category: ArmourAndShield, guide: "feats#armor-proficiency-light-barding"),
    (key: "armor-proficiency-medium-armor", blueprint: "46f4fb320f35704488ba3d513397789d", name: "Armor Proficiency (Medium Armor)", summary: "Proficiency with medium armour.", category: ArmourAndShield, guide: "feats#armor-proficiency-medium-armor", prerequisite: Feat("armor-proficiency-light-armor")),
    (key: "armor-proficiency-medium-barding", blueprint: "7213b7bd026d4414da2308df23715d8f", name: "Armor Proficiency (Medium Barding)", summary: "Your animal companion gains medium barding proficiency.", category: ArmourAndShield, guide: "feats#armor-proficiency-medium-barding", prerequisite: Feat("armor-proficiency-light-barding")),
    (key: "augment-summoning", blueprint: "38155ca9e4055bb48a89240a2055dcc3", name: "Augment Summoning", summary: "Creatures you summon arrive with +4 enhancement to Strength and Constitution.", category: Magic, guide: "feats#augment-summoning", prerequisite: FeatFor(feat: "spell-focus", value: SpellSchool(Conjuration))),
    (key: "back-to-back", blueprint: "c920f2cd2244d284aa69a146aeefcb2c", name: "Back to Back", summary: "+2 AC against the foes flanking you, as long as an ally with this feat stands beside you.", category: Teamwork, guide: "feats#back-to-back", prerequisite: SkillRanks(skill: "perception", ranks: 3)),
    (key: "bashing-finish", blueprint: "0b442a7b4aa598d4e912a4ecee0500ff", name: "Bashing Finish", summary: "A free shield bash at the same attack bonus follows each of your melee crits on that target.", category: ArmourAndShield, guide: "feats#bashing-finish", prerequisite: Feat("shield-master")),
    (key: "blind-fight", blueprint: "4e219f5894ad0ea4daa0699e28c37b1d", name: "Blind Fight", summary: "Reroll concealment misses; invisible attackers get no melee advantage against you; immunity to gaze attacks.", category: Miscellaneous, guide: "feats#blind-fight"),
    (key: "blinding-critical", blueprint: "787e56055e3ef864d9c78a3ec21e56be", name: "Blinding Critical", summary: "Your critical hits blind the target, or dazzle it for 1d4 rounds if it makes a Fort save (DC 10 + your BAB).", category: Weapon, guide: "feats#blinding-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(15)])),
    (key: "blood-drinker", blueprint: "96983d50aca1d214e8adc57a39b41c25", name: "Blood Drinker", summary: "Three times a day, drink from a helpless or dead living creature for +1 Fortitude and 5 temp HP, +5 per 3 HD, for 1 hour.", category: Racial, guide: "feats#blood-drinker", prerequisite: Race("dhampir")),
    (key: "blood-feaster", blueprint: "e78b4b66db382aa4199f5f2b7da6e5ea", name: "Blood Feaster", summary: "For half your HD in rounds after feeding with Blood Drinker, +2 damage and +1 Athletics.", category: Racial, guide: "feats#blood-feaster", prerequisite: Feat("blood-drinker")),
    (key: "boar-ferocity", blueprint: "c450b2902b1f4ebdbdd5063260823b57", name: "Boar Ferocity", summary: "Unarmed strikes add piercing damage; demoralising gets +2 and is a free action after you tear a foe's flesh.", category: UnarmedCombat, guide: "feats#boar-ferocity", prerequisite: All([Feat("boar-style"), SkillRanks(skill: "persuasion", ranks: 6)])),
    (key: "boar-shred", blueprint: "bfd867bce95e420e82b3c96abb133876", name: "Boar Shred", summary: "Tearing flesh adds 1d6 bleed per round, and demoralising takes only a move action.", category: UnarmedCombat, guide: "feats#boar-shred", prerequisite: All([Feat("boar-ferocity"), SkillRanks(skill: "persuasion", ranks: 9)])),
    (key: "boar-style", blueprint: "0641368c74334671aaaf32a2730587be", name: "Boar Style", summary: "Two or more unarmed hits on one foe in a round add +2d6 once; your unarmed strikes also slash as well as bludgeon.", category: UnarmedCombat, guide: "feats#boar-style", prerequisite: All([Feat("improved-unarmed-strike"), SkillRanks(skill: "persuasion", ranks: 3)])),
    (key: "boon-companion", blueprint: "8fc01f06eab4dd946baa5bc658cac556", name: "Boon Companion", summary: "Your animal companion advances as if your class level were 4 higher, never above your character level.", category: Class, guide: "feats#boon-companion", prerequisite: Any([Feature(feature: "barbarian/mad-dog/animal-companion", count: 1), Feature(feature: "cavalier/animal-companion", count: 1), Feature(feature: "cavalier/beast-rider/animal-companion-beast-rider", count: 1), Feature(feature: "cavalier/standard-bearer/animal-companion-standard-bearer", count: 1), Feature(feature: "cleric/domain/animal/animal-companion", count: 1), Feature(feature: "cleric/domain/scalykind/animal-companion", count: 1), Feature(feature: "druid/drovier/animal-companion", count: 1), Feature(feature: "druid/primal-druid/animal-companion-primal-druid", count: 1), Feature(feature: "hunter/animal-companion", count: 1), Feature(feature: "hunter/divine-hound/animal-companion-divine-hound", count: 1), Feature(feature: "hunter/urban-hunter/animal-companion-urban-hunter", count: 1), Feature(feature: "inquisitor/sacred-huntsmaster/animal-companion", count: 1), Feature(feature: "ranger/nomad/animal-companion", count: 1), Feature(feature: "shaman/wildland-shaman/animal-companion", count: 1), Feature(feature: "sorcerer/sylvan-sorcerer/animal-companion", count: 1), SelectionOption("druid/nature-bond/animal-companion"), SelectionOption("oracle/revelations/nature/animal-companion")])),
    (key: "breadth-of-experience", blueprint: "351bfb6ce48d441da02cc141e7f19ed8", name: "Breadth of Experience", summary: "Knowledge and Lore checks all get +2.", category: Racial, guide: "feats#breadth-of-experience", prerequisite: Any([Race("dwarf"), Race("elf"), Race("gnome")])),
    (key: "brew-potions", blueprint: "c0f8c4e513eb493408b8070a1de93fc0", name: "Brew Potions", summary: "While camping, make potions of spells of 3rd level or lower.", category: Magic, guide: "feats#brew-potions"),
    (key: "bull-rush", blueprint: "b3614622866fe7046b787a548bbd7f59", name: "Bull Rush", summary: "Push a foe 5 ft (+5 ft per 5 you beat its CMD by); +2 CMB to bull rush and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#bull-rush", prerequisite: Feat("power-attack")),
    (key: "cautious-fighter", blueprint: "4a6fbe77a4a2ce24db0cd0b1e4d93db1", name: "Cautious Fighter", summary: "Fighting defensively gives 2 more dodge AC.", category: Racial, guide: "feats#cautious-fighter", prerequisite: Race("halfling")),
    (key: "cleave", blueprint: "d809b6c4ff2aaff4fa70d712a70f7d7b", name: "Cleave", summary: "A standard-action attack that, if it hits, gives a second full-bonus attack on an adjacent foe; you take -2 AC until your next turn.", category: Weapon, guide: "feats#cleave", prerequisite: Feat("power-attack")),
    (key: "cleaving-finish", blueprint: "59bd93899149fa44687ff4121389b3a9", name: "Cleaving Finish", summary: "Once a round, when you drop a foe to 0 HP, make another attack at full bonus against a foe in reach.", category: Weapon, guide: "feats#cleaving-finish", prerequisite: Feat("cleave")),
    (key: "clustered-shots", blueprint: "f7de245bb20f12f47864c7cb8b1d1abb", name: "Clustered Shots", summary: "Damage reduction applies once to the combined damage of your ranged hits on one foe each round, not to each hit.", category: Ranged, guide: "feats#clustered-shots", prerequisite: All([Feat("point-blank-shot"), Feat("precise-shot"), BaseAttackBonus(6)])),
    (key: "combat-casting", blueprint: "06964d468fde1dc4aa71a92ea04d930d", name: "Combat Casting", summary: "+4 to concentration checks to cast spells or use spell-like abilities.", category: Magic, guide: "feats#combat-casting"),
    (key: "combat-expertise", blueprint: "4c44724ffa8844f4d9bedb5bb27d144a", name: "Combat Expertise", summary: "Take -1 to melee attacks and manoeuvre checks for +1 dodge AC; both grow by 1 at BAB 4 and every 4 after.", category: Miscellaneous, guide: "feats#combat-expertise", prerequisite: AbilityScore(ability: Intelligence, score: 13)),
    (key: "combat-mobility", blueprint: "2a6091b97ad940943b46262600eaeaeb", name: "Combat Mobility", summary: "Moving through or out of threatened squares: +4 dodge AC against the attacks of opportunity, unless you're denied Dex.", category: Miscellaneous, guide: "feats#combat-mobility", prerequisite: Feat("dodge")),
    (key: "combat-reflexes", blueprint: "0f8939ae6f220984e8fb568abbdfba95", name: "Combat Reflexes", summary: "Your Dex bonus adds that many attacks of opportunity per round, and being flat-footed doesn't stop them.", category: Miscellaneous, guide: "feats#combat-reflexes"),
    (key: "coordinated-defense", blueprint: "992fd59da1783de49b135ad89142c6d7", name: "Coordinated Defense", summary: "Next to an ally with this feat: +2 CMD, or +4 against a creature larger than both of you.", category: Teamwork, guide: "feats#coordinated-defense"),
    (key: "coordinated-maneuvers", blueprint: "b186cea78dce3a04aacff0a81786008c", name: "Coordinated Maneuvers", summary: "Next to an ally with this feat: +2 to combat manoeuvre checks, or +4 to break free of a grapple.", category: Teamwork, guide: "feats#coordinated-maneuvers"),
    (key: "cornugon-smash", blueprint: "ceea53555d83f2547ae5fc47e0399e14", name: "Cornugon Smash", summary: "Free demoralise (Persuasion) against any foe your Power Attack damages.", category: Weapon, guide: "feats#cornugon-smash", prerequisite: All([Feat("power-attack"), SkillRanks(skill: "persuasion", ranks: 6)])),
    (key: "crane-riposte", blueprint: "59eb2a5507975244c893402d582bf77b", name: "Crane Riposte", summary: "Fighting defensively costs only -1 to attack; a foe whose near miss ends your Crane Wing bonus provokes an attack of opportunity.", category: UnarmedCombat, guide: "feats#crane-riposte", prerequisite: All([Any([ClassLevel(class: "monk", level: 7), BaseAttackBonus(8)]), Feat("crane-wing")])),
    (key: "crane-style", blueprint: "0c17102f650d9044290922b0fad9132f", name: "Crane Style", summary: "Lowers the fighting-defensively attack penalty to -2 and adds 1 more dodge AC.", category: UnarmedCombat, guide: "feats#crane-style", prerequisite: All([Any([ClassLevel(class: "monk", level: 1), BaseAttackBonus(2)]), Feat("dodge"), Feat("improved-unarmed-strike")])),
    (key: "crane-wing", blueprint: "af0aae1b973114f47a19ea532237b5fc", name: "Crane Wing", summary: "Fighting defensively with a free off hand: +4 dodge AC against melee, lost until your next turn when an attack misses by 4 or less.", category: UnarmedCombat, guide: "feats#crane-wing", prerequisite: All([Any([ClassLevel(class: "monk", level: 5), BaseAttackBonus(5)]), Feat("crane-style"), Feat("dodge")])),
    (key: "critical-focus", blueprint: "8ac59959b1b23c347a0361dc97cc786d", name: "Critical Focus", summary: "+4 to attack rolls that confirm critical hits.", category: Weapon, guide: "feats#critical-focus", prerequisite: BaseAttackBonus(9)),
    (key: "critical-mastery", blueprint: "fc85925cd241dd0408ab2f4cb171b7e3", name: "Critical Mastery", summary: "Your critical hits apply two of your critical feats' effects at once.", category: Weapon, guide: "feats#critical-mastery", prerequisite: All([AtLeast(2, [Feat("blinding-critical"), Feat("exhausting-critical"), Feat("flaying-critical"), Feat("sickening-critical"), Feat("staggering-critical"), Feat("stunning-critical"), Feat("tiring-critical")]), Feat("critical-focus"), ClassLevel(class: "fighter", level: 14)])),
    (key: "crushing-blow", blueprint: "4153755355a0b9b4e956c9ca232c22cf", name: "Crushing Blow", summary: "A full-round Stunning Fist variant: success lowers the target's AC by your Wisdom modifier for 1 minute.", category: UnarmedCombat, guide: "feats#crushing-blow", prerequisite: Any([Feat("stunning-fist"), Feature(feature: "monk/stunning-fist", count: 1)])),
    (key: "dazzling-display", blueprint: "bcbd674ec70ff6f4894bb5f07b6f4095", name: "Dazzling Display", summary: "Try to demoralise everyone hostile within 30 ft at once, using Persuasion and a full-round action.", category: Weapon, guide: "feats#dazzling-display", prerequisite: Feat("weapon-focus")),
    (key: "deadly-aim", blueprint: "f47df34d53f8c904f9981a3ee8e84892", name: "Deadly Aim", summary: "Take -1 to ranged attacks for +2 ranged damage (not ranged touch); both grow at BAB 8 and every 4 after.", category: Ranged, guide: "feats#deadly-aim", prerequisite: All([AbilityScore(ability: Dexterity, score: 13), BaseAttackBonus(1)])),
    (key: "deceitful", blueprint: "231a37321e26551489503e4e1d99e681", name: "Deceitful", summary: "+2 to Persuasion and Trickery, or +4 for a skill with 10 or more ranks.", category: Skill, guide: "feats#deceitful"),
    (key: "defensive-combat-training", blueprint: "479c7f3b0dba69a4bbcb43e101f3f7f9", name: "Defensive Combat Training", summary: "Use your character level instead of your BAB for your CMD.", category: CombatManoeuvres, guide: "feats#defensive-combat-training"),
    (key: "deflect-arrows", blueprint: "2c61fdbf242866f4e93c3e1477fb96b5", name: "Deflect Arrows", summary: "Once a round, with a hand free, a ranged attack that would hit you is deflected at no action cost.", category: UnarmedCombat, guide: "feats#deflect-arrows", prerequisite: All([Feat("improved-unarmed-strike"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "deft-hands", blueprint: "ab5fbcd092c860d46a2e62d9dac272e8", name: "Deft Hands", summary: "+2 to Trickery and Use Magic Device, or +4 for a skill with 10 or more ranks.", category: Skill, guide: "feats#deft-hands"),
    (key: "destructive-dispel", blueprint: "d298e64e14398e848a54db5a2619ba42", name: "Destructive Dispel", summary: "A foe you dispel with a targeted dispel is stunned until your next turn (Fort DC 10 + half CL + casting stat), or sickened 1 round on a save.", category: Magic, guide: "feats#destructive-dispel"),
    (key: "diehard", blueprint: "86669ce8759f9d7478565db69b8c19ad", name: "Diehard", summary: "Dropping below 0 HP (but not dead) leaves you disabled but fighting for 1 more round; unless healed above 0, you then pass out.", category: Miscellaneous, guide: "feats#diehard"),
    (key: "dirty-trick", blueprint: "ed699d64870044b43bb5a7fbe3f29494", name: "Dirty Trick", summary: "Standard action: blind, entangle or sicken a foe for 1 round (+1 per 5 over its CMD); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#dirty-trick", prerequisite: Any([All([Feature(feature: "kineticist/kinetic-knight/kinetic-warrior", count: 1), AbilityScore(ability: Intelligence, score: 13)]), Feat("combat-expertise")])),
    (key: "disarm", blueprint: "25bc9c439ac44fd44ac3b1e58890916f", name: "Disarm", summary: "Standard action: a foe can't use its weapon for 1 round (+1 per 5 over its CMD); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#disarm", prerequisite: Any([All([Feature(feature: "kineticist/kinetic-knight/kinetic-warrior", count: 1), AbilityScore(ability: Intelligence, score: 13)]), Feat("combat-expertise")])),
    (key: "disarming-strike", blueprint: "3af3476f6034a924e96f3ffa198424b7", name: "Disarming Strike", summary: "Confirmation rolls on melee crits that beat the foe's CMD also disarm it.", category: CombatManoeuvres, guide: "feats#disarming-strike", prerequisite: All([Feat("disarm"), BaseAttackBonus(9)])),
    (key: "discerning-eye", blueprint: "c4b818bdcea845c9ae8cf277251d70d9", name: "Discerning Eye", summary: "+2 to saves against illusions and +2 to Use Magic Device.", category: Racial, guide: "feats#discerning-eye", prerequisite: Any([Race("elf"), Race("half-elf")])),
    (key: "discordant-voice", blueprint: "49a72b24ad604be481ad73994e14a34b", name: "Discordant Voice", summary: "Your bardic performances give allies' weapon attacks an extra 1d6 sonic damage.", category: Class, guide: "feats#discordant-voice", prerequisite: All([Any([Feature(feature: "bard/bardic-performance-move-action", count: 1), Feature(feature: "bard/bardic-performance-swift-action", count: 1)]), CharacterLevel(4)])),
    (key: "dispel-focus", blueprint: "c39576f8842e4505b14aa918b3a36a0a", name: "Dispel Focus", summary: "+2 caster level on dispel attempts.", category: Magic, guide: "feats#dispel-focus"),
    (key: "dispel-synergy", blueprint: "f3e3e29608ba07844ab3cafc4c8e4343", name: "Dispel Synergy", summary: "For 1 round after you dispel an effect on a foe, it saves at -2 against your spells.", category: Magic, guide: "feats#dispel-synergy"),
    (key: "disruptive", blueprint: "f3ef866a9da642c4b9f7dcd76c3567fe", name: "Disruptive", summary: "Enemies within 10 ft face a +4 DC to cast defensively.", category: Miscellaneous, guide: "feats#disruptive", prerequisite: Any([ClassLevel(class: "fighter", level: 6), SelectionOption("bloodrager/bloodline/arcane"), SelectionOption("sorcerer/bloodline/arcane")])),
