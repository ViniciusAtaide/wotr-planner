    (key: "greater-disarm", name: "Greater Disarm", summary: "Disarms last 1d4 rounds +1 per 5 over the foe's CMD, and get +2 more to the check.", category: CombatManoeuvres, guide: "feats#greater-disarm", prerequisite: All([Feat("disarm"), BaseAttackBonus(6)])),
    (key: "greater-dispel-focus", name: "Greater Dispel Focus", summary: "+2 more caster level on dispel attempts.", category: Magic, guide: "feats#greater-dispel-focus", prerequisite: Feat("dispel-focus")),
    (key: "greater-elemental-focus", name: "Greater Elemental Focus", summary: "+1 more to the save DCs of your spells of an energy type you have Elemental Focus in.", category: Magic, guide: "feats#greater-elemental-focus", parameter: Energy, repeat: PerValue, prerequisite: FeatForSameValue("elemental-focus")),
    (key: "greater-penetrating-strike", name: "Greater Penetrating Strike", summary: "Damage reduction up to 10 points doesn't apply to hits from your Weapon Focus weapons.", category: Weapon, guide: "feats#greater-penetrating-strike", prerequisite: All([Feat("penetrating-strike"), ClassLevel(class: "fighter", level: 16)])),
    (key: "greater-shield-focus", name: "Greater Shield Focus", summary: "+1 more AC from your shield.", category: ArmourAndShield, guide: "feats#greater-shield-focus", prerequisite: All([Feat("shield-focus"), ClassLevel(class: "fighter", level: 8)])),
    (key: "greater-snap-shot", name: "Greater Snap Shot", summary: "+2 damage and crit confirmation on attacks of opportunity (+4 from BAB 16, +6 from BAB 20); Snap Shot covers 5 more ft.", category: Ranged, guide: "feats#greater-snap-shot", prerequisite: All([Feat("improved-snap-shot"), AbilityScore(ability: Dexterity, score: 17), BaseAttackBonus(12)])),
    (key: "greater-spell-focus", name: "Greater Spell Focus", summary: "+1 more to the save DCs of spells from a school you have Spell Focus in.", category: Magic, guide: "feats#greater-spell-focus", parameter: SpellSchool, repeat: PerValue, prerequisite: FeatForSameValue("spell-focus")),
    (key: "greater-spell-penetration", name: "Greater Spell Penetration", summary: "+2 more to caster level checks against spell resistance.", category: Magic, guide: "feats#greater-spell-penetration", prerequisite: Feat("spell-penetration")),
    (key: "greater-sunder-armor", name: "Greater Sunder Armor", summary: "Sundered armour stays down 1d4 rounds +1 per 5 over the foe's CMD, and the check gets +2 more.", category: CombatManoeuvres, guide: "feats#greater-sunder-armor", prerequisite: All([Feat("sunder-armor"), BaseAttackBonus(6)])),
    (key: "greater-trip", name: "Greater Trip", summary: "Tripped foes provoke attacks of opportunity, and trip checks get +2 more.", category: CombatManoeuvres, guide: "feats#greater-trip", prerequisite: All([Feat("trip"), BaseAttackBonus(6)])),
    (key: "greater-two-weapon-fighting", name: "Greater Two-Weapon Fighting", summary: "A third off-hand attack at -10.", category: Weapon, guide: "feats#greater-two-weapon-fighting", prerequisite: All([Feat("improved-two-weapon-fighting"), AbilityScore(ability: Dexterity, score: 19), BaseAttackBonus(11)])),
    (key: "greater-vital-strike", name: "Greater Vital Strike", summary: "Standard action: one attack at your highest bonus that rolls the weapon's damage four times.", category: Weapon, guide: "feats#greater-vital-strike", prerequisite: All([Feat("improved-vital-strike"), BaseAttackBonus(16)])),
    (key: "greater-weapon-focus", name: "Greater Weapon Focus", summary: "+1 more to attack with a weapon you have Weapon Focus in.", category: Weapon, guide: "feats#greater-weapon-focus", parameter: Weapon, repeat: PerValue, prerequisite: All([FeatForSameValue("weapon-focus"), ClassLevel(class: "fighter", level: 8)])),
    (key: "greater-weapon-specialization", name: "Greater Weapon Specialization", summary: "+2 more damage with a weapon you have Weapon Specialization in.", category: Weapon, guide: "feats#greater-weapon-specialization", parameter: Weapon, repeat: PerValue, prerequisite: All([FeatForSameValue("weapon-specialization"), ClassLevel(class: "fighter", level: 12)])),
    (key: "hammer-the-gap", name: "Hammer the Gap", summary: "Every hit in an unbroken streak this turn adds +1 damage per earlier hit in the streak; crits multiply it.", category: Weapon, guide: "feats#hammer-the-gap", prerequisite: BaseAttackBonus(6)),
    (key: "harmonic-spell", name: "Harmonic Spell", summary: "Spells of 1st level or higher cast mid-performance refund a round of bardic performance.", category: Class, guide: "feats#harmonic-spell", prerequisite: ClassLevel(class: "bard", level: 1)),
    (key: "history-of-terrors", name: "History of Terrors", summary: "+2 to saves against mind-affecting effects and +4 against fear.", category: Racial, guide: "feats#history-of-terrors", prerequisite: Race("human")),
    (key: "improved-blind-fight", name: "Improved Blind Fight", summary: "Only total concealment affects your melee (miss can be rerolled); invisible foes within 30 ft get no ranged edge.", category: Miscellaneous, guide: "feats#improved-blind-fight", prerequisite: All([Feat("blind-fight"), SkillRanks(skill: "perception", ranks: 10)])),
    (key: "improved-cleaving-finish", name: "Improved Cleaving Finish", summary: "Cleaving Finish works any number of times a round.", category: Weapon, guide: "feats#improved-cleaving-finish", prerequisite: All([Feat("cleaving-finish"), Feat("great-cleave"), BaseAttackBonus(6)])),
    (key: "improved-critical", name: "Improved Critical", summary: "Doubles the threat range of the chosen weapon type, before other threat-range effects.", category: Weapon, guide: "feats#improved-critical", parameter: Weapon, repeat: PerValue, prerequisite: BaseAttackBonus(8)),
    (key: "improved-elven-immunities", name: "Improved Elven Immunities", summary: "+2 more to saves against enchantment, and +1 DC to your enchantment spells.", category: Racial, guide: "feats#improved-elven-immunities", prerequisite: Any([Race("elf"), Race("half-elf")])),
    (key: "improved-great-fortitude", name: "Improved Great Fortitude", summary: "+2 more to Fortitude saves.", category: Miscellaneous, guide: "feats#improved-great-fortitude", prerequisite: Feat("great-fortitude")),
    (key: "improved-improved-critical", name: "Improved Improved Critical", summary: "+1 to the threat range of the chosen weapon.", category: Weapon, guide: "trickster#improved-improved-critical", parameter: Weapon, repeat: PerValue, prerequisite: All([FeatForSameValue("improved-critical"), SelectionOption("trickster/improved-mythic-trick/perception-ii")])),
    (key: "improved-improved-improved-critical", name: "Improved Improved Improved Critical", summary: "+1 more to the threat range of the chosen weapon.", category: Weapon, guide: "trickster#improved-improved-improved-critical", parameter: Weapon, repeat: PerValue, prerequisite: All([FeatForSameValue("improved-improved-critical"), SelectionOption("trickster/improved-mythic-trick/perception-ii")])),
    (key: "improved-improved-improved-critical-improved", name: "Improved Improved Improved Critical Improved", summary: "+1 to the critical multiplier of the chosen weapon.", category: Weapon, guide: "trickster#improved-improved-improved-critical-improved", parameter: Weapon, repeat: PerValue, prerequisite: All([FeatForSameValue("improved-improved-improved-critical"), SelectionOption("trickster/improved-mythic-trick/perception-ii")])),
    (key: "improved-initiative", name: "Improved Initiative", summary: "+4 to initiative.", category: Miscellaneous, guide: "feats#improved-initiative"),
    (key: "improved-iron-will", name: "Improved Iron Will", summary: "+2 more to Will saves.", category: Miscellaneous, guide: "feats#improved-iron-will", prerequisite: Feat("iron-will")),
    (key: "improved-lightning-reflexes", name: "Improved Lightning Reflexes", summary: "+2 more to Reflex saves.", category: Miscellaneous, guide: "feats#improved-lightning-reflexes", prerequisite: Feat("lightning-reflexes")),
    (key: "improved-precise-shot", name: "Improved Precise Shot", summary: "Only total concealment can make your ranged attacks miss by chance.", category: Ranged, guide: "feats#improved-precise-shot", prerequisite: All([Feat("point-blank-shot"), Feat("precise-shot"), AbilityScore(ability: Dexterity, score: 19), BaseAttackBonus(11)])),
    (key: "improved-snap-shot", name: "Improved Snap Shot", summary: "Snap Shot reaches 5 ft further.", category: Ranged, guide: "feats#improved-snap-shot", prerequisite: All([Feat("rapid-shot"), Feat("snap-shot"), BaseAttackBonus(9)])),
    (key: "improved-two-weapon-fighting", name: "Improved Two-Weapon Fighting", summary: "A second off-hand attack at -5.", category: Weapon, guide: "feats#improved-two-weapon-fighting", prerequisite: All([Feat("two-weapon-fighting"), AbilityScore(ability: Dexterity, score: 17), BaseAttackBonus(6)])),
    (key: "improved-unarmed-strike", name: "Improved Unarmed Strike", summary: "You count as armed when unarmed; unarmed strikes deal 1d3 (1d2 if small).", category: UnarmedCombat, guide: "feats#improved-unarmed-strike"),
    (key: "improved-vital-strike", name: "Improved Vital Strike", summary: "Standard action: one attack at your highest bonus that rolls the weapon's damage three times.", category: Weapon, guide: "feats#improved-vital-strike", prerequisite: All([Feat("vital-strike"), BaseAttackBonus(11)])),
    (key: "indomitable-mount", name: "Indomitable Mount", summary: "A Mobility check against the DC can turn your mount's failed save into a success, once a round.", category: MountedCombat, guide: "feats#indomitable-mount", prerequisite: SkillRanks(skill: "mobility", ranks: 5)),
    (key: "intimidating-prowess", name: "Intimidating Prowess", summary: "Intimidate checks with Persuasion use your Strength modifier on top of Charisma.", category: Skill, guide: "feats#intimidating-prowess"),
    (key: "iron-will", name: "Iron Will", summary: "+2 to Will saves.", category: Miscellaneous, guide: "feats#iron-will"),
    (key: "ironguts", name: "Ironguts", summary: "+2 to saves against poison and against sickening and nauseating attacks.", category: Racial, guide: "feats#ironguts", prerequisite: Race("half-orc")),
    (key: "ironhide", name: "Ironhide", summary: "+1 natural armour to AC.", category: Racial, guide: "feats#ironhide", prerequisite: Any([Race("dwarf"), Race("half-orc")])),
    (key: "life-dominant-soul", name: "Life-Dominant Soul", summary: "Channelled positive energy that heals the living and negative energy that heals undead both heal you, at half the amount.", category: Racial, guide: "feats#life-dominant-soul", prerequisite: Race("dhampir")),
    (key: "lightning-reflexes", name: "Lightning Reflexes", summary: "+2 to Reflex saves.", category: Miscellaneous, guide: "feats#lightning-reflexes"),
    (key: "lingering-performance", name: "Lingering Performance", summary: "Stopping a performance doesn't end its effects for another 2 rounds.", category: Class, guide: "feats#lingering-performance", prerequisite: Any([Feature(feature: "bard/bardic-performance-move-action", count: 1), Feature(feature: "bard/bardic-performance-swift-action", count: 1)])),
    (key: "lunge", name: "Lunge", summary: "Trade 2 AC for 5 ft of extra melee reach until your turn ends.", category: Weapon, guide: "feats#lunge", prerequisite: BaseAttackBonus(6)),
    (key: "magical-tail", name: "Magical Tail", summary: "Up to 8 times: a new spell-like ability, usable twice a day, in order from Vanish to Dominate Person; caster level = HD, DCs use Cha.", category: Racial, guide: "feats#magical-tail", repeat: Times(8), prerequisite: Race("kitsune")),
    (key: "manyshot", name: "Manyshot", summary: "In a full attack with a bow, your first attack fires two arrows, each getting your damage bonuses and facing damage reduction.", category: Ranged, guide: "feats#manyshot", prerequisite: All([Feat("point-blank-shot"), Feat("rapid-shot"), AbilityScore(ability: Dexterity, score: 17), BaseAttackBonus(6)])),
    (key: "martial-weapons-proficiency", name: "Martial Weapons Proficiency", summary: "Proficiency with all martial weapons, such as the longsword, greatsword, greataxe, falchion, longbow, rapier and scimitar.", category: Weapon, guide: "feats#martial-weapons-proficiency"),
    (key: "metamagic-bolster-spell", name: "Metamagic (Bolster Spell)", summary: "+1 spell level: the spell deals +2 damage per die, and 2 damage per die to every enemy within 5 ft of its targets.", category: Magic, guide: "feats#metamagic-bolster-spell"),
    (key: "metamagic-completely-normal-spell", name: "Metamagic (Completely Normal Spell)", summary: "The spell's level drops by 1, so 1st-level spells can be cast as cantrips.", category: Magic, guide: "trickster#metamagic-completely-normal-spell", prerequisite: SelectionOption("trickster/improved-mythic-trick/perception-ii")),
    (key: "metamagic-empower-spell", name: "Metamagic (Empower Spell)", summary: "+2 spell level: the spell's variable numbers are 50% higher.", category: Magic, guide: "feats#metamagic-empower-spell"),
    (key: "metamagic-extend-spell", name: "Metamagic (Extend Spell)", summary: "+1 spell level: doubles the spell's duration (not instant, permanent or concentration spells).", category: Magic, guide: "feats#metamagic-extend-spell"),
    (key: "metamagic-heighten-spell", name: "Metamagic (Heighten Spell)", summary: "Cast the spell at a higher level, up to your highest, raising its DC and beating spell-level immunities.", category: Magic, guide: "feats#metamagic-heighten-spell"),
    (key: "metamagic-intensified-spell", name: "Metamagic (Intensified Spell)", summary: "+1 spell level: the spell's damage dice cap rises by 5 caster levels, if your caster level is high enough.", category: Magic, guide: "feats#metamagic-intensified-spell"),
    (key: "metamagic-maximise-spell", name: "Metamagic (Maximise Spell)", summary: "+3 spell level: the spell's variable numbers are maximised; it can also be empowered.", category: Magic, guide: "feats#metamagic-maximise-spell"),
    (key: "metamagic-persistent-spell", name: "Metamagic (Persistent Spell)", summary: "+2 spell level: a target that saves must save again or take the full effect.", category: Magic, guide: "feats#metamagic-persistent-spell"),
    (key: "metamagic-piercing-spell", name: "Metamagic (Piercing Spell)", summary: "+1 spell level: the target's spell resistance counts as 5 lower.", category: Magic, guide: "feats#metamagic-piercing-spell"),
    (key: "metamagic-quicken-spell", name: "Metamagic (Quicken Spell)", summary: "+4 spell level: cast the spell as a swift action without provoking (not spells taking over a full round).", category: Magic, guide: "feats#metamagic-quicken-spell"),
    (key: "metamagic-reach-spell", name: "Metamagic (Reach Spell)", summary: "+1 spell level: a touch, close or medium range spell reaches the next range up; melee touch becomes ranged touch.", category: Magic, guide: "feats#metamagic-reach-spell"),
    (key: "metamagic-selective-spell", name: "Metamagic (Selective Spell)", summary: "+1 spell level: up to your casting stat modifier in creatures of your choice are left out of the spell's area.", category: Magic, guide: "feats#metamagic-selective-spell"),
    (key: "missile-shield", name: "Missile Shield", summary: "Once a round, your shield lets you deflect a ranged weapon attack, unless you're flat-footed.", category: ArmourAndShield, guide: "feats#missile-shield", prerequisite: All([Feat("shield-focus"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "mounted-combat", name: "Mounted Combat", summary: "Hits on your mount can be cancelled, once a round, by a Mobility check beating the attack roll.", category: MountedCombat, guide: "feats#mounted-combat", prerequisite: SkillRanks(skill: "mobility", ranks: 1)),
    (key: "mounted-shield", name: "Mounted Shield", summary: "Add your shield's base bonus and Shield Focus (not enhancement) to your mount's AC.", category: MountedCombat, guide: "feats#mounted-shield", prerequisite: All([Feat("mounted-combat"), Feat("shield-focus")])),
    (key: "murmurs-of-earth", name: "Murmurs of Earth", summary: "You know where every creature within 15 ft is, as long as it touches the ground.", category: Racial, guide: "feats#murmurs-of-earth", prerequisite: All([Feat("echoes-of-stone"), CharacterLevel(9)])),
    (key: "natural-charmer", name: "Natural Charmer", summary: "Your next Persuasion check can be a take 20, once a day.", category: Racial, guide: "feats#natural-charmer", prerequisite: All([AbilityScore(ability: Charisma, score: 17), Race("dhampir")])),
    (key: "natural-spell", name: "Natural Spell", summary: "Shifted forms no longer stop you from casting.", category: Class, guide: "feats#natural-spell", prerequisite: All([Any([Feature(feature: "druid/blight-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/defender-of-the-true-world/wild-shape-wolf", count: 1), Feature(feature: "druid/elemental-rampager/wild-shape-wolf", count: 1), Feature(feature: "druid/feyspeaker/wild-shape-wolf", count: 1), Feature(feature: "druid/primal-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/wild-shape-wolf", count: 1), Feature(feature: "warpriest/feral-champion/wild-shape-wolf", count: 1)]), AbilityScore(ability: Wisdom, score: 13)])),
    (key: "outflank", name: "Outflank", summary: "Your flanking bonus becomes +4 when an ally with this feat flanks with you, and your crits there give that ally an attack of opportunity.", category: Teamwork, guide: "feats#outflank", prerequisite: BaseAttackBonus(4)),
    (key: "penetrating-strike", name: "Penetrating Strike", summary: "Damage reduction up to 5 points doesn't apply to hits from your Weapon Focus weapons.", category: Weapon, guide: "feats#penetrating-strike", prerequisite: All([Feat("weapon-focus"), ClassLevel(class: "fighter", level: 12)])),
    (key: "perfect-strike", name: "Perfect Strike", summary: "Once a day per 4 levels, roll an attack twice and keep the higher result.", category: UnarmedCombat, guide: "feats#perfect-strike", prerequisite: All([Feat("improved-unarmed-strike"), AbilityScore(ability: Dexterity, score: 13), AbilityScore(ability: Wisdom, score: 13), BaseAttackBonus(8)])),
    (key: "persuasive", name: "Persuasive", summary: "+2 to Persuasion and Perception, or +4 for a skill with 10 or more ranks.", category: Skill, guide: "feats#persuasive"),
    (key: "piranha-strike", name: "Piranha Strike", summary: "With a finesse weapon, take -1 to attack for +2 damage (+1 off-hand); both grow at BAB 4 and every 4 after.", category: Weapon, guide: "feats#piranha-strike", prerequisite: All([Feat("weapon-finesse"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "point-blank-master", name: "Point Blank Master", summary: "Shooting your specialised weapon while threatened provokes no attacks of opportunity.", category: Ranged, guide: "feats#point-blank-master", prerequisite: Feat("weapon-specialization")),
    (key: "point-blank-shot", name: "Point-Blank Shot", summary: "Ranged attacks within 30 ft get +1 to hit and damage.", category: Ranged, guide: "feats#point-blank-shot"),
    (key: "power-attack", name: "Power Attack", summary: "Take -1 to attack for +2 damage (+3 two-handed, +1 off-hand); both grow at BAB 4 and every 4 after.", category: Weapon, guide: "feats#power-attack", prerequisite: AbilityScore(ability: Strength, score: 13)),
    (key: "precise-shot", name: "Precise Shot", summary: "No -4 penalty for shooting at foes in melee.", category: Ranged, guide: "feats#precise-shot", prerequisite: Feat("point-blank-shot")),
    (key: "precise-strike", name: "Precise Strike", summary: "Flanking a foe with an ally who has this feat adds 1d6 to each of your melee hits, not multiplied on a crit.", category: Teamwork, guide: "feats#precise-strike", prerequisite: All([AbilityScore(ability: Dexterity, score: 13), BaseAttackBonus(1)])),
    (key: "pummeling-bully", name: "Pummeling Bully", summary: "With Pummeling Style in a full attack or flurry, a hit lets you make a free trip attempt.", category: UnarmedCombat, guide: "feats#pummeling-bully", prerequisite: All([Any([ClassLevel(class: "monk", level: 5), BaseAttackBonus(9)]), Feat("pummeling-style"), Feat("trip")])),
    (key: "pummeling-charge", name: "Pummeling Charge", summary: "End a charge with a full attack or a Flurry of Blows.", category: UnarmedCombat, guide: "feats#pummeling-charge", prerequisite: All([Any([ClassLevel(class: "monk", level: 8), BaseAttackBonus(12)]), Feat("pummeling-style")])),
    (key: "pummeling-style", name: "Pummeling Style", summary: "Damage reduction applies once to the combined damage of your unarmed hits on one foe, not to each hit.", category: UnarmedCombat, guide: "feats#pummeling-style", prerequisite: All([Any([Any([Feature(feature: "monk/flurry-of-blows", count: 1), Feature(feature: "monk/quarterstaff-master/flurry-of-blows-quarterstaff-master", count: 1), Feature(feature: "monk/sohei/flurry-of-blows-sohei", count: 1), Feature(feature: "monk/zen-archer/flurry-of-blows-zen-archer", count: 1)]), BaseAttackBonus(6)]), Feat("improved-unarmed-strike")])),
    (key: "raging-brutality", name: "Raging Brutality", summary: "While raging with Power Attack, a swift action adds your Con bonus (1.5x two-handed) to melee and thrown damage that turn, not on crits.", category: Class, guide: "feats#raging-brutality", prerequisite: All([Feat("power-attack"), AbilityScore(ability: Strength, score: 13), BaseAttackBonus(12)])),
    (key: "raking-claws", name: "Raking Claws", summary: "Natural attacks that pierce or slash leave the foe bleeding 1d6 per round.", category: Class, guide: "feats#raking-claws", prerequisite: All([Any([Any([Feature(feature: "druid/blight-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/defender-of-the-true-world/wild-shape-wolf", count: 1), Feature(feature: "druid/elemental-rampager/wild-shape-wolf", count: 1), Feature(feature: "druid/feyspeaker/wild-shape-wolf", count: 1), Feature(feature: "druid/primal-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/wild-shape-wolf", count: 1), Feature(feature: "warpriest/feral-champion/wild-shape-wolf", count: 1)]), Any([Feature(feature: "shifter/major-form", count: 1), Feature(feature: "shifter/wild-effigy/major-form", count: 1)])]), BaseAttackBonus(8)])),
    (key: "ranged-feint", name: "Ranged Feint", summary: "Feints work with ranged weapons too, removing the target's Dex bonus against your shots.", category: Ranged, guide: "feats#ranged-feint", prerequisite: Feat("feint")),
    (key: "rapid-shot", name: "Rapid Shot", summary: "Ranged full attacks gain an extra full-bonus attack, at the cost of -2 on every attack roll.", category: Ranged, guide: "feats#rapid-shot", prerequisite: All([Feat("point-blank-shot"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "ray-shield", name: "Ray Shield", summary: "Your touch AC includes your shield's base bonus (enhancement excluded).", category: ArmourAndShield, guide: "feats#ray-shield", prerequisite: All([Feat("missile-shield"), AbilityScore(ability: Dexterity, score: 15)])),
    (key: "razortusk", name: "Razortusk", summary: "Grants a secondary bite (1d4 + half Strength) attacking at your full BAB -5.", category: Racial, guide: "feats#razortusk", prerequisite: Race("half-orc")),
    (key: "scribe-scrolls", name: "Scribe Scrolls", summary: "Craft scrolls while camping.", category: Magic, guide: "feats#scribe-scrolls"),
    (key: "sculpting-the-river", name: "Sculpting the River", summary: "Each unarmed hit on a foe you already hurt this round gives it a stacking -1 to attack others, until it misses or your next turn.", category: UnarmedCombat, guide: "feats#sculpting-the-river", prerequisite: All([Any([ClassLevel(class: "monk", level: 6), BaseAttackBonus(6)]), Feat("dodge"), Feat("improved-unarmed-strike")])),
    (key: "seize-the-moment", name: "Seize the Moment", summary: "Gives you an attack of opportunity whenever an ally with this feat crits a foe you threaten.", category: Teamwork, guide: "feats#seize-the-moment", prerequisite: Feat("combat-reflexes")),
    (key: "selective-channel", name: "Selective Channel", summary: "Healing channels skip enemies and harming channels skip allies.", category: Class, guide: "feats#selective-channel", prerequisite: All([Any([Feature(feature: "cleric/channel-energy", count: 1), Feature(feature: "shaman/witch-doctor/channel-energy", count: 1), Feature(feature: "warpriest/channel-energy", count: 1), Feature(feature: "warpriest/shieldbearer/channel-energy-shieldbearer", count: 1), Feature(feature: "witch/hex-channeler/channel-energy", count: 1)]), AbilityScore(ability: Charisma, score: 13)])),
    (key: "shadowplay", name: "Shadowplay", summary: "+2 caster level for shadow spells.", category: Racial, guide: "feats#shadowplay", prerequisite: Race("gnome")),
    (key: "shaitan-earthblast", name: "Shaitan Earthblast", summary: "Spend two Elemental Fist uses for a 10 ft acid column within 30 ft: unarmed + fist damage and staggered 1 round, Reflex halves and negates.", category: UnarmedCombat, guide: "feats#shaitan-earthblast", prerequisite: All([Any([ClassLevel(class: "monk", level: 13), BaseAttackBonus(13)]), Feat("shaitan-skin"), AbilityScore(ability: Constitution, score: 15), AbilityScore(ability: Wisdom, score: 17)])),
    (key: "shaitan-skin", name: "Shaitan Skin", summary: "One more Elemental Fist a day; acid resistance equal to BAB in Shaitan Style; acid fists stagger 1 round (Reflex DC 10 + half level + Wis).", category: UnarmedCombat, guide: "feats#shaitan-skin", prerequisite: All([Any([ClassLevel(class: "monk", level: 9), BaseAttackBonus(11)]), Feat("shaitan-style"), AbilityScore(ability: Constitution, score: 15), AbilityScore(ability: Wisdom, score: 15)])),
    (key: "shaitan-style", name: "Shaitan Style", summary: "One more Elemental Fist a day; add Wis to acid damage, and an acid fist that misses still deals 1d6 acid.", category: UnarmedCombat, guide: "feats#shaitan-style", prerequisite: All([Any([ClassLevel(class: "monk", level: 5), BaseAttackBonus(9)]), Feat("elemental-fist"), Feat("improved-unarmed-strike"), AbilityScore(ability: Constitution, score: 13), AbilityScore(ability: Wisdom, score: 13)])),
    (key: "shake-it-off", name: "Shake It Off", summary: "+1 to saves for each adjacent ally with this feat, up to +4.", category: Teamwork, guide: "feats#shake-it-off"),
    (key: "shatter-defenses", name: "Shatter Defenses", summary: "Shaken, frightened or panicked foes you hit count as flat-footed through your next turn.", category: Weapon, guide: "feats#shatter-defenses", prerequisite: All([Feat("dazzling-display"), Feat("weapon-focus"), BaseAttackBonus(6)])),
    (key: "shield-bash", name: "Shield Bash", summary: "Shields become weapons: 1d3 for a light shield, 1d4 for a heavy one, with two-weapon fighting penalties.", category: ArmourAndShield, guide: "feats#shield-bash", prerequisite: Feat("shield-proficiency")),
    (key: "shield-focus", name: "Shield Focus", summary: "+1 AC from your shield.", category: ArmourAndShield, guide: "feats#shield-focus", prerequisite: Feat("shield-proficiency")),
    (key: "shield-master", name: "Shield Master", summary: "The shield's enhancement bonus counts for its attack and damage rolls, which also lose their penalties.", category: ArmourAndShield, guide: "feats#shield-master", prerequisite: All([Feat("shield-bash"), Feat("two-weapon-fighting"), BaseAttackBonus(11)])),
    (key: "shield-proficiency", name: "Shield Proficiency", summary: "Heavy shields, light shields and bucklers can be used proficiently.", category: ArmourAndShield, guide: "feats#shield-proficiency"),
    (key: "shield-wall", name: "Shield Wall", summary: "With a shield next to an ally who has this feat, your shield AC rises by +1 (ally's buckler or light shield) or +2 (heavy or tower).", category: Teamwork, guide: "feats#shield-wall", prerequisite: Feat("shield-proficiency")),
    (key: "shielded-caster", name: "Shielded Caster", summary: "Next to an ally with this feat, +4 to concentration checks, +5 if it has a buckler or light shield and +6 with a heavy or tower shield.", category: Teamwork, guide: "feats#shielded-caster"),
    (key: "shifters-edge", name: "Shifter\'s Edge", summary: "Adds half your class level to damage on attacks that use Dex to hit but not Dex for damage; can't be combined with Mythic Finesse.", category: Class, guide: "feats#shifters-edge", prerequisite: All([Any([Feature(feature: "shifter/dragonblood-shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/shifter-claws", count: 1), Feature(feature: "shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-1d10", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-1d6", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-1d8", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-1d10", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-1d6", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-1d8", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-cold-iron-magic-and-silver", count: 1)]), Feat("weapon-finesse"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "shifters-multiattack", name: "Shifter\'s Multiattack", summary: "Secondary natural attacks take -2 instead of -5.", category: Class, guide: "feats#shifters-multiattack", prerequisite: ClassLevel(class: "shifter", level: 6)),
    (key: "shifters-rush", name: "Shifter\'s Rush", summary: "Wild shape is a free action when you charge or move more than 10 ft in a round.", category: Class, guide: "feats#shifters-rush", prerequisite: Any([Any([Feature(feature: "druid/blight-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/defender-of-the-true-world/wild-shape-wolf", count: 1), Feature(feature: "druid/elemental-rampager/wild-shape-wolf", count: 1), Feature(feature: "druid/feyspeaker/wild-shape-wolf", count: 1), Feature(feature: "druid/primal-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/wild-shape-wolf", count: 1), Feature(feature: "warpriest/feral-champion/wild-shape-wolf", count: 1)]), Any([Feature(feature: "shifter/major-form", count: 1), Feature(feature: "shifter/wild-effigy/major-form", count: 1)])])),
    (key: "sickening-critical", name: "Sickening Critical", summary: "Your critical hits sicken the target for 1 minute, extended by further crits.", category: Weapon, guide: "feats#sickening-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(11)])),
    (key: "simple-weapon-proficiency", name: "Simple Weapon Proficiency", summary: "Proficiency with all simple weapons, such as the club, dagger, crossbows, maces, quarterstaff and spears.", category: Weapon, guide: "feats#simple-weapon-proficiency"),
    (key: "skill-focus", name: "Skill Focus", summary: "+3 to one skill, or +6 with 10 or more ranks in it.", category: Skill, guide: "feats#skill-focus", parameter: Skill, repeat: PerValue),
    (key: "slashing-grace", name: "Slashing Grace", summary: "Add Dex to damage with a Weapon Focus one-handed slashing weapon, without shield, off-hand weapon or flurry; it counts as piercing for Duelist.", category: Weapon, guide: "feats#slashing-grace", prerequisite: All([Feat("weapon-finesse"), Feat("weapon-focus"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "slayers-feint", name: "Slayer\'s Feint", summary: "Feint with Mobility instead of Persuasion.", category: Weapon, guide: "feats#slayers-feint", prerequisite: All([Any([FeatFor(feat: "skill-focus", value: Skill("mobility")), Feature(feature: "slayer/slayer-proficiencies", count: 1)]), Feat("combat-expertise"), Feat("feint"), AbilityScore(ability: Dexterity, score: 15)])),
    (key: "snap-shot", name: "Snap Shot", summary: "Lets a ranged weapon threaten the squares in your melee reach, so it can take attacks of opportunity.", category: Ranged, guide: "feats#snap-shot", prerequisite: All([Feat("point-blank-shot"), Feat("precise-shot"), BaseAttackBonus(6)])),
    (key: "spell-chain", name: "Spell Chain", summary: "Beating a foe's spell resistance lets the next ally who also has this feat roll that foe's SR check twice, keeping the higher roll.", category: Teamwork, guide: "feats#spell-chain"),
    (key: "spell-focus", name: "Spell Focus", summary: "+1 to the save DCs of spells from the chosen school.", category: Magic, guide: "feats#spell-focus", parameter: SpellSchool, repeat: PerValue),
    (key: "spell-penetration", name: "Spell Penetration", summary: "+2 to caster level checks against spell resistance.", category: Magic, guide: "feats#spell-penetration"),
    (key: "spell-specialization", name: "Spell Specialization", summary: "For one chosen spell from a Spell Focus school, level-based effects use caster level +2; you may switch spells each time your caster level rises.", category: Magic, guide: "feats#spell-specialization", prerequisite: Feat("spell-focus")),
    (key: "spirited-charge", name: "Spirited Charge", summary: "Double melee damage on a mounted charge.", category: MountedCombat, guide: "feats#spirited-charge", prerequisite: Feat("mounted-combat")),
    (key: "staggering-critical", name: "Staggering Critical", summary: "Crits stagger the target for 2 to 5 rounds, or just 1 round if it passes a Fort save (DC 10 + your BAB); more crits extend it.", category: Weapon, guide: "feats#staggering-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(13)])),
    (key: "stat-focus", name: "Stat Focus", summary: "+1 mythic bonus to a stat of your choice: AC, attack, attacks of opportunity, CMB, CMD, damage, HP, initiative, Fortitude, Reflex, Will or speed.", category: Miscellaneous, guide: "trickster#stat-focus", parameter: Stat, repeat: PerValue, prerequisite: SelectionOption("trickster/improved-mythic-trick/perception-ii")),
    (key: "stealthy", name: "Stealthy", summary: "+2 to Mobility and Stealth, or +4 for a skill with 10 or more ranks.", category: Skill, guide: "feats#stealthy"),
    (key: "steel-soul", name: "Steel Soul", summary: "+4 to saves against spells and spell-like abilities, replacing Hardy's +2.", category: Racial, guide: "feats#steel-soul", prerequisite: Race("dwarf")),
    (key: "stony-step", name: "Stony Step", summary: "+2 Mobility, and you ignore difficult terrain underground.", category: Racial, guide: "feats#stony-step", prerequisite: Race("oread")),
    (key: "stumbling-bash", name: "Stumbling Bash", summary: "Shield bash hits leave the target at -2 AC for 1 round.", category: ArmourAndShield, guide: "feats#stumbling-bash", prerequisite: All([Any([ClassLevel(class: "fighter", level: 4), BaseAttackBonus(6)]), Feat("shield-bash"), Feat("shield-focus")])),
    (key: "stunning-critical", name: "Stunning Critical", summary: "Your crits stun the target 1d4 rounds, or stagger it 1d4 rounds on a Fort save (DC 10 + your BAB); further crits add duration.", category: Weapon, guide: "feats#stunning-critical", prerequisite: All([Feat("critical-focus"), Feat("staggering-critical"), BaseAttackBonus(17)])),
    (key: "stunning-fist", name: "Stunning Fist", summary: "Once a day per 4 levels (once a round), a hit stuns 1 round, with no Dex to AC and -2 more AC (Fort DC 10 + half level + Wis).", category: UnarmedCombat, guide: "feats#stunning-fist", prerequisite: Feat("improved-unarmed-strike")),
    (key: "sunder-armor", name: "Sunder Armor", summary: "A foe you sunder loses its armour bonuses for 1 round (+1 per 5 over its CMD); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#sunder-armor", prerequisite: Feat("power-attack")),
    (key: "superior-summoning", name: "Superior Summoning", summary: "Multi-creature summons bring one extra creature of that kind.", category: Magic, guide: "feats#superior-summoning", prerequisite: Feat("augment-summoning")),
    (key: "tandem-trip", name: "Tandem Trip", summary: "Roll trips twice and keep the better result whenever an ally with this feat is beside you.", category: Teamwork, guide: "feats#tandem-trip", prerequisite: Feat("trip")),
    (key: "throw-anything", name: "Throw Anything", summary: "+1 to attack with thrown splash weapons.", category: Ranged, guide: "feats#throw-anything"),
    (key: "tiring-critical", name: "Tiring Critical", summary: "Your critical hits leave the target fatigued.", category: Weapon, guide: "feats#tiring-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(13)])),
    (key: "toppling-bash", name: "Toppling Bash", summary: "Once a round, after a shield bash hit, make a trip attempt at -5 that doesn't provoke.", category: ArmourAndShield, guide: "feats#toppling-bash", prerequisite: All([Any([ClassLevel(class: "fighter", level: 8), BaseAttackBonus(11)]), Feat("shield-bash"), Feat("shield-focus"), Feat("stumbling-bash")])),
    (key: "toughness", name: "Toughness", summary: "+3 HP, plus 1 HP per character level above 3rd.", category: Miscellaneous, guide: "feats#toughness"),
    (key: "tower-shield-proficiency", name: "Tower Shield Proficiency", summary: "Proficiency with tower shields.", category: ArmourAndShield, guide: "feats#tower-shield-proficiency", prerequisite: Feat("shield-proficiency")),
    (key: "trample", name: "Trample", summary: "Trample foes while mounted; a trampled foe is knocked prone and takes damage as from one of your mount's natural attacks.", category: MountedCombat, guide: "feats#trample", prerequisite: Feat("mounted-combat")),
    (key: "trip", name: "Trip", summary: "Instead of a melee attack, knock a foe prone (harder per extra leg; not fliers or legless); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#trip", prerequisite: Any([All([Feature(feature: "kineticist/kinetic-knight/kinetic-warrior", count: 1), AbilityScore(ability: Intelligence, score: 13)]), Feat("combat-expertise")])),
    (key: "two-weapon-feint", name: "Two-Weapon Feint", summary: "While two-weapon fighting, trade your first main-hand attack for a Persuasion (Bluff) feint against a foe.", category: Weapon, guide: "feats#two-weapon-feint", prerequisite: All([Feat("feint"), Feat("two-weapon-fighting"), AbilityScore(ability: Dexterity, score: 15)])),
    (key: "two-weapon-fighting", name: "Two-Weapon Fighting", summary: "Two-weapon penalties drop to -4/-4, or -2/-2 with a light off-hand weapon.", category: Weapon, guide: "feats#two-weapon-fighting", prerequisite: AbilityScore(ability: Dexterity, score: 15)),
    (key: "vital-strike", name: "Vital Strike", summary: "Standard action: one attack at your highest bonus that rolls the weapon's damage twice; flat bonuses are added once.", category: Weapon, guide: "feats#vital-strike", prerequisite: BaseAttackBonus(6)),
    (key: "volley-fire", name: "Volley Fire", summary: "+1 to ranged attacks for each ally with this feat who shot at a foe within 15 ft of your target since your last turn, up to +4.", category: Teamwork, guide: "feats#volley-fire", prerequisite: Feat("point-blank-shot")),
    (key: "vulpine-pounce", name: "Vulpine Pounce", summary: "Pounce while in kitsune form.", category: Racial, guide: "feats#vulpine-pounce", prerequisite: All([BaseAttackBonus(10), Race("kitsune")])),
    (key: "warrior-priest", name: "Warrior Priest", summary: "+1 to initiative and +2 to concentration checks.", category: Class, guide: "feats#warrior-priest", prerequisite: SpellLevel(spell_type: Divine, level: 1)),
    (key: "weapon-finesse", name: "Weapon Finesse", summary: "Use Dex instead of Str for attack rolls (not damage) with light and finesse weapons such as the dagger, rapier, dueling sword and estoc.", category: Weapon, guide: "feats#weapon-finesse"),
    (key: "weapon-focus", name: "Weapon Focus", summary: "+1 to attack with one weapon (or unarmed strike, natural weapons, touch attacks or rays); repeatable for other weapons.", category: Weapon, guide: "feats#weapon-focus", parameter: Weapon, repeat: PerValue, prerequisite: BaseAttackBonus(1)),
    (key: "weapon-specialization", name: "Weapon Specialization", summary: "+2 damage with a weapon you have Weapon Focus in.", category: Weapon, guide: "feats#weapon-specialization", parameter: Weapon, repeat: PerValue, prerequisite: All([FeatForSameValue("weapon-focus"), ClassLevel(class: "fighter", level: 4)])),
    (key: "wings", name: "Wings", summary: "Wings that make you immune to ground-based effects and give +3 dodge AC versus melee.", category: Racial, guide: "feats#wings", prerequisite: All([CharacterLevel(10), Race("aasimar")])),
]
