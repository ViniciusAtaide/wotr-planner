    (key: "extra-slayer-talent", blueprint: "53f7237f5b1447bb851ba68045a00e41", name: "Extra Slayer Talent", summary: "One more slayer talent whose prerequisites you meet; up to 3 times.", category: Class, guide: "feats#extra-slayer-talent", repeat: Times(3), extra_pick_of: ["slayer/slayer-talents"], prerequisite: Any([All([ClassLevel(class: "inquisitor", level: 8), Archetype("inquisitor/sanctified-slayer")]), ClassLevel(class: "slayer", level: 2)])),
    (key: "extra-wild-talent", blueprint: "0f73730cf1b44ee882671e55d5f6e471", name: "Extra Wild Talent", summary: "One more wild talent whose prerequisites you meet; up to 3 times.", category: Class, guide: "feats#extra-wild-talent", repeat: Times(3), extra_pick_of: ["kineticist/wild-talents"], prerequisite: ClassLevel(class: "kineticist", level: 2)),
    (key: "fast-learner", blueprint: "7ad59ca648c14c0a92adec798d51eb6d", name: "Fast Learner", summary: "+1 skill point per level.", category: Racial, guide: "feats#fast-learner", prerequisite: Race("human")),
    (key: "favored-enemy-spellcasting", blueprint: "0226d84afe68462da8a392798f1225b8", name: "Favored Enemy Spellcasting", summary: "Spells you cast are resisted at -2 by your favoured enemies.", category: Magic, guide: "feats#favored-enemy-spellcasting", prerequisite: Any([Feature(feature: "inquisitor/sacred-huntsmaster/favored-enemy", count: 1), Feature(feature: "ranger/favored-enemy", count: 1)])),
    (key: "feint", blueprint: "c610310d31414edabcedf0c8a6fe32c4", name: "Feint", summary: "Persuasion (Bluff) vs 10 + the foe's BAB + Wis (or its Perception if trained and higher): your next melee attack ignores its Dex bonus to AC.", category: Weapon, guide: "feats#feint", prerequisite: All([Feat("combat-expertise"), AbilityScore(ability: Intelligence, score: 13)])),
    (key: "fencing-grace", blueprint: "47b352ea0f73c354aba777945760b441", name: "Fencing Grace", summary: "Add Dex to damage with a Weapon Focus one-handed piercing finesse weapon, without a shield, off-hand weapon or Flurry of Blows.", category: Weapon, guide: "feats#fencing-grace", prerequisite: All([Any([FeatFor(feat: "weapon-focus", value: Weapon("dagger")), FeatFor(feat: "weapon-focus", value: Weapon("estoc")), FeatFor(feat: "weapon-focus", value: Weapon("punching-dagger")), FeatFor(feat: "weapon-focus", value: Weapon("rapier")), FeatFor(feat: "weapon-focus", value: Weapon("sai")), FeatFor(feat: "weapon-focus", value: Weapon("starknife"))]), Feat("weapon-finesse"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "final-feint", blueprint: "32429740d6a5470aaaa02f20d61e43d3", name: "Final Feint", summary: "Feints now last the whole round: the foe has no Dex bonus against any of your melee attacks.", category: Weapon, guide: "feats#final-feint", prerequisite: All([Feat("combat-expertise"), Feat("feint"), AbilityScore(ability: Intelligence, score: 13), BaseAttackBonus(6)])),
    (key: "flaying-critical", blueprint: "a0e95a17fed549bcbf85a977811f6094", name: "Flaying Critical", summary: "Each of your critical hits gives the target a stacking -1 to its natural armour bonus.", category: Weapon, guide: "feats#flaying-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(11)])),
    (key: "focused-shot", blueprint: "f979ed68d1e74d21962edc66f0a1d169", name: "Focused Shot", summary: "Adds Int to damage on a standard-action ranged attack at 30 ft or less; foes immune to crits or sneak attacks ignore the bonus.", category: Ranged, guide: "feats#focused-shot", prerequisite: All([Feat("point-blank-shot"), Feat("precise-shot"), AbilityScore(ability: Intelligence, score: 13)])),
    (key: "focused-strike", blueprint: "f09b89812cc94b89a09069671002b899", name: "Focused Strike", summary: "With a two-handed grip, your first attack each turn takes no Power Attack penalty to hit.", category: Weapon, guide: "feats#focused-strike", prerequisite: All([Feat("power-attack"), AbilityScore(ability: Strength, score: 13), BaseAttackBonus(1)])),
    (key: "frightening-ambush", blueprint: "805fd6181a104bf0aca9ae79ef220c16", name: "Frightening Ambush", summary: "Free demoralise attempt against any flat-footed foe you hit.", category: Miscellaneous, guide: "feats#frightening-ambush", prerequisite: SkillRanks(skill: "persuasion", ranks: 1)),
    (key: "frightful-shape", blueprint: "8e8a34c754d649aa9286fe8ee5cc3f10", name: "Frightful Shape", summary: "Attacking while shifted shakes foes within 30 ft with fewer HD than you for rounds equal to level (Will negates); 4 HD or less are frightened.", category: Class, guide: "feats#frightful-shape", prerequisite: All([Any([Any([Feature(feature: "druid/blight-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/defender-of-the-true-world/wild-shape-wolf", count: 1), Feature(feature: "druid/elemental-rampager/wild-shape-wolf", count: 1), Feature(feature: "druid/feyspeaker/wild-shape-wolf", count: 1), Feature(feature: "druid/primal-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/wild-shape-wolf", count: 1), Feature(feature: "warpriest/feral-champion/wild-shape-wolf", count: 1)]), Any([Feature(feature: "shifter/major-form", count: 1), Feature(feature: "shifter/wild-effigy/major-form", count: 1)])]), AbilityScore(ability: Wisdom, score: 19)])),
    (key: "furys-fall", blueprint: "0fc1ed8532168f74a9441bd17ad59e66", name: "Fury\'s Fall", summary: "Add your Dex bonus to your CMB when tripping.", category: CombatManoeuvres, guide: "feats#furys-fall", prerequisite: Feat("trip")),
    (key: "great-cleave", blueprint: "cc9c862ef2e03af4f89be5088851ea35", name: "Great Cleave", summary: "Like Cleave, but keep attacking further adjacent foes, each once, while you keep hitting; -2 AC until your next turn.", category: Weapon, guide: "feats#great-cleave", prerequisite: Feat("cleave")),
    (key: "great-fortitude", blueprint: "79042cb55f030614ea29956177977c52", name: "Great Fortitude", summary: "+2 to Fortitude saves.", category: Miscellaneous, guide: "feats#great-fortitude"),
    (key: "greater-blind-fight", blueprint: "80a50d9744a40ac4c96e2cc6451a6703", name: "Greater Blind Fight", summary: "Only total concealment affects your melee, at a 20% miss chance you can reroll; invisible foes get no edge at any range.", category: Miscellaneous, guide: "feats#greater-blind-fight", prerequisite: All([Feat("improved-blind-fight"), SkillRanks(skill: "perception", ranks: 15)])),
    (key: "greater-bull-rush", blueprint: "72ba6ad46d94ecd41bad8e64739ea392", name: "Greater Bull Rush", summary: "Foes you bull rush provoke attacks of opportunity as they're pushed; +2 more to the check.", category: CombatManoeuvres, guide: "feats#greater-bull-rush", prerequisite: All([Feat("bull-rush"), BaseAttackBonus(6)])),
    (key: "greater-dirty-trick", blueprint: "52c6b07a68940af41b270b3710682dc7", name: "Greater Dirty Trick", summary: "Dirty tricks last 1d4 rounds +1 per 5 over the foe's CMD, and get +2 more to the check.", category: CombatManoeuvres, guide: "feats#greater-dirty-trick", prerequisite: All([Feat("dirty-trick"), BaseAttackBonus(6)])),
    (key: "greater-disarm", blueprint: "63d8e3a9ab4d72e4081a7862d7246a79", name: "Greater Disarm", summary: "Disarms last 1d4 rounds +1 per 5 over the foe's CMD, and get +2 more to the check.", category: CombatManoeuvres, guide: "feats#greater-disarm", prerequisite: All([Feat("disarm"), BaseAttackBonus(6)])),
    (key: "greater-dispel-focus", blueprint: "d0cf79c8e0a44325b00dc8fa6ad37d7c", name: "Greater Dispel Focus", summary: "+2 more caster level on dispel attempts.", category: Magic, guide: "feats#greater-dispel-focus", prerequisite: Feat("dispel-focus")),
    (key: "greater-elemental-focus", blueprint: "1c17446a3eb744f438488711b792ca4d", name: "Greater Elemental Focus", summary: "+1 more to the save DCs of your spells of an energy type you have Elemental Focus in.", category: Magic, guide: "feats#greater-elemental-focus", parameter: Energy, repeat: PerValue, prerequisite: FeatForSameValue("elemental-focus")),
    (key: "greater-penetrating-strike", blueprint: "eb6eb946c68ef094f89c7633f5bfdc9b", name: "Greater Penetrating Strike", summary: "Damage reduction up to 10 points doesn't apply to hits from your Weapon Focus weapons.", category: Weapon, guide: "feats#greater-penetrating-strike", prerequisite: All([Feat("penetrating-strike"), ClassLevel(class: "fighter", level: 16)])),
    (key: "greater-shield-focus", blueprint: "afd05ca5363036c44817c071189b67e1", name: "Greater Shield Focus", summary: "+1 more AC from your shield.", category: ArmourAndShield, guide: "feats#greater-shield-focus", prerequisite: All([Feat("shield-focus"), ClassLevel(class: "fighter", level: 8)])),
    (key: "greater-snap-shot", blueprint: "67b09c86234cecc4c8309f22f7d33973", name: "Greater Snap Shot", summary: "+2 damage and crit confirmation on attacks of opportunity (+4 from BAB 16, +6 from BAB 20); Snap Shot covers 5 more ft.", category: Ranged, guide: "feats#greater-snap-shot", prerequisite: All([Feat("improved-snap-shot"), AbilityScore(ability: Dexterity, score: 17), BaseAttackBonus(12)])),
    (key: "greater-spell-focus", blueprint: "5b04b45b228461c43bad768eb0f7c7bf", name: "Greater Spell Focus", summary: "+1 more to the save DCs of spells from a school you have Spell Focus in.", category: Magic, guide: "feats#greater-spell-focus", parameter: SpellSchool, repeat: PerValue, prerequisite: FeatForSameValue("spell-focus")),
    (key: "greater-spell-penetration", blueprint: "1978c3f91cfbbc24b9c9b0d017f4beec", name: "Greater Spell Penetration", summary: "+2 more to caster level checks against spell resistance.", category: Magic, guide: "feats#greater-spell-penetration", prerequisite: Feat("spell-penetration")),
    (key: "greater-sunder-armor", blueprint: "54d824028117e884a8f9356c7c66149b", name: "Greater Sunder Armor", summary: "Sundered armour stays down 1d4 rounds +1 per 5 over the foe's CMD, and the check gets +2 more.", category: CombatManoeuvres, guide: "feats#greater-sunder-armor", prerequisite: All([Feat("sunder-armor"), BaseAttackBonus(6)])),
    (key: "greater-trip", blueprint: "4cc71ae82bdd85b40b3cfe6697bb7949", name: "Greater Trip", summary: "Tripped foes provoke attacks of opportunity, and trip checks get +2 more.", category: CombatManoeuvres, guide: "feats#greater-trip", prerequisite: All([Feat("trip"), BaseAttackBonus(6)])),
    (key: "greater-two-weapon-fighting", blueprint: "c126adbdf6ddd8245bda33694cd774e8", name: "Greater Two-Weapon Fighting", summary: "A third off-hand attack at -10.", category: Weapon, guide: "feats#greater-two-weapon-fighting", prerequisite: All([Feat("improved-two-weapon-fighting"), AbilityScore(ability: Dexterity, score: 19), BaseAttackBonus(11)])),
    (key: "greater-vital-strike", blueprint: "e2d1fa11f6b095e4fb2fd1dcf5e36eb3", name: "Greater Vital Strike", summary: "Standard action: one attack at your highest bonus that rolls the weapon's damage four times.", category: Weapon, guide: "feats#greater-vital-strike", prerequisite: All([Feat("improved-vital-strike"), BaseAttackBonus(16)])),
    (key: "greater-weapon-focus", blueprint: "09c9e82965fb4334b984a1e9df3bd088", name: "Greater Weapon Focus", summary: "+1 more to attack with a weapon you have Weapon Focus in.", category: Weapon, guide: "feats#greater-weapon-focus", parameter: Weapon, requires_proficiency: true, repeat: PerValue, prerequisite: All([FeatForSameValue("weapon-focus"), ClassLevel(class: "fighter", level: 8)])),
    (key: "greater-weapon-specialization", blueprint: "7cf5edc65e785a24f9cf93af987d66b3", name: "Greater Weapon Specialization", summary: "+2 more damage with a weapon you have Weapon Specialization in.", category: Weapon, guide: "feats#greater-weapon-specialization", parameter: Weapon, requires_proficiency: true, repeat: PerValue, prerequisite: All([FeatForSameValue("weapon-specialization"), ClassLevel(class: "fighter", level: 12)])),
    (key: "hammer-the-gap", blueprint: "7b64641c76ff4a744a2bce7f91a20f9a", name: "Hammer the Gap", summary: "Every hit in an unbroken streak this turn adds +1 damage per earlier hit in the streak; crits multiply it.", category: Weapon, guide: "feats#hammer-the-gap", prerequisite: BaseAttackBonus(6)),
    (key: "harmonic-spell", blueprint: "88c5ed03321d45b99a65a621c5963c65", name: "Harmonic Spell", summary: "Spells of 1st level or higher cast mid-performance refund a round of bardic performance.", category: Class, guide: "feats#harmonic-spell", prerequisite: ClassLevel(class: "bard", level: 1)),
    (key: "history-of-terrors", blueprint: "9e4c7d08f67f4496ba42c2cdb00609a7", name: "History of Terrors", summary: "+2 to saves against mind-affecting effects and +4 against fear.", category: Racial, guide: "feats#history-of-terrors", prerequisite: Race("human")),
    (key: "improved-blind-fight", blueprint: "4f1a78b02ac71bd4fa7d6e011d6f8ce0", name: "Improved Blind Fight", summary: "Only total concealment affects your melee (miss can be rerolled); invisible foes within 30 ft get no ranged edge.", category: Miscellaneous, guide: "feats#improved-blind-fight", prerequisite: All([Feat("blind-fight"), SkillRanks(skill: "perception", ranks: 10)])),
    (key: "improved-cleaving-finish", blueprint: "ffa1b373190af4f4db7a5501904a1983", name: "Improved Cleaving Finish", summary: "Cleaving Finish works any number of times a round.", category: Weapon, guide: "feats#improved-cleaving-finish", prerequisite: All([Feat("cleaving-finish"), Feat("great-cleave"), BaseAttackBonus(6)])),
    (key: "improved-critical", blueprint: "f4201c85a991369408740c6888362e20", name: "Improved Critical", summary: "Doubles the threat range of the chosen weapon type, before other threat-range effects.", category: Weapon, guide: "feats#improved-critical", parameter: Weapon, requires_proficiency: true, repeat: PerValue, prerequisite: BaseAttackBonus(8)),
    (key: "improved-elven-immunities", blueprint: "12a62aa4876a4c6b95e8acca7a6f8369", name: "Improved Elven Immunities", summary: "+2 more to saves against enchantment, and +1 DC to your enchantment spells.", category: Racial, guide: "feats#improved-elven-immunities", prerequisite: Any([Race("elf"), Race("half-elf")])),
    (key: "improved-great-fortitude", blueprint: "f5db1cc7ad48d794f85252fa4a64157b", name: "Improved Great Fortitude", summary: "+2 more to Fortitude saves.", category: Miscellaneous, guide: "feats#improved-great-fortitude", prerequisite: Feat("great-fortitude")),
    (key: "improved-improved-critical", blueprint: "56f94badbba018b4b8277ce6e2e79e72", name: "Improved Improved Critical", summary: "+1 to the threat range of the chosen weapon.", category: Weapon, guide: "trickster#improved-improved-critical", parameter: Weapon, requires_proficiency: true, repeat: PerValue, prerequisite: All([FeatForSameValue("improved-critical"), SelectionOption("trickster/improved-mythic-trick/perception-ii")])),
    (key: "improved-improved-improved-critical", blueprint: "006a966007802a0478c9e21007207aac", name: "Improved Improved Improved Critical", summary: "+1 more to the threat range of the chosen weapon.", category: Weapon, guide: "trickster#improved-improved-improved-critical", parameter: Weapon, requires_proficiency: true, repeat: PerValue, prerequisite: All([FeatForSameValue("improved-improved-critical"), SelectionOption("trickster/improved-mythic-trick/perception-ii")])),
    (key: "improved-improved-improved-critical-improved", blueprint: "319c882ab3cc51544ad2f3f43633d5b1", name: "Improved Improved Improved Critical Improved", summary: "+1 to the critical multiplier of the chosen weapon.", category: Weapon, guide: "trickster#improved-improved-improved-critical-improved", parameter: Weapon, requires_proficiency: true, repeat: PerValue, prerequisite: All([FeatForSameValue("improved-improved-improved-critical"), SelectionOption("trickster/improved-mythic-trick/perception-ii")])),
    (key: "improved-initiative", blueprint: "797f25d709f559546b29e7bcb181cc74", name: "Improved Initiative", summary: "+4 to initiative.", category: Miscellaneous, guide: "feats#improved-initiative"),
    (key: "improved-iron-will", blueprint: "3ea2215150a1c8a4a9bfed9d9023903e", name: "Improved Iron Will", summary: "+2 more to Will saves.", category: Miscellaneous, guide: "feats#improved-iron-will", prerequisite: Feat("iron-will")),
    (key: "improved-lightning-reflexes", blueprint: "1e813eb8159b67a459b1c975027866e5", name: "Improved Lightning Reflexes", summary: "+2 more to Reflex saves.", category: Miscellaneous, guide: "feats#improved-lightning-reflexes", prerequisite: Feat("lightning-reflexes")),
    (key: "improved-precise-shot", blueprint: "46f970a6b9b5d2346b10892673fe6e74", name: "Improved Precise Shot", summary: "Only total concealment can make your ranged attacks miss by chance.", category: Ranged, guide: "feats#improved-precise-shot", prerequisite: All([Feat("point-blank-shot"), Feat("precise-shot"), AbilityScore(ability: Dexterity, score: 19), BaseAttackBonus(11)])),
    (key: "improved-snap-shot", blueprint: "c3453e7e215c1f149b938be27ac754c6", name: "Improved Snap Shot", summary: "Snap Shot reaches 5 ft further.", category: Ranged, guide: "feats#improved-snap-shot", prerequisite: All([Feat("rapid-shot"), Feat("snap-shot"), BaseAttackBonus(9)])),
    (key: "improved-two-weapon-fighting", blueprint: "9af88f3ed8a017b45a6837eab7437629", name: "Improved Two-Weapon Fighting", summary: "A second off-hand attack at -5.", category: Weapon, guide: "feats#improved-two-weapon-fighting", prerequisite: All([Feat("two-weapon-fighting"), AbilityScore(ability: Dexterity, score: 17), BaseAttackBonus(6)])),
    (key: "improved-unarmed-strike", blueprint: "7812ad3672a4b9a4fb894ea402095167", name: "Improved Unarmed Strike", summary: "You count as armed when unarmed; unarmed strikes deal 1d3 (1d2 if small).", category: UnarmedCombat, guide: "feats#improved-unarmed-strike"),
    (key: "improved-vital-strike", blueprint: "52913092cd018da47845f36e6fbe240f", name: "Improved Vital Strike", summary: "Standard action: one attack at your highest bonus that rolls the weapon's damage three times.", category: Weapon, guide: "feats#improved-vital-strike", prerequisite: All([Feat("vital-strike"), BaseAttackBonus(11)])),
    (key: "indomitable-mount", blueprint: "68e814f1f3ce55942a52c1dd536eaa5b", name: "Indomitable Mount", summary: "A Mobility check against the DC can turn your mount's failed save into a success, once a round.", category: MountedCombat, guide: "feats#indomitable-mount", prerequisite: SkillRanks(skill: "mobility", ranks: 5)),
    (key: "intimidating-prowess", blueprint: "d76497bfc48516e45a0831628f767a0f", name: "Intimidating Prowess", summary: "Intimidate checks with Persuasion use your Strength modifier on top of Charisma.", category: Skill, guide: "feats#intimidating-prowess"),
    (key: "iron-will", blueprint: "175d1577bb6c9a04baf88eec99c66334", name: "Iron Will", summary: "+2 to Will saves.", category: Miscellaneous, guide: "feats#iron-will"),
    (key: "ironguts", blueprint: "90f7164ce17840c68c1ceadcf5d10297", name: "Ironguts", summary: "+2 to saves against poison and against sickening and nauseating attacks.", category: Racial, guide: "feats#ironguts", prerequisite: Race("half-orc")),
    (key: "ironhide", blueprint: "07a8059e18fd42eea61567cb11365a9d", name: "Ironhide", summary: "+1 natural armour to AC.", category: Racial, guide: "feats#ironhide", prerequisite: Any([Race("dwarf"), Race("half-orc")])),
    (key: "life-dominant-soul", blueprint: "8f58b4029511b5345981ffaf1da5ea2e", name: "Life-Dominant Soul", summary: "Channelled positive energy that heals the living and negative energy that heals undead both heal you, at half the amount.", category: Racial, guide: "feats#life-dominant-soul", prerequisite: Race("dhampir")),
    (key: "lightning-reflexes", blueprint: "15e7da6645a7f3d41bdad7c8c4b9de1e", name: "Lightning Reflexes", summary: "+2 to Reflex saves.", category: Miscellaneous, guide: "feats#lightning-reflexes"),
    (key: "lingering-performance", blueprint: "17239b298065efc459cffe2220ecb559", name: "Lingering Performance", summary: "Stopping a performance doesn't end its effects for another 2 rounds.", category: Class, guide: "feats#lingering-performance", prerequisite: Any([Feature(feature: "bard/bardic-performance-move-action", count: 1), Feature(feature: "bard/bardic-performance-swift-action", count: 1)])),
    (key: "lunge", blueprint: "d41d5bd9a775d7245929256d58a3e03e", name: "Lunge", summary: "Trade 2 AC for 5 ft of extra melee reach until your turn ends.", category: Weapon, guide: "feats#lunge", prerequisite: BaseAttackBonus(6)),
    (key: "magical-tail", blueprint: "5114829572da5a04f896a8c5b67be413", name: "Magical Tail", summary: "Up to 8 times: a new spell-like ability, usable twice a day, in order from Vanish to Dominate Person; caster level = HD, DCs use Cha.", category: Racial, guide: "feats#magical-tail", repeat: Times(8), prerequisite: Race("kitsune")),
    (key: "manyshot", blueprint: "adf54af2a681792489826f7fd1b62889", name: "Manyshot", summary: "In a full attack with a bow, your first attack fires two arrows, each getting your damage bonuses and facing damage reduction.", category: Ranged, guide: "feats#manyshot", prerequisite: All([Feat("point-blank-shot"), Feat("rapid-shot"), AbilityScore(ability: Dexterity, score: 17), BaseAttackBonus(6)])),
    (key: "martial-weapons-proficiency", blueprint: "203992ef5b35c864390b4e4a1e200629", name: "Martial Weapons Proficiency", summary: "Proficiency with all martial weapons, such as the longsword, greatsword, greataxe, falchion, longbow, rapier and scimitar.", category: Weapon, guide: "feats#martial-weapons-proficiency"),
    (key: "metamagic-bolster-spell", blueprint: "fbf5d9ce931f47f3a0c818b3f8ef8414", name: "Metamagic (Bolster Spell)", summary: "+1 spell level: the spell deals +2 damage per die, and 2 damage per die to every enemy within 5 ft of its targets.", category: Magic, guide: "feats#metamagic-bolster-spell"),
    (key: "metamagic-completely-normal-spell", blueprint: "094b6278f7b570f42aeaa98379f07cf2", name: "Metamagic (Completely Normal Spell)", summary: "The spell's level drops by 1, so 1st-level spells can be cast as cantrips.", category: Magic, guide: "trickster#metamagic-completely-normal-spell", prerequisite: SelectionOption("trickster/improved-mythic-trick/perception-ii")),
    (key: "metamagic-empower-spell", blueprint: "a1de1e4f92195b442adb946f0e2b9d4e", name: "Metamagic (Empower Spell)", summary: "+2 spell level: the spell's variable numbers are 50% higher.", category: Magic, guide: "feats#metamagic-empower-spell"),
    (key: "metamagic-extend-spell", blueprint: "f180e72e4a9cbaa4da8be9bc958132ef", name: "Metamagic (Extend Spell)", summary: "+1 spell level: doubles the spell's duration (not instant, permanent or concentration spells).", category: Magic, guide: "feats#metamagic-extend-spell"),
    (key: "metamagic-heighten-spell", blueprint: "2f5d1e705c7967546b72ad8218ccf99c", name: "Metamagic (Heighten Spell)", summary: "Cast the spell at a higher level, up to your highest, raising its DC and beating spell-level immunities.", category: Magic, guide: "feats#metamagic-heighten-spell"),
    (key: "metamagic-intensified-spell", blueprint: "8ad7fd39abea4722b39eb5a67d606a41", name: "Metamagic (Intensified Spell)", summary: "+1 spell level: the spell's damage dice cap rises by 5 caster levels, if your caster level is high enough.", category: Magic, guide: "feats#metamagic-intensified-spell"),
    (key: "metamagic-maximise-spell", blueprint: "7f2b282626862e345935bbea5e66424b", name: "Metamagic (Maximise Spell)", summary: "+3 spell level: the spell's variable numbers are maximised; it can also be empowered.", category: Magic, guide: "feats#metamagic-maximise-spell"),
    (key: "metamagic-persistent-spell", blueprint: "cd26b9fa3f734461a0fcedc81cafaaac", name: "Metamagic (Persistent Spell)", summary: "+2 spell level: a target that saves must save again or take the full effect.", category: Magic, guide: "feats#metamagic-persistent-spell"),
    (key: "metamagic-piercing-spell", blueprint: "c101ad6879a94204a780506f7a554865", name: "Metamagic (Piercing Spell)", summary: "+1 spell level: the target's spell resistance counts as 5 lower.", category: Magic, guide: "feats#metamagic-piercing-spell"),
    (key: "metamagic-quicken-spell", blueprint: "ef7ece7bb5bb66a41b256976b27f424e", name: "Metamagic (Quicken Spell)", summary: "+4 spell level: cast the spell as a swift action without provoking (not spells taking over a full round).", category: Magic, guide: "feats#metamagic-quicken-spell"),
    (key: "metamagic-reach-spell", blueprint: "46fad72f54a33dc4692d3b62eca7bb78", name: "Metamagic (Reach Spell)", summary: "+1 spell level: a touch, close or medium range spell reaches the next range up; melee touch becomes ranged touch.", category: Magic, guide: "feats#metamagic-reach-spell"),
    (key: "metamagic-selective-spell", blueprint: "85f3340093d144dd944fff9a9adfd2f2", name: "Metamagic (Selective Spell)", summary: "+1 spell level: up to your casting stat modifier in creatures of your choice are left out of the spell's area.", category: Magic, guide: "feats#metamagic-selective-spell"),
    (key: "missile-shield", blueprint: "5ffcd225924514348ac71730179b5b24", name: "Missile Shield", summary: "Once a round, your shield lets you deflect a ranged weapon attack, unless you're flat-footed.", category: ArmourAndShield, guide: "feats#missile-shield", prerequisite: All([Feat("shield-focus"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "mounted-combat", blueprint: "f308a03bea0d69843a8ed0af003d47a9", name: "Mounted Combat", summary: "Hits on your mount can be cancelled, once a round, by a Mobility check beating the attack roll.", category: MountedCombat, guide: "feats#mounted-combat", prerequisite: SkillRanks(skill: "mobility", ranks: 1)),
    (key: "mounted-shield", blueprint: "e5bee904e6724fc44aae8887dcefae51", name: "Mounted Shield", summary: "Add your shield's base bonus and Shield Focus (not enhancement) to your mount's AC.", category: MountedCombat, guide: "feats#mounted-shield", prerequisite: All([Feat("mounted-combat"), Feat("shield-focus")])),
    (key: "murmurs-of-earth", blueprint: "94be54cd152d1c94396754de7bf0105f", name: "Murmurs of Earth", summary: "You know where every creature within 15 ft is, as long as it touches the ground.", category: Racial, guide: "feats#murmurs-of-earth", prerequisite: All([Feat("echoes-of-stone"), CharacterLevel(9)])),
    (key: "natural-charmer", blueprint: "0ebbc4a0ecf03844384a177e9f1f9a11", name: "Natural Charmer", summary: "Your next Persuasion check can be a take 20, once a day.", category: Racial, guide: "feats#natural-charmer", prerequisite: All([AbilityScore(ability: Charisma, score: 17), Race("dhampir")])),
    (key: "natural-spell", blueprint: "c806103e27cce6f429e5bf47067966cf", name: "Natural Spell", summary: "Shifted forms no longer stop you from casting.", category: Class, guide: "feats#natural-spell", prerequisite: All([Any([Feature(feature: "druid/blight-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/defender-of-the-true-world/wild-shape-wolf", count: 1), Feature(feature: "druid/elemental-rampager/wild-shape-wolf", count: 1), Feature(feature: "druid/feyspeaker/wild-shape-wolf", count: 1), Feature(feature: "druid/primal-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/wild-shape-wolf", count: 1), Feature(feature: "warpriest/feral-champion/wild-shape-wolf", count: 1)]), AbilityScore(ability: Wisdom, score: 13)])),
    (key: "outflank", blueprint: "422dab7309e1ad343935f33a4d6e9f11", name: "Outflank", summary: "Your flanking bonus becomes +4 when an ally with this feat flanks with you, and your crits there give that ally an attack of opportunity.", category: Teamwork, guide: "feats#outflank", prerequisite: BaseAttackBonus(4)),
    (key: "penetrating-strike", blueprint: "308cd7dc4f10efd428f531bbf4f2823d", name: "Penetrating Strike", summary: "Damage reduction up to 5 points doesn't apply to hits from your Weapon Focus weapons.", category: Weapon, guide: "feats#penetrating-strike", prerequisite: All([Feat("weapon-focus"), ClassLevel(class: "fighter", level: 12)])),
    (key: "perfect-strike", blueprint: "7477e2e0b72f4ce4fb674f4b21d5e81d", name: "Perfect Strike", summary: "Once a day per 4 levels, roll an attack twice and keep the higher result.", category: UnarmedCombat, guide: "feats#perfect-strike", prerequisite: All([Feat("improved-unarmed-strike"), AbilityScore(ability: Dexterity, score: 13), AbilityScore(ability: Wisdom, score: 13), BaseAttackBonus(8)])),
    (key: "persuasive", blueprint: "86d93a5891d299d4983bdc6ef3987afd", name: "Persuasive", summary: "+2 to Persuasion and Perception, or +4 for a skill with 10 or more ranks.", category: Skill, guide: "feats#persuasive"),
    (key: "piranha-strike", blueprint: "6a556375036ac8b4ebd80e74d308d108", name: "Piranha Strike", summary: "With a finesse weapon, take -1 to attack for +2 damage (+1 off-hand); both grow at BAB 4 and every 4 after.", category: Weapon, guide: "feats#piranha-strike", prerequisite: All([Feat("weapon-finesse"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "point-blank-master", blueprint: "05a3b543b0a0a0346a5061e90f293f0b", name: "Point Blank Master", summary: "Shooting your specialised weapon while threatened provokes no attacks of opportunity.", category: Ranged, guide: "feats#point-blank-master", prerequisite: Feat("weapon-specialization")),
    (key: "point-blank-shot", blueprint: "0da0c194d6e1d43419eb8d990b28e0ab", name: "Point-Blank Shot", summary: "Ranged attacks within 30 ft get +1 to hit and damage.", category: Ranged, guide: "feats#point-blank-shot"),
    (key: "power-attack", blueprint: "9972f33f977fc724c838e59641b2fca5", name: "Power Attack", summary: "Take -1 to attack for +2 damage (+3 two-handed, +1 off-hand); both grow at BAB 4 and every 4 after.", category: Weapon, guide: "feats#power-attack", prerequisite: AbilityScore(ability: Strength, score: 13)),
    (key: "precise-shot", blueprint: "8f3d1e6b4be006f4d896081f2f889665", name: "Precise Shot", summary: "No -4 penalty for shooting at foes in melee.", category: Ranged, guide: "feats#precise-shot", prerequisite: Feat("point-blank-shot")),
    (key: "precise-strike", blueprint: "5662d1b793db90c4b9ba68037fd2a768", name: "Precise Strike", summary: "Flanking a foe with an ally who has this feat adds 1d6 to each of your melee hits, not multiplied on a crit.", category: Teamwork, guide: "feats#precise-strike", prerequisite: All([AbilityScore(ability: Dexterity, score: 13), BaseAttackBonus(1)])),
    (key: "pummeling-bully", blueprint: "bdf58317985383540920c723db07aa3b", name: "Pummeling Bully", summary: "With Pummeling Style in a full attack or flurry, a hit lets you make a free trip attempt.", category: UnarmedCombat, guide: "feats#pummeling-bully", prerequisite: All([Any([ClassLevel(class: "monk", level: 5), BaseAttackBonus(9)]), Feat("pummeling-style"), Feat("trip")])),
    (key: "pummeling-charge", blueprint: "c5a39c8f1a2d6824ca565e6c1e4075a5", name: "Pummeling Charge", summary: "End a charge with a full attack or a Flurry of Blows.", category: UnarmedCombat, guide: "feats#pummeling-charge", prerequisite: All([Any([ClassLevel(class: "monk", level: 8), BaseAttackBonus(12)]), Feat("pummeling-style")])),
    (key: "pummeling-style", blueprint: "c36562b8e7ae12d408487ba8b532d966", name: "Pummeling Style", summary: "Damage reduction applies once to the combined damage of your unarmed hits on one foe, not to each hit.", category: UnarmedCombat, guide: "feats#pummeling-style", prerequisite: All([Any([Any([Feature(feature: "monk/flurry-of-blows", count: 1), Feature(feature: "monk/quarterstaff-master/flurry-of-blows-quarterstaff-master", count: 1), Feature(feature: "monk/sohei/flurry-of-blows-sohei", count: 1), Feature(feature: "monk/zen-archer/flurry-of-blows-zen-archer", count: 1)]), BaseAttackBonus(6)]), Feat("improved-unarmed-strike")])),
    (key: "raging-brutality", blueprint: "c002fad1506842abb2da5bcedacc358e", name: "Raging Brutality", summary: "While raging with Power Attack, a swift action adds your Con bonus (1.5x two-handed) to melee and thrown damage that turn, not on crits.", category: Class, guide: "feats#raging-brutality", prerequisite: All([Feat("power-attack"), AbilityScore(ability: Strength, score: 13), BaseAttackBonus(12)])),
    (key: "raking-claws", blueprint: "a1b262d2b1ef478994113fc941fa3a32", name: "Raking Claws", summary: "Natural attacks that pierce or slash leave the foe bleeding 1d6 per round.", category: Class, guide: "feats#raking-claws", prerequisite: All([Any([Any([Feature(feature: "druid/blight-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/defender-of-the-true-world/wild-shape-wolf", count: 1), Feature(feature: "druid/elemental-rampager/wild-shape-wolf", count: 1), Feature(feature: "druid/feyspeaker/wild-shape-wolf", count: 1), Feature(feature: "druid/primal-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/wild-shape-wolf", count: 1), Feature(feature: "warpriest/feral-champion/wild-shape-wolf", count: 1)]), Any([Feature(feature: "shifter/major-form", count: 1), Feature(feature: "shifter/wild-effigy/major-form", count: 1)])]), BaseAttackBonus(8)])),
    (key: "ranged-feint", blueprint: "a2e947d6be234abba7c3ac0bd5dc9b1d", name: "Ranged Feint", summary: "Feints work with ranged weapons too, removing the target's Dex bonus against your shots.", category: Ranged, guide: "feats#ranged-feint", prerequisite: Feat("feint")),
    (key: "rapid-shot", blueprint: "9c928dc570bb9e54a9649b3ebfe47a41", name: "Rapid Shot", summary: "Ranged full attacks gain an extra full-bonus attack, at the cost of -2 on every attack roll.", category: Ranged, guide: "feats#rapid-shot", prerequisite: All([Feat("point-blank-shot"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "ray-shield", blueprint: "e92cb7c4c900dcf4282def347af42b9c", name: "Ray Shield", summary: "Your touch AC includes your shield's base bonus (enhancement excluded).", category: ArmourAndShield, guide: "feats#ray-shield", prerequisite: All([Feat("missile-shield"), AbilityScore(ability: Dexterity, score: 15)])),
    (key: "razortusk", blueprint: "86af486a0d92427280c46127a216c85a", name: "Razortusk", summary: "Grants a secondary bite (1d4 + half Strength) attacking at your full BAB -5.", category: Racial, guide: "feats#razortusk", prerequisite: Race("half-orc")),
    (key: "scribe-scrolls", blueprint: "a8a385bf53ee3454593ce9054375a2ec", name: "Scribe Scrolls", summary: "Craft scrolls while camping.", category: Magic, guide: "feats#scribe-scrolls"),
    (key: "sculpting-the-river", blueprint: "57c3ea6b05da4226aaeeb21da04e82ea", name: "Sculpting the River", summary: "Each unarmed hit on a foe you already hurt this round gives it a stacking -1 to attack others, until it misses or your next turn.", category: UnarmedCombat, guide: "feats#sculpting-the-river", prerequisite: All([Any([ClassLevel(class: "monk", level: 6), BaseAttackBonus(6)]), Feat("dodge"), Feat("improved-unarmed-strike")])),
    (key: "seize-the-moment", blueprint: "1191ef3065e6f8e4f9fbe1b7e3c0f760", name: "Seize the Moment", summary: "Gives you an attack of opportunity whenever an ally with this feat crits a foe you threaten.", category: Teamwork, guide: "feats#seize-the-moment", prerequisite: Feat("combat-reflexes")),
    (key: "selective-channel", blueprint: "fd30c69417b434d47b6b03b9c1f568ff", name: "Selective Channel", summary: "Healing channels skip enemies and harming channels skip allies.", category: Class, guide: "feats#selective-channel", prerequisite: All([Any([Feature(feature: "cleric/channel-energy", count: 1), Feature(feature: "shaman/witch-doctor/channel-energy", count: 1), Feature(feature: "warpriest/channel-energy", count: 1), Feature(feature: "warpriest/shieldbearer/channel-energy-shieldbearer", count: 1), Feature(feature: "witch/hex-channeler/channel-energy", count: 1)]), AbilityScore(ability: Charisma, score: 13)])),
    (key: "shadowplay", blueprint: "caba7e4dc9b14206bbf667814cc1cb90", name: "Shadowplay", summary: "+2 caster level for shadow spells.", category: Racial, guide: "feats#shadowplay", prerequisite: Race("gnome")),
    (key: "shaitan-earthblast", blueprint: "204a749f60f443e29fbb9e8f6da0a14d", name: "Shaitan Earthblast", summary: "Spend two Elemental Fist uses for a 10 ft acid column within 30 ft: unarmed + fist damage and staggered 1 round, Reflex halves and negates.", category: UnarmedCombat, guide: "feats#shaitan-earthblast", prerequisite: All([Any([ClassLevel(class: "monk", level: 13), BaseAttackBonus(13)]), Feat("shaitan-skin"), AbilityScore(ability: Constitution, score: 15), AbilityScore(ability: Wisdom, score: 17)])),
    (key: "shaitan-skin", blueprint: "60d57680c3f64539b72423b3dbcd38cd", name: "Shaitan Skin", summary: "One more Elemental Fist a day; acid resistance equal to BAB in Shaitan Style; acid fists stagger 1 round (Reflex DC 10 + half level + Wis).", category: UnarmedCombat, guide: "feats#shaitan-skin", prerequisite: All([Any([ClassLevel(class: "monk", level: 9), BaseAttackBonus(11)]), Feat("shaitan-style"), AbilityScore(ability: Constitution, score: 15), AbilityScore(ability: Wisdom, score: 15)])),
    (key: "shaitan-style", blueprint: "c5e2aa13b1b6470d8ec70a962ddabdbd", name: "Shaitan Style", summary: "One more Elemental Fist a day; add Wis to acid damage, and an acid fist that misses still deals 1d6 acid.", category: UnarmedCombat, guide: "feats#shaitan-style", prerequisite: All([Any([ClassLevel(class: "monk", level: 5), BaseAttackBonus(9)]), Feat("elemental-fist"), Feat("improved-unarmed-strike"), AbilityScore(ability: Constitution, score: 13), AbilityScore(ability: Wisdom, score: 13)])),
    (key: "shake-it-off", blueprint: "6337b37f2a7c11b4ab0831d6780bce2a", name: "Shake It Off", summary: "+1 to saves for each adjacent ally with this feat, up to +4.", category: Teamwork, guide: "feats#shake-it-off"),
    (key: "shatter-defenses", blueprint: "61a17ccbbb3d79445b0926347ec07577", name: "Shatter Defenses", summary: "Shaken, frightened or panicked foes you hit count as flat-footed through your next turn.", category: Weapon, guide: "feats#shatter-defenses", prerequisite: All([Feat("dazzling-display"), Feat("weapon-focus"), BaseAttackBonus(6)])),
    (key: "shield-bash", blueprint: "121811173a614534e8720d7550aae253", name: "Shield Bash", summary: "Shields become weapons: 1d3 for a light shield, 1d4 for a heavy one, with two-weapon fighting penalties.", category: ArmourAndShield, guide: "feats#shield-bash", prerequisite: Feat("shield-proficiency")),
    (key: "shield-focus", blueprint: "ac57069b6bf8c904086171683992a92a", name: "Shield Focus", summary: "+1 AC from your shield.", category: ArmourAndShield, guide: "feats#shield-focus", prerequisite: Feat("shield-proficiency")),
    (key: "shield-master", blueprint: "dbec636d84482944f87435bd31522fcc", name: "Shield Master", summary: "The shield's enhancement bonus counts for its attack and damage rolls, which also lose their penalties.", category: ArmourAndShield, guide: "feats#shield-master", prerequisite: All([Feat("shield-bash"), Feat("two-weapon-fighting"), BaseAttackBonus(11)])),
    (key: "shield-proficiency", blueprint: "cb8686e7357a68c42bdd9d4e65334633", name: "Shield Proficiency", summary: "Heavy shields, light shields and bucklers can be used proficiently.", category: ArmourAndShield, guide: "feats#shield-proficiency"),
    (key: "shield-wall", blueprint: "8976de442862f82488a4b138a0a89907", name: "Shield Wall", summary: "With a shield next to an ally who has this feat, your shield AC rises by +1 (ally's buckler or light shield) or +2 (heavy or tower).", category: Teamwork, guide: "feats#shield-wall", prerequisite: Feat("shield-proficiency")),
    (key: "shielded-caster", blueprint: "0b707584fc2ea724aa72c396c2230dc7", name: "Shielded Caster", summary: "Next to an ally with this feat, +4 to concentration checks, +5 if it has a buckler or light shield and +6 with a heavy or tower shield.", category: Teamwork, guide: "feats#shielded-caster"),
    (key: "shifters-edge", blueprint: "0e7ec9a341ca46fcaf4d49759e047c83", name: "Shifter\'s Edge", summary: "Adds half your class level to damage on attacks that use Dex to hit but not Dex for damage; can't be combined with Mythic Finesse.", category: Class, guide: "feats#shifters-edge", prerequisite: All([Any([Feature(feature: "shifter/dragonblood-shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/dragonblood-shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/feyform-shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/fiendflesh-shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/griffonheart-shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/shifter-claws", count: 1), Feature(feature: "shifter/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/shifter-claws-1d10", count: 1), Feature(feature: "shifter/shifter-claws-1d6", count: 1), Feature(feature: "shifter/shifter-claws-1d8", count: 1), Feature(feature: "shifter/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-1d10", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-1d6", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-1d8", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/weretouched/shifter-claws-cold-iron-magic-and-silver", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-1-crit-multiplier", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-1d10", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-1d6", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-1d8", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-adamantine-and-universal", count: 1), Feature(feature: "shifter/wild-effigy/shifter-claws-cold-iron-magic-and-silver", count: 1)]), Feat("weapon-finesse"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "shifters-multiattack", blueprint: "b5d998bd85a74b708516e24fa198874e", name: "Shifter\'s Multiattack", summary: "Secondary natural attacks take -2 instead of -5.", category: Class, guide: "feats#shifters-multiattack", prerequisite: ClassLevel(class: "shifter", level: 6)),
    (key: "shifters-rush", blueprint: "4ddc88f422a84f76a952e24bec7b53e1", name: "Shifter\'s Rush", summary: "Wild shape is a free action when you charge or move more than 10 ft in a round.", category: Class, guide: "feats#shifters-rush", prerequisite: Any([Any([Feature(feature: "druid/blight-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/defender-of-the-true-world/wild-shape-wolf", count: 1), Feature(feature: "druid/elemental-rampager/wild-shape-wolf", count: 1), Feature(feature: "druid/feyspeaker/wild-shape-wolf", count: 1), Feature(feature: "druid/primal-druid/wild-shape-wolf", count: 1), Feature(feature: "druid/wild-shape-wolf", count: 1), Feature(feature: "warpriest/feral-champion/wild-shape-wolf", count: 1)]), Any([Feature(feature: "shifter/major-form", count: 1), Feature(feature: "shifter/wild-effigy/major-form", count: 1)])])),
    (key: "sickening-critical", blueprint: "4c7205d859a1e114895e798af383d76a", name: "Sickening Critical", summary: "Your critical hits sicken the target for 1 minute, extended by further crits.", category: Weapon, guide: "feats#sickening-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(11)])),
    (key: "simple-weapon-proficiency", blueprint: "e70ecf1ed95ca2f40b754f1adb22bbdd", name: "Simple Weapon Proficiency", summary: "Proficiency with all simple weapons, such as the club, dagger, crossbows, maces, quarterstaff and spears.", category: Weapon, guide: "feats#simple-weapon-proficiency"),
    (key: "skill-focus", blueprint: "c9629ef9eebb88b479b2fbc5e836656a", name: "Skill Focus", summary: "+3 to one skill, or +6 with 10 or more ranks in it.", category: Skill, guide: "feats#skill-focus", parameter: Skill, repeat: PerValue),
    (key: "slashing-grace", blueprint: "697d64669eb2c0543abb9c9b07998a38", name: "Slashing Grace", summary: "Add Dex to damage with a Weapon Focus one-handed slashing weapon, without shield, off-hand weapon or flurry; it counts as piercing for Duelist.", category: Weapon, guide: "feats#slashing-grace", prerequisite: All([Feat("weapon-finesse"), Feat("weapon-focus"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "slayers-feint", blueprint: "39425a13df904e3cb0e3f6debfe65cab", name: "Slayer\'s Feint", summary: "Feint with Mobility instead of Persuasion.", category: Weapon, guide: "feats#slayers-feint", prerequisite: All([Any([FeatFor(feat: "skill-focus", value: Skill("mobility")), Feature(feature: "slayer/slayer-proficiencies", count: 1)]), Feat("combat-expertise"), Feat("feint"), AbilityScore(ability: Dexterity, score: 15)])),
    (key: "snap-shot", blueprint: "7115a6c08bd101247b70d72a4ff99453", name: "Snap Shot", summary: "Lets a ranged weapon threaten the squares in your melee reach, so it can take attacks of opportunity.", category: Ranged, guide: "feats#snap-shot", prerequisite: All([Feat("point-blank-shot"), Feat("precise-shot"), BaseAttackBonus(6)])),
    (key: "spell-chain", blueprint: "d8d641edc9a74a64809f56feff9495b6", name: "Spell Chain", summary: "Beating a foe's spell resistance lets the next ally who also has this feat roll that foe's SR check twice, keeping the higher roll.", category: Teamwork, guide: "feats#spell-chain"),
    (key: "spell-focus", blueprint: "16fa59cc9a72a6043b566b49184f53fe", name: "Spell Focus", summary: "+1 to the save DCs of spells from the chosen school.", category: Magic, guide: "feats#spell-focus", parameter: SpellSchool, repeat: PerValue),
    (key: "spell-penetration", blueprint: "ee7dc126939e4d9438357fbd5980d459", name: "Spell Penetration", summary: "+2 to caster level checks against spell resistance.", category: Magic, guide: "feats#spell-penetration"),
    (key: "spell-specialization", blueprint: "f327a765a4353d04f872482ef3e48c35", name: "Spell Specialization", summary: "For one chosen spell from a Spell Focus school, level-based effects use caster level +2; you may switch spells each time your caster level rises.", category: Magic, guide: "feats#spell-specialization", prerequisite: Feat("spell-focus")),
    (key: "spirited-charge", blueprint: "95ef0ff14771f2549897f300ce62c95c", name: "Spirited Charge", summary: "Double melee damage on a mounted charge.", category: MountedCombat, guide: "feats#spirited-charge", prerequisite: Feat("mounted-combat")),
    (key: "staggering-critical", blueprint: "055fb8dcaf6be334ca13172bafa9e782", name: "Staggering Critical", summary: "Crits stagger the target for 2 to 5 rounds, or just 1 round if it passes a Fort save (DC 10 + your BAB); more crits extend it.", category: Weapon, guide: "feats#staggering-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(13)])),
    (key: "stat-focus", blueprint: "0d1d80bd3820a78488412581da3ad9c7", name: "Stat Focus", summary: "+1 mythic bonus to a stat of your choice: AC, attack, attacks of opportunity, CMB, CMD, damage, HP, initiative, Fortitude, Reflex, Will or speed.", category: Miscellaneous, guide: "trickster#stat-focus", parameter: Stat, repeat: PerValue, prerequisite: SelectionOption("trickster/improved-mythic-trick/perception-ii")),
    (key: "stealthy", blueprint: "c7e1d5ef809325943af97f093e149c4f", name: "Stealthy", summary: "+2 to Mobility and Stealth, or +4 for a skill with 10 or more ranks.", category: Skill, guide: "feats#stealthy"),
    (key: "steel-soul", blueprint: "8bc16857824564d4e9400bbfcdd957fb", name: "Steel Soul", summary: "+4 to saves against spells and spell-like abilities, replacing Hardy's +2.", category: Racial, guide: "feats#steel-soul", prerequisite: Race("dwarf")),
    (key: "stony-step", blueprint: "c542b083d72f19944a4c6bdf640fc099", name: "Stony Step", summary: "+2 Mobility, and you ignore difficult terrain underground.", category: Racial, guide: "feats#stony-step", prerequisite: Race("oread")),
    (key: "stumbling-bash", blueprint: "1fc8c07a82d749a1a35b6992ad359788", name: "Stumbling Bash", summary: "Shield bash hits leave the target at -2 AC for 1 round.", category: ArmourAndShield, guide: "feats#stumbling-bash", prerequisite: All([Any([ClassLevel(class: "fighter", level: 4), BaseAttackBonus(6)]), Feat("shield-bash"), Feat("shield-focus")])),
    (key: "stunning-critical", blueprint: "7fb3023bda2f42728e76cf269f5a2fa0", name: "Stunning Critical", summary: "Your crits stun the target 1d4 rounds, or stagger it 1d4 rounds on a Fort save (DC 10 + your BAB); further crits add duration.", category: Weapon, guide: "feats#stunning-critical", prerequisite: All([Feat("critical-focus"), Feat("staggering-critical"), BaseAttackBonus(17)])),
    (key: "stunning-fist", blueprint: "a29a582c3daa4c24bb0e991c596ccb28", name: "Stunning Fist", summary: "Once a day per 4 levels (once a round), a hit stuns 1 round, with no Dex to AC and -2 more AC (Fort DC 10 + half level + Wis).", category: UnarmedCombat, guide: "feats#stunning-fist", prerequisite: Feat("improved-unarmed-strike")),
    (key: "sunder-armor", blueprint: "9719015edcbf142409592e2cbaab7fe1", name: "Sunder Armor", summary: "A foe you sunder loses its armour bonuses for 1 round (+1 per 5 over its CMD); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#sunder-armor", prerequisite: Feat("power-attack")),
    (key: "superior-summoning", blueprint: "0477936c0f74841498b5c8753a8062a3", name: "Superior Summoning", summary: "Multi-creature summons bring one extra creature of that kind.", category: Magic, guide: "feats#superior-summoning", prerequisite: Feat("augment-summoning")),
    (key: "tandem-trip", blueprint: "d26eb8ab2aabd0e45a4d7eec0340bbce", name: "Tandem Trip", summary: "Roll trips twice and keep the better result whenever an ally with this feat is beside you.", category: Teamwork, guide: "feats#tandem-trip", prerequisite: Feat("trip")),
    (key: "throw-anything", blueprint: "65c538dcfd91930489ad3ab18ad9204b", name: "Throw Anything", summary: "+1 to attack with thrown splash weapons.", category: Ranged, guide: "feats#throw-anything"),
    (key: "tiring-critical", blueprint: "12c1b556df3b667458ae200bfb38ccb8", name: "Tiring Critical", summary: "Your critical hits leave the target fatigued.", category: Weapon, guide: "feats#tiring-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(13)])),
    (key: "toppling-bash", blueprint: "cc198d726ac34b4599bd1b4d22a7f2b7", name: "Toppling Bash", summary: "Once a round, after a shield bash hit, make a trip attempt at -5 that doesn't provoke.", category: ArmourAndShield, guide: "feats#toppling-bash", prerequisite: All([Any([ClassLevel(class: "fighter", level: 8), BaseAttackBonus(11)]), Feat("shield-bash"), Feat("shield-focus"), Feat("stumbling-bash")])),
    (key: "toughness", blueprint: "d09b20029e9abfe4480b356c92095623", name: "Toughness", summary: "+3 HP, plus 1 HP per character level above 3rd.", category: Miscellaneous, guide: "feats#toughness"),
    (key: "tower-shield-proficiency", blueprint: "6105f450bb2acbd458d277e71e19d835", name: "Tower Shield Proficiency", summary: "Proficiency with tower shields.", category: ArmourAndShield, guide: "feats#tower-shield-proficiency", prerequisite: Feat("shield-proficiency")),
    (key: "trample", blueprint: "92db263bfb7445d4aa592a5d15128fc5", name: "Trample", summary: "Trample foes while mounted; a trampled foe is knocked prone and takes damage as from one of your mount's natural attacks.", category: MountedCombat, guide: "feats#trample", prerequisite: Feat("mounted-combat")),
    (key: "trip", blueprint: "0f15c6f70d8fb2b49aa6cc24239cc5fa", name: "Trip", summary: "Instead of a melee attack, knock a foe prone (harder per extra leg; not fliers or legless); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#trip", prerequisite: Any([All([Feature(feature: "kineticist/kinetic-knight/kinetic-warrior", count: 1), AbilityScore(ability: Intelligence, score: 13)]), Feat("combat-expertise")])),
    (key: "two-weapon-feint", blueprint: "92c7e14b4da24549a9219e990b30d723", name: "Two-Weapon Feint", summary: "While two-weapon fighting, trade your first main-hand attack for a Persuasion (Bluff) feint against a foe.", category: Weapon, guide: "feats#two-weapon-feint", prerequisite: All([Feat("feint"), Feat("two-weapon-fighting"), AbilityScore(ability: Dexterity, score: 15)])),
    (key: "two-weapon-fighting", blueprint: "ac8aaf29054f5b74eb18f2af950e752d", name: "Two-Weapon Fighting", summary: "Two-weapon penalties drop to -4/-4, or -2/-2 with a light off-hand weapon.", category: Weapon, guide: "feats#two-weapon-fighting", prerequisite: AbilityScore(ability: Dexterity, score: 15)),
    (key: "vital-strike", blueprint: "14a1fc1356df9f146900e1e42142fc9d", name: "Vital Strike", summary: "Standard action: one attack at your highest bonus that rolls the weapon's damage twice; flat bonuses are added once.", category: Weapon, guide: "feats#vital-strike", prerequisite: BaseAttackBonus(6)),
    (key: "volley-fire", blueprint: "c4b555225f565bb40a855c1bfeeff07e", name: "Volley Fire", summary: "+1 to ranged attacks for each ally with this feat who shot at a foe within 15 ft of your target since your last turn, up to +4.", category: Teamwork, guide: "feats#volley-fire", prerequisite: Feat("point-blank-shot")),
    (key: "vulpine-pounce", blueprint: "cd258f1bce80ef54580f6b236c82608c", name: "Vulpine Pounce", summary: "Pounce while in kitsune form.", category: Racial, guide: "feats#vulpine-pounce", prerequisite: All([BaseAttackBonus(10), Race("kitsune")])),
    (key: "warrior-priest", blueprint: "b9bee4e4e15573546b76a8d942ce914b", name: "Warrior Priest", summary: "+1 to initiative and +2 to concentration checks.", category: Class, guide: "feats#warrior-priest", prerequisite: SpellLevel(spell_type: Divine, level: 1)),
    (key: "weapon-finesse", blueprint: "90e54424d682d104ab36436bd527af09", name: "Weapon Finesse", summary: "Use Dex instead of Str for attack rolls (not damage) with light and finesse weapons such as the dagger, rapier, dueling sword and estoc.", category: Weapon, guide: "feats#weapon-finesse"),
    (key: "weapon-focus", blueprint: "1e1f627d26ad36f43bbd26cc2bf8ac7e", name: "Weapon Focus", summary: "+1 to attack with one weapon (or unarmed strike, natural weapons, touch attacks or rays); repeatable for other weapons.", category: Weapon, guide: "feats#weapon-focus", parameter: Weapon, requires_proficiency: true, repeat: PerValue, prerequisite: BaseAttackBonus(1)),
    (key: "weapon-specialization", blueprint: "31470b17e8446ae4ea0dacd6c5817d86", name: "Weapon Specialization", summary: "+2 damage with a weapon you have Weapon Focus in.", category: Weapon, guide: "feats#weapon-specialization", parameter: Weapon, requires_proficiency: true, repeat: PerValue, prerequisite: All([FeatForSameValue("weapon-focus"), ClassLevel(class: "fighter", level: 4)])),
    (key: "wings", blueprint: "d9bd0fde6deb2e44a93268f2dfb3e169", name: "Wings", summary: "Wings that make you immune to ground-based effects and give +3 dodge AC versus melee.", category: Racial, guide: "feats#wings", prerequisite: All([CharacterLevel(10), Race("aasimar")])),
]
