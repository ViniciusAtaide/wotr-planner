[
    (key: "ability-focus-bombs", name: "Ability Focus - Bombs", summary: "+2 to the save DCs of your bombs.", category: Class, guide: "feats#ability-focus-bombs", prerequisite: Any([Any([Feature(feature: "alchemist/bomb", count: 1), Feature(feature: "alchemist/reanimator/bomb-reanimator", count: 1)]), Feature(feature: "wizard/arcane-bomber/arcane-bombs", count: 1)])),
    (key: "accomplished-sneak-attacker", name: "Accomplished Sneak Attacker", summary: "Sneak attack gains a die (1d6), up to a cap of half your character level in dice.", category: Class, guide: "feats#accomplished-sneak-attacker", prerequisite: Any([Feature(feature: "alchemist/vivisectionist/sneak-attack", count: 1), Feature(feature: "arcane-trickster/sneak-attack", count: 1), Feature(feature: "assassin/sneak-attack", count: 1), Feature(feature: "inquisitor/sanctified-slayer/sneak-attack", count: 1), Feature(feature: "paladin/divine-scion/sneak-attack", count: 1), Feature(feature: "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel", count: 1), Feature(feature: "rogue/master-of-all/sneak-attack-master-of-all", count: 1), Feature(feature: "rogue/sneak-attack", count: 1), Feature(feature: "shaman/shadow-shaman/sneak-attack", count: 1), Feature(feature: "skald/inciter/sneak-attack", count: 1), Feature(feature: "slayer/imitator/sneak-attack-imitator", count: 1), Feature(feature: "slayer/sneak-attack", count: 1), Feature(feature: "trickster/sneak-attack", count: 1), Feature(feature: "warpriest/cult-leader/sneak-attack", count: 1)])),
    (key: "acrobatic-spellcaster", name: "Acrobatic Spellcaster", summary: "Lets a Mobility check prevent the attack of opportunity you'd provoke by botching a defensive-casting concentration check.", category: Magic, guide: "feats#acrobatic-spellcaster", prerequisite: All([Feat("combat-casting"), FeatFor(feat: "skill-focus", value: Skill("mobility"))])),
    (key: "advanced-weapon-training", name: "Advanced Weapon Training", summary: "Pick one Weapon Training option: Armed Bravery, CMD, Effortless Dual Wielding, Fighter's Finesse, Reflexes or Tactics, or Trained Initiative.", category: Weapon, guide: "feats#advanced-weapon-training", prerequisite: All([Any([Feature(feature: "cavalier/disciple-of-the-pike/weapon-training-spears-polearms", count: 1), Feature(feature: "fighter/weapon-training", count: 1), Feature(feature: "monk/sohei/weapon-training", count: 1)]), ClassLevel(class: "fighter", level: 5)])),
    (key: "agile-maneuvers", name: "Agile Maneuvers", summary: "Your CMB is based on Dexterity rather than Strength.", category: CombatManoeuvres, guide: "feats#agile-maneuvers", prerequisite: Any([Feat("bull-rush"), Feat("dirty-trick"), Feat("sunder-armor"), Feat("trip")])),
    (key: "aldori-dueling-mastery", name: "Aldori Dueling Mastery", summary: "With a dueling sword: +2 initiative and +2 shield AC without a shield or off-hand weapon; it counts as piercing for Duelist abilities.", category: Weapon, guide: "feats#aldori-dueling-mastery", prerequisite: All([Feat("weapon-finesse"), FeatFor(feat: "weapon-focus", value: Weapon("dueling-sword")), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "alertness", name: "Alertness", summary: "+2 to Perception, or +4 with 10 or more ranks.", category: Skill, guide: "feats#alertness"),
    (key: "allied-spellcaster", name: "Allied Spellcaster", summary: "Next to an ally with this feat: +2 to concentration checks and caster level checks against spell resistance.", category: Teamwork, guide: "feats#allied-spellcaster"),
    (key: "ambuscading-spells", name: "Ambuscading Spells", summary: "Your spells are harder to resist for flat-footed foes: -2 on their saves.", category: Magic, guide: "feats#ambuscading-spells"),
    (key: "arcane-armor-mastery", name: "Arcane Armor Mastery", summary: "Cuts arcane spell failure from armour by another 10% (20% with Arcane Armor Training).", category: Magic, guide: "feats#arcane-armor-mastery", prerequisite: Feat("arcane-armor-training")),
    (key: "arcane-armor-training", name: "Arcane Armor Training", summary: "Cuts arcane spell failure from armour by 10%.", category: Magic, guide: "feats#arcane-armor-training"),
    (key: "arcane-focus", name: "Arcane Focus", summary: "Casting defensively gets +2 concentration, and beating spell resistance gets +1 caster level.", category: Racial, guide: "feats#arcane-focus", prerequisite: Race("elf")),
    (key: "arcane-spirit", name: "Arcane Spirit", summary: "Swift action: a Persuasion (Bluff) check vs a creature's Perception within 30 ft gives it -2 on saves against your next spell.", category: Magic, guide: "feats#arcane-spirit"),
    (key: "arcane-strike", name: "Arcane Strike", summary: "A swift action grants your weapons +1 damage and magic status for a round; the bonus rises by 1 per 5 caster levels, reaching +5.", category: Magic, guide: "feats#arcane-strike", prerequisite: SpellLevel(spell_type: Arcane, level: 1)),
    (key: "armor-focus", name: "Armor Focus", summary: "+1 AC while wearing the chosen armour type (light, medium or heavy).", category: ArmourAndShield, guide: "feats#armor-focus", parameter: ArmourType, repeat: PerValue, prerequisite: All([FeatIfValue(value: ArmourType(Light), feat: "armor-proficiency-light-armor"), FeatIfValue(value: ArmourType(Medium), feat: "armor-proficiency-medium-armor"), FeatIfValue(value: ArmourType(Heavy), feat: "armor-proficiency-heavy-armor"), BaseAttackBonus(1)])),
    (key: "armor-proficiency-heavy-armor", name: "Armor Proficiency (Heavy Armor)", summary: "Proficiency with heavy armour.", category: ArmourAndShield, guide: "feats#armor-proficiency-heavy-armor", prerequisite: Feat("armor-proficiency-medium-armor")),
    (key: "armor-proficiency-heavy-barding", name: "Armor Proficiency (Heavy Barding)", summary: "Your animal companion gains heavy barding proficiency.", category: ArmourAndShield, guide: "feats#armor-proficiency-heavy-barding", prerequisite: Feat("armor-proficiency-medium-barding")),
    (key: "armor-proficiency-light-armor", name: "Armor Proficiency (Light Armor)", summary: "Proficiency with light armour.", category: ArmourAndShield, guide: "feats#armor-proficiency-light-armor"),
    (key: "armor-proficiency-light-barding", name: "Armor Proficiency (Light Barding)", summary: "Your animal companion gains light barding proficiency.", category: ArmourAndShield, guide: "feats#armor-proficiency-light-barding"),
    (key: "armor-proficiency-medium-armor", name: "Armor Proficiency (Medium Armor)", summary: "Proficiency with medium armour.", category: ArmourAndShield, guide: "feats#armor-proficiency-medium-armor", prerequisite: Feat("armor-proficiency-light-armor")),
    (key: "armor-proficiency-medium-barding", name: "Armor Proficiency (Medium Barding)", summary: "Your animal companion gains medium barding proficiency.", category: ArmourAndShield, guide: "feats#armor-proficiency-medium-barding", prerequisite: Feat("armor-proficiency-light-barding")),
    (key: "augment-summoning", name: "Augment Summoning", summary: "Creatures you summon arrive with +4 enhancement to Strength and Constitution.", category: Magic, guide: "feats#augment-summoning", prerequisite: FeatFor(feat: "spell-focus", value: SpellSchool(Conjuration))),
    (key: "back-to-back", name: "Back to Back", summary: "+2 AC against the foes flanking you, as long as an ally with this feat stands beside you.", category: Teamwork, guide: "feats#back-to-back", prerequisite: SkillRanks(skill: "perception", ranks: 3)),
    (key: "bashing-finish", name: "Bashing Finish", summary: "A free shield bash at the same attack bonus follows each of your melee crits on that target.", category: ArmourAndShield, guide: "feats#bashing-finish", prerequisite: Feat("shield-master")),
    (key: "blind-fight", name: "Blind Fight", summary: "Reroll concealment misses; invisible attackers get no melee advantage against you; immunity to gaze attacks.", category: Miscellaneous, guide: "feats#blind-fight"),
    (key: "blinding-critical", name: "Blinding Critical", summary: "Your critical hits blind the target, or dazzle it for 1d4 rounds if it makes a Fort save (DC 10 + your BAB).", category: Weapon, guide: "feats#blinding-critical", prerequisite: All([Feat("critical-focus"), BaseAttackBonus(15)])),
    (key: "blood-drinker", name: "Blood Drinker", summary: "Three times a day, drink from a helpless or dead living creature for +1 Fortitude and 5 temp HP, +5 per 3 HD, for 1 hour.", category: Racial, guide: "feats#blood-drinker", prerequisite: Race("dhampir")),
    (key: "blood-feaster", name: "Blood Feaster", summary: "For half your HD in rounds after feeding with Blood Drinker, +2 damage and +1 Athletics.", category: Racial, guide: "feats#blood-feaster", prerequisite: Feat("blood-drinker")),
    (key: "boar-ferocity", name: "Boar Ferocity", summary: "Unarmed strikes add piercing damage; demoralising gets +2 and is a free action after you tear a foe's flesh.", category: UnarmedCombat, guide: "feats#boar-ferocity", prerequisite: All([Feat("boar-style"), SkillRanks(skill: "persuasion", ranks: 6)])),
    (key: "boar-shred", name: "Boar Shred", summary: "Tearing flesh adds 1d6 bleed per round, and demoralising takes only a move action.", category: UnarmedCombat, guide: "feats#boar-shred", prerequisite: All([Feat("boar-ferocity"), SkillRanks(skill: "persuasion", ranks: 9)])),
    (key: "boar-style", name: "Boar Style", summary: "Two or more unarmed hits on one foe in a round add +2d6 once; your unarmed strikes also slash as well as bludgeon.", category: UnarmedCombat, guide: "feats#boar-style", prerequisite: All([Feat("improved-unarmed-strike"), SkillRanks(skill: "persuasion", ranks: 3)])),
    (key: "boon-companion", name: "Boon Companion", summary: "Your animal companion advances as if your class level were 4 higher, never above your character level.", category: Class, guide: "feats#boon-companion", prerequisite: Any([Feature(feature: "barbarian/mad-dog/animal-companion", count: 1), Feature(feature: "cavalier/animal-companion", count: 1), Feature(feature: "cavalier/beast-rider/animal-companion-beast-rider", count: 1), Feature(feature: "cavalier/standard-bearer/animal-companion-standard-bearer", count: 1), Feature(feature: "cleric/domain/animal/animal-companion", count: 1), Feature(feature: "cleric/domain/scalykind/animal-companion", count: 1), Feature(feature: "druid/drovier/animal-companion", count: 1), Feature(feature: "druid/primal-druid/animal-companion-primal-druid", count: 1), Feature(feature: "hunter/animal-companion", count: 1), Feature(feature: "hunter/divine-hound/animal-companion-divine-hound", count: 1), Feature(feature: "hunter/urban-hunter/animal-companion-urban-hunter", count: 1), Feature(feature: "inquisitor/sacred-huntsmaster/animal-companion", count: 1), Feature(feature: "ranger/nomad/animal-companion", count: 1), Feature(feature: "shaman/wildland-shaman/animal-companion", count: 1), Feature(feature: "sorcerer/sylvan-sorcerer/animal-companion", count: 1), SelectionOption("druid/nature-bond/animal-companion"), SelectionOption("oracle/revelations/nature/animal-companion")])),
    (key: "breadth-of-experience", name: "Breadth of Experience", summary: "Knowledge and Lore checks all get +2.", category: Racial, guide: "feats#breadth-of-experience", prerequisite: Any([Race("dwarf"), Race("elf"), Race("gnome")])),
    (key: "brew-potions", name: "Brew Potions", summary: "While camping, make potions of spells of 3rd level or lower.", category: Magic, guide: "feats#brew-potions"),
    (key: "bull-rush", name: "Bull Rush", summary: "Push a foe 5 ft (+5 ft per 5 you beat its CMD by); +2 CMB to bull rush and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#bull-rush", prerequisite: Feat("power-attack")),
    (key: "cautious-fighter", name: "Cautious Fighter", summary: "Fighting defensively gives 2 more dodge AC.", category: Racial, guide: "feats#cautious-fighter", prerequisite: Race("halfling")),
    (key: "cleave", name: "Cleave", summary: "A standard-action attack that, if it hits, gives a second full-bonus attack on an adjacent foe; you take -2 AC until your next turn.", category: Weapon, guide: "feats#cleave", prerequisite: Feat("power-attack")),
    (key: "cleaving-finish", name: "Cleaving Finish", summary: "Once a round, when you drop a foe to 0 HP, make another attack at full bonus against a foe in reach.", category: Weapon, guide: "feats#cleaving-finish", prerequisite: Feat("cleave")),
    (key: "clustered-shots", name: "Clustered Shots", summary: "Damage reduction applies once to the combined damage of your ranged hits on one foe each round, not to each hit.", category: Ranged, guide: "feats#clustered-shots", prerequisite: All([Feat("point-blank-shot"), Feat("precise-shot"), BaseAttackBonus(6)])),
    (key: "combat-casting", name: "Combat Casting", summary: "+4 to concentration checks to cast spells or use spell-like abilities.", category: Magic, guide: "feats#combat-casting"),
    (key: "combat-expertise", name: "Combat Expertise", summary: "Take -1 to melee attacks and manoeuvre checks for +1 dodge AC; both grow by 1 at BAB 4 and every 4 after.", category: Miscellaneous, guide: "feats#combat-expertise", prerequisite: AbilityScore(ability: Intelligence, score: 13)),
    (key: "combat-mobility", name: "Combat Mobility", summary: "Moving through or out of threatened squares: +4 dodge AC against the attacks of opportunity, unless you're denied Dex.", category: Miscellaneous, guide: "feats#combat-mobility", prerequisite: Feat("dodge")),
    (key: "combat-reflexes", name: "Combat Reflexes", summary: "Your Dex bonus adds that many attacks of opportunity per round, and being flat-footed doesn't stop them.", category: Miscellaneous, guide: "feats#combat-reflexes"),
    (key: "coordinated-defense", name: "Coordinated Defense", summary: "Next to an ally with this feat: +2 CMD, or +4 against a creature larger than both of you.", category: Teamwork, guide: "feats#coordinated-defense"),
    (key: "coordinated-maneuvers", name: "Coordinated Maneuvers", summary: "Next to an ally with this feat: +2 to combat manoeuvre checks, or +4 to break free of a grapple.", category: Teamwork, guide: "feats#coordinated-maneuvers"),
    (key: "cornugon-smash", name: "Cornugon Smash", summary: "Free demoralise (Persuasion) against any foe your Power Attack damages.", category: Weapon, guide: "feats#cornugon-smash", prerequisite: All([Feat("power-attack"), SkillRanks(skill: "persuasion", ranks: 6)])),
    (key: "crane-riposte", name: "Crane Riposte", summary: "Fighting defensively costs only -1 to attack; a foe whose near miss ends your Crane Wing bonus provokes an attack of opportunity.", category: UnarmedCombat, guide: "feats#crane-riposte", prerequisite: All([Any([ClassLevel(class: "monk", level: 7), BaseAttackBonus(8)]), Feat("crane-wing")])),
    (key: "crane-style", name: "Crane Style", summary: "Lowers the fighting-defensively attack penalty to -2 and adds 1 more dodge AC.", category: UnarmedCombat, guide: "feats#crane-style", prerequisite: All([Any([ClassLevel(class: "monk", level: 1), BaseAttackBonus(2)]), Feat("dodge"), Feat("improved-unarmed-strike")])),
    (key: "crane-wing", name: "Crane Wing", summary: "Fighting defensively with a free off hand: +4 dodge AC against melee, lost until your next turn when an attack misses by 4 or less.", category: UnarmedCombat, guide: "feats#crane-wing", prerequisite: All([Any([ClassLevel(class: "monk", level: 5), BaseAttackBonus(5)]), Feat("crane-style"), Feat("dodge")])),
    (key: "critical-focus", name: "Critical Focus", summary: "+4 to attack rolls that confirm critical hits.", category: Weapon, guide: "feats#critical-focus", prerequisite: BaseAttackBonus(9)),
    (key: "critical-mastery", name: "Critical Mastery", summary: "Your critical hits apply two of your critical feats' effects at once.", category: Weapon, guide: "feats#critical-mastery", prerequisite: All([AtLeast(2, [Feat("blinding-critical"), Feat("exhausting-critical"), Feat("flaying-critical"), Feat("sickening-critical"), Feat("staggering-critical"), Feat("stunning-critical"), Feat("tiring-critical")]), Feat("critical-focus"), ClassLevel(class: "fighter", level: 14)])),
    (key: "crushing-blow", name: "Crushing Blow", summary: "A full-round Stunning Fist variant: success lowers the target's AC by your Wisdom modifier for 1 minute.", category: UnarmedCombat, guide: "feats#crushing-blow", prerequisite: Any([Feat("stunning-fist"), Feature(feature: "monk/stunning-fist", count: 1)])),
    (key: "dazzling-display", name: "Dazzling Display", summary: "Try to demoralise everyone hostile within 30 ft at once, using Persuasion and a full-round action.", category: Weapon, guide: "feats#dazzling-display", prerequisite: Feat("weapon-focus")),
    (key: "deadly-aim", name: "Deadly Aim", summary: "Take -1 to ranged attacks for +2 ranged damage (not ranged touch); both grow at BAB 8 and every 4 after.", category: Ranged, guide: "feats#deadly-aim", prerequisite: All([AbilityScore(ability: Dexterity, score: 13), BaseAttackBonus(1)])),
    (key: "deceitful", name: "Deceitful", summary: "+2 to Persuasion and Trickery, or +4 for a skill with 10 or more ranks.", category: Skill, guide: "feats#deceitful"),
    (key: "defensive-combat-training", name: "Defensive Combat Training", summary: "Use your character level instead of your BAB for your CMD.", category: CombatManoeuvres, guide: "feats#defensive-combat-training"),
    (key: "deflect-arrows", name: "Deflect Arrows", summary: "Once a round, with a hand free, a ranged attack that would hit you is deflected at no action cost.", category: UnarmedCombat, guide: "feats#deflect-arrows", prerequisite: All([Feat("improved-unarmed-strike"), AbilityScore(ability: Dexterity, score: 13)])),
    (key: "deft-hands", name: "Deft Hands", summary: "+2 to Trickery and Use Magic Device, or +4 for a skill with 10 or more ranks.", category: Skill, guide: "feats#deft-hands"),
    (key: "destructive-dispel", name: "Destructive Dispel", summary: "A foe you dispel with a targeted dispel is stunned until your next turn (Fort DC 10 + half CL + casting stat), or sickened 1 round on a save.", category: Magic, guide: "feats#destructive-dispel"),
    (key: "diehard", name: "Diehard", summary: "Dropping below 0 HP (but not dead) leaves you disabled but fighting for 1 more round; unless healed above 0, you then pass out.", category: Miscellaneous, guide: "feats#diehard"),
    (key: "dirty-trick", name: "Dirty Trick", summary: "Standard action: blind, entangle or sicken a foe for 1 round (+1 per 5 over its CMD); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#dirty-trick", prerequisite: Any([All([Feature(feature: "kineticist/kinetic-knight/kinetic-warrior", count: 1), AbilityScore(ability: Intelligence, score: 13)]), Feat("combat-expertise")])),
    (key: "disarm", name: "Disarm", summary: "Standard action: a foe can't use its weapon for 1 round (+1 per 5 over its CMD); +2 CMB for it and +2 CMD against it.", category: CombatManoeuvres, guide: "feats#disarm", prerequisite: Any([All([Feature(feature: "kineticist/kinetic-knight/kinetic-warrior", count: 1), AbilityScore(ability: Intelligence, score: 13)]), Feat("combat-expertise")])),
    (key: "disarming-strike", name: "Disarming Strike", summary: "Confirmation rolls on melee crits that beat the foe's CMD also disarm it.", category: CombatManoeuvres, guide: "feats#disarming-strike", prerequisite: All([Feat("disarm"), BaseAttackBonus(9)])),
    (key: "discerning-eye", name: "Discerning Eye", summary: "+2 to saves against illusions and +2 to Use Magic Device.", category: Racial, guide: "feats#discerning-eye", prerequisite: Any([Race("elf"), Race("half-elf")])),
    (key: "discordant-voice", name: "Discordant Voice", summary: "Your bardic performances give allies' weapon attacks an extra 1d6 sonic damage.", category: Class, guide: "feats#discordant-voice", prerequisite: All([Any([Feature(feature: "bard/bardic-performance-move-action", count: 1), Feature(feature: "bard/bardic-performance-swift-action", count: 1)]), CharacterLevel(4)])),
    (key: "dispel-focus", name: "Dispel Focus", summary: "+2 caster level on dispel attempts.", category: Magic, guide: "feats#dispel-focus"),
    (key: "dispel-synergy", name: "Dispel Synergy", summary: "For 1 round after you dispel an effect on a foe, it saves at -2 against your spells.", category: Magic, guide: "feats#dispel-synergy"),
    (key: "disruptive", name: "Disruptive", summary: "Enemies within 10 ft face a +4 DC to cast defensively.", category: Miscellaneous, guide: "feats#disruptive", prerequisite: Any([ClassLevel(class: "fighter", level: 6), SelectionOption("bloodrager/bloodline/arcane"), SelectionOption("sorcerer/bloodline/arcane")])),
    (key: "diva-advance", name: "Diva Advance", summary: "Successful Diva Style feints earn you an attack of opportunity and stop that foe making any for 1 round.", category: Class, guide: "feats#diva-advance", prerequisite: All([Feat("combat-expertise"), Feat("diva-strike"), Feat("diva-style"), Feat("feint"), ClassLevel(class: "bard", level: 11), AbilityScore(ability: Charisma, score: 17)])),
    (key: "diva-strike", name: "Diva Strike", summary: "Once a round in Diva Style, a foe denied its Dex bonus takes your Cha modifier as extra precision damage.", category: Class, guide: "feats#diva-strike", prerequisite: All([Feat("combat-expertise"), Feat("diva-style"), Feat("feint"), ClassLevel(class: "bard", level: 7), AbilityScore(ability: Charisma, score: 15)])),
    (key: "diva-style", name: "Diva Style", summary: "Starting a bardic performance lets you feint for free with Persuasion (Bluff).", category: Class, guide: "feats#diva-style", prerequisite: All([Feat("feint"), ClassLevel(class: "bard", level: 1), AbilityScore(ability: Charisma, score: 13)])),
    (key: "dodge", name: "Dodge", summary: "+1 dodge AC, lost without your Dex bonus.", category: Miscellaneous, guide: "feats#dodge", prerequisite: AbilityScore(ability: Dexterity, score: 13)),
    (key: "double-slice", name: "Double Slice", summary: "Add your full Strength bonus, not half, to off-hand weapon damage.", category: Weapon, guide: "feats#double-slice", prerequisite: All([Feat("two-weapon-fighting"), AbilityScore(ability: Dexterity, score: 15)])),
    (key: "dragon-ferocity", name: "Dragon Ferocity", summary: "2x Strength to your first unarmed strike's damage and 1.5x to the rest; crits and Stunning Fists shake the foe 1d4 + Str rounds.", category: UnarmedCombat, guide: "feats#dragon-ferocity", prerequisite: All([Any([Feat("stunning-fist"), Feature(feature: "monk/stunning-fist", count: 1)]), Feat("dragon-style"), SkillRanks(skill: "mobility", ranks: 5)])),
    (key: "dragon-roar", name: "Dragon Roar", summary: "One more Stunning Fist use; spend two to roar in a 15 ft cone for unarmed damage and shaken 1d4 rounds (Fort DC 10 + half level + Wis).", category: UnarmedCombat, guide: "feats#dragon-roar", prerequisite: All([Any([Feat("stunning-fist"), Feature(feature: "monk/stunning-fist", count: 1)]), Feat("dragon-style"), SkillRanks(skill: "mobility", ranks: 8)])),
    (key: "dragon-style", name: "Dragon Style", summary: "First unarmed strike each round adds 1.5x Strength to damage; +2 to saves against sleep, paralysis and stunning.", category: UnarmedCombat, guide: "feats#dragon-style", prerequisite: All([Feat("improved-unarmed-strike"), SkillRanks(skill: "mobility", ranks: 3), AbilityScore(ability: Strength, score: 15)])),
    (key: "dreadful-carnage", name: "Dreadful Carnage", summary: "Each kill (foe at 0 HP) triggers a free Persuasion check to demoralise every witness within 30 ft.", category: Weapon, guide: "feats#dreadful-carnage", prerequisite: All([Feat("dazzling-display"), Feat("power-attack"), AbilityScore(ability: Strength, score: 15), BaseAttackBonus(11)])),
    (key: "echoes-of-stone", name: "Echoes of Stone", summary: "Underground: +4 Perception and +2 initiative.", category: Racial, guide: "feats#echoes-of-stone", prerequisite: Race("oread")),
    (key: "elemental-fist", name: "Elemental Fist", summary: "Once a day per 4 levels (at most once a round), an unarmed attack deals +1d6 acid, cold, electricity or fire damage.", category: UnarmedCombat, guide: "feats#elemental-fist", prerequisite: All([Feat("improved-unarmed-strike"), AbilityScore(ability: Constitution, score: 13), AbilityScore(ability: Wisdom, score: 13), BaseAttackBonus(8)])),
    (key: "elemental-focus", name: "Elemental Focus", summary: "+1 to the save DCs of your spells dealing the chosen energy (acid, cold, electricity or fire).", category: Magic, guide: "feats#elemental-focus", parameter: Energy, repeat: PerValue),
    (key: "elven-spirit", name: "Elven Spirit", summary: "+2 to caster level checks against spell resistance and +2 to Knowledge (Arcana), as the elves' Elven Magic.", category: Racial, guide: "feats#elven-spirit", prerequisite: Race("half-elf")),
    (key: "endurance", name: "Endurance", summary: "Sleep in light or medium armour without fatigue; +4 Fort against fatigue and exhaustion and +2 Athletics.", category: Miscellaneous, guide: "feats#endurance"),
