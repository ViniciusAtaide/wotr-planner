        name: "Song of Discord",
        school: Enchantment,
        guide: "bard#song-of-discord-enchantment",
        summary: "Each round, every affected enemy has a 50% chance to attack the nearest creature instead of acting normally.",
        target: "All enemies within 20' of target point within medium range",
        duration: "1 round / level",
        saving_throw: "Will negates",
        spell_resistance: true,
        descriptors: [MindAffecting, Compulsion, Sonic],
        casting_time: Standard,
