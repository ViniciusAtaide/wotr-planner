        name: "Challenge Evil",
        school: Enchantment,
        guide: "paladin#challenge-evil-enchantment",
        summary: "Targets only evil enemies (so it reveals alignment); you gain +2 sacred on attacks against it, and it is sickened while it can't attack you.",
        target: "One enemy creature within close range",
        duration: "1 minute / level",
        saving_throw: "Will negates",
        spell_resistance: true,
        descriptors: [MindAffecting, Compulsion],
        casting_time: Standard,
    ),
    (
        key: "veil-of-heaven",
        name: "Veil of Heaven",
        school: Abjuration,
        guide: "paladin#veil-of-heaven-abjuration",
        summary: "You gain a +2 sacred bonus to AC and saves against evil outsiders; dismissing it as a swift action deals 1d8 + 1 per caster level to evil outsiders within 5 ft.",
        target: "Personal",
        duration: "10 minutes / level",
        saving_throw: "Will half",
        spell_resistance: false,
        descriptors: [Good],
        casting_time: Standard,
    ),
    (
        key: "veil-of-positive-energy",
        name: "Veil of Positive Energy",
        school: Abjuration,
        guide: "paladin#veil-of-positive-energy-abjuration",
        summary: "You gain a +2 sacred bonus to AC and saves against undead; dismissing it as a swift action deals 1d8 + 1 per caster level to undead within 5 ft.",
        target: "Personal",
        duration: "10 minutes / level",
        saving_throw: "Will half",
        spell_resistance: false,
        descriptors: [Good],
