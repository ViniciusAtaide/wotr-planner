    (
        key: "forced-repentance",
        name: "Forced Repentance",
        school: Enchantment,
        guide: "inquisitor#forced-repentance-enchantment",
        summary: "An evil target without the evil subtype that fails its save repents for the duration; attacking it ends the effect.",
        target: "One enemy creature within close range",
        duration: "1 round / level",
        saving_throw: "Will negates",
        spell_resistance: true,
        descriptors: [MindAffecting, Compulsion, Emotion, NegativeEmotion],
        casting_time: Standard,
    ),
]
