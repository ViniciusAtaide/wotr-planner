// The spells whose blocks sit under the guide page's "Level 5" heading (inquisitor, saved 2026-11-09), one per
// block: its facts as printed. Extracted for ticket 121; `summary` is ours to write. See the README.
[
    (
        key: "castigate-mass",
        name: "Castigate, Mass",
        school: Enchantment,
        guide: "inquisitor#castigate-mass-enchantment",
        summary: "Enemies in the burst cower in fear unless they save, saving again each round; those that succeed are only shaken for 1 round.",
        target: "One enemy creature within medium range, 30' burst",
        duration: "1 round / level",
        saving_throw: "Will partial",
        spell_resistance: true,
        descriptors: [MindAffecting, Fear, Compulsion, Emotion, NegativeEmotion],
        casting_time: Standard,
    ),
    (
        key: "resounding-blow",
        name: "Resounding Blow",
        school: Evocation,
        guide: "inquisitor#resounding-blow-evocation",
        summary: "Your weapon deals +1d6 sonic; with Judgment or Smite Evil, foes hit are staggered 1 round, and a crit stuns 1 round and blinds 1d6 rounds (Fortitude negates).",
        target: "Personal",
        duration: "1 round / level",
        saving_throw: "Fortitude partial",
        spell_resistance: false,
        descriptors: [Sonic],
        casting_time: Standard,
    ),
]
