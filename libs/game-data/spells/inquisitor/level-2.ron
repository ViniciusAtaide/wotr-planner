// The spells whose blocks sit under the guide page's "Level 2" heading (inquisitor, saved 2026-11-09), one per
// block: its facts as printed. Extracted for ticket 121; `summary` is ours to write. See the README.
[
    (
        key: "castigate",
        name: "Castigate",
        school: Enchantment,
        guide: "inquisitor#castigate-enchantment",
        summary: "The target cowers in fear unless it saves, and may save again each round; on a success it is only shaken for 1 round.",
        target: "One enemy creature within close range",
        duration: "1 round / level",
        saving_throw: "Will partial",
        spell_resistance: true,
        descriptors: [MindAffecting, Fear, Compulsion, Emotion, NegativeEmotion],
        casting_time: Standard,
    ),
]
