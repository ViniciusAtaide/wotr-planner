        (
            key: "druid/feyspeaker",
            blueprint: "da69747aa3dd0044ebff5f3d701cdde3",
            name: "Feyspeaker",
            summary: "Cha-based druid with 1/2 BAB, 4 skill points, delayed wild shape and wizard enchantments and illusions.",
            guide: "druid#feyspeaker",
            skill_points: 4,
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "perception", "persuasion"],
            features: [
                (key: "druid/feyspeaker/fey-magic-i", blueprint: "237efc6a131c8174bbd466ed239f21fc", name: "Fey Magic I", summary: "At 4th level, add Color Spray, Hypnotism, Sleep or Vanish to your spells as a 2nd-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-ii", blueprint: "237efc6a131c8174bbd466ed239f21fc", name: "Fey Magic II", summary: "At 6th level, add Blur, Hideous Laughter, Invisibility or Mirror Image as a 3rd-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-iii", blueprint: "237efc6a131c8174bbd466ed239f21fc", name: "Fey Magic III", summary: "At 8th level, add Deep Slumber, Displacement, Heroism, Hold Person or Rage as a 4th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-iv", blueprint: "237efc6a131c8174bbd466ed239f21fc", name: "Fey Magic IV", summary: "At 10th level, add Crushing Despair, Greater Invisibility, Phantasmal Killer or Rainbow Pattern as a 5th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-v", blueprint: "237efc6a131c8174bbd466ed239f21fc", name: "Fey Magic V", summary: "At 12th level, add a 6th-level pick such as Dominate Person, Feeblemind, Hold Monster or Shadow Evocation.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-vi", blueprint: "237efc6a131c8174bbd466ed239f21fc", name: "Fey Magic VI", summary: "At 14th level, add Cloak of Dreams, Greater Heroism, Phantasmal Putrefaction or Serenity as a 7th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-vii", blueprint: "237efc6a131c8174bbd466ed239f21fc", name: "Fey Magic VII", summary: "At 16th level, add Insanity, Mass Invisibility, Power Word Blind or Waves of Ecstasy as an 8th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-viii", blueprint: "237efc6a131c8174bbd466ed239f21fc", name: "Fey Magic VIII", summary: "At 18th level, add Euphoric Tranquility, Power Word Stun or Greater Shadow Evocation as a 9th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/wild-shape-bear-shambling-mound", blueprint: "0f31b23c2ab39354bbde4e33e8151495", name: "Wild Shape (Bear, Shambling Mound)", summary: "At 10th level, wild shape into a Large bear (rend) or a shambling mound (poison, grapple).", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/wild-shape-leopard", blueprint: "c4d651bc0d4eabd41b08ee81bfe701d8", name: "Wild Shape (Leopard)", summary: "At 8th level, wild shape into a leopard (bite, claws, pounce).", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/wild-shape-smilodon-huge-elemental", blueprint: "253c0c0d00e50a24797445f20af52dc8", name: "Wild Shape (Smilodon, Huge Elemental)", summary: "At 12th level, wild shape into a smilodon (pounce) or a Huge elemental with DR 5/-.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/wild-shape-wolf", blueprint: "19bb148cb92db224abb431642d10efeb", name: "Wild Shape (Wolf)", summary: "At 6th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level.", guide: "druid#feyspeaker"),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/nature-bond"]),
                (level: 4, features: ["druid/feyspeaker/fey-magic-i", "druid/resist-natures-lure"]),
                (level: 6, features: ["druid/feyspeaker/fey-magic-ii", "druid/feyspeaker/wild-shape-wolf"]),
                (level: 8, features: ["druid/feyspeaker/fey-magic-iii", "druid/feyspeaker/wild-shape-leopard", "druid/feyspeaker/wild-shape-wolf"]),
                (level: 10, features: ["druid/feyspeaker/fey-magic-iv", "druid/feyspeaker/wild-shape-bear-shambling-mound", "druid/feyspeaker/wild-shape-wolf"]),
                (level: 12, features: ["druid/feyspeaker/fey-magic-v", "druid/feyspeaker/wild-shape-smilodon-huge-elemental", "druid/feyspeaker/wild-shape-wolf"]),
                (level: 14, features: ["druid/feyspeaker/fey-magic-vi", "druid/feyspeaker/wild-shape-wolf"]),
                (level: 16, features: ["druid/feyspeaker/fey-magic-vii", "druid/feyspeaker/wild-shape-wolf"]),
                (level: 18, features: ["druid/feyspeaker/fey-magic-viii", "druid/feyspeaker/wild-shape-wolf"]),
            ],
        ),
        (
            key: "druid/primal-druid",
            blueprint: "c1c86e2997fd4257a13ef5601b5dc6dd",
            name: "Primal Druid",
            summary: "Megafauna druid with a limited companion list, no domain and a stronger Enlarge Person.",
            guide: "druid#primal-druid",
            features: [
                (key: "druid/primal-druid/animal-companion-primal-druid", blueprint: "fad1127127d9413c8e3e85f8f0450bc1", name: "Animal Companion (Primal Druid)", summary: "Companion choices are limited to a mastodon, smilodon, triceratops or velociraptor.", guide: "druid#animal-companion-primal-druid"),
                (key: "druid/primal-druid/primal-size", blueprint: "9b18d052ac2040f9a68f0c36bf390ce4", name: "Primal Size", summary: "Swap a prepared spell for Enlarge Person; on yourself it gives +4 Str and Con at 8th, and two sizes with +6 at 16th.", guide: "druid#primal-size"),
                (key: "druid/primal-druid/wild-shape-bear-medium-elemental", blueprint: "1368c7ce69702444893af5ffd3226e19", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid#primal-druid"),
                (key: "druid/primal-druid/wild-shape-huge-elemental", blueprint: "fe58dd496a36e274b86958f4677071b2", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid#primal-druid"),
                (key: "druid/primal-druid/wild-shape-leopard-small-elemental", blueprint: "c4d651bc0d4eabd41b08ee81bfe701d8", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid#primal-druid"),
                (key: "druid/primal-druid/wild-shape-smilodon-large-elemental-shambling-mound", blueprint: "253c0c0d00e50a24797445f20af52dc8", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid#primal-druid"),
                (key: "druid/primal-druid/wild-shape-wolf", blueprint: "19bb148cb92db224abb431642d10efeb", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid#primal-druid"),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/primal-druid/animal-companion-primal-druid", "druid/primal-druid/primal-size", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"]),
                (level: 4, features: ["druid/primal-druid/wild-shape-wolf", "druid/resist-natures-lure"]),
                (level: 6, features: ["druid/primal-druid/wild-shape-leopard-small-elemental", "druid/primal-druid/wild-shape-wolf"]),
                (level: 8, features: ["druid/primal-druid/primal-size", "druid/primal-druid/wild-shape-bear-medium-elemental", "druid/primal-druid/wild-shape-wolf"]),
                (level: 10, features: ["druid/primal-druid/wild-shape-smilodon-large-elemental-shambling-mound", "druid/primal-druid/wild-shape-wolf"]),
                (level: 12, features: ["druid/primal-druid/wild-shape-huge-elemental", "druid/primal-druid/wild-shape-wolf"]),
                (level: 14, features: ["druid/primal-druid/wild-shape-wolf"]),
