Class(
    key: "druid",
    blueprint: "610d836f3a3a9ed42a4349b62f002e96",
    name: "Druid",
    summary: "Wis-based prepared divine caster with wild shape and an animal companion or domain; 3/4 BAB, spells to 9th level, good Fortitude and Will, 6 HP a level.",
    guide: "druid",
    skill_points: 3,
    casting_ability: Wisdom,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "perception"],
    prerequisite: Any([Alignment(NeutralGood), Alignment(LawfulNeutral), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil)]),
    features: [
        (key: "druid/druid-proficiencies", blueprint: "0ef3fcce071b4b24a8c52dd0f55fd216", name: "Druid Proficiencies", summary: "Club, dagger, dart, quarterstaff, scimitar, scythe, sickle, shortspear, sling, spear, light and medium armour and wooden shields; no metal armour.", guide: "druid#druid-proficiencies", weapons: ["club", "dagger", "dart", "quarterstaff", "scimitar", "scythe", "shortspear", "sickle", "spear"]),
        (key: "druid/nature-sense", blueprint: "3a859e435fdd6d343b80d4970a7664c1", name: "Nature Sense", summary: "+2 on Lore (Nature) checks.", guide: "druid#nature-sense"),
        (key: "druid/resist-natures-lure", blueprint: "ad6a5b0e1a65c3540986cf9a7b006388", name: "Resist Nature\'s Lure", summary: "From 4th level, +4 on saves against the spell-like and supernatural abilities of fey and plants.", guide: "druid#resist-natures-lure"),
        (key: "druid/spontaneous-summoning", blueprint: "b296531ffe013c8499ad712f8ae97f6b", name: "Spontaneous Summoning", summary: "Swap any prepared spell for a Summon Nature's Ally spell of the same level.", guide: "druid#spontaneous-summoning"),
        (key: "druid/venom-immunity", blueprint: "5078622eb5cecaf4683fa16a9b948c2c", name: "Venom Immunity", summary: "At 9th level, immune to all poison.", guide: "druid#venom-immunity"),
        (key: "druid/wild-shape-bear-medium-elemental", blueprint: "1368c7ce69702444893af5ffd3226e19", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid"),
        (key: "druid/wild-shape-huge-elemental", blueprint: "fe58dd496a36e274b86958f4677071b2", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid"),
        (key: "druid/wild-shape-leopard-small-elemental", blueprint: "c4d651bc0d4eabd41b08ee81bfe701d8", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid"),
        (key: "druid/wild-shape-smilodon-large-elemental-shambling-mound", blueprint: "253c0c0d00e50a24797445f20af52dc8", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid"),
        (key: "druid/wild-shape-wolf", blueprint: "19bb148cb92db224abb431642d10efeb", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid"),
        (key: "druid/woodland-stride", blueprint: "4c1419ef6cfc430a9071405788da4a73", name: "Woodland Stride", summary: "From 2nd level, move through difficult terrain at normal speed without harm.", guide: "druid#woodland-stride"),
    ],
    selections: [
        (
            key: "druid/domain",
            blueprint: "5edfe84c93823d04f8c40ca2b4e0f039",
            name: "Domain",
            summary: "Choose a domain and gain its domain abilities.",
            guide: "druid",
            option_levels: ["druid"],
            options: [],
            shared_options: [
                "cleric/domain/air",
                "cleric/domain/animal",
                "cleric/domain/earth",
                "cleric/domain/fire",
                "cleric/domain/ice",
                "cleric/domain/plant",
                "cleric/domain/water",
                "cleric/domain/weather",
            ],
        ),
        (
            key: "druid/nature-bond",
            blueprint: "3830f3630a33eba49b60f511b4c8f2a8",
            name: "Nature Bond",
            summary: "Choose an animal companion or a domain.",
            guide: "druid",
            option_levels: ["druid"],
            options: [
                (key: "druid/nature-bond/animal-companion", blueprint: "571f8434d98560c43935e132df65fe76", name: "Animal Companion", summary: "Take an animal companion rather than a domain.", guide: "druid"),
                (
                    key: "druid/nature-bond/domain",
                    blueprint: "5edfe84c93823d04f8c40ca2b4e0f039",
                    name: "Domain",
                    summary: "Take a domain rather than an animal companion.",
                    guide: "druid",
                    levels: [
                        (level: 1, selections: ["druid/domain"]),
                    ],
                ),
            ],
        ),
    ],
    levels: [
        (level: 1, divine_spell_level: 1, features: ["druid/druid-proficiencies", "druid/nature-sense", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/nature-bond"]),
        (level: 2, divine_spell_level: 1, features: ["druid/woodland-stride"]),
        (level: 3, divine_spell_level: 2),
        (level: 4, divine_spell_level: 2, features: ["druid/resist-natures-lure", "druid/wild-shape-wolf"]),
        (level: 5, divine_spell_level: 3),
        (level: 6, divine_spell_level: 3, features: ["druid/wild-shape-leopard-small-elemental", "druid/wild-shape-wolf"]),
        (level: 7, divine_spell_level: 4),
        (level: 8, divine_spell_level: 4, features: ["druid/wild-shape-bear-medium-elemental", "druid/wild-shape-wolf"]),
        (level: 9, divine_spell_level: 5, features: ["druid/venom-immunity"]),
        (level: 10, divine_spell_level: 5, features: ["druid/wild-shape-smilodon-large-elemental-shambling-mound", "druid/wild-shape-wolf"]),
        (level: 11, divine_spell_level: 6),
        (level: 12, divine_spell_level: 6, features: ["druid/wild-shape-huge-elemental", "druid/wild-shape-wolf"]),
        (level: 13, divine_spell_level: 7),
        (level: 14, divine_spell_level: 7, features: ["druid/wild-shape-wolf"]),
        (level: 15, divine_spell_level: 8),
        (level: 16, divine_spell_level: 8, features: ["druid/wild-shape-wolf"]),
        (level: 17, divine_spell_level: 9),
        (level: 18, divine_spell_level: 9, features: ["druid/wild-shape-wolf"]),
        (level: 19, divine_spell_level: 9),
        (level: 20, divine_spell_level: 9),
    ],
    archetypes: [
        (
            key: "druid/blight-druid",
            blueprint: "35a3b7bfc663ac74aa8bb50adfe70813",
            name: "Blight Druid",
            summary: "Druid with no animal companion, a blight-themed domain list and auras of sickness and plague.",
            guide: "druid#blight-druid",
            features: [
                (key: "druid/blight-druid/blightblooded", blueprint: "0c079071d76d2bd42889a95d6db22b5f", name: "Blightblooded", summary: "At 9th level, immune to disease and to being sickened or nauseated.", guide: "druid#blightblooded"),
                (key: "druid/blight-druid/miasma", blueprint: "1917f240517cbf84e9ff9ba6adaf40c8", name: "Miasma", summary: "From 5th, foes starting next to you are sickened 1 round (animals, fey, plants: nauseated 1 round, sickened 1 minute) unless Fortitude; a save grants immunity.", guide: "druid#miasma"),
                (key: "druid/blight-druid/plaguebearer", blueprint: "1f01189eb78e334469017066675d21f0", name: "Plaguebearer", summary: "From 13th level, creatures hitting you with touch, unarmed or natural attacks save (Fortitude) or are nauseated and catch bubonic plague.", guide: "druid#plaguebearer"),
                (key: "druid/blight-druid/wild-shape-bear-medium-elemental", blueprint: "1368c7ce69702444893af5ffd3226e19", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid#blight-druid"),
                (key: "druid/blight-druid/wild-shape-huge-elemental", blueprint: "fe58dd496a36e274b86958f4677071b2", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid#blight-druid"),
                (key: "druid/blight-druid/wild-shape-leopard-small-elemental", blueprint: "c4d651bc0d4eabd41b08ee81bfe701d8", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid#blight-druid"),
                (key: "druid/blight-druid/wild-shape-smilodon-large-elemental-shambling-mound", blueprint: "253c0c0d00e50a24797445f20af52dc8", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid#blight-druid"),
                (key: "druid/blight-druid/wild-shape-wolf", blueprint: "19bb148cb92db224abb431642d10efeb", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid#blight-druid"),
            ],
            selections: [
                (
                    key: "druid/blight-druid/domain",
                    blueprint: "096fc02f6cc817a43991c4b437e12b8e",
                    name: "Domain (Blight Druid)",
                    summary: "Choose from Air, Animal, Darkness, Death, Destruction, Earth, Fire, Murder, Plant, Undead, Water or Weather.",
                    guide: "druid#blight-druid",
                    option_levels: ["druid"],
                    skipped_levels: [4],
                    options: [],
                    shared_options: [
                        "cleric/domain/air",
                        "cleric/domain/animal",
                        "cleric/domain/darkness",
                        "cleric/domain/death",
                        "cleric/domain/destruction",
                        "cleric/domain/earth",
                        "cleric/domain/fire",
                        "cleric/domain/murder",
                        "cleric/domain/plant",
                        "cleric/domain/undead",
                        "cleric/domain/water",
                        "cleric/domain/weather",
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/nature-sense", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/blight-druid/domain"]),
                (level: 4, features: ["druid/blight-druid/wild-shape-wolf"]),
                (level: 5, features: ["druid/blight-druid/miasma"]),
                (level: 6, features: ["druid/blight-druid/wild-shape-leopard-small-elemental", "druid/blight-druid/wild-shape-wolf"]),
                (level: 8, features: ["druid/blight-druid/wild-shape-bear-medium-elemental", "druid/blight-druid/wild-shape-wolf"]),
                (level: 9, features: ["druid/blight-druid/blightblooded"]),
                (level: 10, features: ["druid/blight-druid/wild-shape-smilodon-large-elemental-shambling-mound", "druid/blight-druid/wild-shape-wolf"]),
                (level: 12, features: ["druid/blight-druid/wild-shape-huge-elemental", "druid/blight-druid/wild-shape-wolf"]),
                (level: 13, features: ["druid/blight-druid/plaguebearer"]),
                (level: 14, features: ["druid/blight-druid/wild-shape-wolf"]),
                (level: 16, features: ["druid/blight-druid/wild-shape-wolf"]),
                (level: 18, features: ["druid/blight-druid/wild-shape-wolf"]),
            ],
        ),
        (
            key: "druid/defender-of-the-true-world",
            blueprint: "782c46afacd88d448afba6178471a744",
            name: "Defender of the True World",
            summary: "Fey-hunting druid with bonuses against fey, losing poison immunity.",
            guide: "druid#defender-of-the-true-world",
            class_skills: ["athletics", "knowledge-world", "lore-nature", "perception", "persuasion"],
            features: [
                (key: "druid/defender-of-the-true-world/beguiling-immunity", blueprint: "c532e8f7a393d0c4580f017d225d4fe2", name: "Beguiling Immunity", summary: "At 9th level, immune to the mind-affecting effects of fey.", guide: "druid#beguiling-immunity"),
                (key: "druid/defender-of-the-true-world/enemy-of-the-fey", blueprint: "b08a858f2e4887f45aca4c09893a0adc", name: "Enemy of the Fey", summary: "+2 weapon attack and damage against fey; swap prepared spells for Summon Nature's Ally, or for elder elementals and worms at 8th and 9th.", guide: "druid#enemy-of-the-fey"),
                (key: "druid/defender-of-the-true-world/fey-stalker", blueprint: "02357ba2802b8654bb3e824bae68f5c0", name: "Fey Stalker", summary: "From 3rd level, your companion and summoned allies get +1 attack and damage against fey, rising at 8th, 13th and 18th.", guide: "druid#fey-stalker"),
                (key: "druid/defender-of-the-true-world/feybane", blueprint: "7d62b8531749ea74292b0d39b4b7fc19", name: "Feybane", summary: "From 4th level, +4 saves against fey abilities, natural attacks count as cold iron, and +2 to beat fey spell resistance.", guide: "druid#feybane"),
                (key: "druid/defender-of-the-true-world/wild-shape-bear-medium-elemental", blueprint: "1368c7ce69702444893af5ffd3226e19", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid#defender-of-the-true-world"),
                (key: "druid/defender-of-the-true-world/wild-shape-huge-elemental", blueprint: "fe58dd496a36e274b86958f4677071b2", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid#defender-of-the-true-world"),
                (key: "druid/defender-of-the-true-world/wild-shape-leopard-small-elemental", blueprint: "c4d651bc0d4eabd41b08ee81bfe701d8", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid#defender-of-the-true-world"),
                (key: "druid/defender-of-the-true-world/wild-shape-smilodon-large-elemental-shambling-mound", blueprint: "253c0c0d00e50a24797445f20af52dc8", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid#defender-of-the-true-world"),
                (key: "druid/defender-of-the-true-world/wild-shape-wolf", blueprint: "19bb148cb92db224abb431642d10efeb", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid#defender-of-the-true-world"),
            ],
            levels: [
                (level: 1, features: ["druid/defender-of-the-true-world/enemy-of-the-fey", "druid/druid-proficiencies", "druid/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/nature-bond"]),
                (level: 3, features: ["druid/defender-of-the-true-world/fey-stalker"]),
                (level: 4, features: ["druid/defender-of-the-true-world/feybane", "druid/defender-of-the-true-world/wild-shape-wolf"]),
                (level: 6, features: ["druid/defender-of-the-true-world/wild-shape-leopard-small-elemental", "druid/defender-of-the-true-world/wild-shape-wolf"]),
                (level: 8, features: ["druid/defender-of-the-true-world/fey-stalker", "druid/defender-of-the-true-world/wild-shape-bear-medium-elemental", "druid/defender-of-the-true-world/wild-shape-wolf"]),
                (level: 9, features: ["druid/defender-of-the-true-world/beguiling-immunity"]),
                (level: 10, features: ["druid/defender-of-the-true-world/wild-shape-smilodon-large-elemental-shambling-mound", "druid/defender-of-the-true-world/wild-shape-wolf"]),
                (level: 12, features: ["druid/defender-of-the-true-world/wild-shape-huge-elemental", "druid/defender-of-the-true-world/wild-shape-wolf"]),
                (level: 13, features: ["druid/defender-of-the-true-world/fey-stalker"]),
                (level: 14, features: ["druid/defender-of-the-true-world/wild-shape-wolf"]),
                (level: 16, features: ["druid/defender-of-the-true-world/wild-shape-wolf"]),
                (level: 18, features: ["druid/defender-of-the-true-world/fey-stalker", "druid/defender-of-the-true-world/wild-shape-wolf"]),
            ],
        ),
        (
            key: "druid/drovier",
            blueprint: "a6bf603aa4d666f4f86dab0289e2048c",
            name: "Drovier",
            summary: "Druid who gives party-wide animal aspects instead of wild shape or a domain.",
            guide: "druid#drovier",
            features: [
                (key: "druid/drovier/animal-companion", blueprint: "571f8434d98560c43935e132df65fe76", name: "Animal Companion", summary: "A Drovier always takes an animal companion and can't choose a domain.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect", blueprint: "ced7b7d0c4f78e44b8930a802a1c265d", name: "Communal Aspect", summary: "From 4th level, give Animal Aspect to all allies within 30' for 10 minutes per level a day; at will at 20th.", guide: "druid#communal-aspect"),
                (key: "druid/drovier/communal-aspect-aspect-of-the-bear", blueprint: "4f576cc5fab868e4d9bbe37d40bd2a57", name: "Communal Aspect (Aspect of the Bear)", summary: "From 10th level, Communal Aspect can grant Aspect of the Bear.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect-aspect-of-the-falcon", blueprint: "7c3a2b21ffb8faf49a4656a04487d8b4", name: "Communal Aspect (Aspect of the Falcon)", summary: "From 8th level, Communal Aspect can grant Aspect of the Falcon.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect-aspect-of-the-stag", blueprint: "6449ed3a54f5b7942b655fd798ae4d4b", name: "Communal Aspect (Aspect of the Stag)", summary: "From 12th level, Communal Aspect can grant Aspect of the Stag.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect-aspect-of-the-wolf", blueprint: "1bc2172a483c76541b313465ca070c4b", name: "Communal Aspect (Aspect of the Wolf)", summary: "From 14th level, Communal Aspect can grant Aspect of the Wolf.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect-greater", blueprint: "4ab732622752d51439afd19e911abe6b", name: "Communal Aspect (Greater)", summary: "From 6th level, Communal Aspect grants Greater Animal Aspect.", guide: "druid#drovier"),
            ],
            levels: [
                (level: 1, features: ["druid/drovier/animal-companion", "druid/druid-proficiencies", "druid/nature-sense", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"]),
                (level: 4, features: ["druid/drovier/communal-aspect", "druid/resist-natures-lure"]),
                (level: 6, features: ["druid/drovier/communal-aspect-greater"]),
                (level: 8, features: ["druid/drovier/communal-aspect-aspect-of-the-falcon"]),
                (level: 10, features: ["druid/drovier/communal-aspect-aspect-of-the-bear"]),
                (level: 12, features: ["druid/drovier/communal-aspect-aspect-of-the-stag"]),
                (level: 14, features: ["druid/drovier/communal-aspect-aspect-of-the-wolf"]),
                (level: 16),
                (level: 18),
                (level: 20, features: ["druid/drovier/communal-aspect"]),
            ],
        ),
        (
            key: "druid/elemental-rampager",
            blueprint: "f815594bd1e3454182022d375bf70fd1",
            name: "Elemental Rampager",
            summary: "Con and Wis druid with claws and an elemental rage; no animal companion or domain.",
            guide: "druid#elemental-rampager",
            features: [
                (key: "druid/elemental-rampager/claws", blueprint: "1c592a4f288a46889aa70a0eac774c4f", name: "Claws", summary: "A 1d6 claw attack, 1d8 at 9th level and 1d10 at 15th.", guide: "druid#claws"),
                (key: "druid/elemental-rampager/elemental-ability", name: "Elemental Ability", summary: "At 11th and 20th level, a rampage power for your element, such as sickening acid, entangling cold, chained electricity or burning.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/elemental-damage", blueprint: "c8befb3ccd6a46af99ef2b9aac255f6f", name: "Elemental Damage", summary: "Natural attacks deal +1d6 of your chosen element, 2d6 at 11th and 3d6 at 20th.", guide: "druid#elemental-damage"),
                (key: "druid/elemental-rampager/elemental-rampage", blueprint: "c8befb3ccd6a46af99ef2b9aac255f6f", name: "Elemental Rampage", summary: "From 4th level, your rampage gains an element: extra energy damage, resistance and later immunity, with powers at 11th and 20th.", guide: "druid#elemental-rampage"),
                (key: "druid/elemental-rampager/energy-immunity", name: "Energy Immunity", summary: "At 20th level, immune to your rampage element.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/energy-resistance", name: "Energy Resistance", summary: "From 4th level, resistance 5 to your element, 10 at 9th, 20 at 15th, immunity at 20th.", guide: "druid#energy-resistance"),
                (key: "druid/elemental-rampager/rampage", blueprint: "64c5dfe0ba664dd38b7e914ef0912a1c", name: "Rampage", summary: "Rage for 4 + Con rounds (+2 per level) a day: +2 attack and damage with natural weapons and -2 AC; +1 at 6th and every five levels.", guide: "druid#rampage"),
                (key: "druid/elemental-rampager/wild-shape-bear-medium-elemental", blueprint: "6e4b88e2a044c67469c038ac2f09d061", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/wild-shape-huge-elemental", blueprint: "fe58dd496a36e274b86958f4677071b2", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/wild-shape-leopard-small-elemental", blueprint: "bddd46a6f6a3e6e4b99008dcf5271c3b", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/wild-shape-smilodon-large-elemental-shambling-mound", blueprint: "e66154511a6f9fc49a9de644bd8922db", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/wild-shape-wolf", blueprint: "19bb148cb92db224abb431642d10efeb", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid#elemental-rampager"),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/elemental-rampager/claws", "druid/elemental-rampager/rampage", "druid/nature-sense", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"]),
                (level: 4, features: ["druid/elemental-rampager/elemental-damage", "druid/elemental-rampager/elemental-rampage", "druid/elemental-rampager/energy-resistance", "druid/elemental-rampager/wild-shape-wolf"]),
                (level: 6, features: ["druid/elemental-rampager/rampage", "druid/elemental-rampager/wild-shape-leopard-small-elemental", "druid/elemental-rampager/wild-shape-wolf"]),
                (level: 8, features: ["druid/elemental-rampager/wild-shape-bear-medium-elemental", "druid/elemental-rampager/wild-shape-wolf"]),
                (level: 9, features: ["druid/elemental-rampager/claws", "druid/elemental-rampager/energy-resistance"]),
                (level: 10, features: ["druid/elemental-rampager/wild-shape-smilodon-large-elemental-shambling-mound", "druid/elemental-rampager/wild-shape-wolf"]),
                (level: 11, features: ["druid/elemental-rampager/elemental-ability", "druid/elemental-rampager/elemental-damage", "druid/elemental-rampager/rampage"]),
                (level: 12, features: ["druid/elemental-rampager/wild-shape-huge-elemental", "druid/elemental-rampager/wild-shape-wolf"]),
                (level: 14, features: ["druid/elemental-rampager/wild-shape-wolf"]),
                (level: 15, features: ["druid/elemental-rampager/claws", "druid/elemental-rampager/energy-resistance"]),
                (level: 16, features: ["druid/elemental-rampager/rampage", "druid/elemental-rampager/wild-shape-wolf"]),
                (level: 18, features: ["druid/elemental-rampager/wild-shape-wolf"]),
                (level: 20, features: ["druid/elemental-rampager/elemental-ability", "druid/elemental-rampager/elemental-damage", "druid/elemental-rampager/energy-immunity"]),
            ],
