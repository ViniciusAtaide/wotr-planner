Class(
    key: "druid",
    name: "Druid",
    summary: "Wis-based prepared divine caster with wild shape and an animal companion or domain; 3/4 BAB, spells to 9th level, good Fortitude and Will, 6 HP a level.",
    guide: "druid",
    skill_points: 3,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "perception"],
    prerequisite: Any([Alignment(NeutralGood), Alignment(LawfulNeutral), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil)]),
    features: [
        (key: "druid/druid-proficiencies", name: "Druid Proficiencies", summary: "Club, dagger, dart, quarterstaff, scimitar, scythe, sickle, shortspear, sling, spear, light and medium armour and wooden shields; no metal armour.", guide: "druid#druid-proficiencies"),
        (key: "druid/nature-sense", name: "Nature Sense", summary: "+2 on Lore (Nature) checks.", guide: "druid#nature-sense"),
        (key: "druid/resist-natures-lure", name: "Resist Nature\'s Lure", summary: "From 4th level, +4 on saves against the spell-like and supernatural abilities of fey and plants.", guide: "druid#resist-natures-lure"),
        (key: "druid/spontaneous-summoning", name: "Spontaneous Summoning", summary: "Swap any prepared spell for a Summon Nature's Ally spell of the same level.", guide: "druid#spontaneous-summoning"),
        (key: "druid/venom-immunity", name: "Venom Immunity", summary: "At 9th level, immune to all poison.", guide: "druid#venom-immunity"),
        (key: "druid/wild-shape-bear-medium-elemental", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid"),
        (key: "druid/wild-shape-huge-elemental", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid"),
        (key: "druid/wild-shape-leopard-small-elemental", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid"),
        (key: "druid/wild-shape-smilodon-large-elemental-shambling-mound", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid"),
        (key: "druid/wild-shape-wolf", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid"),
        (key: "druid/woodland-stride", name: "Woodland Stride", summary: "From 2nd level, move through difficult terrain at normal speed without harm.", guide: "druid#woodland-stride"),
    ],
    selections: [
        (
            key: "druid/domain",
            name: "Domain",
            summary: "Choose a domain and gain its domain abilities.",
            guide: "druid",
            option_levels: ["druid"],
            options: [],
            shared_options: [
                "cleric/domain/air",
                "cleric/domain/animal",
                "cleric/domain/earth",
                "cleric/domain/fire",
                "cleric/domain/ice",
                "cleric/domain/plant",
                "cleric/domain/water",
                "cleric/domain/weather",
            ],
        ),
        (
            key: "druid/nature-bond",
            name: "Nature Bond",
            summary: "Choose an animal companion or a domain.",
            guide: "druid",
            option_levels: ["druid"],
            options: [
                (key: "druid/nature-bond/animal-companion", name: "Animal Companion", summary: "Take an animal companion rather than a domain.", guide: "druid"),
                (
                    key: "druid/nature-bond/domain",
                    name: "Domain",
                    summary: "Take a domain rather than an animal companion.",
                    guide: "druid",
                    levels: [
                        (level: 1, selections: ["druid/domain"]),
                    ],
                ),
            ],
        ),
    ],
    levels: [
        (level: 1, divine_spell_level: 1, features: ["druid/druid-proficiencies", "druid/nature-sense", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/nature-bond"]),
        (level: 2, divine_spell_level: 1, features: ["druid/woodland-stride"]),
        (level: 3, divine_spell_level: 2),
        (level: 4, divine_spell_level: 2, features: ["druid/resist-natures-lure", "druid/wild-shape-wolf"]),
        (level: 5, divine_spell_level: 3),
        (level: 6, divine_spell_level: 3, features: ["druid/wild-shape-leopard-small-elemental"]),
        (level: 7, divine_spell_level: 4),
        (level: 8, divine_spell_level: 4, features: ["druid/wild-shape-bear-medium-elemental"]),
        (level: 9, divine_spell_level: 5, features: ["druid/venom-immunity"]),
        (level: 10, divine_spell_level: 5, features: ["druid/wild-shape-smilodon-large-elemental-shambling-mound"]),
        (level: 11, divine_spell_level: 6),
        (level: 12, divine_spell_level: 6, features: ["druid/wild-shape-huge-elemental"]),
        (level: 13, divine_spell_level: 7),
        (level: 14, divine_spell_level: 7),
        (level: 15, divine_spell_level: 8),
        (level: 16, divine_spell_level: 8),
        (level: 17, divine_spell_level: 9),
        (level: 18, divine_spell_level: 9),
        (level: 19, divine_spell_level: 9),
        (level: 20, divine_spell_level: 9),
    ],
    archetypes: [
        (
            key: "druid/blight-druid",
            name: "Blight Druid",
            summary: "Druid with no animal companion, a blight-themed domain list and auras of sickness and plague.",
            guide: "druid#blight-druid",
            features: [
                (key: "druid/blight-druid/blightblooded", name: "Blightblooded", summary: "At 9th level, immune to disease and to being sickened or nauseated.", guide: "druid#blightblooded"),
                (key: "druid/blight-druid/miasma", name: "Miasma", summary: "From 5th, foes starting next to you are sickened 1 round (animals, fey, plants: nauseated 1 round, sickened 1 minute) unless Fortitude; a save grants immunity.", guide: "druid#miasma"),
                (key: "druid/blight-druid/plaguebearer", name: "Plaguebearer", summary: "From 13th level, creatures hitting you with touch, unarmed or natural attacks save (Fortitude) or are nauseated and catch bubonic plague.", guide: "druid#plaguebearer"),
                (key: "druid/blight-druid/wild-shape-bear-medium-elemental", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid#blight-druid"),
                (key: "druid/blight-druid/wild-shape-huge-elemental", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid#blight-druid"),
                (key: "druid/blight-druid/wild-shape-leopard-small-elemental", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid#blight-druid"),
                (key: "druid/blight-druid/wild-shape-smilodon-large-elemental-shambling-mound", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid#blight-druid"),
                (key: "druid/blight-druid/wild-shape-wolf", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid#blight-druid"),
            ],
            selections: [
                (
                    key: "druid/blight-druid/domain",
                    name: "Domain (Blight Druid)",
                    summary: "Choose from Air, Animal, Darkness, Death, Destruction, Earth, Fire, Murder, Plant, Undead, Water or Weather.",
                    guide: "druid#blight-druid",
                    option_levels: ["druid"],
                    skipped_levels: [4],
                    options: [],
                    shared_options: [
                        "cleric/domain/air",
                        "cleric/domain/animal",
                        "cleric/domain/darkness",
                        "cleric/domain/death",
                        "cleric/domain/destruction",
                        "cleric/domain/earth",
                        "cleric/domain/fire",
                        "cleric/domain/murder",
                        "cleric/domain/plant",
                        "cleric/domain/undead",
                        "cleric/domain/water",
                        "cleric/domain/weather",
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/nature-sense", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/blight-druid/domain"]),
                (level: 4, features: ["druid/blight-druid/wild-shape-wolf"]),
                (level: 5, features: ["druid/blight-druid/miasma"]),
                (level: 6, features: ["druid/blight-druid/wild-shape-leopard-small-elemental"]),
                (level: 8, features: ["druid/blight-druid/wild-shape-bear-medium-elemental"]),
                (level: 9, features: ["druid/blight-druid/blightblooded"]),
                (level: 10, features: ["druid/blight-druid/wild-shape-smilodon-large-elemental-shambling-mound"]),
                (level: 12, features: ["druid/blight-druid/wild-shape-huge-elemental"]),
                (level: 13, features: ["druid/blight-druid/plaguebearer"]),
            ],
        ),
        (
            key: "druid/defender-of-the-true-world",
            name: "Defender of the True World",
            summary: "Fey-hunting druid with bonuses against fey, losing poison immunity.",
            guide: "druid#defender-of-the-true-world",
            class_skills: ["athletics", "knowledge-world", "lore-nature", "perception", "persuasion"],
            features: [
                (key: "druid/defender-of-the-true-world/beguiling-immunity", name: "Beguiling Immunity", summary: "At 9th level, immune to the mind-affecting effects of fey.", guide: "druid#beguiling-immunity"),
                (key: "druid/defender-of-the-true-world/enemy-of-the-fey", name: "Enemy of the Fey", summary: "+2 weapon attack and damage against fey; swap prepared spells for Summon Nature's Ally, or for elder elementals and worms at 8th and 9th.", guide: "druid#enemy-of-the-fey"),
                (key: "druid/defender-of-the-true-world/fey-stalker", name: "Fey Stalker", summary: "From 3rd level, your companion and summoned allies get +1 attack and damage against fey, rising at 8th, 13th and 18th.", guide: "druid#fey-stalker"),
                (key: "druid/defender-of-the-true-world/feybane", name: "Feybane", summary: "From 4th level, +4 saves against fey abilities, natural attacks count as cold iron, and +2 to beat fey spell resistance.", guide: "druid#feybane"),
                (key: "druid/defender-of-the-true-world/wild-shape-bear-medium-elemental", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid#defender-of-the-true-world"),
                (key: "druid/defender-of-the-true-world/wild-shape-huge-elemental", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid#defender-of-the-true-world"),
                (key: "druid/defender-of-the-true-world/wild-shape-leopard-small-elemental", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid#defender-of-the-true-world"),
                (key: "druid/defender-of-the-true-world/wild-shape-smilodon-large-elemental-shambling-mound", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid#defender-of-the-true-world"),
                (key: "druid/defender-of-the-true-world/wild-shape-wolf", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid#defender-of-the-true-world"),
            ],
            levels: [
                (level: 1, features: ["druid/defender-of-the-true-world/enemy-of-the-fey", "druid/druid-proficiencies", "druid/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/nature-bond"]),
                (level: 3, features: ["druid/defender-of-the-true-world/fey-stalker"]),
                (level: 4, features: ["druid/defender-of-the-true-world/feybane", "druid/defender-of-the-true-world/wild-shape-wolf"]),
                (level: 6, features: ["druid/defender-of-the-true-world/wild-shape-leopard-small-elemental"]),
                (level: 8, features: ["druid/defender-of-the-true-world/wild-shape-bear-medium-elemental"]),
                (level: 9, features: ["druid/defender-of-the-true-world/beguiling-immunity"]),
                (level: 10, features: ["druid/defender-of-the-true-world/wild-shape-smilodon-large-elemental-shambling-mound"]),
                (level: 12, features: ["druid/defender-of-the-true-world/wild-shape-huge-elemental"]),
            ],
        ),
        (
            key: "druid/drovier",
            name: "Drovier",
            summary: "Druid who gives party-wide animal aspects instead of wild shape or a domain.",
            guide: "druid#drovier",
            features: [
                (key: "druid/drovier/animal-companion", name: "Animal Companion", summary: "A Drovier always takes an animal companion and can't choose a domain.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect", name: "Communal Aspect", summary: "From 4th level, give Animal Aspect to all allies within 30' for 10 minutes per level a day; at will at 20th.", guide: "druid#communal-aspect"),
                (key: "druid/drovier/communal-aspect-aspect-of-the-bear", name: "Communal Aspect (Aspect of the Bear)", summary: "From 10th level, Communal Aspect can grant Aspect of the Bear.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect-aspect-of-the-falcon", name: "Communal Aspect (Aspect of the Falcon)", summary: "From 8th level, Communal Aspect can grant Aspect of the Falcon.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect-aspect-of-the-stag", name: "Communal Aspect (Aspect of the Stag)", summary: "From 12th level, Communal Aspect can grant Aspect of the Stag.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect-aspect-of-the-wolf", name: "Communal Aspect (Aspect of the Wolf)", summary: "From 14th level, Communal Aspect can grant Aspect of the Wolf.", guide: "druid#drovier"),
                (key: "druid/drovier/communal-aspect-greater", name: "Communal Aspect (Greater)", summary: "From 6th level, Communal Aspect grants Greater Animal Aspect.", guide: "druid#drovier"),
            ],
            levels: [
                (level: 1, features: ["druid/drovier/animal-companion", "druid/druid-proficiencies", "druid/nature-sense", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"]),
                (level: 4, features: ["druid/drovier/communal-aspect", "druid/resist-natures-lure"]),
                (level: 6, features: ["druid/drovier/communal-aspect-greater"]),
                (level: 8, features: ["druid/drovier/communal-aspect-aspect-of-the-falcon"]),
                (level: 10, features: ["druid/drovier/communal-aspect-aspect-of-the-bear"]),
                (level: 12, features: ["druid/drovier/communal-aspect-aspect-of-the-stag"]),
                (level: 14, features: ["druid/drovier/communal-aspect-aspect-of-the-wolf"]),
                (level: 20, features: ["druid/drovier/communal-aspect"]),
            ],
        ),
        (
            key: "druid/elemental-rampager",
            name: "Elemental Rampager",
            summary: "Con and Wis druid with claws and an elemental rage; no animal companion or domain.",
            guide: "druid#elemental-rampager",
            features: [
                (key: "druid/elemental-rampager/claws", name: "Claws", summary: "A 1d6 claw attack, 1d8 at 9th level and 1d10 at 15th.", guide: "druid#claws"),
                (key: "druid/elemental-rampager/elemental-ability", name: "Elemental Ability", summary: "At 11th and 20th level, a rampage power for your element, such as sickening acid, entangling cold, chained electricity or burning.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/elemental-damage", name: "Elemental Damage", summary: "Natural attacks deal +1d6 of your chosen element, 2d6 at 11th and 3d6 at 20th.", guide: "druid#elemental-damage"),
                (key: "druid/elemental-rampager/elemental-rampage", name: "Elemental Rampage", summary: "From 4th level, your rampage gains an element: extra energy damage, resistance and later immunity, with powers at 11th and 20th.", guide: "druid#elemental-rampage"),
                (key: "druid/elemental-rampager/energy-immunity", name: "Energy Immunity", summary: "At 20th level, immune to your rampage element.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/energy-resistance", name: "Energy Resistance", summary: "From 4th level, resistance 5 to your element, 10 at 9th, 20 at 15th, immunity at 20th.", guide: "druid#energy-resistance"),
                (key: "druid/elemental-rampager/rampage", name: "Rampage", summary: "Rage for 4 + Con rounds (+2 per level) a day: +2 attack and damage with natural weapons and -2 AC; +1 at 6th and every five levels.", guide: "druid#rampage"),
                (key: "druid/elemental-rampager/wild-shape-bear-medium-elemental", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/wild-shape-huge-elemental", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/wild-shape-leopard-small-elemental", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/wild-shape-smilodon-large-elemental-shambling-mound", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid#elemental-rampager"),
                (key: "druid/elemental-rampager/wild-shape-wolf", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid#elemental-rampager"),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/elemental-rampager/claws", "druid/elemental-rampager/rampage", "druid/nature-sense", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"]),
                (level: 4, features: ["druid/elemental-rampager/elemental-damage", "druid/elemental-rampager/elemental-rampage", "druid/elemental-rampager/energy-resistance", "druid/elemental-rampager/wild-shape-wolf"]),
                (level: 6, features: ["druid/elemental-rampager/wild-shape-leopard-small-elemental"]),
                (level: 8, features: ["druid/elemental-rampager/wild-shape-bear-medium-elemental"]),
                (level: 9, features: ["druid/elemental-rampager/energy-resistance"]),
                (level: 10, features: ["druid/elemental-rampager/wild-shape-smilodon-large-elemental-shambling-mound"]),
                (level: 11, features: ["druid/elemental-rampager/elemental-ability", "druid/elemental-rampager/elemental-damage"]),
                (level: 12, features: ["druid/elemental-rampager/wild-shape-huge-elemental"]),
                (level: 15, features: ["druid/elemental-rampager/energy-resistance"]),
                (level: 20, features: ["druid/elemental-rampager/elemental-ability", "druid/elemental-rampager/elemental-damage", "druid/elemental-rampager/energy-immunity"]),
            ],
        ),
        (
            key: "druid/feyspeaker",
            name: "Feyspeaker",
            summary: "Cha-based druid with 1/2 BAB, 4 skill points, delayed wild shape and wizard enchantments and illusions.",
            guide: "druid#feyspeaker",
            skill_points: 4,
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "perception", "persuasion"],
            features: [
                (key: "druid/feyspeaker/fey-magic-i", name: "Fey Magic I", summary: "At 4th level, add Color Spray, Hypnotism, Sleep or Vanish to your spells as a 2nd-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-ii", name: "Fey Magic II", summary: "At 6th level, add Blur, Hideous Laughter, Invisibility or Mirror Image as a 3rd-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-iii", name: "Fey Magic III", summary: "At 8th level, add Deep Slumber, Displacement, Heroism, Hold Person or Rage as a 4th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-iv", name: "Fey Magic IV", summary: "At 10th level, add Crushing Despair, Greater Invisibility, Phantasmal Killer or Rainbow Pattern as a 5th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-v", name: "Fey Magic V", summary: "At 12th level, add a 6th-level pick such as Dominate Person, Feeblemind, Hold Monster or Shadow Evocation.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-vi", name: "Fey Magic VI", summary: "At 14th level, add Cloak of Dreams, Greater Heroism, Phantasmal Putrefaction or Serenity as a 7th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-vii", name: "Fey Magic VII", summary: "At 16th level, add Insanity, Mass Invisibility, Power Word Blind or Waves of Ecstasy as an 8th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/fey-magic-viii", name: "Fey Magic VIII", summary: "At 18th level, add Euphoric Tranquility, Power Word Stun or Greater Shadow Evocation as a 9th-level spell.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/wild-shape-bear-shambling-mound", name: "Wild Shape (Bear, Shambling Mound)", summary: "At 10th level, wild shape into a Large bear (rend) or a shambling mound (poison, grapple).", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/wild-shape-leopard", name: "Wild Shape (Leopard)", summary: "At 8th level, wild shape into a leopard (bite, claws, pounce).", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/wild-shape-smilodon-huge-elemental", name: "Wild Shape (Smilodon, Huge Elemental)", summary: "At 12th level, wild shape into a smilodon (pounce) or a Huge elemental with DR 5/-.", guide: "druid#feyspeaker"),
                (key: "druid/feyspeaker/wild-shape-wolf", name: "Wild Shape (Wolf)", summary: "At 6th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level.", guide: "druid#feyspeaker"),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/nature-bond"]),
                (level: 4, features: ["druid/feyspeaker/fey-magic-i", "druid/resist-natures-lure"]),
                (level: 6, features: ["druid/feyspeaker/fey-magic-ii", "druid/feyspeaker/wild-shape-wolf"]),
                (level: 8, features: ["druid/feyspeaker/fey-magic-iii", "druid/feyspeaker/wild-shape-leopard"]),
                (level: 10, features: ["druid/feyspeaker/fey-magic-iv", "druid/feyspeaker/wild-shape-bear-shambling-mound"]),
                (level: 12, features: ["druid/feyspeaker/fey-magic-v", "druid/feyspeaker/wild-shape-smilodon-huge-elemental"]),
                (level: 14, features: ["druid/feyspeaker/fey-magic-vi"]),
                (level: 16, features: ["druid/feyspeaker/fey-magic-vii"]),
                (level: 18, features: ["druid/feyspeaker/fey-magic-viii"]),
            ],
        ),
        (
            key: "druid/primal-druid",
            name: "Primal Druid",
            summary: "Megafauna druid with a limited companion list, no domain and a stronger Enlarge Person.",
            guide: "druid#primal-druid",
            features: [
                (key: "druid/primal-druid/animal-companion-primal-druid", name: "Animal Companion (Primal Druid)", summary: "Companion choices are limited to a mastodon, smilodon, triceratops or velociraptor.", guide: "druid#animal-companion-primal-druid"),
                (key: "druid/primal-druid/primal-size", name: "Primal Size", summary: "Swap a prepared spell for Enlarge Person; on yourself it gives +4 Str and Con at 8th, and two sizes with +6 at 16th.", guide: "druid#primal-size"),
                (key: "druid/primal-druid/wild-shape-bear-medium-elemental", name: "Wild Shape (Bear, Medium Elemental)", summary: "At 8th level, wild shape into a Large bear (+4 Str, bite, claws, rend) or a Medium elemental.", guide: "druid#primal-druid"),
                (key: "druid/primal-druid/wild-shape-huge-elemental", name: "Wild Shape (Huge Elemental)", summary: "At 12th level, wild shape into a Huge elemental, which also gains DR 5/-.", guide: "druid#primal-druid"),
                (key: "druid/primal-druid/wild-shape-leopard-small-elemental", name: "Wild Shape (Leopard, Small Elemental)", summary: "At 6th level, wild shape into a leopard (bite, claws, pounce) or a Small air, earth, fire or water elemental.", guide: "druid#primal-druid"),
                (key: "druid/primal-druid/wild-shape-smilodon-large-elemental-shambling-mound", name: "Wild Shape (Smilodon, Large Elemental, Shambling Mound)", summary: "At 10th level, wild shape into a smilodon (pounce), a Large elemental or a shambling mound (poison, grapple).", guide: "druid#primal-druid"),
                (key: "druid/primal-druid/wild-shape-wolf", name: "Wild Shape (Wolf)", summary: "From 4th level, wild shape into a wolf (+2 Str, +20' speed, tripping bite) for an hour per level, 1/day plus 1 every two levels (8 at 18th).", guide: "druid#primal-druid"),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/primal-druid/animal-companion-primal-druid", "druid/primal-druid/primal-size", "druid/spontaneous-summoning"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"]),
                (level: 4, features: ["druid/primal-druid/wild-shape-wolf", "druid/resist-natures-lure"]),
                (level: 6, features: ["druid/primal-druid/wild-shape-leopard-small-elemental"]),
                (level: 8, features: ["druid/primal-druid/wild-shape-bear-medium-elemental"]),
                (level: 10, features: ["druid/primal-druid/wild-shape-smilodon-large-elemental-shambling-mound"]),
                (level: 12, features: ["druid/primal-druid/wild-shape-huge-elemental"]),
            ],
        ),
        (
            key: "druid/winter-child",
            name: "Winter Child",
            summary: "Cold druid (Lord of Nothing DLC) with a Blizzard Servant companion and the Ice subdomain; no wild shape or spontaneous summoning.",
            guide: "druid#winter-child",
            features: [
                (key: "druid/winter-child/arctic-native", name: "Arctic Native", summary: "From 4th level, cold resistance 5 (+5 every four levels, 25 at 20th) and immunity to dazzled.", guide: "druid#arctic-native"),
                (key: "druid/winter-child/blizzard-servant", name: "Blizzard Servant", summary: "From 4th level, a Blizzard Servant acts as your animal companion at level - 3, with a companion archetype and companion feats.", guide: "druid#blizzard-servant"),
                (key: "druid/winter-child/blizzard-servant-bound-souls", name: "Blizzard Servant - Bound Souls", summary: "At 16th, the servant grows Huge: +4 Str, +6 Dex, +2 Con, +2 natural armour, numbing cold, cold resistance 30; allies' hits on its hail targets add 2d6 cold.", guide: "druid#blizzard-servant-bound-souls"),
                (key: "druid/winter-child/blizzard-servant-crystallized-affinity", name: "Blizzard Servant - Crystallized Affinity", summary: "At 11th, the servant becomes Large with +4 Str, +4 Dex, +2 Con, +2 natural armour, DR 5/- and resist cold 20, and its Whirlwind of Hail stops hitting allies.", guide: "druid#blizzard-servant-crystallized-affinity"),
                (key: "druid/winter-child/blizzard-servant-winters-advance", name: "Blizzard Servant - Winter\'s Advance", summary: "At 6th, the servant grows Medium: +2 Str, +4 Dex, +2 Con and cold resistance 10.", guide: "druid#blizzard-servant-winters-advance"),
                (key: "druid/winter-child/call-a-feast", name: "Call a Feast", summary: "Your summoned creatures gain cold resistance 5; at 10th, 10 and Blink; at 15th, 15 and +2d6 cold damage on attacks.", guide: "druid#call-a-feast"),
                (key: "druid/winter-child/call-a-feast-biting-frost", name: "Call a Feast - Biting Frost", guide: "druid#winter-child"),
                (key: "druid/winter-child/call-a-feast-cover-of-snow", name: "Call a Feast - Cover of Snow", guide: "druid#winter-child"),
                (key: "druid/winter-child/flurry-form", name: "Flurry Form", summary: "At 20th level, elemental subtype, immunity to cold, trip and ground-based effects, and treated as a native outsider.", guide: "druid#flurry-form"),
                (key: "druid/winter-child/ice-in-the-blood", name: "Ice in the Blood", summary: "Locks your domain choice to the Ice subdomain.", guide: "druid#ice-in-the-blood"),
                (key: "druid/winter-child/snowcaster", name: "Snowcaster", summary: "From 9th level, turn your spells' damage into cold as a swift action.", guide: "druid#snowcaster"),
            ],
            selections: [
                (
                    key: "druid/winter-child/domain",
                    name: "Domain (Winter Child)",
                    summary: "A Winter Child must take the Ice subdomain.",
                    guide: "druid#winter-child",
                    option_levels: ["druid"],
                    options: [],
                    shared_options: [
                        "cleric/domain/ice",
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/nature-sense", "druid/winter-child/call-a-feast", "druid/winter-child/ice-in-the-blood"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/winter-child/domain"]),
                (level: 4, features: ["druid/winter-child/arctic-native", "druid/winter-child/blizzard-servant"]),
                (level: 6, features: ["druid/winter-child/blizzard-servant-winters-advance"]),
                (level: 8),
                (level: 9, features: ["druid/winter-child/snowcaster"]),
                (level: 10, features: ["druid/winter-child/call-a-feast-cover-of-snow"]),
                (level: 11, features: ["druid/winter-child/blizzard-servant-crystallized-affinity"]),
                (level: 12),
                (level: 15, features: ["druid/winter-child/call-a-feast-biting-frost"]),
                (level: 16, features: ["druid/winter-child/blizzard-servant-bound-souls"]),
                (level: 20, features: ["druid/winter-child/flurry-form"]),
