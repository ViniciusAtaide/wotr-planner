        (
            key: "druid/winter-child",
            blueprint: "9f835c539f6e4a96a7b64461f4267d06",
            name: "Winter Child",
            summary: "Cold druid (Lord of Nothing DLC) with a Blizzard Servant companion and the Ice subdomain; no wild shape or spontaneous summoning.",
            guide: "druid#winter-child",
            features: [
                (key: "druid/winter-child/arctic-native", blueprint: "776190c771e2487886ab1de9dfa8f2f1", name: "Arctic Native", summary: "From 4th level, cold resistance 5 (+5 every four levels, 25 at 20th) and immunity to dazzled.", guide: "druid#arctic-native"),
                (key: "druid/winter-child/blizzard-servant", blueprint: "025d5a55f50f44d2a3db30f9e8854bdf", name: "Blizzard Servant", summary: "From 4th level, a Blizzard Servant acts as your animal companion at level - 3, with a companion archetype and companion feats.", guide: "druid#blizzard-servant"),
                (key: "druid/winter-child/blizzard-servant-bound-souls", blueprint: "8e82285ace9e4bc5835c4258425f65c4", name: "Blizzard Servant - Bound Souls", summary: "At 16th, the servant grows Huge: +4 Str, +6 Dex, +2 Con, +2 natural armour, numbing cold, cold resistance 30; allies' hits on its hail targets add 2d6 cold.", guide: "druid#blizzard-servant-bound-souls"),
                (key: "druid/winter-child/blizzard-servant-crystallized-affinity", blueprint: "4bdb7506054f484296a3f1582de090b5", name: "Blizzard Servant - Crystallized Affinity", summary: "At 11th, the servant becomes Large with +4 Str, +4 Dex, +2 Con, +2 natural armour, DR 5/- and resist cold 20, and its Whirlwind of Hail stops hitting allies.", guide: "druid#blizzard-servant-crystallized-affinity"),
                (key: "druid/winter-child/blizzard-servant-winters-advance", blueprint: "a3e2972bb89b450ea6aab160fcb451c6", name: "Blizzard Servant - Winter\'s Advance", summary: "At 6th, the servant grows Medium: +2 Str, +4 Dex, +2 Con and cold resistance 10.", guide: "druid#blizzard-servant-winters-advance"),
                (key: "druid/winter-child/call-a-feast", blueprint: "bfe548bd90d4476c8afde9a0667384cd", name: "Call a Feast", summary: "Your summoned creatures gain cold resistance 5; at 10th, 10 and Blink; at 15th, 15 and +2d6 cold damage on attacks.", guide: "druid#call-a-feast"),
                (key: "druid/winter-child/call-a-feast-biting-frost", blueprint: "a78be8dba1274689b8a97b08a3069087", name: "Call a Feast - Biting Frost", guide: "druid#winter-child"),
                (key: "druid/winter-child/call-a-feast-cover-of-snow", blueprint: "4a64c3265d5e490eadb33c4f33382992", name: "Call a Feast - Cover of Snow", guide: "druid#winter-child"),
                (key: "druid/winter-child/flurry-form", blueprint: "1e272fa81008483bb6c7ed18f368a5ed", name: "Flurry Form", summary: "At 20th level, elemental subtype, immunity to cold, trip and ground-based effects, and treated as a native outsider.", guide: "druid#flurry-form"),
                (key: "druid/winter-child/ice-in-the-blood", blueprint: "79922e274bf4444b93ea77ae0f876bd2", name: "Ice in the Blood", summary: "Locks your domain choice to the Ice subdomain.", guide: "druid#ice-in-the-blood"),
                (key: "druid/winter-child/snowcaster", blueprint: "e2187ff69fdb4914b4357d7565ed005c", name: "Snowcaster", summary: "From 9th level, turn your spells' damage into cold as a swift action.", guide: "druid#snowcaster"),
            ],
            selections: [
                (
                    key: "druid/winter-child/domain",
                    blueprint: "79922e274bf4444b93ea77ae0f876bd2",
                    name: "Domain (Winter Child)",
                    summary: "A Winter Child must take the Ice subdomain.",
                    guide: "druid#winter-child",
                    option_levels: ["druid"],
                    options: [],
                    shared_options: [
                        "cleric/domain/ice",
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["druid/druid-proficiencies", "druid/nature-sense", "druid/winter-child/call-a-feast", "druid/winter-child/ice-in-the-blood"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency"], selections: ["druid/winter-child/domain"]),
                (level: 4, features: ["druid/winter-child/arctic-native", "druid/winter-child/blizzard-servant"]),
                (level: 6, features: ["druid/winter-child/blizzard-servant-winters-advance"]),
                (level: 8, features: ["druid/winter-child/arctic-native"]),
                (level: 9, features: ["druid/winter-child/snowcaster"]),
                (level: 10, features: ["druid/winter-child/call-a-feast-cover-of-snow"]),
                (level: 11, features: ["druid/winter-child/blizzard-servant-crystallized-affinity"]),
                (level: 12, features: ["druid/winter-child/arctic-native"]),
                (level: 14),
                (level: 15, features: ["druid/winter-child/call-a-feast-biting-frost"]),
                (level: 16, features: ["druid/winter-child/arctic-native", "druid/winter-child/blizzard-servant-bound-souls"]),
                (level: 18),
                (level: 20, features: ["druid/winter-child/arctic-native", "druid/winter-child/flurry-form"]),
            ],
        ),
    ],
