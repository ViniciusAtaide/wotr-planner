                (key: "warpriest/disenchanter/bonus-feats-9", name: "Bonus Feat (Disenchanter, from level 9)", guide: "warpriest#bonus-feat-disenchanter", ignores_prerequisites: true, feats: ["dispel-synergy", "great-fortitude", "improved-great-fortitude", "improved-iron-will", "improved-lightning-reflexes", "iron-will", "lightning-reflexes", "skill-focus", "spell-focus"]),
