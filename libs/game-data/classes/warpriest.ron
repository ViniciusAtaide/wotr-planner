            name: "Shieldbearer",
            summary: "Shield-focused warpriest who trades armour bonuses for shield bonuses; their shield counts as their sacred weapon.",
            guide: "warpriest#shieldbearer",
            features: [
                (key: "warpriest/shieldbearer/channel-energy-shieldbearer", name: "Channel Energy (Shieldbearer)", summary: "Channels energy only while holding a shield, as a 30' cone.", guide: "warpriest#channel-energy-shieldbearer"),
                (key: "warpriest/shieldbearer/sacred-shield", name: "Sacred Shield", summary: "The shield counts as a sacred weapon; from 4th, swift action for +1 shield enhancement (+5 at 20th) or spell resistance or fortification.", guide: "warpriest#sacred-shield"),
                (key: "warpriest/shieldbearer/sacred-weapon-shieldbearer", name: "Sacred Weapon (Shieldbearer)", summary: "From 7th level, +1 enhancement to weapons you have Weapon Focus in, +1 every three levels (+5 at 19th).", guide: "warpriest#sacred-weapon-shieldbearer"),
                (key: "warpriest/shieldbearer/shield-adept", name: "Shield Adept", summary: "Add your shield bonus to concentration checks when casting defensively.", guide: "warpriest#shield-adept"),
