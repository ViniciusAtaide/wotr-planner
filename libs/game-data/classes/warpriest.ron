        (
            key: "warpriest/mantis-zealot",
            name: "Mantis Zealot",
            summary: "Warpriest of Achaekek (Dance of Masks DLC) with powers tied to their sawtooth sabers; no channel energy or armour enchanting.",
            guide: "warpriest#mantis-zealot",
            prerequisite: Deity("achaekek"),
            features: [
                (key: "warpriest/mantis-zealot/aspect-of-the-mantis", name: "Aspect of the Mantis", summary: "At 20th, once a day for 1 minute: DR 10/good, a 2d6 bite giving a negative level, bleeding saber hits and a teleport attack on each kill.", guide: "warpriest#aspect-of-the-mantis"),
                (key: "warpriest/mantis-zealot/deadly-fascination", name: "Deadly Fascination", summary: "From 3rd level, each kill forces foes within 30' to make a Will save or be fascinated; harder with two sabres or Red Shroud.", guide: "warpriest#deadly-fascination"),
                (key: "warpriest/mantis-zealot/fading", name: "Fading", summary: "From 7th level, Red Shroud makes you partly ethereal: attacks and targeted spells miss you 20% of the time, +10% at 10th, 13th, 16th and 19th (60%).", guide: "warpriest#fading"),
                (key: "warpriest/mantis-zealot/mantis-swarm", name: "Mantis Swarm", summary: "From 5th level, Red Shroud makes adjacent foes save or bleed 1d6 a turn; sawtooth sabers deal +1d6 to bleeding foes (more at 11th and 18th).", guide: "warpriest#mantis-swarm"),
                (key: "warpriest/mantis-zealot/red-shroud", name: "Red Shroud", summary: "Move action: mantis cloud gives +1 dodge AC (+1 every four levels) and fast healing equal to BAB, for Dex mod minutes a day.", guide: "warpriest#red-shroud"),
                (key: "warpriest/mantis-zealot/red-shroud-free-action", name: "Red Shroud (Free Action)", summary: "At 13th level, Red Shroud can be raised as a free action.", guide: "warpriest#mantis-zealot"),
                (key: "warpriest/mantis-zealot/red-shroud-swift-action", name: "Red Shroud (Swift Action)", summary: "At 7th level, Red Shroud can be raised as a swift action.", guide: "warpriest#mantis-zealot"),
            ],
            levels: [
                (level: 1, features: ["warpriest/mantis-zealot/red-shroud", "warpriest/sacred-weapon", "warpriest/spontaneous-casting"], feats: ["armor-proficiency-light-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"], feats_for: [(feat: "exotic-weapon-proficiency", value: Weapon("sawtooth-saber")), (feat: "weapon-focus", value: Weapon("sawtooth-saber"))]),
                (level: 3, features: ["warpriest/mantis-zealot/deadly-fascination"]),
                (level: 4, features: ["warpriest/mantis-zealot/mantis-swarm", "warpriest/sacred-weapon"], feats_for: [(feat: "weapon-specialization", value: Weapon("sawtooth-saber"))]),
                (level: 7, features: ["warpriest/mantis-zealot/fading", "warpriest/mantis-zealot/red-shroud-swift-action"]),
                (level: 8, features: ["warpriest/sacred-weapon"], feats_for: [(feat: "greater-weapon-focus", value: Weapon("sawtooth-saber"))]),
                (level: 9),
                (level: 10),
                (level: 12, features: ["warpriest/sacred-weapon"], feats_for: [(feat: "greater-weapon-specialization", value: Weapon("sawtooth-saber"))]),
                (level: 13, features: ["warpriest/mantis-zealot/red-shroud-free-action"]),
                (level: 16, features: ["warpriest/sacred-weapon"]),
                (level: 19),
