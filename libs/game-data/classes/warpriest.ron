        (
            key: "warpriest/feral-champion",
            name: "Feral Champion",
            summary: "Nature warpriest (Erastil, Gozreh or the Green Faith only) who gains wild shape but can't enchant their armour.",
            prerequisite: Any([Deity("erastil"), Deity("gozreh"), Deity("green-faith")]),
            guide: "warpriest#feral-champion",
            features: [
                (key: "warpriest/feral-champion/wild-shape-bear", name: "Wild Shape (Bear)", summary: "From 11th level, wild shape into a bear; wild shape uses level - 3 as druid level.", guide: "warpriest#feral-champion"),
                (key: "warpriest/feral-champion/wild-shape-leopard", name: "Wild Shape (Leopard)", summary: "From 9th level, wild shape into a leopard; wild shape uses level - 3 as druid level.", guide: "warpriest#feral-champion"),
                (key: "warpriest/feral-champion/wild-shape-smilodon", name: "Wild Shape (Smilodon)", summary: "From 13th level, wild shape into a smilodon; wild shape uses level - 3 as druid level.", guide: "warpriest#feral-champion"),
                (key: "warpriest/feral-champion/wild-shape-wolf", name: "Wild Shape (Wolf)", summary: "From 7th level, wild shape into a wolf, 1/day plus 1 every four levels (4 at 19th); uses level - 3 as druid level.", guide: "warpriest#feral-champion"),
            ],
