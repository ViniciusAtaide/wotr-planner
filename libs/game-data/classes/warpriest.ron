Class(
    key: "warpriest",
    name: "Warpriest",
    summary: "Divine warrior-caster with blessings and a sacred weapon; Str, Con and Wis, 3/4 BAB, prepared spells to 6th level, good Fortitude and Will, 6 HP a level.",
    guide: "warpriest",
    skill_points: 2,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    save_exceptions: [(level: 20, save: Will, value: 11)],
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-religion", "persuasion"],
    prerequisite: Worships,
    features: [
        (key: "warpriest/aspect-of-war", name: "Aspect of War", summary: "Once a day as a swift action for 1 minute: BAB becomes 20, DR 10/-, full speed in any armour or load, and blessings don't use up daily uses.", guide: "warpriest#aspect-of-war"),
        (key: "warpriest/blessings/air-domain/major-blessing", name: "Major Blessing (Air)", summary: "From 10th level, an ally flies (as Wings) for 1 minute and deals extra electricity damage equal to your level on a successful charge.", guide: "warpriest#air-domain"),
        (key: "warpriest/blessings/air-domain/minor-blessing", name: "Minor Blessing (Air)", summary: "For 1 minute, a touched ally can make ranged attacks without provoking attacks of opportunity.", guide: "warpriest#air-domain"),
        (key: "warpriest/blessings/animal-domain/major-blessing", name: "Major Blessing (Animal)", summary: "From 10th level, summon an ally as Summon Nature's Ally V for 1 minute, one step stronger every two levels (IX at 18th).", guide: "warpriest#animal-domain"),
        (key: "warpriest/blessings/animal-domain/minor-blessing", name: "Minor Blessing (Animal)", summary: "An ally gains two claw attacks (1d6, or 1d4 if Small) for 1 minute.", guide: "warpriest#animal-domain"),
        (key: "warpriest/blessings/chaos-domain/major-blessing", name: "Major Blessing (Chaos)", summary: "From 10th level, summon an ally as Summon Monster IV for 1 minute, one step stronger every two levels (IX at 20th).", guide: "warpriest#chaos-domain"),
        (key: "warpriest/blessings/chaos-domain/minor-blessing", name: "Minor Blessing (Chaos)", summary: "For 1 minute an ally's attacks deal +1d6 damage to lawful creatures and count as chaotic against DR.", guide: "warpriest#chaos-domain"),
        (key: "warpriest/blessings/darkness-domain/major-blessing", name: "Major Blessing (Darkness)", summary: "From 10th level, an enemy within 30' that fails a Will save is blinded for 1 minute.", guide: "warpriest#darkness-domain"),
        (key: "warpriest/blessings/darkness-domain/minor-blessing", name: "Minor Blessing (Darkness)", summary: "Give an ally 20% concealment for 1 minute.", guide: "warpriest#darkness-domain"),
        (key: "warpriest/blessings/death-domain/major-blessing", name: "Major Blessing (Death)", summary: "From 10th level, a melee touch (or, as a swift action, your next melee attack) gives the target 1 negative level for 1 minute.", guide: "warpriest#death-domain"),
        (key: "warpriest/blessings/death-domain/minor-blessing", name: "Minor Blessing (Death)", summary: "For 1 minute: +4 on Intimidate and +2 profane on saves against disease, mind-affecting, paralysis, poison and stun.", guide: "warpriest#death-domain"),
        (key: "warpriest/blessings/destruction/major-blessing", name: "Major Blessing (Destruction)", summary: "From 10th level, an ally gets +4 to confirm critical hits, and crits or sneak attacks against them have a 50% chance to become normal hits.", guide: "warpriest#destruction"),
        (key: "warpriest/blessings/destruction/minor-blessing", name: "Minor Blessing (Destruction)", summary: "An ally gains a morale bonus on damage equal to half your level for 1 minute.", guide: "warpriest#destruction"),
        (key: "warpriest/blessings/earth/major-blessing", name: "Major Blessing (Earth)", summary: "From 10th level, an ally gains DR 1/- for 1 minute, +1 every two levels (DR 5/- at 18th).", guide: "warpriest#earth"),
        (key: "warpriest/blessings/earth/minor-blessing", name: "Minor Blessing (Earth)", summary: "A weapon deals an extra 1d4 acid damage for 1 minute.", guide: "warpriest#earth"),
        (key: "warpriest/blessings/evil-domain/major-blessing", name: "Major Blessing (Evil)", summary: "From 10th level, summon an ally as Summon Monster IV for 1 minute, one step stronger every two levels (IX at 20th).", guide: "warpriest#evil-domain"),
        (key: "warpriest/blessings/evil-domain/minor-blessing", name: "Minor Blessing (Evil)", summary: "For 1 minute an ally's attacks deal +1d6 damage to good creatures and count as evil against DR.", guide: "warpriest#evil-domain"),
        (key: "warpriest/blessings/fire/major-blessing", name: "Major Blessing (Fire)", summary: "From 10th level, an ally gains cold resistance equal to your level for 1 minute.", guide: "warpriest#fire"),
        (key: "warpriest/blessings/fire/minor-blessing", name: "Minor Blessing (Fire)", summary: "A weapon deals an extra 1d4 acid damage for 1 minute.", guide: "warpriest#fire"),
        (key: "warpriest/blessings/good-domain/major-blessing", name: "Major Blessing (Good)", summary: "From 10th level, summon an ally as Summon Monster IV for 1 minute, one step stronger every two levels (IX at 20th).", guide: "warpriest#good-domain"),
        (key: "warpriest/blessings/good-domain/minor-blessing", name: "Minor Blessing (Good)", summary: "For 1 minute an ally's attacks deal +1d6 damage to evil creatures and count as good against DR.", guide: "warpriest#good-domain"),
        (key: "warpriest/blessings/healing-domain/major-blessing", name: "Major Blessing (Healing)", summary: "From 10th level, an ally gains fast healing 3 for 1 minute.", guide: "warpriest#healing-domain"),
        (key: "warpriest/blessings/healing-domain/minor-blessing", name: "Minor Blessing (Healing)", summary: "As a swift action, your next cure spell is empowered.", guide: "warpriest#healing-domain"),
        (key: "warpriest/blessings/law-domain/major-blessing", name: "Major Blessing (Law)", summary: "From 10th level, as a swift action, allies within 30' gain +4 sacred to AC and saves against chaotic opponents.", guide: "warpriest#law-domain"),
        (key: "warpriest/blessings/law-domain/minor-blessing", name: "Minor Blessing (Law)", summary: "For 1 minute an ally's attacks deal +1d6 damage to chaotic creatures and count as lawful against DR.", guide: "warpriest#law-domain"),
        (key: "warpriest/blessings/liberation/major-blessing", name: "Major Blessing (Liberation)", summary: "From 10th level, as a swift action, all allies within 30' gain Freedom of Movement for 1 round.", guide: "warpriest#liberation"),
        (key: "warpriest/blessings/liberation/minor-blessing", name: "Minor Blessing (Liberation)", summary: "As a swift action, gain Freedom of Movement for 1 round.", guide: "warpriest#liberation"),
        (key: "warpriest/blessings/luck/major-blessing", name: "Major Blessing (Luck)", summary: "From 10th level, a cursed enemy rolls twice and keeps the lower result on ability checks, attacks, saves and skill checks for 1 round.", guide: "warpriest#luck"),
        (key: "warpriest/blessings/luck/minor-blessing", name: "Minor Blessing (Luck)", summary: "Touch an ally: for 1 round they roll twice on ability checks, attacks, saves and skill checks.", guide: "warpriest#luck"),
        (key: "warpriest/blessings/madness/major-blessing", name: "Major Blessing (Madness)", summary: "From 10th level, choose what all confused creatures within 30' do for 1 round, such as attacking themselves.", guide: "warpriest#madness"),
        (key: "warpriest/blessings/madness/minor-blessing", name: "Minor Blessing (Madness)", summary: "As a swift action, a frightened, panicked or paralysed creature within 30' is instead confused for 1 round, attacking itself or the nearest foe.", guide: "warpriest#madness"),
        (key: "warpriest/blessings/magic/major-blessing", name: "Major Blessing (Magic)", summary: "From 10th level, as a swift action, recall any spell you have cast.", guide: "warpriest#magic"),
        (key: "warpriest/blessings/magic/minor-blessing", name: "Minor Blessing (Magic)", summary: "Make a ranged attack up to 30' by throwing your melee weapon, with Wisdom added to the attack roll.", guide: "warpriest#magic"),
        (key: "warpriest/blessings/nobility/major-blessing", name: "Major Blessing (Nobility)", summary: "From 10th level, all allies within 30' gain +4 morale on attack rolls, skill checks and saves for 1 round.", guide: "warpriest#nobility"),
        (key: "warpriest/blessings/nobility/minor-blessing", name: "Minor Blessing (Nobility)", summary: "An ally gains +2 morale on attack rolls, skill checks and saves for 1 minute.", guide: "warpriest#nobility"),
        (key: "warpriest/blessings/protection/major-blessing", name: "Major Blessing (Protection)", summary: "From 10th level, allies within 30' gain resistance 10 to acid, cold, electricity, fire and sonic for 1 minute (20 from 15th).", guide: "warpriest#protection"),
        (key: "warpriest/blessings/protection/minor-blessing", name: "Minor Blessing (Protection)", summary: "Gain +1 sacred to AC and saves for 1 minute, +2 at 10th level and +3 at 20th.", guide: "warpriest#protection"),
        (key: "warpriest/blessings/repose/major-blessing", name: "Major Blessing (Repose)", summary: "From 10th level, as a swift action, a healing channel energy also damages undead for half the amount healed.", guide: "warpriest#repose"),
        (key: "warpriest/blessings/repose/minor-blessing", name: "Minor Blessing (Repose)", summary: "Melee touch staggers a target for 1 round (sleep if already staggered); undead are staggered for Wis mod rounds.", guide: "warpriest#repose"),
        (key: "warpriest/blessings/strength/major-blessing", name: "Major Blessing (Strength)", summary: "From 10th level, for 1 minute ignore medium and heavy armour speed penalties and add Str to saves against stagger, entangle and paralysis.", guide: "warpriest#strength"),
        (key: "warpriest/blessings/strength/minor-blessing", name: "Minor Blessing (Strength)", summary: "For 1 round, gain an enhancement bonus of half your level on Strength-based attacks, maneuvers, skill and ability checks.", guide: "warpriest#strength"),
        (key: "warpriest/blessings/sun/major-blessing", name: "Major Blessing (Sun)", summary: "From 10th level, a weapon gains flaming or undead bane for 1 minute; spend two blessings for both.", guide: "warpriest#sun"),
        (key: "warpriest/blessings/sun/minor-blessing", name: "Minor Blessing (Sun)", summary: "An opponent is blinded for 1 round, or only dazzled if it makes a Reflex save.", guide: "warpriest#sun"),
        (key: "warpriest/blessings/travel/major-blessing", name: "Major Blessing (Travel)", summary: "From 10th level, teleport up to 20' as a move action.", guide: "warpriest#travel"),
        (key: "warpriest/blessings/travel/minor-blessing", name: "Minor Blessing (Travel)", summary: "Ignore difficult terrain for 1 round.", guide: "warpriest#travel"),
        (key: "warpriest/blessings/trickery/major-blessing", name: "Major Blessing (Trickery)", summary: "From 10th level, as a swift action, gain Greater Invisibility for 1 round.", guide: "warpriest#trickery"),
        (key: "warpriest/blessings/trickery/minor-blessing", name: "Minor Blessing (Trickery)", summary: "Conjure an illusory duplicate that lasts 1 round per level unless it is destroyed first.", guide: "warpriest#trickery"),
        (key: "warpriest/blessings/water/major-blessing", name: "Major Blessing (Water)", summary: "From 10th level, an ally gains fire resistance equal to your level for 1 minute.", guide: "warpriest#water"),
        (key: "warpriest/blessings/water/minor-blessing", name: "Minor Blessing (Water)", summary: "A weapon deals an extra 1d4 cold damage for 1 minute.", guide: "warpriest#water"),
        (key: "warpriest/blessings/weather/major-blessing", name: "Major Blessing (Weather)", summary: "From 10th level, a 1-minute barrier gives ranged attacks against you a miss chance equal to twice your level.", guide: "warpriest#weather"),
        (key: "warpriest/blessings/weather/minor-blessing", name: "Minor Blessing (Weather)", summary: "A weapon deals an extra 1d4 electricity damage for 1 minute.", guide: "warpriest#weather"),
        (key: "warpriest/channel-energy", name: "Channel Energy", summary: "From 4th level, spend two Fervor to channel energy, healing or harming 1d6 plus 1d6 per 3 levels above 2nd (7d6 at 20th).", guide: "warpriest#channel-energy"),
        (key: "warpriest/fervor", name: "Fervor", summary: "Half level + Wis times a day: heal or harm 1d6, +1d6 per 3 more levels (7d6 at 20th), swift on yourself; or swift-cast a prepared spell on yourself.", guide: "warpriest#fervor"),
        (key: "warpriest/sacred-armor", name: "Sacred Armor", summary: "From 7th level, enhance your armour for minutes a day equal to your level, or add fortification, energy resistance or spell resistance instead.", guide: "warpriest#sacred-armor"),
        (key: "warpriest/sacred-weapon", name: "Sacred Weapon", summary: "Weapon Focus in a chosen weapon; it and your deity's weapon deal 1d6 to 3d6 by level, and from 4th you can enhance it as a swift action, rounds equal to level.", guide: "warpriest#sacred-weapon"),
        (key: "warpriest/spontaneous-casting", name: "Spontaneous Casting", summary: "Choose to convert prepared spells into cure spells or inflict spells of the same level.", guide: "warpriest#spontaneous-casting"),
    ],
    selections: [
        (
            key: "warpriest/blessings",
            deity_domains: Offered,
            name: "Blessings",
            summary: "Choose two blessings from your deity's domains; each gives a minor power and a major one at 10th, used 3 + 1 per two levels times a day.",
            guide: "warpriest#blessings",
            option_levels: ["warpriest"],
            options: [
                (
                    key: "warpriest/blessings/air-domain",
                    name: "Air Domain",
                    summary: "Minor: an ally's ranged attacks don't provoke for 1 minute. Major (10th): an ally flies for 1 minute and adds your level as electricity damage on charges.",
                    guide: "warpriest#air-domain",
                    domain: "cleric/domain/air",
                    levels: [
                        (level: 1, features: ["warpriest/blessings/air-domain/minor-blessing"]),
                        (level: 10, features: ["warpriest/blessings/air-domain/major-blessing"]),
                    ],
                ),
                (
                    key: "warpriest/blessings/animal-domain",
                    name: "Animal Domain",
                    summary: "Minor: an ally gains two 1d6 claws for 1 minute. Major (10th): summon an ally as Summon Nature's Ally V, rising to IX at 18th.",
                    guide: "warpriest#animal-domain",
                    domain: "cleric/domain/animal",
                    levels: [
                        (level: 1, features: ["warpriest/blessings/animal-domain/minor-blessing"]),
                        (level: 10, features: ["warpriest/blessings/animal-domain/major-blessing"]),
                    ],
                ),
                (
                    key: "warpriest/blessings/chaos-domain",
