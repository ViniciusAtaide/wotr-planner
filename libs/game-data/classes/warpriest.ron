Class(
    key: "warpriest",
    blueprint: "30b5e47d47a0e37438cc5a80c96cfb99",
    name: "Warpriest",
    summary: "Divine warrior-caster with blessings and a sacred weapon; Str, Con and Wis, 3/4 BAB, prepared spells to 6th level, good Fortitude and Will, 6 HP a level.",
    guide: "warpriest",
    skill_points: 2,
    casting_ability: Wisdom,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    save_exceptions: [(level: 20, save: Will, value: 11)],
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-religion", "persuasion"],
    prerequisite: Worships,
    features: [
        (key: "warpriest/aspect-of-war", blueprint: "65cc7abc21826a344aa156e2a40dcecc", name: "Aspect of War", summary: "Once a day as a swift action for 1 minute: BAB becomes 20, DR 10/-, full speed in any armour or load, and blessings don't use up daily uses.", guide: "warpriest#aspect-of-war"),
        (key: "warpriest/blessings/air-domain/major-blessing", blueprint: "eb61333a9d5957f42aaf8dbb12d22600", name: "Major Blessing (Air)", summary: "From 10th level, an ally flies (as Wings) for 1 minute and deals extra electricity damage equal to your level on a successful charge.", guide: "warpriest#air-domain"),
        (key: "warpriest/blessings/air-domain/minor-blessing", blueprint: "e1ff99dc3aeaa064e8eecde51c1c4773", name: "Minor Blessing (Air)", summary: "For 1 minute, a touched ally can make ranged attacks without provoking attacks of opportunity.", guide: "warpriest#air-domain"),
        (key: "warpriest/blessings/animal-domain/major-blessing", blueprint: "4a9feb61035b23447a83b52d401c3b2b", name: "Major Blessing (Animal)", summary: "From 10th level, summon an ally as Summon Nature's Ally V for 1 minute, one step stronger every two levels (IX at 18th).", guide: "warpriest#animal-domain"),
        (key: "warpriest/blessings/animal-domain/minor-blessing", blueprint: "9d991f8374c3def4cb4a6287f370814d", name: "Minor Blessing (Animal)", summary: "An ally gains two claw attacks (1d6, or 1d4 if Small) for 1 minute.", guide: "warpriest#animal-domain"),
        (key: "warpriest/blessings/chaos-domain/major-blessing", blueprint: "2067f183d94f69a418533c9611ed127e", name: "Major Blessing (Chaos)", summary: "From 10th level, summon an ally as Summon Monster IV for 1 minute, one step stronger every two levels (IX at 20th).", guide: "warpriest#chaos-domain"),
        (key: "warpriest/blessings/chaos-domain/minor-blessing", blueprint: "528e316f9f092954b9e38d3a82b1634a", name: "Minor Blessing (Chaos)", summary: "For 1 minute an ally's attacks deal +1d6 damage to lawful creatures and count as chaotic against DR.", guide: "warpriest#chaos-domain"),
        (key: "warpriest/blessings/darkness-domain/major-blessing", blueprint: "13f4b8e669dd1934dab447480f1b8e48", name: "Major Blessing (Darkness)", summary: "From 10th level, an enemy within 30' that fails a Will save is blinded for 1 minute.", guide: "warpriest#darkness-domain"),
        (key: "warpriest/blessings/darkness-domain/minor-blessing", blueprint: "3ed6cd88caecec944b837f57b9be176f", name: "Minor Blessing (Darkness)", summary: "Give an ally 20% concealment for 1 minute.", guide: "warpriest#darkness-domain"),
        (key: "warpriest/blessings/death-domain/major-blessing", blueprint: "751fddfe9096fdd41b2104b0cd2a68de", name: "Major Blessing (Death)", summary: "From 10th level, a melee touch (or, as a swift action, your next melee attack) gives the target 1 negative level for 1 minute.", guide: "warpriest#death-domain"),
        (key: "warpriest/blessings/death-domain/minor-blessing", blueprint: "6d11e8b00add90c4f93c2ad6d12885f7", name: "Minor Blessing (Death)", summary: "For 1 minute: +4 on Intimidate and +2 profane on saves against disease, mind-affecting, paralysis, poison and stun.", guide: "warpriest#death-domain"),
        (key: "warpriest/blessings/destruction/major-blessing", blueprint: "11cb0f4df754cde419e233cb4d179f9c", name: "Major Blessing (Destruction)", summary: "From 10th level, an ally gets +4 to confirm critical hits, and crits or sneak attacks against them have a 50% chance to become normal hits.", guide: "warpriest#destruction"),
        (key: "warpriest/blessings/destruction/minor-blessing", blueprint: "dd5e75a02e4563e44a0931c6f46fb0a7", name: "Minor Blessing (Destruction)", summary: "An ally gains a morale bonus on damage equal to half your level for 1 minute.", guide: "warpriest#destruction"),
        (key: "warpriest/blessings/earth/major-blessing", blueprint: "393424a93a6d2614cb93f46a48d97bf2", name: "Major Blessing (Earth)", summary: "From 10th level, an ally gains DR 1/- for 1 minute, +1 every two levels (DR 5/- at 18th).", guide: "warpriest#earth"),
        (key: "warpriest/blessings/earth/minor-blessing", blueprint: "73c37a22bc9a523409a47218d507acf6", name: "Minor Blessing (Earth)", summary: "A weapon deals an extra 1d4 acid damage for 1 minute.", guide: "warpriest#earth"),
        (key: "warpriest/blessings/evil-domain/major-blessing", blueprint: "883897b5ba5a0144fb051a4ad1b84d97", name: "Major Blessing (Evil)", summary: "From 10th level, summon an ally as Summon Monster IV for 1 minute, one step stronger every two levels (IX at 20th).", guide: "warpriest#evil-domain"),
        (key: "warpriest/blessings/evil-domain/minor-blessing", blueprint: "f38f3abf6ca3a07499a61f96e342bb16", name: "Minor Blessing (Evil)", summary: "For 1 minute an ally's attacks deal +1d6 damage to good creatures and count as evil against DR.", guide: "warpriest#evil-domain"),
        (key: "warpriest/blessings/fire/major-blessing", blueprint: "f5b993b62c3ef064ba9f35d1f21611d8", name: "Major Blessing (Fire)", summary: "From 10th level, an ally gains cold resistance equal to your level for 1 minute.", guide: "warpriest#fire"),
        (key: "warpriest/blessings/fire/minor-blessing", blueprint: "2368212fa3856d74589e924d3e2074d8", name: "Minor Blessing (Fire)", summary: "A weapon deals an extra 1d4 acid damage for 1 minute.", guide: "warpriest#fire"),
        (key: "warpriest/blessings/good-domain/major-blessing", blueprint: "c487c937daf9d9d4183b6d6cef33c8fd", name: "Major Blessing (Good)", summary: "From 10th level, summon an ally as Summon Monster IV for 1 minute, one step stronger every two levels (IX at 20th).", guide: "warpriest#good-domain"),
        (key: "warpriest/blessings/good-domain/minor-blessing", blueprint: "60a85144ed37e3a45b343d291dc48079", name: "Minor Blessing (Good)", summary: "For 1 minute an ally's attacks deal +1d6 damage to evil creatures and count as good against DR.", guide: "warpriest#good-domain"),
        (key: "warpriest/blessings/healing-domain/major-blessing", blueprint: "4ef6d989132eaf7438df8acb9aa92458", name: "Major Blessing (Healing)", summary: "From 10th level, an ally gains fast healing 3 for 1 minute.", guide: "warpriest#healing-domain"),
        (key: "warpriest/blessings/healing-domain/minor-blessing", blueprint: "f3881a1a7b44dc74c9d76907c94e49f2", name: "Minor Blessing (Healing)", summary: "As a swift action, your next cure spell is empowered.", guide: "warpriest#healing-domain"),
        (key: "warpriest/blessings/law-domain/major-blessing", blueprint: "2bb9978c134e2e34a8812f6d42144d57", name: "Major Blessing (Law)", summary: "From 10th level, as a swift action, allies within 30' gain +4 sacred to AC and saves against chaotic opponents.", guide: "warpriest#law-domain"),
        (key: "warpriest/blessings/law-domain/minor-blessing", blueprint: "9c49504e2e4c66d4aa341348356b47a8", name: "Minor Blessing (Law)", summary: "For 1 minute an ally's attacks deal +1d6 damage to chaotic creatures and count as lawful against DR.", guide: "warpriest#law-domain"),
        (key: "warpriest/blessings/liberation/major-blessing", blueprint: "83413ca09df2e144bbf945a2eef0337c", name: "Major Blessing (Liberation)", summary: "From 10th level, as a swift action, all allies within 30' gain Freedom of Movement for 1 round.", guide: "warpriest#liberation"),
        (key: "warpriest/blessings/liberation/minor-blessing", blueprint: "61061faf477d67b43b6dedb3e8f205d7", name: "Minor Blessing (Liberation)", summary: "As a swift action, gain Freedom of Movement for 1 round.", guide: "warpriest#liberation"),
        (key: "warpriest/blessings/luck/major-blessing", blueprint: "0b59acd4d1fffa34da9fc91da05dd398", name: "Major Blessing (Luck)", summary: "From 10th level, a cursed enemy rolls twice and keeps the lower result on ability checks, attacks, saves and skill checks for 1 round.", guide: "warpriest#luck"),
        (key: "warpriest/blessings/luck/minor-blessing", blueprint: "70654ee784fffa74489933a0d2047bbd", name: "Minor Blessing (Luck)", summary: "Touch an ally: for 1 round they roll twice on ability checks, attacks, saves and skill checks.", guide: "warpriest#luck"),
        (key: "warpriest/blessings/madness/major-blessing", blueprint: "fd4e07ed255348858fea4f5195b49768", name: "Major Blessing (Madness)", summary: "From 10th level, choose what all confused creatures within 30' do for 1 round, such as attacking themselves.", guide: "warpriest#madness"),
        (key: "warpriest/blessings/madness/minor-blessing", blueprint: "a99916a8aad2414f970072db7b760c48", name: "Minor Blessing (Madness)", summary: "As a swift action, a frightened, panicked or paralysed creature within 30' is instead confused for 1 round, attacking itself or the nearest foe.", guide: "warpriest#madness"),
        (key: "warpriest/blessings/magic/major-blessing", blueprint: "7381f6ea613383041a50f715c96bd644", name: "Major Blessing (Magic)", summary: "From 10th level, as a swift action, recall any spell you have cast.", guide: "warpriest#magic"),
        (key: "warpriest/blessings/magic/minor-blessing", blueprint: "1754ff61a0805714fa2b89c8c1bb87ad", name: "Minor Blessing (Magic)", summary: "Make a ranged attack up to 30' by throwing your melee weapon, with Wisdom added to the attack roll.", guide: "warpriest#magic"),
        (key: "warpriest/blessings/nobility/major-blessing", blueprint: "93284f69850f62e4b9f1e0b7bd14cf21", name: "Major Blessing (Nobility)", summary: "From 10th level, all allies within 30' gain +4 morale on attack rolls, skill checks and saves for 1 round.", guide: "warpriest#nobility"),
        (key: "warpriest/blessings/nobility/minor-blessing", blueprint: "f52af97d05e5de34ea6e0d1b0af740ea", name: "Minor Blessing (Nobility)", summary: "An ally gains +2 morale on attack rolls, skill checks and saves for 1 minute.", guide: "warpriest#nobility"),
        (key: "warpriest/blessings/protection/major-blessing", blueprint: "46039a223264d284fb1af7d21aaa994a", name: "Major Blessing (Protection)", summary: "From 10th level, allies within 30' gain resistance 10 to acid, cold, electricity, fire and sonic for 1 minute (20 from 15th).", guide: "warpriest#protection"),
        (key: "warpriest/blessings/protection/minor-blessing", blueprint: "c6a3fa9d8d7f942499e4909cd01ca22d", name: "Minor Blessing (Protection)", summary: "Gain +1 sacred to AC and saves for 1 minute, +2 at 10th level and +3 at 20th.", guide: "warpriest#protection"),
        (key: "warpriest/blessings/repose/major-blessing", blueprint: "bc55c18711462b74ca5ff977931a9182", name: "Major Blessing (Repose)", summary: "From 10th level, as a swift action, a healing channel energy also damages undead for half the amount healed.", guide: "warpriest#repose"),
        (key: "warpriest/blessings/repose/minor-blessing", blueprint: "64a416082927673409deb330af04d6d2", name: "Minor Blessing (Repose)", summary: "Melee touch staggers a target for 1 round (sleep if already staggered); undead are staggered for Wis mod rounds.", guide: "warpriest#repose"),
        (key: "warpriest/blessings/strength/major-blessing", blueprint: "53261225db472664b841d7930f6ffe76", name: "Major Blessing (Strength)", summary: "From 10th level, for 1 minute ignore medium and heavy armour speed penalties and add Str to saves against stagger, entangle and paralysis.", guide: "warpriest#strength"),
        (key: "warpriest/blessings/strength/minor-blessing", blueprint: "44f9162736a5c2040ae8ede853bc6639", name: "Minor Blessing (Strength)", summary: "For 1 round, gain an enhancement bonus of half your level on Strength-based attacks, maneuvers, skill and ability checks.", guide: "warpriest#strength"),
        (key: "warpriest/blessings/sun/major-blessing", blueprint: "ec6ec8d94e3a5be4e9b10b25db424617", name: "Major Blessing (Sun)", summary: "From 10th level, a weapon gains flaming or undead bane for 1 minute; spend two blessings for both.", guide: "warpriest#sun"),
        (key: "warpriest/blessings/sun/minor-blessing", blueprint: "ba825e3c77acaec4386e00f691f8f3be", name: "Minor Blessing (Sun)", summary: "An opponent is blinded for 1 round, or only dazzled if it makes a Reflex save.", guide: "warpriest#sun"),
        (key: "warpriest/blessings/travel/major-blessing", blueprint: "c52e9a35c5332204aa257352643de1ce", name: "Major Blessing (Travel)", summary: "From 10th level, teleport up to 20' as a move action.", guide: "warpriest#travel"),
        (key: "warpriest/blessings/travel/minor-blessing", blueprint: "87641a8efec53d64d853ecc436234dce", name: "Minor Blessing (Travel)", summary: "Ignore difficult terrain for 1 round.", guide: "warpriest#travel"),
        (key: "warpriest/blessings/trickery/major-blessing", blueprint: "df86f453faeee12408472114fd2eda9f", name: "Major Blessing (Trickery)", summary: "From 10th level, as a swift action, gain Greater Invisibility for 1 round.", guide: "warpriest#trickery"),
        (key: "warpriest/blessings/trickery/minor-blessing", blueprint: "a8e7abcad0cf8384b9f12c3b075b5cae", name: "Minor Blessing (Trickery)", summary: "Conjure an illusory duplicate that lasts 1 round per level unless it is destroyed first.", guide: "warpriest#trickery"),
        (key: "warpriest/blessings/water/major-blessing", blueprint: "d7b5bdf4f8cd6b8449f9e8108d0c74e4", name: "Major Blessing (Water)", summary: "From 10th level, an ally gains fire resistance equal to your level for 1 minute.", guide: "warpriest#water"),
        (key: "warpriest/blessings/water/minor-blessing", blueprint: "0f457943bb99f9b48b709c90bfc0467e", name: "Minor Blessing (Water)", summary: "A weapon deals an extra 1d4 cold damage for 1 minute.", guide: "warpriest#water"),
        (key: "warpriest/blessings/weather/major-blessing", blueprint: "afedfb07c57dbc44aa98427be868eccb", name: "Major Blessing (Weather)", summary: "From 10th level, a 1-minute barrier gives ranged attacks against you a miss chance equal to twice your level.", guide: "warpriest#weather"),
        (key: "warpriest/blessings/weather/minor-blessing", blueprint: "4172d92c598de1d47aa2c0dd51c05e24", name: "Minor Blessing (Weather)", summary: "A weapon deals an extra 1d4 electricity damage for 1 minute.", guide: "warpriest#weather"),
        (key: "warpriest/channel-energy", blueprint: "1a871294410971745bba12ef11e41f6e", name: "Channel Energy", summary: "From 4th level, spend two Fervor to channel energy, healing or harming 1d6 plus 1d6 per 3 levels above 2nd (7d6 at 20th).", guide: "warpriest#channel-energy"),
        (key: "warpriest/fervor", blueprint: "2d5140fd9f19a8e41be32d300eea2e18", name: "Fervor", summary: "Half level + Wis times a day: heal or harm 1d6, +1d6 per 3 more levels (7d6 at 20th), swift on yourself; or swift-cast a prepared spell on yourself.", guide: "warpriest#fervor"),
        (key: "warpriest/sacred-armor", blueprint: "35e2d9525c240ce4c8ae47dd387b6e53", name: "Sacred Armor", summary: "From 7th level, enhance your armour for minutes a day equal to your level, or add fortification, energy resistance or spell resistance instead.", guide: "warpriest#sacred-armor"),
        (key: "warpriest/sacred-weapon", blueprint: "8eb5505ae69cc174fb1781134f949e5f", name: "Sacred Weapon", summary: "Weapon Focus in a chosen weapon; it and your deity's weapon deal 1d6 to 3d6 by level, and from 4th you can enhance it as a swift action, rounds equal to level.", guide: "warpriest#sacred-weapon"),
        (key: "warpriest/spontaneous-casting", blueprint: "2d26a3364d65c4e4e9fb470172f638a9", name: "Spontaneous Casting", summary: "Choose to convert prepared spells into cure spells or inflict spells of the same level.", guide: "warpriest#spontaneous-casting"),
    ],
