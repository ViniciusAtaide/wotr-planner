    archetypes: [
        (
            key: "warpriest/champion-of-the-faith",
            name: "Champion of the Faith",
            summary: "Warpriest devoted to one alignment, who smites opposed foes and makes their weapons count as their chosen alignment.",
            guide: "warpriest#champion-of-the-faith",
            features: [
                (key: "warpriest/champion-of-the-faith/chosen-alignment", name: "Chosen Alignment", summary: "Pick law, good, chaos or evil matching your and your deity's alignment; you gain that alignment's blessing even if your deity lacks it.", guide: "warpriest#chosen-alignment"),
                (key: "warpriest/champion-of-the-faith/sacred-weapon-aligned-weapon", name: "Sacred Weapon - Aligned Weapon", summary: "At 4th, your weapons count as your chosen alignment against DR; from 12th, once a day add the matching property (Holy, etc.) for 1 minute.", guide: "warpriest#sacred-weapon-aligned-weapon"),
                (key: "warpriest/champion-of-the-faith/smite", name: "Smite", summary: "From 4th level, two Fervor: smite a foe of opposed alignment, adding Cha to attack and AC and your level to damage, bypassing DR; +1 use every four levels.", guide: "warpriest#smite"),
            ],
            selections: [
                (
                    key: "warpriest/champion-of-the-faith/chosen-alignment",
                    name: "Chosen Alignment Blessing",
                    summary: "Pick law, good, chaos or evil matching your and your deity's alignment; you gain that alignment's blessing even if your deity lacks it.",
                    guide: "warpriest#chosen-alignment",
                    option_levels: ["warpriest"],
                    options: [],
                    shared_options: [
                        "warpriest/blessings/chaos-domain",
                        "warpriest/blessings/evil-domain",
