        (
            key: "warpriest/disenchanter",
            name: "Disenchanter",
            summary: "Warpriest specialised against magic, with anti-magic powers but weaker in combat.",
            guide: "warpriest#disenchanter",
            features: [
                (key: "warpriest/disenchanter/banish-enchantment", name: "Banish Enchantment", summary: "From 6th level, two Fervor: cast Dispel Magic on one creature within 30'.", guide: "warpriest#banish-enchantment"),
                (key: "warpriest/disenchanter/mystic-interference", name: "Mystic Interference", summary: "From 4th level, two Fervor: allies within 30' gain +1 on saves against spells for rounds equal to your level, +1 more every four levels (+5 at 20th).", guide: "warpriest#mystic-interference"),
            ],
            feat_lists: [
                (key: "warpriest/disenchanter/bonus-feats-12", name: "Bonus Feat (Disenchanter, from level 12)", guide: "warpriest#bonus-feat-disenchanter", ignores_prerequisites: true, feats: ["destructive-dispel", "dispel-synergy", "great-fortitude", "improved-great-fortitude", "improved-iron-will", "improved-lightning-reflexes", "iron-will", "lightning-reflexes", "ray-shield", "skill-focus", "spell-focus"]),
