            name: "Proclaimer",
            summary: "Warpriest with powers against evil outsiders, losing Sacred Armor.",
            guide: "warpriest#proclaimer",
            features: [
                (key: "warpriest/proclaimer/cleanser-of-evil", name: "Cleanser of Evil", summary: "From 2nd level, swift action and one Fervor: 1d6 damage to evil outsiders within 5', +1d6 every three levels from 5th; radius grows from 7th.", guide: "warpriest#cleanser-of-evil"),
                (key: "warpriest/proclaimer/zone-of-sanctification", name: "Zone of Sanctification", summary: "From 4th level, move action and two Fervor: evil outsiders in your Cleanser of Evil radius are pushed out unless they make a Will save.", guide: "warpriest#zone-of-sanctification"),
            ],
            levels: [
