        (level: 17, arcane_spell_level: 9),
        (level: 18, arcane_spell_level: 9, features: ["witch/grand-hexes"], selections: ["witch/hex"]),
        (level: 19, arcane_spell_level: 9),
        (level: 20, arcane_spell_level: 9, selections: ["witch/hex"]),
    ],
    archetypes: [
        (
            key: "witch/elemental-witch",
            blueprint: "d7c7cdbc760041fabaedc1623a53a431",
            name: "Elemental Witch",
            summary: "Witch limited to the Elements or Winter patron who gains an at-will elemental ray.",
            guide: "witch#elemental-witch",
            features: [
                (key: "witch/elemental-witch/cantrips", blueprint: "c213af60aba83ed4993948dce6b947b8", name: "Cantrips", guide: "witch#elemental-witch"),
                (key: "witch/elemental-witch/elemental-patron", blueprint: "3172b6960c774e19ad029c5e4a96d3e4", name: "Elemental Patron", summary: "Must choose the Elements or the Winter patron.", guide: "witch#elemental-patron"),
                (key: "witch/elemental-witch/elemental-ray", blueprint: "edbb5084c34a486fb39d38cc75f2f994", name: "Elemental Ray", summary: "At-will ranged touch for 1d6 energy damage +1d6 per 3 witch levels, of a chosen energy type; a second type at 11th level.", guide: "witch#elemental-ray"),
            ],
            levels: [
                (level: 1, features: ["witch/elemental-witch/cantrips", "witch/elemental-witch/elemental-patron", "witch/elemental-witch/elemental-ray", "witch/familiar"], feats: ["simple-weapon-proficiency"]),
                (level: 10, features: ["witch/major-hexes"]),
                (level: 11, features: ["witch/elemental-witch/elemental-ray"]),
                (level: 14),
                (level: 18, features: ["witch/grand-hexes"]),
            ],
        ),
        (
            key: "witch/hag-of-gyronna",
            blueprint: "411fa458481e44f0855d47a19358874b",
            prerequisite: Deity("gyronna"),
            name: "Hag of Gyronna",
            summary: "Lord of Nothing witch of Gyronna with a fixed patron, fear and dispel powers and a hag companion, but fewer hexes.",
            guide: "witch#hag-of-gyronna",
            features: [
                (key: "witch/hag-of-gyronna/cantrips", blueprint: "c213af60aba83ed4993948dce6b947b8", name: "Cantrips", guide: "witch#hag-of-gyronna"),
                (key: "witch/hag-of-gyronna/curdle-thoughts", blueprint: "e52f02f983734b91baf66e1c6b9110c9", name: "Curdle Thoughts", summary: "From 2nd level, +2 to Persuasion and +2 to the DC of fear spells.", guide: "witch#curdle-thoughts"),
                (key: "witch/hag-of-gyronna/dark-pact", blueprint: "f4f3d8395db347938237c1bc77820781", name: "Dark Pact", summary: "Bonus spells: Doom, Invisibility, Blink, Shout, Serenity, Disintegrate, Repulsion, Seamantle, Implosion.", guide: "witch#dark-pact"),
                (key: "witch/hag-of-gyronna/hag-crony", blueprint: "976b8edc3dcc44f497c7ffb2edfd9b0b", name: "Hag Crony", summary: "From 12th level, a hag companion that levels with you and casts its spells at will.", guide: "witch#hag-crony"),
                (key: "witch/hag-of-gyronna/sunder-hope", blueprint: "be778d85e96d4c21860a301f4153ba3f", name: "Sunder Hope", summary: "From 8th level, once a day a creature you affect with a mind-affecting effect also takes a Greater Dispel Magic; twice at 14th, 3 times at 20th.", guide: "witch#sunder-hope"),
            ],
            levels: [
                (level: 1, features: ["witch/familiar", "witch/hag-of-gyronna/cantrips", "witch/hag-of-gyronna/dark-pact"], feats: ["simple-weapon-proficiency"], selections: ["witch/hex"]),
                (level: 2, features: ["witch/hag-of-gyronna/curdle-thoughts"]),
                (level: 8, features: ["witch/hag-of-gyronna/sunder-hope"]),
                (level: 12, features: ["witch/hag-of-gyronna/hag-crony"]),
                (level: 14, features: ["witch/hag-of-gyronna/sunder-hope"], selections: ["witch/hex"]),
                (level: 20, features: ["witch/hag-of-gyronna/sunder-hope"], selections: ["witch/hex"]),
            ],
        ),
        (
            key: "witch/hagbound",
            blueprint: "96e4c06b6add0a64a8ad8976f9c38c37",
            name: "Hagbound",
            summary: "Witch slowly turning into a hag: limited patrons, claws, Strength and an at-will curse.",
            guide: "witch#hagbound",
            features: [
                (key: "witch/hagbound/cantrips", blueprint: "c213af60aba83ed4993948dce6b947b8", name: "Cantrips", guide: "witch#hagbound"),
                (key: "witch/hagbound/hag-transformation", blueprint: "516ded0e532e4ea48bfef6287d6e68de", name: "Hag Transformation", summary: "At 20th level your type changes to monstrous humanoid; you get SR 31 and can no longer be charmed or frightened.", guide: "witch#hag-transformation"),
                (key: "witch/hagbound/hagbound-patron", blueprint: "0b9af221d99a91842b3a2afbc6a68a1e", name: "Hagbound Patron", summary: "Can only choose the Deception, Shadow, Strength or Winter patron.", guide: "witch#hagbound-patron"),
                (key: "witch/hagbound/hags-claws", blueprint: "0e422fce8572c8d4399bbf0880ba7d6e", name: "Hag\'s Claws", summary: "Your hands are natural weapons dealing 1d4 damage (1d3 if small).", guide: "witch#hagbound"),
                (key: "witch/hagbound/hunched-muscle", blueprint: "53a90334e15796d48a45a3d22cdb147b", name: "Hunched Muscle", summary: "+2 size bonus to Strength from 2nd level, +4 at 8th and +6 at 14th.", guide: "witch#hunched-muscle"),
                (key: "witch/hagbound/vile-curse", blueprint: "1e205c95881c20946bd70c4f993040ec", name: "Vile Curse", summary: "From 10th level, Bestow Curse at will; a target that saves is immune to it for 24 hours.", guide: "witch#vile-curse"),
            ],
            levels: [
                (level: 1, features: ["witch/familiar", "witch/hagbound/cantrips", "witch/hagbound/hagbound-patron", "witch/hagbound/hags-claws"], feats: ["simple-weapon-proficiency"]),
                (level: 2, features: ["witch/hagbound/hunched-muscle"]),
                (level: 8, features: ["witch/hagbound/hunched-muscle"]),
                (level: 10, features: ["witch/hagbound/vile-curse", "witch/major-hexes"]),
                (level: 14, features: ["witch/hagbound/hunched-muscle"]),
                (level: 20, features: ["witch/hagbound/hag-transformation"]),
            ],
        ),
        (
            key: "witch/hex-channeler",
            blueprint: "191b4be2152fde541ac8984c7f36e91d",
            name: "Hex Channeler",
            summary: "Witch who channels positive or negative energy and can grow it instead of taking hexes.",
            guide: "witch#hex-channeler",
