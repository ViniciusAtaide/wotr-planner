Class(
    key: "witch",
    blueprint: "1b9873f1e7bfe5449bc84d03e9c8e3cc",
    name: "Witch",
    summary: "Intelligence-based prepared arcane caster up to 9th-level spells: 1/2 BAB, good Will, a familiar, patron bonus spells and hexes.",
    guide: "witch",
    skill_points: 2,
    casting_ability: Intelligence,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "persuasion", "use-magic-device"],
    features: [
        (key: "witch/cantrips", blueprint: "c213af60aba83ed4993948dce6b947b8", name: "Cantrips", guide: "witch"),
        (key: "witch/familiar", blueprint: "29a333b7ccad3214ea3a51943fa0d8e9", name: "Familiar", summary: "Must choose a familiar.", guide: "witch#familiar"),
        (key: "witch/grand-hexes", blueprint: "d24c2467804ce0e4497d9978bafec1f9", name: "Grand Hexes", summary: "From 18th level, can choose the strongest (grand) hexes.", guide: "witch#grand-hexes"),
        (key: "witch/major-hexes", blueprint: "8ac781b33e380c84aa578f1b006dd6c5", name: "Major Hexes", summary: "From 10th level, can choose the stronger (major) hexes.", guide: "witch#major-hexes"),
    ],
    selections: [
        (
            key: "witch/hex",
            blueprint: "9846043cf51251a4897728ed6e24e76f",
            name: "Hex",
            summary: "A hex at 1st and every even level: standard action, no attack of opportunity, DC 10 + half level + Int, usually once per creature per day.",
            guide: "witch#hex",
            options: [
                (key: "witch/hex/agony", blueprint: "de5f107ec5a340d4dbc333fd86a3cc06", name: "Agony", summary: "A creature within 60 feet saves on Fortitude or is nauseated for 1 round per class level, with a new save each round.", guide: "witch#agony", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/ameliorating", blueprint: "3cdd3660fb69f3e4db0160fa97dfa85d", name: "Ameliorating", summary: "Touch suppresses dazzled, fatigued, shaken or sickened for minutes equal to level and gives +4 to saves against it.", guide: "witch#ameliorating"),
                (key: "witch/hex/animal-servant", blueprint: "876ad8aecd1098243bbfbbe04567d0d5", name: "Animal Servant", summary: "A humanoid saves on Will or becomes a beast (as Beast Shape II) under your control.", guide: "witch#animal-servant", prerequisite: Any([All([ClassLevel(class: "magus", level: 18), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/grand-hex", count: 1), Feature(feature: "witch/grand-hexes", count: 1)])),
                (key: "witch/hex/animal-skin", blueprint: "b8aab24af64e78a42970f476ecf86d4a", name: "Animal Skin", summary: "You turn into a leopard, as Beast Shape II.", guide: "witch#animal-skin", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/aura-of-purity", blueprint: "3459664f16e56124f95ec4c9f9856d06", name: "Aura of Purity", summary: "Negates diseases, inhaled poisons and gases within 10 feet for minutes per day equal to class level.", guide: "witch#aura-of-purity"),
                (key: "witch/hex/beasts-gift", blueprint: "54b4c7e9280cd104b9569f5e420b9aa8", name: "Beast\'s Gift", summary: "The target gains a 1d8 bite or two 1d4 claws, lasting 1 minute per witch level.", guide: "witch#beasts-gift", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/cackle", blueprint: "36f2467103d4635459d412fb418276f4", name: "Cackle", summary: "Move action: extends your Evil Eye, Fortune, Misfortune and Protective Luck hexes on creatures within 30 feet by 1 round.", guide: "witch#cackle"),
                (key: "witch/hex/death-curse", blueprint: "b7cd7ba71151e354d9c8a1bff959d789", name: "Death Curse", summary: "Will save or fatigued, then exhausted, then Fortitude or die; a creature that saves takes 4d6 + 1 per class level damage.", guide: "witch#death-curse", prerequisite: Any([All([ClassLevel(class: "magus", level: 18), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/grand-hex", count: 1), Feature(feature: "witch/grand-hexes", count: 1)])),
                (key: "witch/hex/delicious-fright", blueprint: "3d9c7a1ab0b57ab4d951c45f1f438136", name: "Delicious Fright", summary: "Target is shaken for 3 + Int rounds (1 on a Will save); within 30 feet of it you get +1 morale to attacks and saves.", guide: "witch#delicious-fright", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/evil-eye", blueprint: "a977bcfb36169d447914f084793cac2c", name: "Evil Eye", summary: "-2 to the target's AC, attacks or saves for 3 + Int rounds (1 on a Will save); -4 from 8th level.", guide: "witch#evil-eye"),
                (key: "witch/hex/fortune", blueprint: "0e4ebaf16c5958f4bbe6a8f50fe3afcd", name: "Fortune", summary: "For 1 round a creature rolls ability checks, attacks, saves and skill checks twice and keeps the better; +1 round at 8th and 16th.", guide: "witch#fortune"),
                (key: "witch/hex/healing-hex", blueprint: "47b6e7bd155d2434ebde6ca21a61cf32", name: "Healing (Hex)", summary: "Heals as Cure Light Wounds at your class level, Cure Moderate Wounds from 5th level.", guide: "witch#healing-hex"),
                (key: "witch/hex/hoarfrost", blueprint: "b26dea1fc351b3441a4706b10d250188", name: "Hoarfrost", summary: "On a failed Fortitude save, 1 Constitution damage per minute until cured or a later save succeeds.", guide: "witch#hoarfrost", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/iceplant", blueprint: "9af6dc2697c8ef24eab8ce1c697b05c4", name: "Iceplant", summary: "Permanent +2 natural armour bonus to AC.", guide: "witch#iceplant"),
                (key: "witch/hex/lay-to-rest", blueprint: "5c7e243dde95aed4699e1b3492a73055", name: "Lay to Rest", summary: "Undeath to Death on one undead target, which can resist with a Will save.", guide: "witch#lay-to-rest", prerequisite: Any([All([ClassLevel(class: "magus", level: 18), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/grand-hex", count: 1), Feature(feature: "witch/grand-hexes", count: 1)])),
                (key: "witch/hex/life-giver", blueprint: "c7eb5151b6a670e47bf4713c0934e144", name: "Life Giver", summary: "Once a day, a full-round touch revives a dead creature as Resurrection, without a material component.", guide: "witch#life-giver", prerequisite: Any([All([ClassLevel(class: "magus", level: 18), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/grand-hex", count: 1), Feature(feature: "witch/grand-hexes", count: 1)])),
                (key: "witch/hex/major-ameliorating", blueprint: "cdd9fb3ef0ceb704bb453b2431a2b44b", name: "Major Ameliorating", summary: "Touch suppresses blinded, cursed, diseased or poisoned for minutes equal to level and gives +4 to saves against it.", guide: "witch#major-ameliorating", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/major-healing", blueprint: "be5eaf086444acf459d844ca6f44d1f6", name: "Major Healing", summary: "Heals as Cure Serious Wounds at your class level, Cure Critical Wounds from 15th level.", guide: "witch#major-healing", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/misfortune", blueprint: "4e3dfdf000cc24d4fb96fd04e4e5cd0f", name: "Misfortune", summary: "On a failed Will save, for 1 round a creature rolls checks, attacks and saves twice and keeps the worse; +1 round at 8th and 16th.", guide: "witch#misfortune"),
                (key: "witch/hex/nails", blueprint: "6a9a6cd57f30ffb4784625742c2f1756", name: "Nails", summary: "Your nails are 1d3 natural weapons (1d2 if small).", guide: "witch#nails"),
                (key: "witch/hex/protective-luck", blueprint: "ddfc51eaa495acb40a01b92a2dd4ab73", name: "Protective Luck", summary: "Attackers against the target roll twice and keep the worse, for 1 round (2 at 8th level, 3 at 16th).", guide: "witch#protective-luck"),
                (key: "witch/hex/regenerative-sinew", blueprint: "407955f228e0f7946827d17f94c66a75", name: "Regenerative Sinew", summary: "Fast healing 5 for half your class level in rounds, or heals up to 4 ability damage to two scores.", guide: "witch#regenerative-sinew", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/restless-slumber", blueprint: "0a31b4aba2b3bc24c85636cb8bdba1d9", name: "Restless Slumber", summary: "Will save or asleep for 1 round per level, taking 1d10 a round; on waking, confused for half your level in rounds.", guide: "witch#restless-slumber", prerequisite: All([Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)]), SelectionOption("witch/hex/slumber")])),
                (key: "witch/hex/slumber", blueprint: "498d7668a6086454cb2def921b89bd8f", name: "Slumber", summary: "Will save or asleep for 1 round per class level or until damaged.", guide: "witch#slumber"),
                (key: "witch/hex/vulnerability-curse", blueprint: "e049c31708d932f4c8e7a366b1cd44a2", name: "Vulnerability Curse", summary: "Suppresses the target's energy resistances and immunities for 1 round per class level (1 round on a Will save).", guide: "witch#vulnerability-curse"),
                (key: "witch/hex/ward", blueprint: "4649c74487a4b7d499aed2c5b02ae89d", name: "Ward", summary: "Another creature gets +2 deflection AC and +2 resistance to saves until hit or failing a save; +1 at 8th and 16th.", guide: "witch#ward"),
            ],
        ),
        (
            key: "witch/patron",
            blueprint: "381cf4c890815d049a4420c6f31d063f",
            name: "Patron",
            summary: "A patron that adds bonus spells at even levels, by class level rather than caster level.",
            guide: "witch#patron",
            options: [
                (key: "witch/patron/agility", blueprint: "08518b2a62446c74b9ae08ee73664047", name: "Agility", summary: "Bonus spells: Expeditious Retreat, Cat's Grace, Haste, Freedom of Movement, Polymorph, Mass Cat's Grace, then Greater Polymorph for levels 7 to 9.", guide: "witch#agility"),
                (key: "witch/patron/ancestors", blueprint: "b9c4e782706099f42a2ebc901acf492d", name: "Ancestors", summary: "Bonus spells: Bless, Aid, Prayer, Shield of Dawn, Burst of Glory, Greater Heroism, Bestow Grace of the Champion, Greater Angelic Aspect, Weird.", guide: "witch#ancestors"),
                (key: "witch/patron/deception", blueprint: "3a4214e3c2eab3c40bc491d7abea7045", name: "Deception", summary: "Bonus spells: Vanish, Invisibility, Displacement, Confusion, Phantasmal Web, Serenity, Mass Invisibility, Greater Angelic Aspect, Weird.", guide: "witch#deception"),
                (key: "witch/patron/devotion", blueprint: "facb0ed7d8e52b04cacf351bea430ce9", name: "Devotion", summary: "Bonus spells: Divine Favor, Invisibility, Magical Vestment, Confusion, Flame Strike, Mass Bull's Strength, Bestow Grace of the Champion, Holy Aura, Mass Heal.", guide: "witch#devotion"),
                (key: "witch/patron/elements", blueprint: "67e85f52b1f020847aaa738d8999d4cd", name: "Elements", summary: "Bonus spells: Shocking Grasp, Acid Arrow, Fireball, Dragon's Breath, Flame Strike, Acid Fog, Caustic Eruption, Polar Ray, Mass Icy Prison.", guide: "witch#elements"),
                (key: "witch/patron/endurance", blueprint: "8fe0a14c90d3ea94a833d087b8a09bb9", name: "Endurance", summary: "Adds Stunning Barrier, Bear's Endurance, Protection from Energy, Thorn Body, Spell Resistance, Mass Bear's Endurance, Greater Restoration, Polar Ray, Seamantle.", guide: "witch#endurance"),
                (key: "witch/patron/healing", blueprint: "a3e4ef40ad99f4d47af15cc5f16afc97", name: "Healing", summary: "Bonus spells: Remove Fear, Lesser Restoration, Remove Disease, Restoration, Cleanse, Pillar of Life, Greater Restoration, Mass Cure Critical Wounds, Mass Heal.", guide: "witch#healing"),
                (key: "witch/patron/insanity", blueprint: "eafc47304da734a4d922ae663d82f1e5", name: "Insanity", summary: "Bonus spells: Color Spray, Hideous Laughter, Hold Person, Confusion, Mind Fog, Serenity, Insanity, Mass Cure Critical Wounds, Overwhelming Presence.", guide: "witch#insanity"),
                (key: "witch/patron/mercy", blueprint: "cad7c2fdabeb9574f95f4b9ffee20afe", name: "Mercy", summary: "Bonus spells: Shocking Grasp, Eagle's Splendor, Remove Curse, Restoration, Cleanse, Inspiring Recovery, Resurrection, Euphoric Tranquility, Mass Heal.", guide: "witch#mercy"),
                (key: "witch/patron/shadow", blueprint: "f48bfffe3618c274dbd42dfff8d0df56", name: "Shadow", summary: "Bonus spells: Vanish, Blur, Displacement, Shadow Conjuration, Shadow Evocation, Phantasmal Putrefaction, their Greater versions, Shades.", guide: "witch#shadow"),
                (key: "witch/patron/strength", blueprint: "850ac8a2bc65d814db9f3fea871c18bb", name: "Strength", summary: "Adds Divine Favor, Bull's Strength, Heroism, Divine Power, Righteous Might, Mass Bull's Strength, Legendary Proportions, Frightful Aspect, Heroic Invocation.", guide: "witch#strength"),
                (key: "witch/patron/transformation", blueprint: "23ea5ade326f80b488164f75580c03af", name: "Transformation", summary: "Bonus spells: Longstrider, Bear's Endurance, Beast Shape I to III, Dragonkind I to III, Shapechange.", guide: "witch#transformation"),
                (key: "witch/patron/winter", blueprint: "e98d8d9f907c1814aa7376d6cdaac012", name: "Winter", summary: "Bonus spells: Snowball, Resist Fire, Protection from Fire, Ice Storm, Icy Prison, Cold Ice Strike, Ice Body, Polar Ray, Polar Midnight; needed for Winter Witch.", guide: "witch#winter"),
            ],
        ),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["witch/cantrips", "witch/familiar"], feats: ["simple-weapon-proficiency"], selections: ["witch/hex", "witch/patron"]),
        (level: 2, arcane_spell_level: 1, selections: ["witch/hex"]),
