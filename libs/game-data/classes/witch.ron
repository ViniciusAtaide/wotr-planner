Class(
    key: "witch",
    name: "Witch",
    summary: "Intelligence-based prepared arcane caster up to 9th-level spells: 1/2 BAB, good Will, a familiar, patron bonus spells and hexes.",
    guide: "witch",
    skill_points: 2,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "persuasion", "use-magic-device"],
    features: [
        (key: "witch/cantrips", name: "Cantrips", guide: "witch"),
        (key: "witch/familiar", name: "Familiar", summary: "Must choose a familiar.", guide: "witch#familiar"),
        (key: "witch/grand-hexes", name: "Grand Hexes", summary: "From 18th level, can choose the strongest (grand) hexes.", guide: "witch#grand-hexes"),
        (key: "witch/major-hexes", name: "Major Hexes", summary: "From 10th level, can choose the stronger (major) hexes.", guide: "witch#major-hexes"),
    ],
    selections: [
        (
            key: "witch/hex",
            name: "Hex",
            summary: "A hex at 1st and every even level: standard action, no attack of opportunity, DC 10 + half level + Int, usually once per creature per day.",
            guide: "witch#hex",
            options: [
                (key: "witch/hex/agony", name: "Agony", summary: "A creature within 60 feet saves on Fortitude or is nauseated for 1 round per class level, with a new save each round.", guide: "witch#agony", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/ameliorating", name: "Ameliorating", summary: "Touch suppresses dazzled, fatigued, shaken or sickened for minutes equal to level and gives +4 to saves against it.", guide: "witch#ameliorating"),
                (key: "witch/hex/animal-servant", name: "Animal Servant", summary: "A humanoid saves on Will or becomes a beast (as Beast Shape II) under your control.", guide: "witch#animal-servant", prerequisite: Any([All([ClassLevel(class: "magus", level: 18), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/grand-hex", count: 1), Feature(feature: "witch/grand-hexes", count: 1)])),
                (key: "witch/hex/animal-skin", name: "Animal Skin", summary: "You turn into a leopard, as Beast Shape II.", guide: "witch#animal-skin", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/aura-of-purity", name: "Aura of Purity", summary: "Negates diseases, inhaled poisons and gases within 10 feet for minutes per day equal to class level.", guide: "witch#aura-of-purity"),
                (key: "witch/hex/beasts-gift", name: "Beast\'s Gift", summary: "The target gains a 1d8 bite or two 1d4 claws, lasting 1 minute per witch level.", guide: "witch#beasts-gift", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/cackle", name: "Cackle", summary: "Move action: extends your Evil Eye, Fortune, Misfortune and Protective Luck hexes on creatures within 30 feet by 1 round.", guide: "witch#cackle"),
                (key: "witch/hex/death-curse", name: "Death Curse", summary: "Will save or fatigued, then exhausted, then Fortitude or die; a creature that saves takes 4d6 + 1 per class level damage.", guide: "witch#death-curse", prerequisite: Any([All([ClassLevel(class: "magus", level: 18), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/grand-hex", count: 1), Feature(feature: "witch/grand-hexes", count: 1)])),
                (key: "witch/hex/delicious-fright", name: "Delicious Fright", summary: "Target is shaken for 3 + Int rounds (1 on a Will save); within 30 feet of it you get +1 morale to attacks and saves.", guide: "witch#delicious-fright", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/evil-eye", name: "Evil Eye", summary: "-2 to the target's AC, attacks or saves for 3 + Int rounds (1 on a Will save); -4 from 8th level.", guide: "witch#evil-eye"),
                (key: "witch/hex/fortune", name: "Fortune", summary: "For 1 round a creature rolls ability checks, attacks, saves and skill checks twice and keeps the better; +1 round at 8th and 16th.", guide: "witch#fortune"),
                (key: "witch/hex/healing-hex", name: "Healing (Hex)", summary: "Heals as Cure Light Wounds at your class level, Cure Moderate Wounds from 5th level.", guide: "witch#healing-hex"),
                (key: "witch/hex/hoarfrost", name: "Hoarfrost", summary: "On a failed Fortitude save, 1 Constitution damage per minute until cured or a later save succeeds.", guide: "witch#hoarfrost", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/iceplant", name: "Iceplant", summary: "Permanent +2 natural armour bonus to AC.", guide: "witch#iceplant"),
                (key: "witch/hex/lay-to-rest", name: "Lay to Rest", summary: "Undeath to Death on one undead target, which can resist with a Will save.", guide: "witch#lay-to-rest", prerequisite: Any([All([ClassLevel(class: "magus", level: 18), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/grand-hex", count: 1), Feature(feature: "witch/grand-hexes", count: 1)])),
                (key: "witch/hex/life-giver", name: "Life Giver", summary: "Once a day, a full-round touch revives a dead creature as Resurrection, without a material component.", guide: "witch#life-giver", prerequisite: Any([All([ClassLevel(class: "magus", level: 18), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/grand-hex", count: 1), Feature(feature: "witch/grand-hexes", count: 1)])),
                (key: "witch/hex/major-ameliorating", name: "Major Ameliorating", summary: "Touch suppresses blinded, cursed, diseased or poisoned for minutes equal to level and gives +4 to saves against it.", guide: "witch#major-ameliorating", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/major-healing", name: "Major Healing", summary: "Heals as Cure Serious Wounds at your class level, Cure Critical Wounds from 15th level.", guide: "witch#major-healing", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/misfortune", name: "Misfortune", summary: "On a failed Will save, for 1 round a creature rolls checks, attacks and saves twice and keeps the worse; +1 round at 8th and 16th.", guide: "witch#misfortune"),
                (key: "witch/hex/nails", name: "Nails", summary: "Your nails are 1d3 natural weapons (1d2 if small).", guide: "witch#nails"),
                (key: "witch/hex/protective-luck", name: "Protective Luck", summary: "Attackers against the target roll twice and keep the worse, for 1 round (2 at 8th level, 3 at 16th).", guide: "witch#protective-luck"),
                (key: "witch/hex/regenerative-sinew", name: "Regenerative Sinew", summary: "Fast healing 5 for half your class level in rounds, or heals up to 4 ability damage to two scores.", guide: "witch#regenerative-sinew", prerequisite: Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)])),
                (key: "witch/hex/restless-slumber", name: "Restless Slumber", summary: "Will save or asleep for 1 round per level, taking 1d10 a round; on waking, confused for half your level in rounds.", guide: "witch#restless-slumber", prerequisite: All([Any([All([ClassLevel(class: "magus", level: 12), Archetype("magus/hexcrafter")]), Feature(feature: "rogue/sylvan-trickster/major-hexes", count: 1), Feature(feature: "witch/major-hexes", count: 1)]), SelectionOption("witch/hex/slumber")])),
                (key: "witch/hex/slumber", name: "Slumber", summary: "Will save or asleep for 1 round per class level or until damaged.", guide: "witch#slumber"),
                (key: "witch/hex/vulnerability-curse", name: "Vulnerability Curse", summary: "Suppresses the target's energy resistances and immunities for 1 round per class level (1 round on a Will save).", guide: "witch#vulnerability-curse"),
                (key: "witch/hex/ward", name: "Ward", summary: "Another creature gets +2 deflection AC and +2 resistance to saves until hit or failing a save; +1 at 8th and 16th.", guide: "witch#ward"),
            ],
        ),
        (
            key: "witch/patron",
            name: "Patron",
            summary: "A patron that adds bonus spells at even levels, by class level rather than caster level.",
            guide: "witch#patron",
            options: [
                (key: "witch/patron/agility", name: "Agility", summary: "Bonus spells: Expeditious Retreat, Cat's Grace, Haste, Freedom of Movement, Polymorph, Mass Cat's Grace, then Greater Polymorph for levels 7 to 9.", guide: "witch#agility"),
                (key: "witch/patron/ancestors", name: "Ancestors", summary: "Bonus spells: Bless, Aid, Prayer, Shield of Dawn, Burst of Glory, Greater Heroism, Bestow Grace of the Champion, Greater Angelic Aspect, Weird.", guide: "witch#ancestors"),
                (key: "witch/patron/deception", name: "Deception", summary: "Bonus spells: Vanish, Invisibility, Displacement, Confusion, Phantasmal Web, Serenity, Mass Invisibility, Greater Angelic Aspect, Weird.", guide: "witch#deception"),
                (key: "witch/patron/devotion", name: "Devotion", summary: "Bonus spells: Divine Favor, Invisibility, Magical Vestment, Confusion, Flame Strike, Mass Bull's Strength, Bestow Grace of the Champion, Holy Aura, Mass Heal.", guide: "witch#devotion"),
                (key: "witch/patron/elements", name: "Elements", summary: "Bonus spells: Shocking Grasp, Acid Arrow, Fireball, Dragon's Breath, Flame Strike, Acid Fog, Caustic Eruption, Polar Ray, Mass Icy Prison.", guide: "witch#elements"),
                (key: "witch/patron/endurance", name: "Endurance", summary: "Adds Stunning Barrier, Bear's Endurance, Protection from Energy, Thorn Body, Spell Resistance, Mass Bear's Endurance, Greater Restoration, Polar Ray, Seamantle.", guide: "witch#endurance"),
                (key: "witch/patron/healing", name: "Healing", summary: "Bonus spells: Remove Fear, Lesser Restoration, Remove Disease, Restoration, Cleanse, Pillar of Life, Greater Restoration, Mass Cure Critical Wounds, Mass Heal.", guide: "witch#healing"),
                (key: "witch/patron/insanity", name: "Insanity", summary: "Bonus spells: Color Spray, Hideous Laughter, Hold Person, Confusion, Mind Fog, Serenity, Insanity, Mass Cure Critical Wounds, Overwhelming Presence.", guide: "witch#insanity"),
                (key: "witch/patron/mercy", name: "Mercy", summary: "Bonus spells: Shocking Grasp, Eagle's Splendor, Remove Curse, Restoration, Cleanse, Inspiring Recovery, Resurrection, Euphoric Tranquility, Mass Heal.", guide: "witch#mercy"),
                (key: "witch/patron/shadow", name: "Shadow", summary: "Bonus spells: Vanish, Blur, Displacement, Shadow Conjuration, Shadow Evocation, Phantasmal Putrefaction, their Greater versions, Shades.", guide: "witch#shadow"),
                (key: "witch/patron/strength", name: "Strength", summary: "Adds Divine Favor, Bull's Strength, Heroism, Divine Power, Righteous Might, Mass Bull's Strength, Legendary Proportions, Frightful Aspect, Heroic Invocation.", guide: "witch#strength"),
                (key: "witch/patron/transformation", name: "Transformation", summary: "Bonus spells: Longstrider, Bear's Endurance, Beast Shape I to III, Dragonkind I to III, Shapechange.", guide: "witch#transformation"),
                (key: "witch/patron/winter", name: "Winter", summary: "Bonus spells: Snowball, Resist Fire, Protection from Fire, Ice Storm, Icy Prison, Cold Ice Strike, Ice Body, Polar Ray, Polar Midnight; needed for Winter Witch.", guide: "witch#winter"),
            ],
        ),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["witch/cantrips", "witch/familiar"], feats: ["simple-weapon-proficiency"], selections: ["witch/hex", "witch/patron"]),
        (level: 2, arcane_spell_level: 1, selections: ["witch/hex"]),
        (level: 3, arcane_spell_level: 2),
        (level: 4, arcane_spell_level: 2, selections: ["witch/hex"]),
        (level: 5, arcane_spell_level: 3),
        (level: 6, arcane_spell_level: 3, selections: ["witch/hex"]),
        (level: 7, arcane_spell_level: 4),
        (level: 8, arcane_spell_level: 4, selections: ["witch/hex"]),
        (level: 9, arcane_spell_level: 5),
        (level: 10, arcane_spell_level: 5, features: ["witch/major-hexes"], selections: ["witch/hex"]),
        (level: 11, arcane_spell_level: 6),
        (level: 12, arcane_spell_level: 6, selections: ["witch/hex"]),
        (level: 13, arcane_spell_level: 7),
        (level: 14, arcane_spell_level: 7, selections: ["witch/hex"]),
        (level: 15, arcane_spell_level: 8),
        (level: 16, arcane_spell_level: 8, selections: ["witch/hex"]),
        (level: 17, arcane_spell_level: 9),
        (level: 18, arcane_spell_level: 9, features: ["witch/grand-hexes"], selections: ["witch/hex"]),
        (level: 19, arcane_spell_level: 9),
        (level: 20, arcane_spell_level: 9, selections: ["witch/hex"]),
    ],
    archetypes: [
        (
            key: "witch/elemental-witch",
            name: "Elemental Witch",
            summary: "Witch limited to the Elements or Winter patron who gains an at-will elemental ray.",
            guide: "witch#elemental-witch",
            features: [
                (key: "witch/elemental-witch/cantrips", name: "Cantrips", guide: "witch#elemental-witch"),
                (key: "witch/elemental-witch/elemental-patron", name: "Elemental Patron", summary: "Must choose the Elements or the Winter patron.", guide: "witch#elemental-patron"),
                (key: "witch/elemental-witch/elemental-ray", name: "Elemental Ray", summary: "At-will ranged touch for 1d6 energy damage +1d6 per 3 witch levels, of a chosen energy type; a second type at 11th level.", guide: "witch#elemental-ray"),
            ],
            levels: [
                (level: 1, features: ["witch/elemental-witch/cantrips", "witch/elemental-witch/elemental-patron", "witch/elemental-witch/elemental-ray", "witch/familiar"], feats: ["simple-weapon-proficiency"]),
                (level: 10, features: ["witch/major-hexes"]),
                (level: 11, features: ["witch/elemental-witch/elemental-ray"]),
                (level: 14),
                (level: 18, features: ["witch/grand-hexes"]),
            ],
        ),
        (
            key: "witch/hag-of-gyronna",
            prerequisite: Deity("gyronna"),
            name: "Hag of Gyronna",
            summary: "Lord of Nothing witch of Gyronna with a fixed patron, fear and dispel powers and a hag companion, but fewer hexes.",
            guide: "witch#hag-of-gyronna",
            features: [
                (key: "witch/hag-of-gyronna/cantrips", name: "Cantrips", guide: "witch#hag-of-gyronna"),
                (key: "witch/hag-of-gyronna/curdle-thoughts", name: "Curdle Thoughts", summary: "From 2nd level, +2 to Persuasion and +2 to the DC of fear spells.", guide: "witch#curdle-thoughts"),
                (key: "witch/hag-of-gyronna/dark-pact", name: "Dark Pact", summary: "Bonus spells: Doom, Invisibility, Blink, Shout, Serenity, Disintegrate, Repulsion, Seamantle, Implosion.", guide: "witch#dark-pact"),
                (key: "witch/hag-of-gyronna/hag-crony", name: "Hag Crony", summary: "From 12th level, a hag companion that levels with you and casts its spells at will.", guide: "witch#hag-crony"),
                (key: "witch/hag-of-gyronna/sunder-hope", name: "Sunder Hope", summary: "From 8th level, once a day a creature you affect with a mind-affecting effect also takes a Greater Dispel Magic; twice at 14th, 3 times at 20th.", guide: "witch#sunder-hope"),
            ],
            levels: [
                (level: 1, features: ["witch/familiar", "witch/hag-of-gyronna/cantrips", "witch/hag-of-gyronna/dark-pact"], feats: ["simple-weapon-proficiency"], selections: ["witch/hex"]),
                (level: 2, features: ["witch/hag-of-gyronna/curdle-thoughts"]),
                (level: 8, features: ["witch/hag-of-gyronna/sunder-hope"]),
                (level: 12, features: ["witch/hag-of-gyronna/hag-crony"]),
            ],
        ),
        (
            key: "witch/hagbound",
            name: "Hagbound",
            summary: "Witch slowly turning into a hag: limited patrons, claws, Strength and an at-will curse.",
            guide: "witch#hagbound",
            features: [
                (key: "witch/hagbound/cantrips", name: "Cantrips", guide: "witch#hagbound"),
                (key: "witch/hagbound/hag-transformation", name: "Hag Transformation", summary: "At 20th level your type changes to monstrous humanoid; you get SR 31 and can no longer be charmed or frightened.", guide: "witch#hag-transformation"),
                (key: "witch/hagbound/hagbound-patron", name: "Hagbound Patron", summary: "Can only choose the Deception, Shadow, Strength or Winter patron.", guide: "witch#hagbound-patron"),
                (key: "witch/hagbound/hags-claws", name: "Hag\'s Claws", summary: "Your hands are natural weapons dealing 1d4 damage (1d3 if small).", guide: "witch#hagbound"),
                (key: "witch/hagbound/hunched-muscle", name: "Hunched Muscle", summary: "+2 size bonus to Strength from 2nd level, +4 at 8th and +6 at 14th.", guide: "witch#hunched-muscle"),
                (key: "witch/hagbound/vile-curse", name: "Vile Curse", summary: "From 10th level, Bestow Curse at will; a target that saves is immune to it for 24 hours.", guide: "witch#vile-curse"),
            ],
            levels: [
                (level: 1, features: ["witch/familiar", "witch/hagbound/cantrips", "witch/hagbound/hagbound-patron", "witch/hagbound/hags-claws"], feats: ["simple-weapon-proficiency"]),
                (level: 2, features: ["witch/hagbound/hunched-muscle"]),
                (level: 8),
                (level: 10, features: ["witch/hagbound/vile-curse", "witch/major-hexes"]),
                (level: 14),
                (level: 20, features: ["witch/hagbound/hag-transformation"]),
            ],
        ),
        (
            key: "witch/hex-channeler",
            name: "Hex Channeler",
            summary: "Witch who channels positive or negative energy and can grow it instead of taking hexes.",
            guide: "witch#hex-channeler",
            features: [
                (key: "witch/hex-channeler/cantrips", name: "Cantrips", guide: "witch#hex-channeler"),
                (key: "witch/hex-channeler/channel-energy", name: "Channel Energy", summary: "From 2nd level, channels energy for 1d6, 3 + Cha times a day; each new hex can instead add +1d6.", guide: "witch#channel-energy"),
            ],
            levels: [
                (level: 1, features: ["witch/familiar", "witch/hex-channeler/cantrips"], feats: ["simple-weapon-proficiency"], selections: ["witch/hex", "witch/patron"]),
                (level: 2, features: ["witch/hex-channeler/channel-energy"]),
            ],
        ),
        (
            key: "witch/keen-eyed-adventurer",
            name: "Keen-Eyed Adventurer",
            summary: "Visitors from Morta witch who adds damage to ray cantrips, losing three hexes.",
            guide: "witch#keen-eyed-adventurer",
            features: [
                (key: "witch/keen-eyed-adventurer/cantrip-mastery", name: "Cantrip Mastery", summary: "At 20th level, spells that need a ranged touch attack add your Intelligence modifier to damage.", guide: "witch#cantrip-mastery"),
                (key: "witch/keen-eyed-adventurer/elemental-vortex", name: "Elemental Vortex", summary: "From 6th level, once per combat a vortex pulls enemies within 10 feet in for 1d8 slashing per 2 witch levels (Reflex half).", guide: "witch#elemental-vortex"),
                (key: "witch/keen-eyed-adventurer/improved-cantrips", name: "Improved Cantrips", summary: "Learns Acid Splash, Jolt, Ignition and Ray of Frost; damaging ranged-touch cantrips gain an extra die per 2 witch levels.", guide: "witch#improved-cantrips"),
            ],
            levels: [
                (level: 1, features: ["witch/familiar", "witch/keen-eyed-adventurer/improved-cantrips"], feats: ["simple-weapon-proficiency"], selections: ["witch/patron"]),
                (level: 6, features: ["witch/keen-eyed-adventurer/elemental-vortex"]),
                (level: 20, features: ["witch/keen-eyed-adventurer/cantrip-mastery"]),
            ],
        ),
        (
            key: "witch/ley-line-guardian",
            name: "Ley Line Guardian",
            summary: "Witch who casts spontaneously like a Sorcerer, without a familiar.",
            guide: "witch#ley-line-guardian",
            features: [
                (key: "witch/ley-line-guardian/cantrips", name: "Cantrips", guide: "witch#ley-line-guardian"),
                (key: "witch/ley-line-guardian/conduit-surge", name: "Conduit Surge", summary: "Swift action: next spell gets +1d4-1 caster level (+1d4 at 8th), 3 + Int times a day; Fortitude save or staggered.", guide: "witch#conduit-surge"),
                (key: "witch/ley-line-guardian/ley-line-powered", name: "Ley Line Powered", summary: "You know spells and get slots as a Sorcerer of your level, plus your patron's bonus spells.", guide: "witch#ley-line-powered"),
            ],
            levels: [
                (level: 1, features: ["witch/ley-line-guardian/cantrips", "witch/ley-line-guardian/conduit-surge", "witch/ley-line-guardian/ley-line-powered"], feats: ["simple-weapon-proficiency"], selections: ["witch/patron"]),
                (level: 8),
            ],
        ),
        (
            key: "witch/stigmatized-witch",
            name: "Stigmatized Witch",
            summary: "Spontaneous Charisma-based witch with an oracle curse instead of a patron; 3 skill points per level.",
            guide: "witch#stigmatized-witch",
            skill_points: 3,
            spontaneous: Some(true),
            features: [
                (key: "witch/stigmatized-witch/cantrips", name: "Cantrips", guide: "witch#stigmatized-witch"),
                (key: "witch/stigmatized-witch/curse", name: "Curse", summary: "Must take a curse from the Oracle list.", guide: "witch#curse"),
            ],
            levels: [
                (level: 1, features: ["witch/familiar", "witch/stigmatized-witch/cantrips", "witch/stigmatized-witch/curse"], feats: ["simple-weapon-proficiency"], selections: ["witch/hex"]),
            ],
        ),
        (
            key: "witch/witch-of-the-veil",
            name: "Witch of the Veil",
            summary: "Deception-patron witch with Stealth and Trickery as class skills and at-will invisibility.",
            guide: "witch#witch-of-the-veil",
            class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "persuasion", "stealth", "trickery", "use-magic-device"],
            features: [
                (key: "witch/witch-of-the-veil/cantrips", name: "Cantrips", guide: "witch#witch-of-the-veil"),
                (key: "witch/witch-of-the-veil/deception-witch-of-the-veil", name: "Deception (Witch of the Veil)", summary: "Must choose the Deception patron.", guide: "witch#deception-witch-of-the-veil"),
                (key: "witch/witch-of-the-veil/secrecy", name: "Secrecy", summary: "Stealth and Trickery become class skills.", guide: "witch#secrecy"),
                (key: "witch/witch-of-the-veil/shrouded-step", name: "Shrouded Step", summary: "At will from 2nd level, a swift action turns you invisible for Int rounds; adds a 30-foot teleport at 8th and Greater Invisibility at 16th.", guide: "witch#shrouded-step"),
            ],
            levels: [
