Class(
    key: "alchemist",
    blueprint: "0937bec61c0dabc468428f496580c721",
    name: "Alchemist",
    summary: "Dexterity and Intelligence class: 3/4 BAB, prepared extracts up to 6th level (self only until Infusion), bombs, mutagens and discoveries.",
    guide: "alchemist",
    skill_points: 3,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "perception", "trickery", "use-magic-device"],
    features: [
        (key: "alchemist/alchemist-proficiencies", blueprint: "a1a8971f48a829d4683097f8b14e41c8", name: "Alchemist Proficiencies", summary: "Simple weapons, bombs and light armour; no shields.", guide: "alchemist#alchemist-proficiencies"),
        (key: "alchemist/bomb", blueprint: "c59b2f256f5a70a4d896568658315b7d", name: "Bomb", summary: "Class level + Int modifier bombs a day: 30-foot range, 1d6 fire + Int on a hit (+1d6 per odd level) and Reflex-halved splash.", guide: "alchemist#bomb"),
        (key: "alchemist/mutagen", blueprint: "cee8f65448ce71c4b8b8ca13751dd8ea", name: "Mutagen", summary: "Mutagen for 10 minutes per level: +2 natural armour and +4 to Str, Dex or Con with -2 to Int, Wis or Cha respectively.", guide: "alchemist#mutagen"),
        (key: "alchemist/persistent-mutagen", blueprint: "75ba281feb2b96547a3bfb12ecaff052", name: "Persistent Mutagen", summary: "From 14th level, mutagens last 1 hour per class level.", guide: "alchemist#persistent-mutagen"),
        (key: "alchemist/poison-immunity", blueprint: "202af59b918143a4ab7c33d72c8eb6d5", name: "Poison Immunity", summary: "From 10th level, immune to poison.", guide: "alchemist#poison-immunity"),
        (key: "alchemist/poison-resistance", blueprint: "c9022272c87bd66429176ce5c597989c", name: "Poison Resistance", summary: "+2 to saves against poison at 2nd level, +4 at 5th and +6 at 8th.", guide: "alchemist#poison-resistance"),
    ],
    selections: [
        (
            key: "alchemist/discovery",
            blueprint: "cd86c437488386f438dcc9ae727ea2a6",
            name: "Discovery",
            summary: "A discovery at 2nd level and every even level; save DCs are 10 + half class level + Int modifier.",
            guide: "alchemist#discovery",
            options: [
                (key: "alchemist/discovery/acid-bomb", blueprint: "1ee30ffd28843b84282b04e5d4e8bc7b", name: "Acid Bomb", summary: "Bombs deal acid instead of fire, and a direct hit deals 1d6 more acid damage the next round.", guide: "alchemist#acid-bomb"),
                (key: "alchemist/discovery/blinding-bombs", blueprint: "c3da68b2222768b4f9352fefd29ad15c", name: "Blinding Bombs", summary: "Direct hits must save on Fortitude or be blinded for 1 minute; the splash area is dazzled for 1 minute.", guide: "alchemist#blinding-bombs", prerequisite: ClassLevel(class: "alchemist", level: 8)),
                (key: "alchemist/discovery/breath-weapon-bomb", blueprint: "c186762d98c6a96459cc9302c6f49258", name: "Breath Weapon Bomb", summary: "A bomb can affect a 15-foot cone.", guide: "alchemist#breath-weapon-bomb", prerequisite: ClassLevel(class: "alchemist", level: 6)),
                (key: "alchemist/discovery/choking-bomb", blueprint: "b3c6cb76d5b11cf4c8314d7b1c7b9b8b", name: "Choking Bomb", summary: "Gas bomb: creatures in it save on Fortitude or are nauseated 1 round per damage die, with a new save each round.", guide: "alchemist#choking-bomb"),
                (key: "alchemist/discovery/cognatogen", blueprint: "e3f460ea61fcc504183c7d6818bbbf7a", name: "Cognatogen", summary: "A reversed mutagen (such as +4 Int, -2 Str); when it ends, 2 ability damage to the lowered score.", guide: "alchemist#cognatogen"),
                (key: "alchemist/discovery/cursed-bomb", blueprint: "bf8f80f3a492e7946924e1cd9c4b0867", name: "Cursed Bomb", summary: "Requires 12th level: a direct hit must save on Will or suffer Bestow Curse.", guide: "alchemist#cursed-bomb", prerequisite: ClassLevel(class: "alchemist", level: 12)),
                (key: "alchemist/discovery/dispelling-bombs", blueprint: "92085b99a3fd6e34b85f0e2bb67a17ba", name: "Dispelling Bombs", summary: "A direct hit applies a targeted Dispel Magic.", guide: "alchemist#dispelling-bombs", prerequisite: ClassLevel(class: "alchemist", level: 6)),
                (key: "alchemist/discovery/enhance-potion", blueprint: "2673ccdd6df742d42a8c94977c76a984", name: "Enhance Potion", summary: "Potions you drink use your class level as their caster level.", guide: "alchemist#enhance-potion"),
                (key: "alchemist/discovery/explosive-bombs", blueprint: "1d0e812131f345742adca6431d5bc4fe", name: "Explosive Bombs", summary: "Splash radius grows to 10 feet, and direct hits set targets on fire for 1d6 fire damage a round.", guide: "alchemist#explosive-bombs"),
                (key: "alchemist/discovery/extend-potion", blueprint: "1db8e126b77e71d4d89dcfa50fe87e93", name: "Extend Potion", summary: "Potions last twice as long.", guide: "alchemist#extend-potion"),
                (key: "alchemist/discovery/fast-bombs", blueprint: "128c5fccec5ca724281a4907b1f0ac83", name: "Fast Bombs", summary: "Throws several bombs a round, like a ranged full attack.", guide: "alchemist#fast-bombs", prerequisite: ClassLevel(class: "alchemist", level: 8)),
                (key: "alchemist/discovery/feral-mutagen", blueprint: "fd5f7b37ab4301c48a88cc196ee5f0ce", name: "Feral Mutagen", summary: "Mutagen grants two 1d6 claws and a 1d8 bite at full attack bonus, plus +2 to Persuasion (Intimidate).", guide: "alchemist#feral-mutagen"),
                (key: "alchemist/discovery/feral-wings", blueprint: "78197196e096c6e4eaed5c62fa108b52", name: "Feral Wings", summary: "With a feral mutagen, wings give +3 dodge AC against melee attacks and immunity to difficult terrain.", guide: "alchemist#feral-wings", prerequisite: All([ClassLevel(class: "alchemist", level: 6), SelectionOption("alchemist/discovery/feral-mutagen")])),
                (key: "alchemist/discovery/force-bombs", blueprint: "bfbaa0dd74b9909459e462cd8b091177", name: "Force Bombs", summary: "Bomb dice become d4s, but a direct hit knocks the target prone unless it saves on Reflex.", guide: "alchemist#force-bombs", prerequisite: ClassLevel(class: "alchemist", level: 8)),
                (key: "alchemist/discovery/frost-bomb", blueprint: "92cfb5ab50e2d9948b0577ba94b56bb2", name: "Frost Bomb", summary: "Bombs deal cold instead of fire, and a direct hit staggers for 1 round unless the target saves on Fortitude.", guide: "alchemist#frost-bomb"),
                (key: "alchemist/discovery/grand-cognatogen", blueprint: "af4a320648eb5724889d6ff6255090b2", name: "Grand Cognatogen", summary: "A reversed Grand Mutagen; when it ends, 2 ability damage to all three physical scores.", guide: "alchemist#grand-cognatogen", prerequisite: All([ClassLevel(class: "alchemist", level: 16), SelectionOption("alchemist/discovery/greater-cognatogen")])),
                (key: "alchemist/discovery/grand-mutagen", blueprint: "6f5cb651e26bd97428523061b07ffc85", name: "Grand Mutagen", summary: "Mutagen gives +6 natural armour and +8, +6 and +4 to the physical scores, with -2 to all mental scores.", guide: "alchemist#grand-mutagen", prerequisite: All([ClassLevel(class: "alchemist", level: 16), SelectionOption("alchemist/discovery/greater-mutagen")])),
                (key: "alchemist/discovery/greater-cognatogen", blueprint: "18eb29676492e844eb5a55d1c855ce69", name: "Greater Cognatogen", summary: "A reversed Greater Mutagen; when it ends, 2 ability damage to both lowered physical scores.", guide: "alchemist#greater-cognatogen", prerequisite: All([ClassLevel(class: "alchemist", level: 12), SelectionOption("alchemist/discovery/cognatogen")])),
                (key: "alchemist/discovery/greater-mutagen", blueprint: "76c61966afdd82048911f3d63c6fe0bc", name: "Greater Mutagen", summary: "Mutagen gives +4 natural armour, +6 to one physical score and +4 to another, with -2 to two mental scores.", guide: "alchemist#greater-mutagen", prerequisite: ClassLevel(class: "alchemist", level: 12)),
                (key: "alchemist/discovery/holy-bombs", blueprint: "1747eefb19e4e6649be836c5ae4ccc60", name: "Holy Bombs", summary: "Bombs deal divine damage, and an evil creature hit directly is staggered for 1 round unless it saves on Fortitude.", guide: "alchemist#holy-bombs", prerequisite: ClassLevel(class: "alchemist", level: 8)),
                (key: "alchemist/discovery/infusion", blueprint: "57d5077b301ade749b840b0ea9230bb9", name: "Infusion", summary: "Extracts can be used on others, including self-only effects such as Shield.", guide: "alchemist#infusion"),
                (key: "alchemist/discovery/mummification", blueprint: "daf854d84d442e941aa3a2fdc041b37c", name: "Mummification", summary: "Becomes undead-like: immune to cold, paralysis and sleep.", guide: "alchemist#mummification", prerequisite: All([Any([ClassLevel(class: "alchemist", level: 10), Feature(feature: "rogue/underground-chemist/discovery", count: 1)]), SelectionOption("alchemist/discovery/preserve-organs")])),
                (key: "alchemist/discovery/nauseating-flesh", blueprint: "de112af9600e0e446af0c7ef0707e1c8", name: "Nauseating Flesh", summary: "Creatures that bite you save on Fortitude or are nauseated for 1d4 rounds.", guide: "alchemist#nauseating-flesh"),
                (key: "alchemist/discovery/precise-bomb", blueprint: "5c396342f614dd644a48c3af08d79701", name: "Precise Bomb", summary: "Bombs no longer affect allies.", guide: "alchemist#precise-bomb"),
                (key: "alchemist/discovery/preserve-organs", blueprint: "76b4bb8e54f3f5c418f421684c76ef4e", name: "Preserve Organs", summary: "25% chance to negate extra damage from critical hits and sneak attacks; up to three times for 50% and 75%.", guide: "alchemist#preserve-organs", repeat: Times(3)),
                (key: "alchemist/discovery/shock-bomb", blueprint: "e1e0928b6ab2ae44fafb05b725b82b4f", name: "Shock Bomb", summary: "Bombs deal electricity instead of fire, and a direct hit dazzles for 1d4 rounds.", guide: "alchemist#shock-bomb"),
                (key: "alchemist/discovery/spontaneous-healing", blueprint: "2bc1ee626a69667469ab5c1698b99956", name: "Spontaneous Healing", summary: "Heals 5 HP as a free action, half the class level times per day.", guide: "alchemist#spontaneous-healing"),
                (key: "alchemist/discovery/tanglefoot-bombs", blueprint: "b3c99d01b29d836498595c1cfadc07aa", name: "Tanglefoot Bombs", summary: "The target saves on Reflex or is entangled and stuck in place; failed saves in the splash only entangle.", guide: "alchemist#tanglefoot-bombs"),
            ],
        ),
        (
            key: "alchemist/grand-discovery",
            blueprint: "2729af328ab46274394cedc3582d6e98",
            name: "Grand Discovery",
            summary: "At 20th level, two normal discoveries plus one grand discovery.",
            guide: "alchemist#grand-discovery",
            options: [
                (key: "alchemist/grand-discovery/awakened-intellect", blueprint: "d5378cb816b0c7a4cb47500e6ccf8702", name: "Awakened Intellect", summary: "+2 Intelligence.", guide: "alchemist#awakened-intellect"),
                (key: "alchemist/grand-discovery/fast-healing", blueprint: "318ce88da1832744c87fd15be5010dc0", name: "Fast Healing", summary: "Fast healing 5.", guide: "alchemist#fast-healing"),
                (key: "alchemist/grand-discovery/true-mutagen", blueprint: "15bac762b599b7e42824c333717d79d9", name: "True Mutagen", summary: "Requires Grand Mutagen: the mutagen gives +8 to all physical scores.", guide: "alchemist#true-mutagen"),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["alchemist/alchemist-proficiencies", "alchemist/bomb", "alchemist/mutagen"], feats: ["armor-proficiency-light-armor", "brew-potions", "simple-weapon-proficiency", "throw-anything"]),
        (level: 2, features: ["alchemist/poison-resistance"], selections: ["alchemist/discovery"]),
        (level: 3),
        (level: 4, selections: ["alchemist/discovery"]),
        (level: 5),
        (level: 6, selections: ["alchemist/discovery"]),
        (level: 7),
        (level: 8, selections: ["alchemist/discovery"]),
        (level: 9),
        (level: 10, features: ["alchemist/poison-immunity"], selections: ["alchemist/discovery"]),
        (level: 11),
        (level: 12, selections: ["alchemist/discovery"]),
        (level: 13),
        (level: 14, features: ["alchemist/persistent-mutagen"], selections: ["alchemist/discovery"]),
        (level: 15),
        (level: 16, selections: ["alchemist/discovery"]),
        (level: 17),
        (level: 18, selections: ["alchemist/discovery"]),
        (level: 19),
        (level: 20, selections: ["alchemist/grand-discovery"]),
    ],
    archetypes: [
        (
            key: "alchemist/chirurgeon",
            blueprint: "063440d550b25524abcb8dc2590d0168",
            name: "Chirurgeon",
            summary: "Alchemist who trades poison resistance for healing powers.",
            guide: "alchemist#chirurgeon",
            features: [
                (key: "alchemist/chirurgeon/infused-curative", blueprint: "adc8774dd97dd4d40b83909dc0efa4c3", name: "Infused Curative", summary: "From 2nd level, your healing extracts can be used on others.", guide: "alchemist#infused-curative"),
                (key: "alchemist/chirurgeon/power-over-death", blueprint: "ee4bad9521a00a94fbf60317631aaa92", name: "Power Over Death", summary: "At 10th level, adds Breath of Life to your formulae as a 4th-level extract.", guide: "alchemist#power-over-death"),
            ],
            levels: [
                (level: 2, features: ["alchemist/chirurgeon/infused-curative"], selections: ["alchemist/discovery"]),
                (level: 5, feats_for: [(feat: "skill-focus", value: Skill("lore-religion"))]),
                (level: 10, features: ["alchemist/chirurgeon/power-over-death"], selections: ["alchemist/discovery"]),
            ],
        ),
        (
            key: "alchemist/grenadier",
            blueprint: "6af888a7800b3e949a40f558ff204aae",
            name: "Grenadier",
            summary: "Alchemist with bomb improvements and a lesser poison resistance (max +4).",
            guide: "alchemist#grenadier",
            features: [
                (key: "alchemist/grenadier/alchemical-weapon", blueprint: "73adc9753dd361549a0598ea781255fb", name: "Alchemical Weapon", summary: "From 2nd level, a standard action coats a bomb or weapon with an alchemical substance, acid for example.", guide: "alchemist#alchemical-weapon"),
                (key: "alchemist/grenadier/alchemical-weapon-free", blueprint: "507aac54bf13bae4396dd54fb4d0b722", name: "Alchemical Weapon (Free)", summary: "From 15th level, Alchemical Weapon is a free action.", guide: "alchemist#grenadier"),
                (key: "alchemist/grenadier/alchemical-weapon-swift", blueprint: "ab3dd75baf960264cbbb73ea27b09f89", name: "Alchemical Weapon (Swift)", summary: "From 6th level, Alchemical Weapon is a swift action.", guide: "alchemist#grenadier"),
                (key: "alchemist/grenadier/directed-blast", blueprint: "e39991a116cbbf74c9c75926b25988eb", name: "Directed Blast", summary: "From 6th level, a bomb can detonate as a 30-foot cone.", guide: "alchemist#directed-blast"),
                (key: "alchemist/grenadier/precise-bomb", blueprint: "5c396342f614dd644a48c3af08d79701", name: "Precise Bomb", summary: "Bombs no longer affect allies.", guide: "alchemist#grenadier"),
                (key: "alchemist/grenadier/staggering-blast", blueprint: "60c711f083204f945ae556d7616c38a3", name: "Staggering Blast", summary: "From 10th level, a bomb critical hit staggers the target for 1d4+1 rounds, or 1 round on a Fortitude save.", guide: "alchemist#staggering-blast"),
            ],
            levels: [
                (level: 1, features: ["alchemist/alchemist-proficiencies", "alchemist/bomb", "alchemist/mutagen"], feats: ["armor-proficiency-light-armor", "brew-potions", "martial-weapons-proficiency", "simple-weapon-proficiency", "throw-anything"]),
                (level: 2, features: ["alchemist/grenadier/alchemical-weapon", "alchemist/grenadier/precise-bomb"], selections: ["alchemist/discovery"]),
                (level: 5, features: ["alchemist/poison-resistance"]),
                (level: 6, features: ["alchemist/grenadier/alchemical-weapon-swift", "alchemist/grenadier/directed-blast"], selections: ["alchemist/discovery"]),
                (level: 10, features: ["alchemist/grenadier/staggering-blast"], selections: ["alchemist/discovery"]),
                (level: 15, features: ["alchemist/grenadier/alchemical-weapon-free"]),
            ],
        ),
        (
            key: "alchemist/incense-synthesizer",
            blueprint: "6faf49766d8156c419d08f556a40374f",
            name: "Incense Synthesizer",
            summary: "Alchemist whose incense fog buffs allies; no mutagen and fewer bomb dice increases.",
            guide: "alchemist#incense-synthesizer",
            selections: [
                (
                    key: "alchemist/incense-synthesizer/incense-fog",
                    blueprint: "73d5950937bf0aa428e82c54c968f7e6",
                    name: "Incense Fog",
                    summary: "15-foot fog giving allies +1 attack and weapon damage for 3 + half level + Int rounds a day; a new incense at 3rd and every 3 levels.",
                    guide: "alchemist#incense-fog",
                    options: [
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-clarifying-incense", blueprint: "c16dc187fd12ac54f83007ec4c0a676a", name: "Incense Fog - Clarifying Incense", summary: "Allies in the fog get +2 to saves against mind-affecting effects; can be taken three times.", guide: "alchemist#incense-fog-clarifying-incense", repeat: Times(3)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-greater-sacred-incense", blueprint: "13b74d2110f8a2c43a71ae100074dbde", name: "Incense Fog - Greater Sacred Incense", summary: "Undead and evil outsiders in the fog save on Fortitude or are nauseated for 1d4 rounds, or sickened on a success.", guide: "alchemist#incense-fog-greater-sacred-incense", prerequisite: All([ClassLevel(class: "alchemist", level: 12), SelectionOption("alchemist/incense-synthesizer/incense-fog/incense-fog-sacred-incense")])),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-improved-incense", blueprint: "ccea52d8cc5f8d34d95196d0a885be06", name: "Incense Fog - Improved Incense", summary: "Allies in the fog get +1 more to attack and weapon damage; can be taken twice.", guide: "alchemist#incense-fog-improved-incense", repeat: Times(2), prerequisite: ClassLevel(class: "alchemist", level: 6)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-increased-range", blueprint: "1cd39502119e97f4caa72e7e53ce5ee9", name: "Incense Fog - Increased Range", summary: "The fog's radius grows to 30 feet.", guide: "alchemist#incense-fog-increased-range"),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-neutralizing-incense", blueprint: "6dd6caccd12ff6a4d9c12d36980e1906", name: "Incense Fog - Neutralizing Incense", summary: "Allies in the fog get +2 to saves against poison; can be taken three times.", guide: "alchemist#incense-fog-neutralizing-incense", repeat: Times(3)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-rallying-incense", blueprint: "c5f14b5981ec3994c80def79b6f5a77a", name: "Incense Fog - Rallying Incense", summary: "Allies in the fog get +2 to saves against fear; can be taken three times.", guide: "alchemist#incense-fog-rallying-incense", repeat: Times(3)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-sacred-incense", blueprint: "a3c58f42ba0e324469381c027a1950a4", name: "Incense Fog - Sacred Incense", summary: "Undead and evil outsiders in the fog save on Fortitude or are sickened for 1d4 rounds.", guide: "alchemist#incense-fog-sacred-incense"),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-thick-fog", blueprint: "9e920c1457a19a04caa583e320022cc0", name: "Incense Fog - Thick Fog", summary: "Allies in the fog have concealment (20% miss chance).", guide: "alchemist#incense-fog-thick-fog"),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-toxic-incense", blueprint: "8241699d20232084380fec8152434f2a", name: "Incense Fog - Toxic Incense", summary: "Enemies in the fog take -2 to saves against poison; can be taken three times.", guide: "alchemist#incense-fog-toxic-incense", repeat: Times(3)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-unsettling-fog", blueprint: "57a418cf996beeb4a9b1b3638cfc000e", name: "Incense Fog - Unsettling Fog", summary: "Enemies in the fog take -2 to saves against mind-affecting effects; can be taken three times.", guide: "alchemist#incense-fog-unsettling-fog", repeat: Times(3)),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["alchemist/alchemist-proficiencies", "alchemist/bomb"], feats: ["armor-proficiency-light-armor", "brew-potions", "simple-weapon-proficiency", "throw-anything"], selections: ["alchemist/incense-synthesizer/incense-fog"]),
                (level: 3, selections: ["alchemist/incense-synthesizer/incense-fog"]),
                (level: 6, selections: ["alchemist/discovery", "alchemist/incense-synthesizer/incense-fog"]),
                (level: 9, selections: ["alchemist/incense-synthesizer/incense-fog"]),
                (level: 12, selections: ["alchemist/discovery", "alchemist/incense-synthesizer/incense-fog"]),
                (level: 14, selections: ["alchemist/discovery"]),
                (level: 15, selections: ["alchemist/incense-synthesizer/incense-fog"]),
                (level: 18, selections: ["alchemist/discovery", "alchemist/incense-synthesizer/incense-fog"]),
            ],
        ),
        (
            key: "alchemist/metamorph",
            blueprint: "ac242ddeaa05af449bfc5230231fab84",
            name: "Metamorph",
            summary: "Alchemist who changes shape into beast and dragon forms instead of using bombs; adds Stealth as a class skill.",
            guide: "alchemist#metamorph",
            class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "perception", "stealth", "trickery", "use-magic-device"],
            features: [
                (key: "alchemist/metamorph/adaptive-physiology", blueprint: "cec88d5f7ebda294c93b95cd7360f504", name: "Adaptive Physiology", summary: "25% chance to ignore critical hits and precision damage from 3rd level, rising to 50% at 6th and 75% at 18th.", guide: "alchemist#adaptive-physiology"),
                (key: "alchemist/metamorph/shapechanger-beast-shape-i", blueprint: "2945e5527eefcef45bf9341d693c8bb0", name: "Shapechanger - Beast Shape I", summary: "Shapechanger: Beast Shape I forms for 1 hour per level, twice a day from 4th level plus once more per 2 levels.", guide: "alchemist#metamorph"),
                (key: "alchemist/metamorph/shapechanger-beast-shape-ii", blueprint: "8816d066b5d91584db9cecf3ce35123b", name: "Shapechanger - Beast Shape II", summary: "Shapechanger: adds Beast Shape II forms, each lasting 1 hour per class level.", guide: "alchemist#metamorph"),
                (key: "alchemist/metamorph/shapechanger-beast-shape-iii", blueprint: "417c585867dbb7745bddf70dd5b855ac", name: "Shapechanger - Beast Shape III", summary: "Shapechanger: adds Beast Shape III forms, each lasting 1 hour per class level.", guide: "alchemist#metamorph"),
                (key: "alchemist/metamorph/shapechanger-beast-shape-iv-dragonkind-i", blueprint: "c8abd0538b573d6458755ac64c1a34b9", name: "Shapechanger - Beast Shape IV, Dragonkind I", summary: "Shapechanger: adds Beast Shape IV and Dragonkind I forms, each lasting 1 hour per class level.", guide: "alchemist#metamorph"),
                (key: "alchemist/metamorph/shapechanger-dragonkind-ii", blueprint: "1dfe123d979d86f4aad0ab96385e8ac1", name: "Shapechanger - Dragonkind II", summary: "Shapechanger: adds Dragonkind II forms, each lasting 1 hour per class level.", guide: "alchemist#metamorph"),
