Class(
    key: "alchemist",
    name: "Alchemist",
    summary: "Dexterity and Intelligence class: 3/4 BAB, prepared extracts up to 6th level (self only until Infusion), bombs, mutagens and discoveries.",
    guide: "alchemist",
    skill_points: 3,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "perception", "trickery", "use-magic-device"],
    features: [
        (key: "alchemist/alchemist-proficiencies", name: "Alchemist Proficiencies", summary: "Simple weapons, bombs and light armour; no shields.", guide: "alchemist#alchemist-proficiencies"),
        (key: "alchemist/bomb", name: "Bomb", summary: "Class level + Int modifier bombs a day: 30-foot range, 1d6 fire + Int on a hit (+1d6 per odd level) and Reflex-halved splash.", guide: "alchemist#bomb"),
        (key: "alchemist/mutagen", name: "Mutagen", summary: "Mutagen for 10 minutes per level: +2 natural armour and +4 to Str, Dex or Con with -2 to Int, Wis or Cha respectively.", guide: "alchemist#mutagen"),
        (key: "alchemist/persistent-mutagen", name: "Persistent Mutagen", summary: "From 14th level, mutagens last 1 hour per class level.", guide: "alchemist#persistent-mutagen"),
        (key: "alchemist/poison-immunity", name: "Poison Immunity", summary: "From 10th level, immune to poison.", guide: "alchemist#poison-immunity"),
        (key: "alchemist/poison-resistance", name: "Poison Resistance", summary: "+2 to saves against poison at 2nd level, +4 at 5th and +6 at 8th.", guide: "alchemist#poison-resistance"),
    ],
    selections: [
        (
            key: "alchemist/discovery",
            name: "Discovery",
            summary: "A discovery at 2nd level and every even level; save DCs are 10 + half class level + Int modifier.",
            guide: "alchemist#discovery",
            options: [
                (key: "alchemist/discovery/acid-bomb", name: "Acid Bomb", summary: "Bombs deal acid instead of fire, and a direct hit deals 1d6 more acid damage the next round.", guide: "alchemist#acid-bomb"),
                (key: "alchemist/discovery/blinding-bombs", name: "Blinding Bombs", summary: "Direct hits must save on Fortitude or be blinded for 1 minute; the splash area is dazzled for 1 minute.", guide: "alchemist#blinding-bombs", prerequisite: ClassLevel(class: "alchemist", level: 8)),
                (key: "alchemist/discovery/breath-weapon-bomb", name: "Breath Weapon Bomb", summary: "A bomb can affect a 15-foot cone.", guide: "alchemist#breath-weapon-bomb", prerequisite: ClassLevel(class: "alchemist", level: 6)),
                (key: "alchemist/discovery/choking-bomb", name: "Choking Bomb", summary: "Gas bomb: creatures in it save on Fortitude or are nauseated 1 round per damage die, with a new save each round.", guide: "alchemist#choking-bomb"),
                (key: "alchemist/discovery/cognatogen", name: "Cognatogen", summary: "A reversed mutagen (such as +4 Int, -2 Str); when it ends, 2 ability damage to the lowered score.", guide: "alchemist#cognatogen"),
                (key: "alchemist/discovery/cursed-bomb", name: "Cursed Bomb", summary: "Requires 12th level: a direct hit must save on Will or suffer Bestow Curse.", guide: "alchemist#cursed-bomb", prerequisite: ClassLevel(class: "alchemist", level: 12)),
                (key: "alchemist/discovery/dispelling-bombs", name: "Dispelling Bombs", summary: "A direct hit applies a targeted Dispel Magic.", guide: "alchemist#dispelling-bombs", prerequisite: ClassLevel(class: "alchemist", level: 6)),
                (key: "alchemist/discovery/enhance-potion", name: "Enhance Potion", summary: "Potions he drinks use his class level as their caster level.", guide: "alchemist#enhance-potion"),
                (key: "alchemist/discovery/explosive-bombs", name: "Explosive Bombs", summary: "Splash radius grows to 10 feet, and direct hits set targets on fire for 1d6 fire damage a round.", guide: "alchemist#explosive-bombs"),
                (key: "alchemist/discovery/extend-potion", name: "Extend Potion", summary: "Potions last twice as long.", guide: "alchemist#extend-potion"),
                (key: "alchemist/discovery/fast-bombs", name: "Fast Bombs", summary: "Throws several bombs a round, like a ranged full attack.", guide: "alchemist#fast-bombs", prerequisite: ClassLevel(class: "alchemist", level: 8)),
                (key: "alchemist/discovery/feral-mutagen", name: "Feral Mutagen", summary: "Mutagen grants two 1d6 claws and a 1d8 bite at full attack bonus, plus +2 to Persuasion (Intimidate).", guide: "alchemist#feral-mutagen"),
                (key: "alchemist/discovery/feral-wings", name: "Feral Wings", summary: "With a feral mutagen, wings give +3 dodge AC against melee attacks and immunity to difficult terrain.", guide: "alchemist#feral-wings", prerequisite: All([ClassLevel(class: "alchemist", level: 6), SelectionOption("alchemist/discovery/feral-mutagen")])),
                (key: "alchemist/discovery/force-bombs", name: "Force Bombs", summary: "Bomb dice become d4s, but a direct hit knocks the target prone unless it saves on Reflex.", guide: "alchemist#force-bombs", prerequisite: ClassLevel(class: "alchemist", level: 8)),
                (key: "alchemist/discovery/frost-bomb", name: "Frost Bomb", summary: "Bombs deal cold instead of fire, and a direct hit staggers for 1 round unless the target saves on Fortitude.", guide: "alchemist#frost-bomb"),
                (key: "alchemist/discovery/grand-cognatogen", name: "Grand Cognatogen", summary: "A reversed Grand Mutagen; when it ends, 2 ability damage to all three physical scores.", guide: "alchemist#grand-cognatogen", prerequisite: All([ClassLevel(class: "alchemist", level: 16), SelectionOption("alchemist/discovery/greater-cognatogen")])),
                (key: "alchemist/discovery/grand-mutagen", name: "Grand Mutagen", summary: "Mutagen gives +6 natural armour and +8, +6 and +4 to the physical scores, with -2 to all mental scores.", guide: "alchemist#grand-mutagen", prerequisite: All([ClassLevel(class: "alchemist", level: 16), SelectionOption("alchemist/discovery/greater-mutagen")])),
                (key: "alchemist/discovery/greater-cognatogen", name: "Greater Cognatogen", summary: "A reversed Greater Mutagen; when it ends, 2 ability damage to both lowered physical scores.", guide: "alchemist#greater-cognatogen", prerequisite: All([ClassLevel(class: "alchemist", level: 12), SelectionOption("alchemist/discovery/cognatogen")])),
                (key: "alchemist/discovery/greater-mutagen", name: "Greater Mutagen", summary: "Mutagen gives +4 natural armour, +6 to one physical score and +4 to another, with -2 to two mental scores.", guide: "alchemist#greater-mutagen", prerequisite: ClassLevel(class: "alchemist", level: 12)),
                (key: "alchemist/discovery/holy-bombs", name: "Holy Bombs", summary: "Bombs deal divine damage, and an evil creature hit directly is staggered for 1 round unless it saves on Fortitude.", guide: "alchemist#holy-bombs", prerequisite: ClassLevel(class: "alchemist", level: 8)),
                (key: "alchemist/discovery/infusion", name: "Infusion", summary: "Extracts can be used on others, including self-only effects such as Shield.", guide: "alchemist#infusion"),
                (key: "alchemist/discovery/mummification", name: "Mummification", summary: "Becomes undead-like: immune to cold, paralysis and sleep.", guide: "alchemist#mummification", prerequisite: All([Any([ClassLevel(class: "alchemist", level: 10), Feature(feature: "rogue/underground-chemist/discovery", count: 1)]), SelectionOption("alchemist/discovery/preserve-organs")])),
                (key: "alchemist/discovery/nauseating-flesh", name: "Nauseating Flesh", summary: "Creatures that bite him save on Fortitude or are nauseated for 1d4 rounds.", guide: "alchemist#nauseating-flesh"),
                (key: "alchemist/discovery/precise-bomb", name: "Precise Bomb", summary: "Bombs no longer affect allies.", guide: "alchemist#precise-bomb"),
                (key: "alchemist/discovery/preserve-organs", name: "Preserve Organs", summary: "25% chance to negate extra damage from critical hits and sneak attacks; up to three times for 50% and 75%.", guide: "alchemist#preserve-organs", repeat: Times(3)),
                (key: "alchemist/discovery/shock-bomb", name: "Shock Bomb", summary: "Bombs deal electricity instead of fire, and a direct hit dazzles for 1d4 rounds.", guide: "alchemist#shock-bomb"),
                (key: "alchemist/discovery/spontaneous-healing", name: "Spontaneous Healing", summary: "Heals 5 HP as a free action, half the class level times per day.", guide: "alchemist#spontaneous-healing"),
                (key: "alchemist/discovery/tanglefoot-bombs", name: "Tanglefoot Bombs", summary: "The target saves on Reflex or is entangled and stuck in place; failed saves in the splash only entangle.", guide: "alchemist#tanglefoot-bombs"),
            ],
        ),
        (
            key: "alchemist/grand-discovery",
            name: "Grand Discovery",
            summary: "At 20th level, two normal discoveries plus one grand discovery.",
            guide: "alchemist#grand-discovery",
            options: [
                (key: "alchemist/grand-discovery/awakened-intellect", name: "Awakened Intellect", summary: "+2 Intelligence.", guide: "alchemist#awakened-intellect"),
                (key: "alchemist/grand-discovery/fast-healing", name: "Fast Healing", summary: "Fast healing 5.", guide: "alchemist#fast-healing"),
                (key: "alchemist/grand-discovery/true-mutagen", name: "True Mutagen", summary: "Requires Grand Mutagen: the mutagen gives +8 to all physical scores.", guide: "alchemist#true-mutagen"),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["alchemist/alchemist-proficiencies", "alchemist/bomb", "alchemist/mutagen"], feats: ["armor-proficiency-light-armor", "brew-potions", "simple-weapon-proficiency", "throw-anything"]),
        (level: 2, features: ["alchemist/poison-resistance"], selections: ["alchemist/discovery"]),
        (level: 3),
        (level: 4, selections: ["alchemist/discovery"]),
        (level: 5),
        (level: 6, selections: ["alchemist/discovery"]),
        (level: 7),
        (level: 8, selections: ["alchemist/discovery"]),
        (level: 9),
        (level: 10, features: ["alchemist/poison-immunity"], selections: ["alchemist/discovery"]),
        (level: 11),
        (level: 12, selections: ["alchemist/discovery"]),
        (level: 13),
        (level: 14, features: ["alchemist/persistent-mutagen"], selections: ["alchemist/discovery"]),
        (level: 15),
        (level: 16, selections: ["alchemist/discovery"]),
        (level: 17),
        (level: 18, selections: ["alchemist/discovery"]),
        (level: 19),
        (level: 20, selections: ["alchemist/grand-discovery"]),
    ],
    archetypes: [
        (
            key: "alchemist/chirurgeon",
            name: "Chirurgeon",
            summary: "Alchemist who trades poison resistance for healing powers.",
            guide: "alchemist#chirurgeon",
            features: [
                (key: "alchemist/chirurgeon/infused-curative", name: "Infused Curative", summary: "From 2nd level, his healing extracts can be used on others.", guide: "alchemist#infused-curative"),
                (key: "alchemist/chirurgeon/power-over-death", name: "Power Over Death", summary: "At 10th level, adds Breath of Life to his formulae as a 4th-level extract.", guide: "alchemist#power-over-death"),
            ],
            levels: [
                (level: 2, features: ["alchemist/chirurgeon/infused-curative"], selections: ["alchemist/discovery"]),
                (level: 5, feats_for: [(feat: "skill-focus", value: Skill("lore-religion"))]),
                (level: 10, features: ["alchemist/chirurgeon/power-over-death"], selections: ["alchemist/discovery"]),
            ],
        ),
        (
            key: "alchemist/grenadier",
            name: "Grenadier",
            summary: "Alchemist with bomb improvements and a lesser poison resistance (max +4).",
            guide: "alchemist#grenadier",
            features: [
                (key: "alchemist/grenadier/alchemical-weapon", name: "Alchemical Weapon", summary: "From 2nd level, a standard action coats a bomb or weapon with an alchemical substance, acid for example.", guide: "alchemist#alchemical-weapon"),
                (key: "alchemist/grenadier/alchemical-weapon-free", name: "Alchemical Weapon (Free)", summary: "From 15th level, Alchemical Weapon is a free action.", guide: "alchemist#grenadier"),
                (key: "alchemist/grenadier/alchemical-weapon-swift", name: "Alchemical Weapon (Swift)", summary: "From 6th level, Alchemical Weapon is a swift action.", guide: "alchemist#grenadier"),
                (key: "alchemist/grenadier/directed-blast", name: "Directed Blast", summary: "From 6th level, a bomb can detonate as a 30-foot cone.", guide: "alchemist#directed-blast"),
                (key: "alchemist/grenadier/precise-bomb", name: "Precise Bomb", summary: "Bombs no longer affect allies.", guide: "alchemist#grenadier"),
                (key: "alchemist/grenadier/staggering-blast", name: "Staggering Blast", summary: "From 10th level, a bomb critical hit staggers the target for 1d4+1 rounds, or 1 round on a Fortitude save.", guide: "alchemist#staggering-blast"),
            ],
            levels: [
                (level: 1, features: ["alchemist/alchemist-proficiencies", "alchemist/bomb", "alchemist/mutagen"], feats: ["armor-proficiency-light-armor", "brew-potions", "martial-weapons-proficiency", "simple-weapon-proficiency", "throw-anything"]),
                (level: 2, features: ["alchemist/grenadier/alchemical-weapon", "alchemist/grenadier/precise-bomb"], selections: ["alchemist/discovery"]),
                (level: 5, features: ["alchemist/poison-resistance"]),
                (level: 6, features: ["alchemist/grenadier/alchemical-weapon-swift", "alchemist/grenadier/directed-blast"], selections: ["alchemist/discovery"]),
                (level: 10, features: ["alchemist/grenadier/staggering-blast"], selections: ["alchemist/discovery"]),
                (level: 15, features: ["alchemist/grenadier/alchemical-weapon-free"]),
            ],
        ),
        (
            key: "alchemist/incense-synthesizer",
            name: "Incense Synthesizer",
            summary: "Alchemist whose incense fog buffs allies; no mutagen and fewer bomb dice increases.",
            guide: "alchemist#incense-synthesizer",
            selections: [
                (
                    key: "alchemist/incense-synthesizer/incense-fog",
                    name: "Incense Fog",
                    summary: "15-foot fog giving allies +1 attack and weapon damage for 3 + half level + Int rounds a day; a new incense at 3rd and every 3 levels.",
                    guide: "alchemist#incense-fog",
                    options: [
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-clarifying-incense", name: "Incense Fog - Clarifying Incense", summary: "Allies in the fog get +2 to saves against mind-affecting effects; can be taken three times.", guide: "alchemist#incense-fog-clarifying-incense", repeat: Times(3)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-greater-sacred-incense", name: "Incense Fog - Greater Sacred Incense", summary: "Undead and evil outsiders in the fog save on Fortitude or are nauseated for 1d4 rounds, or sickened on a success.", guide: "alchemist#incense-fog-greater-sacred-incense", prerequisite: All([ClassLevel(class: "alchemist", level: 12), SelectionOption("alchemist/incense-synthesizer/incense-fog/incense-fog-sacred-incense")])),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-improved-incense", name: "Incense Fog - Improved Incense", summary: "Allies in the fog get +1 more to attack and weapon damage; can be taken twice.", guide: "alchemist#incense-fog-improved-incense", repeat: Times(2), prerequisite: ClassLevel(class: "alchemist", level: 6)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-increased-range", name: "Incense Fog - Increased Range", summary: "The fog's radius grows to 30 feet.", guide: "alchemist#incense-fog-increased-range"),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-neutralizing-incense", name: "Incense Fog - Neutralizing Incense", summary: "Allies in the fog get +2 to saves against poison; can be taken three times.", guide: "alchemist#incense-fog-neutralizing-incense", repeat: Times(3)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-rallying-incense", name: "Incense Fog - Rallying Incense", summary: "Allies in the fog get +2 to saves against fear; can be taken three times.", guide: "alchemist#incense-fog-rallying-incense", repeat: Times(3)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-sacred-incense", name: "Incense Fog - Sacred Incense", summary: "Undead and evil outsiders in the fog save on Fortitude or are sickened for 1d4 rounds.", guide: "alchemist#incense-fog-sacred-incense"),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-thick-fog", name: "Incense Fog - Thick Fog", summary: "Allies in the fog have concealment (20% miss chance).", guide: "alchemist#incense-fog-thick-fog"),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-toxic-incense", name: "Incense Fog - Toxic Incense", summary: "Enemies in the fog take -2 to saves against poison; can be taken three times.", guide: "alchemist#incense-fog-toxic-incense", repeat: Times(3)),
                        (key: "alchemist/incense-synthesizer/incense-fog/incense-fog-unsettling-fog", name: "Incense Fog - Unsettling Fog", summary: "Enemies in the fog take -2 to saves against mind-affecting effects; can be taken three times.", guide: "alchemist#incense-fog-unsettling-fog", repeat: Times(3)),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["alchemist/alchemist-proficiencies", "alchemist/bomb"], feats: ["armor-proficiency-light-armor", "brew-potions", "simple-weapon-proficiency", "throw-anything"], selections: ["alchemist/incense-synthesizer/incense-fog"]),
                (level: 3, selections: ["alchemist/incense-synthesizer/incense-fog"]),
                (level: 6, selections: ["alchemist/discovery", "alchemist/incense-synthesizer/incense-fog"]),
                (level: 9, selections: ["alchemist/incense-synthesizer/incense-fog"]),
                (level: 12, selections: ["alchemist/discovery", "alchemist/incense-synthesizer/incense-fog"]),
                (level: 14, selections: ["alchemist/discovery"]),
                (level: 15, selections: ["alchemist/incense-synthesizer/incense-fog"]),
                (level: 18, selections: ["alchemist/discovery", "alchemist/incense-synthesizer/incense-fog"]),
            ],
        ),
        (
            key: "alchemist/metamorph",
            name: "Metamorph",
            summary: "Alchemist who changes shape into beast and dragon forms instead of using bombs; adds Stealth as a class skill.",
            guide: "alchemist#metamorph",
            class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "perception", "stealth", "trickery", "use-magic-device"],
            features: [
                (key: "alchemist/metamorph/adaptive-physiology", name: "Adaptive Physiology", summary: "25% chance to ignore critical hits and precision damage from 3rd level, rising to 50% at 6th and 75% at 18th.", guide: "alchemist#adaptive-physiology"),
                (key: "alchemist/metamorph/shapechanger-beast-shape-i", name: "Shapechanger - Beast Shape I", summary: "Shapechanger: Beast Shape I forms for 1 hour per level, twice a day from 4th level plus once more per 2 levels.", guide: "alchemist#metamorph"),
                (key: "alchemist/metamorph/shapechanger-beast-shape-ii", name: "Shapechanger - Beast Shape II", summary: "Shapechanger: adds Beast Shape II forms, each lasting 1 hour per class level.", guide: "alchemist#metamorph"),
                (key: "alchemist/metamorph/shapechanger-beast-shape-iii", name: "Shapechanger - Beast Shape III", summary: "Shapechanger: adds Beast Shape III forms, each lasting 1 hour per class level.", guide: "alchemist#metamorph"),
                (key: "alchemist/metamorph/shapechanger-beast-shape-iv-dragonkind-i", name: "Shapechanger - Beast Shape IV, Dragonkind I", summary: "Shapechanger: adds Beast Shape IV and Dragonkind I forms, each lasting 1 hour per class level.", guide: "alchemist#metamorph"),
                (key: "alchemist/metamorph/shapechanger-dragonkind-ii", name: "Shapechanger - Dragonkind II", summary: "Shapechanger: adds Dragonkind II forms, each lasting 1 hour per class level.", guide: "alchemist#metamorph"),
            ],
            levels: [
                (level: 1, features: ["alchemist/alchemist-proficiencies", "alchemist/mutagen"], feats: ["armor-proficiency-light-armor", "brew-potions", "simple-weapon-proficiency"]),
                (level: 3, features: ["alchemist/metamorph/adaptive-physiology"]),
                (level: 4, features: ["alchemist/metamorph/shapechanger-beast-shape-i"], selections: ["alchemist/discovery"]),
                (level: 9, features: ["alchemist/metamorph/shapechanger-beast-shape-ii"]),
                (level: 11, features: ["alchemist/metamorph/shapechanger-beast-shape-iii"]),
                (level: 13, features: ["alchemist/metamorph/shapechanger-beast-shape-iv-dragonkind-i"]),
                (level: 15, features: ["alchemist/metamorph/shapechanger-dragonkind-ii"]),
            ],
        ),
        (
            key: "alchemist/preservationist",
            name: "Preservationist",
            summary: "Alchemist who adds Summon Nature's Ally extracts, losing poison resistance and Persistent Mutagen.",
            guide: "alchemist#preservationist",
            features: [
                (key: "alchemist/preservationist/bottled-ally-i", name: "Bottled Ally I", summary: "At 2nd level, Summon Nature's Ally I joins his formulae as a 1st-level extract.", guide: "alchemist#bottled-ally-i"),
                (key: "alchemist/preservationist/bottled-ally-ii", name: "Bottled Ally II", summary: "At 5th level, Summon Nature's Ally II joins his formulae as a 2nd-level extract.", guide: "alchemist#bottled-ally-ii"),
                (key: "alchemist/preservationist/bottled-ally-iii", name: "Bottled Ally III", summary: "At 8th level, Summon Nature's Ally IV joins his formulae as a 3rd-level extract.", guide: "alchemist#bottled-ally-iii"),
                (key: "alchemist/preservationist/bottled-ally-iv", name: "Bottled Ally IV", summary: "At 10th level, Summon Nature's Ally V joins his formulae as a 4th-level extract.", guide: "alchemist#bottled-ally-iv"),
                (key: "alchemist/preservationist/bottled-ally-v", name: "Bottled Ally V", summary: "At 14th level, Summon Nature's Ally VII joins his formulae as a 5th-level extract.", guide: "alchemist#bottled-ally-v"),
                (key: "alchemist/preservationist/bottled-ally-vi", name: "Bottled Ally VI", summary: "At 18th level, Summon Nature's Ally IX joins his formulae as a 6th-level extract.", guide: "alchemist#bottled-ally-vi"),
            ],
            levels: [
                (level: 2, features: ["alchemist/preservationist/bottled-ally-i"], selections: ["alchemist/discovery"]),
                (level: 5, features: ["alchemist/preservationist/bottled-ally-ii"]),
                (level: 8, features: ["alchemist/preservationist/bottled-ally-iii"], selections: ["alchemist/discovery"]),
                (level: 10, features: ["alchemist/preservationist/bottled-ally-iv"], selections: ["alchemist/discovery"]),
                (level: 14, features: ["alchemist/preservationist/bottled-ally-v"], selections: ["alchemist/discovery"]),
                (level: 18, features: ["alchemist/preservationist/bottled-ally-vi"]),
            ],
        ),
        (
            key: "alchemist/reanimator",
            name: "Reanimator",
            summary: "Lord of Nothing alchemist who learns undead creation extracts, with weaker bombs.",
            guide: "alchemist#reanimator",
            features: [
                (key: "alchemist/reanimator/bomb-reanimator", name: "Bomb (Reanimator)", summary: "Bombs start at 1d4 and skip the damage increases at 5th, 11th and 15th level.", guide: "alchemist#bomb-reanimator"),
                (key: "alchemist/reanimator/corpse-studying", name: "Corpse Studying", summary: "After a kill, +1 attack and damage until combat ends, +1 more at 5th and every 6 levels (max +4 at 17th).", guide: "alchemist#corpse-studying"),
                (key: "alchemist/reanimator/greater-reanimation", name: "Greater Reanimation", summary: "At 15th level, adds Create Greater Undead as a 5th-level extract; his undead get +6 Str and Cha and one extra attack a round.", guide: "alchemist#greater-reanimation"),
                (key: "alchemist/reanimator/improved-reanimation", name: "Improved Reanimation", summary: "At 11th level, adds Create Undead as a 4th-level extract; his undead get +6 Str and Cha.", guide: "alchemist#improved-reanimation"),
                (key: "alchemist/reanimator/simple-reanimation", name: "Simple Reanimation", summary: "At 5th level, adds Animate Dead, Lesser as a 2nd-level extract; its undead get +4 Str and Cha.", guide: "alchemist#simple-reanimation"),
            ],
            levels: [
                (level: 1, features: ["alchemist/alchemist-proficiencies", "alchemist/mutagen", "alchemist/reanimator/bomb-reanimator", "alchemist/reanimator/corpse-studying"], feats: ["armor-proficiency-light-armor", "brew-potions", "simple-weapon-proficiency", "throw-anything"]),
                (level: 5, features: ["alchemist/reanimator/simple-reanimation"]),
                (level: 11, features: ["alchemist/reanimator/improved-reanimation"]),
                (level: 15, features: ["alchemist/reanimator/greater-reanimation"]),
            ],
        ),
        (
            key: "alchemist/vivisectionist",
            name: "Vivisectionist",
            summary: "Alchemist with sneak attack instead of bombs.",
