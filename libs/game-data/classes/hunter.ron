Class(
    key: "hunter",
    blueprint: "34ecd1b5e1b90b9498795791b0855239",
    name: "Hunter",
    summary: "Hunter with an animal companion: 3/4 BAB, good Fortitude and Reflex, spontaneous divine spells up to 6th level and Animal Focus aspects.",
    guide: "hunter",
    skill_points: 4,
    casting_ability: Wisdom,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Good,
    will: Poor,
    save_exceptions: [(level: 7, save: Will, value: 3)],
    class_skills: ["athletics", "knowledge-world", "lore-nature", "perception", "persuasion", "stealth"],
    spontaneous: true,
    features: [
        (key: "hunter/animal-companion", blueprint: "715ac15eb8bd5e342bc8a0a3c9e3e38f", name: "Animal Companion", summary: "Chooses an animal companion at 1st level.", guide: "hunter#animal-companion"),
        (key: "hunter/animal-focus", blueprint: "443365823b7d6d14b8d12f4e7bce1077", name: "Animal Focus", summary: "Gives your companion an animal aspect; as a swift action you can take the same benefit for minutes a day equal to your class level.", guide: "hunter#animal-focus", daily_choice: true),
        (key: "hunter/hunter-tactics", blueprint: "1b9916f7675d6ef4fb427081250d49de", name: "Hunter Tactics", summary: "From 3rd level, your animal companion gets your teamwork feats.", guide: "hunter#hunter-tactics"),
        (key: "hunter/master-hunter", blueprint: "d8a126a3ed3b62943a597c937a4bf840", name: "Master Hunter", summary: "At 20th level, you can use Animal Focus on yourself without a daily limit.", guide: "hunter#master-hunter"),
        (key: "hunter/nature-sense", blueprint: "22f280eeb4abde34bb92b58ec2673dad", name: "Nature Sense", summary: "+2 to Lore (Nature) checks.", guide: "hunter#nature-sense"),
        (key: "hunter/one-with-the-wild", blueprint: "c1e0f4ada7c673e4f8e5c57d1eea13d0", name: "One with the Wild", summary: "From 17th level, you and your companion can try to demoralize all animals within 30 feet as a swift action.", guide: "hunter#one-with-the-wild"),
        (key: "hunter/raise-animal-companion", blueprint: "27ad1316abbbbb34b8ffb9a87f38c10e", name: "Raise Animal Companion", summary: "From 10th level, Raise Dead on your companion as a spell-like ability; Resurrection from 16th.", guide: "hunter#raise-animal-companion"),
        (key: "hunter/second-animal-focus", blueprint: "cbc90fcdb60809744989d386a98cd21c", name: "Second Animal Focus", summary: "From 8th level, Animal Focus applies two aspects at once.", guide: "hunter#second-animal-focus", daily_choice: true),
        (key: "hunter/woodland-stride", blueprint: "2efe5983c9064cc6b55f16bc68f0fc33", name: "Woodland Stride", summary: "From 5th level, moves through difficult terrain at normal speed without harm.", guide: "hunter#woodland-stride"),
    ],
    feat_lists: [
        (key: "hunter/bonus-feats-2", blueprint: "75e9a5179aeff4140a8235ebdeaf8df7", name: "Precise Companion", guide: "hunter#precise-companion", ignores_prerequisites: true, feats: ["outflank", "precise-shot"]),
        (key: "hunter/bonus-feats-3", blueprint: "01046afc774beee48abde8e35da0f4ba", name: "Teamwork Feat", guide: "hunter#teamwork-feat", feats: ["allied-spellcaster", "back-to-back", "coordinated-defense", "coordinated-maneuvers", "outflank", "precise-shot", "precise-strike", "seize-the-moment", "shake-it-off", "shield-wall", "shielded-caster", "spell-chain", "tandem-trip", "volley-fire"]),
    ],
    levels: [
        (level: 1, divine_spell_level: 1, features: ["hunter/animal-companion", "hunter/animal-focus", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, divine_spell_level: 1, feat_slots: [OneOf(list: "hunter/bonus-feats-2")]),
        (level: 3, divine_spell_level: 1, features: ["hunter/hunter-tactics"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 4, divine_spell_level: 2),
        (level: 5, divine_spell_level: 2, features: ["hunter/woodland-stride"]),
        (level: 6, divine_spell_level: 2, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 7, divine_spell_level: 3),
        (level: 8, divine_spell_level: 3, features: ["hunter/second-animal-focus"]),
        (level: 9, divine_spell_level: 3, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 10, divine_spell_level: 4, features: ["hunter/raise-animal-companion"]),
        (level: 11, divine_spell_level: 4),
        (level: 12, divine_spell_level: 4, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 13, divine_spell_level: 5),
        (level: 14, divine_spell_level: 5),
        (level: 15, divine_spell_level: 5, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 16, divine_spell_level: 6),
        (level: 17, divine_spell_level: 6, features: ["hunter/one-with-the-wild"]),
        (level: 18, divine_spell_level: 6, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 19, divine_spell_level: 6),
        (level: 20, divine_spell_level: 6, features: ["hunter/master-hunter"]),
    ],
    archetypes: [
        (
            key: "hunter/colluding-scoundrel",
            blueprint: "34963fc6d87354c4fa85eb76f122c41c",
            name: "Colluding Scoundrel",
            summary: "Hunter who makes an ally the target of enemies' attacks and stabs those enemies.",
            guide: "hunter#colluding-scoundrel",
            features: [
                (key: "hunter/colluding-scoundrel/backstabber", blueprint: "f1ca6cf566e473e47bb0f3aee435ded0", name: "Backstabber", summary: "From 8th level, +2d6 precision damage against an enemy threatened by your scapegoat, 3d6 from 15th.", guide: "hunter#backstabber"),
                (key: "hunter/colluding-scoundrel/master-backstabber", blueprint: "9a2272e181d624349896ffdbf1157d6c", name: "Master Backstabber", summary: "At 20th level, a standard-action attack on the scapegoat's foe forces a Fort save (DC 20 + Wis) or death.", guide: "hunter#master-backstabber"),
                (key: "hunter/colluding-scoundrel/scapegoat", blueprint: "cffe3f12c8d00ba4fa15d0c6fcd375c8", name: "Scapegoat", summary: "Swift action: an adjacent foe gets -2 to attack others (-4 at 8th, -6 at 15th) and 10% spell failure for 1 minute; level/day, free on your companion.", guide: "hunter#scapegoat"),
            ],
            levels: [
                (level: 1, features: ["hunter/animal-companion", "hunter/colluding-scoundrel/scapegoat", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 8, features: ["hunter/colluding-scoundrel/backstabber", "hunter/colluding-scoundrel/scapegoat"]),
                (level: 15, features: ["hunter/colluding-scoundrel/backstabber", "hunter/colluding-scoundrel/scapegoat"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 20, features: ["hunter/colluding-scoundrel/master-backstabber"]),
            ],
        ),
        (
            key: "hunter/divine-hound",
            blueprint: "339659f6b09b4136bf8c2b2c3df87c65",
            name: "Divine Hound",
            summary: "Hunter with a dog or wolf and the Inquisitor's judgments instead of Animal Focus and a capstone.",
            guide: "hunter#divine-hound",
            features: [
                (key: "hunter/divine-hound/animal-companion-divine-hound", blueprint: "8abc5936b95d4983866f3bcace522e23", name: "Animal Companion (Divine Hound)", summary: "Your animal companion must be a dog or a wolf.", guide: "hunter#animal-companion-divine-hound"),
                (key: "hunter/divine-hound/companion-judgment", blueprint: "90a4d9f74ea1480abc1365f3e77bc73e", name: "Companion Judgment", summary: "Your animal companion shares your judgment bonuses.", guide: "hunter#companion-judgment"),
                (key: "hunter/divine-hound/judgment", blueprint: "981def910b98200499c0c8f85a78bde8", name: "Judgment", summary: "Judgments as the Inquisitor's, a swift-action bonus until combat ends, with a new judgment every 3 levels.", guide: "hunter#judgment"),
                (key: "hunter/divine-hound/second-judgment", blueprint: "33bf0404b70d65f42acac989ec5295b2", name: "Second Judgment", summary: "From 8th level, one use of Judgment pronounces two judgments.", guide: "hunter#second-judgment"),
                (key: "hunter/divine-hound/third-judgment", blueprint: "490c7e92b22cc8a4bb4885a027b355db", name: "Third Judgment", summary: "From 16th level, one use of Judgment pronounces three judgments.", guide: "hunter#third-judgment"),
            ],
            levels: [
                (level: 1, features: ["hunter/divine-hound/animal-companion-divine-hound", "hunter/divine-hound/companion-judgment", "hunter/divine-hound/judgment", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 4, features: ["hunter/divine-hound/judgment"]),
                (level: 7, features: ["hunter/divine-hound/judgment"]),
                (level: 8, features: ["hunter/divine-hound/second-judgment"]),
                (level: 10, features: ["hunter/divine-hound/judgment", "hunter/raise-animal-companion"]),
                (level: 13, features: ["hunter/divine-hound/judgment"]),
                (level: 16, features: ["hunter/divine-hound/judgment", "hunter/divine-hound/third-judgment"]),
                (level: 19, features: ["hunter/divine-hound/judgment"]),
                (level: 20),
            ],
        ),
        (
