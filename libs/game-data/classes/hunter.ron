Class(
    key: "hunter",
    name: "Hunter",
    summary: "Hunter with an animal companion: 3/4 BAB, good Fortitude and Reflex, spontaneous divine spells up to 6th level and Animal Focus aspects.",
    guide: "hunter",
    skill_points: 4,
    casting_ability: Wisdom,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Good,
    will: Poor,
    save_exceptions: [(level: 7, save: Will, value: 3)],
    class_skills: ["athletics", "knowledge-world", "lore-nature", "perception", "persuasion", "stealth"],
    spontaneous: true,
    features: [
        (key: "hunter/animal-companion", name: "Animal Companion", summary: "Chooses an animal companion at 1st level.", guide: "hunter#animal-companion"),
        (key: "hunter/animal-focus", name: "Animal Focus", summary: "Gives your companion an animal aspect; as a swift action you can take the same benefit for minutes a day equal to your class level.", guide: "hunter#animal-focus", daily_choice: true),
        (key: "hunter/hunter-tactics", name: "Hunter Tactics", summary: "From 3rd level, your animal companion gets your teamwork feats.", guide: "hunter#hunter-tactics"),
        (key: "hunter/master-hunter", name: "Master Hunter", summary: "At 20th level, you can use Animal Focus on yourself without a daily limit.", guide: "hunter#master-hunter"),
        (key: "hunter/nature-sense", name: "Nature Sense", summary: "+2 to Lore (Nature) checks.", guide: "hunter#nature-sense"),
        (key: "hunter/one-with-the-wild", name: "One with the Wild", summary: "From 17th level, you and your companion can try to demoralize all animals within 30 feet as a swift action.", guide: "hunter#one-with-the-wild"),
        (key: "hunter/raise-animal-companion", name: "Raise Animal Companion", summary: "From 10th level, Raise Dead on your companion as a spell-like ability; Resurrection from 16th.", guide: "hunter#raise-animal-companion"),
        (key: "hunter/second-animal-focus", name: "Second Animal Focus", summary: "From 8th level, Animal Focus applies two aspects at once.", guide: "hunter#second-animal-focus", daily_choice: true),
        (key: "hunter/woodland-stride", name: "Woodland Stride", summary: "From 5th level, moves through difficult terrain at normal speed without harm.", guide: "hunter#woodland-stride"),
    ],
    feat_lists: [
        (key: "hunter/bonus-feats-2", name: "Precise Companion", guide: "hunter#precise-companion", ignores_prerequisites: true, feats: ["outflank", "precise-shot"]),
        (key: "hunter/bonus-feats-3", name: "Teamwork Feat", guide: "hunter#teamwork-feat", feats: ["allied-spellcaster", "back-to-back", "coordinated-defense", "coordinated-maneuvers", "outflank", "precise-shot", "precise-strike", "seize-the-moment", "shake-it-off", "shield-wall", "shielded-caster", "spell-chain", "tandem-trip", "volley-fire"]),
    ],
    levels: [
        (level: 1, divine_spell_level: 1, features: ["hunter/animal-companion", "hunter/animal-focus", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, divine_spell_level: 1, feat_slots: [OneOf(list: "hunter/bonus-feats-2")]),
        (level: 3, divine_spell_level: 1, features: ["hunter/hunter-tactics"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 4, divine_spell_level: 2),
        (level: 5, divine_spell_level: 2, features: ["hunter/woodland-stride"]),
        (level: 6, divine_spell_level: 2, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 7, divine_spell_level: 3),
        (level: 8, divine_spell_level: 3, features: ["hunter/second-animal-focus"]),
        (level: 9, divine_spell_level: 3, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 10, divine_spell_level: 4, features: ["hunter/raise-animal-companion"]),
        (level: 11, divine_spell_level: 4),
        (level: 12, divine_spell_level: 4, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 13, divine_spell_level: 5),
        (level: 14, divine_spell_level: 5),
        (level: 15, divine_spell_level: 5, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 16, divine_spell_level: 6),
        (level: 17, divine_spell_level: 6, features: ["hunter/one-with-the-wild"]),
        (level: 18, divine_spell_level: 6, feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
        (level: 19, divine_spell_level: 6),
        (level: 20, divine_spell_level: 6, features: ["hunter/master-hunter"]),
    ],
    archetypes: [
        (
            key: "hunter/colluding-scoundrel",
            name: "Colluding Scoundrel",
            summary: "Hunter who makes an ally the target of enemies' attacks and stabs those enemies.",
            guide: "hunter#colluding-scoundrel",
            features: [
                (key: "hunter/colluding-scoundrel/backstabber", name: "Backstabber", summary: "From 8th level, +2d6 precision damage against an enemy threatened by your scapegoat, 3d6 from 15th.", guide: "hunter#backstabber"),
                (key: "hunter/colluding-scoundrel/master-backstabber", name: "Master Backstabber", summary: "At 20th level, a standard-action attack on the scapegoat's foe forces a Fort save (DC 20 + Wis) or death.", guide: "hunter#master-backstabber"),
                (key: "hunter/colluding-scoundrel/scapegoat", name: "Scapegoat", summary: "Swift action: an adjacent foe gets -2 to attack others (-4 at 8th, -6 at 15th) and 10% spell failure for 1 minute; level/day, free on your companion.", guide: "hunter#scapegoat"),
            ],
            levels: [
                (level: 1, features: ["hunter/animal-companion", "hunter/colluding-scoundrel/scapegoat", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 8, features: ["hunter/colluding-scoundrel/backstabber"]),
                (level: 20, features: ["hunter/colluding-scoundrel/master-backstabber"]),
            ],
        ),
        (
            key: "hunter/divine-hound",
            name: "Divine Hound",
            summary: "Hunter with a dog or wolf and the Inquisitor's judgments instead of Animal Focus and a capstone.",
            guide: "hunter#divine-hound",
            features: [
                (key: "hunter/divine-hound/animal-companion-divine-hound", name: "Animal Companion (Divine Hound)", summary: "Your animal companion must be a dog or a wolf.", guide: "hunter#animal-companion-divine-hound"),
                (key: "hunter/divine-hound/companion-judgment", name: "Companion Judgment", summary: "Your animal companion shares your judgment bonuses.", guide: "hunter#companion-judgment"),
                (key: "hunter/divine-hound/judgment", name: "Judgment", summary: "Judgments as the Inquisitor's, a swift-action bonus until combat ends, with a new judgment every 3 levels.", guide: "hunter#judgment"),
                (key: "hunter/divine-hound/second-judgment", name: "Second Judgment", summary: "From 8th level, one use of Judgment pronounces two judgments.", guide: "hunter#second-judgment"),
                (key: "hunter/divine-hound/third-judgment", name: "Third Judgment", summary: "From 16th level, one use of Judgment pronounces three judgments.", guide: "hunter#third-judgment"),
            ],
            levels: [
                (level: 1, features: ["hunter/divine-hound/animal-companion-divine-hound", "hunter/divine-hound/companion-judgment", "hunter/divine-hound/judgment", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 4, features: ["hunter/divine-hound/judgment"]),
                (level: 7, features: ["hunter/divine-hound/judgment"]),
                (level: 8, features: ["hunter/divine-hound/second-judgment"]),
                (level: 10, features: ["hunter/divine-hound/judgment", "hunter/raise-animal-companion"]),
                (level: 13, features: ["hunter/divine-hound/judgment"]),
                (level: 16, features: ["hunter/divine-hound/judgment", "hunter/divine-hound/third-judgment"]),
                (level: 19, features: ["hunter/divine-hound/judgment"]),
                (level: 20),
            ],
        ),
        (
            key: "hunter/divine-hunter",
            prerequisite: Worships,
            name: "Divine Hunter",
            summary: "Hunter devoted to a deity: a domain and Lore (Religion) as a class skill, losing teamwork feats.",
            guide: "hunter#divine-hunter",
            selections: [
                (
                    key: "hunter/divine-hunter/domain",
                    name: "Domain (Divine Hunter)",
                    summary: "You choose a domain of your deity; its domain spells join your spellbook.",
                    deity_domains: Offered,
                    guide: "hunter#domain",
                    option_levels: ["hunter"],
                    options: [],
                    shared_options: [
                        "cleric/domain/air",
                        "cleric/domain/animal",
                        "cleric/domain/artifice",
                        "cleric/domain/chaos",
                        "cleric/domain/charm",
                        "cleric/domain/community",
                        "cleric/domain/darkness",
                        "cleric/domain/death",
                        "cleric/domain/destruction",
                        "cleric/domain/earth",
                        "cleric/domain/evil",
                        "cleric/domain/fire",
                        "cleric/domain/glory",
                        "cleric/domain/good",
                        "cleric/domain/healing",
                        "cleric/domain/ice",
                        "cleric/domain/knowledge",
                        "cleric/domain/law",
                        "cleric/domain/liberation",
                        "cleric/domain/luck",
                        "cleric/domain/madness",
                        "cleric/domain/magic",
                        "cleric/domain/murder",
                        "cleric/domain/nobility",
                        "cleric/domain/plant",
                        "cleric/domain/protection",
                        "cleric/domain/repose",
                        "cleric/domain/rune",
                        "cleric/domain/scalykind",
                        "cleric/domain/strength",
                        "cleric/domain/sun",
                        "cleric/domain/travel",
                        "cleric/domain/trickery",
                        "cleric/domain/undead",
                        "cleric/domain/war",
                        "cleric/domain/water",
                        "cleric/domain/weather",
                    ],
                ),
                (
                    key: "hunter/divine-hunter/otherworldly-companion",
                    name: "Otherworldly Companion",
                    summary: "From 3rd level, your companion becomes Celestial or Fiendish, by alignment.",
                    guide: "hunter#otherworldly-companion",
                    options: [
                        (key: "hunter/divine-hunter/otherworldly-companion/otherworldly-companion-celestial", name: "Otherworldly Companion - Celestial", summary: "Companion gets SR 5 + level, cold, electricity and acid resistance 5 (10, then 15), DR 5/evil then 10/evil, and Smite Evil once a day.", guide: "hunter#otherworldly-companion-celestial"),
                        (key: "hunter/divine-hunter/otherworldly-companion/otherworldly-companion-fiendish", name: "Otherworldly Companion - Fiendish", summary: "Companion gets SR 5 + level, cold and fire resistance 5 (10, then 15), DR 5/good then 10/good, and Smite Good once a day.", guide: "hunter#otherworldly-companion-fiendish"),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["hunter/animal-companion", "hunter/animal-focus", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"], selections: ["hunter/divine-hunter/domain"]),
                (level: 3, selections: ["hunter/divine-hunter/otherworldly-companion"]),
                (level: 6),
                (level: 9),
                (level: 12),
                (level: 15),
                (level: 18),
            ],
        ),
        (
            key: "hunter/forester",
            name: "Forester",
            summary: "Hunter without an animal companion who gains terrains, bonus combat feats and stealth.",
            guide: "hunter#forester",
            features: [
                (key: "hunter/forester/breath-of-life", name: "Breath of Life", summary: "From 10th level, Breath of Life becomes one of your spell-like abilities.", guide: "hunter#breath-of-life"),
                (key: "hunter/forester/camouflage", name: "Camouflage", summary: "From 7th level, you use Stealth in your favoured terrain without cover.", guide: "hunter#camouflage"),
                (key: "hunter/forester/evasion", name: "Evasion", guide: "hunter#forester"),
                (key: "hunter/forester/favored-terrain", name: "Favored Terrain", summary: "A favoured terrain like the Ranger's at 5th level, another every 4 levels.", guide: "hunter#favored-terrain"),
                (key: "hunter/forester/hide-in-plain-sight", name: "Hide in Plain Sight", summary: "From 14th level, Camouflage works in any terrain.", guide: "hunter#hide-in-plain-sight"),
                (key: "hunter/forester/improved-evasion", name: "Improved Evasion", guide: "hunter#forester"),
                (key: "hunter/forester/tactician", name: "Tactician", summary: "From 3rd level, standard action: allies within 30 feet get one teamwork feat for level + 3 rounds; once a day, +1 at 7th, 12th, 17th.", guide: "hunter#tactician"),
                (key: "hunter/forester/terrain-expertise", name: "Terrain Expertise", summary: "From 11th level, a favoured enemy bonus against creatures in one chosen favoured terrain; more terrains at 15th and 19th.", guide: "hunter#terrain-expertise"),
            ],
            levels: [
                (level: 1, features: ["hunter/animal-focus", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, feat_slots: [CombatFeat]),
                (level: 3, features: ["hunter/forester/tactician"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 4, features: ["hunter/forester/evasion"]),
                (level: 5, features: ["hunter/forester/favored-terrain", "hunter/woodland-stride"]),
                (level: 7, features: ["hunter/forester/camouflage"], feat_slots: [CombatFeat]),
                (level: 8),
                (level: 9, features: ["hunter/forester/favored-terrain"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 10, features: ["hunter/forester/breath-of-life"]),
                (level: 11, features: ["hunter/forester/improved-evasion", "hunter/forester/terrain-expertise"]),
                (level: 13, features: ["hunter/forester/favored-terrain"], feat_slots: [CombatFeat]),
                (level: 14, features: ["hunter/forester/hide-in-plain-sight"]),
                (level: 15, features: ["hunter/forester/terrain-expertise"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 17, features: ["hunter/forester/favored-terrain", "hunter/one-with-the-wild"]),
                (level: 19, features: ["hunter/forester/terrain-expertise"], feat_slots: [CombatFeat]),
            ],
        ),
        (
            key: "hunter/tandem-executioner",
            name: "Tandem Executioner",
            summary: "Lord of Nothing hunter: you have no spells, but study targets and fight in tandem with your companion.",
            guide: "hunter#tandem-executioner",
            features: [
                (key: "hunter/tandem-executioner/aversion-to-spellcasting", name: "Aversion to Spellcasting", summary: "Gains no spells and has no caster level.", guide: "hunter#aversion-to-spellcasting"),
                (key: "hunter/tandem-executioner/studied-target", name: "Studied Target", summary: "As the Slayer's, shared with your companion within 60 feet: move action for +1 attack, damage and DCs against a foe, +1 at 5th, 10th, 15th, 20th.", guide: "hunter#studied-target"),
                (key: "hunter/tandem-executioner/studied-target-swift", name: "Studied Target (Swift)", summary: "From 7th level, Studied Target is a swift action.", guide: "hunter#studied-target-swift"),
            ],
            selections: [
                (
                    key: "hunter/tandem-executioner/tandem-executioner-techniques",
                    name: "Tandem Executioner Techniques",
                    summary: "A combat technique for you and your companion at 4th level and every 3 levels after.",
                    guide: "hunter#tandem-executioner-techniques",
                    options: [
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/disrupted-focus", name: "Disrupted Focus", summary: "Enemies within 10 feet of you or your companion need +4 DC to cast defensively.", guide: "hunter#disrupted-focus"),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/elusive-pair", name: "Elusive Pair", summary: "Within 10 feet of each other, you and your companion get class level / 4 as dodge AC and to Reflex saves.", guide: "hunter#elusive-pair", prerequisite: All([ClassLevel(class: "hunter", level: 16), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/timely-warning"), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/vigilant-partners")])),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/make-it-bleed", name: "Make It Bleed", summary: "Attacking the same foe within 10 feet of each other: +4 to confirm crits, and confirmed crits add 2d6 bleed.", guide: "hunter#make-it-bleed", prerequisite: All([ClassLevel(class: "hunter", level: 16), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/protective-duo"), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/working-in-tandem")])),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/new-favorite-toy", name: "New Favorite Toy", summary: "Companion attacks of opportunity stop movement; your ranged hits mark a foe for +1d6 per 4 levels on the companion's next attack.", guide: "hunter#new-favorite-toy"),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/piercing-cascade", name: "Piercing Cascade", summary: "Full-round action: a ranged attack on every enemy within 15 feet of a point; foes near your companion get -2 AC against it.", guide: "hunter#piercing-cascade", prerequisite: All([ClassLevel(class: "hunter", level: 16), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/new-favorite-toy"), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/push-and-bite")])),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/prey-of-choice", name: "Prey of Choice", summary: "+2 attack and damage against a foe who casts until combat ends; foes within 10 feet roll concentration twice, keeping the worse.", guide: "hunter#prey-of-choice", prerequisite: All([ClassLevel(class: "hunter", level: 16), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/disrupted-focus"), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/spellbane")])),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/protective-duo", name: "Protective Duo", summary: "Within 10 feet of each other, each gets an attack of opportunity on an adjacent foe that hits the other.", guide: "hunter#protective-duo", prerequisite: SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/working-in-tandem")),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/push-and-bite", name: "Push and Bite", summary: "Once a round, a ranged attack on a foe next to your companion adds a +4 Dex-based bull rush; on success the companion hits it automatically.", guide: "hunter#push-and-bite", prerequisite: SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/new-favorite-toy")),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/spellbane", name: "Spellbane", summary: "Enemies within 10 feet of you or your companion take -2 to spell DCs and spell attack rolls.", guide: "hunter#spellbane", prerequisite: SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/disrupted-focus")),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/timely-warning", name: "Timely Warning", summary: "Once a round, a failed save by one of the pair can be negated by the other's Lore (Nature) or Mobility check.", guide: "hunter#timely-warning", prerequisite: SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/vigilant-partners")),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/vigilant-partners", name: "Vigilant Partners", summary: "Once a round, a hit on one of the pair can be negated by the other's Lore (Nature) or Mobility check against the attack roll.", guide: "hunter#vigilant-partners"),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/working-in-tandem", name: "Working in Tandem", summary: "Attacking the same foe in melee within 10 feet of each other, both get class level / 4 to attack.", guide: "hunter#working-in-tandem"),
                    ],
                ),
            ],
            levels: [
                (level: 1, spell_levels: (arcane: 0, divine: 0), features: ["hunter/animal-companion", "hunter/animal-focus", "hunter/nature-sense", "hunter/tandem-executioner/aversion-to-spellcasting", "hunter/tandem-executioner/studied-target"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, spell_levels: (arcane: 0, divine: 0), feat_slots: [OneOf(list: "hunter/bonus-feats-2")]),
                (level: 3, spell_levels: (arcane: 0, divine: 0), features: ["hunter/hunter-tactics"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 4, spell_levels: (arcane: 0, divine: 0), selections: ["hunter/tandem-executioner/tandem-executioner-techniques"]),
                (level: 5, spell_levels: (arcane: 0, divine: 0), features: ["hunter/woodland-stride"]),
                (level: 6, spell_levels: (arcane: 0, divine: 0), feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 7, spell_levels: (arcane: 0, divine: 0), features: ["hunter/tandem-executioner/studied-target-swift"], selections: ["hunter/tandem-executioner/tandem-executioner-techniques"]),
                (level: 8, spell_levels: (arcane: 0, divine: 0), features: ["hunter/second-animal-focus"]),
                (level: 9, spell_levels: (arcane: 0, divine: 0), feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 10, spell_levels: (arcane: 0, divine: 0), selections: ["hunter/tandem-executioner/tandem-executioner-techniques"]),
                (level: 11, spell_levels: (arcane: 0, divine: 0)),
                (level: 12, spell_levels: (arcane: 0, divine: 0), feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 13, spell_levels: (arcane: 0, divine: 0), selections: ["hunter/tandem-executioner/tandem-executioner-techniques"]),
                (level: 14, spell_levels: (arcane: 0, divine: 0)),
                (level: 15, spell_levels: (arcane: 0, divine: 0), feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 16, spell_levels: (arcane: 0, divine: 0), selections: ["hunter/tandem-executioner/tandem-executioner-techniques"]),
                (level: 17, spell_levels: (arcane: 0, divine: 0), features: ["hunter/one-with-the-wild"]),
                (level: 18, spell_levels: (arcane: 0, divine: 0), feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 19, spell_levels: (arcane: 0, divine: 0), selections: ["hunter/tandem-executioner/tandem-executioner-techniques"]),
                (level: 20, spell_levels: (arcane: 0, divine: 0), features: ["hunter/master-hunter"]),
            ],
        ),
        (
            key: "hunter/urban-hunter",
            name: "Urban Hunter",
            summary: "Hunter with a dog or horse and bonus feats instead of teamwork feats.",
            guide: "hunter#urban-hunter",
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "perception", "persuasion", "stealth"],
            features: [
                (key: "hunter/urban-hunter/animal-companion-urban-hunter", name: "Animal Companion (Urban Hunter)", summary: "Your animal companion must be a dog or a horse.", guide: "hunter#animal-companion-urban-hunter"),
                (key: "hunter/urban-hunter/animal-insight", name: "Animal Insight", summary: "From 5th level, within 30 feet of each other, you and your companion get half level to Perception and +2 to saves against mind effects.", guide: "hunter#animal-insight"),
                (key: "hunter/urban-hunter/frightful-ferocity", name: "Frightful Ferocity", summary: "From 17th level, you and your companion can each demoralize a foe as a swift action.", guide: "hunter#frightful-ferocity"),
            ],
            feat_lists: [
