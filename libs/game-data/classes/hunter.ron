                (level: 18),
            ],
        ),
        (
            key: "hunter/forester",
            blueprint: "74ee8172df6782f4792ea0f8647dea34",
            name: "Forester",
            summary: "Hunter without an animal companion who gains terrains, bonus combat feats and stealth.",
            guide: "hunter#forester",
            features: [
                (key: "hunter/forester/breath-of-life", blueprint: "c1c18f217c3327e4da0737a67a3fc08a", name: "Breath of Life", summary: "From 10th level, Breath of Life becomes one of your spell-like abilities.", guide: "hunter#breath-of-life"),
                (key: "hunter/forester/camouflage", blueprint: "df6c28d42a029bf4f94b65390b9b624a", name: "Camouflage", summary: "From 7th level, you use Stealth in your favoured terrain without cover.", guide: "hunter#camouflage"),
                (key: "hunter/forester/evasion", blueprint: "576933720c440aa4d8d42b0c54b77e80", name: "Evasion", guide: "hunter#forester"),
                (key: "hunter/forester/favored-terrain", blueprint: "a6ea422d7308c0d428a541562faedefd", name: "Favored Terrain", summary: "A favoured terrain like the Ranger's at 5th level, another every 4 levels.", guide: "hunter#favored-terrain"),
                (key: "hunter/forester/hide-in-plain-sight", blueprint: "6a0e4c8021fd6fa41ad28b54ba3355cb", name: "Hide in Plain Sight", summary: "From 14th level, Camouflage works in any terrain.", guide: "hunter#hide-in-plain-sight"),
                (key: "hunter/forester/improved-evasion", blueprint: "ce96af454a6137d47b9c6a1e02e66803", name: "Improved Evasion", guide: "hunter#forester"),
                (key: "hunter/forester/tactician", blueprint: "994db4abfa0d6194eb3c847605e6f148", name: "Tactician", summary: "From 3rd level, standard action: allies within 30 feet get one teamwork feat for level + 3 rounds; once a day, +1 at 7th, 12th, 17th.", guide: "hunter#tactician"),
                (key: "hunter/forester/terrain-expertise", blueprint: "1c3413f68270d664ea143182f2abe8a9", name: "Terrain Expertise", summary: "From 11th level, a favoured enemy bonus against creatures in one chosen favoured terrain; more terrains at 15th and 19th.", guide: "hunter#terrain-expertise"),
            ],
            levels: [
                (level: 1, features: ["hunter/animal-focus", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, feat_slots: [CombatFeat]),
                (level: 3, features: ["hunter/forester/tactician"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 4, features: ["hunter/forester/evasion"]),
                (level: 5, features: ["hunter/forester/favored-terrain", "hunter/woodland-stride"]),
                (level: 7, features: ["hunter/forester/camouflage", "hunter/forester/tactician"], feat_slots: [CombatFeat]),
                (level: 8),
                (level: 9, features: ["hunter/forester/favored-terrain"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 10, features: ["hunter/forester/breath-of-life"]),
                (level: 11, features: ["hunter/forester/improved-evasion", "hunter/forester/terrain-expertise"]),
                (level: 12, features: ["hunter/forester/tactician"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 13, features: ["hunter/forester/favored-terrain"], feat_slots: [CombatFeat]),
                (level: 14, features: ["hunter/forester/hide-in-plain-sight"]),
                (level: 15, features: ["hunter/forester/terrain-expertise"], feat_slots: [OneOf(list: "hunter/bonus-feats-3")]),
                (level: 17, features: ["hunter/forester/favored-terrain", "hunter/forester/tactician", "hunter/one-with-the-wild"]),
                (level: 19, features: ["hunter/forester/terrain-expertise"], feat_slots: [CombatFeat]),
            ],
        ),
        (
            key: "hunter/tandem-executioner",
            blueprint: "6d42902b472c4b84b146196fad4bd3c4",
            name: "Tandem Executioner",
            summary: "Lord of Nothing hunter: you have no spells, but study targets and fight in tandem with your companion.",
            guide: "hunter#tandem-executioner",
            features: [
                (key: "hunter/tandem-executioner/aversion-to-spellcasting", blueprint: "48a1bbd976a74556922e8a393ecc116f", name: "Aversion to Spellcasting", summary: "Gains no spells and has no caster level.", guide: "hunter#aversion-to-spellcasting"),
                (key: "hunter/tandem-executioner/studied-target", blueprint: "3dac0ae65dec4b619c035df07751b59d", name: "Studied Target", summary: "As the Slayer's, shared with your companion within 60 feet: move action for +1 attack, damage and DCs against a foe, +1 at 5th, 10th, 15th, 20th.", guide: "hunter#studied-target"),
                (key: "hunter/tandem-executioner/studied-target-swift", blueprint: "40d4f55a5ac0e4f469d67d36c0dfc40b", name: "Studied Target (Swift)", summary: "From 7th level, Studied Target is a swift action.", guide: "hunter#studied-target-swift"),
            ],
            selections: [
                (
                    key: "hunter/tandem-executioner/tandem-executioner-techniques",
                    blueprint: "d03312858cd5420e8bad2756ce4a72ba",
                    name: "Tandem Executioner Techniques",
                    summary: "A combat technique for you and your companion at 4th level and every 3 levels after.",
                    guide: "hunter#tandem-executioner-techniques",
                    options: [
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/disrupted-focus", blueprint: "d5190eed73964203a02f331a3759461c", name: "Disrupted Focus", summary: "Enemies within 10 feet of you or your companion need +4 DC to cast defensively.", guide: "hunter#disrupted-focus"),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/elusive-pair", blueprint: "14b1834ec5a04927bd3db04821f54bf7", name: "Elusive Pair", summary: "Within 10 feet of each other, you and your companion get class level / 4 as dodge AC and to Reflex saves.", guide: "hunter#elusive-pair", prerequisite: All([ClassLevel(class: "hunter", level: 16), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/timely-warning"), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/vigilant-partners")])),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/make-it-bleed", blueprint: "731574bc1f784f7d835c1185c0a01c9c", name: "Make It Bleed", summary: "Attacking the same foe within 10 feet of each other: +4 to confirm crits, and confirmed crits add 2d6 bleed.", guide: "hunter#make-it-bleed", prerequisite: All([ClassLevel(class: "hunter", level: 16), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/protective-duo"), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/working-in-tandem")])),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/new-favorite-toy", blueprint: "85514caba3364033a12070bfecf39bf5", name: "New Favorite Toy", summary: "Companion attacks of opportunity stop movement; your ranged hits mark a foe for +1d6 per 4 levels on the companion's next attack.", guide: "hunter#new-favorite-toy"),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/piercing-cascade", blueprint: "3dad959870604d208b5ce1b19d3cf49d", name: "Piercing Cascade", summary: "Full-round action: a ranged attack on every enemy within 15 feet of a point; foes near your companion get -2 AC against it.", guide: "hunter#piercing-cascade", prerequisite: All([ClassLevel(class: "hunter", level: 16), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/new-favorite-toy"), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/push-and-bite")])),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/prey-of-choice", blueprint: "6b8eb3870131434da4391533a99c149d", name: "Prey of Choice", summary: "+2 attack and damage against a foe who casts until combat ends; foes within 10 feet roll concentration twice, keeping the worse.", guide: "hunter#prey-of-choice", prerequisite: All([ClassLevel(class: "hunter", level: 16), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/disrupted-focus"), SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/spellbane")])),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/protective-duo", blueprint: "185d471608614a4a9a01ead064f1f69d", name: "Protective Duo", summary: "Within 10 feet of each other, each gets an attack of opportunity on an adjacent foe that hits the other.", guide: "hunter#protective-duo", prerequisite: SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/working-in-tandem")),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/push-and-bite", blueprint: "771263db65bf4158bf4a3dc80a619fdb", name: "Push and Bite", summary: "Once a round, a ranged attack on a foe next to your companion adds a +4 Dex-based bull rush; on success the companion hits it automatically.", guide: "hunter#push-and-bite", prerequisite: SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/new-favorite-toy")),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/spellbane", blueprint: "c36f274c3f7443cba4fc8e559f1c7917", name: "Spellbane", summary: "Enemies within 10 feet of you or your companion take -2 to spell DCs and spell attack rolls.", guide: "hunter#spellbane", prerequisite: SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/disrupted-focus")),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/timely-warning", blueprint: "58929ea3bc1541b980f99aefe335434d", name: "Timely Warning", summary: "Once a round, a failed save by one of the pair can be negated by the other's Lore (Nature) or Mobility check.", guide: "hunter#timely-warning", prerequisite: SelectionOption("hunter/tandem-executioner/tandem-executioner-techniques/vigilant-partners")),
                        (key: "hunter/tandem-executioner/tandem-executioner-techniques/vigilant-partners", blueprint: "4d64964f84a54a93864dc03821756226", name: "Vigilant Partners", summary: "Once a round, a hit on one of the pair can be negated by the other's Lore (Nature) or Mobility check against the attack roll.", guide: "hunter#vigilant-partners"),
