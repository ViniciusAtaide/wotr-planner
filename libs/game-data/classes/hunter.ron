                (
                    key: "hunter/divine-hunter/otherworldly-companion",
                    blueprint: "b1c0bcb356a496e4487b7dd8e7521043",
                    name: "Otherworldly Companion",
                    summary: "From 3rd level, your companion becomes Celestial or Fiendish, by alignment.",
                    guide: "hunter#otherworldly-companion",
                    options: [
                        (key: "hunter/divine-hunter/otherworldly-companion/otherworldly-companion-celestial", blueprint: "3db2fd3394613b4438d3c844a0c034ca", name: "Otherworldly Companion - Celestial", summary: "Companion gets SR 5 + level, cold, electricity and acid resistance 5 (10, then 15), DR 5/evil then 10/evil, and Smite Evil once a day.", guide: "hunter#otherworldly-companion-celestial"),
                        (key: "hunter/divine-hunter/otherworldly-companion/otherworldly-companion-fiendish", blueprint: "4d7607a0155af7d43b49b785f2051e21", name: "Otherworldly Companion - Fiendish", summary: "Companion gets SR 5 + level, cold and fire resistance 5 (10, then 15), DR 5/good then 10/good, and Smite Good once a day.", guide: "hunter#otherworldly-companion-fiendish"),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["hunter/animal-companion", "hunter/animal-focus", "hunter/nature-sense"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"], selections: ["hunter/divine-hunter/domain"]),
                (level: 3, selections: ["hunter/divine-hunter/otherworldly-companion"]),
                (level: 6),
