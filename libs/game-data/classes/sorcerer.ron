Class(
    key: "sorcerer",
    blueprint: "b3a505fb61437dc4097f43c3f8f9a4cf",
    name: "Sorcerer",
    summary: "Spontaneous arcane caster up to 9th-level spells, keyed on Charisma, with half BAB, a good Will save, 5 HP and 2 skill points per level, and a bloodline.",
    guide: "sorcerer",
    skill_points: 2,
    casting_ability: Charisma,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "persuasion", "use-magic-device"],
    spontaneous: true,
    features: [
        (key: "sorcerer/bloodline-ascendance", blueprint: "ce85aee1726900641ab53ede61ac5c19", name: "Bloodline Ascendance", summary: "Grants the 20th-level ability of your bloodline.", guide: "mythic-paths#bloodline-ascendance", option_row: (selection: "sorcerer/bloodline", level: 20)),
        (key: "sorcerer/bloodline/abyssal/added-summonings", blueprint: "de24d9e57d7bad24dbada7389eebcd65", name: "Added Summonings", summary: "From 15th level, you summon more creatures, as the Superior Summoning feat.", guide: "character-creation#added-summonings"),
        (key: "sorcerer/bloodline/abyssal/demon-resistances", blueprint: "8cbf303d479cf0d42a8e36092c76fa7c", name: "Demon Resistances", summary: "Electricity resistance 5 and +2 on saves against poison at 3rd level, rising to 10 and +4 at 9th.", guide: "character-creation#demon-resistances"),
        (key: "sorcerer/bloodline/abyssal/demonic-arcana", blueprint: "ed4ab7bba173c204eb30b4e8855b9916", name: "Demonic Arcana", summary: "Summoning-subschool spells give their creatures DR/good of half your class level.", guide: "character-creation#abyssal-bloodline-arcana"),
        (key: "sorcerer/bloodline/abyssal/demonic-might", blueprint: "5c1c2ed7fe5f99649ab00605610b775b", name: "Demonic Might", summary: "At 20th level: immunity to electricity and poison, and resistance 10 to acid, cold and fire.", guide: "character-creation#demonic-might"),
        (key: "sorcerer/bloodline/abyssal/grow-claws", blueprint: "e17698ef77dc3174cbd0a42422c22441", name: "Grow Claws", summary: "Free action: two 1d4 claw attacks, magic at 5th, 1d6 at 7th, +1d6 fire at 11th; usable 3 + Charisma modifier times a day.", guide: "character-creation#grow-claws-abyssal"),
        (key: "sorcerer/bloodline/abyssal/strength-of-the-abyss", blueprint: "489c8c4a53a111d4094d239054b26e32", name: "Strength of the Abyss", summary: "+2 inherent bonus to Strength at 9th level, +4 at 13th and +6 at 17th.", guide: "character-creation#strength-of-the-abyss", ability_bonuses: [Fixed(ability: Strength, amount: 2)]),
        (key: "sorcerer/bloodline/arcane/arcane-apotheosis", blueprint: "2086d8c0d40e35b40b86d47e47fb17e4", name: "Arcane Apotheosis", summary: "At 20th level, every concentration check to cast a spell or spell-like ability succeeds.", guide: "character-creation#arcane-apotheosis"),
        (key: "sorcerer/bloodline/arcane/arcane-arcana", blueprint: "e8e4f56618dd8b04490aa6a0b75ac24f", name: "Arcane Arcana", summary: "Applying a metamagic feat other than Heighten Spell raises the spell's DC by 1.", guide: "character-creation#arcane-bloodline-arcana"),
        (key: "sorcerer/bloodline/arcane/arcane-bond", blueprint: "1740a701ac0a14c4394a7f76f0b07799", name: "Arcane Bond", summary: "Gives you a bonded object or a familiar.", guide: "character-creation#arcane-bond"),
        (key: "sorcerer/bloodline/arcane/class-skill", blueprint: "19ab16dba857d1a4ba617074f203f975", name: "Class Skill", summary: "One of Knowledge (World), Lore (Nature) or Lore (Religion) becomes a class skill.", guide: "sorcerer#arcane"),
        (key: "sorcerer/bloodline/arcane/combat-casting-adept", blueprint: "7aa83ee3526a946419561d8d1aa09e75", name: "Combat Casting Adept", summary: "+2 on concentration checks at 3rd level, +3 at 9th and +4 at 15th; replaced by Arcane Apotheosis at 20th.", guide: "character-creation#combat-casting-adept"),
        (key: "sorcerer/bloodline/celestial/angelic-arcana", blueprint: "2692044c000cc9d45b1086917773dea6", name: "Angelic Arcana", summary: "Summoning-subschool spells give their creatures DR/evil of half your class level.", guide: "character-creation#celestial-bloodline-arcana"),
        (key: "sorcerer/bloodline/celestial/ascension", blueprint: "d85e0396d8f68e047b7b67a1290f8dbc", name: "Ascension", summary: "At 20th level: immunity to acid, cold and petrification, resistance 10 to electricity and fire, and +4 on saves against poison.", guide: "character-creation#ascension"),
        (key: "sorcerer/bloodline/celestial/aura-of-heaven", blueprint: "2768c719ee7338c49932358c2c581bba", name: "Aura of Heaven", summary: "From 9th level, allies within 20 feet get +4 deflection to AC and +4 on saves against evil creatures for a minute; class level uses a day.", guide: "character-creation#aura-of-heaven"),
        (key: "sorcerer/bloodline/celestial/celestial-resistances", blueprint: "b46ef711b4825e04a9380bd0b88d5b06", name: "Celestial Resistances", summary: "Acid and cold resistance 5 at 3rd level, rising to 10 at 9th.", guide: "character-creation#celestial-resistances"),
        (key: "sorcerer/bloodline/celestial/conviction", blueprint: "befc48b88995ea941a9b3ae196b2d5ea", name: "Conviction", summary: "From 15th level, spell resistance of 11 + class level, only against evil spells or spells from evil casters.", guide: "character-creation#conviction"),
        (key: "sorcerer/bloodline/celestial/heavenly-fire", blueprint: "ee30d97c101a2ce4da44ef5745426267", name: "Heavenly Fire", summary: "Ray dealing 1d4 + half class level to evil creatures or healing good ones by as much; 3 + Charisma modifier uses a day.", guide: "character-creation#heavenly-fire"),
        (key: "sorcerer/bloodline/draconic/draconic-arcana", name: "Draconic Arcana", summary: "Spells that deal your bloodline's energy type deal +1 damage per die.", guide: "character-creation#draconic-bloodline-arcana"),
        (key: "sorcerer/bloodline/draconic/draconic-resistances", name: "Draconic Resistances", summary: "Resistance 5 to your dragon's element and +1 natural armor at 3rd level, 10 and +2 at 9th, and +4 natural armor at 15th.", guide: "sorcerer#draconic"),
        (key: "sorcerer/bloodline/draconic/grow-claws", name: "Grow Claws", summary: "Free action: two 1d4 claw attacks, magic at 5th, 1d6 at 7th, +1d6 of your element at 11th; usable 3 + Charisma modifier times a day.", guide: "character-creation#grow-claws-draconic"),
        (key: "sorcerer/bloodline/draconic/power-of-wyrms", name: "Power of Wyrms", summary: "At 20th level: immunity to paralysis, sleep and your bloodline's energy type, plus 60-foot blindsense.", guide: "character-creation#power-of-wyrms"),
        (key: "sorcerer/bloodline/elemental/elemental-arcana", name: "Elemental Arcana", summary: "Your energy-damage spells deal your bloodline's element instead, and change their type to match.", guide: "character-creation#elemental-bloodline-arcana"),
        (key: "sorcerer/bloodline/elemental/elemental-blast", name: "Elemental Blast", summary: "From 9th level, a 20-foot blast for 1d6 per class level; a failed Reflex save leaves foes vulnerable to your element; 1/day, 2 at 17th, 3 at 20th.", guide: "character-creation#elemental-blast"),
        (key: "sorcerer/bloodline/elemental/elemental-body", name: "Elemental Body", summary: "At 20th level, you become immune to your bloodline's element, to critical hits and to sneak attacks.", guide: "character-creation#elemental-body"),
        (key: "sorcerer/bloodline/elemental/elemental-movement-air", blueprint: "1ae6835b8f568d44c8deb911f74762e4", name: "Elemental Movement (Air)", summary: "From 15th level, immunity to entanglement, slow and difficult terrain.", guide: "character-creation#elemental-movement"),
        (key: "sorcerer/bloodline/elemental/elemental-movement-fire", blueprint: "f48c7d56a8a13af4d8e1cc9aae579b01", name: "Elemental Movement (Fire)", summary: "From 15th level, +30 feet to base speed.", guide: "character-creation#elemental-movement"),
        (key: "sorcerer/bloodline/elemental/elemental-movement-water", blueprint: "737ef897849327b45b88b83a797918c8", name: "Elemental Movement (Water)", summary: "From 15th level, immunity to combat maneuvers.", guide: "character-creation#elemental-movement"),
        (key: "sorcerer/bloodline/elemental/elemental-ray", name: "Elemental Ray", summary: "Ranged touch ray of 1d6 elemental damage +1 per two class levels; 3 + Charisma modifier uses a day.", guide: "character-creation#elemental-ray"),
        (key: "sorcerer/bloodline/elemental/elemental-resistances", name: "Elemental Resistances", summary: "Resistance 10 to your bloodline's element at 3rd level, rising to 20 at 9th.", guide: "character-creation#elemental-resistances"),
        (key: "sorcerer/bloodline/fey/fey-arcana", blueprint: "6fe1c3f9437d88749a07e294c08799b9", name: "Fey Arcana", summary: "+2 to the DC of your compulsion spells.", guide: "character-creation#fey-bloodline-arcana"),
        (key: "sorcerer/bloodline/fey/fey-magic", blueprint: "a9ffe3e08a080c8478bae321e70c7de6", name: "Fey Magic", summary: "From 15th level, +2 on caster level checks against spell resistance, stacking with Spell Penetration.", guide: "character-creation#fey-magic"),
        (key: "sorcerer/bloodline/fey/fleeting-glance", blueprint: "9d67add74ffa4934aa638c2d9b573336", name: "Fleeting Glance", summary: "From 9th level, Greater Invisibility for a number of rounds a day equal to your sorcerer level.", guide: "character-creation#fleeting-glance"),
        (key: "sorcerer/bloodline/fey/laughing-touch", blueprint: "847d74c49c08f2a4ea1c540528d5e1d2", name: "Laughing Touch", summary: "Melee touch makes a creature laugh for 1 round, limited to a move action; not on mind-immune foes; 3 + Charisma modifier uses a day.", guide: "character-creation#laughing-touch"),
        (key: "sorcerer/bloodline/fey/soul-of-the-fey", blueprint: "6dba3a0ba5a32c645ba07bcc17873682", name: "Soul of the Fey", summary: "At 20th level: immunity to poison, DR 10/cold iron, and Cloak of Dreams once a day at your class level.", guide: "character-creation#soul-of-the-fey"),
        (key: "sorcerer/bloodline/fey/woodland-stride", blueprint: "11f4072ea766a5840a46e6660894527d", name: "Woodland Stride", summary: "From 3rd level, you move through difficult terrain at normal speed.", guide: "character-creation#woodland-stride"),
        (key: "sorcerer/bloodline/infernal/corrupting-touch", blueprint: "de7fc4b905e3c434a8f8eaac80195b64", name: "Corrupting Touch", summary: "Melee touch leaves a creature shaken for half your class level in rounds; 3 + Charisma modifier uses a day.", guide: "character-creation#corrupting-touch"),
        (key: "sorcerer/bloodline/infernal/hellfire", blueprint: "791ca90317229ec4b9b4dc355cc2fe01", name: "Hellfire", summary: "From 9th level, a 10-foot column of 1d6 fire per class level that shakes foes failing Reflex; 1/day, 2 at 17th, 3 at 20th.", guide: "character-creation#hellfire"),
        (key: "sorcerer/bloodline/infernal/infernal-arcana", blueprint: "67f151cdb9f0c9d4092ccfd5a9ccc6c9", name: "Infernal Arcana", summary: "+2 to the DC of your charm spells.", guide: "character-creation#infernal-bloodline-aracana"),
        (key: "sorcerer/bloodline/infernal/infernal-resistances", blueprint: "c8b51c7112077384da68c48359419046", name: "Infernal Resistances", summary: "Fire resistance 5 and +2 on saves against poison at 3rd level, rising to 10 and +4 at 9th.", guide: "character-creation#infernal-resistances"),
        (key: "sorcerer/bloodline/infernal/power-of-the-pit", blueprint: "b6afdc50876e08149b1f9fdcdb2a308c", name: "Power of the Pit", summary: "At 20th level: immunity to fire and poison, and resistance 10 to acid and cold.", guide: "character-creation#power-of-the-pit"),
        (key: "sorcerer/bloodline/serpentine/den-of-vermin", blueprint: "fe56277224a2f5248bbfd9e692c78857", name: "Den of Vermin", summary: "Once a day, cast Creeping Doom, whose poison deals Con damage and whose area entangles.", guide: "character-creation#den-of-vermin"),
        (key: "sorcerer/bloodline/serpentine/scaled-soul", blueprint: "18436c3dfd2000142ae087bf03740fdf", name: "Scaled Soul", summary: "At 20th level: turn into a Large spirit naga at will, immune to poison and paralysis, with Serpent's Fang at will.", guide: "character-creation#scaled-soul"),
        (key: "sorcerer/bloodline/serpentine/serpentine-arcana", blueprint: "02707231be1d3a74ba7e38a426c8df37", name: "Serpentine Arcana", summary: "Your mind-affecting and language-dependent spells affect animals, magical beasts, monstrous humanoids and vermin like humanoids.", guide: "character-creation#serpentine-bloodline-arcana"),
        (key: "sorcerer/bloodline/serpentine/serpents-fang", blueprint: "a26c62f50bec9fa4ab8ea7cd98fed19a", name: "Serpent\'s Fang", summary: "Free action: a 1d4 bite with poison (1 Con a round for 6 rounds), stronger at 5th, 7th and 11th; 3 + Charisma modifier uses a day.", guide: "character-creation#serpents-fang"),
        (key: "sorcerer/bloodline/serpentine/snakeskin", blueprint: "19d2ea3d212681946920c7b70bb44492", name: "Snakeskin", summary: "From 9th level, +1 natural armor, +2 on saves against poison and +2 Mobility; each rises by 1 at 13th and 17th.", guide: "character-creation#snakeskin"),
        (key: "sorcerer/bloodline/undead/deaths-gift", blueprint: "fd5f14d44e82f464196fdf0ea82347cc", name: "Death\'s Gift", summary: "Cold resistance 5 and DR 5/magic at 3rd level, rising to 10 and DR 10/magic at 9th.", guide: "character-creation#deaths-gift"),
        (key: "sorcerer/bloodline/undead/grasp-of-the-dead", blueprint: "3c0e7252c058f324482e320755898d7a", name: "Grasp of the Dead", summary: "From 9th level, skeletal arms deal 1d6 slashing per class level in 20 feet and shake foes failing Reflex; 1/day, 2 at 17th, 3 at 20th.", guide: "character-creation#grasp-of-the-dead"),
        (key: "sorcerer/bloodline/undead/grave-touch", blueprint: "ba799554aff764243adcc03c5714d88e", name: "Grave Touch", summary: "Melee touch shakes a creature for half your class level in rounds, or frightens a shaken one with fewer HD; 3 + Charisma modifier uses a day.", guide: "character-creation#grave-touch"),
        (key: "sorcerer/bloodline/undead/incorporeal-form", blueprint: "eafdc6762cbfa7d4d8220c6d6372973d", name: "Incorporeal Form", summary: "From 15th level, turn incorporeal for class level rounds: nonmagic weapons can't hurt you and most other sources deal half.", guide: "character-creation#incorporeal-form"),
        (key: "sorcerer/bloodline/undead/one-of-us", blueprint: "b3e403ebbdad8314386270fefc4b4cc8", name: "One of Us", summary: "At 20th level: immunity to cold, paralysis and sleep, DR 5/-, and +4 morale on saves against undead spells and abilities.", guide: "character-creation#one-of-us"),
        (key: "sorcerer/bloodline/undead/undead-arcana", blueprint: "1a5e7191279e7cd479b17a6ca438498c", name: "Undead Arcana", summary: "Undead count as humanoids for your mind-affecting spells.", guide: "character-creation#undead-bloodline-arcana"),
    ],
    selections: [
        (
            key: "sorcerer/bloodline",
            blueprint: "24bef8d1bee12274686f6da6ccbc8914",
            name: "Bloodline",
            summary: "The bloodline picks your arcana, bloodline powers, bonus spells from 3rd level and bonus feats at 7th, 13th and 19th.",
            guide: "character-creation#bloodlines",
            option_levels: ["dragon-disciple", "sorcerer"],
            options: [
                (
                    key: "sorcerer/bloodline/abyssal",
                    blueprint: "d3a4cb7be97a6694290f0dcfbd147113",
