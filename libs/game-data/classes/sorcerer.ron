                        (level: 1, features: ["sorcerer/bloodline/abyssal/demonic-arcana", "sorcerer/bloodline/abyssal/grow-claws"], feat_list: "sorcerer/bloodline/abyssal/feats", class_skills: ["athletics"]),
                        (level: 3, features: ["sorcerer/bloodline/abyssal/demon-resistances"]),
                        (level: 9, features: ["sorcerer/bloodline/abyssal/strength-of-the-abyss", "sorcerer/bloodline/abyssal/demon-resistances"]),
                        (level: 13, features: ["sorcerer/bloodline/abyssal/strength-of-the-abyss"]),
