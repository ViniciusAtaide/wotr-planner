                    ],
                ),
                (
                    key: "cleric/domain/fire",
                    name: "Fire Domain",
                    summary: "Fire Bolt, fire resistance from 6th level and immunity at 20th; spells from Burning Hands to Fiery Body.",
                    guide: "character-creation#fire-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/fire/fire-bolt"]),
                        (level: 6, features: ["cleric/domain/fire/fire-resistance"]),
