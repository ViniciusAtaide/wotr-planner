            key: "cleric/angelfire-apostle",
            name: "Angelfire Apostle",
            summary: "Good support cleric with two domains and Extra Channel; positive channel only, spent on healing spells and fire; light armor and fewer spells.",
            guide: "cleric#angelfire-apostle",
            prerequisite: All([Any([Alignment(LawfulGood), Alignment(NeutralGood), Alignment(ChaoticGood)]), DeityOffers("cleric/domain/good")]),
            features: [
                (key: "cleric/angelfire-apostle/channel-positive-energy", name: "Channel Positive Energy", summary: "Channel energy that can only be positive, never negative.", guide: "cleric#angelfire-apostle"),
                (key: "cleric/angelfire-apostle/cleansing-flames", name: "Cleansing Flames", summary: "From 9th level, spend a channel as a swift action when casting: 1d4 per highest spell level, half fire half divine, to foes within 20 feet.", guide: "cleric#cleansing-flames"),
                (key: "cleric/angelfire-apostle/versatile-healing-channel", name: "Versatile Healing Channel", summary: "From 5th level, spend two channels to cast Lesser Restoration or Remove Blindness, adding spells up to Resurrection at 19th.", guide: "cleric#versatile-healing-channel"),
            ],
