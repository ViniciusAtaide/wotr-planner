Class(
    key: "cleric",
    blueprint: "67819271767a9dd4fbfd4ae700befea0",
    name: "Cleric",
    summary: "Prepared divine caster up to 9th-level spells, keyed on Wisdom, with 3/4 BAB, good Fortitude and Will, 6 HP, channel energy and two domains.",
    guide: "cleric",
    skill_points: 2,
    casting_ability: Wisdom,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-religion", "persuasion"],
    prerequisite: Worships,
    features: [
        (key: "cleric/channel-energy", blueprint: "d332c1748445e8f4f9e92763123e31bd", name: "Channel Energy", summary: "30-foot burst of 1d6 +1d6 per two levels, healing or harming by your energy (Will halves); 3 + Cha uses a day; trade spells for cure or inflict.", guide: "cleric#channel-energy"),
        (key: "cleric/cleric-proficiencies", blueprint: "8c971173613282844888dc20d572cfc9", favoured_weapon_proficiency: true, name: "Cleric Proficiencies", summary: "Simple weapons, light and medium armor, shields except tower shields, and your deity's favored weapon.", guide: "cleric#cleric-proficiencies"),
        (key: "cleric/diminished-spellcasting", blueprint: "e47dba0476b36cf42809819237f44da1", name: "Diminished Spellcasting", summary: "One fewer spell per day of each level; at zero you cast that level only with bonus spells from Wisdom, but keep domain slots.", guide: "cleric#diminished-spellcasting"),
        (key: "cleric/domain/air/electrical-resistance", blueprint: "8a8e3f80abc04c34b98324823d14b057", name: "Electrical Resistance", summary: "Electricity resistance 10 at 6th level, 20 at 12th, and immunity at 20th.", guide: "character-creation#air-domain"),
        (key: "cleric/domain/air/lightning-arc", blueprint: "39b0c7db785560041b436b558c9df2bb", name: "Lightning Arc", summary: "30-foot ranged touch for 1d6 electricity +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#air-domain"),
        (key: "cleric/domain/animal/animal-companion", blueprint: "2ecd6c64683b59944a7fe544033bb533", name: "Animal Companion", summary: "At 4th level, an animal companion at class level -3; Lore (Nature) becomes a class skill.", guide: "character-creation#animal-domain"),
        (key: "cleric/domain/artifice/aura-of-efficiency", blueprint: "01025d876ac28d349ac42d69ba462059", name: "Aura of Efficiency", summary: "Aura for class level rounds a day: allies within 30 feet get +4 on saves against fatigue and exhaustion.", guide: "character-creation#artifice-domain"),
        (key: "cleric/domain/artifice/aura-of-efficiency-damage-resistance", blueprint: "9c536f77cae0c5c46a9cf871003ebe43", name: "Aura of Efficiency (Damage Resistance)", summary: "From 8th level, Aura of Efficiency also gives DR 1/-, +1 every three levels (5/- at 20th).", guide: "character-creation#artifice-domain"),
        (key: "cleric/domain/chaos/chaos-blade", blueprint: "41b647ee4591dc1448a665a62b7a7b5f", name: "Chaos Blade", summary: "From 8th level, make a weapon Anarchic for half your class level in rounds; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#chaos-domain"),
        (key: "cleric/domain/chaos/touch-of-chaos", blueprint: "0c9d931180a19a646bcf4165f66bd318", name: "Touch of Chaos", summary: "Melee touch: the target rolls twice and takes the worse result for the next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#chaos-domain"),
        (key: "cleric/domain/charm/charming-smile", blueprint: "d1fee57aa8f12b849b5abd5f2b7c4616", name: "Charming Smile", summary: "From 8th level, cast Charm Person as a swift action (DC 10 + half level + Wis), class level times a day.", guide: "character-creation#charm-domain"),
        (key: "cleric/domain/charm/dazing-touch", blueprint: "4847d450fbef9b444abcc3a82337b426", name: "Dazing Touch", summary: "Melee touch dazes a creature with no more HD than your level for 1 round; 3 + Wisdom modifier uses a day.", guide: "character-creation#charm-domain"),
        (key: "cleric/domain/community/calming-touch", blueprint: "102d61a114786894bb2b30568943ef1f", name: "Calming Touch", summary: "Touch heals 1d6 + class level and removes fatigued, shaken and sickened; 3 + Wisdom modifier uses a day.", guide: "character-creation#community-domain"),
        (key: "cleric/domain/community/guarded-hearth", blueprint: "4cddbb24833e1d24ea1ff0f59574284a", name: "Guarded Hearth", summary: "From 8th level, once a day, allies in an area get your Wisdom modifier to attacks and saves for 1 hour per level.", guide: "character-creation#community-domain"),
        (key: "cleric/domain/darkness/moonfire", blueprint: "0653cd3fee730654eb4daa6629e07fad", name: "Moonfire", summary: "From 8th level, ranged touch for 1d8 per two levels that dazzles 1 round per level; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#darkness-domain"),
        (key: "cleric/domain/darkness/touch-of-darkness", blueprint: "9dc5863168155854fa8daf4a780f6663", name: "Touch of Darkness", summary: "Touch gives a creature a 20% miss chance for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#darkness-domain"),
        (key: "cleric/domain/death/bleeding-touch", blueprint: "9809efa15e5f9ad478594479af575a5d", name: "Bleeding Touch", summary: "Touch deals 1d6 a round for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#death-domain"),
        (key: "cleric/domain/death/deaths-embrace", blueprint: "b0acce833384b9b428f32517163c9117", name: "Death\'s Embrace", summary: "From 8th level, channeled negative energy heals you, or positive energy doesn't harm you if you're undead.", guide: "character-creation#death-domain"),
        (key: "cleric/domain/destruction/destructive-aura", blueprint: "b047e72c88cbdfe409ea0aaea3dfddf6", name: "Destructive Aura", summary: "From 8th level, a 30-foot aura gives everyone, foe or friend, +half level melee damage and auto-confirmed crits; class level rounds a day.", guide: "character-creation#destruction-domain"),
        (key: "cleric/domain/destruction/destructive-smite", blueprint: "2d3b9491bc05a114ab10e5b1b30dc86a", name: "Destructive Smite", summary: "One damage roll gets a morale bonus of half your class level; 3 + Wisdom modifier uses a day.", guide: "character-creation#destruction-domain"),
        (key: "cleric/domain/earth/acid-dart", blueprint: "828d82a0e8c5a944bbdb6b12f802ff02", name: "Acid Dart", summary: "30-foot ranged touch for 1d6 acid +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#earth-domain"),
        (key: "cleric/domain/earth/acid-resistance", blueprint: "761e8208dc1e2074d89d7cd968f432eb", name: "Acid Resistance", summary: "Acid resistance 10 at 6th level, 20 at 12th, and immunity at 20th.", guide: "character-creation#earth-domain"),
        (key: "cleric/domain/evil/scythe-of-evil", blueprint: "3784df3083cb6404fbce7a585be24bcf", name: "Scythe of Evil", summary: "From 8th level, make a weapon Unholy for half your class level in rounds; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#evil-domain"),
        (key: "cleric/domain/evil/touch-of-evil", blueprint: "80de18178ff13304e8cf27ba3ef3d77d", name: "Touch of Evil", summary: "Touch sickens a creature for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#evil-domain"),
        (key: "cleric/domain/fire/fire-bolt", blueprint: "42cc125d570c5334c89c6499b55fc0a3", name: "Fire Bolt", summary: "30-foot ranged touch for 1d6 fire +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#fire-domain"),
        (key: "cleric/domain/fire/fire-resistance", blueprint: "ef5aedb6a97071b46969b61a86a967db", name: "Fire Resistance", summary: "Fire resistance 10 at 6th level, 20 at 12th, and immunity at 20th.", guide: "character-creation#fire-domain"),
        (key: "cleric/domain/glory/aura-of-heroism", blueprint: "bf41d1d2cf72e8545b51857f20fa58e7", name: "Aura of Heroism", summary: "From 8th level, swift action: allies within 30 feet get Heroism; class level rounds a day.", guide: "character-creation#glory-domain"),
        (key: "cleric/domain/glory/touch-of-glory", blueprint: "17e891b3964492f43aae44f994b5d454", name: "Touch of Glory", summary: "Touch adds your class level to one Charisma skill or ability check; channel against undead gets +2 DC; 3 + Wis uses a day.", guide: "character-creation#glory-domain"),
        (key: "cleric/domain/good/holy-lance", blueprint: "c90f8979927db4b4fbf6159297e01af8", name: "Holy Lance", summary: "From 8th level, make a weapon Holy for half your class level in rounds; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#good-domain"),
        (key: "cleric/domain/good/touch-of-good", blueprint: "f27684b3b72c2f546abf3ef2fb611a05", name: "Touch of Good", summary: "Touch: +half level sacred bonus to attacks, skills, ability checks and saves next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#good-domain"),
        (key: "cleric/domain/healing/healers-blessing", blueprint: "b9ea4eb16ded8b146868540e711f81c8", name: "Healer\'s Blessing", summary: "From 6th level, all your cure spells are empowered.", guide: "character-creation#healing-domain"),
        (key: "cleric/domain/healing/rebuke-death", blueprint: "303cf1c933f343c4d91212f8f4953e3c", name: "Rebuke Death", summary: "Heal an ally at 0 HP or below for 1d4 + half your class level; 3 + Wisdom modifier uses a day.", guide: "character-creation#healing-domain"),
        (key: "cleric/domain/ice/body-of-ice", blueprint: "b105ed7a854948bda3d7ee23e60b7c70", name: "Body of Ice", summary: "From 8th level, for class level rounds a day: DR 5/- (10/- at 16th) and cold immunity, but double fire damage.", guide: "character-creation#ice-subdomain"),
        (key: "cleric/domain/ice/icicle", blueprint: "fe2be05e3ee04b818554a2fc93f7605b", name: "Icicle", summary: "30-foot ranged touch for 1d6 cold +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#ice-subdomain"),
        (key: "cleric/domain/knowledge/teaching-moment", blueprint: "74ac5dbc420501c4cae29a9db24e4e3a", name: "Teaching Moment", summary: "From 8th level, swift action: allies roll twice on one d20 roll within a minute; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#knowledge-domain"),
        (key: "cleric/domain/knowledge/void-form", blueprint: "44ff896dccfd453da78e83c194f460eb", name: "Void Form", summary: "Class level rounds a day: immune to criticals and +1 deflection to AC (+2 at 8th, +1 per 4 levels after); all Knowledge and Lore are class skills.", guide: "character-creation#knowledge-domain"),
        (key: "cleric/domain/law/staff-of-order", blueprint: "3dc5e2b315ff07f438582a2468beb1fb", name: "Staff of Order", summary: "From 8th level, make a weapon Axiomatic for half your class level in rounds; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#law-domain"),
        (key: "cleric/domain/law/touch-of-law", blueprint: "9bd2d216e56a0db44be0df48ffc515af", name: "Touch of Law", summary: "Touch: the target's rolls all count as 11 next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#law-domain"),
        (key: "cleric/domain/liberation/freedom-of-movement", blueprint: "7cc934aa505172a40b4a10c14c7681c4", name: "Freedom of Movement", summary: "Freedom of Movement for class level rounds a day.", guide: "character-creation#liberation-domain"),
        (key: "cleric/domain/liberation/freedoms-call", blueprint: "25636a46d4e7a484d903946ef4a6f6db", name: "Freedom\'s Call", summary: "From 8th level, allies within 30 feet ignore difficult terrain and suppress confusion, fear, paralysis, slow and stagger; class level rounds a day.", guide: "character-creation#liberation-domain"),
        (key: "cleric/domain/luck/bit-of-luck", blueprint: "2b3818bf4656c1a41b93467755662c78", name: "Bit of Luck", summary: "Standard action: the target rolls everything twice next round, taking the better; 3 + Wisdom modifier uses a day.", guide: "character-creation#luck-domain"),
        (key: "cleric/domain/luck/divine-fortune", blueprint: "dd58b458af054e642bf845c3f01307e5", name: "Divine Fortune", summary: "From 6th level, roll everything twice and take the better for half your level in rounds; 1/day, 2 at 12th, 3 at 18th.", guide: "character-creation#luck-domain"),
        (key: "cleric/domain/madness/aura-of-madness", blueprint: "9acc8ab2f313d0e49bb01e030c868e3f", name: "Aura of Madness", summary: "From 8th level, enemies within 30 feet must save each round or be confused (DC 10 + half level + Wis); class level rounds a day.", guide: "character-creation#madness-domain"),
        (key: "cleric/domain/madness/vision-of-madness", blueprint: "84bf46e8086dbdc438bac875ab0e5c2f", name: "Vision of Madness", summary: "Melee touch: +half level to one of attacks, saves or skills and the same penalty to the other two; 3 + Wis uses a day.", guide: "character-creation#madness-domain"),
        (key: "cleric/domain/magic/dispelling-touch", blueprint: "cf47e96abd88c9f418f8e67f5a14381f", name: "Dispelling Touch", summary: "From 8th level, Dispel Magic as a melee touch; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#magic-domain"),
        (key: "cleric/domain/magic/hand-of-the-acolyte", blueprint: "90f939eb611ac3743b5de3dd00135e22", name: "Hand of the Acolyte", summary: "Throw your melee weapon up to 30 feet using Wisdom to hit and Strength to damage; 3 + Wisdom modifier uses a day.", guide: "character-creation#magic-domain"),
        (key: "cleric/domain/murder/bleeding-touch", blueprint: "b94f3f27224b4421be9d6aaa6f46b088", name: "Bleeding Touch", summary: "Touch deals 1d6 a round for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#murder-subdomain"),
        (key: "cleric/domain/murder/weapons-infused-with-death", blueprint: "f7dbd9bc4b634f0dae18c49cc851bb69", name: "Weapons Infused with Death", summary: "From 8th level, free action: confirmed crits add bleed of half your level for half your level in rounds; 1/day, +1 at 12th, 16th, 20th.", guide: "character-creation#murder-subdomain"),
        (key: "cleric/domain/nobility/inspiring-command", blueprint: "75acf3f9598248344b76f0b87ad27ac1", name: "Inspiring Command", summary: "From 8th level, allies within 30 feet get +2 insight to attack, AC, CMD and skills for half level rounds; 3 + Wis uses a day.", guide: "character-creation#nobility-domain"),
        (key: "cleric/domain/nobility/inspiring-word", blueprint: "a1a7f3dd904ed8e45b074232f48190d1", name: "Inspiring Word", summary: "Target gets +2 morale to attacks, skills, ability checks and saves for half your level in rounds; 3 + Wis uses a day.", guide: "character-creation#nobility-domain"),
        (key: "cleric/domain/plant/bramble-armor", blueprint: "24ec8901c8092264f864c7626ec3677e", name: "Bramble Armor", summary: "From 6th level, for class level rounds a day, foes hitting you in melee without reach take 1d6 + half your level.", guide: "character-creation#plant-domain"),
        (key: "cleric/domain/plant/enlarge", blueprint: "e433267d36089d049b34900fde38032b", name: "Enlarge", summary: "Enlarge Person on yourself for the next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#plant-domain"),
        (key: "cleric/domain/protection/aura-of-protection", blueprint: "e2e9d41bfa7aa364592b9d57dd74c9db", name: "Aura of Protection", summary: "From 8th level, allies within 30 feet get +1 deflection (+1 per 4 levels) and resist 5 (10 at 14th) to all energy; class level rounds a day.", guide: "character-creation#protection-domain"),
        (key: "cleric/domain/protection/resistant-touch", blueprint: "a05a8959c594daa40a1c5add79566566", name: "Resistant Touch", summary: "+1 resistance on saves (+1 per five levels); a touch lends that bonus to an ally for 1 minute, 3 + Wis times a day.", guide: "character-creation#protection-domain"),
        (key: "cleric/domain/repose/gentle-rest", blueprint: "8526bc808c303034cb2b7832bccf1482", name: "Gentle Rest", summary: "Melee touch staggers for 1 round, or puts a staggered target to sleep; undead staggered for Wis rounds; 3 + Wis uses a day.", guide: "character-creation#repose-domain"),
        (key: "cleric/domain/repose/ward-against-death", blueprint: "e06bfe3ad866c0e4f8a3d5516b844881", name: "Ward Against Death", summary: "From 8th level, a 30-foot aura shields living creatures from death effects and level drain, for class level rounds a day.", guide: "character-creation#repose-domain"),
        (key: "cleric/domain/rune/blast-rune", blueprint: "b74c64a0152c7ee46b13ecdd72dda6f3", name: "Blast Rune", summary: "A rune trap for class level rounds that deals 1d6 energy +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#rune-domain"),
        (key: "cleric/domain/rune/warding-rune", blueprint: "8a2064b6e41c90e4c8a2880deccac139", name: "Warding Rune", summary: "From 8th level, creatures coming within 5 feet can't attack for half your level in rounds unless they pass Will; 1/day, +1 at 12th, 16th, 20th.", guide: "character-creation#rune-domain"),
        (key: "cleric/domain/scalykind/animal-companion", blueprint: "de9a327caa5b45eeb05ed9fe0f0ed4ce", name: "Animal Companion", summary: "At 4th level, a monitor lizard or velociraptor companion at class level -2.", guide: "character-creation#scalykind-domain"),
        (key: "cleric/domain/scalykind/venomous-stare", blueprint: "e22881ef284148fa972af9f521abf66d", name: "Venomous Stare", summary: "Gaze within 30 feet: 1d6 + class level damage and fascinated 1 round unless Will (DC 10 + half level + Wis); 3 + Wis uses a day.", guide: "character-creation#scalykind-domain"),
        (key: "cleric/domain/strength/might-of-the-gods", blueprint: "3298fd30e221ef74189a06acbf376d29", name: "Might of the Gods", summary: "From 8th level, Athletics checks get an enhancement bonus of half your class level.", guide: "character-creation#strength-domain"),
        (key: "cleric/domain/strength/strength-surge", blueprint: "526f99784e9fe4346824e7f210d46112", name: "Strength Surge", summary: "For 1 round, the target adds an enhancement bonus of half your level to melee attacks and Athletics; 3 + Wis uses a day.", guide: "character-creation#strength-domain"),
        (key: "cleric/domain/sun/nimbus-of-light", blueprint: "3e301c9d0e735b649955139ee0f5f165", name: "Nimbus of Light", summary: "From 8th level, a 30-foot aura blinds hostile creatures failing Fortitude and deals your level to undead each round; class level rounds a day.", guide: "character-creation#sun-domain"),
        (key: "cleric/domain/sun/suns-blessing", blueprint: "3d8e38c9ed54931469281ab0cec506e9", name: "Sun\'s Blessing", summary: "Channeling positive energy against undead adds your class level to the damage, and they get no channel resistance.", guide: "character-creation#sun-domain"),
        (key: "cleric/domain/travel/agile-feet", blueprint: "3079cdfba971d614ab4f49220c6cd228", name: "Agile Feet", summary: "+10 feet base speed; free action to ignore difficult terrain for 1 round, 3 + Wisdom modifier times a day.", guide: "character-creation#travel-domain"),
        (key: "cleric/domain/travel/dimensional-hop", blueprint: "9c4b72c847277cd4c94933a647d846cc", name: "Dimensional Hop", summary: "From 8th level, teleport up to 10 feet per class level a day in 5-foot steps as a move action, without provoking.", guide: "character-creation#travel-domain"),
        (key: "cleric/domain/trickery/copycat", blueprint: "cd1f4a784e0820647a34fe9bd5ffa770", name: "Copycat", summary: "Move action: a single Mirror Image for class level rounds; 3 + Wisdom modifier uses a day; Stealth and Trickery are class skills.", guide: "character-creation#trickery-domain"),
        (key: "cleric/domain/trickery/masters-illusion", blueprint: "a681aa60d35344c4b9ceb49de4e169ac", name: "Master\'s Illusion", summary: "From 8th level, all allies within 30 feet become invisible; class level rounds a day.", guide: "character-creation#trickery-domain"),
        (key: "cleric/domain/undead/deaths-embrace", blueprint: "b0acce833384b9b428f32517163c9117", name: "Death\'s Embrace", summary: "From 8th level, channeled negative energy heals you, or positive energy doesn't harm you if you're undead.", guide: "character-creation#undead-subdomain"),
        (key: "cleric/domain/undead/deaths-kiss", blueprint: "665fabebb632402d948fbe45e03a0b86", name: "Death\'s Kiss", summary: "Makes a creature count as undead for positive and negative energy for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#undead-subdomain"),
        (key: "cleric/domain/war/battle-rage", blueprint: "640c20da7d6fcbc43b0d30a0a762f122", name: "Battle Rage", summary: "Standard action: the target adds half your class level to damage next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#war-domain"),
        (key: "cleric/domain/water/cold-resistance", blueprint: "8f8d0892cbe15b54ebe10552603349b2", name: "Cold Resistance", summary: "Cold resistance 10 at 6th level, 20 at 12th, and immunity at 20th.", guide: "character-creation#water-domain"),
        (key: "cleric/domain/water/icicle", blueprint: "4c21ad24f55f64d4fb722f40720d9ab0", name: "Icicle", summary: "30-foot ranged touch for 1d6 cold +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#water-domain"),
        (key: "cleric/domain/weather/lightning-lord", blueprint: "8e44306af595c8d44aad2f1260fd7be2", name: "Lightning Lord", summary: "From 8th level, call down lightning as the Call Lightning spell, class level times a day.", guide: "character-creation#weather-domain"),
        (key: "cleric/domain/weather/storm-burst", blueprint: "1c37869ee06ca33459f16f23f4969e7d", name: "Storm Burst", summary: "30-foot ranged touch for 1d6 +1 per two levels and -2 to the target's attacks next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#weather-domain"),
    ],
    selections: [
        (
            key: "cleric/domain",
            blueprint: "48525e5da45c9c243a343fc6545dbdb9",
            name: "Domain",
            summary: "Domains add spells and powers; which ones you can take depends on your deity and alignment.",
            deity_domains: Offered,
            guide: "character-creation#domains",
            option_levels: ["cleric"],
            options: [
                (
                    key: "cleric/domain/air",
                    blueprint: "750bfcd133cd52f42acbd4f7bc9cc365",
                    name: "Air Domain",
                    summary: "Lightning Arc, electricity resistance from 6th level and immunity at 20th; spells from Shocking Grasp to Elemental Swarm.",
                    guide: "character-creation#air-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/air/lightning-arc"]),
                        (level: 6, features: ["cleric/domain/air/electrical-resistance"]),
                    ],
                ),
                (
                    key: "cleric/domain/animal",
                    blueprint: "23d2f87aa54c89f418e68e790dba11e0",
                    name: "Animal Domain",
                    summary: "An animal companion at 4th level and Lore (Nature) as a class skill; spells like Magic Fang and Summon Nature's Ally.",
                    guide: "character-creation#animal-domain",
                    levels: [
                        (level: 4, features: ["cleric/domain/animal/animal-companion"], class_skills: ["lore-nature"]),
                    ],
                ),
                (
                    key: "cleric/domain/artifice",
                    blueprint: "6454b37f50e10ae41bca83aaaa81ffc2",
                    name: "Artifice Domain",
                    summary: "An aura against fatigue that adds DR/- from 8th level; spells from Lead Blades to Clashing Rocks.",
                    guide: "character-creation#artifice-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/artifice/aura-of-efficiency"]),
                        (level: 8, features: ["cleric/domain/artifice/aura-of-efficiency-damage-resistance"]),
                    ],
                ),
                (
                    key: "cleric/domain/chaos",
                    blueprint: "5a5d19c246961484a97e1e5dded98ab2",
                    name: "Chaos Domain",
