Class(
    key: "cleric",
    name: "Cleric",
    summary: "Prepared divine caster up to 9th-level spells, keyed on Wisdom, with 3/4 BAB, good Fortitude and Will, 6 HP, channel energy and two domains.",
    guide: "cleric",
    skill_points: 2,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-religion", "persuasion"],
    prerequisite: Worships,
    features: [
        (key: "cleric/channel-energy", name: "Channel Energy", summary: "30-foot burst of 1d6 +1d6 per two levels, healing or harming by your energy (Will halves); 3 + Cha uses a day; trade spells for cure or inflict.", guide: "cleric#channel-energy"),
        (key: "cleric/cleric-proficiencies", favoured_weapon_proficiency: true, name: "Cleric Proficiencies", summary: "Simple weapons, light and medium armor, shields except tower shields, and your deity's favored weapon.", guide: "cleric#cleric-proficiencies"),
        (key: "cleric/diminished-spellcasting", name: "Diminished Spellcasting", summary: "One fewer spell per day of each level; at zero you cast that level only with bonus spells from Wisdom, but keep domain slots.", guide: "cleric#diminished-spellcasting"),
        (key: "cleric/domain/air/electrical-resistance", name: "Electrical Resistance", summary: "Electricity resistance 10 at 6th level, 20 at 12th, and immunity at 20th.", guide: "character-creation#air-domain"),
        (key: "cleric/domain/air/lightning-arc", name: "Lightning Arc", summary: "30-foot ranged touch for 1d6 electricity +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#air-domain"),
        (key: "cleric/domain/animal/animal-companion", name: "Animal Companion", summary: "At 4th level, an animal companion at class level -3; Lore (Nature) becomes a class skill.", guide: "character-creation#animal-domain"),
        (key: "cleric/domain/artifice/aura-of-efficiency", name: "Aura of Efficiency", summary: "Aura for class level rounds a day: allies within 30 feet get +4 on saves against fatigue and exhaustion.", guide: "character-creation#artifice-domain"),
        (key: "cleric/domain/artifice/aura-of-efficiency-damage-resistance", name: "Aura of Efficiency (Damage Resistance)", summary: "From 8th level, Aura of Efficiency also gives DR 1/-, +1 every three levels (5/- at 20th).", guide: "character-creation#artifice-domain"),
        (key: "cleric/domain/chaos/chaos-blade", name: "Chaos Blade", summary: "From 8th level, make a weapon Anarchic for half your class level in rounds; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#chaos-domain"),
        (key: "cleric/domain/chaos/touch-of-chaos", name: "Touch of Chaos", summary: "Melee touch: the target rolls twice and takes the worse result for the next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#chaos-domain"),
        (key: "cleric/domain/charm/charming-smile", name: "Charming Smile", summary: "From 8th level, cast Charm Person as a swift action (DC 10 + half level + Wis), class level times a day.", guide: "character-creation#charm-domain"),
        (key: "cleric/domain/charm/dazing-touch", name: "Dazing Touch", summary: "Melee touch dazes a creature with no more HD than your level for 1 round; 3 + Wisdom modifier uses a day.", guide: "character-creation#charm-domain"),
        (key: "cleric/domain/community/calming-touch", name: "Calming Touch", summary: "Touch heals 1d6 + class level and removes fatigued, shaken and sickened; 3 + Wisdom modifier uses a day.", guide: "character-creation#community-domain"),
        (key: "cleric/domain/community/guarded-hearth", name: "Guarded Hearth", summary: "From 8th level, once a day, allies in an area get your Wisdom modifier to attacks and saves for 1 hour per level.", guide: "character-creation#community-domain"),
        (key: "cleric/domain/darkness/moonfire", name: "Moonfire", summary: "From 8th level, ranged touch for 1d8 per two levels that dazzles 1 round per level; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#darkness-domain"),
        (key: "cleric/domain/darkness/touch-of-darkness", name: "Touch of Darkness", summary: "Touch gives a creature a 20% miss chance for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#darkness-domain"),
        (key: "cleric/domain/death/bleeding-touch", name: "Bleeding Touch", summary: "Touch deals 1d6 a round for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#death-domain"),
        (key: "cleric/domain/death/deaths-embrace", name: "Death\'s Embrace", summary: "From 8th level, channeled negative energy heals you, or positive energy doesn't harm you if you're undead.", guide: "character-creation#death-domain"),
        (key: "cleric/domain/destruction/destructive-aura", name: "Destructive Aura", summary: "From 8th level, a 30-foot aura gives everyone, foe or friend, +half level melee damage and auto-confirmed crits; class level rounds a day.", guide: "character-creation#destruction-domain"),
        (key: "cleric/domain/destruction/destructive-smite", name: "Destructive Smite", summary: "One damage roll gets a morale bonus of half your class level; 3 + Wisdom modifier uses a day.", guide: "character-creation#destruction-domain"),
        (key: "cleric/domain/earth/acid-dart", name: "Acid Dart", summary: "30-foot ranged touch for 1d6 acid +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#earth-domain"),
        (key: "cleric/domain/earth/acid-resistance", name: "Acid Resistance", summary: "Acid resistance 10 at 6th level, 20 at 12th, and immunity at 20th.", guide: "character-creation#earth-domain"),
        (key: "cleric/domain/evil/scythe-of-evil", name: "Scythe of Evil", summary: "From 8th level, make a weapon Unholy for half your class level in rounds; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#evil-domain"),
        (key: "cleric/domain/evil/touch-of-evil", name: "Touch of Evil", summary: "Touch sickens a creature for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#evil-domain"),
        (key: "cleric/domain/fire/fire-bolt", name: "Fire Bolt", summary: "30-foot ranged touch for 1d6 fire +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#fire-domain"),
        (key: "cleric/domain/fire/fire-resistance", name: "Fire Resistance", summary: "Fire resistance 10 at 6th level, 20 at 12th, and immunity at 20th.", guide: "character-creation#fire-domain"),
        (key: "cleric/domain/glory/aura-of-heroism", name: "Aura of Heroism", summary: "From 8th level, swift action: allies within 30 feet get Heroism; class level rounds a day.", guide: "character-creation#glory-domain"),
        (key: "cleric/domain/glory/touch-of-glory", name: "Touch of Glory", summary: "Touch adds your class level to one Charisma skill or ability check; channel against undead gets +2 DC; 3 + Wis uses a day.", guide: "character-creation#glory-domain"),
        (key: "cleric/domain/good/holy-lance", name: "Holy Lance", summary: "From 8th level, make a weapon Holy for half your class level in rounds; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#good-domain"),
        (key: "cleric/domain/good/touch-of-good", name: "Touch of Good", summary: "Touch: +half level sacred bonus to attacks, skills, ability checks and saves next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#good-domain"),
        (key: "cleric/domain/healing/healers-blessing", name: "Healer\'s Blessing", summary: "From 6th level, all your cure spells are empowered.", guide: "character-creation#healing-domain"),
        (key: "cleric/domain/healing/rebuke-death", name: "Rebuke Death", summary: "Heal an ally at 0 HP or below for 1d4 + half your class level; 3 + Wisdom modifier uses a day.", guide: "character-creation#healing-domain"),
        (key: "cleric/domain/ice/body-of-ice", name: "Body of Ice", summary: "From 8th level, for class level rounds a day: DR 5/- (10/- at 16th) and cold immunity, but double fire damage.", guide: "character-creation#ice-subdomain"),
        (key: "cleric/domain/ice/icicle", name: "Icicle", summary: "30-foot ranged touch for 1d6 cold +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#ice-subdomain"),
        (key: "cleric/domain/knowledge/teaching-moment", name: "Teaching Moment", summary: "From 8th level, swift action: allies roll twice on one d20 roll within a minute; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#knowledge-domain"),
        (key: "cleric/domain/knowledge/void-form", name: "Void Form", summary: "Class level rounds a day: immune to criticals and +1 deflection to AC (+2 at 8th, +1 per 4 levels after); all Knowledge and Lore are class skills.", guide: "character-creation#knowledge-domain"),
        (key: "cleric/domain/law/staff-of-order", name: "Staff of Order", summary: "From 8th level, make a weapon Axiomatic for half your class level in rounds; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#law-domain"),
        (key: "cleric/domain/law/touch-of-law", name: "Touch of Law", summary: "Touch: the target's rolls all count as 11 next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#law-domain"),
        (key: "cleric/domain/liberation/freedom-of-movement", name: "Freedom of Movement", summary: "Freedom of Movement for class level rounds a day.", guide: "character-creation#liberation-domain"),
        (key: "cleric/domain/liberation/freedoms-call", name: "Freedom\'s Call", summary: "From 8th level, allies within 30 feet ignore difficult terrain and suppress confusion, fear, paralysis, slow and stagger; class level rounds a day.", guide: "character-creation#liberation-domain"),
        (key: "cleric/domain/luck/bit-of-luck", name: "Bit of Luck", summary: "Standard action: the target rolls everything twice next round, taking the better; 3 + Wisdom modifier uses a day.", guide: "character-creation#luck-domain"),
        (key: "cleric/domain/luck/divine-fortune", name: "Divine Fortune", summary: "From 6th level, roll everything twice and take the better for half your level in rounds; 1/day, 2 at 12th, 3 at 18th.", guide: "character-creation#luck-domain"),
        (key: "cleric/domain/madness/aura-of-madness", name: "Aura of Madness", summary: "From 8th level, enemies within 30 feet must save each round or be confused (DC 10 + half level + Wis); class level rounds a day.", guide: "character-creation#madness-domain"),
        (key: "cleric/domain/madness/vision-of-madness", name: "Vision of Madness", summary: "Melee touch: +half level to one of attacks, saves or skills and the same penalty to the other two; 3 + Wis uses a day.", guide: "character-creation#madness-domain"),
        (key: "cleric/domain/magic/dispelling-touch", name: "Dispelling Touch", summary: "From 8th level, Dispel Magic as a melee touch; 1/day, +1 at 12th, 16th and 20th.", guide: "character-creation#magic-domain"),
        (key: "cleric/domain/magic/hand-of-the-acolyte", name: "Hand of the Acolyte", summary: "Throw your melee weapon up to 30 feet using Wisdom to hit and Strength to damage; 3 + Wisdom modifier uses a day.", guide: "character-creation#magic-domain"),
        (key: "cleric/domain/murder/bleeding-touch", name: "Bleeding Touch", summary: "Touch deals 1d6 a round for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#murder-subdomain"),
        (key: "cleric/domain/murder/weapons-infused-with-death", name: "Weapons Infused with Death", summary: "From 8th level, free action: confirmed crits add bleed of half your level for half your level in rounds; 1/day, +1 at 12th, 16th, 20th.", guide: "character-creation#murder-subdomain"),
        (key: "cleric/domain/nobility/inspiring-command", name: "Inspiring Command", summary: "From 8th level, allies within 30 feet get +2 insight to attack, AC, CMD and skills for half level rounds; 3 + Wis uses a day.", guide: "character-creation#nobility-domain"),
        (key: "cleric/domain/nobility/inspiring-word", name: "Inspiring Word", summary: "Target gets +2 morale to attacks, skills, ability checks and saves for half your level in rounds; 3 + Wis uses a day.", guide: "character-creation#nobility-domain"),
        (key: "cleric/domain/plant/bramble-armor", name: "Bramble Armor", summary: "From 6th level, for class level rounds a day, foes hitting you in melee without reach take 1d6 + half your level.", guide: "character-creation#plant-domain"),
        (key: "cleric/domain/plant/enlarge", name: "Enlarge", summary: "Enlarge Person on yourself for the next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#plant-domain"),
        (key: "cleric/domain/protection/aura-of-protection", name: "Aura of Protection", summary: "From 8th level, allies within 30 feet get +1 deflection (+1 per 4 levels) and resist 5 (10 at 14th) to all energy; class level rounds a day.", guide: "character-creation#protection-domain"),
        (key: "cleric/domain/protection/resistant-touch", name: "Resistant Touch", summary: "+1 resistance on saves (+1 per five levels); a touch lends that bonus to an ally for 1 minute, 3 + Wis times a day.", guide: "character-creation#protection-domain"),
        (key: "cleric/domain/repose/gentle-rest", name: "Gentle Rest", summary: "Melee touch staggers for 1 round, or puts a staggered target to sleep; undead staggered for Wis rounds; 3 + Wis uses a day.", guide: "character-creation#repose-domain"),
        (key: "cleric/domain/repose/ward-against-death", name: "Ward Against Death", summary: "From 8th level, a 30-foot aura shields living creatures from death effects and level drain, for class level rounds a day.", guide: "character-creation#repose-domain"),
        (key: "cleric/domain/rune/blast-rune", name: "Blast Rune", summary: "A rune trap for class level rounds that deals 1d6 energy +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#rune-domain"),
        (key: "cleric/domain/rune/warding-rune", name: "Warding Rune", summary: "From 8th level, creatures coming within 5 feet can't attack for half your level in rounds unless they pass Will; 1/day, +1 at 12th, 16th, 20th.", guide: "character-creation#rune-domain"),
        (key: "cleric/domain/scalykind/animal-companion", name: "Animal Companion", summary: "At 4th level, a monitor lizard or velociraptor companion at class level -2.", guide: "character-creation#scalykind-domain"),
        (key: "cleric/domain/scalykind/venomous-stare", name: "Venomous Stare", summary: "Gaze within 30 feet: 1d6 + class level damage and fascinated 1 round unless Will (DC 10 + half level + Wis); 3 + Wis uses a day.", guide: "character-creation#scalykind-domain"),
        (key: "cleric/domain/strength/might-of-the-gods", name: "Might of the Gods", summary: "From 8th level, Athletics checks get an enhancement bonus of half your class level.", guide: "character-creation#strength-domain"),
        (key: "cleric/domain/strength/strength-surge", name: "Strength Surge", summary: "For 1 round, the target adds an enhancement bonus of half your level to melee attacks and Athletics; 3 + Wis uses a day.", guide: "character-creation#strength-domain"),
        (key: "cleric/domain/sun/nimbus-of-light", name: "Nimbus of Light", summary: "From 8th level, a 30-foot aura blinds hostile creatures failing Fortitude and deals your level to undead each round; class level rounds a day.", guide: "character-creation#sun-domain"),
        (key: "cleric/domain/sun/suns-blessing", name: "Sun\'s Blessing", summary: "Channeling positive energy against undead adds your class level to the damage, and they get no channel resistance.", guide: "character-creation#sun-domain"),
        (key: "cleric/domain/travel/agile-feet", name: "Agile Feet", summary: "+10 feet base speed; free action to ignore difficult terrain for 1 round, 3 + Wisdom modifier times a day.", guide: "character-creation#travel-domain"),
        (key: "cleric/domain/travel/dimensional-hop", name: "Dimensional Hop", summary: "From 8th level, teleport up to 10 feet per class level a day in 5-foot steps as a move action, without provoking.", guide: "character-creation#travel-domain"),
        (key: "cleric/domain/trickery/copycat", name: "Copycat", summary: "Move action: a single Mirror Image for class level rounds; 3 + Wisdom modifier uses a day; Stealth and Trickery are class skills.", guide: "character-creation#trickery-domain"),
        (key: "cleric/domain/trickery/masters-illusion", name: "Master\'s Illusion", summary: "From 8th level, all allies within 30 feet become invisible; class level rounds a day.", guide: "character-creation#trickery-domain"),
        (key: "cleric/domain/undead/deaths-embrace", name: "Death\'s Embrace", summary: "From 8th level, channeled negative energy heals you, or positive energy doesn't harm you if you're undead.", guide: "character-creation#undead-subdomain"),
        (key: "cleric/domain/undead/deaths-kiss", name: "Death\'s Kiss", summary: "Makes a creature count as undead for positive and negative energy for half your class level in rounds; 3 + Wisdom modifier uses a day.", guide: "character-creation#undead-subdomain"),
        (key: "cleric/domain/war/battle-rage", name: "Battle Rage", summary: "Standard action: the target adds half your class level to damage next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#war-domain"),
        (key: "cleric/domain/water/cold-resistance", name: "Cold Resistance", summary: "Cold resistance 10 at 6th level, 20 at 12th, and immunity at 20th.", guide: "character-creation#water-domain"),
        (key: "cleric/domain/water/icicle", name: "Icicle", summary: "30-foot ranged touch for 1d6 cold +1 per two levels; 3 + Wisdom modifier uses a day.", guide: "character-creation#water-domain"),
        (key: "cleric/domain/weather/lightning-lord", name: "Lightning Lord", summary: "From 8th level, call down lightning as the Call Lightning spell, class level times a day.", guide: "character-creation#weather-domain"),
        (key: "cleric/domain/weather/storm-burst", name: "Storm Burst", summary: "30-foot ranged touch for 1d6 +1 per two levels and -2 to the target's attacks next round; 3 + Wisdom modifier uses a day.", guide: "character-creation#weather-domain"),
    ],
    selections: [
        (
            key: "cleric/domain",
            name: "Domain",
            summary: "Domains add spells and powers; which ones you can take depends on your deity and alignment.",
            deity_domains: Offered,
            guide: "character-creation#domains",
            option_levels: ["cleric"],
            options: [
                (
                    key: "cleric/domain/air",
                    name: "Air Domain",
                    summary: "Lightning Arc, electricity resistance from 6th level and immunity at 20th; spells from Shocking Grasp to Elemental Swarm.",
                    guide: "character-creation#air-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/air/lightning-arc"]),
                        (level: 6, features: ["cleric/domain/air/electrical-resistance"]),
                    ],
                ),
                (
                    key: "cleric/domain/animal",
                    name: "Animal Domain",
                    summary: "An animal companion at 4th level and Lore (Nature) as a class skill; spells like Magic Fang and Summon Nature's Ally.",
                    guide: "character-creation#animal-domain",
                    levels: [
                        (level: 4, features: ["cleric/domain/animal/animal-companion"], class_skills: ["lore-nature"]),
                    ],
                ),
                (
                    key: "cleric/domain/artifice",
                    name: "Artifice Domain",
                    summary: "An aura against fatigue that adds DR/- from 8th level; spells from Lead Blades to Clashing Rocks.",
                    guide: "character-creation#artifice-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/artifice/aura-of-efficiency"]),
                        (level: 8, features: ["cleric/domain/artifice/aura-of-efficiency-damage-resistance"]),
                    ],
                ),
                (
                    key: "cleric/domain/chaos",
                    name: "Chaos Domain",
                    summary: "Touch of Chaos and Anarchic weapons from 8th level; spells from Protection from Law to Summon Monster IX.",
                    guide: "character-creation#chaos-domain",
                    prerequisite: All([Any([Not(PickedThrough("cleric/separatist/domain")), Alignment(NeutralGood), Alignment(ChaoticGood), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]), Any([Not(PickedThrough("cleric/domain")), Alignment(ChaoticGood), Alignment(ChaoticNeutral), Alignment(ChaoticEvil)]), Any([Not(PickedThrough("inquisitor/domain")), Alignment(ChaoticGood), Alignment(ChaoticNeutral), Alignment(ChaoticEvil)]), Any([Not(PickedThrough("inquisitor/sacred-huntsmaster/domain")), Alignment(ChaoticGood), Alignment(ChaoticNeutral), Alignment(ChaoticEvil)]), Any([Not(PickedThrough("hunter/divine-hunter/domain")), Alignment(ChaoticGood), Alignment(ChaoticNeutral), Alignment(ChaoticEvil)])]),
                    levels: [
                        (level: 1, features: ["cleric/domain/chaos/touch-of-chaos"]),
                        (level: 8, features: ["cleric/domain/chaos/chaos-blade"]),
                    ],
                ),
                (
                    key: "cleric/domain/charm",
                    name: "Charm Domain",
                    summary: "Dazing Touch and swift Charm Person from 8th level; spells from Hypnotism to Dominate Monster.",
                    guide: "character-creation#charm-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/charm/dazing-touch"]),
                        (level: 8, features: ["cleric/domain/charm/charming-smile"]),
                    ],
                ),
                (
                    key: "cleric/domain/community",
                    name: "Community Domain",
                    summary: "Calming Touch heals and cleanses; Guarded Hearth adds Wisdom to allies' attacks and saves from 8th; spells up to Mass Heal.",
                    guide: "character-creation#community-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/community/calming-touch"]),
                        (level: 8, features: ["cleric/domain/community/guarded-hearth"]),
                    ],
                ),
                (
                    key: "cleric/domain/darkness",
                    name: "Darkness Domain",
                    summary: "Touch of Darkness miss chance and Moonfire from 8th level; spells from Sleep to Polar Midnight.",
                    guide: "character-creation#darkness-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/darkness/touch-of-darkness"]),
                        (level: 8, features: ["cleric/domain/darkness/moonfire"]),
                    ],
                ),
                (
                    key: "cleric/domain/death",
                    name: "Death Domain",
                    summary: "Bleeding Touch and Death's Embrace from 8th level; necromancy from Cause Fear to Wail of the Banshee.",
                    guide: "character-creation#death-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/death/bleeding-touch"]),
                        (level: 8, features: ["cleric/domain/death/deaths-embrace"]),
                    ],
                ),
                (
                    key: "cleric/domain/destruction",
                    name: "Destruction Domain",
                    summary: "Destructive Smite and an aura of extra damage and auto-confirmed crits for everyone from 8th; spells up to Tsunami.",
                    guide: "character-creation#destruction-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/destruction/destructive-smite"]),
                        (level: 8, features: ["cleric/domain/destruction/destructive-aura"]),
                    ],
                ),
                (
                    key: "cleric/domain/earth",
                    name: "Earth Domain",
                    summary: "Acid Dart, acid resistance from 6th level and immunity at 20th; spells from Stone Fist to Elemental Swarm.",
                    guide: "character-creation#earth-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/earth/acid-dart"]),
                        (level: 6, features: ["cleric/domain/earth/acid-resistance"]),
                    ],
                ),
                (
                    key: "cleric/domain/evil",
                    name: "Evil Domain",
                    summary: "Touch of Evil sickens; Unholy weapons from 8th level; spells from Ray of Sickening to Summon Monster IX.",
                    guide: "character-creation#evil-domain",
                    prerequisite: All([Any([Not(PickedThrough("cleric/separatist/domain")), Alignment(LawfulNeutral), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)]), Any([Not(PickedThrough("cleric/domain")), Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)]), Any([Not(PickedThrough("inquisitor/domain")), Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)]), Any([Not(PickedThrough("inquisitor/sacred-huntsmaster/domain")), Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)]), Any([Not(PickedThrough("hunter/divine-hunter/domain")), Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)])]),
                    levels: [
