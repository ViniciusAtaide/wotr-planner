                (key: "cleric/ecclesitheurge/bonded-holy-symbol", name: "Bonded Holy Symbol", summary: "From 3rd level, a bonded object lets you restore one prepared spell a day.", guide: "cleric#bonded-holy-symbol"),
                (key: "cleric/ecclesitheurge/domain-mastery", name: "Domain Mastery", summary: "Prepare domain spells in normal slots, and swap your second domain's spells for another of your deity's domains each day.", guide: "cleric#domain-mastery"),
                (key: "cleric/ecclesitheurge/ecclesitheurge-proficiencies", favoured_weapon_proficiency: true, name: "Ecclesitheurge Proficiencies", summary: "Club, dagger, crossbows, quarterstaff and your deity's weapon; no armor, and you can't cast in armor or with a shield.", guide: "cleric#ecclesitheurge"),
