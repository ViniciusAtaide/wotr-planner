                (key: "cleric/priest-of-balance/empowered-equilibrium", name: "Empowered Equilibrium", summary: "From 11th level, strengthened cure and inflict spells are empowered and a strengthened channel adds 2d6.", guide: "cleric#empowered-equilibrium"),
                (key: "cleric/priest-of-balance/energy-equilibrium", name: "Energy Equilibrium", summary: "Using one energy strengthens your next use of the other: +2 caster level on cure or inflict spells, +1d6 on a channel.", guide: "cleric#energy-equilibrium"),
