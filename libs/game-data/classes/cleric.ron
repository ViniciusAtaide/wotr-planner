                    name: "Glory Domain",
                    summary: "Touch of Glory, +2 channel DC against undead, Aura of Heroism from 8th; spells from Shield of Faith to Overwhelming Presence.",
                    guide: "character-creation#glory-domain",
                    levels: [
                        (level: 1, features: ["cleric/domain/glory/touch-of-glory"]),
                        (level: 8, features: ["cleric/domain/glory/aura-of-heroism"]),
                    ],
                ),
                (
                    key: "cleric/domain/good",
                    name: "Good Domain",
                    summary: "Touch of Good's sacred bonus and Holy weapons from 8th level; spells from Protection from Evil to Summon Monster IX.",
                    guide: "character-creation#good-domain",
                    prerequisite: All([Any([Not(PickedThrough("cleric/separatist/domain")), Alignment(LawfulGood), Alignment(NeutralGood), Alignment(ChaoticGood), Alignment(LawfulNeutral), Alignment(TrueNeutral), Alignment(ChaoticNeutral)]), Any([Not(PickedThrough("cleric/domain")), Alignment(LawfulGood), Alignment(NeutralGood), Alignment(ChaoticGood)]), Any([Not(PickedThrough("inquisitor/domain")), Alignment(LawfulGood), Alignment(NeutralGood), Alignment(ChaoticGood)]), Any([Not(PickedThrough("inquisitor/sacred-huntsmaster/domain")), Alignment(LawfulGood), Alignment(NeutralGood), Alignment(ChaoticGood)]), Any([Not(PickedThrough("hunter/divine-hunter/domain")), Alignment(LawfulGood), Alignment(NeutralGood), Alignment(ChaoticGood)])]),
                    levels: [
