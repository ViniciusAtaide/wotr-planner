Class(
    key: "wizard",
    blueprint: "ba34257984f4c41408ce1dc2004e342e",
    name: "Wizard",
    summary: "Int-based prepared arcane caster with a spellbook, arcane bond and optional school; 1/2 BAB, spells to 9th level, good Will, 5 HP a level.",
    guide: "wizard",
    skill_points: 2,
    casting_ability: Intelligence,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion"],
    features: [
        (key: "wizard/school/abjurer/energy-absorption", blueprint: "e0a0f1ec8dd1fb94d99f824c6f032c64", name: "Energy Absorption", summary: "From 6th level, absorb energy damage up to 3 times your level each day.", guide: "wizard#energy-absorption"),
        (key: "wizard/school/abjurer/protective-ward", blueprint: "4e63d38f5f48a474eaf1ce0521bb7e87", name: "Protective Ward", summary: "Standard action, 3 + Int times a day: a 10' field giving allies +1 deflection AC, +1 per five levels.", guide: "wizard#protective-ward"),
        (key: "wizard/school/abjurer/resistance", blueprint: "1abe070e7a00ddd48b8a141d71f79e70", name: "Resistance", summary: "Resistance 5 to an energy type chosen when you prepare spells, 10 at 11th, immunity at 20th.", guide: "wizard#resistance", daily_choice: true),
        (key: "wizard/school/conjurer/acid-dart", blueprint: "b4b575d14c3bab6489aafa17ac2c909e", name: "Acid Dart", summary: "Standard action, 3 + Int times a day: a 30' ranged touch dart for 1d6 acid + 1 per two levels.", guide: "wizard#acid-dart"),
        (key: "wizard/school/conjurer/dimensional-steps", blueprint: "71293f6177954334697ca44a9ddf7090", name: "Dimensional Steps", summary: "From 8th level, teleport up to 30' as a move action, level times a day.", guide: "wizard#dimensional-steps"),
        (key: "wizard/school/conjurer/summoners-charm", blueprint: "cee0f7edbd874a042952ee150f878b84", name: "Summoner\'s Charm", summary: "Conjuration spells last extra rounds equal to half your level (minimum 1), not doubled by Extend Spell.", guide: "wizard#summoners-charm"),
        (key: "wizard/school/diviner/diviners-fortune", blueprint: "54d21b3221ea82a4d90d5a91b7872f3d", name: "Diviner\'s Fortune", summary: "Standard action, 3 + Int times a day: an ally adds half your level to attacks, skills, ability checks and saves for 1 round.", guide: "wizard#diviners-fortune"),
        (key: "wizard/school/diviner/foretell", blueprint: "ef01f802ebc01a94cbc25c89c365563b", name: "Foretell", summary: "From 8th level, a 30' aura for level rounds a day: allies get +2 luck to most rolls, or foes take -2.", guide: "wizard#foretell"),
        (key: "wizard/school/diviner/forewarned", blueprint: "f8ee4f0f4cf741fa9b561ba4eef9ebef", name: "Forewarned", summary: "Add half your level to initiative; at 20th, initiative is always a natural 20.", guide: "wizard#forewarned"),
        (key: "wizard/school/enchanter/aura-of-despair", blueprint: "972ed7d4b0e497345a69b06afc052f67", name: "Aura of Despair", summary: "From 8th level, a 30' mind-affecting aura for level rounds a day gives enemies -2 on all rolls.", guide: "wizard#aura-of-despair"),
        (key: "wizard/school/enchanter/dazing-touch", blueprint: "9e4c4799735ae9c45964e9113107ef02", name: "Dazing Touch", summary: "Standard action, 3 + Int times a day: a melee touch dazes a living creature.", guide: "wizard#dazing-touch"),
        (key: "wizard/school/enchanter/enchanting-smile", blueprint: "9e4c4799735ae9c45964e9113107ef02", name: "Enchanting Smile", summary: "+2 on Persuasion and saves against enchantments, +1 per 5 wizard levels (max +6).", guide: "wizard#enchanting-smile"),
        (key: "wizard/school/illusionist/blinding-ray", blueprint: "9be5e050244352d43a1cb50aad8d548f", name: "Blinding Ray", summary: "Standard action, 3 + Int times a day: ranged touch blinds for 1 round, or dazzles creatures with more HD than your level.", guide: "wizard#blinding-ray"),
        (key: "wizard/school/illusionist/invisibility-field", blueprint: "f0585eb111ede2c4ebf00b057d069463", name: "Invisibility Field", summary: "From 8th level, turn invisible as a swift action for level rounds a day.", guide: "wizard#invisibility-field"),
        (key: "wizard/school/invoker/elemental-wall", blueprint: "de877714f4d224949b403205e8582de4", name: "Elemental Wall", summary: "From 8th level, a Wall of Fire-like wall of a chosen energy; twice a day at 12th, three at 16th, four at 20th.", guide: "wizard#elemental-wall"),
        (key: "wizard/school/invoker/force-missile", blueprint: "f9501f0df27af5446b705b5da255469a", name: "Force Missile", summary: "Standard action, 3 + Int times a day: an unerring 30' dart for 1d4 force + 1 per two levels.", guide: "wizard#force-missile"),
        (key: "wizard/school/invoker/intense-spells", blueprint: "c46512b796216b64899f26301241e4e6", name: "Intense Spells", summary: "Damaging evocation spells add half your level to damage once (not empowered); at 20th, roll twice against spell resistance.", guide: "wizard#intense-spells"),
        (key: "wizard/school/invoker/intense-spells-spell-penetration", blueprint: "f50f2336ee59d004c8a37f9c8665bb98", name: "Intense Spells - Spell Penetration", summary: "At 20th level, roll twice to beat spell resistance with evocation spells.", guide: "wizard#invoker"),
        (key: "wizard/school/necromancer/grave-touch", blueprint: "927707dce06627d4f880c90b5575125f", name: "Grave Touch", summary: "Melee touch, 3 + Int times a day: shaken for half your level in rounds, or frightened 1 round if already shaken and low HD.", guide: "wizard#grave-touch"),
        (key: "wizard/school/necromancer/life-sight", blueprint: "82371e899df830e4bb955429d89b755c", name: "Life Sight", summary: "From 8th level, blindsight 10' for level rounds, telling living from undead.", guide: "wizard#life-sight"),
        (key: "wizard/school/necromancer/power-over-undead", blueprint: "927707dce06627d4f880c90b5575125f", name: "Power Over Undead", summary: "Turn undead 3 + Int times a day (DC 10 + half level + Cha); at 20th, undead lose channel resistance.", guide: "wizard#power-over-undead"),
        (key: "wizard/school/transmuter/change-shape-i", blueprint: "aeb56418768235640a3ee858d5ee05e8", name: "Change Shape I", summary: "From 8th level, take a Beast Shape II or Elemental Shape I form for rounds equal to your wizard level.", guide: "wizard#transmuter"),
        (key: "wizard/school/transmuter/change-shape-ii", blueprint: "b699aa5a98519ee469afddb71b9a8fd0", name: "Change Shape II", summary: "From 12th level, Change Shape works as Beast Shape III or Elemental Shape II.", guide: "wizard#transmuter"),
        (key: "wizard/school/transmuter/physical-enhancement", blueprint: "93919f8ce64dc5a4cbf058a486a44a1b", name: "Physical Enhancement", summary: "+1 enhancement to a physical ability chosen when preparing spells, +1 per 5 wizard levels (+5 at 20th, two abilities at 20th).", guide: "wizard#physical-enhancement"),
        (key: "wizard/school/transmuter/physical-enhancement-2", blueprint: "93919f8ce64dc5a4cbf058a486a44a1b", name: "Physical Enhancement +2", summary: "At 5th level, Physical Enhancement rises to +2.", guide: "wizard#transmuter"),
        (key: "wizard/school/transmuter/physical-enhancement-3", blueprint: "93919f8ce64dc5a4cbf058a486a44a1b", name: "Physical Enhancement +3", summary: "At 10th level, Physical Enhancement rises to +3.", guide: "wizard#transmuter"),
        (key: "wizard/school/transmuter/physical-enhancement-4", blueprint: "93919f8ce64dc5a4cbf058a486a44a1b", name: "Physical Enhancement +4", summary: "At 15th level, Physical Enhancement rises to +4.", guide: "wizard#transmuter"),
        (key: "wizard/school/transmuter/physical-enhancement-5", blueprint: "93919f8ce64dc5a4cbf058a486a44a1b", name: "Physical Enhancement +5", summary: "At 20th level, Physical Enhancement rises to +5 and can boost two attributes.", guide: "wizard#transmuter"),
        (key: "wizard/school/transmuter/telekinetic-fist", blueprint: "e015d05ca18b5c24183cd062486fd46b", name: "Telekinetic Fist", summary: "Standard action, 3 + Int times a day: a 30' ranged touch for 1d4 bludgeoning + 1 per two levels.", guide: "wizard#telekinetic-fist"),
        (key: "wizard/school/universalist/hand-of-the-apprentice", blueprint: "38aab7423d96de84d8e6ab2cdbccce63", name: "Hand of the Apprentice", summary: "Standard action, 3 + Int times a day: attack with your melee weapon at 30' using Int for the attack.", guide: "wizard#hand-of-the-apprentice"),
        (key: "wizard/school/universalist/mm-empower", blueprint: "26c7b2e163035254ead73d20fbce8c86", name: "MM - Empower", summary: "From 12th level, Metamagic Mastery can apply Empower for 2 uses.", guide: "wizard#universalist"),
        (key: "wizard/school/universalist/mm-extend-and-reach-spell", blueprint: "541bb8d595532ec419343b7a93cdb449", name: "MM - Extend and Reach Spell", summary: "From 8th level, apply Extend or Reach to your next spell, 1/day plus 1 per two levels (7 at 20th), 1 use each.", guide: "wizard#universalist"),
        (key: "wizard/school/universalist/mm-maximise", blueprint: "c9165b50a298ba346bd1b34f8d9cb9f9", name: "MM - Maximise", summary: "From 16th level, Metamagic Mastery can apply Maximise for 3 uses.", guide: "wizard#universalist"),
        (key: "wizard/school/universalist/mm-quicken", blueprint: "5e6fe442c2b4be24f969505cef85f61b", name: "MM - Quicken", summary: "At 20th level, Metamagic Mastery can apply Quicken for 4 uses.", guide: "wizard#universalist"),
        (key: "wizard/wizard-proficiencies", blueprint: "a98d7cc4e30fe6c4bb3a2c2f69acc3fe", name: "Wizard Proficiencies", summary: "Club, dagger, heavy and light crossbow and quarterstaff.", guide: "wizard#wizard-proficiencies", weapons: ["club", "dagger", "heavy-crossbow", "light-crossbow", "quarterstaff"]),
    ],
