                        (key: "wizard/elemental-specialist/focused-element/cold", blueprint: "15beef5d93954cb8991acb9745c9150a", name: "Cold", summary: "Convert elemental spell damage to cold; from 15th level, half of cold spells' damage is untyped.", guide: "wizard#focused-element"),
