            guide: "wizard#arcane-bomber",
            features: [
                (key: "wizard/arcane-bomber/arcane-bombs", blueprint: "0c7a9899e27cae6449ee1fb3049f128d", name: "Arcane Bombs", summary: "Level + Int bombs a day of a chosen energy: 1d6 + Int, +1d6 every odd level, with splash damage (Reflex half).", guide: "wizard#arcane-bombs"),
                (key: "wizard/arcane-bomber/cantrips", blueprint: "44d19b62d00179e4bad7afae7684f2e2", name: "Cantrips", guide: "wizard#arcane-bomber"),
                (key: "wizard/arcane-bomber/spellblast", blueprint: "142e7d12c27ea084fb9b7c24631f10f2", name: "Spellblast", summary: "Swift action: sacrifice a spell so a bomb gains its level to attack and twice its level to damage.", guide: "wizard#arcane-bomber"),
