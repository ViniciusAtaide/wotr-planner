                (key: "wizard/cruromancer/commanding-infusion", blueprint: "52ab0f623a2446758c0f22fedc2bda70", name: "Commanding Infusion", summary: "From 5th level, an infused Animate Dead gives its skeletons +4 Str and Cha.", guide: "wizard#cruromancer"),
                (key: "wizard/cruromancer/perfect-infusion", blueprint: "74686a88b35946219aa72455c50a15b0", name: "Perfect Infusion", summary: "At 20th level, blood infusions cost no HP.", guide: "wizard#perfect-infusion"),
            ],
