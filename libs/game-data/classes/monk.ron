        (
            key: "monk/traditional-monk",
            name: "Traditional Monk",
            summary: "Monk with good saves in all three and a fixed set of ki powers.",
            guide: "monk#traditional-monk",
            features: [
                (key: "monk/traditional-monk/ki-power-abundant-step", name: "Ki Power: Abundant Step", summary: "Teleport like Dimension Door using ki, without bringing others.", guide: "monk#abundant-step"),
                (key: "monk/traditional-monk/ki-power-diamond-body", name: "Ki Power: Diamond Body", summary: "Immune to poison.", guide: "monk#diamond-body"),
                (key: "monk/traditional-monk/ki-power-diamond-soul", name: "Ki Power: Diamond Soul", summary: "Permanent spell resistance of level + 10.", guide: "monk#diamond-soul"),
                (key: "monk/traditional-monk/ki-power-quivering-palm", name: "Ki Power: Quivering Palm", summary: "At 14th level, spend ki: a target that fails a Fortitude save (DC 10 + half level + Wis) dies.", guide: "monk#quivering-palm"),
                (key: "monk/traditional-monk/ki-power-wholeness-of-body", name: "Ki Power: Wholeness of Body", summary: "Spend ki to heal HP equal to your level.", guide: "monk#wholeness-of-body"),
            ],
            levels: [
                (level: 4, features: ["monk/still-mind", "monk/stunning-fist-fatigue"]),
                (level: 6, features: ["monk/traditional-monk/ki-power-wholeness-of-body"], feat_slots: [OneOf(list: "monk/bonus-feats-6")]),
                (level: 8, features: ["monk/stunning-fist-sicken", "monk/traditional-monk/ki-power-abundant-step"]),
                (level: 10, features: ["monk/ki-strike-lawful", "monk/traditional-monk/ki-power-diamond-body"], feat_slots: [OneOf(list: "monk/bonus-feats-10")]),
                (level: 12, features: ["monk/traditional-monk/ki-power-diamond-soul"]),
                (level: 14, features: ["monk/traditional-monk/ki-power-quivering-palm"], feat_slots: [OneOf(list: "monk/bonus-feats-10")]),
                (level: 16, features: ["monk/ki-strike-adamantine"]),
                (level: 18, feat_slots: [OneOf(list: "monk/bonus-feats-10")]),
                (level: 20, features: ["monk/ki-power-perfect-self"]),
            ],
        ),
