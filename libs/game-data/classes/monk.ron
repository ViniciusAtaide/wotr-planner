Class(
    key: "monk",
    blueprint: "e8f21e5b58e0569468e420ebea456124",
    name: "Monk",
    summary: "Lawful unarmed fighter with flurries, ki and Wis to AC; full BAB, 7 HP a level, good Fortitude and Reflex, 3 skill points a level.",
    guide: "monk",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["athletics", "knowledge-world", "lore-religion", "mobility", "perception", "persuasion", "stealth"],
    prerequisite: Any([Alignment(LawfulGood), Alignment(LawfulNeutral), Alignment(LawfulEvil)]),
    features: [
        (key: "monk/ac-bonus", blueprint: "2615c5f87b3d72b42ac0e73b56d895e0", name: "AC Bonus", summary: "With no armour or shield and a light load, add Wis to AC and CMD, plus +1 at 4th level and every four levels after (+5 at 20th).", guide: "monk#ac-bonus"),
        (key: "monk/evasion", blueprint: "576933720c440aa4d8d42b0c54b77e80", name: "Evasion", summary: "From 2nd level, a successful Reflex save against a half-damage effect means no damage.", guide: "monk#evasion"),
        (key: "monk/fast-movement", blueprint: "73ab5b41fa465ee429ad6658368c6629", name: "Fast Movement", summary: "From 3rd level, +10' base speed, +10' more every 3 levels.", guide: "monk#fast-movement"),
        (key: "monk/flurry-of-blows", blueprint: "fd99770e6bd240a4aab70f7af103e56a", name: "Flurry of Blows", summary: "Unarmed or with monk weapons, one extra attack at full BAB (stacks with Haste); two extra from 11th level.", guide: "monk#flurry-of-blows"),
        (key: "monk/improved-evasion", blueprint: "ce96af454a6137d47b9c6a1e02e66803", name: "Improved Evasion", summary: "From 9th level, a failed Reflex save against a half-damage effect still only deals half damage.", guide: "monk#improved-evasion"),
        (key: "monk/ki-pool", blueprint: "e9590244effb4be4f830b1e3fffced13", name: "Ki Pool", summary: "From 3rd level, a pool of half level + Wis ki points; while it holds a point, unarmed strikes bypass certain kinds of DR.", guide: "monk#ki-pool"),
        (key: "monk/ki-power-extra-attack", name: "Ki Power - Extra Attack", summary: "During a flurry, a swift action and 1 ki point give one more attack, stacking with Haste.", guide: "monk#ki-power-extra-attack"),
        (key: "monk/ki-power-perfect-self", blueprint: "3854f693180168a4980646aee9494c72", name: "Ki Power: Perfect Self", summary: "At 20th level, DR 10/chaotic.", guide: "monk#ki-power-perfect-self"),
        (key: "monk/ki-strike-adamantine", blueprint: "ddc10a3463bd4d54dbcbe993655cf64e", name: "Ki Strike - Adamantine", summary: "At 16th level, unarmed strikes count as adamantine against DR.", guide: "monk#ki-strike-adamantine"),
        (key: "monk/ki-strike-cold-iron-and-silver", blueprint: "7b657938fde78b14cae10fc0d3dcb991", name: "Ki Strike - Cold Iron and Silver", summary: "At 7th level, unarmed strikes count as cold iron and silver against DR.", guide: "monk#ki-strike-cold-iron-and-silver"),
        (key: "monk/ki-strike-lawful", blueprint: "34439e527a8f5fb4588024e71960dd42", name: "Ki Strike - Lawful", summary: "At 10th level, unarmed strikes count as lawful against DR.", guide: "monk#ki-strike-lawful"),
        (key: "monk/ki-strike-magic", blueprint: "1188005ee3160f84f8bed8b19a7d46cf", name: "Ki Strike - Magic", summary: "At 3rd level, unarmed strikes count as magic against DR.", guide: "monk#ki-strike-magic"),
        (key: "monk/monk-proficiencies", blueprint: "c7d6f5244c617734a8a76b6785a752b4", name: "Monk Proficiencies", summary: "Club, crossbow, dagger, handaxe, javelin, kama, nunchaku, quarterstaff, sai, short sword, shortspear, spear and monk weapons.", guide: "monk#monk-proficiencies", weapons: ["club", "dagger", "hand-axe", "heavy-crossbow", "javelin", "kama", "light-crossbow", "nunchaku", "quarterstaff", "sai", "short-sword", "shortspear", "spear"]),
        (key: "monk/purity-of-body", blueprint: "9b02f77c96d6bba4daf9043eff876c76", name: "Purity of Body", summary: "At 5th level, immune to all diseases.", guide: "monk#purity-of-body"),
        (key: "monk/still-mind", blueprint: "b8933d223d87087418a627e61ea42ae6", name: "Still Mind", summary: "At 4th level, +2 on saves against enchantments.", guide: "monk#still-mind"),
        (key: "monk/stunning-fist", blueprint: "a29a582c3daa4c24bb0e991c596ccb28", name: "Stunning Fist", summary: "Once a day per four levels, a hit forces a Fortitude save (DC 10 + half level + Wis) or the target is stunned for 1 round.", guide: "monk#stunning-fist"),
        (key: "monk/stunning-fist-fatigue", blueprint: "819645da2e446f84d9b168ed1676ec29", name: "Stunning Fist: Fatigue", summary: "From 4th level, Stunning Fist can fatigue the target for 1 minute instead of stunning it.", guide: "monk#stunning-fist-fatigue"),
        (key: "monk/stunning-fist-sicken", blueprint: "d256ab3837538cc489d4b571e3a813eb", name: "Stunning Fist: Sicken", summary: "From 8th level, Stunning Fist can sicken the target for 1 minute instead of stunning it.", guide: "monk#stunning-fist-sicken"),
        (key: "monk/style-strike", blueprint: "7bc6a93f6e48eff49be5b0cde83c9450", name: "Style Strike", summary: "From 5th level, one flurry unarmed strike can be a style strike: Defensive Spin, Hammerblow, Leg Sweep or Shattering Punch; more every four levels.", guide: "monk#style-strike"),
        (key: "monk/unarmed-strike", blueprint: "c3fbeb2ffebaaa64aa38ce7a0bb18fb0", name: "Unarmed Strike", summary: "Unarmed damage grows with level for a Medium monk: 1d6, 1d8 at 4th, 1d10 at 8th, 2d6 at 12th, 2d8 at 16th, 2d10 at 20th.", guide: "monk#unarmed-strike"),
    ],
    selections: [
        (
            key: "monk/ki-power",
            blueprint: "3049386713ff04245a38b32483362551",
            name: "Ki Power",
            summary: "Choose a ki power at 4th level and every 2 levels after, paid for with ki points.",
            guide: "monk#ki-power",
            options: [
                (key: "monk/ki-power/abundant-step", blueprint: "008466f45b3e2e64793b30f3d16e41c0", name: "Abundant Step", summary: "From 8th level, 2 ki: teleport like Dimension Door, without bringing others.", guide: "monk#abundant-step", prerequisite: ClassLevel(class: "monk", level: 8)),
                (key: "monk/ki-power/barkskin", blueprint: "7259ec579682c2f45a6444b9e64f122d", name: "Barkskin", summary: "From 4th level, spend 1 ki point to cast Barkskin.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 4)),
                (key: "monk/ki-power/cold-ice-strike", blueprint: "bd0eea84b4ff6994a96b119a3cee8357", name: "Cold Ice Strike", summary: "From 14th level, spend 3 ki points to use Cold Ice Strike.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 14)),
                (key: "monk/ki-power/diamond-body", blueprint: "a8819b70975701b4e874b2f9862aac24", name: "Diamond Body", summary: "From 12th level, immune to poison.", guide: "monk#diamond-body", prerequisite: ClassLevel(class: "monk", level: 12)),
                (key: "monk/ki-power/diamond-soul", blueprint: "01182bcee8cb41640b7fa1b1ad772421", name: "Diamond Soul", summary: "From 14th level, permanent spell resistance of level + 10.", guide: "monk#diamond-soul", prerequisite: ClassLevel(class: "monk", level: 14)),
                (key: "monk/ki-power/poison", blueprint: "7368732975b40eb42aa83889fdfaa3f2", name: "Poison", summary: "From 8th level, spend 2 ki points to use Poison.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 8)),
                (key: "monk/ki-power/quivering-palm", blueprint: "25d1247bb1a66b74081095085e169eb1", name: "Quivering Palm", summary: "From 16th level, 4 ki: a target that fails a Fortitude save (DC 10 + half level + Wis) dies.", guide: "monk#quivering-palm", prerequisite: ClassLevel(class: "monk", level: 16)),
                (key: "monk/ki-power/restoration", blueprint: "64dea39d32b9400469ef84a8fb4b171d", name: "Restoration", summary: "From 8th level, spend 2 ki points to cast Restoration.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 8)),
                (key: "monk/ki-power/scorching-ray", blueprint: "16612cc8d88ef83458d05fd063709af7", name: "Scorching Ray", summary: "From 4th level, spend 2 ki points to cast Scorching Ray.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 4)),
                (key: "monk/ki-power/shout", blueprint: "474870c516601a444857f41e7b219557", name: "Shout", summary: "From 14th level, 3 ki: 1d6 sonic damage per level and a 1-round stun; a Fortitude save halves it and negates the stun.", guide: "monk#shout", prerequisite: ClassLevel(class: "monk", level: 14)),
                (key: "monk/ki-power/spit-venom", blueprint: "35012509f410a4b478d76922f8db5b96", name: "Spit Venom", summary: "From 10th level, spend 2 ki points to use Spit Venom.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 10)),
                (key: "monk/ki-power/sudden-speed", blueprint: "96d96f5b6f71004418e7a7e42a81c94d", name: "Sudden Speed", summary: "From 4th level, 1 ki: +30' base speed for 1 minute.", guide: "monk#sudden-speed", prerequisite: ClassLevel(class: "monk", level: 4)),
                (key: "monk/ki-power/true-strike", blueprint: "98e18d4659f390d4d84c9cc2765ac9c3", name: "True Strike", summary: "From 4th level, spend 1 ki point to cast True Strike.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 4)),
                (key: "monk/ki-power/wholeness-of-body", blueprint: "e9c8117e70e168345b3f4c01538936e5", name: "Wholeness of Body", summary: "From 8th level, 2 ki: heal HP equal to your level.", guide: "monk#wholeness-of-body", prerequisite: ClassLevel(class: "monk", level: 8)),
            ],
        ),
    ],
    feat_lists: [
        (key: "monk/bonus-feats-1", blueprint: "ac3b7f5c11bce4e44aeb332f66b75bab", name: "Monk Bonus Feats", guide: "monk#monk-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "dodge", "improved-initiative"]),
        (key: "monk/bonus-feats-10", blueprint: "1051170c612d5b844bfaa817d6f4cfff", name: "Monk Bonus Feats (from level 10)", guide: "monk#monk-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "disarm", "dodge", "improved-blind-fight", "improved-critical", "improved-initiative", "trip"]),
        (key: "monk/bonus-feats-6", blueprint: "b993f42cb119b4f40ac423ae76394374", name: "Monk Bonus Feats (from level 6)", guide: "monk#monk-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "disarm", "dodge", "improved-initiative", "trip"]),
    ],
    levels: [
        (level: 1, features: ["monk/ac-bonus", "monk/flurry-of-blows", "monk/monk-proficiencies", "monk/stunning-fist", "monk/unarmed-strike"], feats: ["improved-unarmed-strike"], feat_slots: [OneOf(list: "monk/bonus-feats-1")]),
        (level: 2, features: ["monk/evasion"], feat_slots: [OneOf(list: "monk/bonus-feats-1")]),
        (level: 3, features: ["monk/fast-movement", "monk/ki-pool", "monk/ki-power-extra-attack", "monk/ki-strike-magic"]),
        (level: 4, features: ["monk/still-mind", "monk/stunning-fist-fatigue"], selections: ["monk/ki-power"]),
        (level: 5, features: ["monk/purity-of-body", "monk/style-strike"]),
        (level: 6, feat_slots: [OneOf(list: "monk/bonus-feats-6")], selections: ["monk/ki-power"]),
        (level: 7, features: ["monk/ki-strike-cold-iron-and-silver"]),
        (level: 8, features: ["monk/stunning-fist-sicken"], selections: ["monk/ki-power"]),
        (level: 9, features: ["monk/improved-evasion", "monk/style-strike"]),
        (level: 10, features: ["monk/ki-strike-lawful"], feat_slots: [OneOf(list: "monk/bonus-feats-10")], selections: ["monk/ki-power"]),
        (level: 11),
        (level: 12, selections: ["monk/ki-power"]),
        (level: 13, features: ["monk/style-strike"]),
        (level: 14, feat_slots: [OneOf(list: "monk/bonus-feats-10")], selections: ["monk/ki-power"]),
        (level: 15),
        (level: 16, features: ["monk/ki-strike-adamantine"], selections: ["monk/ki-power"]),
        (level: 17, features: ["monk/style-strike"]),
        (level: 18, feat_slots: [OneOf(list: "monk/bonus-feats-10")], selections: ["monk/ki-power"]),
        (level: 19),
        (level: 20, features: ["monk/ki-power-perfect-self"], selections: ["monk/ki-power"]),
    ],
    archetypes: [
        (
            key: "monk/drunken-master",
            blueprint: "a8532f88b704413ba68f62e4e7ff84c1",
            name: "Drunken Master",
            summary: "Non-lawful monk (Dance of Masks DLC) who draws power from drinking.",
            guide: "monk#drunken-master",
            prerequisite: Any([Alignment(NeutralGood), Alignment(ChaoticGood), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
            features: [
                (key: "monk/drunken-master/drunken-combat", blueprint: "8ba5c2349af94fbdaaf491a51d71e77b", name: "Drunken Combat", summary: "+1 attack and AC and -1 Int for every two drunken ki points; your movement doesn't provoke attacks of opportunity.", guide: "monk#drunken-combat"),
                (key: "monk/drunken-master/drunken-courage", blueprint: "479dd8ad30eb433b9ad8a7fbaedd2fd9", name: "Drunken Courage", summary: "From 7th level, immune to fear while holding ki; from 11th, +4 on saves against mind-affecting and compulsion effects.", guide: "monk#drunken-courage"),
                (key: "monk/drunken-master/drunken-ki", blueprint: "814ddce615b84e488fb7a196acebd408", name: "Drunken Ki", summary: "From 3rd level, a ki pool of 2 + 1 per odd level (10 at 19th), refilled 1 point per drink (standard action, swift from 8th).", guide: "monk#drunken-ki"),
                (key: "monk/drunken-master/drunken-power", blueprint: "e57194a032e14c978eca489f80bc374d", name: "Drunken Power", summary: "From 5th level, swift action, 1 ki: melee attacks deal +1d8 for Wis mod rounds, +1d8 every 3 levels (+5d8 at 18th).", guide: "monk#drunken-power"),
                (key: "monk/drunken-master/drunken-resilience", blueprint: "4db82a5a352543b3842f63e2583a85f1", name: "Drunken Resilience", summary: "From 9th level, while holding ki: DR 2/- and +4 on saves against poison; DR 5/- at 15th and 10/- at 19th.", guide: "monk#drunken-resilience"),
                (key: "monk/drunken-master/drunken-technique-caydens-trick", blueprint: "2120300ea9434bd0b8da0a2ba52f99fe", name: "Drunken Technique: Cayden\'s Trick", summary: "From 6th level, 2 ki: vomit in a 15' cone; failing Reflex means -2 AC, blinded, flat-footed and sickened for 2-5 rounds, plus Grease.", guide: "monk#drunken-technique-caydens-trick"),
                (key: "monk/drunken-master/drunken-technique-firewater-breath", blueprint: "5accb22c1d0945a39b07fb6024fdfb93", name: "Drunken Technique: Firewater Breath", summary: "From 4th level, 2 ki: breathe fire in a 15' cone for 1d6 per level (Reflex half).", guide: "monk#drunken-technique-firewater-breath"),
                (key: "monk/drunken-master/eternal-drunkenness", blueprint: "712cb204f96a492095a0c4e97ca06265", name: "Eternal Drunkenness", summary: "At 20th level, +6 to Str, Dex and Con and +6 ki pool capacity.", guide: "monk#eternal-drunkenness"),
            ],
            levels: [
                (level: 3, features: ["monk/drunken-master/drunken-combat", "monk/drunken-master/drunken-ki", "monk/fast-movement", "monk/ki-power-extra-attack", "monk/ki-strike-magic"]),
                (level: 4, features: ["monk/drunken-master/drunken-technique-firewater-breath", "monk/stunning-fist-fatigue"], selections: ["monk/ki-power"]),
                (level: 5, features: ["monk/drunken-master/drunken-ki", "monk/drunken-master/drunken-power", "monk/style-strike"]),
                (level: 6, features: ["monk/drunken-master/drunken-technique-caydens-trick"], feat_slots: [OneOf(list: "monk/bonus-feats-6")], selections: ["monk/ki-power"]),
                (level: 7, features: ["monk/drunken-master/drunken-courage", "monk/drunken-master/drunken-ki", "monk/ki-strike-cold-iron-and-silver"]),
                (level: 8, features: ["monk/drunken-master/drunken-ki", "monk/stunning-fist-sicken"], selections: ["monk/ki-power"]),
                (level: 9, features: ["monk/drunken-master/drunken-ki", "monk/drunken-master/drunken-resilience", "monk/improved-evasion", "monk/style-strike"]),
                (level: 11, features: ["monk/drunken-master/drunken-courage", "monk/drunken-master/drunken-ki"]),
                (level: 13, features: ["monk/drunken-master/drunken-ki", "monk/style-strike"]),
                (level: 15, features: ["monk/drunken-master/drunken-ki", "monk/drunken-master/drunken-resilience"]),
                (level: 17, features: ["monk/drunken-master/drunken-ki", "monk/style-strike"]),
                (level: 19, features: ["monk/drunken-master/drunken-ki", "monk/drunken-master/drunken-resilience"]),
                (level: 20, features: ["monk/drunken-master/eternal-drunkenness"], selections: ["monk/ki-power"]),
            ],
        ),
        (
            key: "monk/quarterstaff-master",
            blueprint: "dde7724382ae4f63aa9786cb9b3b64b2",
            name: "Quarterstaff Master",
            summary: "Monk devoted to the quarterstaff, losing most unarmed bonuses and gaining extra staff damage and fixed style strikes.",
            guide: "monk#quarterstaff-master",
            features: [
                (key: "monk/quarterstaff-master/flurry-of-blows-quarterstaff-master", blueprint: "44b0f313ec56481eb447019fbe714330", name: "Flurry of Blows (Quarterstaff Master)", summary: "Flurry of Blows works only with a quarterstaff.", guide: "monk#flurry-of-blows-quarterstaff-master"),
                (key: "monk/quarterstaff-master/quarterstaff-damage", blueprint: "11ce78cdcbe6427a8a4dd9dd1e36c914", name: "Quarterstaff Damage", summary: "Quarterstaff damage as one size larger (1d8) at 4th, two sizes (2d6) at 12th and three sizes (3d6) at 20th.", guide: "monk#quarterstaff-damage"),
                (key: "monk/quarterstaff-master/style-strike-disarm", blueprint: "63c83997c4cb4f008b448ac449739116", name: "Style Strike - Disarm", summary: "At 13th level, the first flurry attack makes a free disarm attempt.", guide: "monk#style-strike-disarm"),
                (key: "monk/quarterstaff-master/style-strike-sunder", blueprint: "a85bb778d9434c3683f543e1d7329781", name: "Style Strike - Sunder", summary: "At 9th level, the first flurry attack makes a free sunder attempt.", guide: "monk#style-strike-sunder"),
                (key: "monk/quarterstaff-master/style-strike-trip", blueprint: "89daaf240927407a9a6a570d27263595", name: "Style Strike - Trip", summary: "At 5th level, the first flurry attack makes a free trip attempt.", guide: "monk#style-strike-trip"),
            ],
            levels: [
                (level: 1, features: ["monk/ac-bonus", "monk/monk-proficiencies", "monk/quarterstaff-master/flurry-of-blows-quarterstaff-master"], feats: ["improved-unarmed-strike", "perfect-strike"], feat_slots: [OneOf(list: "monk/bonus-feats-1")]),
                (level: 3, features: ["monk/fast-movement", "monk/ki-pool", "monk/ki-power-extra-attack"]),
                (level: 4, features: ["monk/quarterstaff-master/quarterstaff-damage", "monk/still-mind"], selections: ["monk/ki-power"]),
                (level: 5, features: ["monk/purity-of-body", "monk/quarterstaff-master/style-strike-trip"]),
                (level: 7),
                (level: 8, selections: ["monk/ki-power"]),
                (level: 9, features: ["monk/improved-evasion", "monk/quarterstaff-master/style-strike-sunder"]),
                (level: 10, feat_slots: [OneOf(list: "monk/bonus-feats-10")], selections: ["monk/ki-power"]),
                (level: 12, features: ["monk/quarterstaff-master/quarterstaff-damage"], selections: ["monk/ki-power"]),
                (level: 13, features: ["monk/quarterstaff-master/style-strike-disarm"]),
                (level: 16, selections: ["monk/ki-power"]),
                (level: 17),
                (level: 20, features: ["monk/ki-power-perfect-self", "monk/quarterstaff-master/quarterstaff-damage"], selections: ["monk/ki-power"]),
            ],
        ),
        (
            key: "monk/scaled-fist",
            blueprint: "5868fc82eb11a4244926363983897279",
            name: "Scaled Fist",
            summary: "Draconic monk using Charisma in place of Wisdom, with elemental strikes and a breath attack.",
            guide: "monk#scaled-fist",
            features: [
                (key: "monk/scaled-fist/draconic-heritage", blueprint: "f9042eed12dac2745a2eb7a9a936906b", name: "Draconic Heritage", summary: "At 3rd level, pick a dragon type; swift action, 1 ki: unarmed strikes add 1d6 elemental damage for half your level in rounds.", guide: "monk#draconic-heritage"),
                (key: "monk/scaled-fist/draconic-mettle", blueprint: "6bcef8b77901a8f4eb6015f0a3f2dc63", name: "Draconic Mettle", summary: "At 3rd level, +2 on saves against fear, paralysis and sleep.", guide: "monk#draconic-mettle"),
                (key: "monk/scaled-fist/dragon-breath", name: "Dragon Breath", summary: "From 12th level, 3 ki: breath for 1d6 elemental damage per level in a 30' cone or 60' line (Reflex, DC 10 + half level + Cha).", guide: "monk#scaled-fist"),
            ],
            feat_lists: [
                (key: "monk/scaled-fist/bonus-feats-1", blueprint: "8705b13f703cbdc43ad1d9150f8cacca", name: "Scaled Fist Bonus Feats", guide: "monk#scaled-fist-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "dodge", "dragon-style", "improved-initiative", "intimidating-prowess"]),
                (key: "monk/scaled-fist/bonus-feats-10", blueprint: "c569fc66f22825445a7b7f3b5d6d208f", name: "Scaled Fist Bonus Feats (from level 10)", guide: "monk#scaled-fist-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "dazzling-display", "deflect-arrows", "disarm", "dodge", "dragon-ferocity", "dragon-roar", "dragon-style", "improved-blind-fight", "improved-critical", "improved-initiative", "intimidating-prowess", "trip"]),
