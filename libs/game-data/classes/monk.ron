                (key: "monk/zen-archer/bonus-feats-10", name: "Bonus Feat (Zen Archer, from level 10)", guide: "monk#bonus-feat-zen-archer", ignores_prerequisites: true, feats: ["clustered-shots", "combat-mobility", "combat-reflexes", "crane-style", "deflect-arrows", "dodge", "improved-critical", "improved-precise-shot", "manyshot", "point-blank-shot", "precise-shot", "rapid-shot"]),
