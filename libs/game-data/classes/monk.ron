                (key: "monk/sohei/bonus-feats-10", name: "Bonus Feat (Sohei, from level 10)", guide: "monk#bonus-feat-sohei", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "disarm", "dodge", "improved-blind-fight", "improved-critical", "improved-initiative", "indomitable-mount", "mounted-combat", "mounted-shield", "spirited-charge", "trample", "trip"]),
