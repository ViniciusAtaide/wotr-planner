        (
            key: "monk/student-of-stone",
            name: "Student of Stone",
            summary: "Oread-only monk focused on stability over mobility.",
            guide: "monk#student-of-stone",
            prerequisite: Race("oread"),
            features: [
                (key: "monk/student-of-stone/body-of-stone", name: "Body of Stone", summary: "At 9th level, 25% chance to ignore critical hits.", guide: "monk#body-of-stone"),
                (key: "monk/student-of-stone/bones-of-stone", name: "Bones of Stone", summary: "From 7th level, swift action, 1 ki: DR 2/magic until your next turn; DR 2/chaotic at 10th, DR 5/chaotic at 15th.", guide: "monk#bones-of-stone"),
                (key: "monk/student-of-stone/hard-as-stone", name: "Hard as Stone", summary: "At 2nd level, +4 AC against critical hit confirmation rolls.", guide: "monk#hard-as-stone"),
                (key: "monk/student-of-stone/soul-of-stone", name: "Soul of Stone", summary: "From 12th level, swift action, 1 ki: tremorsense 15' until your next turn (30' at 16th).", guide: "monk#soul-of-stone"),
                (key: "monk/student-of-stone/stone-self", name: "Stone Self", summary: "At 20th level, become an outsider with the earth subtype and gain tremorsense 20'.", guide: "monk#stone-self"),
                (key: "monk/student-of-stone/strength-of-stone", name: "Strength of Stone", summary: "From 3rd level, on the ground: +1 to attack, damage, bull rush and trip, and to CMD against bull rush and trip.", guide: "monk#strength-of-stone"),
            ],
            feat_lists: [
                (key: "monk/student-of-stone/bonus-feats-10", name: "Bonus Feat (Student of Stone, level 10)", guide: "monk#bonus-feat-student-of-stone", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "disarm", "dodge", "elemental-fist", "improved-blind-fight", "improved-critical", "improved-initiative", "shaitan-style", "trip"]),
