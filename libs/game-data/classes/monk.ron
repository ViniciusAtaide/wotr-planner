Class(
    key: "monk",
    name: "Monk",
    summary: "Lawful unarmed fighter with flurries, ki and Wis to AC; full BAB, 7 HP a level, good Fortitude and Reflex, 3 skill points a level.",
    guide: "monk",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["athletics", "knowledge-world", "lore-religion", "mobility", "perception", "persuasion", "stealth"],
    prerequisite: Any([Alignment(LawfulGood), Alignment(LawfulNeutral), Alignment(LawfulEvil)]),
    features: [
        (key: "monk/ac-bonus", name: "AC Bonus", summary: "With no armour or shield and a light load, add Wis to AC and CMD, plus +1 at 4th level and every four levels after (+5 at 20th).", guide: "monk#ac-bonus"),
        (key: "monk/evasion", name: "Evasion", summary: "From 2nd level, a successful Reflex save against a half-damage effect means no damage.", guide: "monk#evasion"),
        (key: "monk/fast-movement", name: "Fast Movement", summary: "From 3rd level, +10' base speed, +10' more every 3 levels.", guide: "monk#fast-movement"),
        (key: "monk/flurry-of-blows", name: "Flurry of Blows", summary: "Unarmed or with monk weapons, one extra attack at full BAB (stacks with Haste); two extra from 11th level.", guide: "monk#flurry-of-blows"),
        (key: "monk/improved-evasion", name: "Improved Evasion", summary: "From 9th level, a failed Reflex save against a half-damage effect still only deals half damage.", guide: "monk#improved-evasion"),
        (key: "monk/ki-pool", name: "Ki Pool", summary: "From 3rd level, a pool of half level + Wis ki points; while it holds a point, unarmed strikes bypass certain kinds of DR.", guide: "monk#ki-pool"),
        (key: "monk/ki-power-extra-attack", name: "Ki Power - Extra Attack", summary: "During a flurry, a swift action and 1 ki point give one more attack, stacking with Haste.", guide: "monk#ki-power-extra-attack"),
        (key: "monk/ki-power-perfect-self", name: "Ki Power: Perfect Self", summary: "At 20th level, DR 10/chaotic.", guide: "monk#ki-power-perfect-self"),
        (key: "monk/ki-strike-adamantine", name: "Ki Strike - Adamantine", summary: "At 16th level, unarmed strikes count as adamantine against DR.", guide: "monk#ki-strike-adamantine"),
        (key: "monk/ki-strike-cold-iron-and-silver", name: "Ki Strike - Cold Iron and Silver", summary: "At 7th level, unarmed strikes count as cold iron and silver against DR.", guide: "monk#ki-strike-cold-iron-and-silver"),
        (key: "monk/ki-strike-lawful", name: "Ki Strike - Lawful", summary: "At 10th level, unarmed strikes count as lawful against DR.", guide: "monk#ki-strike-lawful"),
        (key: "monk/ki-strike-magic", name: "Ki Strike - Magic", summary: "At 3rd level, unarmed strikes count as magic against DR.", guide: "monk#ki-strike-magic"),
        (key: "monk/monk-proficiencies", name: "Monk Proficiencies", summary: "Club, crossbow, dagger, handaxe, javelin, kama, nunchaku, quarterstaff, sai, short sword, shortspear, spear and monk weapons.", guide: "monk#monk-proficiencies"),
        (key: "monk/purity-of-body", name: "Purity of Body", summary: "At 5th level, immune to all diseases.", guide: "monk#purity-of-body"),
        (key: "monk/still-mind", name: "Still Mind", summary: "At 4th level, +2 on saves against enchantments.", guide: "monk#still-mind"),
        (key: "monk/stunning-fist", name: "Stunning Fist", summary: "Once a day per four levels, a hit forces a Fortitude save (DC 10 + half level + Wis) or the target is stunned for 1 round.", guide: "monk#stunning-fist"),
        (key: "monk/stunning-fist-fatigue", name: "Stunning Fist: Fatigue", summary: "From 4th level, Stunning Fist can fatigue the target for 1 minute instead of stunning it.", guide: "monk#stunning-fist-fatigue"),
        (key: "monk/stunning-fist-sicken", name: "Stunning Fist: Sicken", summary: "From 8th level, Stunning Fist can sicken the target for 1 minute instead of stunning it.", guide: "monk#stunning-fist-sicken"),
        (key: "monk/style-strike", name: "Style Strike", summary: "From 5th level, one flurry unarmed strike can be a style strike: Defensive Spin, Hammerblow, Leg Sweep or Shattering Punch; more every four levels.", guide: "monk#style-strike"),
        (key: "monk/unarmed-strike", name: "Unarmed Strike", summary: "Unarmed damage grows with level for a Medium monk: 1d6, 1d8 at 4th, 1d10 at 8th, 2d6 at 12th, 2d8 at 16th, 2d10 at 20th.", guide: "monk#unarmed-strike"),
    ],
    selections: [
        (
            key: "monk/ki-power",
            name: "Ki Power",
            summary: "Choose a ki power at 4th level and every 2 levels after, paid for with ki points.",
            guide: "monk#ki-power",
            options: [
                (key: "monk/ki-power/abundant-step", name: "Abundant Step", summary: "From 8th level, 2 ki: teleport like Dimension Door, without bringing others.", guide: "monk#abundant-step", prerequisite: ClassLevel(class: "monk", level: 8)),
                (key: "monk/ki-power/barkskin", name: "Barkskin", summary: "From 4th level, spend 1 ki point to cast Barkskin.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 4)),
                (key: "monk/ki-power/cold-ice-strike", name: "Cold Ice Strike", summary: "From 14th level, spend 3 ki points to use Cold Ice Strike.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 14)),
                (key: "monk/ki-power/diamond-body", name: "Diamond Body", summary: "From 12th level, immune to poison.", guide: "monk#diamond-body", prerequisite: ClassLevel(class: "monk", level: 12)),
                (key: "monk/ki-power/diamond-soul", name: "Diamond Soul", summary: "From 14th level, permanent spell resistance of level + 10.", guide: "monk#diamond-soul", prerequisite: ClassLevel(class: "monk", level: 14)),
                (key: "monk/ki-power/poison", name: "Poison", summary: "From 8th level, spend 2 ki points to use Poison.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 8)),
                (key: "monk/ki-power/quivering-palm", name: "Quivering Palm", summary: "From 16th level, 4 ki: a target that fails a Fortitude save (DC 10 + half level + Wis) dies.", guide: "monk#quivering-palm", prerequisite: ClassLevel(class: "monk", level: 16)),
                (key: "monk/ki-power/restoration", name: "Restoration", summary: "From 8th level, spend 2 ki points to cast Restoration.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 8)),
                (key: "monk/ki-power/scorching-ray", name: "Scorching Ray", summary: "From 4th level, spend 2 ki points to cast Scorching Ray.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 4)),
                (key: "monk/ki-power/shout", name: "Shout", summary: "From 14th level, 3 ki: 1d6 sonic damage per level and a 1-round stun; a Fortitude save halves it and negates the stun.", guide: "monk#shout", prerequisite: ClassLevel(class: "monk", level: 14)),
                (key: "monk/ki-power/spit-venom", name: "Spit Venom", summary: "From 10th level, spend 2 ki points to use Spit Venom.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 10)),
                (key: "monk/ki-power/sudden-speed", name: "Sudden Speed", summary: "From 4th level, 1 ki: +30' base speed for 1 minute.", guide: "monk#sudden-speed", prerequisite: ClassLevel(class: "monk", level: 4)),
                (key: "monk/ki-power/true-strike", name: "True Strike", summary: "From 4th level, spend 1 ki point to cast True Strike.", guide: "monk", prerequisite: ClassLevel(class: "monk", level: 4)),
                (key: "monk/ki-power/wholeness-of-body", name: "Wholeness of Body", summary: "From 8th level, 2 ki: heal HP equal to your level.", guide: "monk#wholeness-of-body", prerequisite: ClassLevel(class: "monk", level: 8)),
            ],
        ),
    ],
    feat_lists: [
        (key: "monk/bonus-feats-1", name: "Monk Bonus Feats", guide: "monk#monk-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "dodge", "improved-initiative"]),
        (key: "monk/bonus-feats-10", name: "Monk Bonus Feats (from level 10)", guide: "monk#monk-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "disarm", "dodge", "improved-blind-fight", "improved-critical", "improved-initiative", "trip"]),
        (key: "monk/bonus-feats-6", name: "Monk Bonus Feats (from level 6)", guide: "monk#monk-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "disarm", "dodge", "improved-initiative", "trip"]),
    ],
    levels: [
        (level: 1, features: ["monk/ac-bonus", "monk/flurry-of-blows", "monk/monk-proficiencies", "monk/stunning-fist", "monk/unarmed-strike"], feats: ["improved-unarmed-strike"], feat_slots: [OneOf(list: "monk/bonus-feats-1")]),
        (level: 2, features: ["monk/evasion"], feat_slots: [OneOf(list: "monk/bonus-feats-1")]),
        (level: 3, features: ["monk/fast-movement", "monk/ki-pool", "monk/ki-power-extra-attack", "monk/ki-strike-magic"]),
        (level: 4, features: ["monk/still-mind", "monk/stunning-fist-fatigue"], selections: ["monk/ki-power"]),
        (level: 5, features: ["monk/purity-of-body", "monk/style-strike"]),
        (level: 6, feat_slots: [OneOf(list: "monk/bonus-feats-6")], selections: ["monk/ki-power"]),
        (level: 7, features: ["monk/ki-strike-cold-iron-and-silver"]),
        (level: 8, features: ["monk/stunning-fist-sicken"], selections: ["monk/ki-power"]),
        (level: 9, features: ["monk/improved-evasion", "monk/style-strike"]),
        (level: 10, features: ["monk/ki-strike-lawful"], feat_slots: [OneOf(list: "monk/bonus-feats-10")], selections: ["monk/ki-power"]),
        (level: 11),
        (level: 12, selections: ["monk/ki-power"]),
        (level: 13, features: ["monk/style-strike"]),
        (level: 14, feat_slots: [OneOf(list: "monk/bonus-feats-10")], selections: ["monk/ki-power"]),
        (level: 15),
        (level: 16, features: ["monk/ki-strike-adamantine"], selections: ["monk/ki-power"]),
        (level: 17, features: ["monk/style-strike"]),
        (level: 18, feat_slots: [OneOf(list: "monk/bonus-feats-10")], selections: ["monk/ki-power"]),
        (level: 19),
        (level: 20, features: ["monk/ki-power-perfect-self"], selections: ["monk/ki-power"]),
    ],
    archetypes: [
        (
            key: "monk/drunken-master",
            name: "Drunken Master",
            summary: "Non-lawful monk (Dance of Masks DLC) who draws power from drinking.",
            guide: "monk#drunken-master",
            prerequisite: Any([Alignment(NeutralGood), Alignment(ChaoticGood), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
            features: [
                (key: "monk/drunken-master/drunken-combat", name: "Drunken Combat", summary: "+1 attack and AC and -1 Int for every two drunken ki points; your movement doesn't provoke attacks of opportunity.", guide: "monk#drunken-combat"),
                (key: "monk/drunken-master/drunken-courage", name: "Drunken Courage", summary: "From 7th level, immune to fear while holding ki; from 11th, +4 on saves against mind-affecting and compulsion effects.", guide: "monk#drunken-courage"),
                (key: "monk/drunken-master/drunken-ki", name: "Drunken Ki", summary: "From 3rd level, a ki pool of 2 + 1 per odd level (10 at 19th), refilled 1 point per drink (standard action, swift from 8th).", guide: "monk#drunken-ki"),
                (key: "monk/drunken-master/drunken-power", name: "Drunken Power", summary: "From 5th level, swift action, 1 ki: melee attacks deal +1d8 for Wis mod rounds, +1d8 every 3 levels (+5d8 at 18th).", guide: "monk#drunken-power"),
                (key: "monk/drunken-master/drunken-resilience", name: "Drunken Resilience", summary: "From 9th level, while holding ki: DR 2/- and +4 on saves against poison; DR 5/- at 15th and 10/- at 19th.", guide: "monk#drunken-resilience"),
                (key: "monk/drunken-master/drunken-technique-caydens-trick", name: "Drunken Technique: Cayden\'s Trick", summary: "From 6th level, 2 ki: vomit in a 15' cone; failing Reflex means -2 AC, blinded, flat-footed and sickened for 2-5 rounds, plus Grease.", guide: "monk#drunken-technique-caydens-trick"),
                (key: "monk/drunken-master/drunken-technique-firewater-breath", name: "Drunken Technique: Firewater Breath", summary: "From 4th level, 2 ki: breathe fire in a 15' cone for 1d6 per level (Reflex half).", guide: "monk#drunken-technique-firewater-breath"),
                (key: "monk/drunken-master/eternal-drunkenness", name: "Eternal Drunkenness", summary: "At 20th level, +6 to Str, Dex and Con and +6 ki pool capacity.", guide: "monk#eternal-drunkenness"),
            ],
            levels: [
                (level: 3, features: ["monk/drunken-master/drunken-combat", "monk/drunken-master/drunken-ki", "monk/fast-movement", "monk/ki-power-extra-attack", "monk/ki-strike-magic"]),
                (level: 4, features: ["monk/drunken-master/drunken-technique-firewater-breath", "monk/stunning-fist-fatigue"], selections: ["monk/ki-power"]),
                (level: 5, features: ["monk/drunken-master/drunken-power", "monk/style-strike"]),
                (level: 6, features: ["monk/drunken-master/drunken-technique-caydens-trick"], feat_slots: [OneOf(list: "monk/bonus-feats-6")], selections: ["monk/ki-power"]),
                (level: 7, features: ["monk/drunken-master/drunken-courage", "monk/ki-strike-cold-iron-and-silver"]),
                (level: 9, features: ["monk/drunken-master/drunken-resilience", "monk/improved-evasion", "monk/style-strike"]),
                (level: 20, features: ["monk/drunken-master/eternal-drunkenness"], selections: ["monk/ki-power"]),
            ],
        ),
        (
            key: "monk/quarterstaff-master",
            name: "Quarterstaff Master",
            summary: "Monk devoted to the quarterstaff, losing most unarmed bonuses and gaining extra staff damage and fixed style strikes.",
            guide: "monk#quarterstaff-master",
            features: [
                (key: "monk/quarterstaff-master/flurry-of-blows-quarterstaff-master", name: "Flurry of Blows (Quarterstaff Master)", summary: "Flurry of Blows works only with a quarterstaff.", guide: "monk#flurry-of-blows-quarterstaff-master"),
                (key: "monk/quarterstaff-master/quarterstaff-damage", name: "Quarterstaff Damage", summary: "Quarterstaff damage as one size larger (1d8) at 4th, two sizes (2d6) at 12th and three sizes (3d6) at 20th.", guide: "monk#quarterstaff-damage"),
                (key: "monk/quarterstaff-master/style-strike-disarm", name: "Style Strike - Disarm", summary: "At 13th level, the first flurry attack makes a free disarm attempt.", guide: "monk#style-strike-disarm"),
                (key: "monk/quarterstaff-master/style-strike-sunder", name: "Style Strike - Sunder", summary: "At 9th level, the first flurry attack makes a free sunder attempt.", guide: "monk#style-strike-sunder"),
                (key: "monk/quarterstaff-master/style-strike-trip", name: "Style Strike - Trip", summary: "At 5th level, the first flurry attack makes a free trip attempt.", guide: "monk#style-strike-trip"),
            ],
            levels: [
                (level: 1, features: ["monk/ac-bonus", "monk/monk-proficiencies", "monk/quarterstaff-master/flurry-of-blows-quarterstaff-master"], feats: ["improved-unarmed-strike", "perfect-strike"], feat_slots: [OneOf(list: "monk/bonus-feats-1")]),
                (level: 3, features: ["monk/fast-movement", "monk/ki-pool", "monk/ki-power-extra-attack"]),
                (level: 4, features: ["monk/quarterstaff-master/quarterstaff-damage", "monk/still-mind"], selections: ["monk/ki-power"]),
                (level: 5, features: ["monk/purity-of-body", "monk/quarterstaff-master/style-strike-trip"]),
                (level: 7),
                (level: 8, selections: ["monk/ki-power"]),
                (level: 9, features: ["monk/improved-evasion", "monk/quarterstaff-master/style-strike-sunder"]),
                (level: 10, feat_slots: [OneOf(list: "monk/bonus-feats-10")], selections: ["monk/ki-power"]),
                (level: 12, features: ["monk/quarterstaff-master/quarterstaff-damage"], selections: ["monk/ki-power"]),
                (level: 13, features: ["monk/quarterstaff-master/style-strike-disarm"]),
                (level: 16, selections: ["monk/ki-power"]),
                (level: 17),
                (level: 20, features: ["monk/ki-power-perfect-self", "monk/quarterstaff-master/quarterstaff-damage"], selections: ["monk/ki-power"]),
            ],
        ),
        (
            key: "monk/scaled-fist",
            name: "Scaled Fist",
            summary: "Draconic monk using Charisma in place of Wisdom, with elemental strikes and a breath attack.",
            guide: "monk#scaled-fist",
            features: [
                (key: "monk/scaled-fist/draconic-heritage", name: "Draconic Heritage", summary: "At 3rd level, pick a dragon type; swift action, 1 ki: unarmed strikes add 1d6 elemental damage for half your level in rounds.", guide: "monk#draconic-heritage"),
                (key: "monk/scaled-fist/draconic-mettle", name: "Draconic Mettle", summary: "At 3rd level, +2 on saves against fear, paralysis and sleep.", guide: "monk#draconic-mettle"),
                (key: "monk/scaled-fist/dragon-breath", name: "Dragon Breath", summary: "From 12th level, 3 ki: breath for 1d6 elemental damage per level in a 30' cone or 60' line (Reflex, DC 10 + half level + Cha).", guide: "monk#scaled-fist"),
            ],
            feat_lists: [
                (key: "monk/scaled-fist/bonus-feats-1", name: "Scaled Fist Bonus Feats", guide: "monk#scaled-fist-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "deflect-arrows", "dodge", "dragon-style", "improved-initiative", "intimidating-prowess"]),
                (key: "monk/scaled-fist/bonus-feats-10", name: "Scaled Fist Bonus Feats (from level 10)", guide: "monk#scaled-fist-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "dazzling-display", "deflect-arrows", "disarm", "dodge", "dragon-ferocity", "dragon-roar", "dragon-style", "improved-blind-fight", "improved-critical", "improved-initiative", "intimidating-prowess", "trip"]),
                (key: "monk/scaled-fist/bonus-feats-6", name: "Scaled Fist Bonus Feats (from level 6)", guide: "monk#scaled-fist-bonus-feats", ignores_prerequisites: true, feats: ["blind-fight", "combat-reflexes", "crane-style", "dazzling-display", "deflect-arrows", "disarm", "dodge", "dragon-ferocity", "dragon-style", "improved-initiative", "intimidating-prowess", "trip"]),
            ],
            levels: [
                (level: 1, features: ["monk/ac-bonus", "monk/flurry-of-blows", "monk/monk-proficiencies", "monk/stunning-fist", "monk/unarmed-strike"], feats: ["improved-unarmed-strike"], feat_slots: [OneOf(list: "monk/scaled-fist/bonus-feats-1")]),
                (level: 2, features: ["monk/evasion"], feat_slots: [OneOf(list: "monk/scaled-fist/bonus-feats-1")]),
                (level: 3, features: ["monk/fast-movement", "monk/ki-pool", "monk/ki-power-extra-attack", "monk/ki-strike-magic", "monk/scaled-fist/draconic-heritage", "monk/scaled-fist/draconic-mettle"]),
                (level: 4, features: ["monk/stunning-fist-fatigue"], selections: ["monk/ki-power"]),
                (level: 6, feat_slots: [OneOf(list: "monk/scaled-fist/bonus-feats-6")], selections: ["monk/ki-power"]),
                (level: 10, features: ["monk/ki-strike-lawful"], feat_slots: [OneOf(list: "monk/scaled-fist/bonus-feats-10")], selections: ["monk/ki-power"]),
                (level: 12, features: ["monk/scaled-fist/dragon-breath"]),
                (level: 14, feat_slots: [OneOf(list: "monk/scaled-fist/bonus-feats-10")], selections: ["monk/ki-power"]),
                (level: 18, feat_slots: [OneOf(list: "monk/scaled-fist/bonus-feats-10")], selections: ["monk/ki-power"]),
            ],
        ),
        (
            key: "monk/sensei",
            name: "Sensei",
            summary: "Teaching monk who trades Fast Movement and Flurry of Blows for bard-like Advice performances.",
            guide: "monk#sensei",
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion", "stealth"],
            features: [
                (key: "monk/sensei/advice", name: "Advice", summary: "Bard-style performances for character level + Wis rounds a day; the Lingering Performance feat works with them.", guide: "monk#advice"),
                (key: "monk/sensei/insightful-strike", name: "Insightful Strike", summary: "From 2nd level, use Wis instead of Str or Dex for attacks and maneuvers with unarmed strikes and monk weapons.", guide: "monk#insightful-strike"),
                (key: "monk/sensei/inspire-competence", name: "Inspire Competence", summary: "From 3rd level, the bard's Inspire Competence.", guide: "monk#inspire-competence"),
                (key: "monk/sensei/inspire-courage", name: "Inspire Courage", summary: "The bard's Inspire Courage.", guide: "monk#inspire-courage"),
                (key: "monk/sensei/inspire-greatness", name: "Inspire Greatness", summary: "From 9th level, the bard's Inspire Greatness.", guide: "monk#inspire-greatness"),
                (key: "monk/sensei/mystic-powers", name: "Mystic Powers", summary: "From 6th level, Advice extends ki powers such as Barkskin or True Strike to an ally in 30', and to all allies in 30' from 10th.", guide: "monk#mystic-powers"),
                (key: "monk/sensei/mystic-wisdom", name: "Mystic Wisdom", summary: "From 10th level, 1 ki gives an ally in 30' Evasion, Fast Movement or Purity of Soul for 1 minute; from 14th, 2 ki for all allies.", guide: "monk#mystic-wisdom"),
            ],
            levels: [
                (level: 1, features: ["monk/ac-bonus", "monk/monk-proficiencies", "monk/sensei/advice", "monk/sensei/inspire-courage", "monk/stunning-fist", "monk/unarmed-strike"], feats: ["improved-unarmed-strike"], feat_slots: [OneOf(list: "monk/bonus-feats-1")]),
                (level: 2, features: ["monk/sensei/insightful-strike"]),
                (level: 3, features: ["monk/ki-pool", "monk/ki-strike-magic", "monk/sensei/inspire-competence"]),
                (level: 6, features: ["monk/sensei/mystic-powers"], selections: ["monk/ki-power"]),
                (level: 9, features: ["monk/sensei/inspire-greatness", "monk/style-strike"]),
                (level: 10, features: ["monk/ki-strike-lawful", "monk/sensei/mystic-wisdom"], selections: ["monk/ki-power"]),
                (level: 14, selections: ["monk/ki-power"]),
            ],
        ),
        (
            key: "monk/sohei",
            name: "Sohei",
            summary: "Mounted monk with a horse, weapon training and martial weapons, losing most unarmed bonuses.",
            guide: "monk#sohei",
            class_skills: ["athletics", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion", "stealth"],
            features: [
                (key: "monk/sohei/devoted-guardian", name: "Devoted Guardian", summary: "Bonus of half your level on initiative; at 20th level, initiative is always 20.", guide: "monk#devoted-guardian"),
                (key: "monk/sohei/flurry-of-blows-sohei", name: "Flurry of Blows (Sohei)", summary: "Flurry with quarterstaffs and trained weapons; in light armour, only with trained weapons.", guide: "monk#flurry-of-blows-sohei"),
                (key: "monk/sohei/ki-weapon", name: "Ki Weapon", summary: "From 4th level, swift action, 1 ki: weapon gets +1 attack and damage until your next turn, +1 every four levels (+5 at 20th).", guide: "monk#ki-weapon"),
                (key: "monk/sohei/monastic-mount", name: "Monastic Mount", summary: "Gain a horse animal companion.", guide: "monk#monastic-mount"),
                (key: "monk/sohei/sohei-proficiencies", name: "Sohei Proficiencies", summary: "Simple and martial weapons and light armour; from 3rd, 1 ki gives your mount temporary HP of twice your level for an hour per level.", guide: "monk#sohei-proficiencies"),
                (key: "monk/sohei/weapon-training", name: "Weapon Training", summary: "At 6th level, weapon training in bows, crossbows, monk weapons, polearms, spears or thrown weapons; again at 12th and 18th.", guide: "monk#weapon-training"),
            ],
            feat_lists: [
