                (key: "kineticist/kinetic-sharpshooter/kinetic-quiver", name: "Kinetic Quiver", summary: "From 3rd level, accept 1 Burn for a quiver holding charges equal to your level, spent to add infusions to blasts.", guide: "kineticist#kinetic-quiver"),
