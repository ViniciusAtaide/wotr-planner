                (key: "kineticist/kinetic-knight/defensive-wild-talent", name: "Defensive Wild Talent", summary: "At 4th level, unlocks the Defensive Wild Talent of her Elemental Focus.", guide: "kineticist#kinetic-knight", option_row: (selection: "kineticist/kinetic-knight/element", level: 2)),
                (key: "kineticist/kinetic-knight/elemental-bastion", name: "Elemental Bastion", summary: "At 1st level, proficiency with medium and heavy armour and shields.", guide: "kineticist#elemental-bastion"),
                (key: "kineticist/kinetic-knight/elemental-blade", name: "Elemental Blade", summary: "Kinetic Blade costs 0 Burn, but blasts need the blade (or Blade Whirlwind from 9th); no attacks of opportunity with it.", guide: "kineticist#elemental-blade"),
                (key: "kineticist/kinetic-knight/kinetic-warrior", name: "Kinetic Warrior", summary: "Use Con instead of Int to qualify for combat feats; counts as Combat Expertise for prerequisites.", guide: "kineticist#kinetic-warrior"),
                (key: "kineticist/kinetic-knight/knights-resolve", name: "Knight\'s Resolve", summary: "From 3rd level, Resolve 1/day (+1 per two levels, 9 at 19th) to remove conditions or roll a Fortitude or Will save twice.", guide: "kineticist#knights-resolve"),
