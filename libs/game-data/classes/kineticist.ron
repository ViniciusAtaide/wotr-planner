Class(
    key: "kineticist",
    name: "Kineticist",
    summary: "Hurls elemental blasts and takes Burn for extra power; Dex and Con based, 3/4 BAB, 6 HP a level, good Fortitude and Reflex, 2 skill points a level.",
    guide: "kineticist",
    skill_points: 2,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["mobility", "perception", "persuasion", "stealth", "use-magic-device"],
    features: [
        (key: "kineticist/burn", name: "Burn", summary: "Accept Burn (up to 1 a round, rising to 6 at 18th) to power abilities; each point deals 1 nonlethal damage per level until rest, max level + Con mod.", guide: "kineticist#burn"),
        (key: "kineticist/composite-specialization", name: "Composite Specialization", summary: "At 16th level, composite blasts cost 1 less Burn.", guide: "kineticist#composite-specialization"),
        (key: "kineticist/element/air/enveloping-winds", name: "Enveloping Winds", summary: "Ranged attacks against you get a 20% miss chance, +5% per five levels past 2nd; each Burn accepted adds another 5%.", guide: "kineticist#enveloping-winds"),
        (key: "kineticist/element/earth/flesh-of-stone", name: "Flesh of Stone", summary: "DR 1/adamantine, +1 per two levels past 2nd (DR 10 at 20th); each Burn accepted adds 1 more DR.", guide: "kineticist#flesh-of-stone"),
        (key: "kineticist/element/fire/searing-flesh", name: "Searing Flesh", summary: "Creatures hitting you with unarmed or natural attacks take 1 fire damage per four levels, multiplied by any Burn you accept.", guide: "kineticist#searing-flesh"),
        (key: "kineticist/element/water/shroud-of-water", name: "Shroud of Water", summary: "Choose a +4 armour or +2 shield bonus to AC, +1 per four levels past 2nd; each Burn accepted adds 1 more.", guide: "kineticist#shroud-of-water"),
        (key: "kineticist/elemental-overflow", name: "Elemental Overflow", summary: "From 3rd level, blasts gain +1 attack per Burn (max +1 per 3 levels) and twice that to damage; at high Burn, bonuses to physical scores.", guide: "kineticist#elemental-overflow"),
        (key: "kineticist/gather-power", name: "Gather Power", summary: "A move action cuts a blast's Burn cost by 1, a full round by 2, and a full round plus a move action by 3.", guide: "kineticist#gather-power"),
        (key: "kineticist/infusion", name: "Infusion", summary: "Learn infusions, with new ones at 3rd, 5th, 9th, 11th, 13th, 17th and 19th; a blast can take one form and one substance infusion.", guide: "kineticist#infusion"),
        (key: "kineticist/infusion-specialization", name: "Infusion Specialization", summary: "From 5th level, the combined Burn cost of infusions drops by 1, and by 1 more at 8th, 11th, 14th, 17th and 20th.", guide: "kineticist#infusion-specialization"),
        (key: "kineticist/kinetic-blast", name: "Kinetic Blast", summary: "Standard-action ranged blast to 30'; physical 1d6+1+Con, energy 1d6+half Con vs touch AC, +1 die every odd level; composites deal double.", guide: "kineticist#kinetic-blast"),
        (key: "kineticist/metakinesis-empowered", name: "Metakinesis - Empowered", summary: "From 5th level, accept 1 extra Burn to empower a blast as with the Empower metamagic.", guide: "kineticist"),
        (key: "kineticist/metakinesis-maximized", name: "Metakinesis - Maximized", summary: "From 9th level, accept 2 extra Burn to maximize a blast as with the Maximize metamagic.", guide: "kineticist"),
        (key: "kineticist/metakinesis-quicken", name: "Metakinesis - Quicken", summary: "From 13th level, accept 3 extra Burn to quicken a blast as with the Quicken metamagic.", guide: "kineticist"),
        (key: "kineticist/metakinetic-master", name: "Metakinetic Master", summary: "At 19th level, one chosen Metakinesis costs 1 less Burn.", guide: "kineticist#metakinetic-master"),
        (key: "kineticist/supercharge", name: "Supercharge", summary: "From 11th level, Gather Power cuts Burn by 2 as a move action and by 3 as a full round.", guide: "kineticist#supercharge"),
        (key: "kineticist/wild-talents/expanded-defense/defense", name: "Expanded Defense", summary: "Unlocks the Defensive Wild Talent of an element gained through Expanded Element.", guide: "kineticist#expanded-defense", option_row: (selection: "kineticist/expanded-element", level: 2)),
    ],
    selections: [
        (
            key: "kineticist/element",
            name: "Elemental Focus",
            summary: "Choose the element your powers draw on; it sets your blasts, extra class skills, bonus feat list and defensive wild talent.",
            guide: "kineticist#elemental-focus",
            option_levels: ["kineticist"],
            options: [
                (
                    key: "kineticist/element/air",
                    name: "Elemental Focus - Air",
                    summary: "Air: Lore (Nature) as a class skill, mobility and reflex bonus feats, and the Enveloping Winds defense.",
                    guide: "kineticist#elemental-focus-air",
                    repeat: Times(2),
                    levels: [
                        (level: 1, feat_list: "kineticist/element/air/wild-talent-feats", class_skills: ["lore-nature"]),
                        (level: 2, features: ["kineticist/element/air/enveloping-winds"]),
                    ],
                ),
                (
                    key: "kineticist/element/earth",
                    name: "Elemental Focus - Earth",
                    summary: "Earth: Athletics and Knowledge (World) as class skills, toughness and trip bonus feats, and the Flesh of Stone defense.",
                    guide: "kineticist#elemental-focus-earth",
                    repeat: Times(2),
                    levels: [
                        (level: 1, feat_list: "kineticist/element/earth/wild-talent-feats", class_skills: ["athletics", "knowledge-world"]),
                        (level: 2, features: ["kineticist/element/earth/flesh-of-stone"]),
                    ],
                ),
                (
                    key: "kineticist/element/fire",
                    name: "Elemental Focus - Fire",
                    summary: "Fire: Lore (Nature) as a class skill, intimidation and will bonus feats, and the Searing Flesh defense.",
                    guide: "kineticist#elemental-focus-fire",
                    repeat: Times(2),
                    levels: [
                        (level: 1, feat_list: "kineticist/element/fire/wild-talent-feats", class_skills: ["lore-nature"]),
                        (level: 2, features: ["kineticist/element/fire/searing-flesh"]),
                    ],
                ),
                (
                    key: "kineticist/element/water",
                    name: "Elemental Focus - Water",
                    summary: "Water: Athletics and Lore (Nature) as class skills, blind-fight and bull rush bonus feats, and the Shroud of Water defense.",
                    guide: "kineticist#elemental-focus-water",
                    repeat: Times(2),
                    levels: [
                        (level: 1, feat_list: "kineticist/element/water/wild-talent-feats", class_skills: ["athletics", "lore-nature"]),
                        (level: 2, features: ["kineticist/element/water/shroud-of-water"]),
                    ],
                ),
            ],
        ),
        (
            key: "kineticist/expanded-element",
            name: "Expanded Element",
            summary: "At 7th level pick a second element or deepen your first, gaining its blasts and composites; at 15th pick a third or deepen again.",
            guide: "kineticist#expanded-element",
            option_levels: ["kineticist"],
            feat_lists_only: true,
            once_per_option: true,
            options: [],
            shared_options: [
                "kineticist/element/air",
                "kineticist/element/earth",
                "kineticist/element/fire",
                "kineticist/element/water",
            ],
        ),
        (
            key: "kineticist/infusions",
            name: "Infusion",
            summary: "Pick an infusion you qualify for; a blast can carry one form and one substance infusion.",
            guide: "kineticist#infusion",
            options: [
                (key: "kineticist/infusions/blade-whirlwind", name: "Blade Whirlwind", summary: "Form, 3 Burn: conjure a kinetic blade and make one attack against every foe in reach.", guide: "kineticist#blade-whirlwind", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 10), SelectionOption("kineticist/infusions/kinetic-blade")])),
                (key: "kineticist/infusions/bowling-infusion", name: "Bowling Infusion", summary: "Substance, 2 Burn, earth blasts: trip each target the blast damages, using your Con modifier for the combat maneuver.", guide: "kineticist#bowling-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 4), SelectionOption("kineticist/element/earth")])),
                (key: "kineticist/infusions/burning-infusion", name: "Burning Infusion", summary: "Substance, 1 Burn, fire blasts: a target hit past SR catches fire for 1d6 a round until put out (Reflex negates).", guide: "kineticist#burning-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/chain-arrows", name: "Chain Arrows", summary: "Sharpshooter form, 6 Burn: the shot jumps up to 10' between enemies, hitting up to half your level in targets (Reflex half).", guide: "kineticist#chain-arrows", prerequisite: All([ClassLevel(class: "kineticist", level: 16), Archetype("kineticist/kinetic-sharpshooter")])),
                (key: "kineticist/infusions/chilling-infusion", name: "Chilling Infusion", summary: "Substance, 3 Burn, cold blasts: a foe dealt cold damage is staggered for 1 round (Fortitude negates).", guide: "kineticist#chilling-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 10), SelectionOption("kineticist/element/water")])),
                (key: "kineticist/infusions/cloud", name: "Cloud", summary: "Form, 4 Burn: a 20' cloud up to 50' away lasts Con mod rounds and deals half blast damage to anyone entering or ending a turn in it.", guide: "kineticist#cloud", prerequisite: All([Any([SelectionOption("kineticist/element/air"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 14), SelectionOption("kineticist/infusions/extended-range")])),
                (key: "kineticist/infusions/cyclone", name: "Cyclone", summary: "Form, 3 Burn, air blasts: everything in a 20' radius takes half blast damage (Reflex half).", guide: "kineticist#cyclone", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/infusions/dazzling-infusion", name: "Dazzling Infusion", summary: "Substance, 1 Burn, fire blasts: a target hit past SR is dazzled for 1 minute (Will negates).", guide: "kineticist#dazziing-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/deadly-earth", name: "Deadly Earth", summary: "Form, 4 Burn: a 20' patch up to 50' away becomes difficult terrain for Con mod rounds, dealing half blast damage to those in it.", guide: "kineticist#deadly-earth", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 12), SelectionOption("kineticist/element/earth"), SelectionOption("kineticist/infusions/extended-range")])),
                (key: "kineticist/infusions/detonation", name: "Detonation", summary: "Form, 3 Burn, fire blasts: every creature in a 20' radius takes full blast damage (Reflex half).", guide: "kineticist#detonation", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/entangling-infusion", name: "Entangling Infusion", summary: "Substance, 2 Burn, earth or water: a damaged foe is entangled for 1 minute, and rooted if it fails a second save (Reflex negates).", guide: "kineticist#entangling-infusion", prerequisite: All([Any([SelectionOption("kineticist/element/earth"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 4)])),
                (key: "kineticist/infusions/eruption", name: "Eruption", summary: "Form, 3 Burn, fire blasts: a 10' radius burst up to 50' away; full damage for energy blasts, half for physical (Reflex half).", guide: "kineticist#eruption", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/infusions/extended-range")])),
                (key: "kineticist/infusions/exploding-arrows", name: "Exploding Arrows", summary: "Sharpshooter form, 2 Burn: creatures within 5' of the target take half blast damage (Reflex half).", guide: "kineticist#exploding-arrows", prerequisite: All([ClassLevel(class: "kineticist", level: 2), Archetype("kineticist/kinetic-sharpshooter")])),
                (key: "kineticist/infusions/extended-range", name: "Extended Range", summary: "Form, 1 Burn: the blast reaches any target within 50'.", guide: "kineticist#extended-range", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/infusions/fan-of-flames", name: "Fan of Flames", summary: "Form, 1 Burn, fire blasts: the blast fills a 15' cone (Reflex half).", guide: "kineticist#fan-of-flames", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/flash-infusion", name: "Flash Infusion", summary: "Substance, 3 Burn, fire blasts: a target hit past SR is blinded for 1 round (Will negates).", guide: "kineticist#flash-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/foxfire-infusion", name: "Foxfire Infusion", summary: "Substance, 2 Burn, fire blasts: the target gets Faerie Fire for 1 minute, or until your next turn on a save.", guide: "kineticist#foxfire-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/wild-talents/foxfire")])),
                (key: "kineticist/infusions/fragmentation", name: "Fragmentation", summary: "Form, 4 Burn: hit a target within 50' for full damage; creatures within 20' of it take half (Reflex for half again).", guide: "kineticist#fragmentation", prerequisite: All([Any([SelectionOption("kineticist/element/earth"), SelectionOption("kineticist/element/water")]), Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 14), SelectionOption("kineticist/infusions/extended-range")])),
                (key: "kineticist/infusions/grappling-infusion", name: "Grappling Infusion", summary: "Substance, 3 Burn: foes in your Cloud, Deadly Earth or Wall must make a Reflex save or be grappled.", guide: "kineticist#grappling-infusion", prerequisite: All([Any([SelectionOption("kineticist/infusions/cloud"), SelectionOption("kineticist/infusions/deadly-earth"), SelectionOption("kineticist/infusions/wall")]), ClassLevel(class: "kineticist", level: 10)])),
                (key: "kineticist/infusions/honed-infusion", name: "Honed Infusion", summary: "Sharpshooter substance, 3 Burn: the blast ignores damage reduction.", guide: "kineticist#honed-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 12), Archetype("kineticist/kinetic-sharpshooter")])),
                (key: "kineticist/infusions/kinetic-blade", name: "Kinetic Blade", summary: "Form, 1 Burn: a light one-handed blade dealing blast damage per hit, usable in full attacks and charges; no Str or Overflow damage.", guide: "kineticist#kinetic-blade", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/infusions/magnetic-infusion", name: "Magnetic Infusion", summary: "Substance, 2 Burn: attacks with metal weapons get +4 against the target until the end of your next turn.", guide: "kineticist#magnetic-infusion", prerequisite: All([Any([SelectionOption("kineticist/element/air"), SelectionOption("kineticist/element/earth")]), ClassLevel(class: "kineticist", level: 4)])),
                (key: "kineticist/infusions/pure-flame-infusion", name: "Pure-Flame Infusion", summary: "Substance, 4 Burn, blue flame blasts: the blast ignores spell resistance.", guide: "kineticist#pure-flame-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 14), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/pushing-infusion", name: "Pushing Infusion", summary: "Substance, 1 Burn: bull rush each target the blast damages, using your Con modifier for the combat maneuver.", guide: "kineticist#pushing-infusion", prerequisite: All([Any([SelectionOption("kineticist/element/air"), SelectionOption("kineticist/element/earth"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/infusions/rare-metal-infusion", name: "Rare-Metal Infusion", summary: "Substance, 2 Burn, metal blasts: the blast bypasses DR as adamantine, cold iron or silver.", guide: "kineticist#rare-metal-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/earth")])),
                (key: "kineticist/infusions/rending-arrows", name: "Rending Arrows", summary: "Sharpshooter substance, 3 Burn: each hit gives the target -2 AC, stacking to -10.", guide: "kineticist#rending-arrows", prerequisite: All([ClassLevel(class: "kineticist", level: 10), Archetype("kineticist/kinetic-sharpshooter")])),
                (key: "kineticist/infusions/spindle", name: "Spindle", summary: "Form, 2 Burn: a spindle up to 30' hits creatures in two adjacent squares; full damage for energy, half for physical (Reflex negates).", guide: "kineticist#spindle", prerequisite: ClassLevel(class: "kineticist", level: 4)),
                (key: "kineticist/infusions/spray", name: "Spray", summary: "Form, 3 Burn, water blasts: everything in a 30' cone takes half blast damage (Reflex half).", guide: "kineticist#spray", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/water")])),
                (key: "kineticist/infusions/synaptic-infusion", name: "Synaptic Infusion", summary: "Substance, 2 Burn, electric blasts: the target is staggered for 1 round (Will negates).", guide: "kineticist#synaptic-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/infusions/torrent", name: "Torrent", summary: "Form, 2 Burn: the blast hits foes in a 30' line; full damage for energy, half for physical (Reflex half).", guide: "kineticist#torrent", prerequisite: All([Any([SelectionOption("kineticist/element/air"), SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 6)])),
                (key: "kineticist/infusions/unraveling-infusion", name: "Unraveling Infusion", summary: "Substance, 3 Burn, fire blasts: a target hit past SR is subject to Dispel Magic.", guide: "kineticist#unraveling-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 10), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/wall", name: "Wall", summary: "Form, 3 Burn: a wall lasting Con mod rounds deals blast damage (half for physical) to any creature crossing it.", guide: "kineticist#wall", prerequisite: ClassLevel(class: "kineticist", level: 10)),
            ],
        ),
        (
            key: "kineticist/wild-talents",
            name: "Wild Talents",
            summary: "Pick a utility wild talent at 2nd level and every even level after.",
            guide: "kineticist#wild-talents",
            option_levels: ["kineticist"],
            options: [
                (key: "kineticist/wild-talents/aerial-adaptation", name: "Aerial Adaptation", summary: "Electricity resistance equal to twice your current Burn.", guide: "kineticist#aerial-adaptation", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/wild-talents/aerial-evasion", name: "Aerial Evasion", summary: "1 Burn: gain Evasion.", guide: "kineticist#aerial-evasion", prerequisite: All([ClassLevel(class: "kineticist", level: 6), Feature(feature: "kineticist/element/air/enveloping-winds", count: 1), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/wild-talents/celerity", name: "Celerity", summary: "Haste yourself for 1 round, or for rounds equal to your level by accepting 1 Burn.", guide: "kineticist#celerity", prerequisite: All([ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/wild-talents/cold-adaptation", name: "Cold Adaptation", summary: "Cold resistance equal to twice your current Burn.", guide: "kineticist#cold-adaptation", prerequisite: All([Any([SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/wild-talents/elemental-whispers", name: "Elemental Whispers", summary: "Gain a familiar.", guide: "kineticist#elemental-whispers", prerequisite: ClassLevel(class: "kineticist", level: 2)),
                (key: "kineticist/wild-talents/enduring-earth", name: "Enduring Earth", summary: "Effect durations of your earth blasts, composite earth blasts and wild talents are doubled.", guide: "kineticist#enduring-earth", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/earth")])),
                (
                    key: "kineticist/wild-talents/expanded-defense",
                    name: "Expanded Defense",
                    summary: "Unlocks the Defensive Wild Talent of an element gained through Expanded Element.",
                    guide: "kineticist#expanded-defense",
                    prerequisite: ClassLevel(class: "kineticist", level: 8),
                    levels: [
                        (level: 1, features: ["kineticist/wild-talents/expanded-defense/defense"]),
                    ],
                ),
                (key: "kineticist/wild-talents/fires-fury", name: "Fire\'s Fury", summary: "Fire and fire composite blasts add your Elemental Overflow bonus to damage again.", guide: "kineticist#fires-fury", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/wild-talents/flame-shield", name: "Flame Shield", summary: "1 Burn: creatures hitting you in melee without reach take fire damage equal to half your level.", guide: "kineticist#flame-shield", prerequisite: All([ClassLevel(class: "kineticist", level: 2), Feature(feature: "kineticist/element/fire/searing-flesh", count: 1), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/wild-talents/foxfire", name: "Foxfire", summary: "Outline a target with the effect of Faerie Fire (spell resistance applies).", guide: "kineticist#foxfire", prerequisite: All([ClassLevel(class: "kineticist", level: 4), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/wild-talents/healing-burst", name: "Healing Burst", summary: "1 Burn: heal everyone in a 30' radius for half your blast damage.", guide: "kineticist#healing-burst", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/water"), SelectionOption("kineticist/wild-talents/kinetic-healer")])),
                (key: "kineticist/wild-talents/heat-adaptation", name: "Heat Adaptation", summary: "Fire resistance equal to twice your current Burn.", guide: "kineticist#heat-adaptation", prerequisite: All([Any([SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/wild-talents/jagged-flesh", name: "Jagged Flesh", summary: "1 Burn: creatures hitting you with unarmed strikes or natural weapons take 1d6 piercing damage.", guide: "kineticist#jagged-flesh", prerequisite: All([ClassLevel(class: "kineticist", level: 6), Feature(feature: "kineticist/element/earth/flesh-of-stone", count: 1), SelectionOption("kineticist/element/earth")])),
                (key: "kineticist/wild-talents/kinetic-healer", name: "Kinetic Healer", summary: "1 Burn: heal a creature for your blast damage.", guide: "kineticist#kinetic-healer", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/water")])),
                (key: "kineticist/wild-talents/kinetic-restoration", name: "Kinetic Restoration", summary: "1 Burn: heal 1d4 physical ability damage and remove fatigue.", guide: "kineticist#kinetic-restoration", prerequisite: ClassLevel(class: "kineticist", level: 6)),
                (key: "kineticist/wild-talents/kinetic-revivification", name: "Kinetic Revivification", summary: "Kinetic Healer can bring back an ally who died within the last two rounds.", guide: "kineticist#kinetic-revivification", prerequisite: All([ClassLevel(class: "kineticist", level: 12), SelectionOption("kineticist/element/water"), SelectionOption("kineticist/wild-talents/kinetic-healer")])),
                (
                    key: "kineticist/wild-talents/kineticist-bonus-feat",
                    name: "Kineticist Bonus Feat",
                    summary: "Take a bonus feat from an Elemental Focus list, ignoring its prerequisites.",
                    guide: "kineticist#kineticist-bonus-feat",
                    prerequisite: ClassLevel(class: "kineticist", level: 2),
                    levels: [
                        (level: 1, feat_slots: [OptionList(selection: "kineticist/element", label: "Wild talent feat")]),
                    ],
                ),
                (key: "kineticist/wild-talents/skill-focus", name: "Skill Focus", summary: "Works like the Skill Focus feat.", guide: "kineticist#skill-focus", chosen_feat: "skill-focus", repeat: PerValue, prerequisite: ClassLevel(class: "kineticist", level: 2)),
                (key: "kineticist/wild-talents/skilled-kineticist", name: "Skilled Kineticist", summary: "Bonus of half your level on the class skills granted by your primary Elemental Focus.", guide: "kineticist#skilled-kineticist", prerequisite: ClassLevel(class: "kineticist", level: 2)),
                (key: "kineticist/wild-talents/slick", name: "Slick", summary: "Grease for 1 round, or for 1 minute per level by accepting 1 Burn.", guide: "kineticist#slick", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/water")])),
                (key: "kineticist/wild-talents/tidal-wave", name: "Tidal Wave", summary: "1 Burn: produce the effect of the Tsunami spell.", guide: "kineticist#tidal-wave", prerequisite: All([ClassLevel(class: "kineticist", level: 18), SelectionOption("kineticist/element/water")])),
                (key: "kineticist/wild-talents/tremor-sense", name: "Tremor Sense", summary: "Blindsight out to 30'.", guide: "kineticist#tremor-sense", prerequisite: All([ClassLevel(class: "kineticist", level: 12), SelectionOption("kineticist/element/earth")])),
            ],
        ),
    ],
    feat_lists: [
