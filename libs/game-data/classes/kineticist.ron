Class(
    key: "kineticist",
    blueprint: "42a455d9ec1ad924d889272429eb8391",
    name: "Kineticist",
    summary: "Hurls elemental blasts and takes Burn for extra power; Dex and Con based, 3/4 BAB, 6 HP a level, good Fortitude and Reflex, 2 skill points a level.",
    guide: "kineticist",
    skill_points: 2,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["mobility", "perception", "persuasion", "stealth", "use-magic-device"],
    features: [
        (key: "kineticist/burn", blueprint: "57e3577a0eb53294e9d7cc649d5239a3", name: "Burn", summary: "Accept Burn (up to 1 a round, rising to 6 at 18th) to power abilities; each point deals 1 nonlethal damage per level until rest, max level + Con mod.", guide: "kineticist#burn"),
        (key: "kineticist/composite-specialization", blueprint: "df8897708983d4846871ca72c4cbfc52", name: "Composite Specialization", summary: "At 16th level, composite blasts cost 1 less Burn.", guide: "kineticist#composite-specialization"),
        (key: "kineticist/element/air/enveloping-winds", blueprint: "bb0de2047c448bd46aff120be3b39b7a", name: "Enveloping Winds", summary: "Ranged attacks against you get a 20% miss chance, +5% per five levels past 2nd; each Burn accepted adds another 5%.", guide: "kineticist#enveloping-winds"),
        (key: "kineticist/element/earth/flesh-of-stone", blueprint: "a275b35f282601944a97e694f6bc79f8", name: "Flesh of Stone", summary: "DR 1/adamantine, +1 per two levels past 2nd (DR 10 at 20th); each Burn accepted adds 1 more DR.", guide: "kineticist#flesh-of-stone"),
        (key: "kineticist/element/fire/searing-flesh", blueprint: "8ad77685e64842c45a6f5b19f9086c6c", name: "Searing Flesh", summary: "Creatures hitting you with unarmed or natural attacks take 1 fire damage per four levels, multiplied by any Burn you accept.", guide: "kineticist#searing-flesh"),
        (key: "kineticist/element/water/shroud-of-water", blueprint: "29ec36fa2a5b8b94ebce170bd369083a", name: "Shroud of Water", summary: "Choose a +4 armour or +2 shield bonus to AC, +1 per four levels past 2nd; each Burn accepted adds 1 more.", guide: "kineticist#shroud-of-water"),
        (key: "kineticist/elemental-overflow", blueprint: "2496916d8465dbb4b9ddeafdf28c67d8", name: "Elemental Overflow", summary: "From 3rd level, blasts gain +1 attack per Burn (max +1 per 3 levels) and twice that to damage; at high Burn, bonuses to physical scores.", guide: "kineticist#elemental-overflow"),
        (key: "kineticist/gather-power", blueprint: "71f526b1d4b50b94582b0b9cbe12b0e0", name: "Gather Power", summary: "A move action cuts a blast's Burn cost by 1, a full round by 2, and a full round plus a move action by 3.", guide: "kineticist#gather-power"),
        (key: "kineticist/infusion", blueprint: "58d6f8e9eea63f6418b107ce64f315ea", name: "Infusion", summary: "Learn infusions, with new ones at 3rd, 5th, 9th, 11th, 13th, 17th and 19th; a blast can take one form and one substance infusion.", guide: "kineticist#infusion"),
        (key: "kineticist/infusion-specialization", blueprint: "5f64f446aef387d499a396b626d5fc51", name: "Infusion Specialization", summary: "From 5th level, the combined Burn cost of infusions drops by 1, and by 1 more at 8th, 11th, 14th, 17th and 20th.", guide: "kineticist#infusion-specialization"),
        (key: "kineticist/kinetic-blast", blueprint: "30a5b8cf728bd4a4d8d90fc4953e322e", name: "Kinetic Blast", summary: "Standard-action blast to 30': physical 1d6+1+Con (+1d6+1 per odd level), energy 1d6+half Con vs touch AC (+1d6 per odd level); composites double.", guide: "kineticist#kinetic-blast"),
        (key: "kineticist/metakinesis-empowered", blueprint: "70322f5a2a294e54a9552f77ee85b0a7", name: "Metakinesis - Empowered", summary: "From 5th level, accept 1 extra Burn to empower a blast as with the Empower metamagic.", guide: "kineticist"),
        (key: "kineticist/metakinesis-maximized", blueprint: "0306bc7c6930a5c4b879c7dea78208c2", name: "Metakinesis - Maximized", summary: "From 9th level, accept 2 extra Burn to maximize a blast as with the Maximize metamagic.", guide: "kineticist"),
        (key: "kineticist/metakinesis-quicken", blueprint: "4bb9d2328a3fdca419243d6116b337ac", name: "Metakinesis - Quicken", summary: "From 13th level, accept 3 extra Burn to quicken a blast as with the Quicken metamagic.", guide: "kineticist"),
        (key: "kineticist/metakinetic-master", blueprint: "8c33002186eb2fd45a140eed1301e207", name: "Metakinetic Master", summary: "At 19th level, one chosen Metakinesis costs 1 less Burn.", guide: "kineticist#metakinetic-master"),
        (key: "kineticist/supercharge", blueprint: "5a13756fb4be25f46951bc3f16448276", name: "Supercharge", summary: "From 11th level, Gather Power cuts Burn by 2 as a move action and by 3 as a full round.", guide: "kineticist#supercharge"),
        (key: "kineticist/wild-talents/expanded-defense/defense", blueprint: "d741f298dfae8fc40b4615aaf83b6548", name: "Expanded Defense", summary: "Unlocks the Defensive Wild Talent of an element gained through Expanded Element.", guide: "kineticist#expanded-defense", option_row: (selection: "kineticist/expanded-element", level: 2)),
    ],
    selections: [
        (
            key: "kineticist/element",
            blueprint: "1f3a15a3ae8a5524ab8b97f469bf4e3d",
            name: "Elemental Focus",
            summary: "Choose the element your powers draw on; it sets your blasts, extra class skills, bonus feat list and defensive wild talent.",
            guide: "kineticist#elemental-focus",
            option_levels: ["kineticist"],
            options: [
                (
                    key: "kineticist/element/air",
                    blueprint: "2bd0d44953a536f489082534c48f8e31",
                    name: "Elemental Focus - Air",
                    summary: "Air: Lore (Nature) as a class skill, mobility and reflex bonus feats, and the Enveloping Winds defense.",
                    guide: "kineticist#elemental-focus-air",
                    repeat: Times(2),
                    levels: [
                        (level: 1, feat_list: "kineticist/element/air/wild-talent-feats", class_skills: ["lore-nature"]),
                        (level: 2, features: ["kineticist/element/air/enveloping-winds"]),
                    ],
                ),
                (
                    key: "kineticist/element/earth",
                    blueprint: "c6816ad80a3df9c4ea7d3b012b06bacd",
                    name: "Elemental Focus - Earth",
                    summary: "Earth: Athletics and Knowledge (World) as class skills, toughness and trip bonus feats, and the Flesh of Stone defense.",
                    guide: "kineticist#elemental-focus-earth",
                    repeat: Times(2),
                    levels: [
                        (level: 1, feat_list: "kineticist/element/earth/wild-talent-feats", class_skills: ["athletics", "knowledge-world"]),
                        (level: 2, features: ["kineticist/element/earth/flesh-of-stone"]),
                    ],
                ),
                (
                    key: "kineticist/element/fire",
                    blueprint: "3d8d3d6678b901444a07984294a1bc24",
                    name: "Elemental Focus - Fire",
                    summary: "Fire: Lore (Nature) as a class skill, intimidation and will bonus feats, and the Searing Flesh defense.",
                    guide: "kineticist#elemental-focus-fire",
                    repeat: Times(2),
                    levels: [
                        (level: 1, feat_list: "kineticist/element/fire/wild-talent-feats", class_skills: ["lore-nature"]),
                        (level: 2, features: ["kineticist/element/fire/searing-flesh"]),
                    ],
                ),
                (
                    key: "kineticist/element/water",
                    blueprint: "7ab8947ce2e19c44a9edcf5fd1466686",
                    name: "Elemental Focus - Water",
                    summary: "Water: Athletics and Lore (Nature) as class skills, blind-fight and bull rush bonus feats, and the Shroud of Water defense.",
                    guide: "kineticist#elemental-focus-water",
                    repeat: Times(2),
                    levels: [
                        (level: 1, feat_list: "kineticist/element/water/wild-talent-feats", class_skills: ["athletics", "lore-nature"]),
                        (level: 2, features: ["kineticist/element/water/shroud-of-water"]),
                    ],
                ),
            ],
        ),
        (
            key: "kineticist/expanded-element",
            blueprint: "4204bc10b3d5db440b1f52f0c375848b",
            name: "Expanded Element",
            summary: "At 7th level pick a second element or deepen your first, gaining its blasts and composites; at 15th pick a third or deepen again.",
            guide: "kineticist#expanded-element",
            option_levels: ["kineticist"],
            feat_lists_only: true,
            once_per_option: true,
            options: [],
            shared_options: [
                "kineticist/element/air",
                "kineticist/element/earth",
                "kineticist/element/fire",
                "kineticist/element/water",
            ],
        ),
        (
            key: "kineticist/infusions",
            blueprint: "58d6f8e9eea63f6418b107ce64f315ea",
            name: "Infusion",
            summary: "Pick an infusion you qualify for; a blast can carry one form and one substance infusion.",
            guide: "kineticist#infusion",
            options: [
                (key: "kineticist/infusions/blade-whirlwind", blueprint: "80fdf049d396c33408a805d9e21a42e1", name: "Blade Whirlwind", summary: "Form, 3 Burn: conjure a kinetic blade and make one attack against every foe in reach.", guide: "kineticist#blade-whirlwind", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 10), SelectionOption("kineticist/infusions/kinetic-blade")])),
                (key: "kineticist/infusions/bowling-infusion", blueprint: "b3bd080eed83a9940abd97e4aa2a7341", name: "Bowling Infusion", summary: "Substance, 2 Burn, earth blasts: trip each target the blast damages, using your Con modifier for the combat maneuver.", guide: "kineticist#bowling-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 4), SelectionOption("kineticist/element/earth")])),
                (key: "kineticist/infusions/burning-infusion", blueprint: "228ec37705a5e5240be3ff5622c4476f", name: "Burning Infusion", summary: "Substance, 1 Burn, fire blasts: a target hit past SR catches fire for 1d6 a round until put out (Reflex negates).", guide: "kineticist#burning-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/chain-arrows", blueprint: "0ff81c5691c64c4aa8b2ecc35c885901", name: "Chain Arrows", summary: "Sharpshooter form, 6 Burn: the shot jumps up to 10' between enemies, hitting up to half your level in targets (Reflex half).", guide: "kineticist#chain-arrows", prerequisite: All([ClassLevel(class: "kineticist", level: 16), Archetype("kineticist/kinetic-sharpshooter")])),
                (key: "kineticist/infusions/chilling-infusion", blueprint: "6ac87a3af9ccf014787c49745df75e6a", name: "Chilling Infusion", summary: "Substance, 3 Burn, cold blasts: a foe dealt cold damage is staggered for 1 round (Fortitude negates).", guide: "kineticist#chilling-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 10), SelectionOption("kineticist/element/water")])),
                (key: "kineticist/infusions/cloud", blueprint: "3c53ee4965a13d74e81b37ae34f0861b", name: "Cloud", summary: "Form, 4 Burn: a 20' cloud up to 50' away lasts Con mod rounds and deals half blast damage to anyone entering or ending a turn in it.", guide: "kineticist#cloud", prerequisite: All([Any([SelectionOption("kineticist/element/air"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 14), SelectionOption("kineticist/infusions/extended-range")])),
                (key: "kineticist/infusions/cyclone", blueprint: "f2fa7541f18b8af4896fbaf9f2a21dfe", name: "Cyclone", summary: "Form, 3 Burn, air blasts: everything in a 20' radius takes half blast damage (Reflex half).", guide: "kineticist#cyclone", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/infusions/dazzling-infusion", blueprint: "037460f7ae3e21943b237007f2b1a5d5", name: "Dazzling Infusion", summary: "Substance, 1 Burn, fire blasts: a target hit past SR is dazzled for 1 minute (Will negates).", guide: "kineticist#dazziing-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/deadly-earth", blueprint: "061f5d7e659432b478668b70f6d4caae", name: "Deadly Earth", summary: "Form, 4 Burn: a 20' patch up to 50' away becomes difficult terrain for Con mod rounds, dealing half blast damage to those in it.", guide: "kineticist#deadly-earth", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 12), SelectionOption("kineticist/element/earth"), SelectionOption("kineticist/infusions/extended-range")])),
                (key: "kineticist/infusions/detonation", blueprint: "77c24cc95ce319c44a0e5fc6ff466d5b", name: "Detonation", summary: "Form, 3 Burn, fire blasts: every creature in a 20' radius takes full blast damage (Reflex half).", guide: "kineticist#detonation", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/entangling-infusion", blueprint: "607539d018d03454aaac0a2c1522f7ac", name: "Entangling Infusion", summary: "Substance, 2 Burn, earth or water: a damaged foe is entangled for 1 minute, and rooted if it fails a second save (Reflex negates).", guide: "kineticist#entangling-infusion", prerequisite: All([Any([SelectionOption("kineticist/element/earth"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 4)])),
                (key: "kineticist/infusions/eruption", blueprint: "00f8e4b846c367141afcd133f4a1c816", name: "Eruption", summary: "Form, 3 Burn, fire blasts: a 10' radius burst up to 50' away; full damage for energy blasts, half for physical (Reflex half).", guide: "kineticist#eruption", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/infusions/extended-range")])),
                (key: "kineticist/infusions/exploding-arrows", blueprint: "7c8ded7015114e4086b3dbdd16388b29", name: "Exploding Arrows", summary: "Sharpshooter form, 2 Burn: creatures within 5' of the target take half blast damage (Reflex half).", guide: "kineticist#exploding-arrows", prerequisite: All([ClassLevel(class: "kineticist", level: 2), Archetype("kineticist/kinetic-sharpshooter")])),
                (key: "kineticist/infusions/extended-range", blueprint: "cb2d9e6355dd33940b2bef49e544b0bf", name: "Extended Range", summary: "Form, 1 Burn: the blast reaches any target within 50'.", guide: "kineticist#extended-range", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/infusions/fan-of-flames", blueprint: "fde466d2c24705641bcd97d04a323566", name: "Fan of Flames", summary: "Form, 1 Burn, fire blasts: the blast fills a 15' cone (Reflex half).", guide: "kineticist#fan-of-flames", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/flash-infusion", blueprint: "37f3cfca29073e142a80c3b8e7c54b05", name: "Flash Infusion", summary: "Substance, 3 Burn, fire blasts: a target hit past SR is blinded for 1 round (Will negates).", guide: "kineticist#flash-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/foxfire-infusion", blueprint: "ae21c5369252ec74aa1fee89f1bc1b21", name: "Foxfire Infusion", summary: "Substance, 2 Burn, fire blasts: the target gets Faerie Fire for 1 minute, or until your next turn on a save.", guide: "kineticist#foxfire-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/wild-talents/foxfire")])),
                (key: "kineticist/infusions/fragmentation", blueprint: "88ae936abf296894695a282f49214718", name: "Fragmentation", summary: "Form, 4 Burn: hit a target within 50' for full damage; creatures within 20' of it take half (Reflex for half again).", guide: "kineticist#fragmentation", prerequisite: All([Any([SelectionOption("kineticist/element/earth"), SelectionOption("kineticist/element/water")]), Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 14), SelectionOption("kineticist/infusions/extended-range")])),
                (key: "kineticist/infusions/grappling-infusion", blueprint: "e2d70b95e80549b439d30df29a79cb58", name: "Grappling Infusion", summary: "Substance, 3 Burn: foes in your Cloud, Deadly Earth or Wall must make a Reflex save or be grappled.", guide: "kineticist#grappling-infusion", prerequisite: All([Any([SelectionOption("kineticist/infusions/cloud"), SelectionOption("kineticist/infusions/deadly-earth"), SelectionOption("kineticist/infusions/wall")]), ClassLevel(class: "kineticist", level: 10)])),
                (key: "kineticist/infusions/honed-infusion", blueprint: "cf531860c9fb44c09bda9d8904657314", name: "Honed Infusion", summary: "Sharpshooter substance, 3 Burn: the blast ignores damage reduction.", guide: "kineticist#honed-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 12), Archetype("kineticist/kinetic-sharpshooter")])),
                (key: "kineticist/infusions/kinetic-blade", blueprint: "9ff81732daddb174aa8138ad1297c787", name: "Kinetic Blade", summary: "Form, 1 Burn: a light one-handed blade dealing blast damage per hit, usable in full attacks and charges; no Str or Overflow damage.", guide: "kineticist#kinetic-blade", prerequisite: All([Not(Archetype("kineticist/kinetic-sharpshooter")), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/infusions/magnetic-infusion", blueprint: "d6b95ac99e3004b499d750835864e053", name: "Magnetic Infusion", summary: "Substance, 2 Burn: attacks with metal weapons get +4 against the target until the end of your next turn.", guide: "kineticist#magnetic-infusion", prerequisite: All([Any([SelectionOption("kineticist/element/air"), SelectionOption("kineticist/element/earth")]), ClassLevel(class: "kineticist", level: 4)])),
                (key: "kineticist/infusions/pure-flame-infusion", blueprint: "1dfd9b8e1439e4a4ab4b6b11f5ea676a", name: "Pure-Flame Infusion", summary: "Substance, 4 Burn, blue flame blasts: the blast ignores spell resistance.", guide: "kineticist#pure-flame-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 14), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/pushing-infusion", blueprint: "fbb97f35a41b71c4cbc36c5f3995b892", name: "Pushing Infusion", summary: "Substance, 1 Burn: bull rush each target the blast damages, using your Con modifier for the combat maneuver.", guide: "kineticist#pushing-infusion", prerequisite: All([Any([SelectionOption("kineticist/element/air"), SelectionOption("kineticist/element/earth"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/infusions/rare-metal-infusion", blueprint: "6700ce7f56ddc30488e45b049f4ee475", name: "Rare-Metal Infusion", summary: "Substance, 2 Burn, metal blasts: the blast bypasses DR as adamantine, cold iron or silver.", guide: "kineticist#rare-metal-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/earth")])),
                (key: "kineticist/infusions/rending-arrows", blueprint: "8896ac251d394dceaf650793aa85e177", name: "Rending Arrows", summary: "Sharpshooter substance, 3 Burn: each hit gives the target -2 AC, stacking to -10.", guide: "kineticist#rending-arrows", prerequisite: All([ClassLevel(class: "kineticist", level: 10), Archetype("kineticist/kinetic-sharpshooter")])),
                (key: "kineticist/infusions/spindle", blueprint: "c4f4a62a325f7c14dbcace3ce34782b5", name: "Spindle", summary: "Form, 2 Burn: a spindle up to 30' hits creatures in two adjacent squares; full damage for energy, half for physical (Reflex negates).", guide: "kineticist#spindle", prerequisite: ClassLevel(class: "kineticist", level: 4)),
                (key: "kineticist/infusions/spray", blueprint: "b5852e8287f12d34ca6f84fcc7019f07", name: "Spray", summary: "Form, 3 Burn, water blasts: everything in a 30' cone takes half blast damage (Reflex half).", guide: "kineticist#spray", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/water")])),
                (key: "kineticist/infusions/synaptic-infusion", blueprint: "53c80f136f2bf65409d358f28b0c5bb4", name: "Synaptic Infusion", summary: "Substance, 2 Burn, electric blasts: the target is staggered for 1 round (Will negates).", guide: "kineticist#synaptic-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/infusions/torrent", blueprint: "2aad85320d0751340a0786de073ee3d5", name: "Torrent", summary: "Form, 2 Burn: the blast hits foes in a 30' line; full damage for energy, half for physical (Reflex half).", guide: "kineticist#torrent", prerequisite: All([Any([SelectionOption("kineticist/element/air"), SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 6)])),
                (key: "kineticist/infusions/unraveling-infusion", blueprint: "79339d57d491d824ba0aa4ed0c114b2f", name: "Unraveling Infusion", summary: "Substance, 3 Burn, fire blasts: a target hit past SR is subject to Dispel Magic.", guide: "kineticist#unraveling-infusion", prerequisite: All([ClassLevel(class: "kineticist", level: 10), SelectionOption("kineticist/element/fire")])),
                (key: "kineticist/infusions/wall", blueprint: "c684335918896ce4ab13e96cec929796", name: "Wall", summary: "Form, 3 Burn: a wall lasting Con mod rounds deals blast damage (half for physical) to any creature crossing it.", guide: "kineticist#wall", prerequisite: ClassLevel(class: "kineticist", level: 10)),
            ],
        ),
        (
            key: "kineticist/wild-talents",
            blueprint: "5c883ae0cd6d7d5448b7a420f51f8459",
            name: "Wild Talents",
            summary: "Pick a utility wild talent at 2nd level and every even level after.",
            guide: "kineticist#wild-talents",
            option_levels: ["kineticist"],
            options: [
                (key: "kineticist/wild-talents/aerial-adaptation", blueprint: "c8719b3c5c0d4694cb13abcc3b7e893b", name: "Aerial Adaptation", summary: "Electricity resistance equal to twice your current Burn.", guide: "kineticist#aerial-adaptation", prerequisite: All([ClassLevel(class: "kineticist", level: 2), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/wild-talents/aerial-evasion", blueprint: "871e6b0bb9d050743b98b78990ae1cff", name: "Aerial Evasion", summary: "1 Burn: gain Evasion.", guide: "kineticist#aerial-evasion", prerequisite: All([ClassLevel(class: "kineticist", level: 6), Feature(feature: "kineticist/element/air/enveloping-winds", count: 1), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/wild-talents/celerity", blueprint: "b182f559f572da342b54bece4404e4e7", name: "Celerity", summary: "Haste yourself for 1 round, or for rounds equal to your level by accepting 1 Burn.", guide: "kineticist#celerity", prerequisite: All([ClassLevel(class: "kineticist", level: 6), SelectionOption("kineticist/element/air")])),
                (key: "kineticist/wild-talents/cold-adaptation", blueprint: "1ff5d6e76b7c2fa48be555b77d1ad8b2", name: "Cold Adaptation", summary: "Cold resistance equal to twice your current Burn.", guide: "kineticist#cold-adaptation", prerequisite: All([Any([SelectionOption("kineticist/element/fire"), SelectionOption("kineticist/element/water")]), ClassLevel(class: "kineticist", level: 2)])),
                (key: "kineticist/wild-talents/elemental-whispers", blueprint: "f02525006521bee4eb90ab26b7b9db24", name: "Elemental Whispers", summary: "Gain a familiar.", guide: "kineticist#elemental-whispers", prerequisite: ClassLevel(class: "kineticist", level: 2)),
                (key: "kineticist/wild-talents/enduring-earth", blueprint: "14359e9c35a42ee48b8c31b4424a8d3f", name: "Enduring Earth", summary: "Effect durations of your earth blasts, composite earth blasts and wild talents are doubled.", guide: "kineticist#enduring-earth", prerequisite: All([ClassLevel(class: "kineticist", level: 8), SelectionOption("kineticist/element/earth")])),
                (
                    key: "kineticist/wild-talents/expanded-defense",
                    blueprint: "d741f298dfae8fc40b4615aaf83b6548",
                    name: "Expanded Defense",
