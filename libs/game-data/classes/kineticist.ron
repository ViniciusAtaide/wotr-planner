            name: "Blood Kineticist",
            summary: "Water-only kineticist (Water at 1st and 7th, Water blast at 1st) with its own blood infusions such as Wrack, Bleeding and Vampiric.",
            guide: "kineticist#blood-kineticist",
            features: [
                (key: "kineticist/blood-kineticist/bleeding-infusion", blueprint: "f098e5f724c78f141a42190f798b2669", name: "Bleeding Infusion", summary: "Substance, 2 Burn: on a failed Fortitude save the target bleeds 1 per blast damage die.", guide: "kineticist#bleeding-infusion"),
                (key: "kineticist/blood-kineticist/blood-blast", blueprint: "c347c1e4f8a30494ba83a29e76cbca0e", name: "Blood Blast", summary: "At 7th level, takes Water again and gains the Charged Water composite blast; the described Blood Blast itself isn't in the game.", guide: "kineticist#blood-blast"),
                (key: "kineticist/blood-kineticist/blood-mastery", blueprint: "a8edc0359317f33468655af6bc40369d", name: "Blood Mastery", summary: "At 20th level, immune to bleed, poison, disease, sickened and nauseated.", guide: "kineticist#blood-mastery"),
                (key: "kineticist/blood-kineticist/gut-wrenching-infusion", blueprint: "c50f50ca3a079f84682da8e91baa9e87", name: "Gut-Wrenching Infusion", summary: "Substance, 3 Burn: on a failed Fortitude save the target is sickened for 1 minute.", guide: "kineticist#gut-wrenching-infusion"),
                (key: "kineticist/blood-kineticist/metakinesis-empowered", blueprint: "70322f5a2a294e54a9552f77ee85b0a7", name: "Metakinesis - Empowered", summary: "From 5th level, accept 1 extra Burn to empower a blast as with the Empower metamagic.", guide: "kineticist#blood-kineticist"),
                (key: "kineticist/blood-kineticist/metakinesis-maximized", blueprint: "0306bc7c6930a5c4b879c7dea78208c2", name: "Metakinesis - Maximized", summary: "From 9th level, accept 2 extra Burn to maximize a blast as with the Maximize metamagic.", guide: "kineticist#blood-kineticist"),
                (key: "kineticist/blood-kineticist/metakinesis-quicken", blueprint: "4bb9d2328a3fdca419243d6116b337ac", name: "Metakinesis - Quicken", summary: "From 13th level, accept 3 extra Burn to quicken a blast as with the Quicken metamagic.", guide: "kineticist#blood-kineticist"),
                (key: "kineticist/blood-kineticist/vampiric-infusion", blueprint: "4f8962781c26a864b97ea9a2b208046d", name: "Vampiric Infusion", summary: "Substance, 3 Burn: when the blast hits, you can use Kinetic Healer without paying its Burn.", guide: "kineticist#vampiric-infusion"),
