                (key: "kineticist/dark-elementalist/metakinesis-maximized", name: "Metakinesis - Maximized", summary: "From 9th level, accept 2 extra Burn to maximize a blast as with the Maximize metamagic.", guide: "kineticist#dark-elementalist"),
