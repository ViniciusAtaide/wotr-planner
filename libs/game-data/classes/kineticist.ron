            features: [
                (key: "kineticist/elemental-engine/burnout", name: "Burnout", summary: "From 3rd level, +1 attack per Burn (max +1 per 3 levels) and double that to damage; doubled at max Burn, where Gather Power cuts 1 more.", guide: "kineticist#burnout"),
                (key: "kineticist/elemental-engine/elemental-burnout", name: "Elemental Burnout", summary: "From 7th level at max Burn: +2 saves against your element's spells, plus an element perk such as +20 speed for Fire.", guide: "kineticist#elemental-burnout"),
                (key: "kineticist/elemental-engine/greater-elemental-burnout", name: "Greater Elemental Burnout", summary: "From 13th level at max Burn: more element perks, such as Freedom of Movement for Air or Haste for Fire.", guide: "kineticist#greater-elemental-burnout"),
                (key: "kineticist/elemental-engine/metakinesis-empowered", name: "Metakinesis - Empowered", summary: "From 5th level, accept 1 extra Burn to empower a blast as with the Empower metamagic.", guide: "kineticist#elemental-engine"),
