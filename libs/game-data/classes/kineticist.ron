    archetypes: [
        (
            key: "kineticist/blood-kineticist",
            name: "Blood Kineticist",
            summary: "Water-only kineticist (Water at 1st and 7th, Water blast at 1st) with its own blood infusions such as Wrack, Bleeding and Vampiric.",
            guide: "kineticist#blood-kineticist",
            features: [
                (key: "kineticist/blood-kineticist/bleeding-infusion", name: "Bleeding Infusion", summary: "Substance, 2 Burn: on a failed Fortitude save the target bleeds 1 per blast damage die.", guide: "kineticist#bleeding-infusion"),
                (key: "kineticist/blood-kineticist/blood-blast", name: "Blood Blast", summary: "At 7th level, takes Water again and gains the Charged Water composite blast; the described Blood Blast itself isn't in the game.", guide: "kineticist#blood-blast"),
                (key: "kineticist/blood-kineticist/blood-mastery", name: "Blood Mastery", summary: "At 20th level, immune to bleed, poison, disease, sickened and nauseated.", guide: "kineticist#blood-mastery"),
                (key: "kineticist/blood-kineticist/gut-wrenching-infusion", name: "Gut-Wrenching Infusion", summary: "Substance, 3 Burn: on a failed Fortitude save the target is sickened for 1 minute.", guide: "kineticist#gut-wrenching-infusion"),
                (key: "kineticist/blood-kineticist/metakinesis-empowered", name: "Metakinesis - Empowered", summary: "From 5th level, accept 1 extra Burn to empower a blast as with the Empower metamagic.", guide: "kineticist#blood-kineticist"),
                (key: "kineticist/blood-kineticist/metakinesis-maximized", name: "Metakinesis - Maximized", summary: "From 9th level, accept 2 extra Burn to maximize a blast as with the Maximize metamagic.", guide: "kineticist#blood-kineticist"),
                (key: "kineticist/blood-kineticist/metakinesis-quicken", name: "Metakinesis - Quicken", summary: "From 13th level, accept 3 extra Burn to quicken a blast as with the Quicken metamagic.", guide: "kineticist#blood-kineticist"),
                (key: "kineticist/blood-kineticist/vampiric-infusion", name: "Vampiric Infusion", summary: "Substance, 3 Burn: when the blast hits, you can use Kinetic Healer without paying its Burn.", guide: "kineticist#vampiric-infusion"),
                (key: "kineticist/blood-kineticist/wrack", name: "Wrack", summary: "Form, 0 Burn: the target takes half blast damage, a quarter on a Fortitude save, as untyped damage that ignores DR and resistances.", guide: "kineticist#wrack"),
            ],
            selections: [
                (
                    key: "kineticist/blood-kineticist/element",
                    name: "Elemental Focus (Blood Kineticist)",
                    summary: "The Blood Kineticist must take Water as her element, and only the Water blast at 1st level.",
                    guide: "kineticist#blood-kineticist",
                    option_levels: ["kineticist"],
                    options: [],
                    shared_options: [
