Class(
    key: "rogue",
    name: "Rogue",
    summary: "Dexterity skill expert: 3/4 BAB, good Reflex, 5 skill points per level, sneak attack and rogue talents.",
    guide: "rogue",
    skill_points: 5,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["athletics", "knowledge-world", "mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
    features: [
        (key: "rogue/advanced-talents", name: "Advanced Talents", summary: "From 10th level, can choose advanced rogue talents.", guide: "rogue#advanced-rogue-talents"),
        (key: "rogue/danger-sense", name: "Danger Sense", summary: "From 3rd level, +1 to Reflex and dodge AC against traps and to Perception against surprise, +1 every 3 levels (max +6).", guide: "rogue#danger-sense"),
        (key: "rogue/debilitating-injury", name: "Debilitating Injury", summary: "From 4th level, a sneak attack also bewilders (-2 AC, worse vs you), disorients (-2 attack, worse vs you) or halves speed for 1 round.", guide: "rogue#debilitating-injury"),
        (key: "rogue/evasion", name: "Evasion", summary: "From 2nd level, a successful Reflex save against a half-damage effect means no damage.", guide: "rogue#evasion"),
        (key: "rogue/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "From 8th level, you cannot be flanked; rogues need 4 more rogue levels than you to sneak attack you.", guide: "rogue#improved-uncanny-dodge"),
        (key: "rogue/master-strike", name: "Master Strike", summary: "At 20th level, a sneak attack can kill outright on a failed Fort save (DC 20 + Dex); a target that saves becomes immune.", guide: "rogue#master-strike"),
        (key: "rogue/rogue-proficiencies", name: "Rogue Proficiencies", summary: "Simple weapons, rapier, short sword, short bow and light armour; no shields.", guide: "rogue#rogue-proficiencies"),
        (key: "rogue/sneak-attack", name: "Sneak Attack", summary: "+1d6 damage against flanked foes or those denied Dexterity to AC, +1d6 more every odd class level.", guide: "rogue#sneak-attack"),
        (key: "rogue/trapfinding", name: "Trapfinding", summary: "Adds half the class level to Perception checks.", guide: "rogue#trapfinding"),
        (key: "rogue/uncanny-dodge", name: "Uncanny Dodge", summary: "From 4th level, you are never caught flat-footed and keep your Dexterity bonus to AC against invisible attackers.", guide: "rogue#uncanny-dodge"),
    ],
    selections: [
        (
            key: "rogue/finesse-training",
            name: "Finesse Training",
            summary: "From 3rd level, adds Dexterity instead of Strength to damage with one chosen finessable weapon; a second at 11th, a third at 19th.",
            guide: "rogue#finesse-training",
            options: [
                (
                    key: "rogue/finesse-training/weapon",
                    name: "Finesse Training",
                    summary: "Adds Dexterity instead of Strength to damage with the chosen finessable weapon.",
                    guide: "rogue#finesse-training",
                    parameter: Weapon,
                    // The guide's list: "The weapons selectable are: Bite, Claw, Dagger, …, Starknife, Unarmed."
                    values: [
                        Weapon("bite"),
                        Weapon("claw"),
                        Weapon("dagger"),
                        Weapon("dueling-sword"),
                        Weapon("elven-curve-blade"),
                        Weapon("estoc"),
                        Weapon("hand-axe"),
                        Weapon("kama"),
                        Weapon("kukri"),
                        Weapon("light-hammer"),
                        Weapon("light-mace"),
                        Weapon("light-pick"),
                        Weapon("light-shield-bash"),
                        Weapon("nunchaku"),
                        Weapon("punching-dagger"),
                        Weapon("rapier"),
                        Weapon("sai"),
                        Weapon("short-sword"),
                        Weapon("sickle"),
                        Weapon("starknife"),
                        Weapon("unarmed-strike"),
                    ],
                    repeat: PerValue,
                ),
            ],
        ),
        (
            key: "rogue/rogue-talents",
            name: "Rogue Talents",
            summary: "A rogue talent from the class list; an Eldritch Scoundrel can also take (Improved) Uncanny Dodge.",
            guide: "rogue#rogue-talents",
            option_levels: ["bard", "rogue", "skald"],
            options: [
                (key: "rogue/rogue-talents/blinding-strike", name: "Blinding Strike", summary: "Requires character level 15: gains Blinding Critical as a bonus feat.", guide: "rogue#blinding-strike", feats: ["blinding-critical"], prerequisite: All([Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)]), CharacterLevel(15)])),
                (key: "rogue/rogue-talents/canny-observer", name: "Canny Observer", summary: "+4 to Perception checks.", guide: "rogue#canny-observer"),
                (
                    key: "rogue/rogue-talents/combat-trick",
                    name: "Combat Trick",
                    summary: "A bonus combat feat you qualify for.",
                    guide: "rogue#combat-trick",
                    repeat: Unlimited,
                    levels: [
                        (level: 1, feat_slots: [CombatFeat]),
                    ],
                ),
                (key: "rogue/rogue-talents/confounding-blades", name: "Confounding Blades", summary: "A melee sneak attack stops the target making attacks of opportunity for 2 to 5 rounds.", guide: "rogue#confounding-blades", prerequisite: All([Any([Feature(feature: "alchemist/vivisectionist/advanced-talents", count: 1), Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)]), SelectionOption("rogue/rogue-talents/slow-reactions")])),
                (key: "rogue/rogue-talents/crippling-strike", name: "Crippling Strike", summary: "Sneak attacks deal 2 Strength damage.", guide: "rogue#crippling-strike", prerequisite: Any([Feature(feature: "alchemist/vivisectionist/advanced-talents", count: 1), Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/dispelling-attack", name: "Dispelling Attack", summary: "Your sneak attacks also dispel one active spell on the target, using your character level as the caster level.", guide: "rogue#dispelling-attack", prerequisite: Any([Feature(feature: "alchemist/vivisectionist/advanced-talents", count: 1), Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/double-debilitation", name: "Double Debilitation", summary: "Debilitating Injury applies two penalties at once.", guide: "rogue#double-debilitation", prerequisite: All([Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)]), Feature(feature: "rogue/debilitating-injury", count: 1)])),
                (key: "rogue/rogue-talents/emboldening-strike", name: "Emboldening Strike", summary: "A sneak attack gives +1 to saving throws per 2 sneak dice rolled, for 1 round.", guide: "rogue#emboldening-strike"),
                (key: "rogue/rogue-talents/familiar", name: "Familiar", summary: "Gains a familiar, as a Wizard's arcane bond.", guide: "rogue#familiar", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/fast-stealth", name: "Fast Stealth", summary: "Moves at full speed while using Stealth.", guide: "rogue#fast-stealth"),
                (key: "rogue/rogue-talents/focusing-attack-confused", name: "Focusing Attack - Confused", summary: "Dealing sneak attack damage ends your own confusion.", guide: "rogue#focusing-attack-confused"),
                (key: "rogue/rogue-talents/focusing-attack-shaken", name: "Focusing Attack - Shaken", summary: "Dealing sneak attack damage ends your own shaken condition.", guide: "rogue#focusing-attack-shaken"),
                (key: "rogue/rogue-talents/focusing-attack-sickened", name: "Focusing Attack - Sickened", summary: "Dealing sneak attack damage ends your own sickened condition.", guide: "rogue#focusing-attack-sickened"),
                (key: "rogue/rogue-talents/hunters-surprise", name: "Hunter\'s Surprise", summary: "Once a day, your attacks against one adjacent enemy add sneak attack damage until the end of your next turn.", guide: "rogue#hunters-surprise", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/improved-evasion", name: "Improved Evasion", summary: "A successful Reflex save means no damage, and a failed one only half damage.", guide: "rogue#improved-evasion", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                // "An Eldritch Scoundrel can select (Improved) Uncanny Dodge as Rogue Talents" (ticket 190). The Improved one
                // needing Uncanny Dodge first is provisional: the guide doesn't say, the user confirms.
                (key: "rogue/rogue-talents/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Eldritch Scoundrel only, after Uncanny Dodge: you cannot be flanked; rogues need 4 more rogue levels than you to sneak attack you.", guide: "rogue#rogue-talents", prerequisite: All([Archetype("rogue/eldritch-scoundrel"), Feature(feature: "rogue/uncanny-dodge", count: 1)]), levels: [(level: 1, features: ["rogue/improved-uncanny-dodge"])]),
                (key: "rogue/rogue-talents/intimidating-prowess", name: "Intimidating Prowess", summary: "Gains the Intimidating Prowess feat.", guide: "rogue#intimidating-prowess", feats: ["intimidating-prowess"]),
                (key: "rogue/rogue-talents/iron-guts", name: "Iron Guts", summary: "+1 to saves against poison and +4 against sickening and nauseating effects.", guide: "rogue#iron-guts"),
                (key: "rogue/rogue-talents/jump-up", name: "Jump Up", summary: "Standing up from prone does not provoke attacks of opportunity.", guide: "rogue#jump-up"),
                (key: "rogue/rogue-talents/mystery-seeker", name: "Mystery Seeker", summary: "Knowledge (Arcana) becomes a class skill.", guide: "rogue#mystery-seeker"),
                (key: "rogue/rogue-talents/opportunist", name: "Opportunist", summary: "Once a round, an attack of opportunity against a foe another character has just hit.", guide: "rogue#opportunist", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/petrifying-strike", name: "Petrifying Strike", summary: "Sneak attacks deal 2 Dexterity damage.", guide: "rogue#petrifying-strike", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/skill-focus", name: "Skill Focus", summary: "Gains the Skill Focus feat.", guide: "rogue#skill-focus", chosen_feat: "skill-focus", repeat: PerValue),
                (key: "rogue/rogue-talents/skill-mastery-knowledge", name: "Skill Mastery (Knowledge)", summary: "Can take 10 on Knowledge (Arcana) and Knowledge (World) checks.", guide: "rogue#skill-mastery-knowledge", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/skill-mastery-lore", name: "Skill Mastery (Lore)", summary: "Can take 10 on Lore (Nature) and Lore (Religion) checks.", guide: "rogue#skill-mastery-lore", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/skill-mastery-stealth-and-trickery", name: "Skill Mastery (Stealth and Trickery)", summary: "Can take 10 on Stealth and Trickery checks.", guide: "rogue#skill-mastery-stealth-and-trickery", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/slippery-mind", name: "Slippery Mind", summary: "Adds your Dexterity modifier to saves against mind-affecting effects.", guide: "rogue#slippery-mind", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/slow-reactions", name: "Slow Reactions", summary: "Foes hit by your sneak attacks lose their attacks of opportunity for 1 round.", guide: "rogue#slow-reactions"),
                (key: "rogue/rogue-talents/survivalist", name: "Survivalist", summary: "Lore (Nature) becomes a class skill.", guide: "rogue#survivalist"),
                (key: "rogue/rogue-talents/terrain-mastery", name: "Terrain Mastery", summary: "A favoured terrain like the Ranger's, but its bonus does not grow with level.", guide: "rogue#terrain-mastery"),
                (key: "rogue/rogue-talents/trailblazer", name: "Trailblazer", summary: "Immune to difficult terrain.", guide: "rogue#trailblazer"),
                (key: "rogue/rogue-talents/unbalancing-trick", name: "Unbalancing Trick", summary: "Gains Trip as a bonus feat.", guide: "rogue#unbalancing-trick", feats: ["trip"]),
                (key: "rogue/rogue-talents/uncanny-dodge", name: "Uncanny Dodge", summary: "Eldritch Scoundrel only: you are never caught flat-footed and keep your Dexterity bonus to AC against invisible attackers.", guide: "rogue#rogue-talents", prerequisite: Archetype("rogue/eldritch-scoundrel"), levels: [(level: 1, features: ["rogue/uncanny-dodge"])]),
                (key: "rogue/rogue-talents/underhanded-trick", name: "Underhanded Trick", summary: "Gains Dirty Trick as a bonus feat.", guide: "rogue#underhanded-trick", feats: ["dirty-trick"]),
                (key: "rogue/rogue-talents/weakening-wound", name: "Weakening Wound", summary: "A sneak attack lowers the target's DR by your character level for 2 rounds.", guide: "rogue#weakening-wound"),
                (key: "rogue/rogue-talents/weapon-focus", name: "Weapon Focus", summary: "Gains the Weapon Focus feat.", guide: "rogue#weapon-focus", chosen_feat: "weapon-focus"),
                (key: "rogue/rogue-talents/weapon-snatcher", name: "Weapon Snatcher", summary: "Uses a Trickery check instead of a combat manoeuvre check to disarm.", guide: "rogue#weapon-snatcher", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/wearying-strike", name: "Wearying Strike", summary: "Sneak attacks deal 1 Constitution damage.", guide: "rogue#wearying-strike", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["rogue/rogue-proficiencies", "rogue/sneak-attack", "rogue/trapfinding"], feats: ["armor-proficiency-light-armor", "simple-weapon-proficiency", "weapon-finesse"]),
        (level: 2, features: ["rogue/evasion"], selections: ["rogue/rogue-talents"]),
        (level: 3, features: ["rogue/danger-sense", "rogue/sneak-attack"], selections: ["rogue/finesse-training"]),
        (level: 4, features: ["rogue/debilitating-injury", "rogue/uncanny-dodge"], selections: ["rogue/rogue-talents"]),
        (level: 5, features: ["rogue/sneak-attack"]),
        (level: 6, selections: ["rogue/rogue-talents"]),
        (level: 7, features: ["rogue/sneak-attack"]),
        (level: 8, features: ["rogue/improved-uncanny-dodge"], selections: ["rogue/rogue-talents"]),
        (level: 9, features: ["rogue/sneak-attack"]),
        (level: 10, features: ["rogue/advanced-talents"], selections: ["rogue/rogue-talents"]),
        (level: 11, features: ["rogue/sneak-attack"], selections: ["rogue/finesse-training"]),
        (level: 12, selections: ["rogue/rogue-talents"]),
        (level: 13, features: ["rogue/sneak-attack"]),
        (level: 14, selections: ["rogue/rogue-talents"]),
        (level: 15, features: ["rogue/sneak-attack"]),
        (level: 16, selections: ["rogue/rogue-talents"]),
        (level: 17, features: ["rogue/sneak-attack"]),
        (level: 18, selections: ["rogue/rogue-talents"]),
        (level: 19, features: ["rogue/sneak-attack"], selections: ["rogue/finesse-training"]),
        (level: 20, features: ["rogue/master-strike"], selections: ["rogue/rogue-talents"]),
    ],
    archetypes: [
        (
            key: "rogue/dark-lurker",
            name: "Dark Lurker",
            summary: "Lord of Nothing rogue who strikes from enemies' shadows, with Blind-Fight feats, no Evasion and fewer talents.",
            guide: "rogue#dark-lurker",
            features: [
                (key: "rogue/dark-lurker/blade-from-the-shadows", name: "Blade from the Shadows", summary: "From 2nd level, next to a larger creature, steps through shadows to one within 30 feet for a melee sneak attack; +2 at night.", guide: "rogue#blade-from-the-shadows"),
                (key: "rogue/dark-lurker/blade-from-the-shadows-full-attack", name: "Blade from the Shadows (Full Attack)", summary: "From 14th level, Blade from the Shadows allows a full attack, the first hit a sneak attack (+2 at night).", guide: "rogue#blade-from-the-shadows-full-attack"),
                (key: "rogue/dark-lurker/instinctual-sense", name: "Instinctual Sense", summary: "At 20th level, blindsight 30 feet.", guide: "rogue#instinctual-sense"),
            ],
            levels: [
                (level: 2, features: ["rogue/dark-lurker/blade-from-the-shadows"], feats: ["blind-fight"]),
                (level: 8, features: ["rogue/improved-uncanny-dodge"], feats: ["improved-blind-fight"]),
                (level: 14, features: ["rogue/dark-lurker/blade-from-the-shadows-full-attack"], feats: ["greater-blind-fight"]),
                (level: 20, features: ["rogue/dark-lurker/instinctual-sense", "rogue/master-strike"]),
            ],
        ),
        (
            key: "rogue/eldritch-scoundrel",
            name: "Eldritch Scoundrel",
            summary: "Dexterity and Intelligence rogue with prepared wizard-list spells up to 6th level, less sneak attack, fewer talents and no Uncanny Dodge.",
            guide: "rogue#eldritch-scoundrel",
            casting_ability: Intelligence,
            skill_points: 3,
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
            features: [
                (key: "rogue/eldritch-scoundrel/cantrips", name: "Cantrips", guide: "rogue#eldritch-scoundrel"),
                (key: "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel", name: "Sneak Attack (Eldritch Scoundrel)", summary: "+1d6 sneak attack from 3rd level, +1d6 more at 7th, 11th, 15th and 19th.", guide: "rogue#sneak-attack-eldritch-scoundrel"),
            ],
            levels: [
                (level: 1, spell_levels: (arcane: 1, divine: 0), features: ["rogue/eldritch-scoundrel/cantrips", "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel", "rogue/rogue-proficiencies", "rogue/trapfinding"], feats: ["scribe-scrolls", "simple-weapon-proficiency", "weapon-finesse"]),
                (level: 2, spell_levels: (arcane: 1, divine: 0), features: ["rogue/evasion"], selections: ["rogue/rogue-talents"]),
                (level: 3, spell_levels: (arcane: 1, divine: 0), features: ["rogue/danger-sense", "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel"], selections: ["rogue/finesse-training"]),
                (level: 4, spell_levels: (arcane: 2, divine: 0), features: ["rogue/debilitating-injury"]),
                (level: 5, spell_levels: (arcane: 2, divine: 0)),
                (level: 6, spell_levels: (arcane: 2, divine: 0)),
                (level: 7, spell_levels: (arcane: 3, divine: 0), features: ["rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel"]),
                (level: 8, spell_levels: (arcane: 3, divine: 0), selections: ["rogue/rogue-talents"]),
                (level: 9, spell_levels: (arcane: 3, divine: 0)),
                (level: 10, spell_levels: (arcane: 4, divine: 0), features: ["rogue/advanced-talents"]),
                (level: 11, spell_levels: (arcane: 4, divine: 0), features: ["rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel"], selections: ["rogue/finesse-training"]),
                (level: 12, spell_levels: (arcane: 4, divine: 0), selections: ["rogue/rogue-talents"]),
                (level: 13, spell_levels: (arcane: 5, divine: 0)),
                (level: 14, spell_levels: (arcane: 5, divine: 0)),
                (level: 15, spell_levels: (arcane: 5, divine: 0), features: ["rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel"]),
                (level: 16, spell_levels: (arcane: 6, divine: 0), selections: ["rogue/rogue-talents"]),
                (level: 17, spell_levels: (arcane: 6, divine: 0)),
                (level: 18, spell_levels: (arcane: 6, divine: 0)),
                (level: 19, spell_levels: (arcane: 6, divine: 0), features: ["rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel"], selections: ["rogue/finesse-training"]),
                (level: 20, spell_levels: (arcane: 6, divine: 0), features: ["rogue/master-strike"], selections: ["rogue/rogue-talents"]),
            ],
        ),
        (
            key: "rogue/knife-master",
            name: "Knife Master",
            summary: "Rogue specialised in light blades, with bigger sneak attack dice.",
            guide: "rogue#knife-master",
            features: [
                (key: "rogue/knife-master/blade-sense", name: "Blade Sense", summary: "From 3rd level, +1 dodge AC against light blades, +1 more every 3 levels (max +6 at 18th).", guide: "rogue#blade-sense"),
                (key: "rogue/knife-master/sneak-stab", name: "Sneak Stab", summary: "Sneak attack dice are d8s with daggers, kukris, punching daggers, starknives or sai, and d4s with anything else.", guide: "rogue#sneak-stab"),
            ],
            levels: [
                (level: 1, features: ["rogue/knife-master/sneak-stab", "rogue/rogue-proficiencies", "rogue/sneak-attack"], feats: ["armor-proficiency-light-armor", "simple-weapon-proficiency", "weapon-finesse"]),
                (level: 3, features: ["rogue/knife-master/blade-sense", "rogue/sneak-attack"], selections: ["rogue/finesse-training"]),
                (level: 6, features: ["rogue/knife-master/blade-sense"], selections: ["rogue/rogue-talents"]),
                (level: 9, features: ["rogue/knife-master/blade-sense", "rogue/sneak-attack"]),
                (level: 12, features: ["rogue/knife-master/blade-sense"], selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["rogue/knife-master/blade-sense", "rogue/sneak-attack"]),
                (level: 18, features: ["rogue/knife-master/blade-sense"], selections: ["rogue/rogue-talents"]),
            ],
        ),
        (
            key: "rogue/master-of-all",
            name: "Master of All",
            summary: "Half-elf rogue with every skill as a class skill and Skill Focus feats, but less sneak attack.",
            guide: "rogue#master-of-all",
            prerequisite: Race("half-elf"),
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
            features: [
                (key: "rogue/master-of-all/bardic-knowledge", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "rogue#bardic-knowledge"),
                (key: "rogue/master-of-all/sneak-attack-master-of-all", name: "Sneak Attack (Master of All)", summary: "+1d6 sneak attack, gaining another 1d6 at levels 5, 7, 11, 13, 17 and 19.", guide: "rogue#sneak-attack-master-of-all"),
