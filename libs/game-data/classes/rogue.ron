Class(
    key: "rogue",
    blueprint: "299aa766dee3cbf4790da4efb8c72484",
    name: "Rogue",
    summary: "Dexterity skill expert: 3/4 BAB, good Reflex, 5 skill points per level, sneak attack and rogue talents.",
    guide: "rogue",
    skill_points: 5,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["athletics", "knowledge-world", "mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
    features: [
        (key: "rogue/advanced-talents", blueprint: "a33b99f95322d6741af83e9381b2391c", name: "Advanced Talents", summary: "From 10th level, can choose advanced rogue talents.", guide: "rogue#advanced-rogue-talents"),
        (key: "rogue/danger-sense", blueprint: "0bcbe9e450b0e7b428f08f66c53c5136", name: "Danger Sense", summary: "From 3rd level, +1 to Reflex and dodge AC against traps and to Perception against surprise, +1 every 3 levels (max +6).", guide: "rogue#danger-sense"),
        (key: "rogue/debilitating-injury", blueprint: "def114eb566dfca448e998969bf51586", name: "Debilitating Injury", summary: "From 4th level, a sneak attack also bewilders (-2 AC, worse vs you), disorients (-2 attack, worse vs you) or halves speed for 1 round.", guide: "rogue#debilitating-injury"),
        (key: "rogue/evasion", blueprint: "576933720c440aa4d8d42b0c54b77e80", name: "Evasion", summary: "From 2nd level, a successful Reflex save against a half-damage effect means no damage.", guide: "rogue#evasion"),
        (key: "rogue/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "From 8th level, you cannot be flanked; rogues need 4 more rogue levels than you to sneak attack you.", guide: "rogue#improved-uncanny-dodge"),
        (key: "rogue/master-strike", blueprint: "72dcf1fb106d5054a81fd804fdc168d3", name: "Master Strike", summary: "At 20th level, a sneak attack can kill outright on a failed Fort save (DC 20 + Dex); a target that saves becomes immune.", guide: "rogue#master-strike"),
        (key: "rogue/rogue-proficiencies", blueprint: "33e2a7e4ad9daa54eaf808e1483bb43c", name: "Rogue Proficiencies", summary: "Simple weapons, rapier, short sword, short bow and light armour; no shields.", guide: "rogue#rogue-proficiencies", weapons: ["rapier", "short-bow", "short-sword"]),
        (key: "rogue/sneak-attack", blueprint: "9b9eac6709e1c084cb18c3a366e0ec87", name: "Sneak Attack", summary: "+1d6 damage against flanked foes or those denied Dexterity to AC, +1d6 more every odd class level.", guide: "rogue#sneak-attack"),
        (key: "rogue/trapfinding", blueprint: "dbb6b3bffe6db3547b31c3711653838e", name: "Trapfinding", summary: "Adds half the class level to Perception checks.", guide: "rogue#trapfinding"),
        (key: "rogue/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "From 4th level, you are never caught flat-footed and keep your Dexterity bonus to AC against invisible attackers.", guide: "rogue#uncanny-dodge"),
    ],
    selections: [
        (
            key: "rogue/finesse-training",
            blueprint: "b78d146cea711a84598f0acef69462ea",
            name: "Finesse Training",
            summary: "From 3rd level, adds Dexterity instead of Strength to damage with one chosen finessable weapon; a second at 11th, a third at 19th.",
            guide: "rogue#finesse-training",
            options: [
                (
                    key: "rogue/finesse-training/weapon",
                    name: "Finesse Training",
                    summary: "Adds Dexterity instead of Strength to damage with the chosen finessable weapon.",
                    guide: "rogue#finesse-training",
                    parameter: Weapon,
                    // The guide's list: "The weapons selectable are: Bite, Claw, Dagger, …, Starknife, Unarmed."
                    values: [
                        Weapon("bite"),
                        Weapon("claw"),
                        Weapon("dagger"),
                        Weapon("dueling-sword"),
                        Weapon("elven-curve-blade"),
                        Weapon("estoc"),
                        Weapon("hand-axe"),
                        Weapon("kama"),
                        Weapon("kukri"),
                        Weapon("light-hammer"),
                        Weapon("light-mace"),
                        Weapon("light-pick"),
                        Weapon("light-shield-bash"),
                        Weapon("nunchaku"),
                        Weapon("punching-dagger"),
                        Weapon("rapier"),
                        Weapon("sai"),
                        Weapon("short-sword"),
                        Weapon("sickle"),
                        Weapon("starknife"),
                        Weapon("unarmed-strike"),
                    ],
                    repeat: PerValue,
                ),
            ],
        ),
        (
            key: "rogue/rogue-talents",
            blueprint: "c074a5d615200494b8f2a9c845799d93",
            name: "Rogue Talents",
            summary: "A rogue talent from the class list; an Eldritch Scoundrel can also take (Improved) Uncanny Dodge.",
            guide: "rogue#rogue-talents",
            option_levels: ["bard", "rogue", "skald"],
            options: [
                (key: "rogue/rogue-talents/blinding-strike", blueprint: "fd01c15d9e74cd247b1fdbd6eb4d4713", name: "Blinding Strike", summary: "Requires character level 15: gains Blinding Critical as a bonus feat.", guide: "rogue#blinding-strike", feats: ["blinding-critical"], prerequisite: All([Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)]), CharacterLevel(15)])),
                (key: "rogue/rogue-talents/canny-observer", blueprint: "68a23a419b330de45b4c3789649b5b41", name: "Canny Observer", summary: "+4 to Perception checks.", guide: "rogue#canny-observer"),
                (
                    key: "rogue/rogue-talents/combat-trick",
                    blueprint: "c5158a6622d0b694a99efb1d0025d2c1",
                    name: "Combat Trick",
                    summary: "A bonus combat feat you qualify for.",
                    guide: "rogue#combat-trick",
                    repeat: Unlimited,
                    levels: [
                        (level: 1, feat_slots: [CombatFeat]),
                    ],
                ),
                (key: "rogue/rogue-talents/confounding-blades", blueprint: "ce72662a812b1f242849417b2c784b5e", name: "Confounding Blades", summary: "A melee sneak attack stops the target making attacks of opportunity for 2 to 5 rounds.", guide: "rogue#confounding-blades", prerequisite: All([Any([Feature(feature: "alchemist/vivisectionist/advanced-talents", count: 1), Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)]), SelectionOption("rogue/rogue-talents/slow-reactions")])),
                (key: "rogue/rogue-talents/crippling-strike", blueprint: "b696bd7cb38da194fa3404032483d1db", name: "Crippling Strike", summary: "Sneak attacks deal 2 Strength damage.", guide: "rogue#crippling-strike", prerequisite: Any([Feature(feature: "alchemist/vivisectionist/advanced-talents", count: 1), Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/dispelling-attack", blueprint: "1b92146b8a9830d4bb97ab694335fa7c", name: "Dispelling Attack", summary: "Your sneak attacks also dispel one active spell on the target, using your character level as the caster level.", guide: "rogue#dispelling-attack", prerequisite: Any([Feature(feature: "alchemist/vivisectionist/advanced-talents", count: 1), Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/double-debilitation", blueprint: "dd699394df0ef8847abba26038333f02", name: "Double Debilitation", summary: "Debilitating Injury applies two penalties at once.", guide: "rogue#double-debilitation", prerequisite: All([Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)]), Feature(feature: "rogue/debilitating-injury", count: 1)])),
                (key: "rogue/rogue-talents/emboldening-strike", blueprint: "ba6bea8c93c64764ab7e5bbdb88fb9a6", name: "Emboldening Strike", summary: "A sneak attack gives +1 to saving throws per 2 sneak dice rolled, for 1 round.", guide: "rogue#emboldening-strike"),
                (key: "rogue/rogue-talents/familiar", blueprint: "363cab72f77c47745bf3a8807074d183", name: "Familiar", summary: "Gains a familiar, as a Wizard's arcane bond.", guide: "rogue#familiar", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/fast-stealth", blueprint: "97a6aa2b64dd21a4fac67658a91067d7", name: "Fast Stealth", summary: "Moves at full speed while using Stealth.", guide: "rogue#fast-stealth"),
                (key: "rogue/rogue-talents/focusing-attack-confused", blueprint: "955ff81c596c1c3489406d03e81e6087", name: "Focusing Attack - Confused", summary: "Dealing sneak attack damage ends your own confusion.", guide: "rogue#focusing-attack-confused"),
                (key: "rogue/rogue-talents/focusing-attack-shaken", blueprint: "791f50e199d069d4f8e933996a2ce054", name: "Focusing Attack - Shaken", summary: "Dealing sneak attack damage ends your own shaken condition.", guide: "rogue#focusing-attack-shaken"),
                (key: "rogue/rogue-talents/focusing-attack-sickened", blueprint: "79475c263e538c94f8e23907bd570a35", name: "Focusing Attack - Sickened", summary: "Dealing sneak attack damage ends your own sickened condition.", guide: "rogue#focusing-attack-sickened"),
                (key: "rogue/rogue-talents/hunters-surprise", blueprint: "6209197fed619cf41910f9aaceaf7d51", name: "Hunter\'s Surprise", summary: "Once a day, your attacks against one adjacent enemy add sneak attack damage until the end of your next turn.", guide: "rogue#hunters-surprise", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/improved-evasion", blueprint: "0d35d6c4d5eef8d4790d09bd9a874e57", name: "Improved Evasion", summary: "A successful Reflex save means no damage, and a failed one only half damage.", guide: "rogue#improved-evasion", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                // "An Eldritch Scoundrel can select (Improved) Uncanny Dodge as Rogue Talents" (ticket 190). The Improved one
                // needing Uncanny Dodge first is the user's decision (the guide doesn't say; 2026-11-13: the recommended option).
                (key: "rogue/rogue-talents/improved-uncanny-dodge", blueprint: "e821c61b2711cea4cb993725b910e7e8", name: "Improved Uncanny Dodge", summary: "Eldritch Scoundrel only, after Uncanny Dodge: you cannot be flanked; rogues need 4 more rogue levels than you to sneak attack you.", guide: "rogue#rogue-talents", prerequisite: All([Archetype("rogue/eldritch-scoundrel"), Feature(feature: "rogue/uncanny-dodge", count: 1)]), levels: [(level: 1, features: ["rogue/improved-uncanny-dodge"])]),
                (key: "rogue/rogue-talents/intimidating-prowess", blueprint: "d76497bfc48516e45a0831628f767a0f", name: "Intimidating Prowess", summary: "Gains the Intimidating Prowess feat.", guide: "rogue#intimidating-prowess", feats: ["intimidating-prowess"]),
                (key: "rogue/rogue-talents/iron-guts", blueprint: "6087e0c9801b5eb48bf48d6e75116aad", name: "Iron Guts", summary: "+1 to saves against poison and +4 against sickening and nauseating effects.", guide: "rogue#iron-guts"),
                (key: "rogue/rogue-talents/jump-up", blueprint: "9f2d35be63f68614b89c901db84dd750", name: "Jump Up", summary: "Standing up from prone does not provoke attacks of opportunity.", guide: "rogue#jump-up"),
                (key: "rogue/rogue-talents/mystery-seeker", blueprint: "04f8c258a47a2de4faac28be313b1621", name: "Mystery Seeker", summary: "Knowledge (Arcana) becomes a class skill.", guide: "rogue#mystery-seeker"),
                (key: "rogue/rogue-talents/opportunist", blueprint: "5bb6dc5ce00550441880a6ff8ad4c968", name: "Opportunist", summary: "Once a round, an attack of opportunity against a foe another character has just hit.", guide: "rogue#opportunist", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/petrifying-strike", blueprint: "719d4539f7824eb99b8c6668e77820d2", name: "Petrifying Strike", summary: "Sneak attacks deal 2 Dexterity damage.", guide: "rogue#petrifying-strike", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/skill-focus", blueprint: "c9629ef9eebb88b479b2fbc5e836656a", name: "Skill Focus", summary: "Gains the Skill Focus feat.", guide: "rogue#skill-focus", chosen_feat: "skill-focus", repeat: PerValue),
                (key: "rogue/rogue-talents/skill-mastery-knowledge", blueprint: "4b104a7319393494ca8d449a3b38a45f", name: "Skill Mastery (Knowledge)", summary: "Can take 10 on Knowledge (Arcana) and Knowledge (World) checks.", guide: "rogue#skill-mastery-knowledge", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/skill-mastery-lore", blueprint: "31b5f3e5093c8244abb32f6c7c775de1", name: "Skill Mastery (Lore)", summary: "Can take 10 on Lore (Nature) and Lore (Religion) checks.", guide: "rogue#skill-mastery-lore", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/skill-mastery-stealth-and-trickery", blueprint: "84ba86c9cc1ef9e489dab1ad03e3ba17", name: "Skill Mastery (Stealth and Trickery)", summary: "Can take 10 on Stealth and Trickery checks.", guide: "rogue#skill-mastery-stealth-and-trickery", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/slippery-mind", blueprint: "a14e8c1801911334f96d410f10eab7bf", name: "Slippery Mind", summary: "Adds your Dexterity modifier to saves against mind-affecting effects.", guide: "rogue#slippery-mind", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/slow-reactions", blueprint: "7787030571e87704d9177401c595408e", name: "Slow Reactions", summary: "Foes hit by your sneak attacks lose their attacks of opportunity for 1 round.", guide: "rogue#slow-reactions"),
                (key: "rogue/rogue-talents/survivalist", blueprint: "9836ea18e56af8249bdda4a4b11ea78c", name: "Survivalist", summary: "Lore (Nature) becomes a class skill.", guide: "rogue#survivalist"),
                (key: "rogue/rogue-talents/terrain-mastery", blueprint: "4cd06a915daa74f4094952f2b3314b3b", name: "Terrain Mastery", summary: "A favoured terrain like the Ranger's, but its bonus does not grow with level.", guide: "rogue#terrain-mastery"),
                (key: "rogue/rogue-talents/trailblazer", blueprint: "5a5ad5a6ca394bf46a70a68902cf3fd7", name: "Trailblazer", summary: "Immune to difficult terrain.", guide: "rogue#trailblazer"),
                (key: "rogue/rogue-talents/unbalancing-trick", blueprint: "f3aeaba4f6506824ab393b03d28faa50", name: "Unbalancing Trick", summary: "Gains Trip as a bonus feat.", guide: "rogue#unbalancing-trick", feats: ["trip"]),
                (key: "rogue/rogue-talents/uncanny-dodge", blueprint: "ca5274d057152fa45b7527cad0927840", name: "Uncanny Dodge", summary: "Eldritch Scoundrel only: you are never caught flat-footed and keep your Dexterity bonus to AC against invisible attackers.", guide: "rogue#rogue-talents", prerequisite: Archetype("rogue/eldritch-scoundrel"), levels: [(level: 1, features: ["rogue/uncanny-dodge"])]),
                (key: "rogue/rogue-talents/underhanded-trick", blueprint: "3a0068c5f38cfa445a20efc5b05286bd", name: "Underhanded Trick", summary: "Gains Dirty Trick as a bonus feat.", guide: "rogue#underhanded-trick", feats: ["dirty-trick"]),
                (key: "rogue/rogue-talents/weakening-wound", blueprint: "2b61127f29ba97942868e8677b7633e6", name: "Weakening Wound", summary: "A sneak attack lowers the target's DR by your character level for 2 rounds.", guide: "rogue#weakening-wound"),
                (key: "rogue/rogue-talents/weapon-focus", blueprint: "1e1f627d26ad36f43bbd26cc2bf8ac7e", name: "Weapon Focus", summary: "Gains the Weapon Focus feat for one weapon; can be taken again for another weapon.", guide: "rogue#weapon-focus", chosen_feat: "weapon-focus", repeat: PerValue),
                (key: "rogue/rogue-talents/weapon-snatcher", blueprint: "ffced614e1f95e34d99df77debbc4207", name: "Weapon Snatcher", summary: "Uses a Trickery check instead of a combat manoeuvre check to disarm.", guide: "rogue#weapon-snatcher", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
                (key: "rogue/rogue-talents/wearying-strike", blueprint: "b4befb0a9b58e0e4687942661c55198d", name: "Wearying Strike", summary: "Sneak attacks deal 1 Constitution damage.", guide: "rogue#wearying-strike", prerequisite: Any([Feature(feature: "bard/archaeologist/advanced-talents", count: 1), Feature(feature: "rogue/advanced-talents", count: 1), Feature(feature: "slayer/advanced-talents", count: 1)])),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["rogue/rogue-proficiencies", "rogue/sneak-attack", "rogue/trapfinding"], feats: ["armor-proficiency-light-armor", "simple-weapon-proficiency", "weapon-finesse"]),
        (level: 2, features: ["rogue/evasion"], selections: ["rogue/rogue-talents"]),
        (level: 3, features: ["rogue/danger-sense", "rogue/sneak-attack"], selections: ["rogue/finesse-training"]),
        (level: 4, features: ["rogue/debilitating-injury", "rogue/uncanny-dodge"], selections: ["rogue/rogue-talents"]),
        (level: 5, features: ["rogue/sneak-attack"]),
        (level: 6, features: ["rogue/danger-sense"], selections: ["rogue/rogue-talents"]),
        (level: 7, features: ["rogue/sneak-attack"]),
        (level: 8, features: ["rogue/improved-uncanny-dodge"], selections: ["rogue/rogue-talents"]),
        (level: 9, features: ["rogue/danger-sense", "rogue/sneak-attack"]),
        (level: 10, features: ["rogue/advanced-talents"], selections: ["rogue/rogue-talents"]),
        (level: 11, features: ["rogue/sneak-attack"], selections: ["rogue/finesse-training"]),
        (level: 12, features: ["rogue/danger-sense"], selections: ["rogue/rogue-talents"]),
        (level: 13, features: ["rogue/sneak-attack"]),
        (level: 14, selections: ["rogue/rogue-talents"]),
        (level: 15, features: ["rogue/danger-sense", "rogue/sneak-attack"]),
        (level: 16, selections: ["rogue/rogue-talents"]),
        (level: 17, features: ["rogue/sneak-attack"]),
        (level: 18, features: ["rogue/danger-sense"], selections: ["rogue/rogue-talents"]),
        (level: 19, features: ["rogue/sneak-attack"], selections: ["rogue/finesse-training"]),
        (level: 20, features: ["rogue/master-strike"], selections: ["rogue/rogue-talents"]),
    ],
    archetypes: [
        (
            key: "rogue/dark-lurker",
            blueprint: "33eb002078e5437b8c25db4b80b4a4fe",
            name: "Dark Lurker",
            summary: "Lord of Nothing rogue who strikes from enemies' shadows, with Blind-Fight feats, no Evasion and fewer talents.",
            guide: "rogue#dark-lurker",
            features: [
                (key: "rogue/dark-lurker/blade-from-the-shadows", blueprint: "d8bbc2750a7349eeb54b4cb97dc8e796", name: "Blade from the Shadows", summary: "From 2nd level, next to a larger creature, steps through shadows to one within 30 feet for a melee sneak attack; +2 at night.", guide: "rogue#blade-from-the-shadows"),
                (key: "rogue/dark-lurker/blade-from-the-shadows-full-attack", blueprint: "0c67c03754314f7eb980d6d9e27b4831", name: "Blade from the Shadows (Full Attack)", summary: "From 14th level, Blade from the Shadows allows a full attack, the first hit a sneak attack (+2 at night).", guide: "rogue#blade-from-the-shadows-full-attack"),
                (key: "rogue/dark-lurker/instinctual-sense", blueprint: "359b313177f74a17bda6007265a58207", name: "Instinctual Sense", summary: "At 20th level, blindsight 30 feet.", guide: "rogue#instinctual-sense"),
            ],
            levels: [
                (level: 2, features: ["rogue/dark-lurker/blade-from-the-shadows"], feats: ["blind-fight"]),
                (level: 8, features: ["rogue/improved-uncanny-dodge"], feats: ["improved-blind-fight"]),
                (level: 14, features: ["rogue/dark-lurker/blade-from-the-shadows-full-attack"], feats: ["greater-blind-fight"]),
                (level: 20, features: ["rogue/dark-lurker/instinctual-sense", "rogue/master-strike"]),
            ],
        ),
        (
            key: "rogue/eldritch-scoundrel",
            blueprint: "57f93dd8423c97c49989501281296c4a",
            name: "Eldritch Scoundrel",
            summary: "Dexterity and Intelligence rogue with prepared wizard-list spells up to 6th level, less sneak attack, fewer talents and no Uncanny Dodge.",
            guide: "rogue#eldritch-scoundrel",
            casting_ability: Intelligence,
            skill_points: 3,
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
            features: [
                (key: "rogue/eldritch-scoundrel/cantrips", blueprint: "0e451b208e7b855468986e03fcd4f990", name: "Cantrips", guide: "rogue#eldritch-scoundrel"),
                (key: "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel", blueprint: "9b9eac6709e1c084cb18c3a366e0ec87", name: "Sneak Attack (Eldritch Scoundrel)", summary: "+1d6 sneak attack from 3rd level, +1d6 more at 7th, 11th, 15th and 19th.", guide: "rogue#sneak-attack-eldritch-scoundrel"),
            ],
            levels: [
                (level: 1, spell_levels: (arcane: 1, divine: 0), features: ["rogue/eldritch-scoundrel/cantrips", "rogue/eldritch-scoundrel/sneak-attack-eldritch-scoundrel", "rogue/rogue-proficiencies", "rogue/trapfinding"], feats: ["scribe-scrolls", "simple-weapon-proficiency", "weapon-finesse"]),
