Class(
    key: "bard",
    blueprint: "772c83a25e2268e448e841dcd548235f",
    name: "Bard",
    summary: "Charisma-based spontaneous arcane caster up to 6th level: 3/4 BAB, good Reflex and Will, all class skills and party-buffing performances.",
    guide: "bard",
    skill_points: 4,
    casting_ability: Charisma,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Good,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
    spontaneous: true,
    features: [
        (key: "bard/bard-proficiencies", blueprint: "fa3d3b2211a51994785d85e753f612d3", name: "Bard Proficiencies", summary: "Simple weapons, longsword, rapier, short sword, shortbow, light armour and shields.", guide: "bard#bard-proficiencies", weapons: ["longsword", "rapier", "short-bow", "short-sword"]),
        (key: "bard/bardic-knowledge", blueprint: "65cff8410a336654486c98fd3bacd8c5", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "bard#bardic-knowledge"),
        (key: "bard/bardic-performance-move-action", blueprint: "36931765983e96d4bb07ce7844cd897e", name: "Bardic Performance (Move Action)", summary: "From 7th level, a performance can be started as a move action rather than a standard one.", guide: "bard#bardic-performance-move-action"),
        (key: "bard/bardic-performance-swift-action", blueprint: "fd4ec50bc895a614194df6b9232004b9", name: "Bardic Performance (Swift Action)", summary: "From 13th level, starts a performance as a swift action.", guide: "bard#bardic-performance-swift-action"),
        (key: "bard/deadly-performance", blueprint: "a6e13797b0a20d2458a086a8a511fd8c", name: "Deadly Performance", summary: "At 20th level, once a day, an enemy within 30 feet hearing 1 round of song saves (DC 20 + Cha) or dies; on a save it is staggered 1-4 rounds.", guide: "bard#deadly-performance"),
        (key: "bard/dirge-of-doom", blueprint: "1d48ab2bded57a74dad8af3da07d313a", name: "Dirge of Doom", summary: "From 8th level, Fascinate also makes its targets shaken.", guide: "bard#dirge-of-doom"),
        (key: "bard/fascinate", blueprint: "ddaec3a5845bc7d4191792529b687d65", name: "Fascinate", summary: "From 6th level, creatures within 30 feet save on Will (DC 10 + half level + Cha) or are fascinated and stop moving until damaged.", guide: "bard#fascinate"),
        (key: "bard/frightening-tune", blueprint: "cfd8940869a304f4aa9077415f93febe", name: "Frightening Tune", summary: "From 14th level, Fascinate also inflicts fear (DC 10 + half level + Cha).", guide: "bard#frightening-tune"),
        (key: "bard/inspire-competence", blueprint: "6d3fcfab6d935754c918eb0e004b5ef7", name: "Inspire Competence", summary: "From 3rd level, allies within 30 feet get +2 competence to skill checks, +1 at 7th, 11th, 15th and 19th (max +6).", guide: "bard#inspire-competence"),
        (key: "bard/inspire-courage", blueprint: "acb4df34b25ca9043a6aba1a4c92bc69", name: "Inspire Courage", summary: "Allies get +1 morale to saves against charm and fear and +1 competence to attack and damage; +2 at 5th, +3 at 11th, +4 at 17th.", guide: "bard#inspire-courage"),
        (key: "bard/inspire-greatness", blueprint: "9ae0f32c72f8df84dab023d1b34641dc", name: "Inspire Greatness", summary: "From 9th level, allies gain 2d10 hit points, +2 competence to attacks and +1 competence to Fortitude saves.", guide: "bard#inspire-greatness"),
        (key: "bard/inspire-heroics", blueprint: "199d6fa0de149d044a8ab622a542cc79", name: "Inspire Heroics", summary: "From 15th level, allies get +4 morale to saves and +4 dodge AC.", guide: "bard#inspire-heroics"),
        (key: "bard/jack-of-all-trades", blueprint: "21fbafd5dc42d4d488c4d6caed46bc99", name: "Jack of All Trades", summary: "From 10th level, +1 to all skill checks.", guide: "bard#jack-of-all-trades"),
        (key: "bard/lore-master", blueprint: "4bea694e79a87cd4d8c14fb91578059e", name: "Lore Master", summary: "From 5th level, you may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "bard#lore-master"),
        (key: "bard/soothing-performance", blueprint: "546698146e02d1e4ea00581a3ea7fe58", name: "Soothing Performance", summary: "From 12th level, 4 rounds of performance work as Mass Cure Serious Wounds and remove fatigued, sickened and shaken from allies.", guide: "bard#soothing-performance"),
        (key: "bard/well-versed", blueprint: "8f4060852a4c8604290037365155662f", name: "Well Versed", summary: "From 2nd level, saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "bard#well-versed"),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["bard/bard-proficiencies", "bard/bardic-knowledge", "bard/inspire-courage"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, arcane_spell_level: 1, features: ["bard/well-versed"], selections: ["rogue/rogue-talents"]),
        (level: 3, arcane_spell_level: 1, features: ["bard/inspire-competence"]),
        (level: 4, arcane_spell_level: 2),
        (level: 5, arcane_spell_level: 2, features: ["bard/lore-master"]),
        (level: 6, arcane_spell_level: 2, features: ["bard/fascinate"], selections: ["rogue/rogue-talents"]),
        (level: 7, arcane_spell_level: 3, features: ["bard/bardic-performance-move-action"]),
        (level: 8, arcane_spell_level: 3, features: ["bard/dirge-of-doom"]),
        (level: 9, arcane_spell_level: 3, features: ["bard/inspire-greatness"]),
        (level: 10, arcane_spell_level: 4, features: ["bard/jack-of-all-trades"], selections: ["rogue/rogue-talents"]),
        (level: 11, arcane_spell_level: 4),
        (level: 12, arcane_spell_level: 4, features: ["bard/soothing-performance"]),
        (level: 13, arcane_spell_level: 5, features: ["bard/bardic-performance-swift-action"]),
        (level: 14, arcane_spell_level: 5, features: ["bard/frightening-tune"], selections: ["rogue/rogue-talents"]),
        (level: 15, arcane_spell_level: 5, features: ["bard/inspire-heroics"]),
        (level: 16, arcane_spell_level: 6),
        (level: 17, arcane_spell_level: 6),
        (level: 18, arcane_spell_level: 6, selections: ["rogue/rogue-talents"]),
        (level: 19, arcane_spell_level: 6),
        (level: 20, arcane_spell_level: 6, features: ["bard/deadly-performance"]),
    ],
    archetypes: [
        (
            key: "bard/archaeologist",
            blueprint: "38384e0c1e99c2e42ac6ed70a04aca46",
            name: "Archaeologist",
            summary: "Rogue-like bard with a luck bonus, Evasion, Uncanny Dodge and bard talents (advanced rogue talents from 10th) instead of performances.",
            guide: "bard#archaeologist",
            features: [
                (key: "bard/archaeologist/advanced-talents", blueprint: "a33b99f95322d6741af83e9381b2391c", name: "Advanced Talents", summary: "From 10th level, can choose advanced rogue talents.", guide: "bard#advanced-talents"),
                (key: "bard/archaeologist/archaeologists-luck", blueprint: "03bf87dd753cd4f48a47eaf0ea6da9fe", name: "Archaeologist\'s Luck", summary: "4 + Cha rounds a day (+2 per level): +1 luck to attacks, saves, skills and weapon damage; +2 at 5th, +3 at 11th, +4 at 17th.", guide: "bard#archaeologists-luck"),
                (key: "bard/archaeologist/clever-explorer", blueprint: "1322e50d2b36aba45ab5405db43c53a3", name: "Clever Explorer", summary: "From 2nd level, adds half the class level to Trickery and Perception checks.", guide: "bard#clever-explorer"),
                (key: "bard/archaeologist/confident-explorer", blueprint: "56f4e48126b78ab40970783a3cebed65", name: "Confident Explorer", summary: "From 6th level, can always take 10 on Trickery checks.", guide: "bard#confident-explorer"),
                (key: "bard/archaeologist/danger-sense", blueprint: "f3ce82243623f414a94fd83cb22d5528", name: "Danger Sense", summary: "From 3rd level, +1 to Reflex and dodge AC against traps and to Perception against surprise, +1 every 3 levels (max +6).", guide: "bard#danger-sense"),
                (key: "bard/archaeologist/detect-magic", blueprint: "ee0b69e90bac14446a4cf9a050f87f2e", name: "Detect Magic", guide: "bard#archaeologist"),
                (key: "bard/archaeologist/evasion", blueprint: "576933720c440aa4d8d42b0c54b77e80", name: "Evasion", summary: "From 6th level, a successful Reflex save against a half-damage effect means no damage.", guide: "bard#evasion"),
                (key: "bard/archaeologist/uncanny-dodge", blueprint: "3c08d842e802c3e4eb19d15496145709", name: "Uncanny Dodge", summary: "From 2nd level, you are never caught flat-footed and keep your Dexterity bonus to AC against invisible attackers.", guide: "bard#uncanny-dodge"),
            ],
            levels: [
                (level: 1, features: ["bard/archaeologist/archaeologists-luck", "bard/archaeologist/detect-magic", "bard/bard-proficiencies", "bard/bardic-knowledge"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["bard/archaeologist/clever-explorer", "bard/archaeologist/uncanny-dodge"], selections: ["rogue/rogue-talents"]),
                (level: 3, features: ["bard/archaeologist/danger-sense"]),
                (level: 5, features: ["bard/archaeologist/archaeologists-luck", "bard/lore-master"]),
                (level: 6, features: ["bard/archaeologist/confident-explorer", "bard/archaeologist/danger-sense", "bard/archaeologist/evasion"], selections: ["rogue/rogue-talents"]),
                (level: 7),
                (level: 8),
                (level: 9, features: ["bard/archaeologist/danger-sense"]),
                (level: 10, features: ["bard/archaeologist/advanced-talents", "bard/jack-of-all-trades"], selections: ["rogue/rogue-talents"]),
                (level: 11, features: ["bard/archaeologist/archaeologists-luck", "bard/inspire-competence"]),
                (level: 12, features: ["bard/archaeologist/danger-sense"]),
                (level: 13),
                (level: 14, selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["bard/archaeologist/danger-sense"]),
                (level: 17, features: ["bard/archaeologist/archaeologists-luck"]),
                (level: 18, features: ["bard/archaeologist/danger-sense"], selections: ["rogue/rogue-talents"]),
                (level: 20),
            ],
        ),
        (
            key: "bard/beast-tamer",
            blueprint: "912b0495d9485124bb2c0e4aa6ac2efd",
            name: "Beast Tamer",
            summary: "Bard who summons nature's allies and inspires animals, with fewer party buffs.",
            guide: "bard#beast-tamer",
            features: [
                (key: "bard/beast-tamer/beast-call", blueprint: "db328d2d7b6443d4a8c783395c9820cd", name: "Beast Call", summary: "Summon Nature's Ally as a standard-action spell-like ability 3 + Cha times a day, its level rising every 2 levels to IX at 17th.", guide: "bard#beast-call"),
                (key: "bard/beast-tamer/inspire-ferocity", blueprint: "2106e5e252e59ae4c81cea04627869ca", name: "Inspire Ferocity", summary: "Animal companions and summons get +1 morale vs charm and fear and +1 to attack and damage (up to +4), later Magic Fang and better DR bypass.", guide: "bard#inspire-ferocity"),
                (key: "bard/beast-tamer/spontaneous-summoning", blueprint: "f026602be18bc194dbb77f75487a2b41", name: "Spontaneous Summoning", summary: "Can swap any prepared spell for a Summon Nature's Ally spell of the same level.", guide: "bard#spontaneous-summoning"),
                (key: "bard/beast-tamer/summon-natures-ally-i", blueprint: "fb6000f054cec7847a6e793069e90040", name: "Summon Nature\'s Ally I", summary: "Beast Call summons with Summon Nature's Ally I from 1st level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-ii", blueprint: "ef9409a4908f30a4392832af62f9a64d", name: "Summon Nature\'s Ally II", summary: "Beast Call summons with Summon Nature's Ally II from 3rd level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-iii", blueprint: "174677b0fd47a0d44bd0704a39d2565b", name: "Summon Nature\'s Ally III", summary: "Beast Call summons with Summon Nature's Ally III from 5th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-iv", blueprint: "148392566c0280c4f9b49bee0664c568", name: "Summon Nature\'s Ally IV", summary: "Beast Call summons with Summon Nature's Ally IV from 7th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-ix", blueprint: "0e38ad0c8b28e914eaea5327ebad9315", name: "Summon Nature\'s Ally IX", summary: "Beast Call summons with Summon Nature's Ally IX from 17th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-v", blueprint: "af1b9da38c4fb84448d88bfe183a5038", name: "Summon Nature\'s Ally V", summary: "Beast Call summons with Summon Nature's Ally V from 9th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-vi", blueprint: "665a4fb64f1aadf48a08585b2af994cc", name: "Summon Nature\'s Ally VI", summary: "Beast Call summons with Summon Nature's Ally VI from 11th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-vii", blueprint: "cc74dc1141f9abc4ab49af3bb21a83c8", name: "Summon Nature\'s Ally VII", summary: "Beast Call summons with Summon Nature's Ally VII from 13th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-viii", blueprint: "e9c24d2cf74d11344a91cdb3ff781735", name: "Summon Nature\'s Ally VIII", summary: "Beast Call summons with Summon Nature's Ally VIII from 15th level.", guide: "bard#beast-tamer"),
            ],
            levels: [
                (level: 1, features: ["bard/bard-proficiencies", "bard/bardic-knowledge", "bard/beast-tamer/beast-call", "bard/beast-tamer/inspire-ferocity", "bard/beast-tamer/spontaneous-summoning", "bard/beast-tamer/summon-natures-ally-i"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["bard/well-versed"], feats: ["augment-summoning"]),
                (level: 3, features: ["bard/beast-tamer/summon-natures-ally-ii"]),
                (level: 5, features: ["bard/beast-tamer/summon-natures-ally-iii", "bard/lore-master"]),
                (level: 7, features: ["bard/bardic-performance-move-action", "bard/beast-tamer/summon-natures-ally-iv"]),
                (level: 8),
                (level: 9, features: ["bard/beast-tamer/summon-natures-ally-v", "bard/inspire-greatness"]),
                (level: 10, features: ["bard/jack-of-all-trades"]),
                (level: 11, features: ["bard/beast-tamer/summon-natures-ally-vi"]),
                (level: 13, features: ["bard/bardic-performance-swift-action", "bard/beast-tamer/summon-natures-ally-vii"]),
                (level: 14, selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["bard/beast-tamer/summon-natures-ally-viii", "bard/inspire-heroics"]),
                (level: 17, features: ["bard/beast-tamer/summon-natures-ally-ix"]),
            ],
        ),
        (
            key: "bard/chelaxian-diva",
            blueprint: "985e74f9becb4ea492eb27726f5df872",
            name: "Chelaxian Diva",
            summary: "Dance of Masks bard with damaging and debilitating opera songs instead of most standard performances.",
            guide: "bard#chelaxian-diva",
            features: [
                (key: "bard/chelaxian-diva/banshees-requiem", blueprint: "59077996944b4ae1bef4cdd1b872ef8d", name: "Banshee\'s Requiem", summary: "From 16th level, the song gives living creatures within 30 feet 2 negative levels unless they save on Fortitude.", guide: "bard#banshees-requiem"),
                (key: "bard/chelaxian-diva/blazing-rondo", blueprint: "2c575afe75a24905bde456308514b048", name: "Blazing Rondo", summary: "From 9th level, the song hastes allies within 60 feet (bonuses of a fifth of your level); 3+ rounds risks fatigue.", guide: "bard#blazing-rondo"),
                (key: "bard/chelaxian-diva/deadly-vibrato", blueprint: "2d301c453db84865b162403d34ad1f17", name: "Deadly Vibrato", summary: "From 6th level, 1 more round of song adds 1d8 sonic damage (Fort negates), 2d8 at 14th and 3d8 at 20th.", guide: "bard#deadly-vibrato"),
                (key: "bard/chelaxian-diva/devastating-aria", blueprint: "f7dcab1cd75140488bacb73b04e29b5c", name: "Devastating Aria", summary: "From 2nd level, 1d6 + level sonic damage to an object (half to creatures), +1d6 at 7th and every 4 levels (max 5d6).", guide: "bard#devastating-aria"),
                (key: "bard/chelaxian-diva/famous", blueprint: "7d597cb3de6d4b99983432910582a8af", name: "Famous", summary: "Persuasion (Bluff and Diplomacy) checks get a bonus of half the class level.", guide: "bard#famous"),
                (key: "bard/chelaxian-diva/prima-donna", blueprint: "719f9232523742d9a09e433a40e25d5b", name: "Prima Donna", summary: "From 5th level, 1 round of performance raises your songs' save DCs by +2.", guide: "bard#prima-donna"),
                (key: "bard/chelaxian-diva/tragedy-of-false-hope", blueprint: "241ce86c60b54392a988c61a5d75293f", name: "Tragedy of False Hope", summary: "From 3rd level, the song leaves enemies within 30 feet flat-footed unless they save on Will; Uncanny Dodge grants immunity.", guide: "bard#chelaxian-diva"),
                (key: "bard/chelaxian-diva/vindictive-soliloquy", blueprint: "6b600329edb14b8ca658a2e8e39b8610", name: "Vindictive Soliloquy", summary: "From 12th level, the song works as a sonic Call Lightning Storm; a DC 30 Persuasion check makes a bolt 5d10 instead of 5d6.", guide: "bard#vindictive-soliloquy"),
            ],
            levels: [
                (level: 1, features: ["bard/bard-proficiencies", "bard/chelaxian-diva/famous", "bard/inspire-courage"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["bard/chelaxian-diva/devastating-aria"], selections: ["rogue/rogue-talents"]),
                (level: 3, features: ["bard/chelaxian-diva/tragedy-of-false-hope"]),
                (level: 5, features: ["bard/chelaxian-diva/prima-donna"]),
                (level: 6, features: ["bard/chelaxian-diva/deadly-vibrato"], selections: ["rogue/rogue-talents"]),
                (level: 7, features: ["bard/bardic-performance-move-action", "bard/chelaxian-diva/devastating-aria"]),
                (level: 9, features: ["bard/chelaxian-diva/blazing-rondo"]),
                (level: 10, selections: ["rogue/rogue-talents"]),
                (level: 11, features: ["bard/chelaxian-diva/devastating-aria"]),
                (level: 12, features: ["bard/chelaxian-diva/vindictive-soliloquy"]),
                (level: 14, features: ["bard/chelaxian-diva/deadly-vibrato", "bard/frightening-tune"], selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["bard/chelaxian-diva/devastating-aria"]),
                (level: 16, features: ["bard/chelaxian-diva/banshees-requiem"]),
                (level: 19, features: ["bard/chelaxian-diva/devastating-aria"]),
                (level: 20, features: ["bard/chelaxian-diva/deadly-vibrato", "bard/deadly-performance"]),
            ],
        ),
        (
            key: "bard/dirge-bard",
            blueprint: "f128f6cd9c140284caa244da069f250c",
            name: "Dirge Bard",
            summary: "Bard with necromantic spells and powers over the dead.",
            guide: "bard#dirge-bard",
            features: [
                (key: "bard/dirge-bard/dance-of-the-dead", blueprint: "88550ccfc7811884bb859c35fcf0b109", name: "Dance of the Dead", summary: "From 10th level, your performance animates dead bodies as Animate Dead.", guide: "bard#dance-of-the-dead"),
                (key: "bard/dirge-bard/haunted-eyes", blueprint: "44ccf877fb894944a87c81cd8851e37f", name: "Haunted Eyes", summary: "From 2nd level, +4 to saves against fear, curses, death effects and necromancy.", guide: "bard#haunted-eyes"),
                (key: "bard/dirge-bard/haunting-refrain", blueprint: "d90802b1a74ae004aac439036263825a", name: "Haunting Refrain", summary: "From 5th level, half level to Intimidate and +2 to fear spell DCs, +1 every 5 levels (max +5).", guide: "bard#haunting-refrain"),
                (key: "bard/dirge-bard/secrets-of-the-grave", blueprint: "ff657fbdd7576f647a24fbe25f684e18", name: "Secrets of the Grave", summary: "Half level to Lore (Religion), mind-affecting spells work on undead, and adds Cause Fear, Command Undead, Fear and more to known spells.", guide: "bard#secrets-of-the-grave"),
            ],
            levels: [
                (level: 2, features: ["bard/dirge-bard/haunted-eyes", "bard/dirge-bard/secrets-of-the-grave"], selections: ["rogue/rogue-talents"]),
                (level: 5, features: ["bard/dirge-bard/haunting-refrain", "bard/lore-master"]),
                (level: 10, features: ["bard/dirge-bard/dance-of-the-dead", "bard/dirge-bard/haunting-refrain"], selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["bard/dirge-bard/haunting-refrain", "bard/inspire-heroics"]),
                (level: 20, features: ["bard/deadly-performance", "bard/dirge-bard/haunting-refrain"]),
            ],
        ),
        (
            key: "bard/flame-dancer",
            blueprint: "e7914f2adcdb8fc46af5b65d1e06c539",
            name: "Flame Dancer",
            summary: "Bard whose performance protects allies from fire and who learns fire spells.",
            guide: "bard#flame-dancer",
            features: [
                (key: "bard/flame-dancer/detect-magic", blueprint: "ee0b69e90bac14446a4cf9a050f87f2e", name: "Detect Magic", guide: "bard#flame-dancer"),
                (key: "bard/flame-dancer/fan-the-flames", blueprint: "a317c030f0b3f304f84f2a52e7258e6a", name: "Fan the Flames", summary: "From 8th level, your spell list gains Burning Hands, Burning Arc and Fireball.", guide: "bard#fan-the-flames"),
                (key: "bard/flame-dancer/fire-dance", blueprint: "3c10a0069e7f110499d2e810f4861a6e", name: "Fire Dance", summary: "From 3rd level, your performance gives allies within 30 feet fire resistance 10, 20 at 6th and 30 at 11th.", guide: "bard#fire-dance"),
            ],
            levels: [
                (level: 1, features: ["bard/bard-proficiencies", "bard/bardic-knowledge", "bard/flame-dancer/detect-magic", "bard/inspire-courage"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["bard/flame-dancer/fire-dance"]),
                (level: 6, features: ["bard/fascinate", "bard/flame-dancer/fire-dance"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["bard/flame-dancer/fan-the-flames"]),
                (level: 11, features: ["bard/flame-dancer/fire-dance"]),
            ],
        ),
        (
            key: "bard/thundercaller",
            blueprint: "3c67fb6458752a1419fb8cd4efaf8eaa",
            name: "Thundercaller",
            summary: "Shaman-like bard whose performances call thunder, lightning and rage.",
            guide: "bard#thundercaller",
            features: [
