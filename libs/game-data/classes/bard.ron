Class(
    key: "bard",
    name: "Bard",
    summary: "Charisma-based spontaneous arcane caster up to 6th level: 3/4 BAB, good Reflex and Will, all class skills and party-buffing performances.",
    guide: "bard",
    skill_points: 4,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Good,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
    spontaneous: true,
    features: [
        (key: "bard/bard-proficiencies", name: "Bard Proficiencies", summary: "Simple weapons, longsword, rapier, short sword, shortbow, light armour and shields.", guide: "bard#bard-proficiencies"),
        (key: "bard/bardic-knowledge", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "bard#bardic-knowledge"),
        (key: "bard/bardic-performance-move-action", name: "Bardic Performance (Move Action)", summary: "From 7th level, a performance can be started as a move action rather than a standard one.", guide: "bard#bardic-performance-move-action"),
        (key: "bard/bardic-performance-swift-action", name: "Bardic Performance (Swift Action)", summary: "From 13th level, starts a performance as a swift action.", guide: "bard#bardic-performance-swift-action"),
        (key: "bard/deadly-performance", name: "Deadly Performance", summary: "At 20th level, once a day, an enemy within 30 feet hearing 1 round of song saves (DC 20 + Cha) or dies; on a save it is staggered 1-4 rounds.", guide: "bard#deadly-performance"),
        (key: "bard/dirge-of-doom", name: "Dirge of Doom", summary: "From 8th level, Fascinate also makes its targets shaken.", guide: "bard#dirge-of-doom"),
        (key: "bard/fascinate", name: "Fascinate", summary: "From 6th level, creatures within 30 feet save on Will (DC 10 + half level + Cha) or are fascinated and stop moving until damaged.", guide: "bard#fascinate"),
        (key: "bard/frightening-tune", name: "Frightening Tune", summary: "From 14th level, Fascinate also inflicts fear (DC 10 + half level + Cha).", guide: "bard#frightening-tune"),
        (key: "bard/inspire-competence", name: "Inspire Competence", summary: "From 3rd level, allies within 30 feet get +2 competence to skill checks, +1 at 7th, 11th, 15th and 19th (max +6).", guide: "bard#inspire-competence"),
        (key: "bard/inspire-courage", name: "Inspire Courage", summary: "Allies get +1 morale to saves against charm and fear and +1 competence to attack and damage; +2 at 5th, +3 at 11th, +4 at 17th.", guide: "bard#inspire-courage"),
        (key: "bard/inspire-greatness", name: "Inspire Greatness", summary: "From 9th level, allies gain 2d10 hit points, +2 competence to attacks and +1 competence to Fortitude saves.", guide: "bard#inspire-greatness"),
        (key: "bard/inspire-heroics", name: "Inspire Heroics", summary: "From 15th level, allies get +4 morale to saves and +4 dodge AC.", guide: "bard#inspire-heroics"),
        (key: "bard/jack-of-all-trades", name: "Jack of All Trades", summary: "From 10th level, +1 to all skill checks.", guide: "bard#jack-of-all-trades"),
        (key: "bard/lore-master", name: "Lore Master", summary: "From 5th level, may take 10 on Knowledge and Lore checks in skills where she has ranks.", guide: "bard#lore-master"),
        (key: "bard/soothing-performance", name: "Soothing Performance", summary: "From 12th level, 4 rounds of performance work as Mass Cure Serious Wounds and remove fatigued, sickened and shaken from allies.", guide: "bard#soothing-performance"),
        (key: "bard/well-versed", name: "Well Versed", summary: "From 2nd level, saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "bard#well-versed"),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["bard/bard-proficiencies", "bard/bardic-knowledge", "bard/inspire-courage"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, arcane_spell_level: 1, features: ["bard/well-versed"], selections: ["rogue/rogue-talents"]),
        (level: 3, arcane_spell_level: 1, features: ["bard/inspire-competence"]),
        (level: 4, arcane_spell_level: 2),
        (level: 5, arcane_spell_level: 2, features: ["bard/lore-master"]),
        (level: 6, arcane_spell_level: 2, features: ["bard/fascinate"], selections: ["rogue/rogue-talents"]),
        (level: 7, arcane_spell_level: 3, features: ["bard/bardic-performance-move-action"]),
        (level: 8, arcane_spell_level: 3, features: ["bard/dirge-of-doom"]),
        (level: 9, arcane_spell_level: 3, features: ["bard/inspire-greatness"]),
        (level: 10, arcane_spell_level: 4, features: ["bard/jack-of-all-trades"], selections: ["rogue/rogue-talents"]),
        (level: 11, arcane_spell_level: 4),
        (level: 12, arcane_spell_level: 4, features: ["bard/soothing-performance"]),
        (level: 13, arcane_spell_level: 5, features: ["bard/bardic-performance-swift-action"]),
        (level: 14, arcane_spell_level: 5, features: ["bard/frightening-tune"], selections: ["rogue/rogue-talents"]),
        (level: 15, arcane_spell_level: 5, features: ["bard/inspire-heroics"]),
        (level: 16, arcane_spell_level: 6),
        (level: 17, arcane_spell_level: 6),
        (level: 18, arcane_spell_level: 6, selections: ["rogue/rogue-talents"]),
        (level: 19, arcane_spell_level: 6),
        (level: 20, arcane_spell_level: 6, features: ["bard/deadly-performance"]),
    ],
    archetypes: [
        (
            key: "bard/archaeologist",
            name: "Archaeologist",
            summary: "Rogue-like bard with a luck bonus, Evasion, Uncanny Dodge and bard talents (advanced rogue talents from 10th) instead of performances.",
            guide: "bard#archaeologist",
            features: [
                (key: "bard/archaeologist/advanced-talents", name: "Advanced Talents", summary: "From 10th level, can choose advanced rogue talents.", guide: "bard#advanced-talents"),
                (key: "bard/archaeologist/archaeologists-luck", name: "Archaeologist\'s Luck", summary: "4 + Cha rounds a day (+2 per level): +1 luck to attacks, saves, skills and weapon damage; +2 at 5th, +3 at 11th, +4 at 17th.", guide: "bard#archaeologists-luck"),
                (key: "bard/archaeologist/clever-explorer", name: "Clever Explorer", summary: "From 2nd level, adds half the class level to Trickery and Perception checks.", guide: "bard#clever-explorer"),
                (key: "bard/archaeologist/confident-explorer", name: "Confident Explorer", summary: "From 6th level, can always take 10 on Trickery checks.", guide: "bard#confident-explorer"),
                (key: "bard/archaeologist/danger-sense", name: "Danger Sense", summary: "From 3rd level, +1 to Reflex and dodge AC against traps and to Perception against surprise, +1 every 3 levels (max +6).", guide: "bard#danger-sense"),
                (key: "bard/archaeologist/detect-magic", name: "Detect Magic", guide: "bard#archaeologist"),
                (key: "bard/archaeologist/evasion", name: "Evasion", summary: "From 6th level, a successful Reflex save against a half-damage effect means no damage.", guide: "bard#evasion"),
                (key: "bard/archaeologist/uncanny-dodge", name: "Uncanny Dodge", summary: "From 2nd level, never caught flat-footed and keeps her Dexterity bonus to AC against invisible attackers.", guide: "bard#uncanny-dodge"),
            ],
            levels: [
                (level: 1, features: ["bard/archaeologist/archaeologists-luck", "bard/archaeologist/detect-magic", "bard/bard-proficiencies", "bard/bardic-knowledge"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["bard/archaeologist/clever-explorer", "bard/archaeologist/uncanny-dodge"], selections: ["rogue/rogue-talents"]),
                (level: 3, features: ["bard/archaeologist/danger-sense"]),
                (level: 6, features: ["bard/archaeologist/confident-explorer", "bard/archaeologist/evasion"], selections: ["rogue/rogue-talents"]),
                (level: 7),
                (level: 8),
                (level: 9),
                (level: 10, features: ["bard/archaeologist/advanced-talents", "bard/jack-of-all-trades"], selections: ["rogue/rogue-talents"]),
                (level: 11, features: ["bard/inspire-competence"]),
                (level: 12),
                (level: 13),
                (level: 14, selections: ["rogue/rogue-talents"]),
                (level: 15),
                (level: 20),
            ],
        ),
        (
            key: "bard/beast-tamer",
            name: "Beast Tamer",
            summary: "Bard who summons nature's allies and inspires animals, with fewer party buffs.",
            guide: "bard#beast-tamer",
            features: [
                (key: "bard/beast-tamer/beast-call", name: "Beast Call", summary: "Summon Nature's Ally as a standard-action spell-like ability 3 + Cha times a day, its level rising every 2 levels to IX at 17th.", guide: "bard#beast-call"),
                (key: "bard/beast-tamer/inspire-ferocity", name: "Inspire Ferocity", summary: "Animal companions and summons get +1 morale vs charm and fear and +1 to attack and damage (up to +4), later Magic Fang and better DR bypass.", guide: "bard#inspire-ferocity"),
                (key: "bard/beast-tamer/spontaneous-summoning", name: "Spontaneous Summoning", summary: "Can swap any prepared spell for a Summon Nature's Ally spell of the same level.", guide: "bard#spontaneous-summoning"),
                (key: "bard/beast-tamer/summon-natures-ally-i", name: "Summon Nature\'s Ally I", summary: "Beast Call summons with Summon Nature's Ally I from 1st level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-ii", name: "Summon Nature\'s Ally II", summary: "Beast Call summons with Summon Nature's Ally II from 3rd level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-iii", name: "Summon Nature\'s Ally III", summary: "Beast Call summons with Summon Nature's Ally III from 5th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-iv", name: "Summon Nature\'s Ally IV", summary: "Beast Call summons with Summon Nature's Ally IV from 7th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-ix", name: "Summon Nature\'s Ally IX", summary: "Beast Call summons with Summon Nature's Ally IX from 17th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-v", name: "Summon Nature\'s Ally V", summary: "Beast Call summons with Summon Nature's Ally V from 9th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-vi", name: "Summon Nature\'s Ally VI", summary: "Beast Call summons with Summon Nature's Ally VI from 11th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-vii", name: "Summon Nature\'s Ally VII", summary: "Beast Call summons with Summon Nature's Ally VII from 13th level.", guide: "bard#beast-tamer"),
                (key: "bard/beast-tamer/summon-natures-ally-viii", name: "Summon Nature\'s Ally VIII", summary: "Beast Call summons with Summon Nature's Ally VIII from 15th level.", guide: "bard#beast-tamer"),
            ],
            levels: [
                (level: 1, features: ["bard/bard-proficiencies", "bard/bardic-knowledge", "bard/beast-tamer/beast-call", "bard/beast-tamer/inspire-ferocity", "bard/beast-tamer/spontaneous-summoning", "bard/beast-tamer/summon-natures-ally-i"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["bard/well-versed"], feats: ["augment-summoning"]),
                (level: 3, features: ["bard/beast-tamer/summon-natures-ally-ii"]),
                (level: 5, features: ["bard/beast-tamer/summon-natures-ally-iii", "bard/lore-master"]),
                (level: 7, features: ["bard/bardic-performance-move-action", "bard/beast-tamer/summon-natures-ally-iv"]),
                (level: 8),
                (level: 9, features: ["bard/beast-tamer/summon-natures-ally-v", "bard/inspire-greatness"]),
                (level: 10, features: ["bard/jack-of-all-trades"]),
                (level: 11, features: ["bard/beast-tamer/summon-natures-ally-vi"]),
                (level: 13, features: ["bard/bardic-performance-swift-action", "bard/beast-tamer/summon-natures-ally-vii"]),
                (level: 14, selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["bard/beast-tamer/summon-natures-ally-viii", "bard/inspire-heroics"]),
                (level: 17, features: ["bard/beast-tamer/summon-natures-ally-ix"]),
            ],
        ),
        (
            key: "bard/chelaxian-diva",
            name: "Chelaxian Diva",
            summary: "Dance of Masks bard with damaging and debilitating opera songs instead of most standard performances.",
            guide: "bard#chelaxian-diva",
            features: [
                (key: "bard/chelaxian-diva/banshees-requiem", name: "Banshee\'s Requiem", summary: "From 16th level, the song gives living creatures within 30 feet 2 negative levels unless they save on Fortitude.", guide: "bard#banshees-requiem"),
                (key: "bard/chelaxian-diva/blazing-rondo", name: "Blazing Rondo", summary: "From 9th level, the song hastes allies within 60 feet (bonuses of a fifth of her level); 3+ rounds risks fatigue.", guide: "bard#blazing-rondo"),
                (key: "bard/chelaxian-diva/deadly-vibrato", name: "Deadly Vibrato", summary: "From 6th level, 1 more round of song adds 1d8 sonic damage (Fort negates), 2d8 at 14th and 3d8 at 20th.", guide: "bard#deadly-vibrato"),
                (key: "bard/chelaxian-diva/devastating-aria", name: "Devastating Aria", summary: "From 2nd level, 1d6 + level sonic damage to an object (half to creatures), +1d6 at 7th and every 4 levels (max 5d6).", guide: "bard#devastating-aria"),
                (key: "bard/chelaxian-diva/famous", name: "Famous", summary: "Persuasion (Bluff and Diplomacy) checks get a bonus of half the class level.", guide: "bard#famous"),
                (key: "bard/chelaxian-diva/prima-donna", name: "Prima Donna", summary: "From 5th level, 1 round of performance raises her songs' save DCs by +2.", guide: "bard#prima-donna"),
                (key: "bard/chelaxian-diva/tragedy-of-false-hope", name: "Tragedy of False Hope", summary: "From 3rd level, the song leaves enemies within 30 feet flat-footed unless they save on Will; Uncanny Dodge grants immunity.", guide: "bard#chelaxian-diva"),
                (key: "bard/chelaxian-diva/vindictive-soliloquy", name: "Vindictive Soliloquy", summary: "From 12th level, the song works as a sonic Call Lightning Storm; a DC 30 Persuasion check makes a bolt 5d10 instead of 5d6.", guide: "bard#vindictive-soliloquy"),
            ],
            levels: [
                (level: 1, features: ["bard/bard-proficiencies", "bard/chelaxian-diva/famous", "bard/inspire-courage"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["bard/chelaxian-diva/devastating-aria"], selections: ["rogue/rogue-talents"]),
                (level: 3, features: ["bard/chelaxian-diva/tragedy-of-false-hope"]),
                (level: 5, features: ["bard/chelaxian-diva/prima-donna"]),
                (level: 6, features: ["bard/chelaxian-diva/deadly-vibrato"], selections: ["rogue/rogue-talents"]),
                (level: 9, features: ["bard/chelaxian-diva/blazing-rondo"]),
                (level: 10, selections: ["rogue/rogue-talents"]),
                (level: 12, features: ["bard/chelaxian-diva/vindictive-soliloquy"]),
                (level: 15),
                (level: 16, features: ["bard/chelaxian-diva/banshees-requiem"]),
            ],
        ),
        (
            key: "bard/dirge-bard",
            name: "Dirge Bard",
            summary: "Bard with necromantic spells and powers over the dead.",
            guide: "bard#dirge-bard",
            features: [
                (key: "bard/dirge-bard/dance-of-the-dead", name: "Dance of the Dead", summary: "From 10th level, her performance animates dead bodies as Animate Dead.", guide: "bard#dance-of-the-dead"),
                (key: "bard/dirge-bard/haunted-eyes", name: "Haunted Eyes", summary: "From 2nd level, +4 to saves against fear, curses, death effects and necromancy.", guide: "bard#haunted-eyes"),
                (key: "bard/dirge-bard/haunting-refrain", name: "Haunting Refrain", summary: "From 5th level, half level to Intimidate and +2 to fear spell DCs, +1 every 5 levels (max +5).", guide: "bard#haunting-refrain"),
                (key: "bard/dirge-bard/secrets-of-the-grave", name: "Secrets of the Grave", summary: "Half level to Lore (Religion), mind-affecting spells work on undead, and adds Cause Fear, Command Undead, Fear and more to known spells.", guide: "bard#secrets-of-the-grave"),
            ],
            levels: [
                (level: 2, features: ["bard/dirge-bard/haunted-eyes", "bard/dirge-bard/secrets-of-the-grave"], selections: ["rogue/rogue-talents"]),
                (level: 5, features: ["bard/dirge-bard/haunting-refrain", "bard/lore-master"]),
                (level: 10, features: ["bard/dirge-bard/dance-of-the-dead"], selections: ["rogue/rogue-talents"]),
            ],
        ),
        (
            key: "bard/flame-dancer",
            name: "Flame Dancer",
            summary: "Bard whose performance protects allies from fire and who learns fire spells.",
            guide: "bard#flame-dancer",
            features: [
                (key: "bard/flame-dancer/detect-magic", name: "Detect Magic", guide: "bard#flame-dancer"),
                (key: "bard/flame-dancer/fan-the-flames", name: "Fan the Flames", summary: "From 8th level, her spell list gains Burning Hands, Burning Arc and Fireball.", guide: "bard#fan-the-flames"),
                (key: "bard/flame-dancer/fire-dance", name: "Fire Dance", summary: "From 3rd level, her performance gives allies within 30 feet fire resistance 10, 20 at 6th and 30 at 11th.", guide: "bard#fire-dance"),
            ],
            levels: [
                (level: 1, features: ["bard/bard-proficiencies", "bard/bardic-knowledge", "bard/flame-dancer/detect-magic", "bard/inspire-courage"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["bard/flame-dancer/fire-dance"]),
                (level: 8, features: ["bard/flame-dancer/fan-the-flames"]),
            ],
        ),
        (
            key: "bard/thundercaller",
            name: "Thundercaller",
            summary: "Shaman-like bard whose performances call thunder, lightning and rage.",
            guide: "bard#thundercaller",
            features: [
                (key: "bard/thundercaller/bound-to-the-land", name: "Bound to the Land", summary: "Adds half the class level to Lore (Nature) checks.", guide: "bard#bound-to-the-land"),
                (key: "bard/thundercaller/incite-rage", name: "Incite Rage", summary: "From 6th level, allies or enemies failing a Will save rage: +2 Str and Con, +1 Will, -2 AC and no spellcasting.", guide: "bard#incite-rage"),
                (key: "bard/thundercaller/storm-call", name: "Storm Call", summary: "From 8th level, her performance calls a 3d6 lightning bolt each round (3d10 in a storm).", guide: "bard#storm-call"),
                (key: "bard/thundercaller/storm-call-greater", name: "Storm Call, Greater", summary: "From 14th level, Storm Call bolts deal 5d6 (5d10 in a storm).", guide: "bard#storm-call-greater"),
                (key: "bard/thundercaller/thunder-call", name: "Thunder Call", summary: "From 3rd level, a Sound Burst: 1d8 sonic in 10 feet and stun 1 round (Fort negates); 3d8 at 7th, +2d8 per 4 levels (max 9d8).", guide: "bard#thunder-call"),
            ],
            levels: [
                (level: 1, features: ["bard/bard-proficiencies", "bard/inspire-courage", "bard/thundercaller/bound-to-the-land"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["bard/thundercaller/thunder-call"]),
                (level: 6, features: ["bard/fascinate", "bard/thundercaller/incite-rage"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["bard/thundercaller/storm-call"]),
                (level: 14, features: ["bard/frightening-tune", "bard/thundercaller/storm-call-greater"], selections: ["rogue/rogue-talents"]),
            ],
        ),
        (
            key: "bard/tranquil-whisperer",
            name: "Tranquil Whisperer",
            summary: "Bard whose performance calms and protects allies.",
            guide: "bard#tranquil-whisperer",
            features: [
                (key: "bard/tranquil-whisperer/inspire-tranquility", name: "Inspire Tranquility", summary: "Allies get +1 morale AC and have rage suppressed; +1 at 5th and every 6 levels (max +4 at 17th).", guide: "bard#inspire-tranquility"),
                (key: "bard/tranquil-whisperer/saving-tranquility", name: "Saving Tranquility", summary: "From 7th level, Inspire Tranquility's bonus also applies to saves against mind-affecting spells.", guide: "bard#saving-tranquility"),
                (key: "bard/tranquil-whisperer/tranquil-apotheosis", name: "Tranquil Apotheosis", summary: "At 20th level, immune to mind-affecting effects and counts as an outsider.", guide: "bard#tranquil-apotheosis"),
                (key: "bard/tranquil-whisperer/tranquil-senses", name: "Tranquil Senses", summary: "From 13th level, Inspire Tranquility also gives 10-foot blindsense.", guide: "bard#tranquil-senses"),
            ],
            levels: [
                (level: 1, features: ["bard/bard-proficiencies", "bard/bardic-knowledge", "bard/tranquil-whisperer/inspire-tranquility"], feats: ["armor-proficiency-light-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, selections: ["rogue/rogue-talents"]),
                (level: 3),
                (level: 7, features: ["bard/bardic-performance-move-action", "bard/tranquil-whisperer/saving-tranquility"]),
                (level: 13, features: ["bard/bardic-performance-swift-action", "bard/tranquil-whisperer/tranquil-senses"]),
                (level: 20, features: ["bard/tranquil-whisperer/tranquil-apotheosis"]),
            ],
        ),
    ],
)
