        (key: "ranger/combat-style-feat/two-handed-weapon-feats-6", blueprint: "83a4b2605333e004f875e2fd22f6be30", name: "Two-Handed Weapon Feats (from level 6)", guide: "ranger#two-handed-weapon-feats", ignores_prerequisites: true, feats: ["cleave", "cleaving-finish", "dodge", "great-cleave", "great-fortitude", "intimidating-prowess", "iron-will", "lightning-reflexes", "power-attack", "toughness"]),
