    ],
    archetypes: [
        (
            key: "ranger/demonslayer",
            blueprint: "fd8c915590dcc5b41b73b80c3c0da8ee",
            name: "Demonslayer",
            summary: "Ranger whose favoured enemies are only demons, with stronger quarry abilities against evil outsiders.",
            guide: "ranger#demonslayer",
            features: [
                (key: "ranger/demonslayer/demonologist", blueprint: "513ee15f849932e4ca3b6d3ef2091e5f", name: "Demonologist", summary: "From 3rd level, adds half the class level to Knowledge (Arcana) checks.", guide: "ranger#demonologist"),
                (key: "ranger/demonslayer/demonslayer-favored-enemy", blueprint: "f7b7c69d80dd12c40920803a8efb2306", name: "Demonslayer Favored Enemy", summary: "All three demon types are favoured enemies: +2 attack and damage at 1st level, +2 more at 5th, 10th, 15th and 20th.", guide: "ranger#demonslayer-favored-enemy"),
                (key: "ranger/demonslayer/fiendish-quarry", blueprint: "c5a04078f35e23d4dbdb18a1b17dc346", name: "Fiendish Quarry", summary: "From 11th level, against an evil outsider quarry, can trade the +2 attack bonus for weapons counting as good for DR.", guide: "ranger#fiendish-quarry"),
                (key: "ranger/demonslayer/improved-fiendish-quarry", blueprint: "f08bca28b82e32747b03446e3f7f818a", name: "Improved Fiendish Quarry", summary: "From 19th level, against an evil outsider quarry, you can trade the +4 attack bonus for the Holy property on your weapons.", guide: "ranger#improved-fiendish-quarry"),
            ],
            levels: [
                (level: 1, features: ["ranger/demonslayer/demonslayer-favored-enemy"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["ranger/demonslayer/demonologist", "ranger/favored-terrain"]),
                (level: 5, features: ["ranger/demonslayer/demonslayer-favored-enemy"]),
                (level: 10, features: ["ranger/demonslayer/demonslayer-favored-enemy"], feat_slots: [OptionList(selection: "ranger/combat-style-feat")]),
                (level: 11, features: ["ranger/demonslayer/fiendish-quarry"]),
                (level: 15, features: ["ranger/demonslayer/demonslayer-favored-enemy"]),
                (level: 19, features: ["ranger/demonslayer/improved-fiendish-quarry"]),
                (level: 20, features: ["ranger/demonslayer/demonslayer-favored-enemy", "ranger/master-hunter"]),
            ],
        ),
        (
            key: "ranger/espionage-expert",
            blueprint: "7888187acfd26b7499cf255b0d6dcb0e",
            name: "Espionage Expert",
            summary: "Charisma-casting urban ranger with skill bonuses, no animal companion and no favoured terrains.",
            guide: "ranger#espionage-expert",
            class_skills: ["knowledge-arcana", "knowledge-world", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
            features: [
                (key: "ranger/espionage-expert/espionage-expert-magic", blueprint: "babd11fd792fe404ebdcb035af80229a", name: "Espionage Expert Magic", summary: "You use Charisma as your casting attribute.", guide: "ranger#espionage-expert-magic"),
                (key: "ranger/espionage-expert/espionage-master", blueprint: "5d83bd56c95a5d14ab739bae65d488a8", name: "Espionage Master", summary: "At 20th level, 5 times a day, a standard-action attack on a favoured enemy forces a Fort save (DC 20 + Cha) or death; once per creature.", guide: "ranger#espionage-master"),
                (key: "ranger/espionage-expert/rangers-bond", blueprint: "6dddf5ba2291f41498df2df7f8fa2b35", name: "Ranger\'s Bond", guide: "ranger#espionage-expert"),
                (key: "ranger/espionage-expert/trapfinding", blueprint: "d55acf213bf709c40b2bc72b997fb345", name: "Trapfinding", summary: "Adds half the class level to Perception checks.", guide: "ranger#trapfinding"),
                (key: "ranger/espionage-expert/undercover", blueprint: "4b575457914597c41b6925896be1b7b6", name: "Undercover", summary: "From 3rd level, adds half the class level to Bluff and Stealth checks.", guide: "ranger#undercover"),
            ],
            levels: [
                (level: 1, features: ["ranger/espionage-expert/trapfinding", "ranger/favored-enemy"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["ranger/espionage-expert/undercover"]),
                (level: 4, features: ["ranger/espionage-expert/espionage-expert-magic", "ranger/espionage-expert/rangers-bond"]),
                (level: 8),
                (level: 12),
                (level: 13),
                (level: 18, feat_slots: [OptionList(selection: "ranger/combat-style-feat")]),
                (level: 20, features: ["ranger/espionage-expert/espionage-master", "ranger/favored-enemy"]),
            ],
        ),
        (
            key: "ranger/flamewarden",
            blueprint: "300917c3479d27d47b4b4b52b1762e8d",
            name: "Flamewarden",
            summary: "Ranger with fire powers instead of an animal companion.",
            guide: "ranger#flamewarden",
            features: [
                (key: "ranger/flamewarden/burning-renewal", blueprint: "7cf2a6bf35c422e4ea219fcc2eb564f5", name: "Burning Renewal", summary: "From 12th level, taking 10+ fire damage removes fatigue, fear, sickness and nausea and heals 1d6 ability damage and drain; 3 + Wis a day.", guide: "ranger#burning-renewal"),
                (key: "ranger/flamewarden/phoenix-blast", blueprint: "9a1fc45d57567e946a20926f891453ed", name: "Phoenix Blast", summary: "From 16th level, on death you explode: 10d6 to enemies within 10 feet (Reflex half), and allies heal 5d6 and lose poisons.", guide: "ranger#flamewarden"),
                (key: "ranger/flamewarden/phoenix-rising", blueprint: "92d8b962250e3a5448c9e1063dc85283", name: "Phoenix Rising", summary: "At 20th level, immune to fire, and once a day you return to life with half your HP when killed.", guide: "ranger#phoenix-rising"),
                (key: "ranger/flamewarden/spellcasting", blueprint: "2cb57c0d74d143f4da1ef6704012b0f4", name: "Spellcasting", summary: "Can choose fire spells: Firebelly and Small Fire Elemental at 4th, Scorching Ray at 7th, more elementals, Flamestrike and Volcanic Storm later.", guide: "ranger#spellcasting"),
                (key: "ranger/flamewarden/stoking-the-embers", blueprint: "1a0aad85379212f46bd921dcdcb8cfaa", name: "Stoking the Embers", summary: "From 9th level, once a day revives an ally dead within 1 round with 5d8 + caster level HP.", guide: "ranger#stoking-the-embers"),
