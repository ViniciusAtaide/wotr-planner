Class(
    key: "ranger",
    blueprint: "cda0615668a6df14eb36ba19ee881af6",
    name: "Ranger",
    summary: "Dexterity and Wisdom hunter: full BAB, good Fortitude and Reflex, divine spells to 4th level from 4th, favoured enemies, terrains and combat style feats.",
    guide: "ranger",
    skill_points: 4,
    casting_ability: Wisdom,
    bab: Full,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "perception", "persuasion", "stealth"],
    features: [
        (key: "ranger/camouflage", blueprint: "ff1b5aa8dcc7d7d4d9aa85e1cb3f9e88", name: "Camouflage", summary: "From 12th level, can hide with Stealth in a favoured terrain as a move action, even in combat.", guide: "ranger#camouflage"),
        (key: "ranger/evasion", blueprint: "576933720c440aa4d8d42b0c54b77e80", name: "Evasion", summary: "From 9th level, a successful Reflex save against a half-damage effect means no damage.", guide: "ranger#evasion"),
        (key: "ranger/favored-enemy", blueprint: "c1be13839472aad46b152cf10cf46179", name: "Favored Enemy", summary: "+2 attack and damage against a chosen creature type; another type at 5th, 10th, 15th and 20th, each time raising one bonus by +2.", guide: "ranger#favored-enemy"),
        (key: "ranger/favored-terrain", blueprint: "c4de22ecac494c91b3d2f077ec162bbd", name: "Favored Terrain", summary: "From 3rd level, +2 initiative, Lore (Nature), Perception and Stealth in a chosen terrain; more at 8th, 13th and 18th, each raising one by +2.", guide: "ranger#favored-terrain"),
        (key: "ranger/hunters-bond", blueprint: "b705c5184a96a84428eeb35ae2517a14", name: "Hunter\'s Bond", summary: "Move action: allies within 30 feet get half your favoured enemy bonus for Wis rounds; or an animal companion sharing your enemy and terrain bonuses.", guide: "ranger#hunters-bond"),
        (key: "ranger/improved-evasion", blueprint: "ce96af454a6137d47b9c6a1e02e66803", name: "Improved Evasion", summary: "From 16th level, a failed Reflex save against a half-damage effect deals only half damage.", guide: "ranger#improved-evasion"),
        (key: "ranger/improved-quarry", blueprint: "25e009b7e53f86141adee3a1213af5af", name: "Improved Quarry", summary: "At 19th level, a quarry can be marked as a free action and its attack bonus rises to +4.", guide: "ranger#improved-quarry"),
        (key: "ranger/master-hunter", blueprint: "9d53ef63441b5d84297587d75f72fc17", name: "Master Hunter", summary: "At 20th level, 5 times a day, a standard-action attack on a favoured enemy forces a Fort save (DC 20 + Wis) or death; once per creature.", guide: "ranger#master-hunter"),
        (key: "ranger/quarry", blueprint: "385260ca07d5f1b4e907ba22a02944fc", name: "Quarry", summary: "From 11th level, standard action to mark one quarry: +2 insight to attack it and every critical hit against it is confirmed.", guide: "ranger#quarry"),
    ],
    selections: [
        (
            key: "ranger/combat-style-feat",
            blueprint: "c6d0da9124735a44f93ac31df803b9a9",
            name: "Combat Style",
            summary: "A combat feat from your style, ignoring its prerequisites, or Dodge, Great Fortitude, Iron Will, Lightning Reflexes or Toughness; Skill Focus from 10th.",
            guide: "ranger#combat-style-feat",
            option_levels: ["ranger"],
            options: [
                (
                    key: "ranger/combat-style-feat/archery-feats",
                    blueprint: "3cf94df3f1cf9a443a880bc1ae9be3c6",
                    name: "Archery Feats",
                    summary: "Point Blank Shot, Precise Shot, Rapid Shot; from 6th Improved Precise Shot, Point Blank Master, Manyshot; from 10th Improved Critical.",
                    guide: "ranger#archery-feats",
                    levels: [
                        (level: 2, feat_list: "ranger/combat-style-feat/archery-feats-2"),
                        (level: 6, feat_list: "ranger/combat-style-feat/archery-feats-6"),
                        (level: 10, feat_list: "ranger/combat-style-feat/archery-feats-10"),
                    ],
                ),
                (
                    key: "ranger/combat-style-feat/menacing-feats",
                    blueprint: "1c5988e90e0657645972e7b28ba4ce8b",
                    name: "Menacing Feats",
                    summary: "Dazzling Display, Power Attack, Intimidating Prowess; from 6th Cornugon Smash, Shatter Defenses; from 10th Dreadful Carnage, Improved Critical.",
                    guide: "ranger#menacing-feats",
                    levels: [
                        (level: 2, feat_list: "ranger/combat-style-feat/menacing-feats-2"),
                        (level: 6, feat_list: "ranger/combat-style-feat/menacing-feats-6"),
                        (level: 10, feat_list: "ranger/combat-style-feat/menacing-feats-10"),
                    ],
                ),
                (
                    key: "ranger/combat-style-feat/two-handed-weapon-feats",
                    blueprint: "f489d9f696c588d43907b879d89451be",
                    name: "Two-Handed Weapon Feats",
                    summary: "Cleave, Power Attack, Intimidating Prowess; from 6th Cleaving Finish, Great Cleave; from 10th Dreadful Carnage, Critical Focus.",
                    guide: "ranger#two-handed-weapon-feats",
                    levels: [
                        (level: 2, feat_list: "ranger/combat-style-feat/two-handed-weapon-feats-2"),
                        (level: 6, feat_list: "ranger/combat-style-feat/two-handed-weapon-feats-6"),
                        (level: 10, feat_list: "ranger/combat-style-feat/two-handed-weapon-feats-10"),
                    ],
                ),
                (
                    key: "ranger/combat-style-feat/two-weapon-combat-feats",
                    blueprint: "019e68517c95c5447bff125b8a91c73f",
                    name: "Two-Weapon Combat Feats",
                    summary: "Double Slice, Shield Bash, Two-Weapon Fighting; Improved Two-Weapon Fighting from 6th and Greater Two-Weapon Fighting from 10th.",
                    guide: "ranger#two-weapon-combat-feats",
                    levels: [
                        (level: 2, feat_list: "ranger/combat-style-feat/two-weapon-combat-feats-2"),
                        (level: 6, feat_list: "ranger/combat-style-feat/two-weapon-combat-feats-6"),
                        (level: 10, feat_list: "ranger/combat-style-feat/two-weapon-combat-feats-10"),
                    ],
                ),
                (
                    key: "ranger/combat-style-feat/weapon-and-shield-feats",
                    blueprint: "2d54cc761ab82604f93d82b4b358cf7e",
                    name: "Weapon and Shield Feats",
                    summary: "Shield Bash, Shield Focus, Two-Weapon Fighting; from 6th Improved TWF, Shield Master; from 10th Bashing Finish, Greater TWF.",
                    guide: "ranger#weapon-and-shield-feats",
                    levels: [
                        (level: 2, feat_list: "ranger/combat-style-feat/weapon-and-shield-feats-2"),
                        (level: 6, feat_list: "ranger/combat-style-feat/weapon-and-shield-feats-6"),
                        (level: 10, feat_list: "ranger/combat-style-feat/weapon-and-shield-feats-10"),
                    ],
                ),
            ],
        ),
    ],
    feat_lists: [
        (key: "ranger/bonus-feats-10b", blueprint: "7ef950ca681955d47bc4efbe77073e2c", name: "Archery Feats (from level 10)", guide: "ranger#archery-feats", ignores_prerequisites: true, feats: ["improved-critical", "improved-precise-shot", "manyshot", "point-blank-master", "point-blank-shot", "precise-shot", "rapid-shot"]),
