        ),
        (
            key: "fighter/armiger",
            blueprint: "fdee5f25a5d0fe0448d093b462435c0c",
            name: "Armiger",
            summary: "Hellknight-in-training fighter with order abilities and two fewer bonus combat feats.",
            guide: "fighter#armiger",
            skill_points: 3,
            features: [
                (key: "fighter/armiger/ardent", blueprint: "fcffd9b743a98784fb9e293c22ee6aff", name: "Ardent", summary: "From 2nd level, +1 to saves against charm and compulsion (+1 per 4 levels, max +5) and one reroll a day on a failed one.", guide: "fighter#ardent"),
                (key: "fighter/armiger/studious-squire", blueprint: "0c5065ffc67c4494cba9a14226714ae6", name: "Studious Squire", summary: "+1 skill point per level.", guide: "fighter#studious-squire"),
            ],
            selections: [
                (
                    key: "fighter/armiger/order",
                    blueprint: "e31d849e4eb2578458419c9df622270f",
                    name: "Order",
                    summary: "Joins one of seven Hellknight orders, each granting its own bonus.",
                    guide: "fighter#order",
                    options: [
                        (key: "fighter/armiger/order/order-of-the-chain", blueprint: "90eb2a2cec75a8f4fb79ed637c082f47", name: "Order of the Chain", summary: "+2 to CMB and CMD from 1st level, +1 at 5th and 9th.", guide: "fighter#order-of-the-chain"),
                        (key: "fighter/armiger/order/order-of-the-gate", blueprint: "475a3716ef4756849acf7c0c855dbe31", name: "Order of the Gate", summary: "Arcane spell failure in armour drops by 5% from 1st level, 10% from 5th and 20% from 9th.", guide: "fighter#order-of-the-gate"),
                        (key: "fighter/armiger/order/order-of-the-godclaw", blueprint: "5636564c278583342aec54eb2b409029", name: "Order of the Godclaw", summary: "Three times a day, a 1-minute aura gives allies within 30 feet +1 morale AC, attack and damage against chaotic foes (+1 at 5th and 9th).", guide: "fighter#order-of-the-godclaw"),
                        (key: "fighter/armiger/order/order-of-the-nail", blueprint: "e506d5dee7944b50824054c6526c6532", name: "Order of the Nail", summary: "+2 attack and damage against one Ranger favoured enemy type, +2 more at 5th and 9th.", guide: "fighter#order-of-the-nail"),
                        (key: "fighter/armiger/order/order-of-the-pyre", blueprint: "603944646bb64a34d8a9e526301398ee", name: "Order of the Pyre", summary: "After taking fire damage, fast healing 5 for rounds equal to class level; 10 from 5th, 15 from 9th.", guide: "fighter#order-of-the-pyre"),
                        (key: "fighter/armiger/order/order-of-the-rack", blueprint: "9ff89287e89287c4498d551d88221447", name: "Order of the Rack", summary: "Standard action, 3 times a day (+1 at 5th and 9th) and on crits: a creature saves on Will or cannot cast for class level rounds.", guide: "fighter#order-of-the-rack"),
                        (key: "fighter/armiger/order/order-of-the-scourge", blueprint: "552f196e7a10bea4b9a5e7cb0147c89f", name: "Order of the Scourge", summary: "Your killing blows give enemies within 15 feet -2 to Will saves for 3 rounds, -3 from 5th and -4 from 9th.", guide: "fighter#order-of-the-scourge"),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["fighter/armiger/studious-squire"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"], selections: ["fighter/armiger/order"]),
                (level: 2, features: ["fighter/armiger/ardent"], feat_slots: [CombatFeat]),
                (level: 6, features: ["fighter/armiger/ardent"], feat_slots: [CombatFeat]),
                (level: 10, features: ["fighter/armiger/ardent"]),
                (level: 14, features: ["fighter/armiger/ardent"], feat_slots: [CombatFeat]),
                (level: 18, features: ["fighter/armiger/ardent"], feat_slots: [CombatFeat]),
