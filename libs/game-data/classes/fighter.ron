Class(
    key: "fighter",
    name: "Fighter",
    summary: "Strength and Constitution warrior: full BAB, good Fortitude, 2 skill points per level, many bonus combat feats, armour and weapon training.",
    guide: "fighter",
    skill_points: 2,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["athletics", "knowledge-world", "lore-nature", "persuasion"],
    features: [
        (key: "fighter/armor-mastery", name: "Armor Mastery", summary: "At 19th level, DR 5/- while wearing armour or using a shield.", guide: "fighter#armor-mastery"),
        (key: "fighter/armor-training", name: "Armor Training", summary: "From 3rd level, armour check penalty -1 and max Dex +1, +1 more every 4 levels (max 4); full speed in medium armour, heavy from 7th.", guide: "fighter#armor-training"),
        (key: "fighter/bravery", name: "Bravery", summary: "From 2nd level, +1 to Will saves against fear, +1 more every 4 levels (max +5 at 18th).", guide: "fighter#bravery"),
        (key: "fighter/weapon-mastery", name: "Weapon Mastery", summary: "At 20th level, with one chosen weapon type, crits auto-confirm, the multiplier rises by 1 and you cannot be disarmed.", guide: "fighter#weapon-mastery"),
        (key: "fighter/weapon-training", name: "Weapon Training", summary: "From 5th level, +1 attack, damage and CMB with a weapon group; a new group every 4 levels, raising earlier groups by +1.", guide: "fighter#weapon-training"),
    ],
    levels: [
        (level: 1, feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"], feat_slots: [CombatFeat]),
        (level: 2, features: ["fighter/bravery"], feat_slots: [CombatFeat]),
        (level: 3, features: ["fighter/armor-training"]),
        (level: 4, feat_slots: [CombatFeat]),
        (level: 5, features: ["fighter/weapon-training"]),
        (level: 6, feat_slots: [CombatFeat]),
        (level: 7),
        (level: 8, feat_slots: [CombatFeat]),
        (level: 9),
        (level: 10, feat_slots: [CombatFeat]),
        (level: 11),
        (level: 12, feat_slots: [CombatFeat]),
        (level: 13),
        (level: 14, feat_slots: [CombatFeat]),
        (level: 15),
        (level: 16, feat_slots: [CombatFeat]),
        (level: 17),
        (level: 18, feat_slots: [CombatFeat]),
        (level: 19, features: ["fighter/armor-mastery"]),
        (level: 20, features: ["fighter/weapon-mastery"], feat_slots: [CombatFeat]),
    ],
    archetypes: [
        (
            key: "fighter/aldori-defender",
            name: "Aldori Defender",
            summary: "Dexterity fighter who defends with the Aldori dueling sword, with fewer bonus feats and no Armor Training.",
            guide: "fighter#aldori-defender",
            features: [
                (key: "fighter/aldori-defender/counterattack", name: "Counterattack", summary: "From 10th level, an immediate-action attack of opportunity against a foe in reach who hits you in melee.", guide: "fighter#counterattack"),
                (key: "fighter/aldori-defender/defensive-parry", name: "Defensive Parry", summary: "From 3rd level, a full attack with a dueling sword gives +1 dodge AC against melee until your next turn, +1 per 4 levels (max +5).", guide: "fighter#defensive-parry"),
                (key: "fighter/aldori-defender/disarming-strike", name: "Disarming Strike", summary: "From 6th level, a successful disarm with a dueling sword also deals its normal damage, without Strength.", guide: "fighter#disarming-strike"),
                (key: "fighter/aldori-defender/steel-net", name: "Steel Net", summary: "From 8th level, fighting defensively with a dueling sword costs 2 less on attacks and gives 2 more dodge AC.", guide: "fighter#steel-net"),
                (key: "fighter/aldori-defender/weapon-proficiency-dueling-sword", name: "Weapon Proficiency (Dueling Sword)", summary: "Proficiency with the Aldori dueling sword.", guide: "fighter#aldori-defender"),
            ],
            levels: [
                (level: 1, features: ["fighter/aldori-defender/weapon-proficiency-dueling-sword"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"], feat_slots: [CombatFeat]),
                (level: 3, features: ["fighter/aldori-defender/defensive-parry"]),
                (level: 6, features: ["fighter/aldori-defender/disarming-strike"]),
                (level: 8, features: ["fighter/aldori-defender/steel-net"]),
                (level: 10, features: ["fighter/aldori-defender/counterattack"]),
            ],
        ),
        (
            key: "fighter/armiger",
            name: "Armiger",
            summary: "Hellknight-in-training fighter with order abilities and two fewer bonus combat feats.",
            guide: "fighter#armiger",
            skill_points: 3,
            features: [
                (key: "fighter/armiger/ardent", name: "Ardent", summary: "From 2nd level, +1 to saves against charm and compulsion (+1 per 4 levels, max +5) and one reroll a day on a failed one.", guide: "fighter#ardent"),
                (key: "fighter/armiger/studious-squire", name: "Studious Squire", summary: "+1 skill point per level.", guide: "fighter#studious-squire"),
            ],
            selections: [
                (
                    key: "fighter/armiger/order",
                    name: "Order",
                    summary: "Joins one of seven Hellknight orders, each granting its own bonus.",
                    guide: "fighter#order",
                    options: [
                        (key: "fighter/armiger/order/order-of-the-chain", name: "Order of the Chain", summary: "+2 to CMB and CMD from 1st level, +1 at 5th and 9th.", guide: "fighter#order-of-the-chain"),
                        (key: "fighter/armiger/order/order-of-the-gate", name: "Order of the Gate", summary: "Arcane spell failure in armour drops by 5% from 1st level, 10% from 5th and 20% from 9th.", guide: "fighter#order-of-the-gate"),
                        (key: "fighter/armiger/order/order-of-the-godclaw", name: "Order of the Godclaw", summary: "Three times a day, a 1-minute aura gives allies within 30 feet +1 morale AC, attack and damage against chaotic foes (+1 at 5th and 9th).", guide: "fighter#order-of-the-godclaw"),
                        (key: "fighter/armiger/order/order-of-the-nail", name: "Order of the Nail", summary: "+2 attack and damage against one Ranger favoured enemy type, +2 more at 5th and 9th.", guide: "fighter#order-of-the-nail"),
                        (key: "fighter/armiger/order/order-of-the-pyre", name: "Order of the Pyre", summary: "After taking fire damage, fast healing 5 for rounds equal to class level; 10 from 5th, 15 from 9th.", guide: "fighter#order-of-the-pyre"),
                        (key: "fighter/armiger/order/order-of-the-rack", name: "Order of the Rack", summary: "Standard action, 3 times a day (+1 at 5th and 9th) and on crits: a creature saves on Will or cannot cast for class level rounds.", guide: "fighter#order-of-the-rack"),
                        (key: "fighter/armiger/order/order-of-the-scourge", name: "Order of the Scourge", summary: "Your killing blows give enemies within 15 feet -2 to Will saves for 3 rounds, -3 from 5th and -4 from 9th.", guide: "fighter#order-of-the-scourge"),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["fighter/armiger/studious-squire"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"], selections: ["fighter/armiger/order"]),
                (level: 2, features: ["fighter/armiger/ardent"], feat_slots: [CombatFeat]),
                (level: 10),
            ],
        ),
        (
            key: "fighter/defender-of-the-hearth",
            name: "Defender of the Hearth",
            summary: "Visitors from Morta fighter with shield attacks and blocks, delayed Weapon Training and 3 skill points per level.",
            guide: "fighter#defender-of-the-hearth",
            features: [
                (key: "fighter/defender-of-the-hearth/defenders-gift", name: "Defender\'s Gift", summary: "At 20th level, after a Shield Block your weapon damage is doubled for the next round.", guide: "fighter#defenders-gift"),
                (key: "fighter/defender-of-the-hearth/heaven-strike", name: "Heaven Strike", summary: "From 5th level, once per combat with a weapon and shield, deals weapon damage to every enemy within 20 feet without an attack roll.", guide: "fighter#heaven-strike"),
                (key: "fighter/defender-of-the-hearth/shield-block", name: "Shield Block", summary: "With a heavy or tower shield, the first hit against you deals 20% less damage; +1 attack covered at 5th and every 5 levels (max 5).", guide: "fighter#shield-block"),
            ],
            levels: [
                (level: 1, features: ["fighter/defender-of-the-hearth/shield-block"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"]),
                (level: 5, features: ["fighter/defender-of-the-hearth/heaven-strike"]),
                (level: 9, features: ["fighter/weapon-training"]),
                (level: 20, features: ["fighter/defender-of-the-hearth/defenders-gift"], feat_slots: [CombatFeat]),
            ],
        ),
        (
            key: "fighter/dragonheir-scion",
            name: "Dragonheir Scion",
            summary: "Fighter with a draconic bloodline, losing Armor Training, Armor Mastery and Weapon Mastery.",
            guide: "fighter#dragonheir-scion",
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "persuasion", "use-magic-device"],
            features: [
                (key: "fighter/dragonheir-scion/draconic-defences", name: "Draconic Defences", summary: "From 3rd level, +1 natural armour and resistance 5 to your bloodline's energy; +2 and 10 at 7th, +3 and 20 at 13th.", guide: "fighter#dragonheir-scion"),
                (key: "fighter/dragonheir-scion/draconic-presence", name: "Draconic Presence", summary: "From 6th level, Dazzling Display as a bonus feat, usable as a standard action.", guide: "fighter#draconic-presence"),
                (key: "fighter/dragonheir-scion/draconic-strike", name: "Draconic Strike", summary: "From 4th level, Arcane Strike hits add 1d4 damage of your bloodline's energy type.", guide: "fighter#draconic-strike"),
                (key: "fighter/dragonheir-scion/fearful-might", name: "Fearful Might", summary: "From 2nd level, +1 to Intimidate, +1 more every 4 levels (max +5 at 18th).", guide: "fighter#fearful-might"),
                (key: "fighter/dragonheir-scion/might-of-wyrms", name: "Might of Wyrms", summary: "At 20th level, immune to paralysis, sleep and your bloodline's element, with 60-foot blindsense.", guide: "fighter#might-of-wyrms"),
            ],
            selections: [
                (
                    key: "fighter/dragonheir-scion/bloodline",
                    name: "Draconic Bloodline",
                    summary: "You gain a draconic bloodline, whose energy type your other draconic abilities use.",
                    guide: "fighter#draconic-bloodline",
                    option_levels: ["fighter"],
                    skipped_levels: [1, 3, 15, 20],
                    options: [],
                    shared_options: [
                        "sorcerer/bloodline/draconic-black",
                        "sorcerer/bloodline/draconic-blue",
                        "sorcerer/bloodline/draconic-brass",
                        "sorcerer/bloodline/draconic-bronze",
                        "sorcerer/bloodline/draconic-copper",
                        "sorcerer/bloodline/draconic-gold",
                        "sorcerer/bloodline/draconic-green",
                        "sorcerer/bloodline/draconic-red",
                        "sorcerer/bloodline/draconic-silver",
                        "sorcerer/bloodline/draconic-white",
                    ],
                ),
            ],
            levels: [
                (level: 1, feats: ["arcane-strike", "armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"], selections: ["fighter/dragonheir-scion/bloodline"]),
                (level: 2, features: ["fighter/dragonheir-scion/fearful-might"], feat_slots: [CombatFeat]),
                (level: 3, features: ["fighter/dragonheir-scion/draconic-defences"]),
                (level: 4, features: ["fighter/dragonheir-scion/draconic-strike"]),
                (level: 6, features: ["fighter/dragonheir-scion/draconic-presence"]),
                (level: 15, feats: ["wings"]),
                (level: 19),
                (level: 20, features: ["fighter/dragonheir-scion/might-of-wyrms"], feat_slots: [CombatFeat]),
            ],
        ),
        (
            key: "fighter/mutation-warrior",
            name: "Mutation Warrior",
            summary: "Fighter who uses alchemist mutagens, losing Armor Training and Armor Mastery.",
            guide: "fighter#mutation-warrior",
            skill_points: 3,
            features: [
                (key: "fighter/mutation-warrior/mutagen", name: "Mutagen", summary: "From 3rd level, you use mutagens as the Alchemist does, with duration by your class level.", guide: "fighter#mutagen"),
                (key: "fighter/mutation-warrior/mutagen-discovery", name: "Mutagen Discovery", summary: "At 7th level and every 4 levels, a discovery such as Feral Mutagen, Preserve Organs, Feral Wings or Greater and Grand Mutagen.", guide: "fighter#mutagen-discovery"),
            ],
            levels: [
                (level: 3, features: ["fighter/mutation-warrior/mutagen"]),
                (level: 7, features: ["fighter/mutation-warrior/mutagen-discovery"]),
                (level: 11, features: ["fighter/mutation-warrior/mutagen-discovery"]),
                (level: 15, features: ["fighter/mutation-warrior/mutagen-discovery"]),
                (level: 19, features: ["fighter/mutation-warrior/mutagen-discovery"]),
            ],
        ),
        (
            key: "fighter/titan-fighter",
            name: "Titan Fighter",
            summary: "Dance of Masks fighter who wields two-handed weapons in one hand, without Armor or Weapon Training.",
            guide: "fighter#titan-fighter",
            features: [
                (key: "fighter/titan-fighter/giant-weapon-wielder", name: "Giant Weapon Wielder", summary: "Wields a two-handed weapon in one hand at -2 to attack, with one-handed Strength and Power Attack damage.", guide: "fighter#giant-weapon-wielder"),
                (key: "fighter/titan-fighter/giants-might", name: "Giant\'s Might", summary: "From 9th level, a two-handed weapon wielded in one hand adds 1.5 times your Strength modifier to damage.", guide: "fighter#giants-might"),
                (key: "fighter/titan-fighter/incredible-heft", name: "Incredible Heft", summary: "+1 attack and damage with a two-handed weapon in one hand at 3rd level, +1 more every 4 levels.", guide: "fighter#incredible-heft"),
                (key: "fighter/titan-fighter/unstoppable-strike", name: "Unstoppable Strike", summary: "From 17th level, a two-handed weapon wielded in one hand adds twice your Strength modifier to damage.", guide: "fighter#unstoppable-strike"),
            ],
            feat_lists: [
                (key: "fighter/titan-fighter/bonus-feats-10", name: "Massive Attacks (from level 10)", guide: "fighter#massive-attacks", ignores_prerequisites: true, feats: ["double-slice", "greater-two-weapon-fighting", "improved-two-weapon-fighting", "shield-bash", "two-weapon-fighting"]),
                (key: "fighter/titan-fighter/bonus-feats-2", name: "Massive Attacks", guide: "fighter#massive-attacks", ignores_prerequisites: true, feats: ["double-slice", "shield-bash", "two-weapon-fighting"]),
                (key: "fighter/titan-fighter/bonus-feats-6", name: "Massive Attacks (from level 6)", guide: "fighter#massive-attacks", ignores_prerequisites: true, feats: ["double-slice", "improved-two-weapon-fighting", "shield-bash", "two-weapon-fighting"]),
            ],
            levels: [
                (level: 1, features: ["fighter/titan-fighter/giant-weapon-wielder"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"], feat_slots: [CombatFeat]),
                (level: 2, features: ["fighter/bravery"], feat_slots: [OneOf(list: "fighter/titan-fighter/bonus-feats-2")]),
                (level: 3, features: ["fighter/titan-fighter/incredible-heft"]),
                (level: 6, feat_slots: [OneOf(list: "fighter/titan-fighter/bonus-feats-6")]),
                (level: 7, features: ["fighter/titan-fighter/incredible-heft"]),
                (level: 9, features: ["fighter/titan-fighter/giants-might"]),
                (level: 10, feat_slots: [OneOf(list: "fighter/titan-fighter/bonus-feats-10")]),
                (level: 11, features: ["fighter/titan-fighter/incredible-heft"]),
                (level: 14, feat_slots: [OneOf(list: "fighter/titan-fighter/bonus-feats-10")]),
                (level: 15, features: ["fighter/titan-fighter/incredible-heft"]),
                (level: 17, features: ["fighter/titan-fighter/unstoppable-strike"]),
                (level: 18, feat_slots: [OneOf(list: "fighter/titan-fighter/bonus-feats-10")]),
                (level: 19, features: ["fighter/titan-fighter/incredible-heft"]),
            ],
        ),
        (
            key: "fighter/tower-shield-specialist",
            name: "Tower Shield Specialist",
            summary: "Fighter skilled with tower shields instead of Weapon Training.",
            guide: "fighter#tower-shield-specialist",
            features: [
                (key: "fighter/tower-shield-specialist/burst-barrier", name: "Burst Barrier", summary: "From 2nd level, +1 to Reflex saves against area effects, +1 more every 4 levels (max +5 at 18th).", guide: "fighter#burst-barrier"),
                (key: "fighter/tower-shield-specialist/total-cover", name: "Total Cover", summary: "From 13th level, cannot be flanked while using a tower shield.", guide: "fighter#total-cover"),
                (key: "fighter/tower-shield-specialist/tower-shield-defense", name: "Tower Shield Defense", summary: "From 9th level, adds your tower shield's shield bonus to touch AC.", guide: "fighter#tower-shield-defense"),
                (key: "fighter/tower-shield-specialist/tower-shield-evasion", name: "Tower Shield Evasion", summary: "From 16th level, with a tower shield, a successful Reflex save against a half-damage effect means no damage.", guide: "fighter#tower-shield-evasion"),
                (key: "fighter/tower-shield-specialist/tower-shield-improved-evasion", name: "Tower Shield Improved Evasion", summary: "At 20th level, with a tower shield, a failed Reflex save against a half-damage effect deals only half damage.", guide: "fighter#tower-shield-improved-evasion"),
                (key: "fighter/tower-shield-specialist/tower-shield-specialist", name: "Tower Shield Specialist", summary: "From 5th level, no -2 attack penalty for using a tower shield.", guide: "fighter#tower-shield-specialist"),
                (key: "fighter/tower-shield-specialist/tower-shield-training", name: "Tower Shield Training", summary: "From 3rd level, with a tower shield, armour check penalty -3 and max Dex +2, improving on Armor Training.", guide: "fighter#tower-shield-training"),
            ],
            levels: [
                (level: 2, features: ["fighter/tower-shield-specialist/burst-barrier"], feat_slots: [CombatFeat]),
                (level: 3, features: ["fighter/armor-training", "fighter/tower-shield-specialist/tower-shield-training"]),
                (level: 5, features: ["fighter/tower-shield-specialist/tower-shield-specialist"]),
                (level: 9, features: ["fighter/tower-shield-specialist/tower-shield-defense"]),
                (level: 13, features: ["fighter/tower-shield-specialist/total-cover"]),
                (level: 16, features: ["fighter/tower-shield-specialist/tower-shield-evasion"], feat_slots: [CombatFeat]),
                (level: 20, features: ["fighter/tower-shield-specialist/tower-shield-improved-evasion"], feat_slots: [CombatFeat]),
            ],
        ),
        (
            key: "fighter/two-handed-fighter",
            name: "Two-Handed Fighter",
            summary: "Fighter with bonuses for two-handed weapons, losing Armor Training and Armor Mastery.",
            guide: "fighter#two-handed-fighter",
            features: [
                (key: "fighter/two-handed-fighter/backswing", name: "Backswing", summary: "From 7th level, when full attacking two-handed, every attack after the first adds double your Strength bonus to damage.", guide: "fighter#backswing"),
                (key: "fighter/two-handed-fighter/devastating-blow", name: "Devastating Blow", summary: "From 19th level, a standard-action two-handed attack at -5 that is an automatic critical threat; on-crit weapon effects don't trigger.", guide: "fighter#devastating-blow"),
                (key: "fighter/two-handed-fighter/greater-power-attack", name: "Greater Power Attack", summary: "From 15th level, Power Attack's extra damage is multiplied by 2 rather than by 1.5.", guide: "fighter#greater-power-attack"),
                (key: "fighter/two-handed-fighter/overhand-chop", name: "Overhand Chop", summary: "From 3rd level, a single two-handed attack (attack action or charge) adds double your Strength bonus to damage.", guide: "fighter#overhand-chop"),
                (key: "fighter/two-handed-fighter/piledriver", name: "Piledriver", summary: "From 11th level, a standard-action two-handed hit allows a free bull rush or trip without provoking.", guide: "fighter#piledriver"),
                (key: "fighter/two-handed-fighter/strong-grip", name: "Strong Grip", summary: "From 2nd level, +1 to CMB and CMD for sunder and disarm, +1 more every 4 levels (max +5 at 18th).", guide: "fighter#strong-grip"),
                (key: "fighter/two-handed-fighter/two-handed-weapon-training", name: "Two-Handed Weapon Training", summary: "From 5th level, +1 attack and damage with two-handed weapons, +1 more every 4 levels (max +4 at 17th).", guide: "fighter#two-handed-weapon-training"),
            ],
            levels: [
                (level: 2, features: ["fighter/two-handed-fighter/strong-grip"], feat_slots: [CombatFeat]),
                (level: 3, features: ["fighter/two-handed-fighter/overhand-chop"]),
                (level: 5, features: ["fighter/two-handed-fighter/two-handed-weapon-training"]),
                (level: 7, features: ["fighter/two-handed-fighter/backswing"]),
                (level: 11, features: ["fighter/two-handed-fighter/piledriver"]),
                (level: 15, features: ["fighter/two-handed-fighter/greater-power-attack"]),
                (level: 19, features: ["fighter/two-handed-fighter/devastating-blow"]),
            ],
        ),
    ],
)
