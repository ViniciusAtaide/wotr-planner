                (key: "fighter/defender-of-the-hearth/heaven-strike", blueprint: "a7662fc393334b0ca61d26d7715a66f1", name: "Heaven Strike", summary: "From 5th level, once per combat with a weapon and shield, deals weapon damage to every enemy within 20 feet without an attack roll.", guide: "fighter#heaven-strike"),
                (key: "fighter/defender-of-the-hearth/shield-block", blueprint: "08ef60cbb8324d13a8524ba552fa579e", name: "Shield Block", summary: "With a heavy or tower shield, the first hit against you deals 20% less damage; +1 attack covered at 5th and every 5 levels (max 5).", guide: "fighter#shield-block"),
            ],
            levels: [
