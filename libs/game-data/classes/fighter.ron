                (key: "fighter/titan-fighter/incredible-heft", blueprint: "f0235447f6f3430fa4a98d15642b849e", name: "Incredible Heft", summary: "+1 attack and damage with a two-handed weapon in one hand at 3rd level, +1 more every 4 levels.", guide: "fighter#incredible-heft"),
                (key: "fighter/titan-fighter/unstoppable-strike", blueprint: "7d60d8bb86a14e3188d208652d4a5581", name: "Unstoppable Strike", summary: "From 17th level, a two-handed weapon wielded in one hand adds twice your Strength modifier to damage.", guide: "fighter#unstoppable-strike"),
