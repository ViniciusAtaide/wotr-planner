            guide: "fighter#titan-fighter",
            features: [
                (key: "fighter/titan-fighter/giant-weapon-wielder", blueprint: "38323bb032d740ab9045f1086705b0c7", name: "Giant Weapon Wielder", summary: "Wields a two-handed weapon in one hand at -2 to attack, with one-handed Strength and Power Attack damage.", guide: "fighter#giant-weapon-wielder"),
