Class(
    key: "fighter",
    blueprint: "48ac8db94d5de7645906c7d0ad3bcfbd",
    name: "Fighter",
    summary: "Strength and Constitution warrior: full BAB, good Fortitude, 2 skill points per level, many bonus combat feats, armour and weapon training.",
    guide: "fighter",
    skill_points: 2,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["athletics", "knowledge-world", "lore-nature", "persuasion"],
    features: [
        (key: "fighter/armor-mastery", blueprint: "ae177f17cfb45264291d4d7c2cb64671", name: "Armor Mastery", summary: "At 19th level, DR 5/- while wearing armour or using a shield.", guide: "fighter#armor-mastery"),
        (key: "fighter/armor-training", blueprint: "3c380607706f209499d951b29d3c44f3", name: "Armor Training", summary: "From 3rd level, armour check penalty -1 and max Dex +1, +1 more every 4 levels (max 4); full speed in medium armour, heavy from 7th.", guide: "fighter#armor-training"),
        (key: "fighter/bravery", blueprint: "f6388946f9f472f4585591b80e9f2452", name: "Bravery", summary: "From 2nd level, +1 to Will saves against fear, +1 more every 4 levels (max +5 at 18th).", guide: "fighter#bravery"),
        (key: "fighter/weapon-mastery", blueprint: "55f516d7d1fc5294aba352a5a1c92786", name: "Weapon Mastery", summary: "At 20th level, with one chosen weapon type, crits auto-confirm, the multiplier rises by 1 and you cannot be disarmed.", guide: "fighter#weapon-mastery"),
        (key: "fighter/weapon-training", blueprint: "b8cecf4e5e464ad41b79d5b42b76b399", name: "Weapon Training", summary: "From 5th level, +1 attack, damage and CMB with a weapon group; a new group every 4 levels, raising earlier groups by +1.", guide: "fighter#weapon-training"),
    ],
    levels: [
        (level: 1, feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"], feat_slots: [CombatFeat]),
        (level: 2, features: ["fighter/bravery"], feat_slots: [CombatFeat]),
        (level: 3, features: ["fighter/armor-training"]),
        (level: 4, feat_slots: [CombatFeat]),
        (level: 5, features: ["fighter/weapon-training"]),
        (level: 6, features: ["fighter/bravery"], feat_slots: [CombatFeat]),
        (level: 7, features: ["fighter/armor-training"]),
        (level: 8, feat_slots: [CombatFeat]),
        (level: 9, features: ["fighter/weapon-training"]),
        (level: 10, features: ["fighter/bravery"], feat_slots: [CombatFeat]),
        (level: 11, features: ["fighter/armor-training"]),
        (level: 12, feat_slots: [CombatFeat]),
        (level: 13, features: ["fighter/weapon-training"]),
        (level: 14, features: ["fighter/bravery"], feat_slots: [CombatFeat]),
        (level: 15, features: ["fighter/armor-training"]),
