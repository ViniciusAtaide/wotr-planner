        (
            key: "fighter/tower-shield-specialist",
            blueprint: "a599da9a8a6b9e54083b0a4d2a25db59",
            name: "Tower Shield Specialist",
            summary: "Fighter skilled with tower shields instead of Weapon Training.",
            guide: "fighter#tower-shield-specialist",
            features: [
                (key: "fighter/tower-shield-specialist/burst-barrier", blueprint: "6c97b3fd5d354454c9f69fea5348a7e8", name: "Burst Barrier", summary: "From 2nd level, +1 to Reflex saves against area effects, +1 more every 4 levels (max +5 at 18th).", guide: "fighter#burst-barrier"),
                (key: "fighter/tower-shield-specialist/total-cover", blueprint: "4068bdf2373538e4fbd1c70438102f2e", name: "Total Cover", summary: "From 13th level, cannot be flanked while using a tower shield.", guide: "fighter#total-cover"),
                (key: "fighter/tower-shield-specialist/tower-shield-defense", blueprint: "68666566c506d344bad1e30bc3194fed", name: "Tower Shield Defense", summary: "From 9th level, adds your tower shield's shield bonus to touch AC.", guide: "fighter#tower-shield-defense"),
                (key: "fighter/tower-shield-specialist/tower-shield-evasion", blueprint: "bc678dd87b293ed4a99d0d75c1974f64", name: "Tower Shield Evasion", summary: "From 16th level, with a tower shield, a successful Reflex save against a half-damage effect means no damage.", guide: "fighter#tower-shield-evasion"),
