    archetypes: [
        (
            key: "fighter/aldori-defender",
            blueprint: "d80a67a264f206e4b8d2fcf7e560d48f",
            name: "Aldori Defender",
            summary: "Dexterity fighter who defends with the Aldori dueling sword, with fewer bonus feats and no Armor Training.",
            guide: "fighter#aldori-defender",
            features: [
                (key: "fighter/aldori-defender/counterattack", blueprint: "ff125ecc8b2c1894b879b7bcf34e1b17", name: "Counterattack", summary: "From 10th level, an immediate-action attack of opportunity against a foe in reach who hits you in melee.", guide: "fighter#counterattack"),
                (key: "fighter/aldori-defender/defensive-parry", blueprint: "faa56353e193e5940a305c60b4412ea5", name: "Defensive Parry", summary: "From 3rd level, a full attack with a dueling sword gives +1 dodge AC against melee until your next turn, +1 per 4 levels (max +5).", guide: "fighter#defensive-parry"),
                (key: "fighter/aldori-defender/disarming-strike", blueprint: "c7ea46f5e1822994ba069c11819844ae", name: "Disarming Strike", summary: "From 6th level, a successful disarm with a dueling sword also deals its normal damage, without Strength.", guide: "fighter#disarming-strike"),
                (key: "fighter/aldori-defender/steel-net", blueprint: "b4202533d1748f84484658491d2ff766", name: "Steel Net", summary: "From 8th level, fighting defensively with a dueling sword costs 2 less on attacks and gives 2 more dodge AC.", guide: "fighter#steel-net"),
                (key: "fighter/aldori-defender/weapon-proficiency-dueling-sword", blueprint: "9c37279588fd9e34e9c4cb234857492c", name: "Weapon Proficiency (Dueling Sword)", summary: "Proficiency with the Aldori dueling sword.", guide: "fighter#aldori-defender"),
            ],
            levels: [
                (level: 1, features: ["fighter/aldori-defender/weapon-proficiency-dueling-sword"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency", "tower-shield-proficiency"], feat_slots: [CombatFeat]),
                (level: 3, features: ["fighter/aldori-defender/defensive-parry"]),
                (level: 6, features: ["fighter/aldori-defender/disarming-strike", "fighter/bravery"]),
                (level: 7, features: ["fighter/aldori-defender/defensive-parry"]),
