                (key: "fighter/dragonheir-scion/draconic-presence", blueprint: "f6b7f213fc0e428d9a01ed4b02b50cce", name: "Draconic Presence", summary: "From 6th level, Dazzling Display as a bonus feat, usable as a standard action.", guide: "fighter#draconic-presence"),
                (key: "fighter/dragonheir-scion/draconic-strike", name: "Draconic Strike", summary: "From 4th level, Arcane Strike hits add 1d4 damage of your bloodline's energy type.", guide: "fighter#draconic-strike"),
                (key: "fighter/dragonheir-scion/fearful-might", blueprint: "6ba2b2178dfc4331a34cc2a8a2b68d6a", name: "Fearful Might", summary: "From 2nd level, +1 to Intimidate, +1 more every 4 levels (max +5 at 18th).", guide: "fighter#fearful-might"),
                (key: "fighter/dragonheir-scion/might-of-wyrms", name: "Might of Wyrms", summary: "At 20th level, immune to paralysis, sleep and your bloodline's element, with 60-foot blindsense.", guide: "fighter#might-of-wyrms"),
