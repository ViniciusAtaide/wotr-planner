Class(
    key: "skald",
    name: "Skald",
    summary: "Strength and Charisma singer: 3/4 BAB, spontaneous bard-list arcane spells up to 6th level, and a Raging Song that grants allies Inspired Rage.",
    guide: "skald",
    skill_points: 3,
    casting_ability: Charisma,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion", "use-magic-device"],
    spontaneous: true,
    features: [
        (key: "skald/bardic-knowledge", name: "Bardic Knowledge", summary: "Shared with the Bard: half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald"),
        (key: "skald/damage-reduction", name: "Damage Reduction", summary: "DR 1/- at 9th level, rising by 1 at 14th and 19th; allies under Inspired Rage get the same DR.", guide: "skald#damage-reduction"),
        (key: "skald/dirge-of-doom", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald"),
        (key: "skald/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Shared with the Barbarian: cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald"),
        (key: "skald/inspired-rage", name: "Inspired Rage", summary: "Allies in the song get +1 attack, damage and Will saves and -1 AC; attack and damage rise to +2 at 8th and +3 at 16th, Will by +1 per 4 levels.", guide: "skald#inspired-rage"),
        (key: "skald/lore-master", name: "Lore Master", summary: "Shared with the Bard: you may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald"),
        (key: "skald/master-skald", name: "Master Skald", summary: "At 20th level Inspired Rage drops its AC penalty, lets allies cast spells and also grants them Haste.", guide: "skald#master-skald"),
        (key: "skald/rage-powers", name: "Rage Powers", summary: "From 3rd level, adds the effects of chosen Barbarian rage powers to Inspired Rage.", guide: "skald#rage-powers"),
        (key: "skald/raging-song", name: "Raging Song", summary: "Sings for 3 + Charisma modifier rounds per day, plus 2 rounds per class level.", guide: "skald#raging-song"),
        (key: "skald/raging-song-move-action", name: "Raging Song (Move Action)", summary: "From 7th level, a song can be started as a move action rather than a standard one.", guide: "skald#raging-song-move-action"),
        (key: "skald/raging-song-swift-action", name: "Raging Song (Swift Action)", summary: "From 13th level, starts a song as a swift action.", guide: "skald#raging-song-swift-action"),
        (key: "skald/skald-proficiencies", name: "Skald Proficiencies", summary: "Simple and martial weapons, light and medium armour and shields; no arcane spell failure in light or medium armour with a shield.", guide: "skald#skald-proficiencies"),
        (key: "skald/song-of-strength", name: "Song of Strength", summary: "From 6th level, allies within 50 feet get half your skald level on Athletics checks.", guide: "skald#song-of-strength"),
        (key: "skald/song-of-the-fallen", name: "Song of the Fallen", summary: "From 14th level, the song revives dead allies within 50 feet for as long as it lasts.", guide: "skald#song-of-the-fallen"),
        (key: "skald/uncanny-dodge", name: "Uncanny Dodge", summary: "Shared with the Barbarian: never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald"),
        (key: "skald/well-versed", name: "Well Versed", summary: "Shared with the Bard: saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald"),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["skald/bardic-knowledge", "skald/inspired-rage", "skald/raging-song", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
        (level: 2, arcane_spell_level: 1, features: ["skald/well-versed"], selections: ["rogue/rogue-talents"]),
        (level: 3, arcane_spell_level: 1, features: ["skald/rage-powers"]),
        (level: 4, arcane_spell_level: 2, features: ["skald/uncanny-dodge"]),
        (level: 5, arcane_spell_level: 2),
        (level: 6, arcane_spell_level: 2, features: ["skald/rage-powers", "skald/song-of-strength"]),
        (level: 7, arcane_spell_level: 3, features: ["skald/lore-master", "skald/raging-song-move-action"], selections: ["rogue/rogue-talents"]),
        (level: 8, arcane_spell_level: 3, features: ["skald/improved-uncanny-dodge"]),
        (level: 9, arcane_spell_level: 3, features: ["skald/damage-reduction", "skald/rage-powers"]),
        (level: 10, arcane_spell_level: 4, features: ["skald/dirge-of-doom"]),
        (level: 11, arcane_spell_level: 4),
        (level: 12, arcane_spell_level: 4, features: ["skald/rage-powers"], selections: ["rogue/rogue-talents"]),
        (level: 13, arcane_spell_level: 5, features: ["skald/raging-song-swift-action"]),
        (level: 14, arcane_spell_level: 5, features: ["skald/damage-reduction", "skald/song-of-the-fallen"]),
        (level: 15, arcane_spell_level: 5, features: ["skald/rage-powers"]),
        (level: 16, arcane_spell_level: 6),
        (level: 17, arcane_spell_level: 6, selections: ["rogue/rogue-talents"]),
        (level: 18, arcane_spell_level: 6, features: ["skald/rage-powers"]),
        (level: 19, arcane_spell_level: 6, features: ["skald/damage-reduction"]),
        (level: 20, arcane_spell_level: 6, features: ["skald/master-skald"]),
    ],
    archetypes: [
        (
            key: "skald/battle-scion",
            name: "Battle Scion",
            summary: "You can trade rage powers for teamwork feats, which your Inspired Rage shares with allies.",
            guide: "skald#battle-scion",
            features: [
                (key: "skald/battle-scion/bardic-knowledge-battle-scion", name: "Bardic Knowledge (Battle Scion)", summary: "Adds half the class level to Knowledge (World) checks.", guide: "skald#bardic-knowledge-battle-scion"),
                (key: "skald/battle-scion/battle-prowess", name: "Battle Prowess", summary: "From 3rd level, can take a teamwork feat instead of a rage power and add it to Inspired Rage for 3 rounds of song; allies need its prerequisites.", guide: "skald#battle-prowess"),
                (key: "skald/battle-scion/courtly-presence", name: "Courtly Presence", summary: "Adds half the class level to Intimidate checks.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/dirge-of-doom", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/lore-master", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/uncanny-dodge", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/well-versed", name: "Well Versed", summary: "Saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald#battle-scion"),
            ],
            levels: [
                (level: 1, features: ["skald/battle-scion/bardic-knowledge-battle-scion", "skald/battle-scion/courtly-presence", "skald/inspired-rage", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, features: ["skald/battle-scion/well-versed"], selections: ["rogue/rogue-talents"]),
                (level: 3, features: ["skald/battle-scion/battle-prowess"]),
                (level: 4, features: ["skald/battle-scion/uncanny-dodge"]),
                (level: 6, features: ["skald/battle-scion/battle-prowess", "skald/song-of-strength"]),
                (level: 7, features: ["skald/battle-scion/lore-master", "skald/raging-song-move-action"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["skald/battle-scion/improved-uncanny-dodge"]),
                (level: 9, features: ["skald/battle-scion/battle-prowess", "skald/damage-reduction"]),
                (level: 10, features: ["skald/battle-scion/dirge-of-doom"]),
                (level: 12, features: ["skald/battle-scion/battle-prowess"], selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["skald/battle-scion/battle-prowess"]),
                (level: 18, features: ["skald/battle-scion/battle-prowess"]),
            ],
        ),
        (
            key: "skald/battle-singer",
            name: "Battle Singer",
            summary: "Skald whose song becomes three sonic damage verses, with fewer rage powers.",
            guide: "skald#battle-singer",
            features: [
                (key: "skald/battle-singer/bardic-knowledge", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald#battle-singer"),
                (key: "skald/battle-singer/battle-song-final-verse", name: "Battle Song - Final Verse", summary: "2 song rounds: 1d8 sonic per level to one enemy, Fort half, stun 1 round and stagger 1d4+1 on a failed save; stronger after the earlier verses.", guide: "skald#battle-song-final-verse"),
                (key: "skald/battle-singer/battle-song-first-verse", name: "Battle Song - First Verse", summary: "1 song round: 1d6 sonic per 2 levels to enemies in a 15-foot cone, Fortitude for half; a failed save staggers for 1 round.", guide: "skald#battle-song-first-verse"),
                (key: "skald/battle-singer/battle-song-second-verse", name: "Battle Song - Second Verse", summary: "2 song rounds: 1d6 sonic per 2 levels to enemies in 50 feet, Fort half, stun then stagger; cheaper and empowered right after the First Verse.", guide: "skald#battle-song-second-verse"),
                (key: "skald/battle-singer/dirge-of-doom", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#battle-singer"),
                (key: "skald/battle-singer/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#battle-singer"),
                (key: "skald/battle-singer/lore-master", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#battle-singer"),
                (key: "skald/battle-singer/uncanny-dodge", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#battle-singer"),
                (key: "skald/battle-singer/well-versed", name: "Well Versed", summary: "Saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald#battle-singer"),
            ],
            levels: [
                (level: 1, features: ["skald/battle-singer/bardic-knowledge", "skald/inspired-rage", "skald/raging-song", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, features: ["skald/battle-singer/well-versed"], selections: ["rogue/rogue-talents"]),
                (level: 3, features: ["skald/battle-singer/battle-song-first-verse"]),
                (level: 4, features: ["skald/battle-singer/uncanny-dodge"]),
                (level: 7, features: ["skald/battle-singer/lore-master", "skald/raging-song-move-action"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["skald/battle-singer/improved-uncanny-dodge"]),
                (level: 9, features: ["skald/battle-singer/battle-song-second-verse", "skald/damage-reduction"]),
                (level: 10, features: ["skald/battle-singer/dirge-of-doom"]),
                (level: 15, features: ["skald/battle-singer/battle-song-final-verse"]),
            ],
        ),
        (
            key: "skald/court-poet",
            name: "Court Poet",
            summary: "Skald whose song raises allies' Intelligence and Charisma and their spell damage instead of granting rage; no rage powers.",
            guide: "skald#court-poet",
            features: [
                (key: "skald/court-poet/bardic-knowledge", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald#court-poet"),
                (key: "skald/court-poet/dirge-of-doom", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#court-poet"),
                (key: "skald/court-poet/handling-the-crowd", name: "Handling the Crowd", summary: "From 2nd level, +1 AC when next to two or more creatures and half the class level to Persuasion checks.", guide: "skald#handling-the-crowd"),
                (key: "skald/court-poet/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#court-poet"),
                (key: "skald/court-poet/insightful-contemplation", name: "Insightful Contemplation", summary: "Song gives allies +2 morale to Intelligence and Charisma (+4 at 8th, +6 at 16th) and +1 Will (+1 per 4 levels), with -1 AC.", guide: "skald#insightful-contemplation"),
                (key: "skald/court-poet/insightful-spell", name: "Insightful Spell", summary: "From 4th level, damaging spells deal +1 damage, +1 more per 4 levels (max +5); allies under the song get it too.", guide: "skald#insightful-spell"),
                (key: "skald/court-poet/lore-master", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#court-poet"),
                (key: "skald/court-poet/song-of-inspiration", name: "Song of Inspiration", summary: "Your song lets allies within 30 feet add half your skald level to their Wisdom-based skill checks.", guide: "skald#song-of-inspiration"),
                (key: "skald/court-poet/uncanny-dodge", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#court-poet"),
            ],
            levels: [
                (level: 1, features: ["skald/court-poet/bardic-knowledge", "skald/court-poet/insightful-contemplation", "skald/raging-song", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, features: ["skald/court-poet/handling-the-crowd"], selections: ["rogue/rogue-talents"]),
                (level: 3),
                (level: 4, features: ["skald/court-poet/insightful-contemplation", "skald/court-poet/insightful-spell", "skald/court-poet/uncanny-dodge"]),
                (level: 6, features: ["skald/court-poet/song-of-inspiration"]),
                (level: 7, features: ["skald/court-poet/lore-master", "skald/raging-song-move-action"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["skald/court-poet/improved-uncanny-dodge", "skald/court-poet/insightful-contemplation", "skald/court-poet/insightful-spell"]),
                (level: 9, features: ["skald/damage-reduction"]),
                (level: 10, features: ["skald/court-poet/dirge-of-doom"]),
                (level: 12, features: ["skald/court-poet/insightful-contemplation", "skald/court-poet/insightful-spell"], selections: ["rogue/rogue-talents"]),
                (level: 15),
                (level: 16, features: ["skald/court-poet/insightful-contemplation", "skald/court-poet/insightful-spell"]),
                (level: 18),
                (level: 20, features: ["skald/court-poet/insightful-contemplation", "skald/court-poet/insightful-spell", "skald/master-skald"]),
            ],
        ),
        (
            key: "skald/demon-dancer",
            name: "Demon Dancer",
            summary: "Skald with Fiend Totem powers whose Inspired Rage gives allies a bite and, from 7th, +1 attack and damage that hurts them if they switch targets.",
            guide: "skald#demon-dancer",
            features: [
                (key: "skald/demon-dancer/bardic-knowledge", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/demonic-conquest", name: "Demonic Conquest", summary: "From 7th level, raging allies get +1 more attack and damage, but take class level + 1d6 damage if they stop attacking or switch targets.", guide: "skald#demonic-conquest"),
                (key: "skald/demon-dancer/dirge-of-doom", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/fiend-totem", name: "Fiend Totem", summary: "Fiend Totem rage power at 6th level: enemies hitting with melee, unarmed or natural attacks take 1d6 piercing damage.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/fiend-totem-greater", name: "Fiend Totem, Greater", summary: "Fiend Totem, Greater at 10th level: adjacent good creatures are shaken and take 2d6 slashing each turn; neutral ones are only shaken.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/fiendish-maw", name: "Fiendish Maw", summary: "Allies under Inspired Rage gain a secondary bite of 1d6, rising to 1d8 at 7th, 2d6 at 12th and 3d6 at 17th level.", guide: "skald#fiendish-maw"),
                (key: "skald/demon-dancer/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/lore-master", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/uncanny-dodge", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/well-versed", name: "Well Versed", summary: "Saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald#demon-dancer"),
            ],
            levels: [
                (level: 1, features: ["skald/demon-dancer/bardic-knowledge", "skald/inspired-rage", "skald/raging-song", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, features: ["skald/demon-dancer/well-versed"], selections: ["rogue/rogue-talents"]),
                (level: 3, features: ["skald/demon-dancer/fiendish-maw"]),
                (level: 4, features: ["skald/demon-dancer/uncanny-dodge"]),
                (level: 6, features: ["skald/demon-dancer/fiend-totem", "skald/song-of-strength"]),
                (level: 7, features: ["skald/demon-dancer/demonic-conquest", "skald/demon-dancer/fiendish-maw", "skald/demon-dancer/lore-master", "skald/raging-song-move-action"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["skald/demon-dancer/improved-uncanny-dodge"]),
                (level: 9, features: ["skald/damage-reduction"]),
                (level: 10, features: ["skald/demon-dancer/dirge-of-doom", "skald/demon-dancer/fiend-totem-greater"]),
                (level: 12, features: ["skald/rage-powers", "skald/demon-dancer/fiendish-maw"], selections: ["rogue/rogue-talents"]),
                (level: 17, features: ["skald/demon-dancer/fiendish-maw"], selections: ["rogue/rogue-talents"]),
            ],
        ),
        (
            key: "skald/herald-of-the-horn",
            name: "Herald of the Horn",
            summary: "Skald with a bonded horn: higher sonic spell DCs and a sonic cone blast from 11th level.",
            guide: "skald#herald-of-the-horn",
            features: [
                (key: "skald/herald-of-the-horn/arcane-bond-object", name: "Arcane Bond - Object", summary: "Once per day, the bonded object restores a spell slot.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/bardic-knowledge", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/crumbling-blast", name: "Crumbling Blast", summary: "From 11th level, 5d6 sonic in a 40-foot cone (Fort half); at 17th, twice per day for 10d6 and a failed save stuns for 1 round.", guide: "skald#crumbling-blast"),
                (key: "skald/herald-of-the-horn/dirge-of-doom", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/horn-call", name: "Horn Call", summary: "Sonic spell DCs +1 at 7th level, +2 at 13th and +3 at 19th.", guide: "skald#horn-call"),
                (key: "skald/herald-of-the-horn/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/uncanny-dodge", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/well-versed", name: "Well Versed", summary: "Saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald#herald-of-the-horn"),
            ],
            levels: [
                (level: 1, features: ["skald/herald-of-the-horn/arcane-bond-object", "skald/herald-of-the-horn/bardic-knowledge", "skald/inspired-rage", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, features: ["skald/herald-of-the-horn/well-versed"], selections: ["rogue/rogue-talents"]),
                (level: 4, features: ["skald/herald-of-the-horn/uncanny-dodge"]),
                (level: 7, features: ["skald/herald-of-the-horn/horn-call", "skald/raging-song-move-action"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["skald/herald-of-the-horn/improved-uncanny-dodge"]),
                (level: 10, features: ["skald/herald-of-the-horn/dirge-of-doom"]),
                (level: 11, features: ["skald/herald-of-the-horn/crumbling-blast"]),
                (level: 13, features: ["skald/herald-of-the-horn/horn-call", "skald/raging-song-swift-action"]),
                (level: 17, features: ["skald/herald-of-the-horn/crumbling-blast"], selections: ["rogue/rogue-talents"]),
                (level: 19, features: ["skald/damage-reduction", "skald/herald-of-the-horn/horn-call"]),
            ],
        ),
        (
            key: "skald/hunt-caller",
            name: "Hunt Caller",
            summary: "You turn yourself and allies into wolves and share Scent, at the cost of some songs and two rage powers.",
            guide: "skald#hunt-caller",
            features: [
                (key: "skald/hunt-caller/bardic-knowledge", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/call-of-the-wild-i", name: "Call of the Wild I", summary: "From 10th level, 1 round of song turns you and allies within 15 feet into wolves as Beast Shape I.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/call-of-the-wild-ii", name: "Call of the Wild II", summary: "From 14th level, Call of the Wild works as Beast Shape II.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/call-of-the-wild-iii", name: "Call of the Wild III", summary: "Call of the Wild works as Beast Shape III from 18th level (the guide's table; its text says 19th).", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/dirge-of-doom", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/inspire-scent", name: "Inspire Scent", summary: "Allies under Inspired Rage gain the Scent ability.", guide: "skald#inspire-scent"),
                (key: "skald/hunt-caller/lore-master", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/scent", name: "Scent", summary: "Shared with the Barbarian: senses enemies within 30 feet, working like blindsense.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/uncanny-dodge", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#hunt-caller"),
            ],
            levels: [
                (level: 1, features: ["skald/hunt-caller/bardic-knowledge", "skald/inspired-rage", "skald/raging-song", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, selections: ["rogue/rogue-talents"]),
                (level: 4, features: ["skald/hunt-caller/uncanny-dodge"]),
                (level: 6, features: ["skald/hunt-caller/inspire-scent", "skald/hunt-caller/scent"]),
                (level: 7, features: ["skald/hunt-caller/lore-master", "skald/raging-song-move-action"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["skald/hunt-caller/improved-uncanny-dodge"]),
                (level: 10, features: ["skald/hunt-caller/call-of-the-wild-i", "skald/hunt-caller/dirge-of-doom"]),
                (level: 14, features: ["skald/damage-reduction", "skald/hunt-caller/call-of-the-wild-ii"]),
                (level: 18, features: ["skald/hunt-caller/call-of-the-wild-iii"]),
            ],
        ),
        (
            key: "skald/inciter",
            name: "Inciter",
            summary: "Dance of Masks skald: you share sneak attacks with allies and your song enrages and weakens enemies; fewer rage powers.",
            guide: "skald#inciter",
            features: [
                (key: "skald/inciter/caustic-ridicule", name: "Caustic Ridicule", summary: "From 10th level, enemies hit by Insult also take -1 to AC and Will saves, -2 from 15th level.", guide: "skald#caustic-ridicule"),
                (key: "skald/inciter/hit-a-nerve", name: "Hit a Nerve", summary: "At 20th level the song stops costing allies AC or limiting their abilities, and foes who save still take half the Insult and Caustic Ridicule penalties.", guide: "skald#hit-a-nerve"),
                (key: "skald/inciter/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#inciter"),
                (key: "skald/inciter/insult", name: "Insult", summary: "Enemies hearing the song save on Will or take -2 to attacks and skill checks until they hit or damage the Inciter.", guide: "skald#insult"),
                (key: "skald/inciter/mind-games", name: "Mind Games", summary: "+1 to saves against mind-affecting, compulsion, fear and emotion effects, +1 more per 6 levels (max +4 at 19th).", guide: "skald#mind-games"),
                (key: "skald/inciter/prompted-by-backstabbing", name: "Prompted By Backstabbing", summary: "From 8th level, allies hearing the song deal +1d6 sneak damage, +2d6 at 13th and +3d6 at 18th level.", guide: "skald#prompted-by-backstabbing"),
                (key: "skald/inciter/serpents-tongue", name: "Serpent\'s Tongue", summary: "Your Persuasion checks (Bluff and Intimidate) get a bonus equal to half your class level.", guide: "skald#serpents-tongue"),
                (key: "skald/inciter/sneak-attack", name: "Sneak Attack", summary: "+1d6 sneak attack damage from 2nd level, rising by 1d6 at 7th, 12th and 17th level.", guide: "skald#sneak-attack"),
                (key: "skald/inciter/sneaky-tricks", name: "Sneaky Tricks", summary: "From 12th level, can pick advanced talents that alter sneak attacks and share them with allies through the song.", guide: "skald#sneaky-tricks"),
                (key: "skald/inciter/uncanny-dodge", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#inciter"),
            ],
            levels: [
                (level: 1, features: ["skald/inciter/insult", "skald/inciter/mind-games", "skald/inciter/serpents-tongue", "skald/inspired-rage", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, features: ["skald/inciter/sneak-attack"]),
                (level: 4, features: ["skald/inciter/uncanny-dodge"], selections: ["rogue/rogue-talents"]),
                (level: 6, features: ["skald/rage-powers"]),
                (level: 7, features: ["skald/inciter/sneak-attack", "skald/raging-song-move-action"]),
                (level: 8, features: ["skald/inciter/improved-uncanny-dodge", "skald/inciter/prompted-by-backstabbing"]),
                (level: 9, selections: ["rogue/rogue-talents"]),
                (level: 10, features: ["skald/inciter/caustic-ridicule"]),
                (level: 12, features: ["skald/inciter/sneak-attack", "skald/inciter/sneaky-tricks", "skald/rage-powers"]),
                (level: 13, features: ["skald/inciter/prompted-by-backstabbing", "skald/raging-song-swift-action"]),
                (level: 14, selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["skald/inciter/caustic-ridicule"]),
                (level: 17, features: ["skald/inciter/sneak-attack"]),
                (level: 18, features: ["skald/inciter/prompted-by-backstabbing", "skald/rage-powers"]),
                (level: 19, selections: ["rogue/rogue-talents"]),
                (level: 20, features: ["skald/inciter/hit-a-nerve"]),
            ],
        ),
    ],
)
