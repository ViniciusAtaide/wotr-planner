                (key: "skald/demon-dancer/demonic-conquest", blueprint: "2bba973bcb1abdf40a0192c769b1cbc2", name: "Demonic Conquest", summary: "From 7th level, raging allies get +1 more attack and damage, but take class level + 1d6 damage if they stop attacking or switch targets.", guide: "skald#demonic-conquest"),
                (key: "skald/demon-dancer/dirge-of-doom", blueprint: "12a03dce517a43e45b7203c8f8d4e110", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/fiend-totem", blueprint: "ce449404eeb4a7c499fbe0248056174f", name: "Fiend Totem", summary: "Fiend Totem rage power at 6th level: enemies hitting with melee, unarmed or natural attacks take 1d6 piercing damage.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/fiend-totem-greater", blueprint: "1105632657d94d940a43707a3a57b006", name: "Fiend Totem, Greater", summary: "Fiend Totem, Greater at 10th level: adjacent good creatures are shaken and take 2d6 slashing each turn; neutral ones are only shaken.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/fiendish-maw", blueprint: "a5f55fc653c389e4ea1c032342a507bd", name: "Fiendish Maw", summary: "Allies under Inspired Rage gain a secondary bite of 1d6, rising to 1d8 at 7th, 2d6 at 12th and 3d6 at 17th level.", guide: "skald#fiendish-maw"),
                (key: "skald/demon-dancer/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/lore-master", blueprint: "5eb7d688e472ca546a30d4a99cdb16a0", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#demon-dancer"),
                (key: "skald/demon-dancer/well-versed", blueprint: "17e1dede01c763a439852a1d0d8014c7", name: "Well Versed", summary: "Saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald#demon-dancer"),
            ],
            levels: [
                (level: 1, features: ["skald/demon-dancer/bardic-knowledge", "skald/inspired-rage", "skald/raging-song", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, features: ["skald/demon-dancer/well-versed"], selections: ["rogue/rogue-talents"]),
                (level: 3, features: ["skald/demon-dancer/fiendish-maw"]),
                (level: 4, features: ["skald/demon-dancer/uncanny-dodge"]),
                (level: 6, features: ["skald/demon-dancer/fiend-totem", "skald/song-of-strength"]),
                (level: 7, features: ["skald/demon-dancer/demonic-conquest", "skald/demon-dancer/fiendish-maw", "skald/demon-dancer/lore-master", "skald/raging-song-move-action"], selections: ["rogue/rogue-talents"]),
                (level: 8, features: ["skald/demon-dancer/improved-uncanny-dodge"]),
