                (key: "skald/court-poet/dirge-of-doom", blueprint: "12a03dce517a43e45b7203c8f8d4e110", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#court-poet"),
                (key: "skald/court-poet/handling-the-crowd", blueprint: "804a4a407eac8484896a71c3e9cde234", name: "Handling the Crowd", summary: "From 2nd level, +1 AC when next to two or more creatures and half the class level to Persuasion checks.", guide: "skald#handling-the-crowd"),
                (key: "skald/court-poet/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#court-poet"),
                (key: "skald/court-poet/insightful-contemplation", blueprint: "7549a18f454afe24c8f3b3ec7efffee2", name: "Insightful Contemplation", summary: "Song gives allies +2 morale to Intelligence and Charisma (+4 at 8th, +6 at 16th) and +1 Will (+1 per 4 levels), with -1 AC.", guide: "skald#insightful-contemplation"),
                (key: "skald/court-poet/insightful-spell", blueprint: "04da9870c35d48efb109838cb2bb8d82", name: "Insightful Spell", summary: "From 4th level, damaging spells deal +1 damage, +1 more per 4 levels (max +5); allies under the song get it too.", guide: "skald#insightful-spell"),
                (key: "skald/court-poet/lore-master", blueprint: "5eb7d688e472ca546a30d4a99cdb16a0", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#court-poet"),
                (key: "skald/court-poet/song-of-inspiration", blueprint: "fe280a76c5bb2364daae55e4209e985c", name: "Song of Inspiration", summary: "Your song lets allies within 30 feet add half your skald level to their Wisdom-based skill checks.", guide: "skald#song-of-inspiration"),
