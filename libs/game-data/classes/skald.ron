        (
            key: "skald/hunt-caller",
            blueprint: "67daa4f4f2b62f54cb3ec56bdc85dea6",
            name: "Hunt Caller",
            summary: "You turn yourself and allies into wolves and share Scent, at the cost of some songs and two rage powers.",
            guide: "skald#hunt-caller",
            features: [
                (key: "skald/hunt-caller/bardic-knowledge", blueprint: "b2cc2d1d1844d0443866164466613c5c", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/call-of-the-wild-i", blueprint: "8debcb06fccab7249a09db5e58be954e", name: "Call of the Wild I", summary: "From 10th level, 1 round of song turns you and allies within 15 feet into wolves as Beast Shape I.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/call-of-the-wild-ii", blueprint: "45e8873cc6894fd42b98d7745b42e826", name: "Call of the Wild II", summary: "From 14th level, Call of the Wild works as Beast Shape II.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/call-of-the-wild-iii", blueprint: "d62c37cd671849f4a898c91c34660bc5", name: "Call of the Wild III", summary: "Call of the Wild works as Beast Shape III from 18th level (the guide's table; its text says 19th).", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/dirge-of-doom", blueprint: "12a03dce517a43e45b7203c8f8d4e110", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/inspire-scent", blueprint: "f0e41e160d475914fb3306d16827ed18", name: "Inspire Scent", summary: "Allies under Inspired Rage gain the Scent ability.", guide: "skald#inspire-scent"),
                (key: "skald/hunt-caller/lore-master", blueprint: "5eb7d688e472ca546a30d4a99cdb16a0", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/scent", blueprint: "6e5d57a733d1eea46a9022a304f2c728", name: "Scent", summary: "Shared with the Barbarian: senses enemies within 30 feet, working like blindsense.", guide: "skald#hunt-caller"),
                (key: "skald/hunt-caller/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#hunt-caller"),
