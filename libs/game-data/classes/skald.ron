Class(
    key: "skald",
    blueprint: "6afa347d804838b48bda16acb0573dc0",
    name: "Skald",
    summary: "Strength and Charisma singer: 3/4 BAB, spontaneous bard-list arcane spells up to 6th level, and a Raging Song that grants allies Inspired Rage.",
    guide: "skald",
    skill_points: 3,
    casting_ability: Charisma,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion", "use-magic-device"],
    spontaneous: true,
    features: [
        (key: "skald/bardic-knowledge", blueprint: "b2cc2d1d1844d0443866164466613c5c", name: "Bardic Knowledge", summary: "Shared with the Bard: half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald"),
        (key: "skald/damage-reduction", blueprint: "d9446a35d1401cf418bb9b5e0e199d57", name: "Damage Reduction", summary: "DR 1/- at 9th level, rising by 1 at 14th and 19th; allies under Inspired Rage get the same DR.", guide: "skald#damage-reduction"),
        (key: "skald/dirge-of-doom", blueprint: "12a03dce517a43e45b7203c8f8d4e110", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald"),
        (key: "skald/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "Shared with the Barbarian: cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald"),
        (key: "skald/inspired-rage", blueprint: "1a639eadc2c3ed546bc4bb236864cd0c", name: "Inspired Rage", summary: "Allies in the song get +1 attack, damage and Will saves and -1 AC; attack and damage rise to +2 at 8th and +3 at 16th, Will by +1 per 4 levels.", guide: "skald#inspired-rage"),
        (key: "skald/lore-master", blueprint: "5eb7d688e472ca546a30d4a99cdb16a0", name: "Lore Master", summary: "Shared with the Bard: you may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald"),
        (key: "skald/master-skald", blueprint: "ae4d45a39a91dee4fb4200d7a677d9a7", name: "Master Skald", summary: "At 20th level Inspired Rage drops its AC penalty, lets allies cast spells and also grants them Haste.", guide: "skald#master-skald"),
        (key: "skald/raging-song", blueprint: "334cb75aa673d1d4bb279761c2ef5cf1", name: "Raging Song", summary: "Sings for 3 + Charisma modifier rounds per day, plus 2 rounds per class level.", guide: "skald#raging-song"),
        (key: "skald/raging-song-move-action", blueprint: "f24dc98de96671d4288cba09584e249b", name: "Raging Song (Move Action)", summary: "From 7th level, a song can be started as a move action rather than a standard one.", guide: "skald#raging-song-move-action"),
        (key: "skald/raging-song-swift-action", blueprint: "0c12540bf7e45f04faa84730136cb726", name: "Raging Song (Swift Action)", summary: "From 13th level, starts a song as a swift action.", guide: "skald#raging-song-swift-action"),
        (key: "skald/skald-proficiencies", blueprint: "64e3e3fb96c439b4f8d896339b2f358a", name: "Skald Proficiencies", summary: "Simple and martial weapons, light and medium armour and shields; no arcane spell failure in light or medium armour with a shield.", guide: "skald#skald-proficiencies"),
        (key: "skald/song-of-strength", blueprint: "45cfdf2474fe89f49892a72540614ce0", name: "Song of Strength", summary: "From 6th level, allies within 50 feet get half your skald level on Athletics checks.", guide: "skald#song-of-strength"),
        (key: "skald/song-of-the-fallen", blueprint: "9fc5d126524dbc84a90b1856707e2d87", name: "Song of the Fallen", summary: "From 14th level, the song revives dead allies within 50 feet for as long as it lasts.", guide: "skald#song-of-the-fallen"),
        (key: "skald/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "Shared with the Barbarian: never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald"),
        (key: "skald/well-versed", blueprint: "17e1dede01c763a439852a1d0d8014c7", name: "Well Versed", summary: "Shared with the Bard: saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald"),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["skald/bardic-knowledge", "skald/inspired-rage", "skald/raging-song", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "scribe-scrolls", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
        (level: 2, arcane_spell_level: 1, features: ["skald/well-versed"], selections: ["rogue/rogue-talents"]),
