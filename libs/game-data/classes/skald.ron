        (
            key: "skald/inciter",
            blueprint: "a1f5ab7eb78942f6889304acbd92e945",
            name: "Inciter",
            summary: "Dance of Masks skald: you share sneak attacks with allies and your song enrages and weakens enemies; fewer rage powers.",
            guide: "skald#inciter",
            features: [
                (key: "skald/inciter/caustic-ridicule", blueprint: "47619c4de860458186b9e5b968a4f1c1", name: "Caustic Ridicule", summary: "From 10th level, enemies hit by Insult also take -1 to AC and Will saves, -2 from 15th level.", guide: "skald#caustic-ridicule"),
                (key: "skald/inciter/hit-a-nerve", blueprint: "c216e0ea091c4d1181d9449a09877857", name: "Hit a Nerve", summary: "At 20th level the song stops costing allies AC or limiting their abilities, and foes who save still take half the Insult and Caustic Ridicule penalties.", guide: "skald#hit-a-nerve"),
                (key: "skald/inciter/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#inciter"),
                (key: "skald/inciter/insult", blueprint: "0f0a404c0b7a4b678d31ed8986adbd39", name: "Insult", summary: "Enemies hearing the song save on Will or take -2 to attacks and skill checks until they hit or damage the Inciter.", guide: "skald#insult"),
                (key: "skald/inciter/mind-games", blueprint: "8d9e69bcc76342559a97695fe0dce04f", name: "Mind Games", summary: "+1 to saves against mind-affecting, compulsion, fear and emotion effects, +1 more per 6 levels (max +4 at 19th).", guide: "skald#mind-games"),
                (key: "skald/inciter/prompted-by-backstabbing", blueprint: "1ae6618b3eb2450b92d6ae6e0aa64c03", name: "Prompted By Backstabbing", summary: "From 8th level, allies hearing the song deal +1d6 sneak damage, +2d6 at 13th and +3d6 at 18th level.", guide: "skald#prompted-by-backstabbing"),
                (key: "skald/inciter/serpents-tongue", blueprint: "7fc52d08d6984d24babaa5c746ddbd51", name: "Serpent\'s Tongue", summary: "Your Persuasion checks (Bluff and Intimidate) get a bonus equal to half your class level.", guide: "skald#serpents-tongue"),
                (key: "skald/inciter/sneak-attack", blueprint: "9b9eac6709e1c084cb18c3a366e0ec87", name: "Sneak Attack", summary: "+1d6 sneak attack damage from 2nd level, rising by 1d6 at 7th, 12th and 17th level.", guide: "skald#sneak-attack"),
                (key: "skald/inciter/sneaky-tricks", blueprint: "4e1dfa97892645988937cfdcf7253c5e", name: "Sneaky Tricks", summary: "From 12th level, can pick advanced talents that alter sneak attacks and share them with allies through the song.", guide: "skald#sneaky-tricks"),
                (key: "skald/inciter/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#inciter"),
            ],
            levels: [
                (level: 1, features: ["skald/inciter/insult", "skald/inciter/mind-games", "skald/inciter/serpents-tongue", "skald/inspired-rage", "skald/skald-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"], feat_slots: [Category(Magic)]),
                (level: 2, features: ["skald/inciter/sneak-attack"]),
                (level: 4, features: ["skald/inciter/uncanny-dodge"], selections: ["rogue/rogue-talents"]),
                (level: 6, selections: ["barbarian/rage-power"]),
                (level: 7, features: ["skald/inciter/sneak-attack", "skald/raging-song-move-action"]),
                (level: 8, features: ["skald/inciter/improved-uncanny-dodge", "skald/inciter/prompted-by-backstabbing"]),
                (level: 9, selections: ["rogue/rogue-talents"]),
                (level: 10, features: ["skald/inciter/caustic-ridicule"]),
                (level: 12, features: ["skald/inciter/sneak-attack", "skald/inciter/sneaky-tricks"], selections: ["barbarian/rage-power"]),
                (level: 13, features: ["skald/inciter/prompted-by-backstabbing", "skald/raging-song-swift-action"]),
                (level: 14, selections: ["rogue/rogue-talents"]),
                (level: 15, features: ["skald/inciter/caustic-ridicule"]),
