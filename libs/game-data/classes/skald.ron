        (level: 11, arcane_spell_level: 4),
        (level: 12, arcane_spell_level: 4, selections: ["barbarian/rage-power", "rogue/rogue-talents"]),
        (level: 13, arcane_spell_level: 5, features: ["skald/raging-song-swift-action"]),
        (level: 14, arcane_spell_level: 5, features: ["skald/damage-reduction", "skald/song-of-the-fallen"]),
        (level: 15, arcane_spell_level: 5, selections: ["barbarian/rage-power"]),
        (level: 16, arcane_spell_level: 6),
        (level: 17, arcane_spell_level: 6, selections: ["rogue/rogue-talents"]),
        (level: 18, arcane_spell_level: 6, selections: ["barbarian/rage-power"]),
        (level: 19, arcane_spell_level: 6, features: ["skald/damage-reduction"]),
        (level: 20, arcane_spell_level: 6, features: ["skald/master-skald"]),
    ],
    archetypes: [
        (
            key: "skald/battle-scion",
            blueprint: "71d41dd6309ea994886908c34c87ccd9",
            name: "Battle Scion",
            summary: "You can trade rage powers for teamwork feats, which your Inspired Rage shares with allies.",
            guide: "skald#battle-scion",
            features: [
                (key: "skald/battle-scion/bardic-knowledge-battle-scion", blueprint: "a26443d8c4ccdf040965cfe0066a61f6", name: "Bardic Knowledge (Battle Scion)", summary: "Adds half the class level to Knowledge (World) checks.", guide: "skald#bardic-knowledge-battle-scion"),
                (key: "skald/battle-scion/battle-prowess", blueprint: "225940b509289224e83cd900f15b852e", name: "Battle Prowess", summary: "From 3rd level, can take a teamwork feat instead of a rage power and add it to Inspired Rage for 3 rounds of song; allies need its prerequisites.", guide: "skald#battle-prowess"),
                (key: "skald/battle-scion/courtly-presence", blueprint: "4142f5d4a1ede7946aedd85dffc9c54d", name: "Courtly Presence", summary: "Adds half the class level to Intimidate checks.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/dirge-of-doom", blueprint: "12a03dce517a43e45b7203c8f8d4e110", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/lore-master", blueprint: "5eb7d688e472ca546a30d4a99cdb16a0", name: "Lore Master", summary: "You may take 10 on Knowledge and Lore checks in skills where you have ranks.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#battle-scion"),
                (key: "skald/battle-scion/well-versed", blueprint: "17e1dede01c763a439852a1d0d8014c7", name: "Well Versed", summary: "Saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald#battle-scion"),
