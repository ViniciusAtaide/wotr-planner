        (
            key: "skald/herald-of-the-horn",
            blueprint: "72fa7b1c7a6ede44eb490080bf4a2f90",
            name: "Herald of the Horn",
            summary: "Skald with a bonded horn: higher sonic spell DCs and a sonic cone blast from 11th level.",
            guide: "skald#herald-of-the-horn",
            features: [
                (key: "skald/herald-of-the-horn/arcane-bond-object", blueprint: "4f92e08a658e5b34c961fc12c560672b", name: "Arcane Bond - Object", summary: "Once per day, the bonded object restores a spell slot.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/bardic-knowledge", blueprint: "b2cc2d1d1844d0443866164466613c5c", name: "Bardic Knowledge", summary: "Half the class level is added as a bonus on every Knowledge and Lore check.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/crumbling-blast", blueprint: "024e019efc3b9cb4ea9e7ea0bab709c0", name: "Crumbling Blast", summary: "From 11th level, 5d6 sonic in a 40-foot cone (Fort half); at 17th, twice per day for 10d6 and a failed save stuns for 1 round.", guide: "skald#crumbling-blast"),
                (key: "skald/herald-of-the-horn/dirge-of-doom", blueprint: "12a03dce517a43e45b7203c8f8d4e110", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/horn-call", blueprint: "7ab19a006c4abb0489d6d1a99e54fb99", name: "Horn Call", summary: "Sonic spell DCs +1 at 7th level, +2 at 13th and +3 at 19th.", guide: "skald#horn-call"),
                (key: "skald/herald-of-the-horn/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "Never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "skald#herald-of-the-horn"),
                (key: "skald/herald-of-the-horn/well-versed", blueprint: "17e1dede01c763a439852a1d0d8014c7", name: "Well Versed", summary: "Saving throws against sonic, language-dependent and bardic performance effects get +4.", guide: "skald#herald-of-the-horn"),
            ],
