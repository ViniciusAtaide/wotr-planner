                (key: "skald/battle-singer/battle-song-final-verse", blueprint: "2fcec2fce98446f4957fe0e894be7caa", name: "Battle Song - Final Verse", summary: "2 song rounds: 1d8 sonic per level to one enemy, Fort half, stun 1 round and stagger 1d4+1 on a failed save; stronger after the earlier verses.", guide: "skald#battle-song-final-verse"),
                (key: "skald/battle-singer/battle-song-first-verse", blueprint: "9c842978fca648979f933747f647881f", name: "Battle Song - First Verse", summary: "1 song round: 1d6 sonic per 2 levels to enemies in a 15-foot cone, Fortitude for half; a failed save staggers for 1 round.", guide: "skald#battle-song-first-verse"),
                (key: "skald/battle-singer/battle-song-second-verse", blueprint: "4ccc0a5cc51c4a7ba0202312eedbda5d", name: "Battle Song - Second Verse", summary: "2 song rounds: 1d6 sonic per 2 levels to enemies in 50 feet, Fort half, stun then stagger; cheaper and empowered right after the First Verse.", guide: "skald#battle-song-second-verse"),
                (key: "skald/battle-singer/dirge-of-doom", blueprint: "12a03dce517a43e45b7203c8f8d4e110", name: "Dirge of Doom", summary: "Shared with the Bard: the performance leaves affected enemies shaken.", guide: "skald#battle-singer"),
                (key: "skald/battle-singer/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "Cannot be flanked, and rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "skald#battle-singer"),
