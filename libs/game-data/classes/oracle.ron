            summary: "Bones revelations: Armor of Bones, Death's Touch, Near Death, Resist Life, Soul Siphon (7th) and Spirit Walk (11th).",
            guide: "oracle#bones",
            options: [
                (key: "oracle/revelations/bones/armor-of-bones", blueprint: "b07a138d653a16146bc12d90637d5dd1", name: "Armor of Bones", summary: "+4 armor bonus barrier for 1 hour per level, +2 at 7th and every 4 levels (+12 at 19th); DR 5/bludgeoning from 13th.", guide: "oracle#armor-of-bones"),
                (key: "oracle/revelations/bones/deaths-touch", blueprint: "1a25afc333021a64cbe9f23ef8c5ebd8", name: "Death\'s Touch", summary: "Melee touch for 1d6 negative energy +1 per two class levels; 3 + Charisma modifier uses a day.", guide: "oracle#deaths-touch"),
                (key: "oracle/revelations/bones/near-death", blueprint: "96649fb9694c1164caf7b836898685aa", name: "Near Death", summary: "+2 insight on saves vs disease, mind-affecting and poison; also death, sleep and stun from 7th; +4 from 11th.", guide: "oracle#near-death"),
                (key: "oracle/revelations/bones/resist-life", blueprint: "f7f37cff49bfc9b49a45d9f4fbb8aec3", name: "Resist Life", summary: "Positive and negative energy affect you as undead; channel resistance +3 at 7th, rising by 2 at 11th and again at 15th.", guide: "oracle#resist-life"),
                (key: "oracle/revelations/bones/soul-siphon", blueprint: "226c053a75fd7c34cab1b493f5847787", name: "Soul Siphon", summary: "From 7th level, a ranged touch within 30 feet gives a negative level for Cha modifier minutes and heals you class level HP; 1/day, more later.", guide: "oracle#soul-siphon", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/bones/spirit-walk", blueprint: "87bdea524911cfa4dacfe7243abe8b51", name: "Spirit Walk", summary: "From 11th level, become incorporeal and invisible for class level rounds; once a day, twice from 15th.", guide: "oracle#spirit-walk", prerequisite: Any([ClassLevel(class: "arcanist", level: 11), ClassLevel(class: "oracle", level: 11)])),
