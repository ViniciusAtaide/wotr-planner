Class(
    key: "oracle",
    name: "Oracle",
    summary: "Spontaneous divine caster on the cleric list up to 9th-level spells, keyed on Charisma, with 3/4 BAB, good Will, 6 HP, a mystery and a curse.",
    guide: "oracle",
    skill_points: 3,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "persuasion"],
    spontaneous: true,
    features: [
        (key: "oracle/additional-spells", name: "Additional Spells", summary: "Adds either every cure spell or every inflict spell to your spells known at the matching levels.", guide: "oracle#additional-spells"),
        (key: "oracle/curse-2", name: "Curse 2", summary: "At 5th level, your curse moves to its next stage.", guide: "oracle"),
        (key: "oracle/curse-3", name: "Curse 3", summary: "At 10th level, your curse moves to its next stage.", guide: "oracle"),
        (key: "oracle/curse-4", name: "Curse 4", summary: "At 15th level, your curse moves to its final stage.", guide: "oracle"),
        (key: "oracle/mystery/ancestor/ancestor-final-revelation", name: "Ancestor Final Revelation", summary: "At 20th level: Charisma modifier added to Will saves, 60-foot blindsense, +4 caster level for divination, and Foresight once a day.", guide: "oracle#ancestor-final-revelation"),
        (key: "oracle/mystery/battle/battle-final-revelation", name: "Battle Final Revelation", summary: "At 20th level: Pounce, criticals ignore damage reduction, and +4 insight to AC against critical confirmation rolls.", guide: "oracle#battle-final-revelation"),
        (key: "oracle/mystery/bones/bones-final-revelation", name: "Bones Final Revelation", summary: "At 20th level: Animate Dead at will, and Power Word Kill once a day on a creature with 150 HP or less.", guide: "oracle#bones-final-revelation"),
        (key: "oracle/mystery/flame/flame-final-revelation", name: "Flame Final Revelation", summary: "At 20th level, all your fire spells are empowered, as Empower Spell.", guide: "oracle#flame-final-revelation"),
        (key: "oracle/mystery/life/life-final-revelation", name: "Life Final Revelation", summary: "At 20th level, immunity to bleed, death attacks, negative levels, and being fatigued, exhausted, sickened or nauseated.", guide: "oracle#life-final-revelation"),
        (key: "oracle/mystery/nature/nature-final-revelation", name: "Nature Final Revelation", summary: "At 20th level, once a day as a full-round action, change into a plant, animal or humanoid, curing poison, disease and ability damage and healing fully.", guide: "oracle#nature-final-revelation"),
        (key: "oracle/mystery/stone/stone-final-revelation", name: "Stone Final Revelation", summary: "At 20th level, all your acid spells are empowered, as Empower Spell.", guide: "oracle#stone-final-revelation"),
        (key: "oracle/mystery/waves/waves-final-revelation", name: "Waves Final Revelation", summary: "At 20th level, all your cold spells are empowered, as Empower Spell.", guide: "oracle#waves-final-revelation"),
        (key: "oracle/mystery/wind/wind-final-revelation", name: "Wind Final Revelation", summary: "At 20th level, all your electricity spells are empowered, as Empower Spell.", guide: "oracle#wind-final-revelation"),
        (key: "oracle/revelations/battle/war-sight/uncanny-dodge", name: "Uncanny Dodge", summary: "From War Sight at 7th level: you gain Uncanny Dodge.", guide: "oracle#war-sight"),
    ],
    selections: [
        (
            key: "oracle/maneuver-mastery",
            name: "Maneuver Mastery",
            summary: "Pick a combat maneuver: you use your class level instead of BAB for its CMB, gain its Improved feat at 7th and its Greater feat at 11th.",
            guide: "oracle#maneuver-mastery",
            level_from: GrantingOption,
            options: [
                (
                    key: "oracle/maneuver-mastery/bull-rush",
                    name: "Bull Rush",
                    summary: "Bull Rush uses your class level instead of BAB for CMB; its Improved feat at 7th level and Greater feat at 11th.",
                    guide: "oracle#maneuver-mastery",
                    levels: [
                        (level: 7, feats: ["bull-rush"]),
                        (level: 11, feats: ["greater-bull-rush"]),
                    ],
                ),
                (
                    key: "oracle/maneuver-mastery/dirty-trick",
                    name: "Dirty Trick",
                    summary: "Dirty Trick uses your class level instead of BAB for CMB; its Improved feat at 7th level and Greater feat at 11th.",
                    guide: "oracle#maneuver-mastery",
                    levels: [
                        (level: 7, feats: ["dirty-trick"]),
                        (level: 11, feats: ["greater-dirty-trick"]),
                    ],
                ),
                (
                    key: "oracle/maneuver-mastery/disarm",
                    name: "Disarm",
                    summary: "Disarm uses your class level instead of BAB for CMB; its Improved feat at 7th level and Greater feat at 11th.",
                    guide: "oracle#maneuver-mastery",
                    levels: [
                        (level: 7, feats: ["disarm"]),
                        (level: 11, feats: ["greater-disarm"]),
                    ],
                ),
                (
                    key: "oracle/maneuver-mastery/sunder-armor",
                    name: "Sunder Armor",
                    summary: "Sunder Armor uses your class level instead of BAB for CMB; its Improved feat at 7th level and Greater feat at 11th.",
                    guide: "oracle#maneuver-mastery",
                    levels: [
                        (level: 7, feats: ["sunder-armor"]),
                        (level: 11, feats: ["greater-sunder-armor"]),
                    ],
                ),
                (
                    key: "oracle/maneuver-mastery/trip",
                    name: "Trip",
                    summary: "Trip uses your class level instead of BAB for CMB; its Improved feat at 7th level and Greater feat at 11th.",
                    guide: "oracle#maneuver-mastery",
                    levels: [
                        (level: 7, feats: ["trip"]),
                        (level: 11, feats: ["greater-trip"]),
                    ],
                ),
            ],
        ),
        (
            key: "oracle/mystery",
            name: "Mystery",
            summary: "Your mystery adds spells known at even levels, may add class skills, and sets your revelations and your 20th-level Final Revelation.",
            guide: "oracle#mystery",
            option_levels: ["oracle"],
            options: [
                (
                    key: "oracle/mystery/ancestor",
                    name: "Ancestor",
                    summary: "Ancestor: spells from Unbreakable Heart to Foresight, revelations like Blood of Heroes and Spirit Shield, and a divination-focused final revelation.",
                    guide: "oracle#ancestor",
                    pool: "oracle/revelations/ancestor",
                    levels: [
                        (level: 20, features: ["oracle/mystery/ancestor/ancestor-final-revelation"]),
                    ],
                ),
                (
                    key: "oracle/mystery/battle",
                    name: "Battle",
                    summary: "Battle: Perception as a class skill, Enlarge Person to Overwhelming Presence, martial revelations, and Pounce at 20th.",
                    guide: "oracle#battle",
                    pool: "oracle/revelations/battle",
                    levels: [
                        (level: 1, class_skills: ["perception"]),
                        (level: 20, features: ["oracle/mystery/battle/battle-final-revelation"]),
                    ],
                ),
                (
                    key: "oracle/mystery/bones",
                    name: "Bones",
                    summary: "Bones: Stealth as a class skill, necromancy from Cause Fear to Wail of the Banshee, and Power Word Kill at 20th.",
                    guide: "oracle#bones",
                    pool: "oracle/revelations/bones",
                    levels: [
                        (level: 1, class_skills: ["stealth"]),
                        (level: 20, features: ["oracle/mystery/bones/bones-final-revelation"]),
                    ],
                ),
                (
                    key: "oracle/mystery/flame",
                    name: "Flame",
                    summary: "Flame: Athletics and Mobility as class skills, fire spells from Burning Hands to Fiery Body, and empowered fire spells at 20th.",
                    guide: "oracle#flame",
                    pool: "oracle/revelations/flame",
                    levels: [
                        (level: 1, class_skills: ["athletics", "mobility"]),
                        (level: 20, features: ["oracle/mystery/flame/flame-final-revelation"]),
                    ],
                ),
                (
                    key: "oracle/mystery/life",
                    name: "Life",
                    summary: "Life: healing spells from Remove Sickness to Mass Heal, revelations like Channel, and immunity to many conditions at 20th.",
                    guide: "oracle#life",
                    pool: "oracle/revelations/life",
                    levels: [
                        (level: 20, features: ["oracle/mystery/life/life-final-revelation"]),
                    ],
                ),
                (
                    key: "oracle/mystery/nature",
                    name: "Nature",
                    summary: "Nature: Athletics as a class skill, Feather Step to Shapechange, revelations like an animal companion, and a restoring form change at 20th.",
                    guide: "oracle#nature",
                    pool: "oracle/revelations/nature",
                    levels: [
                        (level: 1, class_skills: ["athletics"]),
                        (level: 20, features: ["oracle/mystery/nature/nature-final-revelation"]),
                    ],
                ),
                (
                    key: "oracle/mystery/stone",
                    name: "Stone",
                    summary: "Stone: Athletics as a class skill, acid and earth spells from Corrosive Touch to Clashing Rocks, and empowered acid spells at 20th.",
                    guide: "oracle#stone",
                    pool: "oracle/revelations/stone",
                    levels: [
                        (level: 1, class_skills: ["athletics"]),
                        (level: 20, features: ["oracle/mystery/stone/stone-final-revelation"]),
                    ],
                ),
                (
                    key: "oracle/mystery/waves",
                    name: "Waves",
                    summary: "Waves: Athletics and Mobility as class skills, cold spells from Snowball to Tsunami, and empowered cold spells at 20th.",
                    guide: "oracle#waves",
                    pool: "oracle/revelations/waves",
                    levels: [
                        (level: 1, class_skills: ["athletics", "mobility"]),
                        (level: 20, features: ["oracle/mystery/waves/waves-final-revelation"]),
                    ],
                ),
                (
                    key: "oracle/mystery/wind",
                    name: "Wind",
                    summary: "Wind: Mobility and Stealth as class skills, spells from Feather Step to Winds of Vengeance, and empowered electricity spells at 20th.",
                    guide: "oracle#wind",
                    pool: "oracle/revelations/wind",
                    levels: [
                        (level: 1, class_skills: ["mobility", "stealth"]),
                        (level: 20, features: ["oracle/mystery/wind/wind-final-revelation"]),
                    ],
                ),
            ],
        ),
        (
            key: "oracle/oracles-curse",
            name: "Oracle\'s Curse",
            summary: "Pick a curse with a drawback and benefits that grow at 5th, 10th and 15th; its level is oracle level + 1 per two other class levels.",
            guide: "oracle#oracles-curse",
            options: [
                (key: "oracle/oracles-curse/blackened", name: "Blackened", summary: "-4 on weapon attacks (-2 from 10th) for fire spells known: Burning Hands, then Burning Arc, Scorching Ray, Fire Snake and Hellfire Ray.", guide: "oracle#blackened"),
                (key: "oracle/oracles-curse/demonic", name: "Demonic", summary: "-3 Persuasion for diplomacy, +2 Bluff and Intimidate; +4 vs fear at 5th, poison immunity at 10th, chaotic evil weapons at 15th.", guide: "oracle#demonic"),
                (key: "oracle/oracles-curse/hellbound", name: "Hellbound", summary: "-3 Persuasion for diplomacy, +2 Bluff and Intimidate; +4 vs charm at 5th, fire immunity at 10th, lawful evil weapons at 15th.", guide: "oracle#hellbound"),
                (key: "oracle/oracles-curse/lame", name: "Lame", summary: "-10 feet speed but never slowed by encumbrance; immune to fatigue at 5th, not slowed by armor at 10th, immune to exhaustion at 15th.", guide: "oracle#lame"),
                (key: "oracle/oracles-curse/plagued", name: "Plagued", summary: "-1 on saves vs disease but immune to sickened; Pox Pustules at 5th, +2 to your disease DCs at 10th, disease immunity at 15th.", guide: "oracle#plagued"),
                (key: "oracle/oracles-curse/powerless-prophecy", name: "Powerless Prophecy", summary: "Staggered in the first round of combat but gain Uncanny Dodge; +4 initiative at 5th, Improved Uncanny Dodge at 10th, +4 first-round AC and saves at 15th.", guide: "oracle#powerless-prophecy"),
                (key: "oracle/oracles-curse/pranked", name: "Pranked", summary: "-4 initiative for spells known: Faerie Fire, then Glitterdust and Mirror Image at 5th, Confusion at 10th and Insanity at 15th.", guide: "oracle#pranked"),
                (key: "oracle/oracles-curse/wasting", name: "Wasting", summary: "-4 on Charisma skills except Intimidate, +4 vs disease; immune to sickened at 5th, disease at 10th and nauseated at 15th.", guide: "oracle#wasting"),
                (key: "oracle/oracles-curse/wolf-scarred-face", name: "Wolf-Scarred Face", summary: "10% spell failure for a 1d4 bite that grows to 2d6 by 15th, plus Magic Fang at 5th and Greater Magic Fang at 15th.", guide: "oracle#wolf-scarred-face"),
            ],
        ),
        (
            key: "oracle/revelation",
            name: "Revelation",
            summary: "A mystery power at 1st and 3rd level and every 4 levels after.",
            guide: "oracle#revelation",
            option_levels: ["oracle"],
            pool_of: "oracle/mystery",
            options: [],
        ),
        (
            key: "oracle/revelations/ancestor",
            name: "Ancestor Revelations",
            summary: "Ancestor revelations: Blood of Heroes, Phantom Touch, Sacred Council, Spirit Shield, Storm of Souls (7th), Spirit of the Warrior (11th).",
            guide: "oracle#ancestor",
            options: [
                (key: "oracle/revelations/ancestor/blood-of-heroes", name: "Blood of Heroes", summary: "Move action: +1 attack, damage and saves vs fear for Charisma modifier rounds (+2 at 7th, +3 at 14th); 1/day, +1 use per 5 levels.", guide: "oracle#blood-of-heroes"),
                (key: "oracle/revelations/ancestor/phantom-touch", name: "Phantom Touch", summary: "Melee touch shakes a living creature for half your class level in rounds; 3 + Charisma modifier uses a day.", guide: "oracle#phantom-touch"),
                (key: "oracle/revelations/ancestor/sacred-council", name: "Sacred Council", summary: "Move action: +2 on your next d20 roll; Charisma modifier uses a day.", guide: "oracle#sacred-council"),
                (key: "oracle/revelations/ancestor/spirit-of-the-warrior", name: "Spirit of the Warrior", summary: "From 11th level, for 1 round per two levels: +4 Str, Dex and Con, +4 natural armor, BAB equal to class level and keen weapons.", guide: "oracle#spirit-of-the-warrior", prerequisite: Any([ClassLevel(class: "arcanist", level: 11), ClassLevel(class: "oracle", level: 11)])),
                (key: "oracle/revelations/ancestor/spirit-shield", name: "Spirit Shield", summary: "+4 armor bonus barrier for 1 hour per level, +2 at 7th and every 4 levels (+12 at 19th); 50% miss chance on ranged attacks from 13th.", guide: "oracle#spirit-shield"),
                (key: "oracle/revelations/ancestor/storm-of-souls", name: "Storm of Souls", summary: "From 7th level, a 20-foot burst deals 1d8 per two caster levels to the living, 1d8 per level to undead (Fortitude halves); 1/day, more later.", guide: "oracle#storm-of-souls", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
            ],
        ),
        (
            key: "oracle/revelations/battle",
            name: "Battle Revelations",
            summary: "Battle revelations: Battlecry, Battlefield Clarity, Maneuver Mastery, Skill at Arms, War Sight, Weapon Mastery, Combat Healer, Iron Skin.",
            guide: "oracle#battle",
            options: [
                (key: "oracle/revelations/battle/battlecry", name: "Battlecry", summary: "Standard action: allies within 100 feet get +1 morale (+2 at 10th) to attack, skills and saves for Cha modifier rounds; 1/day, +1 per 5 levels.", guide: "oracle#battlecry"),
                (key: "oracle/revelations/battle/battlefield-clarity", name: "Battlefield Clarity", summary: "Swift action: reroll the next save against blinding, fear, paralysis, stun and similar with +4 insight; 1/day, 2 at 7th, 3 at 15th.", guide: "oracle#battlefield-clarity"),
                (key: "oracle/revelations/battle/combat-healer", name: "Combat Healer", summary: "From 7th level, spend two slots to cast a cure spell as a swift action; 1/day, +1 every four levels after 7th.", guide: "oracle#combat-healer", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/battle/iron-skin", name: "Iron Skin", summary: "From 11th level, DR 10/adamantine as Stoneskin at your class level; once a day, twice from 15th.", guide: "oracle#iron-skin", prerequisite: Any([ClassLevel(class: "arcanist", level: 11), ClassLevel(class: "oracle", level: 11)])),
                (
                    key: "oracle/revelations/battle/maneuver-mastery",
                    name: "Maneuver Mastery",
                    summary: "Pick a combat maneuver: you use your class level instead of BAB for its CMB, gain its Improved feat at 7th and its Greater feat at 11th.",
                    guide: "oracle#maneuver-mastery",
                    levels: [
                        (level: 1, selections: ["oracle/maneuver-mastery"]),
                    ],
                ),
                (key: "oracle/revelations/battle/skill-at-arms", name: "Skill at Arms", summary: "Gives Martial Weapon Proficiency and Heavy Armor Proficiency.", guide: "oracle#skill-at-arms", feats: ["armor-proficiency-heavy-armor", "martial-weapons-proficiency"]),
                (
                    key: "oracle/revelations/battle/war-sight",
                    name: "War Sight",
                    summary: "Roll initiative twice and keep the higher; Uncanny Dodge at 7th; roll three times from 11th.",
                    guide: "oracle#war-sight",
                    levels: [
                        (level: 7, features: ["oracle/revelations/battle/war-sight/uncanny-dodge"]),
                    ],
                ),
                (
                    key: "oracle/revelations/battle/weapon-mastery",
                    name: "Weapon Mastery",
                    summary: "Weapon Focus as a bonus feat, Improved Critical at 8th level and Greater Weapon Focus at 12th.",
                    guide: "oracle#weapon-mastery",
                    chosen_feat: "weapon-focus",
                    levels: [
                        (level: 8, chosen_feats: ["improved-critical"]),
                        (level: 12, chosen_feats: ["greater-weapon-focus"]),
                    ],
                ),
            ],
        ),
        (
            key: "oracle/revelations/bones",
            name: "Bones Revelations",
            summary: "Bones revelations: Armor of Bones, Death's Touch, Near Death, Resist Life, Soul Siphon (7th) and Spirit Walk (11th).",
            guide: "oracle#bones",
            options: [
                (key: "oracle/revelations/bones/armor-of-bones", name: "Armor of Bones", summary: "+4 armor bonus barrier for 1 hour per level, +2 at 7th and every 4 levels (+12 at 19th); DR 5/bludgeoning from 13th.", guide: "oracle#armor-of-bones"),
                (key: "oracle/revelations/bones/deaths-touch", name: "Death\'s Touch", summary: "Melee touch for 1d6 negative energy +1 per two class levels; 3 + Charisma modifier uses a day.", guide: "oracle#deaths-touch"),
                (key: "oracle/revelations/bones/near-death", name: "Near Death", summary: "+2 insight on saves vs disease, mind-affecting and poison; also death, sleep and stun from 7th; +4 from 11th.", guide: "oracle#near-death"),
                (key: "oracle/revelations/bones/resist-life", name: "Resist Life", summary: "Positive and negative energy affect you as undead; channel resistance +3 at 7th, +5 at 11th, +7 at 15th.", guide: "oracle#resist-life"),
                (key: "oracle/revelations/bones/soul-siphon", name: "Soul Siphon", summary: "From 7th level, a ranged touch within 30 feet gives a negative level for Cha modifier minutes and heals you class level HP; 1/day, more later.", guide: "oracle#soul-siphon", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/bones/spirit-walk", name: "Spirit Walk", summary: "From 11th level, become incorporeal and invisible for class level rounds; once a day, twice from 15th.", guide: "oracle#spirit-walk", prerequisite: Any([ClassLevel(class: "arcanist", level: 11), ClassLevel(class: "oracle", level: 11)])),
            ],
        ),
        (
            key: "oracle/revelations/flame",
            name: "Flame Revelations",
            summary: "Flame revelations: Burning Magic, Cinder Dance, Fire Breath, Heat Aura, Molten Skin, Touch of Flame, Form of Flame (7th), Firestorm (11th).",
            guide: "oracle#flame",
            options: [
                (key: "oracle/revelations/flame/burning-magic", name: "Burning Magic", summary: "Creatures hurt by your fire spells burn for 1 fire per caster level for 1d4 rounds unless they pass a Reflex save.", guide: "oracle#burning-magic"),
                (key: "oracle/revelations/flame/cinder-dance", name: "Cinder Dance", summary: "+10 feet base speed, and you ignore difficult terrain from 10th level; not with the Lame curse.", guide: "oracle#cinder-dance", prerequisite: Not(SelectionOption("oracle/oracles-curse/lame"))),
                (key: "oracle/revelations/flame/fire-breath", name: "Fire Breath", summary: "Standard action: 15-foot cone of 1d4 fire per class level (Reflex halves); 1/day, +1 use at 5th and every 5 levels.", guide: "oracle#fire-breath"),
                (key: "oracle/revelations/flame/firestorm", name: "Firestorm", summary: "From 11th level, once a day, a 20-foot fire storm deals 1d6 fire per level to enemies (Reflex halves) for Cha modifier rounds.", guide: "oracle#firestorm", prerequisite: Any([ClassLevel(class: "arcanist", level: 11), ClassLevel(class: "oracle", level: 11)])),
                (key: "oracle/revelations/flame/form-of-flame", name: "Form of Flame", summary: "From 7th level, become a Small fire elemental for 1 hour per level; Medium at 9th, Large at 11th, Huge at 13th.", guide: "oracle#form-of-flame", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/flame/heat-aura", name: "Heat Aura", summary: "Swift action: 1d4 fire per two levels to all within 10 feet (Reflex halves) and 20% concealment; 1/day, +1 at 5th and every 5 levels.", guide: "oracle#heat-aura"),
                (key: "oracle/revelations/flame/molten-skin", name: "Molten Skin", summary: "Fire resistance 5, 10 at 5th level, 20 at 11th, and fire immunity at 17th.", guide: "oracle#molten-skin"),
                (key: "oracle/revelations/flame/touch-of-flame", name: "Touch of Flame", summary: "Melee touch for 1d6 fire +1 per two levels, 3 + Cha modifier uses a day; from 11th your weapons are Flaming.", guide: "oracle#touch-of-flame"),
            ],
        ),
        (
            key: "oracle/revelations/life",
            name: "Life Revelations",
            summary: "Life revelations: Channel, Enhanced Cures, Life Link, Safe Cure, Spirit Boost, Combat Healer (7th) and Lifesense (11th).",
            guide: "oracle#life",
            options: [
                (key: "oracle/revelations/life/channel", name: "Channel", summary: "Channel positive energy as a cleric of your level, 1 + Charisma modifier times a day.", guide: "oracle#channel"),
                (key: "oracle/revelations/life/combat-healer-life", name: "Combat Healer (Life)", summary: "From 7th level, spend two slots to cast a cure spell as a swift action; 1/day, +1 every four levels after 7th.", guide: "oracle#combat-healer-life", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/life/enhanced-cures", name: "Enhanced Cures", summary: "Your cure spells' bonus healing is capped by your class level instead of the spell's limit.", guide: "oracle#enhanced-cures"),
                (key: "oracle/revelations/life/life-link", name: "Life Link", summary: "Bond with up to one creature per level: each turn, one 5+ HP below max heals 5 and you take 4.", guide: "oracle#life-link"),
                (key: "oracle/revelations/life/lifesense", name: "Lifesense", summary: "From 11th level, you sense living creatures within 30 feet as if with blindsight.", guide: "oracle#lifesense"),
                (key: "oracle/revelations/life/safe-cure", name: "Safe Cure", summary: "Casting cure spells doesn't provoke attacks of opportunity.", guide: "oracle#safe-cure"),
                (key: "oracle/revelations/life/spirit-boost", name: "Spirit Boost", summary: "Healing past a target's max HP gives the excess, up to your class level, as temporary HP for 1 round.", guide: "oracle#spirit-boost"),
            ],
        ),
        (
            key: "oracle/revelations/nature",
            name: "Nature Revelations",
            summary: "Nature revelations: Animal Companion, Erosion Touch, Friend to Animals, Nature's Whispers, Spirit of Nature and Life Leech (7th).",
            guide: "oracle#nature",
            options: [
                (key: "oracle/revelations/nature/animal-companion", name: "Animal Companion", summary: "Gives you a horse or wolf animal companion.", guide: "oracle#animal-companion"),
                (key: "oracle/revelations/nature/erosion-touch", name: "Erosion Touch", summary: "Melee touch deals 1d6 per class level to constructs; 1/day plus one per three class levels.", guide: "oracle#erosion-touch"),
                (key: "oracle/revelations/nature/friend-to-animals", name: "Friend to Animals", summary: "Adds Summon Nature's Ally spells to your spells known; animals within 30 feet add your Charisma modifier to saves.", guide: "oracle#friend-to-animals"),
                (key: "oracle/revelations/nature/life-leech", name: "Life Leech", summary: "From 7th level, drain 1d6 per two levels from a creature within 30 feet as temporary HP (Fortitude halves); 1/day, more later.", guide: "oracle#life-leech", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/nature/natures-whispers", name: "Nature\'s Whispers", summary: "Use your Charisma modifier instead of Dexterity for AC and CMD.", guide: "oracle#natures-whispers"),
                (key: "oracle/revelations/nature/spirit-of-nature", name: "Spirit of Nature", summary: "Below 0 HP, you get fast healing 1 per 5 oracle levels for 1d4 rounds.", guide: "oracle#spirit-of-nature"),
            ],
        ),
        (
            key: "oracle/revelations/stone",
            name: "Stone Revelations",
            summary: "Stone revelations: Acid Skin, Clobbering Strike, Mighty Pebble, Shard Explosion, Stone Stability and Touch of Acid.",
            guide: "oracle#stone",
            options: [
                (key: "oracle/revelations/stone/acid-skin", name: "Acid Skin", summary: "Acid resistance 5, 10 at 5th level, 20 at 11th, and acid immunity at 17th.", guide: "oracle#acid-skin"),
                (key: "oracle/revelations/stone/clobbering-strike", name: "Clobbering Strike", summary: "A critical hit with an attack-roll spell lets you try a trip as a swift action.", guide: "oracle#clobbering-strike"),
                (key: "oracle/revelations/stone/mighty-pebble", name: "Mighty Pebble", summary: "Ranged touch for 1d6 bludgeoning per two levels with splash to adjacent foes; 1/day, +1 at 5th and every 5 levels.", guide: "oracle#mighty-pebble"),
                (key: "oracle/revelations/stone/shard-explosion", name: "Shard Explosion", summary: "Swift action: 1d6 piercing per two levels within 10 feet (Reflex halves) and 20% concealment; 1/day, +1 at 5th and every 5 levels.", guide: "oracle#shard-explosion"),
                (
                    key: "oracle/revelations/stone/stone-stability",
                    name: "Stone Stability",
                    summary: "+4 CMD against bull rush and trip; Trip as a bonus feat at 5th and Greater Trip at 10th.",
                    guide: "oracle#stone-stability",
                    levels: [
                        (level: 5, feats: ["trip"]),
                        (level: 10, feats: ["greater-trip"]),
                    ],
                ),
                (key: "oracle/revelations/stone/touch-of-acid", name: "Touch of Acid", summary: "Melee touch for 1d6 acid +1 per two levels, 3 + Cha modifier uses a day; from 11th your weapons are Corrosive.", guide: "oracle#touch-of-acid"),
            ],
        ),
        (
            key: "oracle/revelations/waves",
            name: "Waves Revelations",
            summary: "Waves revelations: Fluid Nature, Freezing Spells, Ice Armor, Icy Skin, Wintry Touch, Punitive Transformation (7th), Blizzard (11th).",
            guide: "oracle#waves",
            options: [
                (key: "oracle/revelations/waves/blizzard", name: "Blizzard", summary: "From 11th level, once a day, a 20-foot blizzard deals 1d4 cold per level to enemies (Reflex halves) for Cha modifier rounds.", guide: "oracle#blizzard", prerequisite: Any([ClassLevel(class: "arcanist", level: 11), ClassLevel(class: "oracle", level: 11)])),
                (
                    key: "oracle/revelations/waves/fluid-nature",
                    name: "Fluid Nature",
                    summary: "+4 CMD against bull rush, grapple and trip, and Dodge as a bonus feat at 5th level.",
                    guide: "oracle#fluid-nature",
                    levels: [
                        (level: 5, feats: ["dodge"]),
                    ],
                ),
                (key: "oracle/revelations/waves/freezing-spells", name: "Freezing Spells", summary: "A creature hurt by your cold spell that fails its Reflex save is slowed for 1 round (1d4 rounds from 11th).", guide: "oracle#freezing-spells"),
                (key: "oracle/revelations/waves/ice-armor", name: "Ice Armor", summary: "+4 armor bonus barrier for 1 hour per level, +2 at 7th and every 4 levels (+12 at 19th); DR 5/piercing from 13th.", guide: "oracle#ice-armor"),
                (key: "oracle/revelations/waves/icy-skin", name: "Icy Skin", summary: "Cold resistance 5, 10 at 5th level, 20 at 11th, and cold immunity at 17th.", guide: "oracle#icy-skin"),
                (key: "oracle/revelations/waves/punitive-transformation", name: "Punitive Transformation", summary: "From 7th level, turn an enemy into a harmless animal for 1 round per level; Charisma modifier uses a day.", guide: "oracle#punitive-transformation", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/waves/wintry-touch", name: "Wintry Touch", summary: "Melee touch for 1d6 cold +1 per two levels, 3 + Cha modifier uses a day; from 11th your weapons are Frost.", guide: "oracle#wintry-touch"),
            ],
        ),
        (
            key: "oracle/revelations/wind",
            name: "Wind Revelations",
            summary: "Wind revelations: Air Barrier, Lightning Breath, Spark Skin, Touch of Electricity, Vortex Spells, Invisibility, Thunderburst (7th).",
            guide: "oracle#wind",
            options: [
                (key: "oracle/revelations/wind/air-barrier", name: "Air Barrier", summary: "+4 armor bonus barrier for 1 hour per level, +2 at 7th and every 4 levels (+12 at 19th); 50% miss chance on ranged attacks from 13th.", guide: "oracle#air-barrier"),
                (key: "oracle/revelations/wind/invisibility", name: "Invisibility", summary: "From 3rd level, invisibility for 1 minute per level a day; from 9th, Greater Invisibility at 1 minute per round.", guide: "oracle#invisibility", prerequisite: Any([ClassLevel(class: "arcanist", level: 3), ClassLevel(class: "oracle", level: 3)])),
                (key: "oracle/revelations/wind/lightning-breath", name: "Lightning Breath", summary: "Standard action: 30-foot line of 1d4 electricity per class level (Reflex halves); 1/day, +1 use at 5th and every 5 levels.", guide: "oracle#lightning-breath"),
                (key: "oracle/revelations/wind/spark-skin", name: "Spark Skin", summary: "Electricity resistance 5, 10 at 5th level, 20 at 11th, and electricity immunity at 17th.", guide: "oracle#spark-skin"),
                (key: "oracle/revelations/wind/thunderburst", name: "Thunderburst", summary: "From 7th level, a 20-foot burst of 1d6 bludgeoning per caster level (Fortitude halves); 1/day, +1 every four levels after 7th.", guide: "oracle#thunderburst", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/wind/touch-of-electricity", name: "Touch of Electricity", summary: "Melee touch for 1d6 electricity +1 per two levels, 3 + Cha modifier uses a day; from 11th your weapons are Shock.", guide: "oracle#touch-of-electricity"),
                (key: "oracle/revelations/wind/vortex-spells", name: "Vortex Spells", summary: "A critical hit with an attack-roll spell staggers the target for 1 round (1d4 rounds from 11th).", guide: "oracle#vortex-spells"),
            ],
