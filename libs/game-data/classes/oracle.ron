        (
            key: "oracle/oracles-curse",
            blueprint: "b0a5118b4fb793241bc7042464b23fab",
            name: "Oracle\'s Curse",
            summary: "Pick a curse with a drawback and benefits that grow at 5th, 10th and 15th; its level is oracle level + 1 per two other class levels.",
            guide: "oracle#oracles-curse",
            options: [
                (key: "oracle/oracles-curse/blackened", blueprint: "ca1e4627a1ad8fc4f83158f6497d5c54", name: "Blackened", summary: "-4 on weapon attacks (-2 from 10th) for fire spells known: Burning Hands, then Burning Arc, Scorching Ray, Fire Snake and Hellfire Ray.", guide: "oracle#blackened"),
                (key: "oracle/oracles-curse/demonic", blueprint: "a565a4eb482424548ad2bcc1b6f6ff61", name: "Demonic", summary: "-3 Persuasion for diplomacy, +2 Bluff and Intimidate; +4 vs fear at 5th, poison immunity at 10th, chaotic evil weapons at 15th.", guide: "oracle#demonic"),
                (key: "oracle/oracles-curse/hellbound", blueprint: "9f08f0d1faf141c41a3d8205f1911e96", name: "Hellbound", summary: "-3 Persuasion for diplomacy, +2 Bluff and Intimidate; +4 vs charm at 5th, fire immunity at 10th, lawful evil weapons at 15th.", guide: "oracle#hellbound"),
                (key: "oracle/oracles-curse/lame", blueprint: "3d319da9614c76a41a095a4467c3233f", name: "Lame", summary: "-10 feet speed but never slowed by encumbrance; immune to fatigue at 5th, not slowed by armor at 10th, immune to exhaustion at 15th.", guide: "oracle#lame"),
                (key: "oracle/oracles-curse/plagued", blueprint: "8be8108c3bdac5d4cbad2e54e581d830", name: "Plagued", summary: "-1 on saves vs disease but immune to sickened; Pox Pustules at 5th, +2 to your disease DCs at 10th, disease immunity at 15th.", guide: "oracle#plagued"),
                (key: "oracle/oracles-curse/powerless-prophecy", blueprint: "88c89ab44a36a67438347e257f70c8fe", name: "Powerless Prophecy", summary: "Staggered in the first round of combat but gain Uncanny Dodge; +4 initiative at 5th, Improved Uncanny Dodge at 10th, +4 first-round AC and saves at 15th.", guide: "oracle#powerless-prophecy"),
                (key: "oracle/oracles-curse/pranked", blueprint: "15631616e56ccf44ab8659e55c36185f", name: "Pranked", summary: "-4 initiative for spells known: Faerie Fire, then Glitterdust and Mirror Image at 5th, Confusion at 10th and Insanity at 15th.", guide: "oracle#pranked"),
                (key: "oracle/oracles-curse/wasting", blueprint: "1dddfbb862b6857478d13fcdd78911f4", name: "Wasting", summary: "-4 on Charisma skills except Intimidate, +4 vs disease; immune to sickened at 5th, disease at 10th and nauseated at 15th.", guide: "oracle#wasting"),
                (key: "oracle/oracles-curse/wolf-scarred-face", blueprint: "e8a1096467696d14288079c6393bb58c", name: "Wolf-Scarred Face", summary: "10% spell failure for a 1d4 bite that grows to 2d6 by 15th, plus Magic Fang at 5th and Greater Magic Fang at 15th.", guide: "oracle#wolf-scarred-face"),
            ],
        ),
        (
