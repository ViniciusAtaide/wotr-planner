Class(
    key: "oracle",
    blueprint: "20ce9bf8af32bee4c8557a045ab499b1",
    name: "Oracle",
    summary: "Spontaneous divine caster on the cleric list up to 9th-level spells, keyed on Charisma, with 3/4 BAB, good Will, 6 HP, a mystery and a curse.",
    guide: "oracle",
    skill_points: 3,
    casting_ability: Charisma,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "persuasion"],
    spontaneous: true,
    features: [
        (key: "oracle/additional-spells", blueprint: "2cd080fc181122c4a9c5a705abe8ad47", name: "Additional Spells", summary: "Adds either every cure spell or every inflict spell to your spells known at the matching levels.", guide: "oracle#additional-spells"),
        (key: "oracle/curse-2", name: "Curse 2", summary: "At 5th level, your curse moves to its next stage.", guide: "oracle"),
        (key: "oracle/curse-3", name: "Curse 3", summary: "At 10th level, your curse moves to its next stage.", guide: "oracle"),
        (key: "oracle/curse-4", name: "Curse 4", summary: "At 15th level, your curse moves to its final stage.", guide: "oracle"),
        (key: "oracle/mystery/ancestor/ancestor-final-revelation", blueprint: "933b4d571a31b9a43aa424eac0a22068", name: "Ancestor Final Revelation", summary: "At 20th level: Charisma modifier added to Will saves, 60-foot blindsense, +4 caster level for divination, and Foresight once a day.", guide: "oracle#ancestor-final-revelation"),
        (key: "oracle/mystery/battle/battle-final-revelation", blueprint: "9caa8060ec83c0842b127c318571c6d1", name: "Battle Final Revelation", summary: "At 20th level: Pounce, criticals ignore damage reduction, and +4 insight to AC against critical confirmation rolls.", guide: "oracle#battle-final-revelation"),
        (key: "oracle/mystery/bones/bones-final-revelation", blueprint: "d20e184293942774eac71acb48ad7f26", name: "Bones Final Revelation", summary: "At 20th level: Animate Dead at will, and Power Word Kill once a day on a creature with 150 HP or less.", guide: "oracle#bones-final-revelation"),
        (key: "oracle/mystery/flame/flame-final-revelation", blueprint: "2b61f2c215ec8cb46ab28c4d08ac2cd5", name: "Flame Final Revelation", summary: "At 20th level, all your fire spells are empowered, as Empower Spell.", guide: "oracle#flame-final-revelation"),
        (key: "oracle/mystery/life/life-final-revelation", blueprint: "ee23b52c6a06c0b48a09a7a23071aa52", name: "Life Final Revelation", summary: "At 20th level, immunity to bleed, death attacks, negative levels, and being fatigued, exhausted, sickened or nauseated.", guide: "oracle#life-final-revelation"),
        (key: "oracle/mystery/nature/nature-final-revelation", blueprint: "e46981dfc05f3924784942b8684194ec", name: "Nature Final Revelation", summary: "At 20th level, once a day as a full-round action, change into a plant, animal or humanoid, curing poison, disease and ability damage and healing fully.", guide: "oracle#nature-final-revelation"),
        (key: "oracle/mystery/stone/stone-final-revelation", blueprint: "46d347b49df9ac143b32fa9ef1926ee7", name: "Stone Final Revelation", summary: "At 20th level, all your acid spells are empowered, as Empower Spell.", guide: "oracle#stone-final-revelation"),
        (key: "oracle/mystery/waves/waves-final-revelation", blueprint: "0d5d8144b1e98f74882be1e0756edda6", name: "Waves Final Revelation", summary: "At 20th level, all your cold spells are empowered, as Empower Spell.", guide: "oracle#waves-final-revelation"),
        (key: "oracle/mystery/wind/wind-final-revelation", blueprint: "169f0e005a5cc9143b0009359fa1453f", name: "Wind Final Revelation", summary: "At 20th level, all your electricity spells are empowered, as Empower Spell.", guide: "oracle#wind-final-revelation"),
        (key: "oracle/revelations/battle/war-sight/uncanny-dodge", blueprint: "374008ffbe3d8884aa79077766fa3f3f", name: "Uncanny Dodge", summary: "From War Sight at 7th level: you gain Uncanny Dodge.", guide: "oracle#war-sight"),
    ],
    selections: [
        (
