        (
            key: "oracle/revelations/ancestor",
            blueprint: "60008a10ad7ad6543b1f63016741a5d2",
            name: "Ancestor Revelations",
            summary: "Ancestor revelations: Blood of Heroes, Phantom Touch, Sacred Council, Spirit Shield, Storm of Souls (7th), Spirit of the Warrior (11th).",
            guide: "oracle#ancestor",
            options: [
                (key: "oracle/revelations/ancestor/blood-of-heroes", blueprint: "1b9eebdfa2ad9d44eb60446d465b0cfd", name: "Blood of Heroes", summary: "Move action: +1 attack, damage and saves vs fear for Charisma modifier rounds (+2 at 7th, +3 at 14th); 1/day, +1 use per 5 levels.", guide: "oracle#blood-of-heroes"),
                (key: "oracle/revelations/ancestor/phantom-touch", blueprint: "60a1be62a0edf274580a1cdc5250293e", name: "Phantom Touch", summary: "Melee touch shakes a living creature for half your class level in rounds; 3 + Charisma modifier uses a day.", guide: "oracle#phantom-touch"),
                (key: "oracle/revelations/ancestor/sacred-council", blueprint: "a8ae26103124a1c409279392b8f56238", name: "Sacred Council", summary: "Move action: +2 on your next d20 roll; Charisma modifier uses a day.", guide: "oracle#sacred-council"),
                (key: "oracle/revelations/ancestor/spirit-of-the-warrior", blueprint: "b63f198db73edbc4b84d863cb681f5bc", name: "Spirit of the Warrior", summary: "From 11th level, for 1 round per two levels: +4 Str, Dex and Con, +4 natural armor, BAB equal to class level and keen weapons.", guide: "oracle#spirit-of-the-warrior", prerequisite: Any([ClassLevel(class: "arcanist", level: 11), ClassLevel(class: "oracle", level: 11)])),
                (key: "oracle/revelations/ancestor/spirit-shield", blueprint: "899d6aa944ea9654fa829edcaedcf073", name: "Spirit Shield", summary: "+4 armor bonus barrier for 1 hour per level, +2 at 7th and every 4 levels (+12 at 19th); 50% miss chance on ranged attacks from 13th.", guide: "oracle#spirit-shield"),
                (key: "oracle/revelations/ancestor/storm-of-souls", blueprint: "0edd5395810cf3441a093ca49efb858f", name: "Storm of Souls", summary: "From 7th level, a 20-foot burst deals 1d8 per two caster levels to the living, 1d8 per level to undead (Fortitude halves); 1/day, more later.", guide: "oracle#storm-of-souls", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
            ],
        ),
        (
            key: "oracle/revelations/battle",
            blueprint: "60008a10ad7ad6543b1f63016741a5d2",
            name: "Battle Revelations",
            summary: "Battle revelations: Battlecry, Battlefield Clarity, Maneuver Mastery, Skill at Arms, War Sight, Weapon Mastery, Combat Healer, Iron Skin.",
            guide: "oracle#battle",
            options: [
                (key: "oracle/revelations/battle/battlecry", blueprint: "9a67248ce68bd5f47a36d240ff8196e4", name: "Battlecry", summary: "Standard action: allies within 100 feet get +1 morale (+2 at 10th) to attack, skills and saves for Cha modifier rounds; 1/day, +1 per 5 levels.", guide: "oracle#battlecry"),
                (key: "oracle/revelations/battle/battlefield-clarity", blueprint: "c0c2b21d83dd2514c98ae8d3684ad981", name: "Battlefield Clarity", summary: "Swift action: reroll the next save against blinding, fear, paralysis, stun and similar with +4 insight; 1/day, 2 at 7th, 3 at 15th.", guide: "oracle#battlefield-clarity"),
                (key: "oracle/revelations/battle/combat-healer", blueprint: "db1d9829383e78841a6f1145411a54b4", name: "Combat Healer", summary: "From 7th level, spend two slots to cast a cure spell as a swift action; 1/day, +1 every four levels after 7th.", guide: "oracle#combat-healer", prerequisite: Any([ClassLevel(class: "arcanist", level: 7), ClassLevel(class: "oracle", level: 7)])),
                (key: "oracle/revelations/battle/iron-skin", blueprint: "7b3f171fe4577474ead600758543cbef", name: "Iron Skin", summary: "From 11th level, DR 10/adamantine as Stoneskin at your class level; once a day, twice from 15th.", guide: "oracle#iron-skin", prerequisite: Any([ClassLevel(class: "arcanist", level: 11), ClassLevel(class: "oracle", level: 11)])),
                (
                    key: "oracle/revelations/battle/maneuver-mastery",
