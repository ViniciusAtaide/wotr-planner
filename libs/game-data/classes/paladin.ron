                (level: 20, spell_levels: (arcane: 0, divine: 0), features: ["paladin/holy-champion"]),
            ],
        ),
        (
            key: "paladin/divine-hunter-paladin",
            blueprint: "fec08c1a3187da549abd6b85f27e4432",
            name: "Divine Hunter (Paladin)",
            summary: "Ranged Dexterity and Charisma paladin with no heavy armour or mount.",
            guide: "paladin#divine-hunter-paladin",
            features: [
                (key: "paladin/divine-hunter-paladin/aura-of-clear-sight", blueprint: "c00342384c641be409907c2bf39d68f1", name: "Aura of Clear Sight", summary: "From 8th level, immune to blindness; allies within 10 feet get +4 morale to saves against it.", guide: "paladin#aura-of-clear-sight"),
                (key: "paladin/divine-hunter-paladin/distant-mercy", blueprint: "12678d8f1c24b7b4fbeeee096e7873e5", name: "Distant Mercy", summary: "From 6th level, two Lay on Hands uses heal a target up to 5 feet per class level away.", guide: "paladin#distant-mercy"),
                (key: "paladin/divine-hunter-paladin/divine-hunter-bond", blueprint: "275d3dd6cad51cf4db9b0bceebff02f2", name: "Divine Hunter Bond", summary: "From 5th level, Divine Weapon Bond applied to your ranged weapon.", guide: "paladin#divine-hunter-bond"),
                (key: "paladin/divine-hunter-paladin/hunters-blessing", blueprint: "ae98475b3f5d3aa4bb830d352655a8ed", name: "Hunter\'s Blessing", summary: "From 11th level, a smite use (swift) gives you and non-evil allies within 10 feet Deadly Aim and (Improved) Precise Shot for 1 minute.", guide: "paladin#hunters-blessing"),
                (key: "paladin/divine-hunter-paladin/righteous-hunter", blueprint: "a848c3b021fec214b97c720eb986800f", name: "Righteous Hunter", summary: "From 14th level, your ranged weapons and those of allies within 10 feet count as good for overcoming DR.", guide: "paladin#righteous-hunter"),
                (key: "paladin/divine-hunter-paladin/shared-precision", blueprint: "3fc1ad7b5f67543488d6c84fc6bc48c9", name: "Shared Precision", summary: "From 3rd level, your ranged hits give allies within 10 feet the Precise Shot benefit against that foe for 1 round.", guide: "paladin#shared-precision"),
            ],
            levels: [
                (level: 1, features: ["paladin/alignment-restriction", "paladin/smite-evil"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "precise-shot", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["paladin/divine-health", "paladin/divine-hunter-paladin/shared-precision"], selections: ["paladin/mercy"]),
                (level: 5, features: ["paladin/divine-hunter-paladin/divine-hunter-bond"]),
                (level: 6, features: ["paladin/divine-hunter-paladin/distant-mercy"]),
                (level: 8, features: ["paladin/divine-hunter-paladin/aura-of-clear-sight"]),
                (level: 11, features: ["paladin/divine-hunter-paladin/hunters-blessing"]),
