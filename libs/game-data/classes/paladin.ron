        (
            key: "paladin/hospitaler",
            blueprint: "fcdb27e1a6cef834ea1d7fab7c6e2b61",
            name: "Hospitaler",
            summary: "Paladin focused on healing, with a separate channel energy pool and fewer smites.",
            guide: "paladin#hospitaler",
            features: [
                (key: "paladin/hospitaler/aura-of-life", blueprint: "d19ef94d056fd1a45bb08017b10a5e93", name: "Aura of Life", summary: "From 11th level, immune to death effects; allies within 10 feet get +4 morale to saves against them.", guide: "paladin#aura-of-life"),
                (key: "paladin/hospitaler/channel-positive-energy-hospitaler", blueprint: "a9ab1bbc79ecb174d9a04699986ce8d5", name: "Channel Positive Energy (Hospitaler)", summary: "Channel Energy no longer uses Lay on Hands; you get 3 + Cha uses a day instead.", guide: "paladin#channel-positive-energy-hospitaler"),
                (key: "paladin/hospitaler/smite-evil-hospitaler", blueprint: "3a6db57fce75b0244a6a5819528ddf26", name: "Smite Evil (Hospitaler)", summary: "Fewer smites: extra uses only at 7th, 13th and 19th level.", guide: "paladin#smite-evil-hospitaler"),
            ],
            levels: [
                (level: 1, features: ["paladin/alignment-restriction", "paladin/hospitaler/smite-evil-hospitaler"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
