Class(
    key: "paladin",
    blueprint: "bfa11238e7ae3544bbeb4d0b92e897ec",
    name: "Paladin",
    summary: "Lawful good holy warrior: full BAB, good Fortitude and Will, prepared divine spells up to 4th level from 4th, Smite Evil and Lay on Hands.",
    guide: "paladin",
    skill_points: 2,
    casting_ability: Charisma,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Good,
    save_exceptions: [(level: 20, save: Will, value: 20)],
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "persuasion"],
    prerequisite: Alignment(LawfulGood),
    features: [
        (key: "paladin/alignment-restriction", blueprint: "f8c91c0135d5fc3458fcc131c4b77e96", name: "Alignment Restriction", summary: "Loses all class powers while not Lawful Good, until the alignment returns.", guide: "paladin#alignment-restriction"),
        (key: "paladin/aura-of-courage", blueprint: "e45ab30f49215054e83b4ea12165409f", name: "Aura of Courage", summary: "From 3rd level, immune to fear; allies within 10 feet get +4 morale to saves against fear.", guide: "paladin#aura-of-courage"),
        (key: "paladin/aura-of-faith", blueprint: "0437f4af5ad49b544bccf48aa7a51319", name: "Aura of Faith", summary: "From 14th level, your weapons and those of allies within 10 feet count as good for overcoming DR.", guide: "paladin#aura-of-faith"),
        (key: "paladin/aura-of-resolve", blueprint: "a28693b24cc412c478b8b85877f2dad2", name: "Aura of Resolve", summary: "From 8th level, immune to charm; allies within 10 feet get +4 morale to saves against charm.", guide: "paladin#aura-of-resolve"),
        (key: "paladin/aura-of-righteousness", blueprint: "6bd4a71232014254e80726f3a3756962", name: "Aura of Righteousness", summary: "From 17th level, DR 5/evil and immunity to compulsion; allies within 10 feet get +4 morale to saves against compulsion.", guide: "paladin#aura-of-righteousness"),
        (key: "paladin/channel-positive-energy", blueprint: "cb6d55dda5ab906459d18a435994a760", name: "Channel Positive Energy", summary: "From 4th level, you channel energy like a cleric of your deity, at the cost of two uses of Lay on Hands.", guide: "paladin#channel-positive-energy"),
        (key: "paladin/divine-bond", blueprint: "ad7dc4eba7bf92f4aba23f716d7a9ba6", name: "Divine Bond", summary: "At 5th level, you choose a mount or a bond with your weapon.", guide: "paladin#divine-bond"),
        (key: "paladin/divine-grace", blueprint: "8a5b5e272e5c34e41aa8b4facbb746d3", name: "Divine Grace", summary: "From 2nd level, adds your Charisma modifier to all saving throws.", guide: "paladin#divine-grace"),
        (key: "paladin/divine-health", blueprint: "41d1d0de15e672349bf4262a5acf06ce", name: "Divine Health", summary: "From 3rd level, immune to all diseases.", guide: "paladin#divine-health"),
        (key: "paladin/divine-weapon-bond", blueprint: "e08a817f475c8794aa56fdd904f43a57", name: "Divine Weapon Bond", summary: "Standard action: +1 enhancement or properties on your weapon for 1 minute per level, +1 per 3 levels after 5th; 1/day, +1 use per 4 levels.", guide: "paladin#divine-weapon-bond"),
        (key: "paladin/holy-champion", blueprint: "eff3b63f744868845a2f511e9929f0de", name: "Holy Champion", summary: "At 20th level, DR becomes 10/evil, and your Lay on Hands and Channel Energy are always maximised.", guide: "paladin#holy-champion"),
        (key: "paladin/lay-on-hands", blueprint: "858a3689c285c844d9e6ce278e686491", name: "Lay On Hands", summary: "From 2nd level, heals 1d6 per 2 levels (swift on self, standard on others) or harms undead; half level + Cha uses a day.", guide: "paladin#lay-on-hands"),
        (key: "paladin/mark-of-justice", blueprint: "9f13fdd044ccb8a439f27417481cb00e", name: "Mark of Justice", summary: "From 11th level, two smite uses give allies all of Smite Evil's bonuses for 1 minute, but not you.", guide: "paladin#mark-of-justice"),
        (key: "paladin/smite-evil", blueprint: "3a6db57fce75b0244a6a5819528ddf26", name: "Smite Evil", summary: "Swift action against an evil foe: +Cha to attack, +level to damage, bypasses DR and +Cha deflection AC against it; 1/day, +1 per 3 levels.", guide: "paladin#smite-evil"),
    ],
    selections: [
        (
            key: "paladin/mercy",
            blueprint: "02b187038a8dce545bb34bbfb346428d",
            name: "Mercy",
            summary: "At 3rd level and every 3 levels, a mercy that lets Lay on Hands also remove a condition.",
            guide: "paladin#mercy",
            options: [
                (key: "paladin/mercy/blinded", blueprint: "23c3fb906c6346440b4e7d92fc25319b", name: "Blinded", summary: "From 12th level, Lay on Hands also removes blindness.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 12)),
                (key: "paladin/mercy/confused", blueprint: "d306e052d2f85b24cb5082951459045e", name: "Confused", summary: "From 9th level, Lay on Hands also removes confusion.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 9)),
                (key: "paladin/mercy/cursed", blueprint: "445c696bead5140459909ffbed14750e", name: "Cursed", summary: "From 9th level, Lay on Hands also removes curses.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 9)),
                (key: "paladin/mercy/dazed", blueprint: "7df9329013baaec4fac20ae08bc1f849", name: "Dazed", summary: "From 6th level, Lay on Hands also removes the dazed condition.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 6)),
                (key: "paladin/mercy/diseased", blueprint: "3990a92ce97efa3439e55c160412ce14", name: "Diseased", summary: "From 6th level, Lay on Hands also removes diseases.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 6)),
                (key: "paladin/mercy/exhausted", blueprint: "25641bda25467224e930e8c70eaf9a83", name: "Exhausted", summary: "From 9th level, needs the Fatigued mercy: Lay on Hands also removes exhaustion.", guide: "paladin#mercy", prerequisite: All([ClassLevel(class: "paladin", level: 9), SelectionOption("paladin/mercy/fatigued")])),
                (key: "paladin/mercy/fatigued", blueprint: "e5aa306af9b91974a9b2f2cbe702f562", name: "Fatigued", summary: "From 3rd level, Lay on Hands also removes fatigue.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 3)),
                (key: "paladin/mercy/frightened", blueprint: "7687aa3764cb651448a50016e1758069", name: "Frightened", summary: "From 9th level, needs the Shaken mercy: Lay on Hands also removes the frightened condition.", guide: "paladin#mercy", prerequisite: All([ClassLevel(class: "paladin", level: 9), SelectionOption("paladin/mercy/shaken")])),
                (key: "paladin/mercy/nauseated", blueprint: "a0cacf71d872d2a42ae3deb6bf977962", name: "Nauseated", summary: "From 9th level, needs the Sickened mercy: Lay on Hands also removes nausea.", guide: "paladin#mercy", prerequisite: All([ClassLevel(class: "paladin", level: 9), SelectionOption("paladin/mercy/sickened")])),
                (key: "paladin/mercy/paralyzed", blueprint: "62582b4636218d74db34606f872c9c05", name: "Paralyzed", summary: "From 12th level, Lay on Hands also removes paralysis.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 12)),
                (key: "paladin/mercy/poisoned", blueprint: "19f936eb38c3d224988e2a02cbe12878", name: "Poisoned", summary: "From 9th level, Lay on Hands also removes poison.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 9)),
                (key: "paladin/mercy/shaken", blueprint: "c4732ca5b0af7214a98f9b4dafe87da9", name: "Shaken", summary: "From 3rd level, Lay on Hands also removes the shaken condition.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 3)),
                (key: "paladin/mercy/sickened", blueprint: "7ee2ef06226a4884f80b7647a2aa2dee", name: "Sickened", summary: "From 3rd level, Lay on Hands also removes the sickened condition.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 3)),
                (key: "paladin/mercy/staggered", blueprint: "19250e5a12db1fc448970b81e0f38922", name: "Staggered", summary: "From 6th level, Lay on Hands also removes the staggered condition.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 6)),
                (key: "paladin/mercy/stunned", blueprint: "7775c915661f8fb449c38dd873524389", name: "Stunned", summary: "From 12th level, Lay on Hands also removes stun.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 12)),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["paladin/alignment-restriction", "paladin/smite-evil"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, features: ["paladin/divine-grace", "paladin/lay-on-hands"]),
        (level: 3, features: ["paladin/aura-of-courage", "paladin/divine-health"], selections: ["paladin/mercy"]),
        (level: 4, features: ["paladin/channel-positive-energy", "paladin/smite-evil"]),
        (level: 5, divine_spell_level: 1, features: ["paladin/divine-bond"]),
        (level: 6, divine_spell_level: 1, selections: ["paladin/mercy"]),
        (level: 7, divine_spell_level: 1, features: ["paladin/smite-evil"]),
        (level: 8, divine_spell_level: 2, features: ["paladin/aura-of-resolve"]),
        (level: 9, divine_spell_level: 2, selections: ["paladin/mercy"]),
        (level: 10, divine_spell_level: 2, features: ["paladin/smite-evil"]),
        (level: 11, divine_spell_level: 3, features: ["paladin/mark-of-justice"]),
        (level: 12, divine_spell_level: 3, selections: ["paladin/mercy"]),
        (level: 13, divine_spell_level: 3, features: ["paladin/smite-evil"]),
        (level: 14, divine_spell_level: 4, features: ["paladin/aura-of-faith"]),
        (level: 15, divine_spell_level: 4, selections: ["paladin/mercy"]),
        (level: 16, divine_spell_level: 4, features: ["paladin/smite-evil"]),
        (level: 17, divine_spell_level: 4, features: ["paladin/aura-of-righteousness"]),
        (level: 18, divine_spell_level: 4, selections: ["paladin/mercy"]),
        (level: 19, divine_spell_level: 4, features: ["paladin/smite-evil"]),
        (level: 20, divine_spell_level: 4, features: ["paladin/holy-champion"]),
    ],
    archetypes: [
        (
            key: "paladin/divine-guardian",
            blueprint: "5693945afac189a469ef970eac8f71d9",
            name: "Divine Guardian",
            summary: "Paladin who protects a chosen ally and gains bonus feats, but casts no spells.",
            guide: "paladin#divine-guardian",
            features: [
                (key: "paladin/divine-guardian/courageous-defense", blueprint: "b15e384109d1af147a31f6119f92c876", name: "Courageous Defense", summary: "Grants immunity to fear; its attack interception and allies' save bonus are not implemented.", guide: "paladin#courageous-defense"),
                (key: "paladin/divine-guardian/divine-troth", blueprint: "d8979d762de7da14ca64f8cedd5c1220", name: "Divine Troth", summary: "You pledge protection to a creature for the day: spend an attack of opportunity to give it +4 dodge AC; can target yourself.", guide: "paladin#divine-troth"),
                (key: "paladin/divine-guardian/guarding-hands", blueprint: "ba9fa17a17e5a494a93cd181b5615198", name: "Guarding Hands", summary: "From 2nd level, Lay on Hands that also heals your divine troth as a swift action.", guide: "paladin#guarding-hands"),
            ],
            feat_lists: [
                (key: "paladin/divine-guardian/bonus-feats", blueprint: "5a4560c300c368b4289ae2b4e4da58cf", name: "Divine Guardian Bonus Feat", guide: "paladin#divine-guardian-bonus-feat", ignores_prerequisites: true, feats: ["combat-reflexes", "diehard", "dodge", "endurance", "great-fortitude", "improved-great-fortitude", "improved-iron-will", "improved-lightning-reflexes", "iron-will", "lightning-reflexes", "missile-shield", "shield-focus", "toughness", "tower-shield-proficiency"]),
            ],
            levels: [
                (level: 2, features: ["paladin/divine-grace", "paladin/divine-guardian/divine-troth", "paladin/divine-guardian/guarding-hands"]),
                (level: 3, features: ["paladin/divine-guardian/courageous-defense", "paladin/divine-health"], selections: ["paladin/mercy"]),
                (level: 5, spell_levels: (arcane: 0, divine: 0), features: ["paladin/divine-bond"]),
                (level: 6, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 7, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"], feat_slots: [OneOf(list: "paladin/divine-guardian/bonus-feats")]),
                (level: 8, spell_levels: (arcane: 0, divine: 0), features: ["paladin/aura-of-resolve"]),
                (level: 9, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 10, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"], feat_slots: [OneOf(list: "paladin/divine-guardian/bonus-feats")]),
                (level: 11, spell_levels: (arcane: 0, divine: 0), features: ["paladin/mark-of-justice"]),
                (level: 12, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 13, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"], feat_slots: [OneOf(list: "paladin/divine-guardian/bonus-feats")]),
                (level: 14, spell_levels: (arcane: 0, divine: 0), features: ["paladin/aura-of-faith"]),
                (level: 15, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 16, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"]),
                (level: 17, spell_levels: (arcane: 0, divine: 0), features: ["paladin/aura-of-righteousness"]),
                (level: 18, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
