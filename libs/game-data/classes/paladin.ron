        (
            key: "paladin/martyr",
            blueprint: "4d9a864eae278744aafa7ff23f2a6466",
            name: "Martyr",
            summary: "You gain bardic performances and wider auras but lose your own save bonuses and immunities.",
            guide: "paladin#martyr",
            features: [
                (key: "paladin/martyr/aura-mastery", blueprint: "1b7118c3857bea643882335a0fd29e67", name: "Aura Mastery", summary: "Your auras of courage, resolve and righteousness reach farther, but you are not immune to their effects.", guide: "paladin#aura-mastery"),
                (key: "paladin/martyr/aura-of-courage-martyr", blueprint: "8121d2fb0b4cd4746a2cda39ef77a9a5", name: "Aura of Courage (Martyr)", summary: "From 3rd level, you and allies within 20 feet get +4 morale to saves against fear.", guide: "paladin#aura-of-courage-martyr"),
                (key: "paladin/martyr/aura-of-health", blueprint: "caa8099018a01b74298aecb560b21cdc", name: "Aura of Health", summary: "From 3rd level, you and allies within 20 feet get +4 morale to saves against disease.", guide: "paladin#aura-of-health"),
                (key: "paladin/martyr/inspire-courage", blueprint: "c0a1b34b616abb74fa4e9d749d6c3cd3", name: "Inspire Courage", summary: "As the Bard's: allies get +1 morale on saves against charm and fear and +1 competence to attack and damage, rising to +4 by 17th level.", guide: "paladin#martyr"),
                (key: "paladin/martyr/inspire-greatness", blueprint: "d5462ffa4e044694781126316950f836", name: "Inspire Greatness", summary: "Bardic performance as the Bard's: allies get 2d10 HP, +2 competence to attacks and +1 to Fortitude saves.", guide: "paladin#martyr"),
                (key: "paladin/martyr/inspire-heroics", blueprint: "6a7f94467a64e8a4993a7f45b891e667", name: "Inspire Heroics", summary: "Bardic performance as the Bard's: allies get +4 morale to saves and +4 dodge AC.", guide: "paladin#martyr"),
