Class(
    key: "paladin",
    name: "Paladin",
    summary: "Lawful good holy warrior: full BAB, good Fortitude and Will, prepared divine spells up to 4th level from 4th, Smite Evil and Lay on Hands.",
    guide: "paladin",
    skill_points: 2,
    casting_ability: Charisma,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Good,
    save_exceptions: [(level: 20, save: Will, value: 20)],
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "persuasion"],
    prerequisite: Alignment(LawfulGood),
    features: [
        (key: "paladin/alignment-restriction", name: "Alignment Restriction", summary: "Loses all class powers while not Lawful Good, until the alignment returns.", guide: "paladin#alignment-restriction"),
        (key: "paladin/aura-of-courage", name: "Aura of Courage", summary: "From 3rd level, immune to fear; allies within 10 feet get +4 morale to saves against fear.", guide: "paladin#aura-of-courage"),
        (key: "paladin/aura-of-faith", name: "Aura of Faith", summary: "From 14th level, your weapons and those of allies within 10 feet count as good for overcoming DR.", guide: "paladin#aura-of-faith"),
        (key: "paladin/aura-of-resolve", name: "Aura of Resolve", summary: "From 8th level, immune to charm; allies within 10 feet get +4 morale to saves against charm.", guide: "paladin#aura-of-resolve"),
        (key: "paladin/aura-of-righteousness", name: "Aura of Righteousness", summary: "From 17th level, DR 5/evil and immunity to compulsion; allies within 10 feet get +4 morale to saves against compulsion.", guide: "paladin#aura-of-righteousness"),
        (key: "paladin/channel-positive-energy", name: "Channel Positive Energy", summary: "From 4th level, you channel energy like a cleric of your deity, at the cost of two uses of Lay on Hands.", guide: "paladin#channel-positive-energy"),
        (key: "paladin/divine-bond", name: "Divine Bond", summary: "At 5th level, you choose a mount or a bond with your weapon.", guide: "paladin#divine-bond"),
        (key: "paladin/divine-grace", name: "Divine Grace", summary: "From 2nd level, adds your Charisma modifier to all saving throws.", guide: "paladin#divine-grace"),
        (key: "paladin/divine-health", name: "Divine Health", summary: "From 3rd level, immune to all diseases.", guide: "paladin#divine-health"),
        (key: "paladin/divine-weapon-bond", name: "Divine Weapon Bond", summary: "Standard action: +1 enhancement or properties on your weapon for 1 minute per level, +1 per 3 levels after 5th; 1/day, +1 use per 4 levels.", guide: "paladin#divine-weapon-bond"),
        (key: "paladin/holy-champion", name: "Holy Champion", summary: "At 20th level, DR becomes 10/evil, and your Lay on Hands and Channel Energy are always maximised.", guide: "paladin#holy-champion"),
        (key: "paladin/lay-on-hands", name: "Lay On Hands", summary: "From 2nd level, heals 1d6 per 2 levels (swift on self, standard on others) or harms undead; half level + Cha uses a day.", guide: "paladin#lay-on-hands"),
        (key: "paladin/mark-of-justice", name: "Mark of Justice", summary: "From 11th level, two smite uses give allies all of Smite Evil's bonuses for 1 minute, but not you.", guide: "paladin#mark-of-justice"),
        (key: "paladin/smite-evil", name: "Smite Evil", summary: "Swift action against an evil foe: +Cha to attack, +level to damage, bypasses DR and +Cha deflection AC against it; 1/day, +1 per 3 levels.", guide: "paladin#smite-evil"),
    ],
    selections: [
        (
            key: "paladin/mercy",
            name: "Mercy",
            summary: "At 3rd level and every 3 levels, a mercy that lets Lay on Hands also remove a condition.",
            guide: "paladin#mercy",
            options: [
                (key: "paladin/mercy/blinded", name: "Blinded", summary: "From 12th level, Lay on Hands also removes blindness.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 12)),
                (key: "paladin/mercy/confused", name: "Confused", summary: "From 9th level, Lay on Hands also removes confusion.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 9)),
                (key: "paladin/mercy/cursed", name: "Cursed", summary: "From 9th level, Lay on Hands also removes curses.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 9)),
                (key: "paladin/mercy/dazed", name: "Dazed", summary: "From 6th level, Lay on Hands also removes the dazed condition.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 6)),
                (key: "paladin/mercy/diseased", name: "Diseased", summary: "From 6th level, Lay on Hands also removes diseases.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 6)),
                (key: "paladin/mercy/exhausted", name: "Exhausted", summary: "From 9th level, needs the Fatigued mercy: Lay on Hands also removes exhaustion.", guide: "paladin#mercy", prerequisite: All([ClassLevel(class: "paladin", level: 9), SelectionOption("paladin/mercy/fatigued")])),
                (key: "paladin/mercy/fatigued", name: "Fatigued", summary: "From 3rd level, Lay on Hands also removes fatigue.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 3)),
                (key: "paladin/mercy/frightened", name: "Frightened", summary: "From 9th level, needs the Shaken mercy: Lay on Hands also removes the frightened condition.", guide: "paladin#mercy", prerequisite: All([ClassLevel(class: "paladin", level: 9), SelectionOption("paladin/mercy/shaken")])),
                (key: "paladin/mercy/nauseated", name: "Nauseated", summary: "From 9th level, needs the Sickened mercy: Lay on Hands also removes nausea.", guide: "paladin#mercy", prerequisite: All([ClassLevel(class: "paladin", level: 9), SelectionOption("paladin/mercy/sickened")])),
                (key: "paladin/mercy/paralyzed", name: "Paralyzed", summary: "From 12th level, Lay on Hands also removes paralysis.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 12)),
                (key: "paladin/mercy/poisoned", name: "Poisoned", summary: "From 9th level, Lay on Hands also removes poison.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 9)),
                (key: "paladin/mercy/shaken", name: "Shaken", summary: "From 3rd level, Lay on Hands also removes the shaken condition.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 3)),
                (key: "paladin/mercy/sickened", name: "Sickened", summary: "From 3rd level, Lay on Hands also removes the sickened condition.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 3)),
                (key: "paladin/mercy/staggered", name: "Staggered", summary: "From 6th level, Lay on Hands also removes the staggered condition.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 6)),
                (key: "paladin/mercy/stunned", name: "Stunned", summary: "From 12th level, Lay on Hands also removes stun.", guide: "paladin#mercy", prerequisite: ClassLevel(class: "paladin", level: 12)),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["paladin/alignment-restriction", "paladin/smite-evil"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, features: ["paladin/divine-grace", "paladin/lay-on-hands"]),
        (level: 3, features: ["paladin/aura-of-courage", "paladin/divine-health"], selections: ["paladin/mercy"]),
        (level: 4, features: ["paladin/channel-positive-energy", "paladin/smite-evil"]),
        (level: 5, divine_spell_level: 1, features: ["paladin/divine-bond"]),
        (level: 6, divine_spell_level: 1, selections: ["paladin/mercy"]),
        (level: 7, divine_spell_level: 1, features: ["paladin/smite-evil"]),
        (level: 8, divine_spell_level: 2, features: ["paladin/aura-of-resolve"]),
        (level: 9, divine_spell_level: 2, selections: ["paladin/mercy"]),
        (level: 10, divine_spell_level: 2, features: ["paladin/smite-evil"]),
        (level: 11, divine_spell_level: 3, features: ["paladin/mark-of-justice"]),
        (level: 12, divine_spell_level: 3, selections: ["paladin/mercy"]),
        (level: 13, divine_spell_level: 3, features: ["paladin/smite-evil"]),
        (level: 14, divine_spell_level: 4, features: ["paladin/aura-of-faith"]),
        (level: 15, divine_spell_level: 4, selections: ["paladin/mercy"]),
        (level: 16, divine_spell_level: 4, features: ["paladin/smite-evil"]),
        (level: 17, divine_spell_level: 4, features: ["paladin/aura-of-righteousness"]),
        (level: 18, divine_spell_level: 4, selections: ["paladin/mercy"]),
        (level: 19, divine_spell_level: 4, features: ["paladin/smite-evil"]),
        (level: 20, divine_spell_level: 4, features: ["paladin/holy-champion"]),
    ],
    archetypes: [
        (
            key: "paladin/divine-guardian",
            name: "Divine Guardian",
            summary: "Paladin who protects a chosen ally and gains bonus feats, but casts no spells.",
            guide: "paladin#divine-guardian",
            features: [
                (key: "paladin/divine-guardian/courageous-defense", name: "Courageous Defense", summary: "Grants immunity to fear; its attack interception and allies' save bonus are not implemented.", guide: "paladin#courageous-defense"),
                (key: "paladin/divine-guardian/divine-troth", name: "Divine Troth", summary: "You pledge protection to a creature for the day: spend an attack of opportunity to give it +4 dodge AC; can target yourself.", guide: "paladin#divine-troth"),
                (key: "paladin/divine-guardian/guarding-hands", name: "Guarding Hands", summary: "From 2nd level, Lay on Hands that also heals your divine troth as a swift action.", guide: "paladin#guarding-hands"),
            ],
            feat_lists: [
                (key: "paladin/divine-guardian/bonus-feats", name: "Divine Guardian Bonus Feat", guide: "paladin#divine-guardian-bonus-feat", ignores_prerequisites: true, feats: ["combat-reflexes", "diehard", "dodge", "endurance", "great-fortitude", "improved-great-fortitude", "improved-iron-will", "improved-lightning-reflexes", "iron-will", "lightning-reflexes", "missile-shield", "shield-focus", "toughness", "tower-shield-proficiency"]),
            ],
            levels: [
                (level: 2, features: ["paladin/divine-grace", "paladin/divine-guardian/divine-troth", "paladin/divine-guardian/guarding-hands"]),
                (level: 3, features: ["paladin/divine-guardian/courageous-defense", "paladin/divine-health"], selections: ["paladin/mercy"]),
                (level: 5, spell_levels: (arcane: 0, divine: 0), features: ["paladin/divine-bond"]),
                (level: 6, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 7, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"], feat_slots: [OneOf(list: "paladin/divine-guardian/bonus-feats")]),
                (level: 8, spell_levels: (arcane: 0, divine: 0), features: ["paladin/aura-of-resolve"]),
                (level: 9, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 10, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"], feat_slots: [OneOf(list: "paladin/divine-guardian/bonus-feats")]),
                (level: 11, spell_levels: (arcane: 0, divine: 0), features: ["paladin/mark-of-justice"]),
                (level: 12, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 13, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"], feat_slots: [OneOf(list: "paladin/divine-guardian/bonus-feats")]),
                (level: 14, spell_levels: (arcane: 0, divine: 0), features: ["paladin/aura-of-faith"]),
                (level: 15, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 16, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"]),
                (level: 17, spell_levels: (arcane: 0, divine: 0), features: ["paladin/aura-of-righteousness"]),
                (level: 18, spell_levels: (arcane: 0, divine: 0), selections: ["paladin/mercy"]),
                (level: 19, spell_levels: (arcane: 0, divine: 0), features: ["paladin/smite-evil"]),
                (level: 20, spell_levels: (arcane: 0, divine: 0), features: ["paladin/holy-champion"]),
            ],
        ),
        (
            key: "paladin/divine-hunter-paladin",
            name: "Divine Hunter (Paladin)",
            summary: "Ranged Dexterity and Charisma paladin with no heavy armour or mount.",
            guide: "paladin#divine-hunter-paladin",
            features: [
                (key: "paladin/divine-hunter-paladin/aura-of-clear-sight", name: "Aura of Clear Sight", summary: "From 8th level, immune to blindness; allies within 10 feet get +4 morale to saves against it.", guide: "paladin#aura-of-clear-sight"),
                (key: "paladin/divine-hunter-paladin/distant-mercy", name: "Distant Mercy", summary: "From 6th level, two Lay on Hands uses heal a target up to 5 feet per class level away.", guide: "paladin#distant-mercy"),
                (key: "paladin/divine-hunter-paladin/divine-hunter-bond", name: "Divine Hunter Bond", summary: "From 5th level, Divine Weapon Bond applied to your ranged weapon.", guide: "paladin#divine-hunter-bond"),
                (key: "paladin/divine-hunter-paladin/hunters-blessing", name: "Hunter\'s Blessing", summary: "From 11th level, a smite use (swift) gives you and non-evil allies within 10 feet Deadly Aim and (Improved) Precise Shot for 1 minute.", guide: "paladin#hunters-blessing"),
                (key: "paladin/divine-hunter-paladin/righteous-hunter", name: "Righteous Hunter", summary: "From 14th level, your ranged weapons and those of allies within 10 feet count as good for overcoming DR.", guide: "paladin#righteous-hunter"),
                (key: "paladin/divine-hunter-paladin/shared-precision", name: "Shared Precision", summary: "From 3rd level, your ranged hits give allies within 10 feet the Precise Shot benefit against that foe for 1 round.", guide: "paladin#shared-precision"),
            ],
            levels: [
                (level: 1, features: ["paladin/alignment-restriction", "paladin/smite-evil"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "precise-shot", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["paladin/divine-health", "paladin/divine-hunter-paladin/shared-precision"], selections: ["paladin/mercy"]),
                (level: 5, features: ["paladin/divine-hunter-paladin/divine-hunter-bond"]),
                (level: 6, features: ["paladin/divine-hunter-paladin/distant-mercy"]),
                (level: 8, features: ["paladin/divine-hunter-paladin/aura-of-clear-sight"]),
                (level: 11, features: ["paladin/divine-hunter-paladin/hunters-blessing"]),
                (level: 14, features: ["paladin/divine-hunter-paladin/righteous-hunter"]),
                (level: 18),
            ],
        ),
        (
            key: "paladin/divine-scion",
            name: "Divine Scion",
            summary: "Paladin with Studied Target and sneak attack instead of Smite Evil and Divine Bond; Perception and 3 skill points per level.",
            guide: "paladin#divine-scion",
            skill_points: 3,
            class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "perception", "persuasion"],
            features: [
                (key: "paladin/divine-scion/divine-insight", name: "Divine Insight", summary: "From 5th level, adds your Charisma modifier as an insight bonus to Lore and Knowledge checks.", guide: "paladin#divine-insight"),
                (key: "paladin/divine-scion/sneak-attack", name: "Sneak Attack", summary: "From 5th level, +1d6 damage against flanked foes or those denied Dexterity to AC, +1d6 at 10th, 15th and 20th.", guide: "paladin#sneak-attack"),
                (key: "paladin/divine-scion/studied-target", name: "Studied Target", summary: "As the Slayer's: move action to study a foe for +1 attack, damage and ability DCs against it, rising with level.", guide: "paladin#studied-target"),
                (key: "paladin/divine-scion/studied-target-swift", name: "Studied Target (Swift)", summary: "As the Slayer's: Studied Target becomes a swift action.", guide: "paladin#divine-scion"),
            ],
            levels: [
                (level: 1, features: ["paladin/alignment-restriction", "paladin/divine-scion/studied-target"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 4, features: ["paladin/channel-positive-energy"]),
                (level: 5, features: ["paladin/divine-scion/divine-insight", "paladin/divine-scion/sneak-attack", "paladin/divine-scion/studied-target"]),
                (level: 7, features: ["paladin/divine-scion/studied-target-swift"]),
                (level: 10, features: ["paladin/divine-scion/sneak-attack", "paladin/divine-scion/studied-target"]),
                (level: 11),
                (level: 13),
                (level: 15, features: ["paladin/divine-scion/sneak-attack", "paladin/divine-scion/studied-target"], selections: ["paladin/mercy"]),
                (level: 16),
                (level: 19),
                (level: 20, features: ["paladin/divine-scion/sneak-attack", "paladin/divine-scion/studied-target", "paladin/holy-champion"]),
            ],
        ),
        (
            key: "paladin/hospitaler",
            name: "Hospitaler",
            summary: "Paladin focused on healing, with a separate channel energy pool and fewer smites.",
            guide: "paladin#hospitaler",
            features: [
                (key: "paladin/hospitaler/aura-of-life", name: "Aura of Life", summary: "From 11th level, immune to death effects; allies within 10 feet get +4 morale to saves against them.", guide: "paladin#aura-of-life"),
                (key: "paladin/hospitaler/channel-positive-energy-hospitaler", name: "Channel Positive Energy (Hospitaler)", summary: "Channel Energy no longer uses Lay on Hands; you get 3 + Cha uses a day instead.", guide: "paladin#channel-positive-energy-hospitaler"),
                (key: "paladin/hospitaler/smite-evil-hospitaler", name: "Smite Evil (Hospitaler)", summary: "Fewer smites: extra uses only at 7th, 13th and 19th level.", guide: "paladin#smite-evil-hospitaler"),
            ],
            levels: [
                (level: 1, features: ["paladin/alignment-restriction", "paladin/hospitaler/smite-evil-hospitaler"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 4, features: ["paladin/hospitaler/channel-positive-energy-hospitaler"]),
                (level: 5, features: ["paladin/divine-weapon-bond"]),
                (level: 7, features: ["paladin/hospitaler/smite-evil-hospitaler"]),
                (level: 10),
                (level: 11, features: ["paladin/hospitaler/aura-of-life"]),
                (level: 13, features: ["paladin/hospitaler/smite-evil-hospitaler"]),
                (level: 16),
                (level: 19, features: ["paladin/hospitaler/smite-evil-hospitaler"]),
            ],
        ),
        (
            key: "paladin/martyr",
            name: "Martyr",
            summary: "You gain bardic performances and wider auras but lose your own save bonuses and immunities.",
            guide: "paladin#martyr",
            features: [
                (key: "paladin/martyr/aura-mastery", name: "Aura Mastery", summary: "Your auras of courage, resolve and righteousness reach farther, but you are not immune to their effects.", guide: "paladin#aura-mastery"),
                (key: "paladin/martyr/aura-of-courage-martyr", name: "Aura of Courage (Martyr)", summary: "From 3rd level, you and allies within 20 feet get +4 morale to saves against fear.", guide: "paladin#aura-of-courage-martyr"),
                (key: "paladin/martyr/aura-of-health", name: "Aura of Health", summary: "From 3rd level, you and allies within 20 feet get +4 morale to saves against disease.", guide: "paladin#aura-of-health"),
                (key: "paladin/martyr/inspire-courage", name: "Inspire Courage", summary: "As the Bard's: allies get +1 morale on saves against charm and fear and +1 competence to attack and damage, rising to +4 by 17th level.", guide: "paladin#martyr"),
                (key: "paladin/martyr/inspire-greatness", name: "Inspire Greatness", summary: "Bardic performance as the Bard's: allies get 2d10 HP, +2 competence to attacks and +1 to Fortitude saves.", guide: "paladin#martyr"),
                (key: "paladin/martyr/inspire-heroics", name: "Inspire Heroics", summary: "Bardic performance as the Bard's: allies get +4 morale to saves and +4 dodge AC.", guide: "paladin#martyr"),
                (key: "paladin/martyr/martyrs-mercy", name: "Martyr\'s Mercy", summary: "From 3rd level, you can remove any condition you have the level for; without the matching mercy, you take it on yourself.", guide: "paladin#martyrs-mercy"),
                (key: "paladin/martyr/see-no-evil-hear-no-evil", name: "See No Evil, Hear No Evil", summary: "From 2nd level, you and allies within 20 feet get +4 morale to saves against gaze attacks and sonic effects.", guide: "paladin#see-no-evil-hear-no-evil"),
                (key: "paladin/martyr/stigmata", name: "Stigmata", summary: "Standard action devotional chant for 4 + Cha rounds a day, +1 per level after 1st; you take 1 bleed damage each round.", guide: "paladin#stigmata"),
                (key: "paladin/martyr/stigmata-move-action", name: "Stigmata - Move Action", summary: "From 7th level, Stigmata starts as a move action.", guide: "paladin#martyr"),
                (key: "paladin/martyr/stigmata-swift-action", name: "Stigmata - Swift Action", summary: "From 13th level, Stigmata starts as a swift action.", guide: "paladin#martyr"),
            ],
            levels: [
                (level: 1, features: ["paladin/alignment-restriction", "paladin/martyr/inspire-courage", "paladin/martyr/stigmata"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["paladin/lay-on-hands", "paladin/martyr/see-no-evil-hear-no-evil"]),
                (level: 3, features: ["paladin/martyr/aura-mastery", "paladin/martyr/aura-of-courage-martyr", "paladin/martyr/aura-of-health", "paladin/martyr/martyrs-mercy"], selections: ["paladin/mercy"]),
                (level: 4, features: ["paladin/channel-positive-energy"]),
                (level: 7, features: ["paladin/martyr/stigmata-move-action"]),
                (level: 10, features: ["paladin/martyr/inspire-greatness"]),
                (level: 11),
                (level: 13, features: ["paladin/martyr/stigmata-swift-action"]),
                (level: 16, features: ["paladin/martyr/inspire-heroics"]),
                (level: 19),
            ],
        ),
        (
            key: "paladin/stonelord",
            name: "Stonelord",
            summary: "Dwarf-only paladin with natural armour, adamantine DR and a growing chance to shrug off crits, instead of Smite Evil.",
            guide: "paladin#stonelord",
            prerequisite: Race("dwarf"),
            features: [
                (key: "paladin/stonelord/defensive-powers", name: "Defensive Powers", guide: "paladin#stonelord"),
                (key: "paladin/stonelord/defensive-stance", name: "Defensive Stance", guide: "paladin#stonelord"),
                (key: "paladin/stonelord/heartstone", name: "Heartstone", summary: "From 2nd level, +1 natural armour (+1 at 6th and every 4 levels, max +5) and adamantine DR equal to class level.", guide: "paladin#heartstone"),
                (key: "paladin/stonelord/stone-body", name: "Stone Body", summary: "At 20th level, immune to paralysis, poison, stun, critical hits and precision damage.", guide: "paladin#stone-body"),
                (key: "paladin/stonelord/stoneblood", name: "Stoneblood", summary: "25% chance to ignore crits and precision damage from 3rd level; 50% and petrification immunity at 9th; 75% and bleed immunity at 15th.", guide: "paladin#stoneblood"),
                (key: "paladin/stonelord/stonestrike", name: "Stonestrike", summary: "Once a day per level, attacks count as magic and adamantine for 1 round with +1 attack and damage (+1 per 5 levels, max +5).", guide: "paladin#stonestrike"),
            ],
            levels: [
                (level: 1, features: ["paladin/alignment-restriction", "paladin/stonelord/stonestrike"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["paladin/lay-on-hands", "paladin/stonelord/heartstone"]),
                (level: 3, features: ["paladin/aura-of-courage", "paladin/stonelord/stoneblood"]),
                (level: 4, features: ["paladin/channel-positive-energy", "paladin/stonelord/defensive-stance"]),
                (level: 6, features: ["paladin/stonelord/heartstone"], selections: ["paladin/mercy"]),
                (level: 7),
                (level: 8, features: ["paladin/aura-of-resolve", "paladin/stonelord/defensive-powers"]),
