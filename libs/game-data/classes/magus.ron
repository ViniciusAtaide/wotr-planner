Class(
    key: "magus",
    blueprint: "45a4607686d96a1498891b3286121780",
    name: "Magus",
    summary: "Arcane gish who casts and strikes in the same round; Dex and Int, 3/4 BAB, prepared arcane spells to 6th level, good Fortitude and Will, 6 HP a level.",
    guide: "magus",
    skill_points: 2,
    casting_ability: Intelligence,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "persuasion", "use-magic-device"],
    features: [
        (key: "magus/arcane-heavy-armor", blueprint: "447ca91389e5c9246acb2c640d63f4da", name: "Arcane Heavy Armor", summary: "At 13th level, proficiency with heavy armour, and casting in it without arcane spell failure.", guide: "magus"),
        (key: "magus/arcane-medium-armor", blueprint: "b24897e082896654c8dd64c8fb677363", name: "Arcane Medium Armor", summary: "At 7th level, proficiency with medium armour, and casting in it without arcane spell failure.", guide: "magus"),
        (key: "magus/arcane-pool", blueprint: "3ce9bb90749c21249adc639031d5eed1", name: "Arcane Pool", summary: "Pool of half level + Int points: a swift-action point gives the weapon +1 (to +5 at 17th) for a minute, or properties from 5th; also fuels arcana.", guide: "magus#arcane-pool"),
        (key: "magus/arcane-weapon-2", blueprint: "36b609a6946733c42930c55ac540416b", name: "Arcane Weapon +2", summary: "From 5th level, an arcane pool point gives the weapon up to +2 enhancement, usable for properties such as flaming or keen.", guide: "magus"),
        (key: "magus/arcane-weapon-3", blueprint: "70be888059f99a245a79d6d61b90edc5", name: "Arcane Weapon +3", summary: "From 9th level, the arcane pool weapon bonus rises to +3, and the speed property becomes available.", guide: "magus"),
        (key: "magus/arcane-weapon-4", blueprint: "1804187264121cd439d70a96234d4ddb", name: "Arcane Weapon +4", summary: "From 13th level, the arcane pool weapon bonus rises to +4.", guide: "magus"),
        (key: "magus/arcane-weapon-5", blueprint: "3cbe3e308342b3247ba2f4fbaf5e6307", name: "Arcane Weapon +5", summary: "From 17th level, the arcane pool weapon bonus rises to +5.", guide: "magus"),
        (key: "magus/counterstrike", blueprint: "cd96b7275c206da4899c69ae127ffda6", name: "Counterstrike", summary: "At 16th level, an enemy in reach who casts defensively provokes an attack of opportunity from you.", guide: "magus#counterstrike"),
        (key: "magus/fighter-training", blueprint: "2b636b9e8dd7df94cbd372c52237eebf", name: "Fighter Training", summary: "At 10th level, count half your magus level as fighter levels for feats, stacking with real fighter levels.", guide: "magus#fighter-training"),
        (key: "magus/greater-spell-access", blueprint: "de18c849c41dbfa44801d812376c707d", name: "Greater Spell Access", summary: "At 19th level, learn 6 spells of levels 1-6 from the full wizard list.", guide: "magus#greater-spell-access"),
        (key: "magus/greater-spell-combat", blueprint: "379887a82a7248946bbf6d0158663b5e", name: "Greater Spell Combat", summary: "At 14th level, +4 on concentration checks during spell combat.", guide: "magus#greater-spell-combat"),
        (key: "magus/improved-spell-combat", blueprint: "836879fcd5b29754eb664a090bd6c22f", name: "Improved Spell Combat", summary: "At 8th level, +2 on concentration checks during spell combat.", guide: "magus#improved-spell-combat"),
        (key: "magus/improved-spell-recall", blueprint: "0ef6ec1c2fdfc204fbd3bff9f1609490", name: "Improved Spell Recall", summary: "From 11th level, Spell Recall costs half the spell's level (rounded up).", guide: "magus#improved-spell-recall"),
        (key: "magus/magus-proficiencies", blueprint: "8f8c2640ffad89349883fc2e5ff2091e", name: "Magus Proficiencies", summary: "Simple and martial weapons and light armour, with no spell failure for magus spells in light armour.", guide: "magus#magus-proficiencies"),
        (key: "magus/spell-combat", blueprint: "2464ba53317c7fc4d88f383fac2b45f9", name: "Spell Combat", summary: "With the off hand free and a light or one-handed weapon, full attack at -2 and also cast a standard-action spell.", guide: "magus#spell-combat"),
        (key: "magus/spell-recall", blueprint: "61fc0521e9992624e9c518060bf89c0f", name: "Spell Recall", summary: "From 4th level, spend arcane pool points equal to a spell's level to recall a spell you already cast.", guide: "magus#spell-recall"),
        (key: "magus/spellstrike", blueprint: "be50f4e97fff8a24ba92561f1694a945", name: "Spellstrike", summary: "From 2nd level, deliver touch spells through a melee weapon attack at your highest attack bonus, in addition to other attacks.", guide: "magus#spellstrike"),
        (key: "magus/true-magus", blueprint: "789c7539ba659174db702e18d7c2d330", name: "True Magus", summary: "At 20th, spell combat needs no concentration check, and you choose +2 to the spell's DC, to beat spell resistance or to attack rolls.", guide: "magus#true-magus"),
    ],
    selections: [
        (
            key: "magus/magus-arcana",
            blueprint: "e9dc4dfc73eaaf94aae27e0ed6cc9ada",
            name: "Magus Arcana",
            summary: "Choose a magus arcana at 3rd level and every three levels after.",
            guide: "magus#magus-arcana",
            options: [
                (key: "magus/magus-arcana/arcane-accuracy", blueprint: "2eacbdbf1c4f4134aa7fea99ab8763dc", name: "Arcane Accuracy", summary: "Swift action, 1 arcane point: insight bonus equal to Int on all attack rolls until the end of your turn.", guide: "magus#arcane-accuracy"),
                (key: "magus/magus-arcana/bane-blade-level-15", blueprint: "a2e0691dcfda2374e84d8bbf480e06a0", name: "Bane Blade (Level 15)", summary: "When enhancing your weapon, spend 1 extra point to add the bane property.", guide: "magus#bane-blade-level-15"),
                (key: "magus/magus-arcana/devoted-blade-level-12", blueprint: "4be0bb10e110a35419e406da767bd1e3", name: "Devoted Blade (Level 12)", summary: "Your weapon enhancement can add anarchic, axiomatic, holy or unholy.", guide: "magus#devoted-blade-level-12"),
                (key: "magus/magus-arcana/dimension-strike-level-9", blueprint: "cb6916027e3c25e4185de068249254dc", name: "Dimension Strike (Level 9)", summary: "Swift action, 2 arcane points: all your melee attacks resolve as touch attacks.", guide: "magus#dimension-strike-level-9"),
                (key: "magus/magus-arcana/empowered-magic-level-6", blueprint: "4cab1e1a9d8e68f41a48777196c65501", name: "Empowered Magic (Level 6)", summary: "Cast three spells a day as if with Empower Spell.", guide: "magus#empowered-magic-level-6"),
                (key: "magus/magus-arcana/enduring-blade-level-6", blueprint: "7a73bf165e8eda6478b4419f857d1ab5", name: "Enduring Blade (Level 6)", summary: "Spend 1 extra point when enhancing your weapon to make it last 1 minute per level.", guide: "magus#enduring-blade-level-6"),
                (key: "magus/magus-arcana/extended-magic", blueprint: "90101ec16ba183c4fb38fbb40a66502f", name: "Extended Magic", summary: "Cast three spells a day as if with Extend Spell.", guide: "magus#extended-magic"),
                (key: "magus/magus-arcana/ghost-blade-level-9", blueprint: "8896f327c59569c4eaf129bf35b96c1f", name: "Ghost Blade (Level 9)", summary: "Your weapon enhancement can add brilliant energy and ghost touch.", guide: "magus#ghost-blade-level-9"),
                (key: "magus/magus-arcana/hasted-assault-level-9", blueprint: "85c05a8120e3e9f4e8ae01625038809a", name: "Hasted Assault (Level 9)", summary: "Spend 1 arcane point to Haste yourself for a duration equal to your Int bonus.", guide: "magus#hasted-assault-level-9"),
                (key: "magus/magus-arcana/maximized-magic-level-12", blueprint: "6c44c7fe4cf35644ea5ed25e48aa6db6", name: "Maximized Magic (Level 12)", summary: "Cast three spells a day as if with Maximize Spell.", guide: "magus#maximized-magic-level-12"),
                (key: "magus/magus-arcana/prescient-attack-level-6", blueprint: "a3909a7293533fe49a2d7cfe051f17e4", name: "Prescient Attack (Level 6)", summary: "Spend 1 arcane point: enemies lose their Dex bonus against you until the end of your next turn.", guide: "magus#prescient-attack-level-6"),
                (key: "magus/magus-arcana/quickened-magic-level-15", blueprint: "10a75ca624a7d3242a05003d22bc38f0", name: "Quickened Magic (Level 15)", summary: "Cast three spells a day as if with Quicken Spell.", guide: "magus#quickened-magic-level-15"),
                (key: "magus/magus-arcana/reach-magic", blueprint: "9d6546880b05e9a43bb6cc5e1d374c6a", name: "Reach Magic", summary: "Cast three spells a day as if with Reach Spell.", guide: "magus#reach-magic"),
                (key: "magus/magus-arcana/wand-mastery", blueprint: "1b94043744e83494c8a083319e1602f3", name: "Wand Mastery", summary: "Wands you use set their DC with your Int bonus instead of the minimum.", guide: "magus#wand-mastery"),
                (key: "magus/magus-arcana/wand-wielder", blueprint: "5826562b74d529e41af2d60feeca093d", name: "Wand Wielder", summary: "Use a wand or staff instead of casting a spell during spell combat.", guide: "magus#wand-wielder"),
            ],
        ),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["magus/arcane-pool", "magus/magus-proficiencies", "magus/spell-combat"], feats: ["armor-proficiency-light-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
        (level: 2, arcane_spell_level: 1, features: ["magus/spellstrike"]),
        (level: 3, arcane_spell_level: 1, selections: ["magus/magus-arcana"]),
        (level: 4, arcane_spell_level: 2, features: ["magus/spell-recall"]),
        (level: 5, arcane_spell_level: 2, features: ["magus/arcane-weapon-2"], feat_slots: [General]),
        (level: 6, arcane_spell_level: 2, selections: ["magus/magus-arcana"]),
        (level: 7, arcane_spell_level: 3, features: ["magus/arcane-medium-armor"], feats: ["armor-proficiency-medium-armor"]),
        (level: 8, arcane_spell_level: 3, features: ["magus/improved-spell-combat"]),
        (level: 9, arcane_spell_level: 3, features: ["magus/arcane-weapon-3"], selections: ["magus/magus-arcana"]),
        (level: 10, arcane_spell_level: 4, features: ["magus/fighter-training"]),
        (level: 11, arcane_spell_level: 4, features: ["magus/improved-spell-recall"], feat_slots: [General]),
        (level: 12, arcane_spell_level: 4, selections: ["magus/magus-arcana"]),
        (level: 13, arcane_spell_level: 5, features: ["magus/arcane-heavy-armor", "magus/arcane-weapon-4"], feats: ["armor-proficiency-heavy-armor"]),
        (level: 14, arcane_spell_level: 5, features: ["magus/greater-spell-combat"]),
        (level: 15, arcane_spell_level: 5, selections: ["magus/magus-arcana"]),
        (level: 16, arcane_spell_level: 6, features: ["magus/counterstrike"]),
        (level: 17, arcane_spell_level: 6, features: ["magus/arcane-weapon-5"], feat_slots: [General]),
        (level: 18, arcane_spell_level: 6, selections: ["magus/magus-arcana"]),
        (level: 19, arcane_spell_level: 6, features: ["magus/greater-spell-access"]),
        (level: 20, arcane_spell_level: 6, features: ["magus/true-magus"]),
    ],
    archetypes: [
        (
            key: "magus/arcane-rider",
            blueprint: "2dff80a045794cb9b5452fe7b66b79d7",
            name: "Arcane Rider",
            summary: "Mounted magus whose arcane pool also empowers their horse; loses medium and heavy armour and Spell Recall.",
            guide: "magus#arcane-rider",
            features: [
                (key: "magus/arcane-rider/arcane-mount", blueprint: "5ced53df7c1c46e5a6c665ff05e2962b", name: "Arcane Mount", summary: "Gain a horse; your arcane pool abilities also apply to it.", guide: "magus#arcane-mount"),
                (key: "magus/arcane-rider/arcane-weapon-2", blueprint: "36b609a6946733c42930c55ac540416b", name: "Arcane Weapon +2", summary: "From 5th level, an arcane pool point gives the weapon up to +2 enhancement, usable for properties such as flaming or keen.", guide: "magus#arcane-rider"),
                (key: "magus/arcane-rider/arcane-weapon-3", blueprint: "70be888059f99a245a79d6d61b90edc5", name: "Arcane Weapon +3", summary: "From 9th level, the arcane pool weapon bonus rises to +3, and the speed property becomes available.", guide: "magus#arcane-rider"),
                (key: "magus/arcane-rider/arcane-weapon-4", blueprint: "1804187264121cd439d70a96234d4ddb", name: "Arcane Weapon +4", summary: "From 13th level, the arcane pool weapon bonus rises to +4.", guide: "magus#arcane-rider"),
                (key: "magus/arcane-rider/arcane-weapon-5", blueprint: "3cbe3e308342b3247ba2f4fbaf5e6307", name: "Arcane Weapon +5", summary: "From 17th level, the arcane pool weapon bonus rises to +5.", guide: "magus#arcane-rider"),
                (key: "magus/arcane-rider/dimensional-ride", blueprint: "ad20d347286f463f90f3532f7dddac0f", name: "Dimensional Ride", summary: "At 8th level, 1 arcane point and a move action teleport you and your mount up to 30'.", guide: "magus#dimensional-ride"),
                (key: "magus/arcane-rider/greater-dimensional-ride", blueprint: "d7ad915605954b35846cd2f0a4207fc8", name: "Greater Dimensional Ride", summary: "At 14th level, Dimensional Ride is a swift action and hastes you and your mount for Int mod rounds.", guide: "magus#greater-dimensional-ride"),
            ],
            levels: [
                (level: 1, features: ["magus/arcane-pool", "magus/arcane-rider/arcane-mount", "magus/magus-proficiencies", "magus/spell-combat"], feats: ["armor-proficiency-light-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
                (level: 4),
                (level: 5, features: ["magus/arcane-rider/arcane-weapon-2"], feat_slots: [General]),
                (level: 7),
                (level: 8, features: ["magus/arcane-rider/dimensional-ride", "magus/improved-spell-combat"]),
