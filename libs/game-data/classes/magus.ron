                (key: "magus/sword-saint/perfect-strike", name: "Perfect Strike", summary: "From 4th level, 1 arcane point maximises your chosen weapon's damage, or 2 points on a confirmed crit add +1 to its multiplier.", guide: "magus#perfect-strike"),
                (key: "magus/sword-saint/superior-reflexes", name: "Superior Reflexes", summary: "At 11th level, make attacks of opportunity equal to your Int mod each round, stacking with Combat Reflexes.", guide: "magus#superior-reflexes"),
                (key: "magus/sword-saint/sword-saint-proficiencies", name: "Sword Saint Proficiencies", summary: "Only simple weapons and the chosen weapon; no armour, and arcane spell failure when wearing it.", guide: "magus#sword-saint-proficiencies"),
                (key: "magus/sword-saint/weapon-mastery", name: "Weapon Mastery", summary: "At 20th level, chosen-weapon threats always confirm and their crit multiplier rises by 1.", guide: "magus#weapon-mastery"),
