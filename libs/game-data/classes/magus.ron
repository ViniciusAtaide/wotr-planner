                (level: 6, features: ["magus/bladebound/sharpening-the-black-blade"], selections: ["magus/magus-arcana"]),
                (level: 7, features: ["magus/bladebound/arcane-medium-armor"], feats: ["armor-proficiency-medium-armor"]),
                (level: 9, features: ["magus/bladebound/arcane-weapon-3", "magus/bladebound/black-blade", "magus/bladebound/sharpening-the-black-blade"], selections: ["magus/magus-arcana"]),
                (level: 12, features: ["magus/bladebound/independent-ego", "magus/bladebound/sharpening-the-black-blade"]),
                (level: 13, features: ["magus/bladebound/arcane-heavy-armor", "magus/bladebound/arcane-weapon-4", "magus/bladebound/black-blade"], feats: ["armor-proficiency-heavy-armor"]),
                (level: 15, features: ["magus/bladebound/sharpening-the-black-blade"], selections: ["magus/magus-arcana"]),
                (level: 17, features: ["magus/bladebound/arcane-weapon-5", "magus/bladebound/black-blade"], feat_slots: [General]),
                (level: 18, features: ["magus/bladebound/sharpening-the-black-blade"]),
                (level: 19, features: ["magus/bladebound/life-drinker", "magus/greater-spell-access"]),
            ],
        ),
