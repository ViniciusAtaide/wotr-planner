                (key: "magus/spell-dancer/spell-dance", name: "Spell Dance", summary: "Swift action, 1 arcane point: +10' speed and +2 dodge AC against attacks of opportunity for 1 minute, growing every four levels.", guide: "magus#spell-dance"),
                (key: "magus/spell-dancer/spell-dance-ii", name: "Spell Dance (II)", summary: "At 5th level, Spell Dance gives +20' speed and +4 AC against attacks of opportunity, and can grant Blur or Haste for 1 round.", guide: "magus#spell-dancer"),
