                (level: 11, feat_slots: [General]),
                (level: 13, features: ["magus/arcane-rider/arcane-weapon-4"]),
                (level: 14, features: ["magus/arcane-rider/greater-dimensional-ride", "magus/greater-spell-combat"]),
                (level: 17, features: ["magus/arcane-rider/arcane-weapon-5"], feat_slots: [General]),
            ],
        ),
        (
            key: "magus/armored-battlemage",
            blueprint: "67ec8dcae6fb3d3439e5ae874ddc7b9b",
            name: "Armored Battlemage",
            summary: "Defensive magus who enchants armour instead of weapons and gets Armor Training, but loses Spell Combat and some arcana.",
            guide: "magus#armored-battlemage",
            features: [
                (key: "magus/armored-battlemage/arcane-armor-2", blueprint: "9157c414fd5f3b346aaa67474a40dd16", name: "Arcane Armor +2", summary: "From 5th level, arcane pool armour enhancement rises to +2, usable for armour properties.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-armor-3", blueprint: "b42b0a354efe5ac4898283ddd71ffaae", name: "Arcane Armor +3", summary: "From 9th level, arcane pool armour enhancement rises to +3.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-armor-4", blueprint: "fd856d29019ccca4f8b67bde8554d0c4", name: "Arcane Armor +4", summary: "From 13th level, arcane pool armour enhancement rises to +4.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-armor-5", blueprint: "08a480ca96c7a834f86813f959a69fa9", name: "Arcane Armor +5", summary: "From 17th level, arcane pool armour enhancement rises to +5.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-heavy-armor", blueprint: "64e83bc639626a34181edb6f6648e90b", name: "Arcane Heavy Armor", summary: "At 7th level, proficiency with heavy armour, and casting in it without arcane spell failure.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-pool-armored-battlemage", blueprint: "466c40aba50096341bf6532b1e53e8bd", name: "Arcane Pool (Armored Battlemage)", summary: "Swift action, 1 point: +1 enhancement to your armour for a minute (+5 at 17th), or armour properties from 5th; can't enhance weapons.", guide: "magus#arcane-pool-armored-battlemage"),
                (key: "magus/armored-battlemage/armor-training", blueprint: "7be523d531bb17449bdba98df0e197ff", name: "Armor Training", summary: "Armor Training at 3rd level and again at 8th, 13th and 18th, as the fighter ability.", guide: "magus#armor-training"),
                (key: "magus/armored-battlemage/armored-battlemage-proficiencies", blueprint: "9a4287e181c450447af1a7565c1b260b", name: "Armored Battlemage Proficiencies", summary: "Simple and martial weapons, light and medium armour, and casting magus spells in them.", guide: "magus#armored-battlemage-proficiencies"),
            ],
            levels: [
                (level: 1, features: ["magus/armored-battlemage/arcane-pool-armored-battlemage", "magus/armored-battlemage/armored-battlemage-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["magus/armored-battlemage/armor-training"]),
                (level: 5, features: ["magus/armored-battlemage/arcane-armor-2"], feat_slots: [General]),
                (level: 7, features: ["magus/armored-battlemage/arcane-heavy-armor"], feats: ["armor-proficiency-heavy-armor"]),
                (level: 8, features: ["magus/armored-battlemage/armor-training"]),
                (level: 9, features: ["magus/armored-battlemage/arcane-armor-3"], selections: ["magus/magus-arcana"]),
                (level: 13, features: ["magus/armored-battlemage/arcane-armor-4", "magus/armored-battlemage/armor-training"]),
                (level: 17, features: ["magus/armored-battlemage/arcane-armor-5"], feat_slots: [General]),
                (level: 18, features: ["magus/armored-battlemage/armor-training"]),
            ],
        ),
        (
            key: "magus/bladebound",
            blueprint: "9b3915d38c7d4b6495415b38571e9d53",
            name: "Bladebound",
            summary: "Magus (Dance of Masks DLC) bonded to a sentient black blade that can fight on its own; fewer arcana and bonus feats.",
            guide: "magus#bladebound",
            features: [
                (key: "magus/bladebound/arcane-heavy-armor", blueprint: "447ca91389e5c9246acb2c640d63f4da", name: "Arcane Heavy Armor", summary: "At 13th level, proficiency with heavy armour, and casting in it without arcane spell failure.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-medium-armor", blueprint: "b24897e082896654c8dd64c8fb677363", name: "Arcane Medium Armor", summary: "At 7th level, proficiency with medium armour, and casting in it without arcane spell failure.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-weapon-2", blueprint: "36b609a6946733c42930c55ac540416b", name: "Arcane Weapon +2", summary: "From 5th level, an arcane pool point gives the weapon up to +2 enhancement, usable for properties such as flaming or keen.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-weapon-3", blueprint: "70be888059f99a245a79d6d61b90edc5", name: "Arcane Weapon +3", summary: "From 9th level, the arcane pool weapon bonus rises to +3, and the speed property becomes available.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-weapon-4", blueprint: "1804187264121cd439d70a96234d4ddb", name: "Arcane Weapon +4", summary: "From 13th level, the arcane pool weapon bonus rises to +4.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-weapon-5", blueprint: "3cbe3e308342b3247ba2f4fbaf5e6307", name: "Arcane Weapon +5", summary: "From 17th level, the arcane pool weapon bonus rises to +5.", guide: "magus#bladebound"),
                (key: "magus/bladebound/black-blade", blueprint: "1e7c04a3151043d792d6a5153c84d779", name: "Black Blade", summary: "A +1 scimitar you summon as a swift action, gaining +1 enhancement at 5th and every four levels (+5 at 17th).", guide: "magus#black-blade"),
                (key: "magus/bladebound/changeable-gist", blueprint: "4302fb536c604be9a7bc062252dcb9ff", name: "Changeable Gist", summary: "From 5th level, 1 arcane point turns the blade's damage to cold, electricity or fire, or 2 points to sonic or force, until your next turn.", guide: "magus#changeable-gist"),
                (key: "magus/bladebound/independent-ego", blueprint: "8c306308b09848bbb49c835dd3ea1030", name: "Independent Ego", summary: "From 12th level, as a free action, let the blade fight on its own for 1 minute, using your Int, BAB and level for its stats.", guide: "magus#independent-ego"),
                (key: "magus/bladebound/life-drinker", blueprint: "3fc2666011fd4f128b235b040d9818af", name: "Life Drinker", summary: "From 19th level, killing a 10+ HD creature with the blade gives temporary HP of level + 3, or 1 arcane pool point if you already have them.", guide: "magus#bladebound"),
                (key: "magus/bladebound/sharpening-the-black-blade", blueprint: "a5f8b3acaa0e4df49a7cb1eb8456d09a", name: "Sharpening the Black Blade", summary: "From 3rd level, free action, 1 arcane point: the blade gets +1 damage for 1 minute, +1 every three levels (+6 at 18th).", guide: "magus#sharpening-the-black-blade"),
            ],
            levels: [
                (level: 1, features: ["magus/arcane-pool", "magus/bladebound/black-blade", "magus/magus-proficiencies", "magus/spell-combat"], feats: ["armor-proficiency-light-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["magus/bladebound/sharpening-the-black-blade"]),
