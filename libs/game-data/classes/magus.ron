Class(
    key: "magus",
    name: "Magus",
    summary: "Arcane gish who casts and strikes in the same round; Dex and Int, 3/4 BAB, prepared arcane spells to 6th level, good Fortitude and Will, 6 HP a level.",
    guide: "magus",
    skill_points: 2,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "persuasion", "use-magic-device"],
    features: [
        (key: "magus/arcane-heavy-armor", name: "Arcane Heavy Armor", summary: "At 13th level, proficiency with heavy armour, and casting in it without arcane spell failure.", guide: "magus"),
        (key: "magus/arcane-medium-armor", name: "Arcane Medium Armor", summary: "At 7th level, proficiency with medium armour, and casting in it without arcane spell failure.", guide: "magus"),
        (key: "magus/arcane-pool", name: "Arcane Pool", summary: "Pool of half level + Int points: a swift-action point gives the weapon +1 (to +5 at 17th) for a minute, or properties from 5th; also fuels arcana.", guide: "magus#arcane-pool"),
        (key: "magus/arcane-weapon-2", name: "Arcane Weapon +2", summary: "From 5th level, an arcane pool point gives the weapon up to +2 enhancement, usable for properties such as flaming or keen.", guide: "magus"),
        (key: "magus/arcane-weapon-3", name: "Arcane Weapon +3", summary: "From 9th level, the arcane pool weapon bonus rises to +3, and the speed property becomes available.", guide: "magus"),
        (key: "magus/arcane-weapon-4", name: "Arcane Weapon +4", summary: "From 13th level, the arcane pool weapon bonus rises to +4.", guide: "magus"),
        (key: "magus/arcane-weapon-5", name: "Arcane Weapon +5", summary: "From 17th level, the arcane pool weapon bonus rises to +5.", guide: "magus"),
        (key: "magus/counterstrike", name: "Counterstrike", summary: "At 16th level, an enemy in reach who casts defensively provokes an attack of opportunity from you.", guide: "magus#counterstrike"),
        (key: "magus/fighter-training", name: "Fighter Training", summary: "At 10th level, count half your magus level as fighter levels for feats, stacking with real fighter levels.", guide: "magus#fighter-training"),
        (key: "magus/greater-spell-access", name: "Greater Spell Access", summary: "At 19th level, learn 6 spells of levels 1-6 from the full wizard list.", guide: "magus#greater-spell-access"),
        (key: "magus/greater-spell-combat", name: "Greater Spell Combat", summary: "At 14th level, +4 on concentration checks during spell combat.", guide: "magus#greater-spell-combat"),
        (key: "magus/improved-spell-combat", name: "Improved Spell Combat", summary: "At 8th level, +2 on concentration checks during spell combat.", guide: "magus#improved-spell-combat"),
        (key: "magus/improved-spell-recall", name: "Improved Spell Recall", summary: "From 11th level, Spell Recall costs half the spell's level (rounded up).", guide: "magus#improved-spell-recall"),
        (key: "magus/magus-proficiencies", name: "Magus Proficiencies", summary: "Simple and martial weapons and light armour, with no spell failure for magus spells in light armour.", guide: "magus#magus-proficiencies"),
        (key: "magus/spell-combat", name: "Spell Combat", summary: "With the off hand free and a light or one-handed weapon, full attack at -2 and also cast a standard-action spell.", guide: "magus#spell-combat"),
        (key: "magus/spell-recall", name: "Spell Recall", summary: "From 4th level, spend arcane pool points equal to a spell's level to recall a spell you already cast.", guide: "magus#spell-recall"),
        (key: "magus/spellstrike", name: "Spellstrike", summary: "From 2nd level, deliver touch spells through a melee weapon attack at your highest attack bonus, in addition to other attacks.", guide: "magus#spellstrike"),
        (key: "magus/true-magus", name: "True Magus", summary: "At 20th, spell combat needs no concentration check, and you choose +2 to the spell's DC, to beat spell resistance or to attack rolls.", guide: "magus#true-magus"),
    ],
    selections: [
        (
            key: "magus/magus-arcana",
            name: "Magus Arcana",
            summary: "Choose a magus arcana at 3rd level and every three levels after.",
            guide: "magus#magus-arcana",
            options: [
                (key: "magus/magus-arcana/arcane-accuracy", name: "Arcane Accuracy", summary: "Swift action, 1 arcane point: insight bonus equal to Int on all attack rolls until the end of your turn.", guide: "magus#arcane-accuracy"),
                (key: "magus/magus-arcana/bane-blade-level-15", name: "Bane Blade (Level 15)", summary: "When enhancing your weapon, spend 1 extra point to add the bane property.", guide: "magus#bane-blade-level-15"),
                (key: "magus/magus-arcana/devoted-blade-level-12", name: "Devoted Blade (Level 12)", summary: "Your weapon enhancement can add anarchic, axiomatic, holy or unholy.", guide: "magus#devoted-blade-level-12"),
                (key: "magus/magus-arcana/dimension-strike-level-9", name: "Dimension Strike (Level 9)", summary: "Swift action, 2 arcane points: all your melee attacks resolve as touch attacks.", guide: "magus#dimension-strike-level-9"),
                (key: "magus/magus-arcana/empowered-magic-level-6", name: "Empowered Magic (Level 6)", summary: "Cast three spells a day as if with Empower Spell.", guide: "magus#empowered-magic-level-6"),
                (key: "magus/magus-arcana/enduring-blade-level-6", name: "Enduring Blade (Level 6)", summary: "Spend 1 extra point when enhancing your weapon to make it last 1 minute per level.", guide: "magus#enduring-blade-level-6"),
                (key: "magus/magus-arcana/extended-magic", name: "Extended Magic", summary: "Cast three spells a day as if with Extend Spell.", guide: "magus#extended-magic"),
                (key: "magus/magus-arcana/ghost-blade-level-9", name: "Ghost Blade (Level 9)", summary: "Your weapon enhancement can add brilliant energy and ghost touch.", guide: "magus#ghost-blade-level-9"),
                (key: "magus/magus-arcana/hasted-assault-level-9", name: "Hasted Assault (Level 9)", summary: "Spend 1 arcane point to Haste yourself for a duration equal to your Int bonus.", guide: "magus#hasted-assault-level-9"),
                (key: "magus/magus-arcana/maximized-magic-level-12", name: "Maximized Magic (Level 12)", summary: "Cast three spells a day as if with Maximize Spell.", guide: "magus#maximized-magic-level-12"),
                (key: "magus/magus-arcana/prescient-attack-level-6", name: "Prescient Attack (Level 6)", summary: "Spend 1 arcane point: enemies lose their Dex bonus against you until the end of your next turn.", guide: "magus#prescient-attack-level-6"),
                (key: "magus/magus-arcana/quickened-magic-level-15", name: "Quickened Magic (Level 15)", summary: "Cast three spells a day as if with Quicken Spell.", guide: "magus#quickened-magic-level-15"),
                (key: "magus/magus-arcana/reach-magic", name: "Reach Magic", summary: "Cast three spells a day as if with Reach Spell.", guide: "magus#reach-magic"),
                (key: "magus/magus-arcana/wand-mastery", name: "Wand Mastery", summary: "Wands you use set their DC with your Int bonus instead of the minimum.", guide: "magus#wand-mastery"),
                (key: "magus/magus-arcana/wand-wielder", name: "Wand Wielder", summary: "Use a wand or staff instead of casting a spell during spell combat.", guide: "magus#wand-wielder"),
            ],
        ),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["magus/arcane-pool", "magus/magus-proficiencies", "magus/spell-combat"], feats: ["armor-proficiency-light-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
        (level: 2, arcane_spell_level: 1, features: ["magus/spellstrike"]),
        (level: 3, arcane_spell_level: 1, selections: ["magus/magus-arcana"]),
        (level: 4, arcane_spell_level: 2, features: ["magus/spell-recall"]),
        (level: 5, arcane_spell_level: 2, features: ["magus/arcane-weapon-2"], feat_slots: [General]),
        (level: 6, arcane_spell_level: 2, selections: ["magus/magus-arcana"]),
        (level: 7, arcane_spell_level: 3, features: ["magus/arcane-medium-armor"], feats: ["armor-proficiency-medium-armor"]),
        (level: 8, arcane_spell_level: 3, features: ["magus/improved-spell-combat"]),
        (level: 9, arcane_spell_level: 3, features: ["magus/arcane-weapon-3"], selections: ["magus/magus-arcana"]),
        (level: 10, arcane_spell_level: 4, features: ["magus/fighter-training"]),
        (level: 11, arcane_spell_level: 4, features: ["magus/improved-spell-recall"], feat_slots: [General]),
        (level: 12, arcane_spell_level: 4, selections: ["magus/magus-arcana"]),
        (level: 13, arcane_spell_level: 5, features: ["magus/arcane-heavy-armor", "magus/arcane-weapon-4"], feats: ["armor-proficiency-heavy-armor"]),
        (level: 14, arcane_spell_level: 5, features: ["magus/greater-spell-combat"]),
        (level: 15, arcane_spell_level: 5, selections: ["magus/magus-arcana"]),
        (level: 16, arcane_spell_level: 6, features: ["magus/counterstrike"]),
        (level: 17, arcane_spell_level: 6, features: ["magus/arcane-weapon-5"], feat_slots: [General]),
        (level: 18, arcane_spell_level: 6, selections: ["magus/magus-arcana"]),
        (level: 19, arcane_spell_level: 6, features: ["magus/greater-spell-access"]),
        (level: 20, arcane_spell_level: 6, features: ["magus/true-magus"]),
    ],
    archetypes: [
        (
            key: "magus/arcane-rider",
            name: "Arcane Rider",
            summary: "Mounted magus whose arcane pool also empowers their horse; loses medium and heavy armour and Spell Recall.",
            guide: "magus#arcane-rider",
            features: [
                (key: "magus/arcane-rider/arcane-mount", name: "Arcane Mount", summary: "Gain a horse; your arcane pool abilities also apply to it.", guide: "magus#arcane-mount"),
                (key: "magus/arcane-rider/arcane-weapon-2", name: "Arcane Weapon +2", summary: "From 5th level, an arcane pool point gives the weapon up to +2 enhancement, usable for properties such as flaming or keen.", guide: "magus#arcane-rider"),
                (key: "magus/arcane-rider/arcane-weapon-3", name: "Arcane Weapon +3", summary: "From 9th level, the arcane pool weapon bonus rises to +3, and the speed property becomes available.", guide: "magus#arcane-rider"),
                (key: "magus/arcane-rider/arcane-weapon-4", name: "Arcane Weapon +4", summary: "From 13th level, the arcane pool weapon bonus rises to +4.", guide: "magus#arcane-rider"),
                (key: "magus/arcane-rider/arcane-weapon-5", name: "Arcane Weapon +5", summary: "From 17th level, the arcane pool weapon bonus rises to +5.", guide: "magus#arcane-rider"),
                (key: "magus/arcane-rider/dimensional-ride", name: "Dimensional Ride", summary: "At 8th level, 1 arcane point and a move action teleport you and your mount up to 30'.", guide: "magus#dimensional-ride"),
                (key: "magus/arcane-rider/greater-dimensional-ride", name: "Greater Dimensional Ride", summary: "At 14th level, Dimensional Ride is a swift action and hastes you and your mount for Int mod rounds.", guide: "magus#greater-dimensional-ride"),
            ],
            levels: [
                (level: 1, features: ["magus/arcane-pool", "magus/arcane-rider/arcane-mount", "magus/magus-proficiencies", "magus/spell-combat"], feats: ["armor-proficiency-light-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
                (level: 4),
                (level: 5, features: ["magus/arcane-rider/arcane-weapon-2"], feat_slots: [General]),
                (level: 7),
                (level: 8, features: ["magus/arcane-rider/dimensional-ride", "magus/improved-spell-combat"]),
                (level: 9, features: ["magus/arcane-rider/arcane-weapon-3"], selections: ["magus/magus-arcana"]),
                (level: 11, feat_slots: [General]),
                (level: 13, features: ["magus/arcane-rider/arcane-weapon-4"]),
                (level: 14, features: ["magus/arcane-rider/greater-dimensional-ride", "magus/greater-spell-combat"]),
                (level: 17, features: ["magus/arcane-rider/arcane-weapon-5"], feat_slots: [General]),
            ],
        ),
        (
            key: "magus/armored-battlemage",
            name: "Armored Battlemage",
            summary: "Defensive magus who enchants armour instead of weapons and gets Armor Training, but loses Spell Combat and some arcana.",
            guide: "magus#armored-battlemage",
            features: [
                (key: "magus/armored-battlemage/arcane-armor-2", name: "Arcane Armor +2", summary: "From 5th level, arcane pool armour enhancement rises to +2, usable for armour properties.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-armor-3", name: "Arcane Armor +3", summary: "From 9th level, arcane pool armour enhancement rises to +3.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-armor-4", name: "Arcane Armor +4", summary: "From 13th level, arcane pool armour enhancement rises to +4.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-armor-5", name: "Arcane Armor +5", summary: "From 17th level, arcane pool armour enhancement rises to +5.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-heavy-armor", name: "Arcane Heavy Armor", summary: "At 7th level, proficiency with heavy armour, and casting in it without arcane spell failure.", guide: "magus#armored-battlemage"),
                (key: "magus/armored-battlemage/arcane-pool-armored-battlemage", name: "Arcane Pool (Armored Battlemage)", summary: "Swift action, 1 point: +1 enhancement to your armour for a minute (+5 at 17th), or armour properties from 5th; can't enhance weapons.", guide: "magus#arcane-pool-armored-battlemage"),
                (key: "magus/armored-battlemage/armor-training", name: "Armor Training", summary: "Armor Training at 3rd level and again at 8th, 13th and 18th, as the fighter ability.", guide: "magus#armor-training"),
                (key: "magus/armored-battlemage/armored-battlemage-proficiencies", name: "Armored Battlemage Proficiencies", summary: "Simple and martial weapons, light and medium armour, and casting magus spells in them.", guide: "magus#armored-battlemage-proficiencies"),
            ],
            levels: [
                (level: 1, features: ["magus/armored-battlemage/arcane-pool-armored-battlemage", "magus/armored-battlemage/armored-battlemage-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["magus/armored-battlemage/armor-training"]),
                (level: 5, features: ["magus/armored-battlemage/arcane-armor-2"], feat_slots: [General]),
                (level: 7, features: ["magus/armored-battlemage/arcane-heavy-armor"], feats: ["armor-proficiency-heavy-armor"]),
                (level: 8, features: ["magus/armored-battlemage/armor-training"]),
                (level: 9, features: ["magus/armored-battlemage/arcane-armor-3"], selections: ["magus/magus-arcana"]),
                (level: 13, features: ["magus/armored-battlemage/arcane-armor-4", "magus/armored-battlemage/armor-training"]),
                (level: 17, features: ["magus/armored-battlemage/arcane-armor-5"], feat_slots: [General]),
                (level: 18, features: ["magus/armored-battlemage/armor-training"]),
            ],
        ),
        (
            key: "magus/bladebound",
            name: "Bladebound",
            summary: "Magus (Dance of Masks DLC) bonded to a sentient black blade that can fight on its own; fewer arcana and bonus feats.",
            guide: "magus#bladebound",
            features: [
                (key: "magus/bladebound/arcane-heavy-armor", name: "Arcane Heavy Armor", summary: "At 13th level, proficiency with heavy armour, and casting in it without arcane spell failure.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-medium-armor", name: "Arcane Medium Armor", summary: "At 7th level, proficiency with medium armour, and casting in it without arcane spell failure.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-weapon-2", name: "Arcane Weapon +2", summary: "From 5th level, an arcane pool point gives the weapon up to +2 enhancement, usable for properties such as flaming or keen.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-weapon-3", name: "Arcane Weapon +3", summary: "From 9th level, the arcane pool weapon bonus rises to +3, and the speed property becomes available.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-weapon-4", name: "Arcane Weapon +4", summary: "From 13th level, the arcane pool weapon bonus rises to +4.", guide: "magus#bladebound"),
                (key: "magus/bladebound/arcane-weapon-5", name: "Arcane Weapon +5", summary: "From 17th level, the arcane pool weapon bonus rises to +5.", guide: "magus#bladebound"),
                (key: "magus/bladebound/black-blade", name: "Black Blade", summary: "A +1 scimitar you summon as a swift action, gaining +1 enhancement at 5th and every four levels (+5 at 17th).", guide: "magus#black-blade"),
                (key: "magus/bladebound/changeable-gist", name: "Changeable Gist", summary: "From 5th level, 1 arcane point turns the blade's damage to cold, electricity or fire, or 2 points to sonic or force, until your next turn.", guide: "magus#changeable-gist"),
                (key: "magus/bladebound/independent-ego", name: "Independent Ego", summary: "From 12th level, as a free action, let the blade fight on its own for 1 minute, using your Int, BAB and level for its stats.", guide: "magus#independent-ego"),
                (key: "magus/bladebound/life-drinker", name: "Life Drinker", summary: "From 19th level, killing a 10+ HD creature with the blade gives temporary HP of level + 3, or 1 arcane pool point if you already have them.", guide: "magus#bladebound"),
                (key: "magus/bladebound/sharpening-the-black-blade", name: "Sharpening the Black Blade", summary: "From 3rd level, free action, 1 arcane point: the blade gets +1 damage for 1 minute, +1 every three levels (+6 at 18th).", guide: "magus#sharpening-the-black-blade"),
            ],
            levels: [
                (level: 1, features: ["magus/arcane-pool", "magus/bladebound/black-blade", "magus/magus-proficiencies", "magus/spell-combat"], feats: ["armor-proficiency-light-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["magus/bladebound/sharpening-the-black-blade"]),
                (level: 5, features: ["magus/bladebound/arcane-weapon-2", "magus/bladebound/changeable-gist"]),
                (level: 7, features: ["magus/bladebound/arcane-medium-armor"], feats: ["armor-proficiency-medium-armor"]),
                (level: 9, features: ["magus/bladebound/arcane-weapon-3"], selections: ["magus/magus-arcana"]),
                (level: 12, features: ["magus/bladebound/independent-ego"]),
                (level: 13, features: ["magus/bladebound/arcane-heavy-armor", "magus/bladebound/arcane-weapon-4"], feats: ["armor-proficiency-heavy-armor"]),
                (level: 17, features: ["magus/bladebound/arcane-weapon-5"], feat_slots: [General]),
                (level: 18),
                (level: 19, features: ["magus/bladebound/life-drinker", "magus/greater-spell-access"]),
            ],
        ),
        (
            key: "magus/eldritch-archer",
            name: "Eldritch Archer",
            summary: "Ranged magus who uses a ranged weapon for spell combat and spellstrike; loses Counterstrike.",
            guide: "magus#eldritch-archer",
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "perception", "persuasion"],
            features: [
                (key: "magus/eldritch-archer/arcane-heavy-armor", name: "Arcane Heavy Armor", summary: "At 13th level, proficiency with heavy armour, and casting in it without arcane spell failure.", guide: "magus#eldritch-archer"),
                (key: "magus/eldritch-archer/arcane-medium-armor", name: "Arcane Medium Armor", summary: "At 7th level, proficiency with medium armour, and casting in it without arcane spell failure.", guide: "magus#eldritch-archer"),
                (key: "magus/eldritch-archer/arcane-weapon-2", name: "Arcane Weapon +2", summary: "From 5th level, an arcane pool point gives the weapon up to +2 enhancement, usable for properties such as flaming or keen.", guide: "magus#eldritch-archer"),
                (key: "magus/eldritch-archer/arcane-weapon-3", name: "Arcane Weapon +3", summary: "From 9th level, the arcane pool weapon bonus rises to +3, and the speed property becomes available.", guide: "magus#eldritch-archer"),
                (key: "magus/eldritch-archer/arcane-weapon-4", name: "Arcane Weapon +4", summary: "From 13th level, the arcane pool weapon bonus rises to +4.", guide: "magus#eldritch-archer"),
                (key: "magus/eldritch-archer/arcane-weapon-5", name: "Arcane Weapon +5", summary: "From 17th level, the arcane pool weapon bonus rises to +5.", guide: "magus#eldritch-archer"),
                (key: "magus/eldritch-archer/detect-magic", name: "Detect Magic", guide: "magus#eldritch-archer"),
                (key: "magus/eldritch-archer/ranged-spell-combat", name: "Ranged Spell Combat", summary: "Spell combat with a ranged weapon; no free hand needed, but no attack penalty trade for concentration.", guide: "magus#ranged-spell-combat"),
                (key: "magus/eldritch-archer/ranged-spellstrike", name: "Ranged Spellstrike", summary: "From 2nd level, deliver ranged touch spells through a ranged weapon attack at full bonus; only one ray of a multi-ray spell.", guide: "magus#ranged-spellstrike"),
            ],
            levels: [
                (level: 1, features: ["magus/arcane-pool", "magus/eldritch-archer/detect-magic", "magus/eldritch-archer/ranged-spell-combat", "magus/magus-proficiencies"], feats: ["armor-proficiency-light-armor", "martial-weapons-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["magus/eldritch-archer/ranged-spellstrike"]),
                (level: 5, features: ["magus/eldritch-archer/arcane-weapon-2"], feat_slots: [General]),
                (level: 7, features: ["magus/eldritch-archer/arcane-medium-armor"], feats: ["armor-proficiency-medium-armor"]),
                (level: 9, features: ["magus/eldritch-archer/arcane-weapon-3"], selections: ["magus/magus-arcana"]),
                (level: 13, features: ["magus/eldritch-archer/arcane-heavy-armor", "magus/eldritch-archer/arcane-weapon-4"], feats: ["armor-proficiency-heavy-armor"]),
                (level: 16),
                (level: 17, features: ["magus/eldritch-archer/arcane-weapon-5"], feat_slots: [General]),
            ],
        ),
        (
            key: "magus/eldritch-scion",
            name: "Eldritch Scion",
            summary: "Spontaneous Cha-based magus with a sorcerer bloodline's spells and powers and an Eldritch Pool; spells known as a bard.",
            guide: "magus#eldritch-scion",
            spontaneous: Some(true),
            features: [
                (key: "magus/eldritch-scion/arcane-heavy-armor", name: "Arcane Heavy Armor", summary: "At 13th level, proficiency with heavy armour, and casting in it without arcane spell failure.", guide: "magus#eldritch-scion"),
                (key: "magus/eldritch-scion/arcane-medium-armor", name: "Arcane Medium Armor", summary: "At 7th level, proficiency with medium armour, and casting in it without arcane spell failure.", guide: "magus#eldritch-scion"),
                (key: "magus/eldritch-scion/arcane-weapon-2", name: "Arcane Weapon +2", summary: "From 5th level, an arcane pool point gives the weapon up to +2 enhancement, usable for properties such as flaming or keen.", guide: "magus#eldritch-scion"),
                (key: "magus/eldritch-scion/arcane-weapon-3", name: "Arcane Weapon +3", summary: "From 9th level, the arcane pool weapon bonus rises to +3, and the speed property becomes available.", guide: "magus#eldritch-scion"),
                (key: "magus/eldritch-scion/arcane-weapon-4", name: "Arcane Weapon +4", summary: "From 13th level, the arcane pool weapon bonus rises to +4.", guide: "magus#eldritch-scion"),
                (key: "magus/eldritch-scion/arcane-weapon-5", name: "Arcane Weapon +5", summary: "From 17th level, the arcane pool weapon bonus rises to +5.", guide: "magus#eldritch-scion"),
                (key: "magus/eldritch-scion/detect-magic", name: "Detect Magic", guide: "magus#eldritch-scion"),
                (key: "magus/eldritch-scion/eldritch-pool", name: "Eldritch Pool", summary: "The Eldritch Scion's version of the arcane pool, using Charisma rather than Intelligence.", guide: "magus#eldritch-scion"),
            ],
