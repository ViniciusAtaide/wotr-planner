                (key: "magus/sword-saint/fighter-training-sword-saint", name: "Fighter Training (Sword Saint)", summary: "At 7th level, count level - 3 as fighter levels for feats, stacking with real fighter levels.", guide: "magus#fighter-training-sword-saint"),
                (key: "magus/sword-saint/lethal-focus", name: "Lethal Focus", summary: "At 13th level, add Int to damage with your chosen weapon against flat-footed foes.", guide: "magus#lethal-focus"),
                (key: "magus/sword-saint/lightning-draw", name: "Lightning Draw", summary: "At 7th level, add Int as well as Dex to initiative.", guide: "magus#lightning-draw"),
