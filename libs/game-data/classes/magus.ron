                (key: "magus/sword-saint/canny-defense", name: "Canny Defense", summary: "In light or no armour, add Int (up to 1 per class level) as a dodge bonus to AC.", guide: "magus#canny-defense"),
                (key: "magus/sword-saint/critical-perfection", name: "Critical Perfection", summary: "At 9th level, add Int to crit confirmation rolls, and use magus level as BAB for feat prerequisites.", guide: "magus#critical-perfection"),
