Class(
    key: "arcanist",
    blueprint: "52dbfd8505e22f84fad8d702611f60b7",
    name: "Arcanist",
    summary: "Arcane caster who prepares wizard spells but casts them in any combination, fuelled by a reservoir; 1/2 BAB, spells to 9th level, good Will, 5 HP a level.",
    guide: "arcanist",
    skill_points: 2,
    casting_ability: Intelligence,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "use-magic-device"],
    features: [
        (key: "arcanist/arcane-reservoir", blueprint: "55db1859bd72fd04f9bd3fe1f10e4cbb", name: "Arcane Reservoir", summary: "Holds up to level + 3 points (half level + 3 after rest); spend 1 as a free action to add +1 to a spell's caster level or DC.", guide: "arcanist#arcane-reservoir"),
        (key: "arcanist/cantrips", blueprint: "5ad7c9fb13ecb52489a89824f0e3db08", name: "Cantrips", guide: "arcanist"),
        (key: "arcanist/consume-spells", blueprint: "69cfb4ab0d9812249b924b8f23d6d19f", name: "Consume Spells", summary: "Give up a prepared casting to gain reservoir points equal to the spell's level.", guide: "arcanist#consume-spells"),
        (key: "arcanist/magical-supremacy", blueprint: "261270d064148224fb982590b7a65414", name: "Magical Supremacy", summary: "At 20th level, cast any prepared spell by spending reservoir points equal to its level.", guide: "arcanist#magical-supremacy"),
    ],
    selections: [
        (
            key: "arcanist/arcanist-exploits",
            blueprint: "b8bf3d5023f2d8c428fdf6438cecaea7",
            name: "Arcanist Exploits",
            summary: "Choose exploits, special powers paid with reservoir points; their save DC is 10 + half level + Cha.",
            guide: "arcanist#arcanist-exploits",
            options: [
                (key: "arcanist/arcanist-exploits/acid-jet", blueprint: "c3705e3054dcba44c93a5f8b603e8631", name: "Acid Jet", summary: "Cost 1: ranged touch for 1d6 acid + Cha, +1d6 every 2 levels (10d6 at 19th); sickened 1d4 rounds unless Fortitude.", guide: "arcanist#acid-jet"),
                (key: "arcanist/arcanist-exploits/arcane-barrier", blueprint: "0652d31817917cb46b1c6e0710dedda5", name: "Arcane Barrier", summary: "Cost 1 (rising to 3 on repeat uses): temporary HP of level + Cha for 1 minute per level.", guide: "arcanist#arcane-barrier"),
                (key: "arcanist/arcanist-exploits/armored-mask", blueprint: "585f02be2202e1f4289e04e84cd787e5", name: "Armored Mask", summary: "Cost 1: Mage Armor at your class level, or Shield of Faith if Mage Armor is already up.", guide: "arcanist#armored-mask"),
                (key: "arcanist/arcanist-exploits/dimensional-slide", blueprint: "687f9c86f8afea34097d84569b5abd07", name: "Dimensional Slide", summary: "Cost 1: use your move action to go to any spot within close range.", guide: "arcanist#dimensional-slide"),
                (key: "arcanist/arcanist-exploits/energy-shield", blueprint: "a652a4f9f77e9fc4fafe15fa2ef9dcfe", name: "Energy Shield", summary: "Cost 1: resistance 10 to one energy for 1 minute per level, +5 per five levels (30 at 20th).", guide: "arcanist#energy-shield"),
                (key: "arcanist/arcanist-exploits/flame-arc", blueprint: "421a868f5c675764b9c1e919629e5fdb", name: "Flame Arc", summary: "Cost 1: 30' line of fire for 1d6 + Cha, +1d6 every 2 levels (10d6 at 19th), Reflex half.", guide: "arcanist#flame-arc"),
                (key: "arcanist/arcanist-exploits/force-strike", blueprint: "0142c6fa966c7da4f9d061bf07974955", name: "Force Strike", summary: "Cost 1: automatically hit a target within 30' for 1d4 force + 1 per level; blocked by what stops Magic Missile.", guide: "arcanist#force-strike"),
                (key: "arcanist/arcanist-exploits/holy-water-jet", blueprint: "3ff84c64d01075d4cbc3dc274c48a4bf", name: "Holy Water Jet", summary: "Good only, cost 1: 30' jet for 1d8 holy + Cha to susceptible creatures, +1d8 every 2 levels (10d8 at 19th), Reflex half.", guide: "arcanist#holy-water-jet", prerequisite: Any([Alignment(LawfulGood), Alignment(NeutralGood), Alignment(ChaoticGood)])),
                (key: "arcanist/arcanist-exploits/ice-missile", blueprint: "84a2204fa1a5c4d43979dc7dd0ea5f11", name: "Ice Missile", summary: "Cost 1: ranged touch for 1d6 cold + Cha, +1d6 every 2 levels (10d6 at 19th); staggered 1 round unless Fortitude.", guide: "arcanist#ice-missile"),
                (key: "arcanist/arcanist-exploits/lightning-lance", blueprint: "0536c9db9535bdf4d81748dbb14dfc26", name: "Lightning Lance", summary: "Cost 1: ranged touch for 1d6 electricity + Cha, +1d6 every 2 levels (10d6 at 19th); 20% miss chance for 1 round unless Fortitude.", guide: "arcanist#lightning-lance"),
                (key: "arcanist/arcanist-exploits/potent-magic", blueprint: "995110cc948d5164a820403a9e903151", name: "Potent Magic", summary: "Reservoir points add +2 instead of +1 to a spell's caster level or DC.", guide: "arcanist#potent-magic"),
                (key: "arcanist/arcanist-exploits/shadow-veil", blueprint: "65397f429b0a3024e9c94a106d0eea35", name: "Shadow Veil", summary: "Cost 1: 20% concealment and +5 Stealth for 1 + Cha rounds.", guide: "arcanist#shadow-veil"),
                (key: "arcanist/arcanist-exploits/sonic-blast", blueprint: "43b196f6cf6726648b9af5945ebaa765", name: "Sonic Blast", summary: "Cost 1: ranged touch within 30' for 1d6 sonic + Cha, +1d6 every 2 levels (10d6 at 19th), Fortitude half.", guide: "arcanist#sonic-blast"),
                (key: "arcanist/arcanist-exploits/spell-resistance", blueprint: "72d6f0a1d508738419b90f90ad1258fb", name: "Spell Resistance", summary: "Cost 1: spell resistance 6 + level for Cha mod rounds.", guide: "arcanist#spell-resistance"),
                (key: "arcanist/arcanist-exploits/swift-consume", blueprint: "eaec53cbf34042f4e9f0d5451f9529d1", name: "Swift Consume", summary: "Consume Spells becomes a swift action instead of a move action.", guide: "arcanist#swift-consume"),
                (key: "arcanist/arcanist-exploits/wooden-flesh", blueprint: "d84be1e69b0870543a959d43151f16e3", name: "Wooden Flesh", summary: "Cost 1: +2 natural armour and DR/slashing equal to Cha for 1 minute per level; you count as a plant only for plant-specific effects.", guide: "arcanist#wooden-flesh"),
            ],
        ),
        (
            key: "arcanist/greater-exploits",
            blueprint: "c7536b93f17c70d4fa3a8cf9aa76bfb7",
            name: "Greater Exploits",
            summary: "Stronger exploits, available from 11th level.",
            guide: "arcanist#greater-exploits",
            options: [
                (key: "arcanist/greater-exploits/burning-flame", blueprint: "9677876c5dbb6074780c392e68f5929c", name: "Burning Flame", summary: "Cost 2, needs Flame Arc: targets failing the save catch fire for 3d6 a turn until a Reflex save puts it out.", guide: "arcanist#burning-flame", prerequisite: SelectionOption("arcanist/arcanist-exploits/flame-arc")),
                (key: "arcanist/greater-exploits/dancing-electricity", blueprint: "72eb96355ef5d0549b9965657f336e1a", name: "Dancing Electricity", summary: "Cost 2, needs Lightning Lance: creatures next to the target take half its electricity damage (Reflex half).", guide: "arcanist#dancing-electricity", prerequisite: SelectionOption("arcanist/arcanist-exploits/lightning-lance")),
                (key: "arcanist/greater-exploits/greater-spell-resistance", blueprint: "1eba9b432ef464349befcc7f5c428849", name: "Greater Spell Resistance", summary: "Cost 1, needs Spell Resistance: spell resistance 11 + level.", guide: "arcanist#greater-spell-resistance", prerequisite: SelectionOption("arcanist/arcanist-exploits/spell-resistance")),
                (key: "arcanist/greater-exploits/hellfire-ray", blueprint: "7d56376148919f64e826bfc63fd2187d", name: "Hellfire Ray", summary: "Cost 2, needs Flame Arc: half the damage is unholy and ignores fire resistance; good targets sickened 1d4 rounds unless Will.", guide: "arcanist#hellfire-ray", prerequisite: SelectionOption("arcanist/arcanist-exploits/flame-arc")),
                (key: "arcanist/greater-exploits/icy-tomb", blueprint: "0e7d6f931f7649f46a10820c0d7b240f", name: "Icy Tomb", summary: "Cost 2, needs Ice Missile: a target failing its save is iced over for 1 minute per caster level, entangled and losing 1 Dex a turn (Str DC 10 + Cha).", guide: "arcanist#icy-tomb", prerequisite: SelectionOption("arcanist/arcanist-exploits/ice-missile")),
                (key: "arcanist/greater-exploits/lingering-acid", blueprint: "479ab6000cc3e2041a46f6ab225ccb78", name: "Lingering Acid", summary: "Cost 2, needs Acid Jet: on a failed save the target keeps taking acid damage, 1d6 per 2d6 dealt the round before.", guide: "arcanist#lingering-acid", prerequisite: SelectionOption("arcanist/arcanist-exploits/acid-jet")),
            ],
        ),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["arcanist/arcane-reservoir", "arcanist/cantrips", "arcanist/consume-spells"], feats: ["simple-weapon-proficiency"], selections: ["arcanist/arcanist-exploits"]),
        (level: 2, arcane_spell_level: 1),
        (level: 3, arcane_spell_level: 1, selections: ["arcanist/arcanist-exploits"]),
        (level: 4, arcane_spell_level: 2),
        (level: 5, arcane_spell_level: 2, selections: ["arcanist/arcanist-exploits"]),
        (level: 6, arcane_spell_level: 3),
        (level: 7, arcane_spell_level: 3, selections: ["arcanist/arcanist-exploits"]),
        (level: 8, arcane_spell_level: 4),
        (level: 9, arcane_spell_level: 4, selections: ["arcanist/arcanist-exploits"]),
        (level: 10, arcane_spell_level: 5),
        (level: 11, arcane_spell_level: 5, selections: ["arcanist/arcanist-exploits", "arcanist/greater-exploits"]),
        (level: 12, arcane_spell_level: 6),
        (level: 13, arcane_spell_level: 6, selections: ["arcanist/arcanist-exploits"]),
        (level: 14, arcane_spell_level: 7),
        (level: 15, arcane_spell_level: 7, selections: ["arcanist/arcanist-exploits"]),
        (level: 16, arcane_spell_level: 8),
        (level: 17, arcane_spell_level: 8, selections: ["arcanist/arcanist-exploits"]),
        (level: 18, arcane_spell_level: 9),
        (level: 19, arcane_spell_level: 9, selections: ["arcanist/arcanist-exploits"]),
        (level: 20, arcane_spell_level: 9, features: ["arcanist/magical-supremacy"]),
    ],
    archetypes: [
        (
            key: "arcanist/brown-fur-transmuter",
            blueprint: "ce63b2df8c6c12649b02c278e73d8bfa",
            name: "Brown-Fur Transmuter",
            summary: "Arcanist who boosts transmutation spells and shares self-buffs, with fewer exploits.",
            guide: "arcanist#brown-fur-transmuter",
            features: [
                (key: "arcanist/brown-fur-transmuter/cantrips", blueprint: "5ad7c9fb13ecb52489a89824f0e3db08", name: "Cantrips", guide: "arcanist#brown-fur-transmuter"),
                (key: "arcanist/brown-fur-transmuter/powerful-change", blueprint: "5e01e267021bffe4e99ebee3fdc872d1", name: "Powerful Change", summary: "Spend 1 reservoir point on a transmutation spell to raise its ability score bonus by 2.", guide: "arcanist#powerful-change"),
                (key: "arcanist/brown-fur-transmuter/shared-transmutation", blueprint: "c4ed8d1a90c93754eacea361653a7d56", name: "Shared Transmutation", summary: "Spend 1 reservoir point to change a personal transmutation spell's range to touch; not with Powerful Change.", guide: "arcanist#shared-transmutation"),
                (key: "arcanist/brown-fur-transmuter/transmutation-supremacy", blueprint: "c94d764d2ce3cd14f892f7c00d9f3a70", name: "Transmutation Supremacy", summary: "Transmutation spells are extended, Powerful Change gives +4, and Shared Transmutation reaches close range.", guide: "arcanist#transmutation-supremacy"),
            ],
            levels: [
                (level: 1, features: ["arcanist/arcane-reservoir", "arcanist/brown-fur-transmuter/cantrips", "arcanist/consume-spells"], feats: ["simple-weapon-proficiency"], selections: ["arcanist/arcanist-exploits"]),
                (level: 3, features: ["arcanist/brown-fur-transmuter/powerful-change"]),
                (level: 9, features: ["arcanist/brown-fur-transmuter/shared-transmutation"]),
                (level: 20, features: ["arcanist/brown-fur-transmuter/transmutation-supremacy"]),
            ],
        ),
        (
            key: "arcanist/eldritch-font",
            blueprint: "2f35608fc073c04448a9c162a20852ce",
            name: "Eldritch Font",
            summary: "Arcanist with more spell slots but fewer prepared spells, able to surge spells, with fewer exploits.",
            guide: "arcanist#eldritch-font",
            features: [
                (key: "arcanist/eldritch-font/bottomless-well", blueprint: "8edcfd5e80898e34cb6c09a850b76083", name: "Bottomless Well", summary: "Once a day as a full-round action, prepare new spells and regain half your level in reservoir points.", guide: "arcanist#bottomless-well"),
                (key: "arcanist/eldritch-font/cantrips", blueprint: "5ad7c9fb13ecb52489a89824f0e3db08", name: "Cantrips", guide: "arcanist#eldritch-font"),
                (key: "arcanist/eldritch-font/eldritch-surge", blueprint: "644c0e9618e417947bd0a1252a5e6ecf", name: "Eldritch Surge", summary: "Swift action: +2 caster level and DC to a spell, or +2 level to an exploit, but you become fatigued (exhausted if already).", guide: "arcanist#eldritch-surge"),
                (key: "arcanist/eldritch-font/font-of-power", blueprint: "8b359846202ec6c4fa8f0ad5e998ff0f", name: "Font of Power", summary: "One extra slot per spell level, but one fewer spell prepared of each level.", guide: "arcanist#font-of-power"),
                (key: "arcanist/eldritch-font/greater-surge", blueprint: "685ee64e43fcb6546b65436a3deb98bd", name: "Greater Surge", summary: "Eldritch Surge can force a creature to roll its save twice and take the worse result.", guide: "arcanist#greater-surge"),
                (key: "arcanist/eldritch-font/improved-surge", blueprint: "718fe8e143d38cc4899ae798dd098b6e", name: "Improved Surge", summary: "Eldritch Surge can let you roll a spell's attack twice and take the better result.", guide: "arcanist#improved-surge"),
            ],
            levels: [
                (level: 1, features: ["arcanist/arcane-reservoir", "arcanist/consume-spells", "arcanist/eldritch-font/cantrips", "arcanist/eldritch-font/font-of-power"], feats: ["simple-weapon-proficiency"], selections: ["arcanist/arcanist-exploits"]),
                (level: 3, features: ["arcanist/eldritch-font/eldritch-surge"]),
                (level: 7, features: ["arcanist/eldritch-font/improved-surge"]),
                (level: 13, features: ["arcanist/eldritch-font/greater-surge"]),
                (level: 20, features: ["arcanist/eldritch-font/bottomless-well"]),
            ],
        ),
        (
            key: "arcanist/magic-deceiver",
            blueprint: "5c77110cd0414e7eb4c2e485659c9a46",
            name: "Magic Deceiver",
            summary: "Arcanist (Dance of Masks DLC) who fuses spells into new ones and picks a deceiver path; no reservoir or exploits, spells to 6th level.",
            guide: "arcanist#magic-deceiver",
            features: [
                (key: "arcanist/magic-deceiver/cantrips", blueprint: "5ad7c9fb13ecb52489a89824f0e3db08", name: "Cantrips", guide: "arcanist#magic-deceiver"),
                (key: "arcanist/magic-deceiver/magic-fusion", blueprint: "2188d7f50f74418e88f925cc0a534e9c", name: "Magic Fusion", summary: "Craft up to 10 new spells by fusing two known spells, using the higher level and DC and either spell's school and shape.", guide: "arcanist#magic-fusion"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/inhibit-courage", blueprint: "d754e431ef504adaaccdfbb90174657a", name: "Inhibit Courage", summary: "Performance for level + Cha rounds a day: foes take -1 to attack, damage and saves against charm and fear, -1 more at 5th, 11th and 17th.", guide: "arcanist#inhibit-courage"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/inhibit-greatness", blueprint: "bc4cac39686b44ab8030edc4b60634ce", name: "Inhibit Greatness", summary: "From 12th level, performance gives foes -2 attack, -1 saves and -3 to beat spell resistance (-4 at 17th).", guide: "arcanist#inhibit-greatness"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/inhibit-heroics", blueprint: "74fb702a468546caaace35139dd322a4", name: "Inhibit Heroics", summary: "At 20th level, performance gives foes -4 to AC and saves.", guide: "arcanist#inhibit-heroics"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/spell-fabrication", blueprint: "ba992e0795e44c11bcb6da270c56d252", name: "Spell Fabrication", summary: "From 4th level, cast a spellbook spell with a Persuasion (Bluff) check (DC 10 + twice its level), 1/day +1 per four levels.", guide: "arcanist#spell-fabrication"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/trick-magic", blueprint: "e23a77f921214bb5b06d02509aa8d79d", name: "Trick Magic", summary: "From 2nd level, add your Persuasion ranks to concentration checks.", guide: "arcanist#trick-magic"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/living-deity/godly-fraud", blueprint: "28a2b97cba254516aa5ca83fd7e3a05e", name: "Godly Fraud", summary: "From 12th level, add half your Lore (Religion) ranks to caster level checks against spell resistance.", guide: "arcanist#godly-fraud"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/living-deity/mysterious-gift", blueprint: "318c99dad43240068ae092b906a8439d", name: "Mysterious Gift", summary: "Atheists only: gain an oracle mystery and curse (without the curse's level-up benefits); Cha for Lore (Religion).", guide: "arcanist#mysterious-gift"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/living-deity/pious-guile", blueprint: "7d000daabb4f43fb9ded569ed946fcfd", name: "Pious Guile", summary: "From 2nd level, add your Lore (Religion) ranks to concentration checks.", guide: "arcanist#pious-guile"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/enchanters-fabrication", blueprint: "c7175145c78542bdbd3ee22f99f19b7c", name: "Enchanter\'s Fabrication", summary: "From 4th level, cast a spellbook spell with a Use Magic Device check (DC 10 + twice its level), 1/day +1 per four levels.", guide: "arcanist#enchanters-fabrication"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/enchanters-penetration", blueprint: "dd76e9fcaa14450e9d75ee6f4a5aa882", name: "Enchanter\'s Penetration", summary: "From 12th level, add half your Use Magic Device ranks to caster level checks against spell resistance.", guide: "arcanist#enchanters-penetration"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/fake-enhancement", blueprint: "40b906ec85584e43b5a11da0a8438363", name: "Fake Enhancement", summary: "From 2nd level, enhancement bonuses from items rise by +1, or +2 for ability scores.", guide: "arcanist#fake-enhancement"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/magic-inventions", blueprint: "15abe5bc39f64eb99ccf9dcb4fe3930d", name: "Magic Inventions", summary: "Add your class level to Use Magic Device checks.", guide: "arcanist#magic-inventions"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/true-enhancement", blueprint: "9a1391262e3341f38a083c0a0c751415", name: "True Enhancement", summary: "At 20th level, enhancement bonuses from items rise by +2, or +4 for ability scores.", guide: "arcanist#true-enhancement"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/acolyte-of-the-first-step", blueprint: "943b093254b145a2ac53dd64d98cb8ae", name: "Acolyte of the First Step", summary: "The mask hides your alignment and gives +2 on Persuasion (Bluff).", guide: "arcanist#acolyte-of-the-first-step"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/fool-resistance", blueprint: "dd2e9aa312664a6b93bc5d4c2915e8f1", name: "Fool Resistance", summary: "From 12th level, add half your Persuasion ranks to caster level checks against spell resistance.", guide: "arcanist#fool-resistance"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/herald-of-the-eighth-step", blueprint: "621aaa4baad04705a975f6023a1205d0", name: "Herald of the Eighth Step", summary: "From 8th level, the mask grants See Invisibility.", guide: "arcanist#herald-of-the-eighth-step"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/mask-of-the-twelfth-step", blueprint: "74ce909e5c414ed7bb708fe57bad8a62", name: "Mask of the Twelfth Step", summary: "From 12th level, the mask grants spell resistance 12 + level.", guide: "arcanist#mask-of-the-twelfth-step"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/most-trusted-follower", blueprint: "eeae2fbeef3f45d6b5b4ed075d663472", name: "Most Trusted Follower", summary: "At 20th level, once a round, try to cancel an enemy spell within 30' with a Persuasion (Bluff) check against its DC.", guide: "arcanist#most-trusted-follower"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/priest-of-the-third-step", blueprint: "61e61abeb8054f8487ad5ec4da2b99ed", name: "Priest of the Third Step", summary: "From 3rd level, the mask gives +2 on initiative.", guide: "arcanist#priest-of-the-third-step"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/razmiri-mask", blueprint: "d86d1a6bc5fc42ab9437527c28c07ad8", name: "Razmiri Mask", summary: "A mask that grants powers as you level; no other face item can be worn.", guide: "arcanist#razmiri-mask"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/spell-fabrication", blueprint: "ba992e0795e44c11bcb6da270c56d252", name: "Spell Fabrication", summary: "From 4th level, cast a spellbook spell with a Persuasion (Bluff) check (DC 10 + twice its level), 1/day +1 per four levels.", guide: "arcanist#razmiri-infiltrator"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/trick-magic", blueprint: "e23a77f921214bb5b06d02509aa8d79d", name: "Trick Magic", summary: "From 2nd level, add your Persuasion ranks to concentration checks.", guide: "arcanist#razmiri-infiltrator"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/vision-of-the-fifteenth-step", blueprint: "af2e3eab2b7a45f6935ead46667617ba", name: "Vision of the Fifteenth Step", guide: "arcanist#razmiri-infiltrator"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/advance-time", blueprint: "2d1c077a35804e3cbf121655745f8f11", name: "Advance Time", summary: "Swift action, 1 + Cha times a day: shorten all effects on yourself or an ally by rounds equal to your level.", guide: "arcanist#advance-time"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/chronomancy", blueprint: "47ac3e4aa5054963bf1f521b292d17fc", name: "Chronomancy", summary: "From 4th level, outside combat, refresh your or an ally's spells and abilities as if rested, at -1 DC until a real rest; 1/day +1 per four levels.", guide: "arcanist#chronomancy"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/split-second", blueprint: "2f3f34f0d1284137b2a7988c6caea274", name: "Split Second", summary: "From 12th level, use Persuasion (Bluff) checks in place of Reflex saves.", guide: "arcanist#split-second"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/split-timeline", blueprint: "78f885c7718b479195b043e0eeaae919", name: "Split Timeline", summary: "At 20th level, once per combat, reset yourself or an ally to a fully rested state, with all spells, abilities and HP.", guide: "arcanist#split-timeline"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/trick-magic", blueprint: "e23a77f921214bb5b06d02509aa8d79d", name: "Trick Magic", summary: "From 2nd level, add your Persuasion ranks to concentration checks.", guide: "arcanist#time-manipulator"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/way-of-the-charlatan/fool-magic", blueprint: "987a71435f214e979b3bcad0a429e978", name: "Fool Magic", summary: "Use Persuasion (Bluff) checks in place of Use Magic Device checks.", guide: "arcanist#fool-magic"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/way-of-the-charlatan/fool-resistance", blueprint: "dd2e9aa312664a6b93bc5d4c2915e8f1", name: "Fool Resistance", summary: "From 12th level, add half your Persuasion ranks to caster level checks against spell resistance.", guide: "arcanist#way-of-the-charlatan"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/way-of-the-charlatan/spell-fabrication", blueprint: "ba992e0795e44c11bcb6da270c56d252", name: "Spell Fabrication", summary: "From 4th level, cast a spellbook spell with a Persuasion (Bluff) check (DC 10 + twice its level), 1/day +1 per four levels.", guide: "arcanist#way-of-the-charlatan"),
