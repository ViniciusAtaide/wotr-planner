Class(
    key: "arcanist",
    name: "Arcanist",
    summary: "Arcane caster who prepares wizard spells but casts them in any combination, fuelled by a reservoir; 1/2 BAB, spells to 9th level, good Will, 5 HP a level.",
    guide: "arcanist",
    skill_points: 2,
    casting_ability: Intelligence,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "use-magic-device"],
    features: [
        (key: "arcanist/arcane-reservoir", name: "Arcane Reservoir", summary: "Holds up to level + 3 points (half level + 3 after rest); spend 1 as a free action to add +1 to a spell's caster level or DC.", guide: "arcanist#arcane-reservoir"),
        (key: "arcanist/cantrips", name: "Cantrips", guide: "arcanist"),
        (key: "arcanist/consume-spells", name: "Consume Spells", summary: "Give up a prepared casting to gain reservoir points equal to the spell's level.", guide: "arcanist#consume-spells"),
        (key: "arcanist/magical-supremacy", name: "Magical Supremacy", summary: "At 20th level, cast any prepared spell by spending reservoir points equal to its level.", guide: "arcanist#magical-supremacy"),
    ],
    selections: [
        (
            key: "arcanist/arcanist-exploits",
            name: "Arcanist Exploits",
            summary: "Choose exploits, special powers paid with reservoir points; their save DC is 10 + half level + Cha.",
            guide: "arcanist#arcanist-exploits",
            options: [
                (key: "arcanist/arcanist-exploits/acid-jet", name: "Acid Jet", summary: "Cost 1: ranged touch for 1d6 acid + Cha, +1d6 every 2 levels (10d6 at 19th); sickened 1d4 rounds unless Fortitude.", guide: "arcanist#acid-jet"),
                (key: "arcanist/arcanist-exploits/arcane-barrier", name: "Arcane Barrier", summary: "Cost 1 (rising to 3 on repeat uses): temporary HP of level + Cha for 1 minute per level.", guide: "arcanist#arcane-barrier"),
                (key: "arcanist/arcanist-exploits/armored-mask", name: "Armored Mask", summary: "Cost 1: Mage Armor at your class level, or Shield of Faith if Mage Armor is already up.", guide: "arcanist#armored-mask"),
                (key: "arcanist/arcanist-exploits/dimensional-slide", name: "Dimensional Slide", summary: "Cost 1: use your move action to go to any spot within close range.", guide: "arcanist#dimensional-slide"),
                (key: "arcanist/arcanist-exploits/energy-shield", name: "Energy Shield", summary: "Cost 1: resistance 10 to one energy for 1 minute per level, +5 per five levels (30 at 20th).", guide: "arcanist#energy-shield"),
                (key: "arcanist/arcanist-exploits/flame-arc", name: "Flame Arc", summary: "Cost 1: 30' line of fire for 1d6 + Cha, +1d6 every 2 levels (10d6 at 19th), Reflex half.", guide: "arcanist#flame-arc"),
                (key: "arcanist/arcanist-exploits/force-strike", name: "Force Strike", summary: "Cost 1: automatically hit a target within 30' for 1d4 force + 1 per level; blocked by what stops Magic Missile.", guide: "arcanist#force-strike"),
                (key: "arcanist/arcanist-exploits/holy-water-jet", name: "Holy Water Jet", summary: "Good only, cost 1: 30' jet for 1d8 holy + Cha to susceptible creatures, +1d8 every 2 levels (10d8 at 19th), Reflex half.", guide: "arcanist#holy-water-jet", prerequisite: Any([Alignment(LawfulGood), Alignment(NeutralGood), Alignment(ChaoticGood)])),
                (key: "arcanist/arcanist-exploits/ice-missile", name: "Ice Missile", summary: "Cost 1: ranged touch for 1d6 cold + Cha, +1d6 every 2 levels (10d6 at 19th); staggered 1 round unless Fortitude.", guide: "arcanist#ice-missile"),
                (key: "arcanist/arcanist-exploits/lightning-lance", name: "Lightning Lance", summary: "Cost 1: ranged touch for 1d6 electricity + Cha, +1d6 every 2 levels (10d6 at 19th); 20% miss chance for 1 round unless Fortitude.", guide: "arcanist#lightning-lance"),
                (key: "arcanist/arcanist-exploits/potent-magic", name: "Potent Magic", summary: "Reservoir points add +2 instead of +1 to a spell's caster level or DC.", guide: "arcanist#potent-magic"),
                (key: "arcanist/arcanist-exploits/shadow-veil", name: "Shadow Veil", summary: "Cost 1: 20% concealment and +5 Stealth for 1 + Cha rounds.", guide: "arcanist#shadow-veil"),
                (key: "arcanist/arcanist-exploits/sonic-blast", name: "Sonic Blast", summary: "Cost 1: ranged touch within 30' for 1d6 sonic + Cha, +1d6 every 2 levels (10d6 at 19th), Fortitude half.", guide: "arcanist#sonic-blast"),
                (key: "arcanist/arcanist-exploits/spell-resistance", name: "Spell Resistance", summary: "Cost 1: spell resistance 6 + level for Cha mod rounds.", guide: "arcanist#spell-resistance"),
                (key: "arcanist/arcanist-exploits/swift-consume", name: "Swift Consume", summary: "Consume Spells becomes a swift action instead of a move action.", guide: "arcanist#swift-consume"),
                (key: "arcanist/arcanist-exploits/wooden-flesh", name: "Wooden Flesh", summary: "Cost 1: +2 natural armour and DR/slashing equal to Cha for 1 minute per level; you count as a plant only for plant-specific effects.", guide: "arcanist#wooden-flesh"),
            ],
        ),
        (
            key: "arcanist/greater-exploits",
            name: "Greater Exploits",
            summary: "Stronger exploits, available from 11th level.",
            guide: "arcanist#greater-exploits",
            options: [
                (key: "arcanist/greater-exploits/burning-flame", name: "Burning Flame", summary: "Cost 2, needs Flame Arc: targets failing the save catch fire for 3d6 a turn until a Reflex save puts it out.", guide: "arcanist#burning-flame", prerequisite: SelectionOption("arcanist/arcanist-exploits/flame-arc")),
                (key: "arcanist/greater-exploits/dancing-electricity", name: "Dancing Electricity", summary: "Cost 2, needs Lightning Lance: creatures next to the target take half its electricity damage (Reflex half).", guide: "arcanist#dancing-electricity", prerequisite: SelectionOption("arcanist/arcanist-exploits/lightning-lance")),
                (key: "arcanist/greater-exploits/greater-spell-resistance", name: "Greater Spell Resistance", summary: "Cost 1, needs Spell Resistance: spell resistance 11 + level.", guide: "arcanist#greater-spell-resistance", prerequisite: SelectionOption("arcanist/arcanist-exploits/spell-resistance")),
                (key: "arcanist/greater-exploits/hellfire-ray", name: "Hellfire Ray", summary: "Cost 2, needs Flame Arc: half the damage is unholy and ignores fire resistance; good targets sickened 1d4 rounds unless Will.", guide: "arcanist#hellfire-ray", prerequisite: SelectionOption("arcanist/arcanist-exploits/flame-arc")),
                (key: "arcanist/greater-exploits/icy-tomb", name: "Icy Tomb", summary: "Cost 2, needs Ice Missile: a target failing its save is iced over for 1 minute per caster level, entangled and losing 1 Dex a turn (Str DC 10 + Cha).", guide: "arcanist#icy-tomb", prerequisite: SelectionOption("arcanist/arcanist-exploits/ice-missile")),
                (key: "arcanist/greater-exploits/lingering-acid", name: "Lingering Acid", summary: "Cost 2, needs Acid Jet: on a failed save the target keeps taking acid damage, 1d6 per 2d6 dealt the round before.", guide: "arcanist#lingering-acid", prerequisite: SelectionOption("arcanist/arcanist-exploits/acid-jet")),
            ],
        ),
    ],
    levels: [
        (level: 1, arcane_spell_level: 1, features: ["arcanist/arcane-reservoir", "arcanist/cantrips", "arcanist/consume-spells"], feats: ["simple-weapon-proficiency"], selections: ["arcanist/arcanist-exploits"]),
        (level: 2, arcane_spell_level: 1),
        (level: 3, arcane_spell_level: 1, selections: ["arcanist/arcanist-exploits"]),
        (level: 4, arcane_spell_level: 2),
        (level: 5, arcane_spell_level: 2, selections: ["arcanist/arcanist-exploits"]),
        (level: 6, arcane_spell_level: 3),
        (level: 7, arcane_spell_level: 3, selections: ["arcanist/arcanist-exploits"]),
        (level: 8, arcane_spell_level: 4),
        (level: 9, arcane_spell_level: 4, selections: ["arcanist/arcanist-exploits"]),
        (level: 10, arcane_spell_level: 5),
        (level: 11, arcane_spell_level: 5, selections: ["arcanist/arcanist-exploits", "arcanist/greater-exploits"]),
        (level: 12, arcane_spell_level: 6),
        (level: 13, arcane_spell_level: 6, selections: ["arcanist/arcanist-exploits"]),
        (level: 14, arcane_spell_level: 7),
        (level: 15, arcane_spell_level: 7, selections: ["arcanist/arcanist-exploits"]),
        (level: 16, arcane_spell_level: 8),
        (level: 17, arcane_spell_level: 8, selections: ["arcanist/arcanist-exploits"]),
        (level: 18, arcane_spell_level: 9),
        (level: 19, arcane_spell_level: 9, selections: ["arcanist/arcanist-exploits"]),
        (level: 20, arcane_spell_level: 9, features: ["arcanist/magical-supremacy"]),
    ],
    archetypes: [
        (
            key: "arcanist/brown-fur-transmuter",
            name: "Brown-Fur Transmuter",
            summary: "Arcanist who boosts transmutation spells and shares self-buffs, with fewer exploits.",
            guide: "arcanist#brown-fur-transmuter",
            features: [
                (key: "arcanist/brown-fur-transmuter/cantrips", name: "Cantrips", guide: "arcanist#brown-fur-transmuter"),
                (key: "arcanist/brown-fur-transmuter/powerful-change", name: "Powerful Change", summary: "Spend 1 reservoir point on a transmutation spell to raise its ability score bonus by 2.", guide: "arcanist#powerful-change"),
                (key: "arcanist/brown-fur-transmuter/shared-transmutation", name: "Shared Transmutation", summary: "Spend 1 reservoir point to change a personal transmutation spell's range to touch; not with Powerful Change.", guide: "arcanist#shared-transmutation"),
                (key: "arcanist/brown-fur-transmuter/transmutation-supremacy", name: "Transmutation Supremacy", summary: "Transmutation spells are extended, Powerful Change gives +4, and Shared Transmutation reaches close range.", guide: "arcanist#transmutation-supremacy"),
            ],
            levels: [
                (level: 1, features: ["arcanist/arcane-reservoir", "arcanist/brown-fur-transmuter/cantrips", "arcanist/consume-spells"], feats: ["simple-weapon-proficiency"], selections: ["arcanist/arcanist-exploits"]),
                (level: 3, features: ["arcanist/brown-fur-transmuter/powerful-change"]),
                (level: 9, features: ["arcanist/brown-fur-transmuter/shared-transmutation"]),
                (level: 20, features: ["arcanist/brown-fur-transmuter/transmutation-supremacy"]),
            ],
        ),
        (
            key: "arcanist/eldritch-font",
            name: "Eldritch Font",
            summary: "Arcanist with more spell slots but fewer prepared spells, able to surge spells, with fewer exploits.",
            guide: "arcanist#eldritch-font",
            features: [
                (key: "arcanist/eldritch-font/bottomless-well", name: "Bottomless Well", summary: "Once a day as a full-round action, prepare new spells and regain half your level in reservoir points.", guide: "arcanist#bottomless-well"),
                (key: "arcanist/eldritch-font/cantrips", name: "Cantrips", guide: "arcanist#eldritch-font"),
                (key: "arcanist/eldritch-font/eldritch-surge", name: "Eldritch Surge", summary: "Swift action: +2 caster level and DC to a spell, or +2 level to an exploit, but you become fatigued (exhausted if already).", guide: "arcanist#eldritch-surge"),
                (key: "arcanist/eldritch-font/font-of-power", name: "Font of Power", summary: "One extra slot per spell level, but one fewer spell prepared of each level.", guide: "arcanist#font-of-power"),
                (key: "arcanist/eldritch-font/greater-surge", name: "Greater Surge", summary: "Eldritch Surge can force a creature to roll its save twice and take the worse result.", guide: "arcanist#greater-surge"),
                (key: "arcanist/eldritch-font/improved-surge", name: "Improved Surge", summary: "Eldritch Surge can let you roll a spell's attack twice and take the better result.", guide: "arcanist#improved-surge"),
            ],
            levels: [
                (level: 1, features: ["arcanist/arcane-reservoir", "arcanist/consume-spells", "arcanist/eldritch-font/cantrips", "arcanist/eldritch-font/font-of-power"], feats: ["simple-weapon-proficiency"], selections: ["arcanist/arcanist-exploits"]),
                (level: 3, features: ["arcanist/eldritch-font/eldritch-surge"]),
                (level: 7, features: ["arcanist/eldritch-font/improved-surge"]),
                (level: 13, features: ["arcanist/eldritch-font/greater-surge"]),
                (level: 20, features: ["arcanist/eldritch-font/bottomless-well"]),
            ],
        ),
        (
            key: "arcanist/magic-deceiver",
            name: "Magic Deceiver",
            summary: "Arcanist (Dance of Masks DLC) who fuses spells into new ones and picks a deceiver path; no reservoir or exploits, spells to 6th level.",
            guide: "arcanist#magic-deceiver",
            features: [
                (key: "arcanist/magic-deceiver/cantrips", name: "Cantrips", guide: "arcanist#magic-deceiver"),
                (key: "arcanist/magic-deceiver/magic-fusion", name: "Magic Fusion", summary: "Craft up to 10 new spells by fusing two known spells, using the higher level and DC and either spell's school and shape.", guide: "arcanist#magic-fusion"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/inhibit-courage", name: "Inhibit Courage", summary: "Performance for level + Cha rounds a day: foes take -1 to attack, damage and saves against charm and fear, -1 more at 5th, 11th and 17th.", guide: "arcanist#inhibit-courage"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/inhibit-greatness", name: "Inhibit Greatness", summary: "From 12th level, performance gives foes -2 attack, -1 saves and -3 to beat spell resistance (-4 at 17th).", guide: "arcanist#inhibit-greatness"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/inhibit-heroics", name: "Inhibit Heroics", summary: "At 20th level, performance gives foes -4 to AC and saves.", guide: "arcanist#inhibit-heroics"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/spell-fabrication", name: "Spell Fabrication", summary: "From 4th level, cast a spellbook spell with a Persuasion (Bluff) check (DC 10 + twice its level), 1/day +1 per four levels.", guide: "arcanist#spell-fabrication"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/fake-celebrity/trick-magic", name: "Trick Magic", summary: "From 2nd level, add your Persuasion ranks to concentration checks.", guide: "arcanist#trick-magic"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/living-deity/godly-fraud", name: "Godly Fraud", summary: "From 12th level, add half your Lore (Religion) ranks to caster level checks against spell resistance.", guide: "arcanist#godly-fraud"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/living-deity/mysterious-gift", name: "Mysterious Gift", summary: "Atheists only: gain an oracle mystery and curse (without the curse's level-up benefits); Cha for Lore (Religion).", guide: "arcanist#mysterious-gift"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/living-deity/pious-guile", name: "Pious Guile", summary: "From 2nd level, add your Lore (Religion) ranks to concentration checks.", guide: "arcanist#pious-guile"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/enchanters-fabrication", name: "Enchanter\'s Fabrication", summary: "From 4th level, cast a spellbook spell with a Use Magic Device check (DC 10 + twice its level), 1/day +1 per four levels.", guide: "arcanist#enchanters-fabrication"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/enchanters-penetration", name: "Enchanter\'s Penetration", summary: "From 12th level, add half your Use Magic Device ranks to caster level checks against spell resistance.", guide: "arcanist#enchanters-penetration"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/fake-enhancement", name: "Fake Enhancement", summary: "From 2nd level, enhancement bonuses from items rise by +1, or +2 for ability scores.", guide: "arcanist#fake-enhancement"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/magic-inventions", name: "Magic Inventions", summary: "Add your class level to Use Magic Device checks.", guide: "arcanist#magic-inventions"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/magic-inventor/true-enhancement", name: "True Enhancement", summary: "At 20th level, enhancement bonuses from items rise by +2, or +4 for ability scores.", guide: "arcanist#true-enhancement"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/acolyte-of-the-first-step", name: "Acolyte of the First Step", summary: "The mask hides your alignment and gives +2 on Persuasion (Bluff).", guide: "arcanist#acolyte-of-the-first-step"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/fool-resistance", name: "Fool Resistance", summary: "From 12th level, add half your Persuasion ranks to caster level checks against spell resistance.", guide: "arcanist#fool-resistance"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/herald-of-the-eighth-step", name: "Herald of the Eighth Step", summary: "From 8th level, the mask grants See Invisibility.", guide: "arcanist#herald-of-the-eighth-step"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/mask-of-the-twelfth-step", name: "Mask of the Twelfth Step", summary: "From 12th level, the mask grants spell resistance 12 + level.", guide: "arcanist#mask-of-the-twelfth-step"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/most-trusted-follower", name: "Most Trusted Follower", summary: "At 20th level, once a round, try to cancel an enemy spell within 30' with a Persuasion (Bluff) check against its DC.", guide: "arcanist#most-trusted-follower"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/priest-of-the-third-step", name: "Priest of the Third Step", summary: "From 3rd level, the mask gives +2 on initiative.", guide: "arcanist#priest-of-the-third-step"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/razmiri-mask", name: "Razmiri Mask", summary: "A mask that grants powers as you level; no other face item can be worn.", guide: "arcanist#razmiri-mask"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/spell-fabrication", name: "Spell Fabrication", summary: "From 4th level, cast a spellbook spell with a Persuasion (Bluff) check (DC 10 + twice its level), 1/day +1 per four levels.", guide: "arcanist#razmiri-infiltrator"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/trick-magic", name: "Trick Magic", summary: "From 2nd level, add your Persuasion ranks to concentration checks.", guide: "arcanist#razmiri-infiltrator"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/razmiri-infiltrator/vision-of-the-fifteenth-step", name: "Vision of the Fifteenth Step", guide: "arcanist#razmiri-infiltrator"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/advance-time", name: "Advance Time", summary: "Swift action, 1 + Cha times a day: shorten all effects on yourself or an ally by rounds equal to your level.", guide: "arcanist#advance-time"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/chronomancy", name: "Chronomancy", summary: "From 4th level, outside combat, refresh your or an ally's spells and abilities as if rested, at -1 DC until a real rest; 1/day +1 per four levels.", guide: "arcanist#chronomancy"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/split-second", name: "Split Second", summary: "From 12th level, use Persuasion (Bluff) checks in place of Reflex saves.", guide: "arcanist#split-second"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/split-timeline", name: "Split Timeline", summary: "At 20th level, once per combat, reset yourself or an ally to a fully rested state, with all spells, abilities and HP.", guide: "arcanist#split-timeline"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/time-manipulator/trick-magic", name: "Trick Magic", summary: "From 2nd level, add your Persuasion ranks to concentration checks.", guide: "arcanist#time-manipulator"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/way-of-the-charlatan/fool-magic", name: "Fool Magic", summary: "Use Persuasion (Bluff) checks in place of Use Magic Device checks.", guide: "arcanist#fool-magic"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/way-of-the-charlatan/fool-resistance", name: "Fool Resistance", summary: "From 12th level, add half your Persuasion ranks to caster level checks against spell resistance.", guide: "arcanist#way-of-the-charlatan"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/way-of-the-charlatan/spell-fabrication", name: "Spell Fabrication", summary: "From 4th level, cast a spellbook spell with a Persuasion (Bluff) check (DC 10 + twice its level), 1/day +1 per four levels.", guide: "arcanist#way-of-the-charlatan"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/way-of-the-charlatan/supreme-hoax", name: "Supreme Hoax", summary: "At 20th level, Spell Fabrication spells get +2 caster level and DC.", guide: "arcanist#supreme-hoax"),
                (key: "arcanist/magic-deceiver/ways-of-the-deceiver/way-of-the-charlatan/trick-magic", name: "Trick Magic", summary: "From 2nd level, add your Persuasion ranks to concentration checks.", guide: "arcanist#way-of-the-charlatan"),
            ],
            selections: [
                (
                    key: "arcanist/magic-deceiver/domain",
                    name: "Domain (Living Deity)",
                    summary: "At 20th level, a Living Deity picks two domains and gains their abilities.",
                    guide: "arcanist#hollow-spark",
                    option_levels: ["arcanist"],
                    options: [],
                    shared_options: [
                        "cleric/domain/air",
                        "cleric/domain/animal",
                        "cleric/domain/artifice",
                        "cleric/domain/chaos",
                        "cleric/domain/charm",
                        "cleric/domain/community",
                        "cleric/domain/darkness",
                        "cleric/domain/death",
                        "cleric/domain/destruction",
                        "cleric/domain/earth",
                        "cleric/domain/evil",
                        "cleric/domain/fire",
                        "cleric/domain/glory",
                        "cleric/domain/good",
                        "cleric/domain/healing",
                        "cleric/domain/ice",
                        "cleric/domain/knowledge",
                        "cleric/domain/law",
                        "cleric/domain/liberation",
                        "cleric/domain/luck",
                        "cleric/domain/madness",
                        "cleric/domain/magic",
                        "cleric/domain/murder",
                        "cleric/domain/nobility",
                        "cleric/domain/plant",
                        "cleric/domain/protection",
                        "cleric/domain/repose",
                        "cleric/domain/rune",
                        "cleric/domain/scalykind",
                        "cleric/domain/strength",
                        "cleric/domain/sun",
                        "cleric/domain/travel",
                        "cleric/domain/trickery",
                        "cleric/domain/undead",
                        "cleric/domain/war",
                        "cleric/domain/water",
                        "cleric/domain/weather",
                    ],
                ),
                (
                    key: "arcanist/magic-deceiver/mystery",
                    name: "Mystery (Living Deity)",
                    summary: "Pick an oracle mystery; its revelations come at 1st, 4th, 12th and 20th level, plus the final revelation.",
                    guide: "arcanist#mysterious-gift-mystery",
                    option_levels: ["arcanist"],
                    options: [],
                    shared_options: [
                        "oracle/mystery/ancestor",
                        "oracle/mystery/battle",
                        "oracle/mystery/bones",
                        "oracle/mystery/flame",
                        "oracle/mystery/life",
                        "oracle/mystery/nature",
                        "oracle/mystery/stone",
                        "oracle/mystery/waves",
                        "oracle/mystery/wind",
                    ],
                ),
                (
                    key: "arcanist/magic-deceiver/revelation",
                    name: "Revelation (Living Deity)",
                    summary: "A revelation from the Living Deity's mystery, gained at 1st, 4th, 12th and 20th level.",
                    guide: "arcanist#mysterious-gift-mystery",
                    option_levels: ["arcanist"],
                    pool_of: "arcanist/magic-deceiver/mystery",
                    options: [],
