Class(
    key: "bloodrager",
    name: "Bloodrager",
    summary: "Full-BAB raging warrior with a bloodline and spontaneous arcane spells up to 4th level from 4th; 8 HP and 3 skill points per level, good Fortitude.",
    guide: "bloodrager",
    skill_points: 3,
    casting_ability: Charisma,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["athletics", "knowledge-arcana", "lore-nature", "mobility", "perception", "persuasion"],
    spontaneous: true,
    features: [
        (key: "bloodrager/blood-sanctuary", name: "Blood Sanctuary", summary: "From 3rd level, +2 on saves against spells cast by yourself or an ally.", guide: "bloodrager#blood-sanctuary"),
        (key: "bloodrager/bloodline-spell-1st", name: "Bloodline Spell (1st)", summary: "At 7th level, adds your bloodline's 1st-level spell to your spells known.", guide: "bloodrager"),
        (key: "bloodrager/bloodline-spell-2nd", name: "Bloodline Spell (2nd)", summary: "At 10th level, adds your bloodline's 2nd-level spell to your spells known.", guide: "bloodrager"),
        (key: "bloodrager/bloodline-spell-3rd", name: "Bloodline Spell (3rd)", summary: "At 13th level, adds your bloodline's 3rd-level spell to your spells known.", guide: "bloodrager"),
        (key: "bloodrager/bloodline-spell-4th", name: "Bloodline Spell (4th)", summary: "At 16th level, adds your bloodline's 4th-level spell to your spells known.", guide: "bloodrager"),
        (key: "bloodrager/bloodline/abyssal/abyssal-bloodrage", name: "Abyssal Bloodrage", summary: "From 12th level, bloodrage's morale bonus to attack and damage gains +1, and +1 more at 16th and 20th, but its AC penalty grows to -4.", guide: "bloodrager#abyssal-bloodrage"),
        (key: "bloodrager/bloodline/abyssal/claws", name: "Claws", summary: "Claws while raging for 1d6 (1d4 if Small): magic at 4th level, 1d8 at 8th, +1d6 fire at 12th.", guide: "bloodrager#claws-abyssal"),
        (key: "bloodrager/bloodline/abyssal/demon-resistances", name: "Demon Resistances", summary: "From 8th level, acid, cold and fire resistance 5, which becomes 10 at 16th.", guide: "bloodrager#demon-resistances"),
        (key: "bloodrager/bloodline/abyssal/demonic-aura", name: "Demonic Aura", summary: "From 16th level, while raging, a 5-foot aura deals 2d6 fire + Constitution modifier to creatures ending their turn in it.", guide: "bloodrager#demonic-aura"),
        (key: "bloodrager/bloodline/abyssal/demonic-bulk", name: "Demonic Bulk", summary: "From 4th level, you grow one size category when you enter bloodrage.", guide: "bloodrager#demonic-bulk"),
        (key: "bloodrager/bloodline/abyssal/demonic-immunities", name: "Demonic Immunities", summary: "At 20th level, immunity to electricity and poison.", guide: "bloodrager#demonic-immunities"),
        (key: "bloodrager/bloodline/arcane/arcane-bloodrage", name: "Arcane Bloodrage", summary: "From 4th level, entering bloodrage can put Blur, Protection from Arrows or Resist Energy on you.", guide: "bloodrager#arcane-bloodrage"),
        (key: "bloodrager/bloodline/arcane/casters-bane", name: "Caster\'s Bane", summary: "At 20th level, spellcasters within 10 feet always fail to cast defensively.", guide: "bloodrager#casters-bane"),
        (key: "bloodrager/bloodline/arcane/casters-scourge", name: "Caster\'s Scourge", summary: "From 12th level, enemy casters within 10 feet must pass a concentration check (DC 15 + twice the spell level).", guide: "bloodrager#casters-scourge"),
        (key: "bloodrager/bloodline/arcane/disruptive-bloodrage", name: "Disruptive Bloodrage", summary: "While you rage, enemies within 10 feet take -2 on concentration checks.", guide: "bloodrager#disruptive-bloodrage"),
        (key: "bloodrager/bloodline/arcane/greater-arcane-bloodrage", name: "Greater Arcane Bloodrage", summary: "From 8th level, entering bloodrage can put Haste or Displacement on you.", guide: "bloodrager#greater-arcane-bloodrage"),
        (key: "bloodrager/bloodline/arcane/true-arcane-bloodrage", name: "True Arcane Bloodrage", summary: "From 16th level, entering bloodrage can put Beast Shape IV, Dragonkind I or Transformation on you.", guide: "bloodrager#true-arcane-bloodrage"),
        (key: "bloodrager/bloodline/celestial/angelic-attacks", name: "Angelic Attacks", summary: "Your melee attacks count as good for damage reduction and deal +1d6 to evil outsiders.", guide: "bloodrager#angelic-attacks"),
        (key: "bloodrager/bloodline/celestial/angelic-protection", name: "Angelic Protection", summary: "From 16th level, +4 deflection to AC and +4 on saves against attacks by evil creatures.", guide: "bloodrager#angelic-protection"),
        (key: "bloodrager/bloodline/celestial/ascension", name: "Ascension", summary: "At 20th level: immunity to acid, cold and petrification, resistance 10 to electricity and fire, and +4 on saves against poison.", guide: "bloodrager#ascension"),
        (key: "bloodrager/bloodline/celestial/celestial-resistances", name: "Celestial Resistances", summary: "Resistance 5 to acid and cold at 4th level, rising to 10 at 12th.", guide: "bloodrager#celestial-resistances"),
        (key: "bloodrager/bloodline/celestial/conviction", name: "Conviction", summary: "From 8th level, each bloodrage gives one reroll of your first failed save or skill check.", guide: "bloodrager#conviction"),
        (key: "bloodrager/bloodline/celestial/wings-of-heaven", name: "Wings of Heaven", summary: "From 12th level, you have wings while in bloodrage.", guide: "bloodrager#wings-of-heaven"),
        (key: "bloodrager/bloodline/draconic/breath-weapon", name: "Breath Weapon", summary: "From 8th level, a breath weapon shaped by your dragon: 1d6 energy per class level, Reflex save; once a day, twice at 16th, three times at 20th.", guide: "bloodrager#breath-weapon"),
        (key: "bloodrager/bloodline/draconic/claws", name: "Claws", summary: "Claws while raging for 1d6 (1d4 if Small): magic at 4th level, 1d8 at 8th, +1d6 of your energy type at 12th.", guide: "bloodrager#claws-draconic"),
        (key: "bloodrager/bloodline/draconic/draconic-resistance", name: "Draconic Resistance", summary: "Resistance 5 to your energy type and +1 natural armor at 4th level, 10 and +2 at 8th, and +4 natural armor at 16th.", guide: "bloodrager#draconic-resistance"),
        (key: "bloodrager/bloodline/draconic/dragon-form", name: "Dragon Form", summary: "From 16th level, entering bloodrage can turn you into your dragon, as Dragonkind II.", guide: "bloodrager#dragon-form"),
        (key: "bloodrager/bloodline/draconic/dragon-wings", name: "Dragon Wings", summary: "From 12th level, you have wings while in bloodrage.", guide: "bloodrager#dragon-wings"),
        (key: "bloodrager/bloodline/draconic/power-of-wyrms", name: "Power of Wyrms", summary: "At 20th level: immunity to paralysis, sleep and your energy type, plus 60-foot blindsense.", guide: "bloodrager#power-of-wyrms"),
        (key: "bloodrager/bloodline/elemental/elemental-body", name: "Elemental Body", summary: "At 20th level, you become immune to your bloodline's element, to critical hits and to sneak attacks.", guide: "bloodrager#elemental-body"),
        (key: "bloodrager/bloodline/elemental/elemental-form", name: "Elemental Form", summary: "From 16th level, once a day on entering bloodrage, take an elemental's form as Elemental Body IV.", guide: "bloodrager#elemental-form"),
        (key: "bloodrager/bloodline/elemental/elemental-movement", name: "Elemental Movement", summary: "From 8th level, +10 feet base speed and +2 on saves against spells and abilities of your element.", guide: "bloodrager#elemental-movement"),
        (key: "bloodrager/bloodline/elemental/elemental-resistance", name: "Elemental Resistance", summary: "From 4th level, resistance 10 to your bloodline's energy type.", guide: "bloodrager#elemental-resistance"),
        (key: "bloodrager/bloodline/elemental/elemental-strikes", name: "Elemental Strikes", summary: "Swift action: melee attacks deal +1d6 of your element for 1 round; 3/day, 5/day at 8th, always on at 20th.", guide: "bloodrager#elemental-strikes"),
        (key: "bloodrager/bloodline/elemental/power-of-the-elements", name: "Power of the Elements", summary: "From 12th level, Elemental Strikes deal 2d6 and spells of your element get +2 DC.", guide: "bloodrager#power-of-the-elements"),
        (key: "bloodrager/bloodline/fey/blurring-movement", name: "Blurring Movement", summary: "From 8th level, moving 10 feet or more gives you Blur for 1 round.", guide: "bloodrager#blurring-movement"),
        (key: "bloodrager/bloodline/fey/confusing-critical", name: "Confusing Critical", summary: "A confirmed critical hit confuses the target for 1 round unless it passes a Will save (DC 10 + half class level + Con modifier).", guide: "bloodrager#confusing-critical"),
        (key: "bloodrager/bloodline/fey/fury-of-the-fey", name: "Fury of the Fey", summary: "At 20th level, your melee attacks have the Bane property while raging (not stacking with real Bane).", guide: "bloodrager#fury-of-the-fey"),
        (key: "bloodrager/bloodline/fey/leaping-charger", name: "Leaping Charger", summary: "From 4th level, you ignore difficult terrain.", guide: "bloodrager#leaping-charger"),
        (key: "bloodrager/bloodline/fey/one-with-nature", name: "One with Nature", summary: "From 16th level, enemy plants and animals within 15 feet are fascinated unless they pass a Will save (DC 10 + half class level + Cha).", guide: "bloodrager#one-with-nature"),
        (key: "bloodrager/bloodline/fey/quickling-bloodrage", name: "Quickling Bloodrage", summary: "From 12th level, you are hasted while raging.", guide: "bloodrager#quickling-bloodrage"),
        (key: "bloodrager/bloodline/hag/covenguard", name: "Covenguard", summary: "From 16th level, cast Bestow Curse three times a day as a spell-like ability.", guide: "bloodrager#covenguard"),
        (key: "bloodrager/bloodline/hag/curse-conduit", name: "Curse Conduit", summary: "At 20th level: immunity to negative energy and curses, and a confirmed critical hit lays a random Bestow Curse on the target.", guide: "bloodrager#curse-conduit"),
        (key: "bloodrager/bloodline/hag/hag-fortitude", name: "Hag Fortitude", summary: "Immunity to disease at 4th level and to poison at 8th.", guide: "bloodrager#hag-fortitude"),
        (key: "bloodrager/bloodline/hag/hag-transformation", name: "Hag Transformation", summary: "From 12th level, while raging: scent, +2 Intimidate, +1 rage attack and damage, -2 Dex and Wis; at 16th the Will bonus applies to all saves.", guide: "bloodrager#hag-transformation"),
        (key: "bloodrager/bloodline/hag/wicked-gaze", name: "Wicked Gaze", summary: "Standard action: a foe within 30 feet takes -2 attack and AC (-4 at 8th) for 1 round per level, Will shortens; 3 + Cha modifier uses a day.", guide: "bloodrager#wicked-gaze"),
        (key: "bloodrager/bloodline/infernal/dark-wings", name: "Dark Wings", summary: "From 12th level, you have wings while in bloodrage.", guide: "bloodrager#dark-wings"),
        (key: "bloodrager/bloodline/infernal/diabolical-arrogance", name: "Diabolical Arrogance", summary: "From 8th level, +4 on saves against enchantment and fear effects.", guide: "bloodrager#diabolical-arrogance"),
        (key: "bloodrager/bloodline/infernal/fiend-of-the-pit", name: "Fiend of the Pit", summary: "At 20th level: immunity to fire and poison, and resistance 10 to acid and cold.", guide: "bloodrager#fiend-of-the-pit"),
        (key: "bloodrager/bloodline/infernal/hellfire-charge", name: "Hellfire Charge", summary: "From 16th level, your attacks on a charge deal +1d6 fire, plus 1d6 per 4 class levels.", guide: "bloodrager#hellfire-charge"),
        (key: "bloodrager/bloodline/infernal/hellfire-strike", name: "Hellfire Strike", summary: "Swift action: melee attacks gain Flaming (+1d6 fire) for 1 round; 3/day, or 5/day as flaming burst from 12th level.", guide: "bloodrager#hellfire-strike"),
        (key: "bloodrager/bloodline/infernal/infernal-resistance", name: "Infernal Resistance", summary: "Fire resistance 5 and +2 on saves against poison at 4th level, rising to 10 and +4 at 8th.", guide: "bloodrager#infernal-resistance"),
        (key: "bloodrager/bloodline/serpentine/dazing-glare", name: "Dazing Glare", summary: "From 8th level, three times a day as a swift action, daze a foe (DC 10 + half class level + Cha; mind-affecting gaze).", guide: "bloodrager#dazing-glare"),
        (key: "bloodrager/bloodline/serpentine/serpentine-body", name: "Serpentine Body", summary: "At 20th level: immunity to poison, never flat-footed, and you don't provoke attacks of opportunity.", guide: "bloodrager#serpentine-body"),
        (key: "bloodrager/bloodline/serpentine/serpentine-elasticity", name: "Serpentine Elasticity", summary: "From 12th level, +5 feet of reach while in bloodrage.", guide: "bloodrager#serpentine-elasticity"),
        (key: "bloodrager/bloodline/serpentine/serpentine-fang", name: "Serpentine Fang", summary: "A 1d8 bite (1d6 if Small) poisons for 1 Con a round over 4 rounds; 1d2 over 5 rounds at 8th, 1d4 over 6 rounds and two saves to end it at 16th.", guide: "bloodrager#serpentine-fang"),
        (key: "bloodrager/bloodline/serpentine/serpentine-form", name: "Serpentine Form", summary: "From 16th level, once per bloodrage, become a hydra: +4 Str, +2 Con, +4 natural armor, trip immunity and five poisoned 1d8 bites.", guide: "bloodrager#serpentine-form"),
        (key: "bloodrager/bloodline/serpentine/serpentine-resistances", name: "Serpentine Resistances", summary: "+1 natural armor and +1 on saves against poison at 4th level, +1 more every four levels from 8th (+5 at 20th).", guide: "bloodrager#serpentine-resistances"),
        (key: "bloodrager/bloodline/undead/deaths-gift", name: "Death\'s Gift", summary: "From 8th level, resistance 10 to cold and negative energy.", guide: "bloodrager#deaths-gift"),
        (key: "bloodrager/bloodline/undead/frightful-charger", name: "Frightful Charger", summary: "Targets of your charge attacks are shaken for half your class level in rounds (fear effect).", guide: "bloodrager#frightful-charger"),
        (key: "bloodrager/bloodline/undead/frightful-strikes", name: "Frightful Strikes", summary: "From 12th level, a swift action once each bloodrage makes your melee hits for 1 round shake foes, or frighten already-shaken ones.", guide: "bloodrager#frightful-strikes"),
        (key: "bloodrager/bloodline/undead/ghost-strike", name: "Ghost Strike", summary: "From 4th level, your melee attacks act as if they had the ghost touch property.", guide: "bloodrager#ghost-strike"),
        (key: "bloodrager/bloodline/undead/incorporeal-bloodrager", name: "Incorporeal Bloodrager", summary: "Once a day, become incorporeal: no damage from nonmagic weapons and half damage from magic corporeal sources.", guide: "bloodrager#incorporeal-bloodrager"),
        (key: "bloodrager/bloodline/undead/one-foot-in-the-grave", name: "One Foot in the Grave", summary: "At 20th level: immunity to cold, paralysis and sleep, DR rises to 8, and +4 morale on saves against undead spells and abilities.", guide: "bloodrager#one-foot-in-the-grave"),
        (key: "bloodrager/bloodrage", name: "Bloodrage", summary: "Free action rage for 4 + Con modifier rounds a day (+2 per level): +2 attack, melee damage and Will, 2 temp HP per HD, -2 AC; fatigued after.", guide: "bloodrager#bloodrage"),
        (key: "bloodrager/damage-reduction", name: "Damage Reduction", guide: "bloodrager"),
        (key: "bloodrager/fast-movement", name: "Fast Movement", guide: "bloodrager"),
        (key: "bloodrager/greater-bloodrage", name: "Greater Bloodrage", summary: "At 11th level, bloodrage gives +3 and 3 temp HP per HD, and you can cast a 2nd-level or lower touch or personal spell on yourself as you enter it.", guide: "bloodrager#greater-bloodrage"),
        (key: "bloodrager/improved-uncanny-dodge", name: "Improved Uncanny Dodge", guide: "bloodrager"),
        (key: "bloodrager/indomitable-will", name: "Indomitable Will", guide: "bloodrager"),
        (key: "bloodrager/mighty-bloodrage", name: "Mighty Bloodrage", summary: "At 20th level, bloodrage gives +4 and 4 temp HP per HD, and you can cast a spell of any level on yourself as you enter it.", guide: "bloodrager#mighty-bloodrage"),
        (key: "bloodrager/tireless-bloodrage", name: "Tireless Bloodrage", summary: "From 17th level, you are no longer fatigued after a bloodrage.", guide: "bloodrager#tireless-bloodrage"),
        (key: "bloodrager/uncanny-dodge", name: "Uncanny Dodge", guide: "bloodrager"),
    ],
    selections: [
        (
            key: "bloodrager/bloodline",
            name: "Bloodline",
            summary: "The bloodline gives your bloodrage powers, bonus spells from 7th level and bonus feats from 6th level.",
