Class(
    key: "bloodrager",
    blueprint: "d77e67a814d686842802c9cfd8ef8499",
    name: "Bloodrager",
    summary: "Full-BAB raging warrior with a bloodline and spontaneous arcane spells up to 4th level from 4th; 8 HP and 3 skill points per level, good Fortitude.",
    guide: "bloodrager",
    skill_points: 3,
    casting_ability: Charisma,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["athletics", "knowledge-arcana", "lore-nature", "mobility", "perception", "persuasion"],
    spontaneous: true,
    features: [
        (key: "bloodrager/blood-sanctuary", blueprint: "70d9d54bd349a63448032b5ac2e5c47d", name: "Blood Sanctuary", summary: "From 3rd level, +2 on saves against spells cast by yourself or an ally.", guide: "bloodrager#blood-sanctuary"),
        (key: "bloodrager/bloodline-spell-1st", name: "Bloodline Spell (1st)", summary: "At 7th level, adds your bloodline's 1st-level spell to your spells known.", guide: "bloodrager"),
        (key: "bloodrager/bloodline-spell-2nd", name: "Bloodline Spell (2nd)", summary: "At 10th level, adds your bloodline's 2nd-level spell to your spells known.", guide: "bloodrager"),
        (key: "bloodrager/bloodline-spell-3rd", name: "Bloodline Spell (3rd)", summary: "At 13th level, adds your bloodline's 3rd-level spell to your spells known.", guide: "bloodrager"),
        (key: "bloodrager/bloodline-spell-4th", name: "Bloodline Spell (4th)", summary: "At 16th level, adds your bloodline's 4th-level spell to your spells known.", guide: "bloodrager"),
        (key: "bloodrager/bloodline/abyssal/abyssal-bloodrage", blueprint: "29fc83f824111bb41829957486752c93", name: "Abyssal Bloodrage", summary: "From 12th level, bloodrage's morale bonus to attack and damage gains +1, and +1 more at 16th and 20th, but its AC penalty grows to -4.", guide: "bloodrager#abyssal-bloodrage", steps: (on: Classes(["bloodrager"]), at: [16, 20])),
        (key: "bloodrager/bloodline/abyssal/claws", blueprint: "60e5fd5e4a8213148a6de41b829bfb1b", name: "Claws", summary: "Claws while raging for 1d6 (1d4 if Small): magic at 4th level, 1d8 at 8th, +1d6 fire at 12th.", guide: "bloodrager#claws-abyssal"),
        (key: "bloodrager/bloodline/abyssal/demon-resistances", blueprint: "cbe641b9f6e57d94280ef05eb8aa7121", name: "Demon Resistances", summary: "From 8th level, acid, cold and fire resistance 5, which becomes 10 at 16th.", guide: "bloodrager#demon-resistances"),
        (key: "bloodrager/bloodline/abyssal/demonic-aura", blueprint: "677171968b9a22f459c7391d8302dd36", name: "Demonic Aura", summary: "From 16th level, while raging, a 5-foot aura deals 2d6 fire + Constitution modifier to creatures ending their turn in it.", guide: "bloodrager#demonic-aura"),
        (key: "bloodrager/bloodline/abyssal/demonic-bulk", blueprint: "7c79456f50656154c8d7bc5bb29764f1", name: "Demonic Bulk", summary: "From 4th level, you grow one size category when you enter bloodrage.", guide: "bloodrager#demonic-bulk"),
        (key: "bloodrager/bloodline/abyssal/demonic-immunities", blueprint: "2c5601c6c096fdb40bdb0a9e6a55401e", name: "Demonic Immunities", summary: "At 20th level, immunity to electricity and poison.", guide: "bloodrager#demonic-immunities"),
        (key: "bloodrager/bloodline/arcane/arcane-bloodrage", blueprint: "3584b932341ecf14fbaaa87bf337c2cf", name: "Arcane Bloodrage", summary: "From 4th level, entering bloodrage can put Blur, Protection from Arrows or Resist Energy on you.", guide: "bloodrager#arcane-bloodrage"),
        (key: "bloodrager/bloodline/arcane/casters-bane", blueprint: "7327c5f0d02a4eb99949da59603263a3", name: "Caster\'s Bane", summary: "At 20th level, spellcasters within 10 feet always fail to cast defensively.", guide: "bloodrager#casters-bane"),
        (key: "bloodrager/bloodline/arcane/casters-scourge", blueprint: "37fe30c322dbbf244af368eccbb37178", name: "Caster\'s Scourge", summary: "From 12th level, enemy casters within 10 feet must pass a concentration check (DC 15 + twice the spell level).", guide: "bloodrager#casters-scourge"),
        (key: "bloodrager/bloodline/arcane/disruptive-bloodrage", blueprint: "d8cb753a508c6fd4090a9c67ad0c1e58", name: "Disruptive Bloodrage", summary: "While you rage, enemies within 10 feet take -2 on concentration checks.", guide: "bloodrager#disruptive-bloodrage"),
        (key: "bloodrager/bloodline/arcane/greater-arcane-bloodrage", blueprint: "834848ff5151c8440b358cbcc72e7880", name: "Greater Arcane Bloodrage", summary: "From 8th level, entering bloodrage can put Haste or Displacement on you.", guide: "bloodrager#greater-arcane-bloodrage"),
        (key: "bloodrager/bloodline/arcane/true-arcane-bloodrage", blueprint: "1d5079fa59fe01a4d8b822b790876e4d", name: "True Arcane Bloodrage", summary: "From 16th level, entering bloodrage can put Beast Shape IV, Dragonkind I or Transformation on you.", guide: "bloodrager#true-arcane-bloodrage"),
        (key: "bloodrager/bloodline/celestial/angelic-attacks", blueprint: "40ed9b51a37d1714e92ece6700ddfaf4", name: "Angelic Attacks", summary: "Your melee attacks count as good for damage reduction and deal +1d6 to evil outsiders.", guide: "bloodrager#angelic-attacks"),
        (key: "bloodrager/bloodline/celestial/angelic-protection", blueprint: "9167b251ca91d824da21a38b1eed495a", name: "Angelic Protection", summary: "From 16th level, +4 deflection to AC and +4 on saves against attacks by evil creatures.", guide: "bloodrager#angelic-protection"),
        (key: "bloodrager/bloodline/celestial/ascension", blueprint: "22026a36e62907f41a8c49717d4eac96", name: "Ascension", summary: "At 20th level: immunity to acid, cold and petrification, resistance 10 to electricity and fire, and +4 on saves against poison.", guide: "bloodrager#ascension"),
        (key: "bloodrager/bloodline/celestial/celestial-resistances", blueprint: "16b632b134b2c27458fb2559e72815f4", name: "Celestial Resistances", summary: "Resistance 5 to acid and cold at 4th level, rising to 10 at 12th.", guide: "bloodrager#celestial-resistances"),
        (key: "bloodrager/bloodline/celestial/conviction", blueprint: "713d244738edd8e488b924fe43ff880e", name: "Conviction", summary: "From 8th level, each bloodrage gives one reroll of your first failed save or skill check.", guide: "bloodrager#conviction"),
        (key: "bloodrager/bloodline/celestial/wings-of-heaven", blueprint: "2356204ced343ab42a2df1e66b92b1b8", name: "Wings of Heaven", summary: "From 12th level, you have wings while in bloodrage.", guide: "bloodrager#wings-of-heaven"),
        (key: "bloodrager/bloodline/draconic/breath-weapon", name: "Breath Weapon", summary: "From 8th level, a breath weapon shaped by your dragon: 1d6 energy per class level, Reflex save; once a day, twice at 16th, three times at 20th.", guide: "bloodrager#breath-weapon"),
        (key: "bloodrager/bloodline/draconic/claws", blueprint: "419dcd95d81401e4eaebbfb4779b0135", name: "Claws", summary: "Claws while raging for 1d6 (1d4 if Small): magic at 4th level, 1d8 at 8th, +1d6 of your energy type at 12th.", guide: "bloodrager#claws-draconic"),
        (key: "bloodrager/bloodline/draconic/draconic-resistance", blueprint: "95e25e3e004640b40ac17dab26028e47", name: "Draconic Resistance", summary: "Resistance 5 to your energy type and +1 natural armor at 4th level, 10 and +2 at 8th, and +4 natural armor at 16th.", guide: "bloodrager#draconic-resistance"),
        (key: "bloodrager/bloodline/draconic/dragon-form", name: "Dragon Form", summary: "From 16th level, entering bloodrage can turn you into your dragon, as Dragonkind II.", guide: "bloodrager#dragon-form"),
        (key: "bloodrager/bloodline/draconic/dragon-wings", blueprint: "d4de55099b24fa64fb5a7ced4894f0b6", name: "Dragon Wings", summary: "From 12th level, you have wings while in bloodrage.", guide: "bloodrager#dragon-wings"),
        (key: "bloodrager/bloodline/draconic/power-of-wyrms", blueprint: "720355ac399b7444098bcb286acadaae", name: "Power of Wyrms", summary: "At 20th level: immunity to paralysis, sleep and your energy type, plus 60-foot blindsense.", guide: "bloodrager#power-of-wyrms"),
        (key: "bloodrager/bloodline/elemental/elemental-body", name: "Elemental Body", summary: "At 20th level, you become immune to your bloodline's element, to critical hits and to sneak attacks.", guide: "bloodrager#elemental-body"),
        (key: "bloodrager/bloodline/elemental/elemental-form", name: "Elemental Form", summary: "From 16th level, once a day on entering bloodrage, take an elemental's form as Elemental Body IV.", guide: "bloodrager#elemental-form"),
        (key: "bloodrager/bloodline/elemental/elemental-movement", blueprint: "c1aa1514e23d0424fa3d78c782dcabc7", name: "Elemental Movement", summary: "From 8th level, +10 feet base speed and +2 on saves against spells and abilities of your element.", guide: "bloodrager#elemental-movement"),
        (key: "bloodrager/bloodline/elemental/elemental-resistance", blueprint: "e1c3a051676728a46963cc7c6c0d0696", name: "Elemental Resistance", summary: "From 4th level, resistance 10 to your bloodline's energy type.", guide: "bloodrager#elemental-resistance"),
        (key: "bloodrager/bloodline/elemental/elemental-strikes", name: "Elemental Strikes", summary: "Swift action: melee attacks deal +1d6 of your element for 1 round; 3/day, 5/day at 8th, always on at 20th.", guide: "bloodrager#elemental-strikes"),
        (key: "bloodrager/bloodline/elemental/power-of-the-elements", blueprint: "7a2cef447f364544e9dddb0f8bb410ce", name: "Power of the Elements", summary: "From 12th level, Elemental Strikes deal 2d6 and spells of your element get +2 DC.", guide: "bloodrager#power-of-the-elements"),
        (key: "bloodrager/bloodline/fey/blurring-movement", blueprint: "a15ebd7e497765442b1663a11ce621c4", name: "Blurring Movement", summary: "From 8th level, moving 10 feet or more gives you Blur for 1 round.", guide: "bloodrager#blurring-movement"),
        (key: "bloodrager/bloodline/fey/confusing-critical", blueprint: "7b2cee44ff286e640bb7ed053de80785", name: "Confusing Critical", summary: "A confirmed critical hit confuses the target for 1 round unless it passes a Will save (DC 10 + half class level + Con modifier).", guide: "bloodrager#confusing-critical"),
        (key: "bloodrager/bloodline/fey/fury-of-the-fey", blueprint: "49c7d32e5c60b2b4791dcaf728a4c8cf", name: "Fury of the Fey", summary: "At 20th level, your melee attacks have the Bane property while raging (not stacking with real Bane).", guide: "bloodrager#fury-of-the-fey"),
        (key: "bloodrager/bloodline/fey/leaping-charger", blueprint: "cfe2b18b06439b24b8bd5a1d6bf8754b", name: "Leaping Charger", summary: "From 4th level, you ignore difficult terrain.", guide: "bloodrager#leaping-charger"),
        (key: "bloodrager/bloodline/fey/one-with-nature", blueprint: "3a6e7bb6f624e0f4d8e8003f92ff501c", name: "One with Nature", summary: "From 16th level, enemy plants and animals within 15 feet are fascinated unless they pass a Will save (DC 10 + half class level + Cha).", guide: "bloodrager#one-with-nature"),
        (key: "bloodrager/bloodline/fey/quickling-bloodrage", blueprint: "1dcd8dc39c157b94f93077822d93ef58", name: "Quickling Bloodrage", summary: "From 12th level, you are hasted while raging.", guide: "bloodrager#quickling-bloodrage"),
        (key: "bloodrager/bloodline/hag/covenguard", blueprint: "b865152306f64169a1862de16ef68ba9", name: "Covenguard", summary: "From 16th level, cast Bestow Curse three times a day as a spell-like ability.", guide: "bloodrager#covenguard"),
        (key: "bloodrager/bloodline/hag/curse-conduit", blueprint: "2aefef394cb6491f9191a2d67ebb6b86", name: "Curse Conduit", summary: "At 20th level: immunity to negative energy and curses, and a confirmed critical hit lays a random Bestow Curse on the target.", guide: "bloodrager#curse-conduit"),
        (key: "bloodrager/bloodline/hag/hag-fortitude", blueprint: "7e203e1a7d3b42bfbd5c1b0dedcdf58f", name: "Hag Fortitude", summary: "Immunity to disease at 4th level and to poison at 8th.", guide: "bloodrager#hag-fortitude"),
        (key: "bloodrager/bloodline/hag/hag-transformation", blueprint: "158cc5887d884b639acb39c9088d8b39", name: "Hag Transformation", summary: "From 12th level, while raging: scent, +2 Intimidate, +1 rage attack and damage, -2 Dex and Wis; at 16th the Will bonus applies to all saves.", guide: "bloodrager#hag-transformation"),
        (key: "bloodrager/bloodline/hag/wicked-gaze", blueprint: "b5b9ca38327c4f53ae718bf0b4f3c480", name: "Wicked Gaze", summary: "Standard action: a foe within 30 feet takes -2 attack and AC (-4 at 8th) for 1 round per level, Will shortens; 3 + Cha modifier uses a day.", guide: "bloodrager#wicked-gaze"),
        (key: "bloodrager/bloodline/infernal/dark-wings", blueprint: "56372c7f8e8f92548bd4c2534558e3e9", name: "Dark Wings", summary: "From 12th level, you have wings while in bloodrage.", guide: "bloodrager#dark-wings"),
        (key: "bloodrager/bloodline/infernal/diabolical-arrogance", blueprint: "9c2b907b944a9534db0391e2b1860c22", name: "Diabolical Arrogance", summary: "From 8th level, +4 on saves against enchantment and fear effects.", guide: "bloodrager#diabolical-arrogance"),
        (key: "bloodrager/bloodline/infernal/fiend-of-the-pit", blueprint: "2b2786e0917d06d45a39930409d77190", name: "Fiend of the Pit", summary: "At 20th level: immunity to fire and poison, and resistance 10 to acid and cold.", guide: "bloodrager#fiend-of-the-pit"),
        (key: "bloodrager/bloodline/infernal/hellfire-charge", blueprint: "cf008cfe7f26ff74baf1c26f42e4d497", name: "Hellfire Charge", summary: "From 16th level, your attacks on a charge deal +1d6 fire, plus 1d6 per 4 class levels.", guide: "bloodrager#hellfire-charge"),
        (key: "bloodrager/bloodline/infernal/hellfire-strike", blueprint: "a08e08cf5ed4f0a4d87caf17ed6ef659", name: "Hellfire Strike", summary: "Swift action: melee attacks gain Flaming (+1d6 fire) for 1 round; 3/day, or 5/day as flaming burst from 12th level.", guide: "bloodrager#hellfire-strike"),
        (key: "bloodrager/bloodline/infernal/infernal-resistance", blueprint: "ac77b22f74aed034ca2b16ba6a4bfde9", name: "Infernal Resistance", summary: "Fire resistance 5 and +2 on saves against poison at 4th level, rising to 10 and +4 at 8th.", guide: "bloodrager#infernal-resistance", steps: (on: Classes(["bloodrager"]), at: [8])),
        (key: "bloodrager/bloodline/serpentine/dazing-glare", blueprint: "08f3591505206f5408577b0e2a5556ba", name: "Dazing Glare", summary: "From 8th level, three times a day as a swift action, daze a foe (DC 10 + half class level + Cha; mind-affecting gaze).", guide: "bloodrager#dazing-glare"),
        (key: "bloodrager/bloodline/serpentine/serpentine-body", blueprint: "0f5041528b307284aa4d8b9c61eef69d", name: "Serpentine Body", summary: "At 20th level: immunity to poison, never flat-footed, and you don't provoke attacks of opportunity.", guide: "bloodrager#serpentine-body"),
        (key: "bloodrager/bloodline/serpentine/serpentine-elasticity", blueprint: "78b8e3e18e9c3664bb24cccf57d44843", name: "Serpentine Elasticity", summary: "From 12th level, +5 feet of reach while in bloodrage.", guide: "bloodrager#serpentine-elasticity"),
        (key: "bloodrager/bloodline/serpentine/serpentine-fang", blueprint: "094bd6ae1b3348a47a14a6f5a8dd8b15", name: "Serpentine Fang", summary: "A 1d8 bite (1d6 if Small) poisons for 1 Con a round over 4 rounds; 1d2 over 5 rounds at 8th, 1d4 over 6 rounds and two saves to end it at 16th.", guide: "bloodrager#serpentine-fang"),
        (key: "bloodrager/bloodline/serpentine/serpentine-form", blueprint: "d433705eb8dec9c419e245e593c4d2e1", name: "Serpentine Form", summary: "From 16th level, once per bloodrage, become a hydra: +4 Str, +2 Con, +4 natural armor, trip immunity and five poisoned 1d8 bites.", guide: "bloodrager#serpentine-form"),
        (key: "bloodrager/bloodline/serpentine/serpentine-resistances", blueprint: "6ef7c801217421647a68e74dd4678fe9", name: "Serpentine Resistances", summary: "+1 natural armor and +1 on saves against poison at 4th level, +1 more every four levels from 8th (+5 at 20th).", guide: "bloodrager#serpentine-resistances"),
        (key: "bloodrager/bloodline/undead/deaths-gift", blueprint: "50a660c13e507584f8da6eb9c0d923a0", name: "Death\'s Gift", summary: "From 8th level, resistance 10 to cold and negative energy.", guide: "bloodrager#deaths-gift"),
        (key: "bloodrager/bloodline/undead/frightful-charger", blueprint: "d8f8074791a627a489d19169da8c01af", name: "Frightful Charger", summary: "Targets of your charge attacks are shaken for half your class level in rounds (fear effect).", guide: "bloodrager#frightful-charger"),
        (key: "bloodrager/bloodline/undead/frightful-strikes", blueprint: "d23ea2bb07e936b4fa932b878230bf68", name: "Frightful Strikes", summary: "From 12th level, a swift action once each bloodrage makes your melee hits for 1 round shake foes, or frighten already-shaken ones.", guide: "bloodrager#frightful-strikes"),
        (key: "bloodrager/bloodline/undead/ghost-strike", blueprint: "84634e9e49342ce44ae6dd13b4279838", name: "Ghost Strike", summary: "From 4th level, your melee attacks act as if they had the ghost touch property.", guide: "bloodrager#ghost-strike"),
        (key: "bloodrager/bloodline/undead/incorporeal-bloodrager", blueprint: "a9c737fe7912e4d49ab64e83aac86ca5", name: "Incorporeal Bloodrager", summary: "Once a day, become incorporeal: no damage from nonmagic weapons and half damage from magic corporeal sources.", guide: "bloodrager#incorporeal-bloodrager"),
        (key: "bloodrager/bloodline/undead/one-foot-in-the-grave", blueprint: "47cc5432a72f71e49969c0396fbf24e8", name: "One Foot in the Grave", summary: "At 20th level: immunity to cold, paralysis and sleep, DR rises to 8, and +4 morale on saves against undead spells and abilities.", guide: "bloodrager#one-foot-in-the-grave"),
        (key: "bloodrager/bloodrage", blueprint: "6991ee8175d87c04790067515f6fb322", name: "Bloodrage", summary: "Free action rage for 4 + Con modifier rounds a day (+2 per level): +2 attack, melee damage and Will, 2 temp HP per HD, -2 AC; fatigued after.", guide: "bloodrager#bloodrage"),
        (key: "bloodrager/damage-reduction", blueprint: "07eba4bb72c2e3845bb442dce85d3b58", name: "Damage Reduction", guide: "bloodrager"),
        (key: "bloodrager/fast-movement", blueprint: "5a7eb193611e0f642bfa6da16fe22b5a", name: "Fast Movement", guide: "bloodrager"),
        (key: "bloodrager/greater-bloodrage", blueprint: "48d5ac71af2136b48a2fac017646f701", name: "Greater Bloodrage", summary: "At 11th level, bloodrage gives +3 and 3 temp HP per HD, and you can cast a 2nd-level or lower touch or personal spell on yourself as you enter it.", guide: "bloodrager#greater-bloodrage"),
        (key: "bloodrager/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", guide: "bloodrager"),
        (key: "bloodrager/indomitable-will", blueprint: "80c27aae29b793a49b4023dc82a3a69e", name: "Indomitable Will", guide: "bloodrager"),
        (key: "bloodrager/mighty-bloodrage", blueprint: "a6cd3eca05ee24840ab159ca47b4cd88", name: "Mighty Bloodrage", summary: "At 20th level, bloodrage gives +4 and 4 temp HP per HD, and you can cast a spell of any level on yourself as you enter it.", guide: "bloodrager#mighty-bloodrage"),
        (key: "bloodrager/tireless-bloodrage", blueprint: "0b183d9b3c96fc44ea5a3c23608923c9", name: "Tireless Bloodrage", summary: "From 17th level, you are no longer fatigued after a bloodrage.", guide: "bloodrager#tireless-bloodrage"),
        (key: "bloodrager/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", guide: "bloodrager"),
    ],
    selections: [
        (
            key: "bloodrager/bloodline",
            blueprint: "62b33ac8ceb18dd47ad4c8f06849bc01",
            name: "Bloodline",
            summary: "The bloodline gives your bloodrage powers, bonus spells from 7th level and bonus feats from 6th level.",
            guide: "character-creation#bloodlines",
            option_levels: ["bloodrager"],
            options: [
                (
                    key: "bloodrager/bloodline/abyssal",
                    blueprint: "55d5bbf4b5ae1744ab26c71be98067f9",
                    name: "Abyssal",
                    summary: "Demonic bloodline: claws, size increase in rage at 4th, resistances at 8th, stronger rage at 12th, a fire aura at 16th.",
                    guide: "bloodrager#abyssal-bloodrager",
                    levels: [
                        (level: 1, features: ["bloodrager/bloodline/abyssal/claws"], feat_list: "bloodrager/bloodline/abyssal/feats"),
                        (level: 4, features: ["bloodrager/bloodline/abyssal/demonic-bulk"]),
                        (level: 8, features: ["bloodrager/bloodline/abyssal/demon-resistances"]),
                        (level: 12, features: ["bloodrager/bloodline/abyssal/abyssal-bloodrage"]),
                        (level: 16, features: ["bloodrager/bloodline/abyssal/demonic-aura", "bloodrager/bloodline/abyssal/demon-resistances"]),
                        (level: 20, features: ["bloodrager/bloodline/abyssal/demonic-immunities"]),
                    ],
                ),
                (
                    key: "bloodrager/bloodline/arcane",
                    blueprint: "aeff0a749e20ffe4b9e2846eae29c386",
                    name: "Arcane",
                    summary: "Arcane bloodline: hampers nearby casters and puts buffs on you when you rage (Blur at 4th, Haste at 8th, Transformation at 16th).",
                    guide: "bloodrager#arcane-bloodrager",
                    levels: [
                        (level: 1, features: ["bloodrager/bloodline/arcane/disruptive-bloodrage"], feat_list: "bloodrager/bloodline/arcane/feats"),
                        (level: 4, features: ["bloodrager/bloodline/arcane/arcane-bloodrage"]),
                        (level: 8, features: ["bloodrager/bloodline/arcane/greater-arcane-bloodrage"]),
                        (level: 12, features: ["bloodrager/bloodline/arcane/casters-scourge"]),
                        (level: 16, features: ["bloodrager/bloodline/arcane/true-arcane-bloodrage"]),
                        (level: 20, features: ["bloodrager/bloodline/arcane/casters-bane"]),
                    ],
                ),
                (
                    key: "bloodrager/bloodline/celestial",
                    blueprint: "05a141717bbce594a8a763c227f4ee2f",
                    name: "Celestial",
                    summary: "Angelic bloodline: good-aligned attacks, acid and cold resistance, a reroll at 8th, wings at 12th, protection from evil at 16th.",
                    guide: "bloodrager#celestial-bloodrager",
                    levels: [
                        (level: 1, features: ["bloodrager/bloodline/celestial/angelic-attacks"], feat_list: "bloodrager/bloodline/celestial/feats"),
                        (level: 4, features: ["bloodrager/bloodline/celestial/celestial-resistances"]),
                        (level: 8, features: ["bloodrager/bloodline/celestial/conviction"]),
                        (level: 12, features: ["bloodrager/bloodline/celestial/wings-of-heaven", "bloodrager/bloodline/celestial/celestial-resistances"]),
                        (level: 16, features: ["bloodrager/bloodline/celestial/angelic-protection"]),
                        (level: 20, features: ["bloodrager/bloodline/celestial/ascension"]),
                    ],
                ),
                (
                    key: "bloodrager/bloodline/draconic-black",
                    blueprint: "3d030a2fed2b5cf45919fc1e40629a9e",
                    name: "Draconic (Black)",
                    summary: "Black dragon (acid): claws, resistance and natural armor at 4th, breath weapon at 8th, wings at 12th, dragon form at 16th.",
                    guide: "bloodrager#draconic-bloodrager",
                    prerequisite: NoOtherOptionOfGroup(BloodragerDraconic),
                    group: BloodragerDraconic,
                    levels: [
