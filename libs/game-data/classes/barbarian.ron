Class(
    key: "barbarian",
    blueprint: "f7d7eb166b3dd594fb330d085df41853",
    name: "Barbarian",
    summary: "Non-lawful Strength and Constitution melee class: full BAB, 8 HP per level, good Fortitude, and Rage for bonuses to attack, damage and Will.",
    guide: "barbarian",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["athletics", "lore-nature", "mobility", "perception", "persuasion"],
    prerequisite: Any([Alignment(NeutralGood), Alignment(ChaoticGood), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
    features: [
        (key: "barbarian/damage-reduction", blueprint: "cffb5cddefab30140ac133699d52a8f8", name: "Damage Reduction", summary: "DR 1/- from 7th level, rising by 1 at 10th, 13th, 16th and 19th.", guide: "barbarian#damage-reduction"),
        (key: "barbarian/danger-sense", blueprint: "fdd591c1fbf1c0b41a359d59756f2888", name: "Danger Sense", summary: "From 3rd level, +1 to Reflex saves and dodge AC against traps, +1 more every 3 levels (max +6 at 18th).", guide: "barbarian#danger-sense"),
        (key: "barbarian/fast-movement", blueprint: "d294a5dddd0120046aae7d4eb6cbc4fc", name: "Fast Movement", summary: "+10 feet speed unless you wear heavy armour or carry a heavy load.", guide: "barbarian#fast-movement"),
        (key: "barbarian/greater-rage", blueprint: "ce49c579fe0bcc647a32c96929fae982", name: "Greater Rage", summary: "From 11th level, the rage bonuses become +3 and rage gives 3 temporary HP per hit die.", guide: "barbarian#greater-rage"),
        (key: "barbarian/improved-uncanny-dodge", blueprint: "485a18c05792521459c7d06c63128c79", name: "Improved Uncanny Dodge", summary: "From 5th level, cannot be flanked; rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "barbarian#improved-uncanny-dodge"),
        (key: "barbarian/indomitable-will", blueprint: "e9ae7276574c170468937b617d993357", name: "Indomitable Will", summary: "From 14th level, +4 more to Will saves against enchantments while raging.", guide: "barbarian#indomitable-will"),
        (key: "barbarian/mighty-rage", blueprint: "06a7e5b60020ad947aed107d82d1f897", name: "Mighty Rage", summary: "At 20th level, the rage bonuses become +4 and rage gives 4 temporary HP per hit die.", guide: "barbarian#mighty-rage"),
        (key: "barbarian/rage", blueprint: "2479395977cfeeb46b482bc3385f4647", name: "Rage", summary: "Rage for 4 + Con modifier rounds a day (+2 per level): +2 attack, melee and thrown damage and Will saves, -2 AC, 2 temp HP per hit die.", guide: "barbarian#rage"),
        (key: "barbarian/tireless-rage", blueprint: "ca9343d75a83a2745a22fa11c383153a", name: "Tireless Rage", summary: "From 17th level, no longer fatigued after raging.", guide: "barbarian#tireless-rage"),
        (key: "barbarian/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "From 2nd level, never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "barbarian#uncanny-dodge"),
    ],
    selections: [
        (
            key: "barbarian/rage-power",
            blueprint: "28710502f46848d48b3f0d6132817c4e",
            name: "Rage Power",
            summary: "From 2nd level, a new ability that works while raging; choosing one totem closes off the other totem lines.",
            guide: "barbarian#rage-power",
            options: [
                (key: "barbarian/rage-power/animal-fury", blueprint: "25954b1652bebc2409f9cb9d5728bceb", name: "Animal Fury", summary: "Bite attack at full BAB -5 for 1d4 + half the Strength modifier.", guide: "barbarian#animal-fury"),
                (key: "barbarian/rage-power/beast-totem", blueprint: "c085888db293f2741b881cc989a2ab14", name: "Beast Totem", summary: "+1 natural armour, +1 more per 4 levels.", guide: "barbarian#beast-totem", prerequisite: All([Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser")), Any([ClassLevel(class: "barbarian", level: 6), ClassLevel(class: "skald", level: 6)]), SelectionOption("barbarian/rage-power/beast-totem-lesser")])),
                (key: "barbarian/rage-power/beast-totem-greater", blueprint: "602d2684add008b4ba748af95c3f8b2e", name: "Beast Totem, Greater", summary: "Pounce (full attack after a charge); claws deal 1d8 with a x3 critical multiplier.", guide: "barbarian#beast-totem-greater", prerequisite: All([Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser")), Any([ClassLevel(class: "barbarian", level: 10), ClassLevel(class: "skald", level: 10)]), SelectionOption("barbarian/rage-power/beast-totem")])),
                (key: "barbarian/rage-power/beast-totem-lesser", blueprint: "d99dfc9238a8a6646b32be09057c1729", name: "Beast Totem, Lesser", summary: "Two claw attacks at full attack bonus, 1d6 + Strength modifier each.", guide: "barbarian#beast-totem-lesser", prerequisite: All([Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/celestial-totem", blueprint: "5156331dc888e9347ae6fc81ad3f3cec", name: "Celestial Totem", summary: "Creates an invisibility purge around you that affects only non-good creatures.", guide: "barbarian#celestial-totem", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/celestial-totem-greater", blueprint: "774f79845d1683a43aa42ebd2a549497", name: "Celestial Totem, Greater", summary: "Spell resistance 11 + class level against evil spells, and +2 on saves against evil creatures' spells and spell-like abilities.", guide: "barbarian#celestial-totem-greater", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/celestial-totem-lesser", blueprint: "aba61e0b0e66bf3439cc247ee89fddae", name: "Celestial Totem, Lesser", summary: "Healing effects heal 1 more HP per character level.", guide: "barbarian#celestial-totem-lesser", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/clear-mind", blueprint: "4a236ae23d5a4f76b3616ddfa337e724", name: "Clear Mind", summary: "Once per rage, rerolls the first failed Will save and keeps the better roll.", guide: "barbarian#clear-mind", prerequisite: Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)])),
                (key: "barbarian/rage-power/come-and-get-me", blueprint: "032402bde3fb47e39e6ebb6724ae9c22", name: "Come and Get Me", summary: "Free action: accept -4 AC in return for an attack of opportunity against every enemy that attacks you.", guide: "barbarian#come-and-get-me"),
                (key: "barbarian/rage-power/crippling-blows", blueprint: "0eec6efbb7f66e148817c9f51b804f08", name: "Crippling Blows", summary: "In Powerful Stance, the first melee hit each round gives -1 to attack and Fortitude for 1 round, worsening by 1 (and +1 round) at 12th, 16th and 20th.", guide: "barbarian#crippling-blows", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)]), SelectionOption("barbarian/rage-power/powerful-stance")])),
                (key: "barbarian/rage-power/daemon-totem", blueprint: "d673c30720e8e7c4bb0903dc3c9ab649", name: "Daemon Totem", summary: "Critical hits give the target a negative level.", guide: "barbarian#daemon-totem", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/daemon-totem-greater", blueprint: "9a2f0ffe517d221459640a4ad85710d7", name: "Daemon Totem, Greater", summary: "You heal 5 HP on killing a living creature whose CR equals half your character level.", guide: "barbarian#daemon-totem-greater", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/daemon-totem-lesser", blueprint: "45102fd7aab96f94d81ec80768549e12", name: "Daemon Totem, Lesser", summary: "+2 on saves vs acid, death effects, disease and poison; +1 more with Daemon Totem and +2 more with Daemon Totem, Greater.", guide: "barbarian#daemon-totem-lesser", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/deadly-accuracy", blueprint: "c841ffa13d39ce442a408f57feb3cb8e", name: "Deadly Accuracy", summary: "In Lethal Stance, critical confirmation rolls get double the stance's attack bonus.", guide: "barbarian#deadly-accuracy", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 4), ClassLevel(class: "skald", level: 4)]), SelectionOption("barbarian/rage-power/lethal-stance")])),
                (key: "barbarian/rage-power/deflect-arrows-instinctual-warrior", blueprint: "d971bbb15f354621ac37fd51d0ab9044", name: "Deflect Arrows (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([Feat("improved-unarmed-strike"), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/diamond-body-instinctual-warrior", blueprint: "39d6ef0cb9794afbb5af3cae7288029d", name: "Diamond Body (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([ClassLevel(class: "barbarian", level: 12), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/diamond-soul-instinctual-warrior", blueprint: "d4c929bffb80464bbe6daf1471088bf8", name: "Diamond Soul (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([ClassLevel(class: "barbarian", level: 16), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/fearless-rage", blueprint: "2f59c85adec695b418a66242f2ba08b8", name: "Fearless Rage", summary: "Immune to shaken and frightened.", guide: "barbarian#fearless-rage", prerequisite: Any([ClassLevel(class: "barbarian", level: 12), ClassLevel(class: "skald", level: 12)])),
                (key: "barbarian/rage-power/fiend-totem", blueprint: "ce449404eeb4a7c499fbe0248056174f", name: "Fiend Totem", summary: "Enemies hitting you with melee, unarmed or natural attacks take 1d6 piercing damage.", guide: "barbarian#fiend-totem", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser"))])),
                (key: "barbarian/rage-power/fiend-totem-greater", blueprint: "1105632657d94d940a43707a3a57b006", name: "Fiend Totem, Greater", summary: "Adjacent good creatures are shaken and take 2d6 slashing each turn; neutral ones are only shaken and evil ones unaffected.", guide: "barbarian#fiend-totem-greater", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser"))])),
                (key: "barbarian/rage-power/fiend-totem-lesser", blueprint: "76437492f801f054ba536473ad2fde79", name: "Fiend Totem, Lesser", summary: "A 1d8 gore attack, secondary when fighting with weapons.", guide: "barbarian#fiend-totem-lesser", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser"))])),
                (key: "barbarian/rage-power/guarded-stance", blueprint: "efb97e482f53f064dab85a9eeaf01085", name: "Guarded Stance", summary: "+1 dodge bonus to AC, +1 more per 4 levels.", guide: "barbarian#guarded-stance"),
                (key: "barbarian/rage-power/increased-damage-reduction", blueprint: "ddaee203ee4dcb24c880d633fbd77db6", name: "Increased Damage Reduction", summary: "DR/- increases by 2; can be taken up to three times.", guide: "barbarian#increased-damage-reduction", repeat: Times(3), prerequisite: Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)])),
                (key: "barbarian/rage-power/inspire-ferocity", blueprint: "32c4d277007aed74c905779cd04a6fed", name: "Inspire Ferocity", summary: "In Reckless Stance, allies within 30 feet also get its attack bonus and AC penalty.", guide: "barbarian#inspire-ferocity", prerequisite: SelectionOption("barbarian/rage-power/reckless-stance")),
                (key: "barbarian/rage-power/internal-fortitude", blueprint: "c6ceaa9bb284fae4c908658a05aa5f4d", name: "Internal Fortitude", summary: "Immune to sickened and nauseated.", guide: "barbarian#internal-fortitude", prerequisite: Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)])),
                (key: "barbarian/rage-power/lethal-accuracy", blueprint: "bb79cb9706379934c9460e46fe8cd04e", name: "Lethal Accuracy", summary: "In Lethal Stance, the equipped weapon's critical multiplier increases by 1.", guide: "barbarian#lethal-accuracy", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 16), ClassLevel(class: "skald", level: 16)]), SelectionOption("barbarian/rage-power/deadly-accuracy")])),
                (key: "barbarian/rage-power/lethal-stance", blueprint: "e4450dd9c06dc034fb7c0c08abcc202b", name: "Lethal Stance", summary: "+1 competence bonus to attack rolls, +1 more per 4 levels.", guide: "barbarian#lethal-stance"),
                (key: "barbarian/rage-power/perfect-self-instinctual-warrior", blueprint: "07777880a89d434c896660e4a521df92", name: "Perfect Self (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([ClassLevel(class: "barbarian", level: 20), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/powerful-stance", blueprint: "bc64d8f695f6d6448b3863d253353e7f", name: "Powerful Stance", summary: "+1 to melee and thrown weapon damage, +1 more per 4 class levels.", guide: "barbarian#powerful-stance"),
                (key: "barbarian/rage-power/protect-vitals", blueprint: "efd53fe2887c3a54d86b99f4bba61dd6", name: "Protect Vitals", summary: "In Guarded Stance, +4 more dodge AC against critical confirmation rolls.", guide: "barbarian#protect-vitals", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)]), SelectionOption("barbarian/rage-power/guarded-stance")])),
                (key: "barbarian/rage-power/purity-of-body-instinctual-warrior", blueprint: "a4418aa778cb4ebd965d78af19becced", name: "Purity of Body (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([ClassLevel(class: "barbarian", level: 8), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/reckless-stance", blueprint: "cb502c65dab407b4e928f5d8355cafc9", name: "Reckless Stance", summary: "+1 to attack and -1 AC, both growing by 1 per 4 class levels.", guide: "barbarian#reckless-stance"),
                (key: "barbarian/rage-power/reflexive-dodge", blueprint: "6a9319f42f742024680af38af54f5d6f", name: "Reflexive Dodge", summary: "In Guarded Stance, its dodge bonus also applies to Reflex saves.", guide: "barbarian#reflexive-dodge", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 6), ClassLevel(class: "skald", level: 6)]), SelectionOption("barbarian/rage-power/guarded-stance")])),
                (key: "barbarian/rage-power/renewed-vigor", blueprint: "aad496a7c9bee224cbd01a3cf8e42061", name: "Renewed Vigor", summary: "Once a day, a standard action heals 1d8 + Con modifier, +1d8 per 4 levels after 4th (5d8 at 20th).", guide: "barbarian#renewed-vigor", prerequisite: Any([ClassLevel(class: "barbarian", level: 4), ClassLevel(class: "skald", level: 4)])),
                (key: "barbarian/rage-power/rolling-dodge", blueprint: "abfaa9ad598093f45ac6ac1db58f9a40", name: "Rolling Dodge", summary: "In Guarded Stance, its dodge AC bonus doubles against ranged attacks.", guide: "barbarian#rolling-dodge", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 6), ClassLevel(class: "skald", level: 6)]), SelectionOption("barbarian/rage-power/guarded-stance")])),
                (key: "barbarian/rage-power/scent", blueprint: "6e5d57a733d1eea46a9022a304f2c728", name: "Scent", summary: "Senses enemies within 30 feet, working like blindsense.", guide: "barbarian#scent"),
                (key: "barbarian/rage-power/swift-foot", blueprint: "7df32d4e9bd2cdc48b0f69b03a57754a", name: "Swift Foot", summary: "+10 feet speed; can be taken up to three times.", guide: "barbarian#swift-foot", repeat: Times(3)),
                (key: "barbarian/rage-power/wrecking-blows", blueprint: "5bccc86dd1f187a4a99f092dc054c755", name: "Wrecking Blows", summary: "In Powerful Stance, melee and thrown attacks add the Con modifier to damage (+1 at 16th and 20th); bypasses DR, not multiplied on crits.", guide: "barbarian#wrecking-blows", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 12), ClassLevel(class: "skald", level: 12)]), SelectionOption("barbarian/rage-power/powerful-stance")])),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["barbarian/fast-movement", "barbarian/rage"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, features: ["barbarian/uncanny-dodge"], selections: ["barbarian/rage-power"]),
        (level: 3, features: ["barbarian/danger-sense"]),
        (level: 4, selections: ["barbarian/rage-power"]),
        (level: 5, features: ["barbarian/improved-uncanny-dodge"]),
        (level: 6, features: ["barbarian/danger-sense"], selections: ["barbarian/rage-power"]),
        (level: 7, features: ["barbarian/damage-reduction"]),
        (level: 8, selections: ["barbarian/rage-power"]),
        (level: 9, features: ["barbarian/danger-sense"]),
        (level: 10, features: ["barbarian/damage-reduction"], selections: ["barbarian/rage-power"]),
        (level: 11, features: ["barbarian/greater-rage"]),
