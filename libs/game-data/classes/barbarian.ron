                (key: "barbarian/armored-hulk/resilience-of-steel", blueprint: "ac8f1fcec10a9584c9e40a5cd8100830", name: "Resilience of Steel", summary: "In heavy armour, +1 AC against critical confirmation rolls, +1 more every 3 levels (+6 at 18th).", guide: "barbarian#resilience-of-steel"),
