            name: "Flesheater",
            summary: "Lord of Nothing barbarian who eats supernatural foes for Essence and powers; fewer rage powers, no Uncanny Dodge, DR or Danger Sense.",
            guide: "barbarian#flesheater",
            features: [
                (key: "barbarian/flesheater/changeable-form", blueprint: "c5a84c4f60364c5e827222c46fc173f5", name: "Changeable Form", summary: "From 7th level, Devour Flesh also gives a major trait usable outside rage, and you can store up to 2 Essence.", guide: "barbarian#changeable-form"),
                (key: "barbarian/flesheater/crush-and-tear", blueprint: "68684e91025d4ebf892e8c0469d14b03", name: "Crush and Tear", summary: "Secondary bite of 1d4 + half Strength, rising to 1d6 (silver and cold iron) at 5th, 1d8 + 1d6 bleed at 11th and 1d10 at 17th.", guide: "barbarian#crush-and-tear"),
                (key: "barbarian/flesheater/devour-essence", blueprint: "492abe84bb2c4e4ebf5fbc83f054ef78", name: "Devour Essence", summary: "From 2nd level, spends stored Essence to heal 1d8 + Con modifier, +1d8 at 8th, 13th and 18th level (max 4d8).", guide: "barbarian#devour-essence"),
                (key: "barbarian/flesheater/power-from-flesh", blueprint: "c53ac2508a4a4f29a22c22b108135200", name: "Power from Flesh", summary: "Must eat dragons, fey, magical beasts, outsiders or undead: +2 attack and damage vs them while raging, -2 Int and a confusion risk until fed.", guide: "barbarian#power-from-flesh"),
                (key: "barbarian/flesheater/unbound-form", blueprint: "43ed2747b3fd44d19a484021476626c9", name: "Unbound Form", summary: "At 20th level, Unbound Rage grows two size categories with +12 Strength, and up to 4 Essence can be stored.", guide: "barbarian#unbound-form"),
                (key: "barbarian/flesheater/unbound-rage", blueprint: "7d32284690484e9b9a536c05b250d09e", name: "Unbound Rage", summary: "From 11th level, grows as Enlarge Person when raging, with +4 Strength and -2 Int, if the last creature eaten was larger.", guide: "barbarian#unbound-rage"),
                (key: "barbarian/flesheater/you-are-what-you-eat", blueprint: "67c9f0fa694b475b8332e17d0c1fb6d1", name: "You Are What You Eat", summary: "From 14th level, eaten creatures grant a standard-action ability costing 2 Essence, and up to 3 Essence can be stored.", guide: "barbarian#you-are-what-you-eat"),
