            features: [
                (key: "barbarian/pack-rager/raging-tactician", name: "Raging Tactician", summary: "From 7th level, entering rage gives allies within 50 feet one of your teamwork feats, two at 13th and three at 19th.", guide: "barbarian#raging-tactician"),
