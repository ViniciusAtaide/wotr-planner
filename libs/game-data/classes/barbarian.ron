                (level: 16, features: ["barbarian/instinctual-warrior/cunning-elusion"], selections: ["barbarian/rage-power"]),
                (level: 17, features: ["barbarian/instinctual-warrior/tireless-focused-rage"]),
                (level: 18, features: ["barbarian/instinctual-warrior/unparalled-senses"], selections: ["barbarian/rage-power"]),
                (level: 19),
                (level: 20, features: ["barbarian/instinctual-warrior/cunning-elusion", "barbarian/instinctual-warrior/mighty-focused-rage-instinctual-warrior"], selections: ["barbarian/rage-power"]),
            ],
        ),
        (
            key: "barbarian/invulnerable-rager",
            name: "Invulnerable Rager",
            summary: "Barbarian who trades Uncanny Dodge and Danger Sense for more Damage Reduction.",
            guide: "barbarian#invulnerable-rager",
            features: [
                (key: "barbarian/invulnerable-rager/extreme-endurance", name: "Extreme Endurance", summary: "From 3rd level, fire and cold resistance 1, +1 every 3 levels (max 6 at 18th).", guide: "barbarian#extreme-endurance"),
                (key: "barbarian/invulnerable-rager/damage-reduction-invulnerable-rager", name: "Damage Reduction (Invulnerable Rager)", summary: "DR 1/- at 2nd level, rising by 1 at every even level after that, to 10/- at 20th.", guide: "barbarian#invulnerable-rager"),
