                (level: 9, features: ["barbarian/flesheater/power-from-flesh"]),
                (level: 10, selections: ["barbarian/rage-power"]),
                (level: 11, features: ["barbarian/flesheater/unbound-rage", "barbarian/flesheater/crush-and-tear"]),
                (level: 13, features: ["barbarian/flesheater/devour-essence"]),
                (level: 14, features: ["barbarian/flesheater/you-are-what-you-eat", "barbarian/indomitable-will"]),
                (level: 16, selections: ["barbarian/rage-power"]),
                (level: 17, features: ["barbarian/tireless-rage", "barbarian/flesheater/crush-and-tear"]),
                (level: 18, features: ["barbarian/flesheater/devour-essence", "barbarian/flesheater/power-from-flesh"], selections: ["barbarian/rage-power"]),
                (level: 19),
                (level: 20, features: ["barbarian/flesheater/unbound-form"], selections: ["barbarian/rage-power"]),
            ],
        ),
        (
            key: "barbarian/instinctual-warrior",
            name: "Instinctual Warrior",
            summary: "Monk-like barbarian who adds Wisdom to AC and rages on Wisdom, with fewer rage powers and no Damage Reduction.",
            guide: "barbarian#instinctual-warrior",
            features: [
                (key: "barbarian/instinctual-warrior/cunning-elusion", name: "Cunning Elusion", summary: "Unarmoured and without a shield, adds Wisdom bonus to AC and CMD, +1 more at 4th level and every 4 levels (max +5).", guide: "barbarian#cunning-elusion"),
                (key: "barbarian/instinctual-warrior/fervent-reflexes", name: "Fervent Reflexes", summary: "Adds the Wisdom modifier to initiative.", guide: "barbarian#fervent-reflexes"),
                (key: "barbarian/instinctual-warrior/focused-rage", name: "Focused Rage", summary: "Rage for 4 + Wisdom modifier rounds a day (+2 per level), giving +2 to attack and Wisdom and 2 temporary HP per hit die.", guide: "barbarian#focused-rage"),
                (key: "barbarian/instinctual-warrior/greater-focused-rage-instinctual-warrior", name: "Greater Focused Rage (Instinctual Warrior)", summary: "From 11th level, Focused Rage gives +3 to attack and Wisdom and 3 temporary HP per hit die.", guide: "barbarian#greater-focused-rage-instinctual-warrior"),
                (key: "barbarian/instinctual-warrior/mighty-focused-rage-instinctual-warrior", name: "Mighty Focused Rage (Instinctual Warrior)", summary: "At 20th level, Focused Rage gives +4 to attack and Wisdom and 4 temporary HP per hit die.", guide: "barbarian#mighty-focused-rage-instinctual-warrior"),
                (key: "barbarian/instinctual-warrior/tireless-focused-rage", name: "Tireless Focused Rage", guide: "barbarian#instinctual-warrior"),
                (key: "barbarian/instinctual-warrior/unparalled-senses", name: "Unparalled Senses", summary: "At 18th level, blindsense 30 feet and blindsight 15 feet.", guide: "barbarian#instinctual-warrior"),
            ],
            levels: [
                (level: 1, features: ["barbarian/fast-movement", "barbarian/instinctual-warrior/fervent-reflexes", "barbarian/instinctual-warrior/focused-rage"], feats: ["martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
