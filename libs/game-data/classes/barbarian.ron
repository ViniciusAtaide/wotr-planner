            key: "barbarian/mad-dog",
            name: "Mad Dog",
            summary: "Barbarian with an animal companion; Rage and DR come later, no Uncanny Dodge, fewer rage powers.",
            guide: "barbarian#mad-dog",
            features: [
                (key: "barbarian/mad-dog/animal-companion", name: "Animal Companion", summary: "Gains an animal companion that learns Trip at 4th level and Bull Rush at 13th.", guide: "barbarian#mad-dog"),
                (key: "barbarian/mad-dog/ferocious-fetch", name: "Ferocious Fetch", summary: "At 5th level, your companion learns Greater Trip for free.", guide: "barbarian#ferocious-fetch"),
                (key: "barbarian/mad-dog/pack-tactics", name: "Pack Tactics", summary: "From 2nd level, you and your companion get +4 to attack when flanking the same opponent.", guide: "barbarian#pack-tactics"),
                (key: "barbarian/mad-dog/throat-cutter", name: "Throat Cutter", summary: "When the companion bull rushes, overruns or trips a foe it threatens, it gets an attack of opportunity against it.", guide: "barbarian#throat-cutter"),
