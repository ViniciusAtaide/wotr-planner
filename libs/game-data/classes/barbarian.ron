Class(
    key: "barbarian",
    name: "Barbarian",
    summary: "Non-lawful Strength and Constitution melee class: full BAB, 8 HP per level, good Fortitude, and Rage for bonuses to attack, damage and Will.",
    guide: "barbarian",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["athletics", "lore-nature", "mobility", "perception", "persuasion"],
    prerequisite: Any([Alignment(NeutralGood), Alignment(ChaoticGood), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
    features: [
        (key: "barbarian/damage-reduction", name: "Damage Reduction", summary: "DR 1/- from 7th level, rising by 1 at 10th, 13th, 16th and 19th.", guide: "barbarian#damage-reduction"),
        (key: "barbarian/danger-sense", name: "Danger Sense", summary: "From 3rd level, +1 to Reflex saves and dodge AC against traps, +1 more every 3 levels (max +6 at 18th).", guide: "barbarian#danger-sense"),
        (key: "barbarian/fast-movement", name: "Fast Movement", summary: "+10 feet speed unless you wear heavy armour or carry a heavy load.", guide: "barbarian#fast-movement"),
        (key: "barbarian/greater-rage", name: "Greater Rage", summary: "From 11th level, the rage bonuses become +3 and rage gives 3 temporary HP per hit die.", guide: "barbarian#greater-rage"),
        (key: "barbarian/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "From 5th level, cannot be flanked; rogues need 4 more rogue levels than your class level to sneak attack you.", guide: "barbarian#improved-uncanny-dodge"),
        (key: "barbarian/indomitable-will", name: "Indomitable Will", summary: "From 14th level, +4 more to Will saves against enchantments while raging.", guide: "barbarian#indomitable-will"),
        (key: "barbarian/mighty-rage", name: "Mighty Rage", summary: "At 20th level, the rage bonuses become +4 and rage gives 4 temporary HP per hit die.", guide: "barbarian#mighty-rage"),
        (key: "barbarian/rage", name: "Rage", summary: "Rage for 4 + Con modifier rounds a day (+2 per level): +2 attack, melee and thrown damage and Will saves, -2 AC, 2 temp HP per hit die.", guide: "barbarian#rage"),
        (key: "barbarian/tireless-rage", name: "Tireless Rage", summary: "From 17th level, no longer fatigued after raging.", guide: "barbarian#tireless-rage"),
        (key: "barbarian/uncanny-dodge", name: "Uncanny Dodge", summary: "From 2nd level, never caught flat-footed and keeps the Dexterity bonus to AC against invisible attackers.", guide: "barbarian#uncanny-dodge"),
    ],
    selections: [
        (
            key: "barbarian/rage-power",
            name: "Rage Power",
            summary: "From 2nd level, a new ability that works while raging; choosing one totem closes off the other totem lines.",
            guide: "barbarian#rage-power",
            option_levels: ["skald"],
            options: [
                (key: "barbarian/rage-power/animal-fury", name: "Animal Fury", summary: "Bite attack at full BAB -5 for 1d4 + half the Strength modifier.", guide: "barbarian#animal-fury"),
                (key: "barbarian/rage-power/beast-totem", name: "Beast Totem", summary: "+1 natural armour, +1 more per 4 levels.", guide: "barbarian#beast-totem", prerequisite: All([Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser")), Any([ClassLevel(class: "barbarian", level: 6), ClassLevel(class: "skald", level: 6)]), SelectionOption("barbarian/rage-power/beast-totem-lesser")])),
                (key: "barbarian/rage-power/beast-totem-greater", name: "Beast Totem, Greater", summary: "Pounce (full attack after a charge); claws deal 1d8 with a x3 critical multiplier.", guide: "barbarian#beast-totem-greater", prerequisite: All([Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser")), Any([ClassLevel(class: "barbarian", level: 10), ClassLevel(class: "skald", level: 10)]), SelectionOption("barbarian/rage-power/beast-totem")])),
                (key: "barbarian/rage-power/beast-totem-lesser", name: "Beast Totem, Lesser", summary: "Two claw attacks at full attack bonus, 1d6 + Strength modifier each.", guide: "barbarian#beast-totem-lesser", prerequisite: All([Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/celestial-totem", name: "Celestial Totem", summary: "Creates an invisibility purge around you that affects only non-good creatures.", guide: "barbarian#celestial-totem", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/celestial-totem-greater", name: "Celestial Totem, Greater", summary: "Spell resistance 11 + class level against evil spells, and +2 on saves against evil creatures' spells and spell-like abilities.", guide: "barbarian#celestial-totem-greater", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/celestial-totem-lesser", name: "Celestial Totem, Lesser", summary: "Healing effects heal 1 more HP per character level.", guide: "barbarian#celestial-totem-lesser", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/clear-mind", name: "Clear Mind", summary: "Once per rage, rerolls the first failed Will save and keeps the better roll.", guide: "barbarian#clear-mind", prerequisite: Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)])),
                (key: "barbarian/rage-power/come-and-get-me", name: "Come and Get Me", summary: "Free action: accept -4 AC in return for an attack of opportunity against every enemy that attacks you.", guide: "barbarian#come-and-get-me"),
                (key: "barbarian/rage-power/crippling-blows", name: "Crippling Blows", summary: "In Powerful Stance, the first melee hit each round gives -1 to attack and Fortitude for 1 round, worsening by 1 (and +1 round) at 12th, 16th and 20th.", guide: "barbarian#crippling-blows", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)]), SelectionOption("barbarian/rage-power/powerful-stance")])),
                (key: "barbarian/rage-power/daemon-totem", name: "Daemon Totem", summary: "Critical hits give the target a negative level.", guide: "barbarian#daemon-totem", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/daemon-totem-greater", name: "Daemon Totem, Greater", summary: "You heal 5 HP on killing a living creature whose CR equals half your character level.", guide: "barbarian#daemon-totem-greater", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/daemon-totem-lesser", name: "Daemon Totem, Lesser", summary: "+2 on saves vs acid, death effects, disease and poison; +1 more with Daemon Totem and +2 more with Daemon Totem, Greater.", guide: "barbarian#daemon-totem-lesser", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/fiend-totem")), Not(SelectionOption("barbarian/rage-power/fiend-totem-greater")), Not(SelectionOption("barbarian/rage-power/fiend-totem-lesser"))])),
                (key: "barbarian/rage-power/deadly-accuracy", name: "Deadly Accuracy", summary: "In Lethal Stance, critical confirmation rolls get double the stance's attack bonus.", guide: "barbarian#deadly-accuracy", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 4), ClassLevel(class: "skald", level: 4)]), SelectionOption("barbarian/rage-power/lethal-stance")])),
                (key: "barbarian/rage-power/deflect-arrows-instinctual-warrior", name: "Deflect Arrows (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([Feat("improved-unarmed-strike"), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/diamond-body-instinctual-warrior", name: "Diamond Body (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([ClassLevel(class: "barbarian", level: 12), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/diamond-soul-instinctual-warrior", name: "Diamond Soul (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([ClassLevel(class: "barbarian", level: 16), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/fearless-rage", name: "Fearless Rage", summary: "Immune to shaken and frightened.", guide: "barbarian#fearless-rage", prerequisite: Any([ClassLevel(class: "barbarian", level: 12), ClassLevel(class: "skald", level: 12)])),
                (key: "barbarian/rage-power/fiend-totem", name: "Fiend Totem", summary: "Enemies hitting you with melee, unarmed or natural attacks take 1d6 piercing damage.", guide: "barbarian#fiend-totem", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser"))])),
                (key: "barbarian/rage-power/fiend-totem-greater", name: "Fiend Totem, Greater", summary: "Adjacent good creatures are shaken and take 2d6 slashing each turn; neutral ones are only shaken and evil ones unaffected.", guide: "barbarian#fiend-totem-greater", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser"))])),
                (key: "barbarian/rage-power/fiend-totem-lesser", name: "Fiend Totem, Lesser", summary: "A 1d8 gore attack, secondary when fighting with weapons.", guide: "barbarian#fiend-totem-lesser", prerequisite: All([Not(SelectionOption("barbarian/rage-power/beast-totem")), Not(SelectionOption("barbarian/rage-power/beast-totem-greater")), Not(SelectionOption("barbarian/rage-power/beast-totem-lesser")), Not(SelectionOption("barbarian/rage-power/celestial-totem")), Not(SelectionOption("barbarian/rage-power/celestial-totem-greater")), Not(SelectionOption("barbarian/rage-power/celestial-totem-lesser")), Not(SelectionOption("barbarian/rage-power/daemon-totem")), Not(SelectionOption("barbarian/rage-power/daemon-totem-greater")), Not(SelectionOption("barbarian/rage-power/daemon-totem-lesser"))])),
                (key: "barbarian/rage-power/guarded-stance", name: "Guarded Stance", summary: "+1 dodge bonus to AC, +1 more per 4 levels.", guide: "barbarian#guarded-stance"),
                (key: "barbarian/rage-power/increased-damage-reduction", name: "Increased Damage Reduction", summary: "DR/- increases by 2; can be taken up to three times.", guide: "barbarian#increased-damage-reduction", repeat: Times(3), prerequisite: Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)])),
                (key: "barbarian/rage-power/inspire-ferocity", name: "Inspire Ferocity", summary: "In Reckless Stance, allies within 30 feet also get its attack bonus and AC penalty.", guide: "barbarian#inspire-ferocity", prerequisite: SelectionOption("barbarian/rage-power/reckless-stance")),
                (key: "barbarian/rage-power/internal-fortitude", name: "Internal Fortitude", summary: "Immune to sickened and nauseated.", guide: "barbarian#internal-fortitude", prerequisite: Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)])),
                (key: "barbarian/rage-power/lethal-accuracy", name: "Lethal Accuracy", summary: "In Lethal Stance, the equipped weapon's critical multiplier increases by 1.", guide: "barbarian#lethal-accuracy", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 16), ClassLevel(class: "skald", level: 16)]), SelectionOption("barbarian/rage-power/deadly-accuracy")])),
                (key: "barbarian/rage-power/lethal-stance", name: "Lethal Stance", summary: "+1 competence bonus to attack rolls, +1 more per 4 levels.", guide: "barbarian#lethal-stance"),
                (key: "barbarian/rage-power/perfect-self-instinctual-warrior", name: "Perfect Self (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([ClassLevel(class: "barbarian", level: 20), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/powerful-stance", name: "Powerful Stance", summary: "+1 to melee and thrown weapon damage, +1 more per 4 class levels.", guide: "barbarian#powerful-stance"),
                (key: "barbarian/rage-power/protect-vitals", name: "Protect Vitals", summary: "In Guarded Stance, +4 more dodge AC against critical confirmation rolls.", guide: "barbarian#protect-vitals", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 8), ClassLevel(class: "skald", level: 8)]), SelectionOption("barbarian/rage-power/guarded-stance")])),
                (key: "barbarian/rage-power/purity-of-body-instinctual-warrior", name: "Purity of Body (Instinctual Warrior)", guide: "barbarian#rage-power-instinctual-warrior", prerequisite: All([ClassLevel(class: "barbarian", level: 8), Archetype("barbarian/instinctual-warrior")])),
                (key: "barbarian/rage-power/reckless-stance", name: "Reckless Stance", summary: "+1 to attack and -1 AC, both growing by 1 per 4 class levels.", guide: "barbarian#reckless-stance"),
                (key: "barbarian/rage-power/reflexive-dodge", name: "Reflexive Dodge", summary: "In Guarded Stance, its dodge bonus also applies to Reflex saves.", guide: "barbarian#reflexive-dodge", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 6), ClassLevel(class: "skald", level: 6)]), SelectionOption("barbarian/rage-power/guarded-stance")])),
                (key: "barbarian/rage-power/renewed-vigor", name: "Renewed Vigor", summary: "Once a day, a standard action heals 1d8 + Con modifier, +1d8 per 4 levels after 4th (5d8 at 20th).", guide: "barbarian#renewed-vigor", prerequisite: Any([ClassLevel(class: "barbarian", level: 4), ClassLevel(class: "skald", level: 4)])),
                (key: "barbarian/rage-power/rolling-dodge", name: "Rolling Dodge", summary: "In Guarded Stance, its dodge AC bonus doubles against ranged attacks.", guide: "barbarian#rolling-dodge", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 6), ClassLevel(class: "skald", level: 6)]), SelectionOption("barbarian/rage-power/guarded-stance")])),
                (key: "barbarian/rage-power/scent", name: "Scent", summary: "Senses enemies within 30 feet, working like blindsense.", guide: "barbarian#scent"),
                (key: "barbarian/rage-power/swift-foot", name: "Swift Foot", summary: "+10 feet speed; can be taken up to three times.", guide: "barbarian#swift-foot", repeat: Times(3)),
                (key: "barbarian/rage-power/wrecking-blows", name: "Wrecking Blows", summary: "In Powerful Stance, melee and thrown attacks add the Con modifier to damage (+1 at 16th and 20th); bypasses DR, not multiplied on crits.", guide: "barbarian#wrecking-blows", prerequisite: All([Any([ClassLevel(class: "barbarian", level: 12), ClassLevel(class: "skald", level: 12)]), SelectionOption("barbarian/rage-power/powerful-stance")])),
                (
                    key: "barbarian/rage-power/teamwork-feat",
                    name: "Teamwork Feat",
                    summary: "A Battle Scion's teamwork feat in place of a rage power, added to Inspired Rage for 3 rounds of song.",
                    guide: "skald#battle-prowess",
                    prerequisite: Archetype("skald/battle-scion"),
                    repeat: Unlimited,
                    levels: [
                        (level: 1, feat_slots: [Category(Teamwork)]),
                    ],
                ),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["barbarian/fast-movement", "barbarian/rage"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, features: ["barbarian/uncanny-dodge"], selections: ["barbarian/rage-power"]),
        (level: 3, features: ["barbarian/danger-sense"]),
        (level: 4, selections: ["barbarian/rage-power"]),
        (level: 5, features: ["barbarian/improved-uncanny-dodge"]),
        (level: 6, selections: ["barbarian/rage-power"]),
        (level: 7, features: ["barbarian/damage-reduction"]),
        (level: 8, selections: ["barbarian/rage-power"]),
        (level: 9),
        (level: 10, features: ["barbarian/damage-reduction"], selections: ["barbarian/rage-power"]),
        (level: 11, features: ["barbarian/greater-rage"]),
        (level: 12, selections: ["barbarian/rage-power"]),
        (level: 13, features: ["barbarian/damage-reduction"]),
        (level: 14, features: ["barbarian/indomitable-will"], selections: ["barbarian/rage-power"]),
        (level: 15),
        (level: 16, features: ["barbarian/damage-reduction"], selections: ["barbarian/rage-power"]),
        (level: 17, features: ["barbarian/tireless-rage"]),
        (level: 18, selections: ["barbarian/rage-power"]),
        (level: 19, features: ["barbarian/damage-reduction"]),
        (level: 20, features: ["barbarian/mighty-rage"], selections: ["barbarian/rage-power"]),
    ],
    archetypes: [
        (
            key: "barbarian/armored-hulk",
            name: "Armored Hulk",
            summary: "Barbarian who gains heavy armour proficiency and moves faster in armour, losing Uncanny Dodge and Danger Sense.",
            guide: "barbarian#armored-hulk",
            features: [
                (key: "barbarian/armored-hulk/armored-swiftness", name: "Armored Swiftness", summary: "From 2nd level, moves 5 feet faster in medium and heavy armour.", guide: "barbarian#armored-swiftness"),
                (key: "barbarian/armored-hulk/improved-armored-swiftness", name: "Improved Armored Swiftness", summary: "From 5th level, moves 10 feet faster in medium and heavy armour.", guide: "barbarian#improved-armored-swiftness"),
                (key: "barbarian/armored-hulk/indomitable-stance", name: "Indomitable Stance", summary: "+1 to combat manoeuvre checks, CMD and Reflex against trample, and +1 AC, attack and damage against charging creatures.", guide: "barbarian#indomitable-stance"),
                (key: "barbarian/armored-hulk/resilience-of-steel", name: "Resilience of Steel", summary: "In heavy armour, +1 AC against critical confirmation rolls, +1 more every 3 levels (+6 at 18th).", guide: "barbarian#resilience-of-steel"),
            ],
            levels: [
                (level: 1, features: ["barbarian/armored-hulk/indomitable-stance", "barbarian/rage"], feats: ["armor-proficiency-heavy-armor", "armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["barbarian/armored-hulk/armored-swiftness"], selections: ["barbarian/rage-power"]),
                (level: 3, features: ["barbarian/armored-hulk/resilience-of-steel"]),
                (level: 5, features: ["barbarian/armored-hulk/improved-armored-swiftness"]),
                (level: 6, features: ["barbarian/armored-hulk/resilience-of-steel"], selections: ["barbarian/rage-power"]),
                (level: 9, features: ["barbarian/armored-hulk/resilience-of-steel"]),
                (level: 12, features: ["barbarian/armored-hulk/resilience-of-steel"], selections: ["barbarian/rage-power"]),
                (level: 15, features: ["barbarian/armored-hulk/resilience-of-steel"]),
                (level: 18, features: ["barbarian/armored-hulk/resilience-of-steel"], selections: ["barbarian/rage-power"]),
            ],
        ),
        (
            key: "barbarian/beastskin-berserker",
            name: "Beastskin Berserker",
            summary: "Barbarian who turns into a beast while raging, with fewer rage powers.",
            guide: "barbarian#beastskin-berserker",
            features: [
                (key: "barbarian/beastskin-berserker/feral-transformation-i", name: "Feral Transformation I", summary: "From 4th level, can become a medium wolf while raging, as Beast Shape I.", guide: "barbarian#beastskin-berserker"),
                (key: "barbarian/beastskin-berserker/feral-transformation-ii", name: "Feral Transformation II", summary: "From 8th level, can become a medium leopard while raging, as Beast Shape II.", guide: "barbarian#beastskin-berserker"),
                (key: "barbarian/beastskin-berserker/feral-transformation-iii", name: "Feral Transformation III", summary: "From 12th level, can become a large bear while raging, as Beast Shape III.", guide: "barbarian#beastskin-berserker"),
                (key: "barbarian/beastskin-berserker/savage-rapport", name: "Savage Rapport", summary: "Adds half the class level to Lore (Nature) and Intimidate checks.", guide: "barbarian#savage-rapport"),
            ],
            levels: [
                (level: 1, features: ["barbarian/beastskin-berserker/savage-rapport", "barbarian/rage"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 4, features: ["barbarian/beastskin-berserker/feral-transformation-i"]),
                (level: 8, features: ["barbarian/beastskin-berserker/feral-transformation-ii"]),
                (level: 12, features: ["barbarian/beastskin-berserker/feral-transformation-iii"]),
            ],
        ),
        (
            key: "barbarian/flesheater",
            name: "Flesheater",
            summary: "Lord of Nothing barbarian who eats supernatural foes for Essence and powers; fewer rage powers, no Uncanny Dodge, DR or Danger Sense.",
            guide: "barbarian#flesheater",
            features: [
                (key: "barbarian/flesheater/changeable-form", name: "Changeable Form", summary: "From 7th level, Devour Flesh also gives a major trait usable outside rage, and you can store up to 2 Essence.", guide: "barbarian#changeable-form"),
                (key: "barbarian/flesheater/crush-and-tear", name: "Crush and Tear", summary: "Secondary bite of 1d4 + half Strength, rising to 1d6 (silver and cold iron) at 5th, 1d8 + 1d6 bleed at 11th and 1d10 at 17th.", guide: "barbarian#crush-and-tear"),
                (key: "barbarian/flesheater/devour-essence", name: "Devour Essence", summary: "From 2nd level, spends stored Essence to heal 1d8 + Con modifier, +1d8 at 8th, 13th and 18th level (max 4d8).", guide: "barbarian#devour-essence"),
                (key: "barbarian/flesheater/power-from-flesh", name: "Power from Flesh", summary: "Must eat dragons, fey, magical beasts, outsiders or undead: +2 attack and damage vs them while raging, -2 Int and a confusion risk until fed.", guide: "barbarian#power-from-flesh"),
                (key: "barbarian/flesheater/unbound-form", name: "Unbound Form", summary: "At 20th level, Unbound Rage grows two size categories with +12 Strength, and up to 4 Essence can be stored.", guide: "barbarian#unbound-form"),
                (key: "barbarian/flesheater/unbound-rage", name: "Unbound Rage", summary: "From 11th level, grows as Enlarge Person when raging, with +4 Strength and -2 Int, if the last creature eaten was larger.", guide: "barbarian#unbound-rage"),
                (key: "barbarian/flesheater/you-are-what-you-eat", name: "You Are What You Eat", summary: "From 14th level, eaten creatures grant a standard-action ability costing 2 Essence, and up to 3 Essence can be stored.", guide: "barbarian#you-are-what-you-eat"),
            ],
            levels: [
                (level: 1, features: ["barbarian/fast-movement", "barbarian/flesheater/crush-and-tear", "barbarian/rage"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["barbarian/flesheater/devour-essence", "barbarian/flesheater/power-from-flesh"]),
                (level: 3),
                (level: 5, features: ["barbarian/flesheater/crush-and-tear"]),
                (level: 6),
