                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-stiffened-limbs", blueprint: "4a590791161145de8cf8d27cdefb8705", name: "Plague Mutation: Stiffened Limbs", summary: "From 14th level, with Dulled Reactions: victims make no attacks of opportunity and are flat-footed.", guide: "shaman#plague-mutation-stiffened-limbs", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dulled-reactions")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage", blueprint: "ed39cb73232b4473934fe932bd7c0d58", name: "Plague Mutation: Strength Damage", summary: "The plague deals 1d4 Strength damage.", guide: "shaman#plague-mutation-strength-damage"),
