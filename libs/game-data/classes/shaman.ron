        (
            key: "shaman/prophet-of-pestilence",
            blueprint: "bcd758a75fb54651a7f668fe2661a307",
            name: "Prophet of Pestilence",
            summary: "Lord of Nothing DLC disease shaman with the fixed Pestilence spirit, no familiar and fewer hexes; neutral, neutral evil or chaotic evil only.",
            guide: "shaman#prophet-of-pestilence",
            prerequisite: Any([Alignment(TrueNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
            features: [
                (key: "shaman/prophet-of-pestilence/a-thousand-diseases", blueprint: "36052ed3e10f43ccb0a59a9eb2dd4150", name: "A Thousand Diseases", summary: "At 20th level, enemies within 30 feet catch the Plague of Abaddon unless they pass Fortitude; diseased ones get no save.", guide: "shaman#a-thousand-diseases"),
                (key: "shaman/prophet-of-pestilence/fatal-disease", blueprint: "05bd7ec913174efdbfb8800ccf36da27", name: "Fatal Disease", summary: "From 16th level, saves against your disease spells and abilities are rolled twice, taking the worse.", guide: "shaman#fatal-disease"),
                (key: "shaman/prophet-of-pestilence/mutating-spirit", blueprint: "c5b69274980942beaaa4c27fa98d5f0f", name: "Mutating Spirit", summary: "At 4th level, immune to sickened and +4 against disease and nausea; at 12th, immune to nausea, poison and disease, with +2 to your disease DCs.", guide: "shaman#mutating-spirit"),
                (key: "shaman/prophet-of-pestilence/orisons", blueprint: "1c7cc4b02e560f74796842ba31f2acda", name: "Orisons", guide: "shaman#prophet-of-pestilence"),
                (key: "shaman/prophet-of-pestilence/pestilence-spirit", blueprint: "557cd05f067b44e8a916d6324c0c6c42", name: "Pestilence Spirit", summary: "The Prophet of Pestilence's own spirit, open to no one else, with unique disease abilities.", guide: "shaman#pestilence-spirit"),
                (key: "shaman/prophet-of-pestilence/plague-of-abaddon", blueprint: "16b45f3a50454d4cb7b10e76656bd998", name: "Plague of Abaddon", summary: "From 2nd level, infect a creature that fails Fortitude with a plague lasting class level rounds or until it saves.", guide: "shaman#plague-of-abaddon"),
                (key: "shaman/prophet-of-pestilence/plagues-caress", blueprint: "59456a1bad5e44b5b9f524614019cdf3", name: "Plague\'s Caress", summary: "Melee touch sickens the target for half your class level in rounds (disease); 3 + Charisma modifier uses a day.", guide: "shaman#plagues-caress"),
                (key: "shaman/prophet-of-pestilence/rapid-spread", blueprint: "494f7e13a506489baa9da89b46e138e9", name: "Rapid Spread", summary: "From 8th level, melee attackers without reach catch the plague unless they pass Fortitude (DC 10 + half level + Wis); plague range 30 feet.", guide: "shaman#rapid-spread"),
            ],
            selections: [
                (
                    key: "shaman/prophet-of-pestilence/carrier-of-disease",
                    blueprint: "68db664d2b5046eab2e6fd267f5d017d",
                    name: "Carrier of Disease",
                    summary: "At 2nd level and every four levels after, pick a mutation for the Plague of Abaddon.",
                    guide: "shaman#carrier-of-disease",
                    options: [
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-addle-mind", blueprint: "c49f6f28f7e44b45b954784cbe7be738", name: "Plague Mutation: Addle Mind", summary: "From 18th level, needs a mental damage mutation: plague victims are confused.", guide: "shaman#plague-mutation-addle-mind", prerequisite: All([Any([SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-charisma-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-intelligence-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-wisdom-damage")]), ClassLevel(class: "shaman", level: 18)])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-charisma-damage", blueprint: "9213e20f726e4785bd42f1e3d7acc703", name: "Plague Mutation: Charisma Damage", summary: "The plague deals 1d4 Charisma damage.", guide: "shaman#plague-mutation-charisma-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage", blueprint: "bee6b9ab7b8d433bb438b616ad5476b4", name: "Plague Mutation: Constitution Damage", summary: "The plague deals 1d4 Constitution damage.", guide: "shaman#plague-mutation-constitution-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-contagiousness", blueprint: "738a731ca6be428c9d49f0335da36312", name: "Plague Mutation: Contagiousness", summary: "From 10th level, creatures within 10 feet of a new victim catch the plague too unless they pass Fortitude.", guide: "shaman#plague-mutation-contagiousness", prerequisite: ClassLevel(class: "shaman", level: 10)),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-defenseless-host", blueprint: "ffca115b5870415db2ac83f7a4f5f26f", name: "Plague Mutation: Defenseless Host", summary: "From 14th level: another -2 on Fortitude, and victims are affected for 1 round by poison or disease even on a successful save.", guide: "shaman#plague-mutation-defenseless-host", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-vulnerable-host")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage", blueprint: "12426fc8134046a9b92e584af950d7fd", name: "Plague Mutation: Dexterity Damage", summary: "The plague deals 1d4 Dexterity damage.", guide: "shaman#plague-mutation-dexterity-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-drain-body", blueprint: "9fa32da6d8dd4d618da704bbbd020506", name: "Plague Mutation: Drain Body", summary: "From 10th level, needs a physical damage mutation: plague victims are sickened and fatigued.", guide: "shaman#plague-mutation-drain-body", prerequisite: All([Any([SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")]), ClassLevel(class: "shaman", level: 10)])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-drain-mind", blueprint: "204e7b65a5bc4ec4ba9714ae4d5216c8", name: "Plague Mutation: Drain Mind", summary: "From 10th level, needs a mental damage mutation: plague victims are shaken.", guide: "shaman#plague-mutation-drain-mind", prerequisite: All([Any([SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-charisma-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-intelligence-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-wisdom-damage")]), ClassLevel(class: "shaman", level: 10)])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dulled-reactions", blueprint: "3cd072db976f468b85de017dd3c832be", name: "Plague Mutation: Dulled Reactions", summary: "From 10th level, with Dexterity Damage: victims take -2 AC, Reflex, and Dex-based attacks, checks and skills.", guide: "shaman#plague-mutation-dulled-reactions", prerequisite: All([ClassLevel(class: "shaman", level: 10), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-erode-body", blueprint: "811e379c217b4caa9b229fed765c977d", name: "Plague Mutation: Erode Body", summary: "From 14th level: victims are exhausted and must pass Fortitude to attack or cast, or lose the action and be nauseated 1 round.", guide: "shaman#plague-mutation-erode-body", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-erode-mind", blueprint: "046b40d2d753429991d60495386d9d9d", name: "Plague Mutation: Erode Mind", summary: "From 14th level, with all three mental damage mutations: victims' spells and spell-like abilities get -2 DC.", guide: "shaman#plague-mutation-erode-mind", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-charisma-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-intelligence-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-wisdom-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-intelligence-damage", blueprint: "b9d4e9b01e744253a9e484994c86dedd", name: "Plague Mutation: Intelligence Damage", summary: "The plague deals 1d4 Intelligence damage.", guide: "shaman#plague-mutation-intelligence-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-muscle-atrophy", blueprint: "a24615f1002f4dd78cc1ae8bc4087a45", name: "Plague Mutation: Muscle Atrophy", summary: "From 14th level, with Muscle Feebleness: plague victims take 2 more Strength damage and their speed drops by 15 feet.", guide: "shaman#plague-mutation-muscle-atrophy", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-muscle-feebleness"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-muscle-feebleness", blueprint: "c6c6c70d65e94606932f13904dddec41", name: "Plague Mutation: Muscle Feebleness", summary: "From 10th level, with Strength Damage: victims take 2 Strength damage and lose 10 feet of speed.", guide: "shaman#plague-mutation-muscle-feebleness", prerequisite: All([ClassLevel(class: "shaman", level: 10), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-new-strain", blueprint: "505648df95f5489fa13ddbd1af9473fd", name: "Plague Mutation: New Strain", summary: "From 10th level, the plague's ability damage rises a die step (1d4 to 1d6, 1d6 to 1d8); can be taken more than once.", guide: "shaman#plague-mutation-new-strain", repeat: Unlimited, prerequisite: ClassLevel(class: "shaman", level: 10)),
