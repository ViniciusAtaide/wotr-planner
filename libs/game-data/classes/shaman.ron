Class(
    key: "shaman",
    blueprint: "145f1d3d360a7ad48bd95d392c81b38e",
    name: "Shaman",
    summary: "Prepared divine caster up to 9th-level spells (Wisdom and Charisma) with 3/4 BAB, good Will, 5 HP and 2 skill points a level, a spirit and hexes.",
    guide: "shaman",
    skill_points: 2,
    casting_ability: Wisdom,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "persuasion"],
    features: [
        (key: "shaman/orisons", blueprint: "1c7cc4b02e560f74796842ba31f2acda", name: "Orisons", guide: "shaman"),
        (key: "shaman/spirit-animal", blueprint: "d22f319fefac4ca4b90f03ac5cb9c714", name: "Spirit Animal", summary: "Gives you a familiar.", guide: "shaman#spirit-animal"),
        (key: "shaman/spirit/battle/battle-spirit", blueprint: "5e1161a3a7e5a83458de8a5f412c8d0c", name: "Battle Spirit", summary: "Allies within 30 feet get +1 morale to attack and damage, +1 more at 8th and 16th, for 3 + Charisma modifier rounds a day.", guide: "shaman#battle-spirit"),
        (key: "shaman/spirit/battle/enemies-bane", blueprint: "cc6b293550ac66c48a0c787b5e986a34", name: "Enemies\' Bane", summary: "From 8th level, swift action: a held weapon becomes Bane vs one creature type for a minute (+4d6 if already bane); 3 + Cha uses a day.", guide: "shaman#enemies-bane"),
        (key: "shaman/spirit/battle/manifestation-battle", blueprint: "1ddcc62d55d24285be8c687c94180578", name: "Manifestation (Battle)", summary: "At 20th level: Pounce, criticals ignore DR, +4 insight to AC against critical confirmations, and +2 x Con modifier max HP.", guide: "shaman#manifestation-battle"),
        (key: "shaman/spirit/battle/paragon-of-battle", blueprint: "4dd557cd188b288449adba1d3a8a35b7", name: "Paragon of Battle", summary: "From 16th level, standard action: Enlarge Person and Divine Power combined for 1 minute; 3 + Charisma modifier uses a day.", guide: "shaman#paragon-of-battle"),
        (key: "shaman/spirit/bones/manifestation-bones", blueprint: "10bb6847ee6b4cbf86dded2d86b76ab6", name: "Manifestation (Bones)", summary: "At 20th level: Animate Dead at will, and Power Word Kill once a day on a creature with 150 HP or less.", guide: "shaman#manifestation-bones"),
        (key: "shaman/spirit/bones/shard-soul", blueprint: "3f8db74aafbcaff40ae3f2cf5192ca4f", name: "Shard Soul", summary: "From 8th level, DR 3/magic (6 at 20th) and, three times a day, a 10-foot burst of 1d6 piercing per two levels (Reflex halves).", guide: "shaman#shard-soul"),
        (key: "shaman/spirit/bones/shedding-form", blueprint: "3ab4bdce51ab27641a7d6ac825d8e0be", name: "Shedding Form", summary: "From 16th level, become incorporeal with ghost touch weapons for class level rounds a day.", guide: "shaman#shedding-form"),
        (key: "shaman/spirit/bones/touch-of-the-grave", blueprint: "f556c44606e5eaa47bac31aae9ebc96d", name: "Touch of the Grave", summary: "Melee touch for 1d4 negative energy +1 per two levels, or heals undead; 3 + Cha uses a day; from 11th your weapons are Unholy.", guide: "shaman#touch-of-the-grave"),
        (key: "shaman/spirit/flame/elemental-form-fire", blueprint: "c66e1a4780a28d34bb13fc2c492b86d3", name: "Elemental Form (Fire)", summary: "From 16th level, once a day, become a Huge fire elemental (Elemental Body IV) for 1 hour per level.", guide: "shaman#elemental-form-fire"),
        (key: "shaman/spirit/flame/fiery-soul", blueprint: "c2a4ce87f8600db41a9a74d33af87c2c", name: "Fiery Soul", summary: "From 8th level, fire resistance 10 and, three times a day, a 15-foot cone of 1d4 fire per level (Reflex halves).", guide: "shaman#fiery-soul"),
        (key: "shaman/spirit/flame/manifestation-flame", blueprint: "e508bc6f64d64fc197ace10d66084b6d", name: "Manifestation (Flame)", summary: "At 20th level, fire resistance 30, and you can add Reach, Extend or Bolster Spell to fire spells at no cost.", guide: "shaman#manifestation-flame"),
        (key: "shaman/spirit/flame/touch-of-flames", blueprint: "ee5503b51c0c9684cb7300d28e3fc4e1", name: "Touch of Flames", summary: "Melee touch for 1d6 fire +1 per two levels; 3 + Cha uses a day; from 11th your weapons are Flaming.", guide: "shaman#touch-of-flames"),
        (key: "shaman/spirit/frost/frigid-blast", blueprint: "a84c3cf1a23eff74188a239c8182d6ee", name: "Frigid Blast", summary: "From 8th level, cold resistance 10 and, three times a day, a 20-foot burst of 1d6 cold per level within 30 feet (Reflex halves).", guide: "shaman#frigid-blast"),
        (key: "shaman/spirit/frost/guardian-of-the-north", blueprint: "7852fcc3e63c3914489e4788f4073e9b", name: "Guardian of the North", summary: "From 16th level, once a day, become a smilodon (Beast Shape IV) for 1 hour per level.", guide: "shaman#guardian-of-the-north"),
        (key: "shaman/spirit/frost/ice-splinter", blueprint: "30dc785861c12374c910e5ede5b87ef4", name: "Ice Splinter", summary: "Ranged touch for 1d6 piercing +1 per two levels; 3 + Cha uses a day; from 11th your weapons are Frost.", guide: "shaman#ice-splinter"),
        (key: "shaman/spirit/frost/manifestation-frost", blueprint: "5d396a800c34407fb3e01b8782b91c86", name: "Manifestation (Frost)", summary: "At 20th level, immunity to cold, and you can add Reach, Extend or Bolster Spell to cold spells at no cost.", guide: "shaman#manifestation-frost"),
        (key: "shaman/spirit/life/channel", blueprint: "9ae3ba76663a19141a3996c1e3ce95e3", name: "Channel", summary: "Channel positive energy as a cleric of your class level, 1 + Charisma modifier times a day.", guide: "shaman#channel"),
        (key: "shaman/spirit/life/healers-touch", blueprint: "8cae5b62ad604de41bf3e9f4489c6b8f", name: "Healer\'s Touch", summary: "From 8th level, +4 Lore (Religion), and a standard action heals 1d6 to every ally at negative HP within 30 feet.", guide: "shaman#healers-touch"),
        (key: "shaman/spirit/life/manifestation-life", blueprint: "83a2f66218554ea3ada1aceacb4aad54", name: "Manifestation (Life)", summary: "At 20th level, immunity to bleed, death, negative energy, and being fatigued, exhausted, sickened or nauseated.", guide: "shaman#manifestation-life"),
        (key: "shaman/spirit/life/quick-healing", blueprint: "9f9ed643240c4f24386eecec8ba3325a", name: "Quick Healing", summary: "From 16th level, Charisma modifier times a day, your channel energy or a cure spell takes only a swift action.", guide: "shaman#quick-healing"),
        (key: "shaman/spirit/nature/companion-animal", blueprint: "e7f4cfcd7488ac14bbc3e09426b59fd0", name: "Companion Animal", summary: "At 16th level, you gain an animal companion leveled as if you had Boon Companion.", guide: "shaman#companion-animal"),
        (key: "shaman/spirit/nature/manifestation-nature", blueprint: "f0bf97f286bb44a686108a97988de89c", name: "Manifestation - Nature", summary: "Once a day as a full-round action, change into a plant, animal or humanoid, curing poison, disease and ability damage and healing fully.", guide: "shaman#manifestation-nature"),
        (key: "shaman/spirit/nature/spirit-of-nature", blueprint: "f54191d614633da4baac7a47a659746b", name: "Spirit of Nature", summary: "From 8th level, at 0 HP you stabilize and get fast healing 1 for 1d4 rounds (fast healing 3 from 15th).", guide: "shaman#spirit-of-nature"),
        (key: "shaman/spirit/nature/storm-burst", blueprint: "0a7166e9c6ea5874e9fc4984f30f2d8d", name: "Storm Burst", summary: "Give a creature within 30 feet 20% concealment for 1 round +1 per 4 levels; 3 + Cha uses a day; from 11th your weapons are Thundering.", guide: "shaman#storm-burst"),
        (key: "shaman/spirit/stone/body-of-earth", blueprint: "ef692472df1b10f4caec90b4984965ef", name: "Body of Earth", summary: "From 8th level, DR 2/adamantine (5 at 20th) and, three times a day, a 10-foot burst of 1d6 piercing per two levels (Reflex halves).", guide: "shaman#body-of-earth"),
        (key: "shaman/spirit/stone/elemental-form-earth", blueprint: "6ea4b2cfa00bb75408662cd6168a64c1", name: "Elemental Form (Earth)", summary: "From 16th level, once a day, become a Huge earth elemental (Elemental Body IV) for 1 hour per level.", guide: "shaman#elemental-form-earth"),
        (key: "shaman/spirit/stone/manifestation-stone", blueprint: "936734437ee8493497760174a0543045", name: "Manifestation (Stone)", summary: "At 20th level, acid resistance 30, and you can add Reach, Extend or Bolster Spell to acid or Stone spirit spells at no cost.", guide: "shaman#manifestation-stone"),
        (key: "shaman/spirit/stone/touch-of-acid", blueprint: "5c3ccab7cb27f4a408531197eb2abd3f", name: "Touch of Acid", summary: "Melee touch for 1d6 acid +1 per two levels; 3 + Cha uses a day; from 11th your weapons are Corrosive.", guide: "shaman#touch-of-acid"),
        (key: "shaman/spirit/waves/elemental-form-water", blueprint: "8bc2929a165ba5940844aad982e2a2a6", name: "Elemental Form (Water)", summary: "From 16th level, once a day, become a Huge water elemental (Elemental Body IV) for 1 hour per level.", guide: "shaman#elemental-form-water"),
        (key: "shaman/spirit/waves/fluid-mastery", blueprint: "b2387cc5ccce4f9428ffd069aa03d029", name: "Fluid Mastery", summary: "From 8th level, three times a day, a 15-foot cone of 1d4 cold per two levels that bull rushes foes (Reflex halves and negates the push).", guide: "shaman#fluid-mastery"),
        (key: "shaman/spirit/waves/manifestation-waves", blueprint: "600780f354f24984b2fe210e2b54ad57", name: "Manifestation (Waves)", summary: "At 20th level, cold resistance 30, and you can add Reach, Extend or Bolster Spell to cold or Waves spirit spells at no cost.", guide: "shaman#manifestation-waves"),
        (key: "shaman/spirit/waves/wave-strike", blueprint: "62f408b7561adb34b899363c905fa13a", name: "Wave Strike", summary: "Melee touch for 1d6 +1 per two levels plus a bull rush using your Charisma modifier; 3 + Charisma modifier uses a day.", guide: "shaman#wave-strike"),
        (key: "shaman/spirit/wind/elemental-form-wind", blueprint: "2eef2cb6c24fd324196a6ae10739d39b", name: "Elemental Form (Wind)", summary: "From 16th level, once a day, become a Huge air elemental (Elemental Body IV) for 1 hour per level.", guide: "shaman#elemental-form-wind"),
        (key: "shaman/spirit/wind/manifestation-wind", blueprint: "a8c0403a27b6471f85d2bc441db5a993", name: "Manifestation (Wind)", summary: "At 20th level, electricity resistance 30, and you can add Reach, Extend or Bolster Spell to electricity or Wind spirit spells at no cost.", guide: "shaman#manifestation-wind"),
        (key: "shaman/spirit/wind/shocking-touch", blueprint: "5d810adea03fb644582eb74de32c75ec", name: "Shocking Touch", summary: "Melee touch for 1d6 electricity +1 per two levels; 3 + Cha uses a day; from 11th your weapons are Shock.", guide: "shaman#shocking-touch"),
        (key: "shaman/spirit/wind/spark-soul", blueprint: "59550028efc886a4e8ca2c80b680642f", name: "Spark Soul", summary: "From 8th level, electricity resistance 10 and, three times a day, a 20-foot line of 1d4 electricity per level (Reflex halves).", guide: "shaman#spark-soul"),
        (key: "shaman/wandering-hex", blueprint: "2674f98616188814fbba9f8fccf43564", name: "Wandering Hex", summary: "At 6th and 14th level, a hex slot you can fill from your main spirit's or current wandering spirit's hexes.", guide: "shaman#wandering-hex", daily_choice: true),
        (key: "shaman/wandering-spirit", blueprint: "70e6075a72633ba49804ccb6203fb18c", name: "Wandering Spirit", summary: "From 4th level, bond with a second spirit you can change on each rest and use its ability; its greater and true abilities at 12th and 20th.", guide: "shaman#wandering-spirit", daily_choice: true),
        (key: "shaman/wandering-spirit-greater-ability", name: "Wandering Spirit - Greater Ability", summary: "From 12th level, you also gain your wandering spirit's greater ability.", guide: "shaman"),
        (key: "shaman/wandering-spirit-true-ability", name: "Wandering Spirit - True Ability", summary: "At 20th level, you also gain your wandering spirit's true ability.", guide: "shaman"),
    ],
    selections: [
        (
            key: "shaman/hex",
            blueprint: "4223fe18c75d4d14787af196a04e14e7",
            name: "Hex",
            summary: "Hexes from the witch's basic list, shaman hexes and your spirit's hexes; their saves use your Wisdom.",
            guide: "shaman#hex",
            option_levels: ["shaman"],
            options: [
                (key: "shaman/hex/air-barrier", blueprint: "4b5b0f429730a984fb56fc3e34e5231e", name: "Air Barrier", summary: "Wind: +4 armor bonus barrier for 1 hour per level, +2 at 7th and every 4 levels (+12 at 19th); 50% ranged miss chance from 13th.", guide: "shaman#air-barrier", prerequisite: SelectionOption("shaman/spirit/wind")),
                (
                    key: "shaman/hex/battle-master",
                    blueprint: "840651aac9b854a4980ec19e2fced74f",
                    name: "Battle Master",
                    summary: "Battle: an extra attack of opportunity each round (stacks with Combat Reflexes), Weapon Specialization at 8th, Greater Weapon Focus at 16th.",
                    guide: "shaman#battle-master",
                    parameter: Weapon,
                    prerequisite: Any([Archetype("shaman/wildland-shaman"), SelectionOption("shaman/spirit/battle")]),
                    levels: [
                        (level: 8, chosen_feats: ["weapon-specialization"]),
                        (level: 16, chosen_feats: ["greater-weapon-focus"]),
                    ],
                ),
                (key: "shaman/hex/battle-ward", blueprint: "6f60723288b405c48af821cf995e4389", name: "Battle Ward", summary: "Battle: a touched ally gets +3 deflection to AC that drops by 1 each time it's attacked; +4 at 8th, +5 at 16th.", guide: "shaman#battle-ward", prerequisite: Any([Archetype("shaman/wildland-shaman"), SelectionOption("shaman/spirit/battle")])),
                (key: "shaman/hex/beckoning-chill", blueprint: "905a9eccb9fa73e4da1d3e86bcb1e421", name: "Beckoning Chill", summary: "Waves: a creature within 30 feet is entangled for 1 round whenever it takes cold damage, for 1 minute.", guide: "shaman#beckoning-chill", prerequisite: SelectionOption("shaman/spirit/waves")),
                (key: "shaman/hex/bone-lock", blueprint: "e506667113c93f94a962a90adedcdb03", name: "Bone Lock", summary: "Bones: stagger a creature within 30 feet for 1 round (Fortitude negates); class level rounds at 8th, no repeat saves at 16th.", guide: "shaman#bone-lock", prerequisite: SelectionOption("shaman/spirit/bones")),
                (key: "shaman/hex/bone-ward", blueprint: "96a99ea4866da4b4cbd51b81f1a61a72", name: "Bone Ward", summary: "Bones: a warded ally gets +2 deflection to AC for class level rounds; +3 for a minute at 8th, +4 for an hour at 16th.", guide: "shaman#bone-ward", prerequisite: SelectionOption("shaman/spirit/bones")),
                (key: "shaman/hex/chant", blueprint: "3f776576b5f27604a9dad54d361153af", name: "Chant", guide: "shaman#chant"),
                (key: "shaman/hex/draconic-resilience", blueprint: "35a5f29c23da9eb4e82fe6c0d39b53bf", name: "Draconic Resilience", summary: "A touched creature is immune to sleep for class level rounds, and to paralysis from 7th level.", guide: "shaman#draconic-resilience"),
                (key: "shaman/hex/entangling-curse", blueprint: "176ee8bedc899964a96ef1b7478dcce7", name: "Entangling Curse", summary: "Nature: entangle a creature within 30 feet for Charisma modifier rounds (Reflex negates).", guide: "shaman#entangling-curse", prerequisite: SelectionOption("shaman/spirit/nature")),
                (key: "shaman/hex/fearful-gaze", blueprint: "89603c7a9ba690d46b95148b46a34f7d", name: "Fearful Gaze", summary: "Bones: shake a creature within 30 feet for 1 round (Will negates); frightened from 8th, panicked from 16th.", guide: "shaman#fearful-gaze", prerequisite: SelectionOption("shaman/spirit/bones")),
                (key: "shaman/hex/fire-nimbus", blueprint: "24074b42608fff54f8e1a5b7fa4a7d29", name: "Fire Nimbus", summary: "Flame: a creature within 30 feet loses concealment and invisibility and takes -2 on saves vs fire for class level rounds (Will negates).", guide: "shaman#fire-nimbus", prerequisite: SelectionOption("shaman/spirit/flame")),
                (key: "shaman/hex/flame-curse", blueprint: "dec5607ab6ea68d4aac0772049e80be7", name: "Flame Curse", summary: "Flame: a creature within 30 feet is vulnerable to fire until the end of your next turn, 1 round longer at 8th and 16th.", guide: "shaman#flame-curse", prerequisite: SelectionOption("shaman/spirit/flame")),
                (key: "shaman/hex/friend-to-animals", blueprint: "0d92799cecf414249a23ad82f7e9901a", name: "Friend to Animals", summary: "Nature: cast Summon Nature's Ally spontaneously like a druid; animals within 30 feet add your Charisma modifier to saves.", guide: "shaman#friend-to-animals", prerequisite: SelectionOption("shaman/spirit/nature")),
                (key: "shaman/hex/fury", blueprint: "f562d3e6445a1cc4796435c356e677d3", name: "Fury", summary: "Target gets +2 morale on attacks and +2 on saves vs fear for Wisdom modifier rounds, +1 more at 8th and 16th.", guide: "shaman#fury"),
                (key: "shaman/hex/hampering-hex", blueprint: "36f07f59f983cd042ae0c8c91e4dcea6", name: "Hampering Hex", summary: "Battle: a creature within 30 feet takes -2 AC and CMD (-4 from 8th) for class level rounds; Will cuts it to 1 round.", guide: "shaman#hampering-hex", prerequisite: Any([Archetype("shaman/wildland-shaman"), SelectionOption("shaman/spirit/battle")])),
                (key: "shaman/hex/hypothermia", blueprint: "9b764fbd91bf92643a36d833762fd069", name: "Hypothermia", summary: "Frost: the target is fatigued for 2 rounds unless it passes Fortitude, 1 round longer at 8th and 16th.", guide: "shaman#hypothermia", prerequisite: SelectionOption("shaman/spirit/frost")),
                (key: "shaman/hex/intimidating-display", blueprint: "2eacbef4be7c6434e9cfaa9632fdc429", name: "Intimidating Display", summary: "Gives Dazzling Display, usable without a weapon.", guide: "shaman#intimidating-display"),
                (key: "shaman/hex/metal-curse", blueprint: "ea8e9fef24350684d82b38fec2cc3139", name: "Metal Curse", summary: "Stone: the target takes -2 AC against metal weapons until your next turn ends; longer and -2 more at 8th and 16th.", guide: "shaman#metal-curse", prerequisite: SelectionOption("shaman/spirit/stone")),
                (key: "shaman/hex/secret", blueprint: "1342b5bfb876e434797cdcf7311bccad", name: "Secret", summary: "Gives you a metamagic feat.", guide: "shaman#secret"),
                (key: "shaman/hex/stone-stability", blueprint: "05b6b99b0f394284899eccd4728031b7", name: "Stone Stability", summary: "Stone: +4 CMD against bull rush and trip; Trip as a bonus feat at 5th and Greater Trip at 10th.", guide: "shaman#stone-stability", prerequisite: SelectionOption("shaman/spirit/stone")),
                (key: "shaman/hex/vortex-spells", blueprint: "d54e52f0e3d086f468ede43222e053e9", name: "Vortex Spells", summary: "Wind: a confirmed critical with a spell staggers the target for 1 round (1d4 rounds from 11th).", guide: "shaman#vortex-spells", prerequisite: SelectionOption("shaman/spirit/wind")),
                (key: "shaman/hex/ward-of-flame", blueprint: "c95e1ccf872844b44a47378f761689be", name: "Ward of Flame", summary: "Flame: a melee attacker hitting the warded ally takes 1d6 fire + half your class level; lasts 1 minute or 1 hit (+1 hit at 8th and 16th).", guide: "shaman#ward-of-flame", prerequisite: SelectionOption("shaman/spirit/flame")),
                (key: "shaman/hex/wind-ward", blueprint: "2a7f7b35e1a0fb44ba7f01e28fa7a535", name: "Wind Ward", summary: "Wind: 20% miss chance on ranged attacks against the warded ally for class level rounds; 1 minute per level at 8th, 50% at 16th.", guide: "shaman#wind-ward", prerequisite: SelectionOption("shaman/spirit/wind")),
            ],
            shared_options: [
                "witch/hex/ameliorating",
                "witch/hex/aura-of-purity",
                "witch/hex/evil-eye",
                "witch/hex/fortune",
                "witch/hex/healing-hex",
                "witch/hex/iceplant",
                "witch/hex/misfortune",
                "witch/hex/nails",
                "witch/hex/protective-luck",
                "witch/hex/slumber",
                "witch/hex/ward",
            ],
        ),
        (
            key: "shaman/spirit",
            blueprint: "00c8c566d1825dd4a871250f35285982",
            name: "Spirit",
            band: Path,
            summary: "Your guiding spirit gives abilities at 1st, 8th and 16th level, a Manifestation at 20th, and bonus spells.",
            guide: "shaman#spirit",
            option_levels: ["shaman"],
            options: [
                (
                    key: "shaman/spirit/battle",
                    blueprint: "26e81d83d13dbf6448b10019c802612d",
                    name: "Battle",
                    summary: "Battle: morale aura for allies, Enemies' Bane at 8th, Paragon of Battle at 16th, Pounce and more HP at 20th; bonus spells like Enlarge Person.",
                    guide: "shaman#battle",
                    levels: [
                        (level: 1, features: ["shaman/spirit/battle/battle-spirit"]),
                        (level: 8, features: ["shaman/spirit/battle/enemies-bane", "shaman/spirit/battle/battle-spirit"]),
                        (level: 16, features: ["shaman/spirit/battle/paragon-of-battle", "shaman/spirit/battle/battle-spirit"]),
                        (level: 20, features: ["shaman/spirit/battle/manifestation-battle"]),
                    ],
                ),
                (
                    key: "shaman/spirit/bones",
                    blueprint: "65b5e7f17a1b928418fc9e8a6b55eafa",
                    name: "Bones",
                    summary: "Bones: Touch of the Grave, Shard Soul DR and burst at 8th, incorporeal Shedding Form at 16th, Power Word Kill at 20th.",
                    guide: "shaman#bones",
                    levels: [
                        (level: 1, features: ["shaman/spirit/bones/touch-of-the-grave"]),
                        (level: 8, features: ["shaman/spirit/bones/shard-soul"]),
                        (level: 16, features: ["shaman/spirit/bones/shedding-form"]),
                        (level: 20, features: ["shaman/spirit/bones/manifestation-bones"]),
                    ],
                ),
                (
                    key: "shaman/spirit/flame",
                    blueprint: "50efeb23b314869409365c8061a4082d",
                    name: "Flame",
                    summary: "Flame: Touch of Flames, fire resistance and a cone at 8th, fire elemental form at 16th, free fire metamagic at 20th.",
                    guide: "shaman#flame",
                    levels: [
                        (level: 1, features: ["shaman/spirit/flame/touch-of-flames"]),
                        (level: 8, features: ["shaman/spirit/flame/fiery-soul"]),
                        (level: 16, features: ["shaman/spirit/flame/elemental-form-fire"]),
                        (level: 20, features: ["shaman/spirit/flame/manifestation-flame"]),
                    ],
                ),
                (
                    key: "shaman/spirit/frost",
                    blueprint: "44c130a12d49ebf4a95945feffe5aae7",
                    name: "Frost",
                    summary: "Frost: Ice Splinter, cold resistance and a burst at 8th, smilodon form at 16th, cold immunity at 20th; needed for Winter Witch.",
                    guide: "shaman#frost",
                    levels: [
                        (level: 1, features: ["shaman/spirit/frost/ice-splinter"]),
                        (level: 8, features: ["shaman/spirit/frost/frigid-blast"]),
                        (level: 16, features: ["shaman/spirit/frost/guardian-of-the-north"]),
                        (level: 20, features: ["shaman/spirit/frost/manifestation-frost"]),
                    ],
                ),
                (
                    key: "shaman/spirit/life",
                    blueprint: "f9ee5a9146561ba4bac4cb8a7126f85c",
                    name: "Life",
                    summary: "Life: Channel positive energy, Healer's Touch at 8th, swift Quick Healing at 16th, immunity to many conditions at 20th.",
                    guide: "shaman#life",
                    levels: [
                        (level: 1, features: ["shaman/spirit/life/channel"]),
                        (level: 8, features: ["shaman/spirit/life/healers-touch"]),
                        (level: 16, features: ["shaman/spirit/life/quick-healing"]),
                        (level: 20, features: ["shaman/spirit/life/manifestation-life"]),
                    ],
                ),
                (
                    key: "shaman/spirit/nature",
