    archetypes: [
        (
            key: "shaman/possessed-shaman",
            blueprint: "7939ff57cc2ce104693ea2f5afa595b6",
            name: "Possessed Shaman",
            summary: "Gets skills from its spirit instead of spirit spells, resists charm and compulsion, but has fewer hexes.",
            guide: "shaman#possessed-shaman",
            features: [
                (key: "shaman/possessed-shaman/crowded-vessel", blueprint: "9939197a3b1db1542bb97a4d7eb2d309", name: "Crowded Vessel", summary: "When you fail a save against a charm or compulsion effect, you get a second save to resist it.", guide: "shaman#crowded-vessel"),
                (key: "shaman/possessed-shaman/orisons", blueprint: "1c7cc4b02e560f74796842ba31f2acda", name: "Orisons", guide: "shaman#possessed-shaman"),
                (key: "shaman/possessed-shaman/shared-skills", blueprint: "9d0477ebd71d43041b419c216b5d6cff", name: "Shared Skills", summary: "Pick two skills: your rank in each equals your class level and uses Wisdom; replaces spirit magic, so no spirit spells.", guide: "shaman#shared-skills"),
                (key: "shaman/possessed-shaman/wandering-skills", blueprint: "39aeefef2162d554cbb902e824b4274d", name: "Wandering Skills", summary: "When bonded to a wandering spirit, pick a skill with rank equal to class level using Wisdom; changeable each rest.", guide: "shaman#wandering-skills"),
                (key: "shaman/possessed-shaman/wandering-spirit-greater-ability", name: "Wandering Spirit - Greater Ability", summary: "From 12th level, you also gain your wandering spirit's greater ability.", guide: "shaman#possessed-shaman"),
                (key: "shaman/possessed-shaman/wandering-spirit-true-ability", name: "Wandering Spirit - True Ability", summary: "At 20th level, you also gain your wandering spirit's true ability.", guide: "shaman#possessed-shaman"),
            ],
            levels: [
                (level: 1, features: ["shaman/possessed-shaman/orisons", "shaman/possessed-shaman/shared-skills", "shaman/spirit-animal"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"], selections: ["shaman/spirit"]),
                (level: 2, features: ["shaman/possessed-shaman/crowded-vessel"]),
