Class(
    key: "shaman",
    name: "Shaman",
    summary: "Prepared divine caster up to 9th-level spells (Wisdom and Charisma) with 3/4 BAB, good Will, 5 HP and 2 skill points a level, a spirit and hexes.",
    guide: "shaman",
    skill_points: 2,
    casting_ability: Wisdom,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "persuasion"],
    features: [
        (key: "shaman/orisons", name: "Orisons", guide: "shaman"),
        (key: "shaman/spirit-animal", name: "Spirit Animal", summary: "Gives you a familiar.", guide: "shaman#spirit-animal"),
        (key: "shaman/spirit/battle/battle-spirit", name: "Battle Spirit", summary: "Allies within 30 feet get +1 morale to attack and damage, +1 more at 8th and 16th, for 3 + Charisma modifier rounds a day.", guide: "shaman#battle-spirit"),
        (key: "shaman/spirit/battle/enemies-bane", name: "Enemies\' Bane", summary: "From 8th level, swift action: a held weapon becomes Bane vs one creature type for a minute (+4d6 if already bane); 3 + Cha uses a day.", guide: "shaman#enemies-bane"),
        (key: "shaman/spirit/battle/manifestation-battle", name: "Manifestation (Battle)", summary: "At 20th level: Pounce, criticals ignore DR, +4 insight to AC against critical confirmations, and +2 x Con modifier max HP.", guide: "shaman#manifestation-battle"),
        (key: "shaman/spirit/battle/paragon-of-battle", name: "Paragon of Battle", summary: "From 16th level, standard action: Enlarge Person and Divine Power combined for 1 minute; 3 + Charisma modifier uses a day.", guide: "shaman#paragon-of-battle"),
        (key: "shaman/spirit/bones/manifestation-bones", name: "Manifestation (Bones)", summary: "At 20th level: Animate Dead at will, and Power Word Kill once a day on a creature with 150 HP or less.", guide: "shaman#manifestation-bones"),
        (key: "shaman/spirit/bones/shard-soul", name: "Shard Soul", summary: "From 8th level, DR 3/magic (6 at 20th) and, three times a day, a 10-foot burst of 1d6 piercing per two levels (Reflex halves).", guide: "shaman#shard-soul"),
        (key: "shaman/spirit/bones/shedding-form", name: "Shedding Form", summary: "From 16th level, become incorporeal with ghost touch weapons for class level rounds a day.", guide: "shaman#shedding-form"),
        (key: "shaman/spirit/bones/touch-of-the-grave", name: "Touch of the Grave", summary: "Melee touch for 1d4 negative energy +1 per two levels, or heals undead; 3 + Cha uses a day; from 11th your weapons are Unholy.", guide: "shaman#touch-of-the-grave"),
        (key: "shaman/spirit/flame/elemental-form-fire", name: "Elemental Form (Fire)", summary: "From 16th level, once a day, become a Huge fire elemental (Elemental Body IV) for 1 hour per level.", guide: "shaman#elemental-form-fire"),
        (key: "shaman/spirit/flame/fiery-soul", name: "Fiery Soul", summary: "From 8th level, fire resistance 10 and, three times a day, a 15-foot cone of 1d4 fire per level (Reflex halves).", guide: "shaman#fiery-soul"),
        (key: "shaman/spirit/flame/manifestation-flame", name: "Manifestation (Flame)", summary: "At 20th level, fire resistance 30, and you can add Reach, Extend or Bolster Spell to fire spells at no cost.", guide: "shaman#manifestation-flame"),
        (key: "shaman/spirit/flame/touch-of-flames", name: "Touch of Flames", summary: "Melee touch for 1d6 fire +1 per two levels; 3 + Cha uses a day; from 11th your weapons are Flaming.", guide: "shaman#touch-of-flames"),
        (key: "shaman/spirit/frost/frigid-blast", name: "Frigid Blast", summary: "From 8th level, cold resistance 10 and, three times a day, a 20-foot burst of 1d6 cold per level within 30 feet (Reflex halves).", guide: "shaman#frigid-blast"),
        (key: "shaman/spirit/frost/guardian-of-the-north", name: "Guardian of the North", summary: "From 16th level, once a day, become a smilodon (Beast Shape IV) for 1 hour per level.", guide: "shaman#guardian-of-the-north"),
        (key: "shaman/spirit/frost/ice-splinter", name: "Ice Splinter", summary: "Ranged touch for 1d6 piercing +1 per two levels; 3 + Cha uses a day; from 11th your weapons are Frost.", guide: "shaman#ice-splinter"),
        (key: "shaman/spirit/frost/manifestation-frost", name: "Manifestation (Frost)", summary: "At 20th level, immunity to cold, and you can add Reach, Extend or Bolster Spell to cold spells at no cost.", guide: "shaman#manifestation-frost"),
        (key: "shaman/spirit/life/channel", name: "Channel", summary: "Channel positive energy as a cleric of your class level, 1 + Charisma modifier times a day.", guide: "shaman#channel"),
        (key: "shaman/spirit/life/healers-touch", name: "Healer\'s Touch", summary: "From 8th level, +4 Lore (Religion), and a standard action heals 1d6 to every ally at negative HP within 30 feet.", guide: "shaman#healers-touch"),
        (key: "shaman/spirit/life/manifestation-life", name: "Manifestation (Life)", summary: "At 20th level, immunity to bleed, death, negative energy, and being fatigued, exhausted, sickened or nauseated.", guide: "shaman#manifestation-life"),
        (key: "shaman/spirit/life/quick-healing", name: "Quick Healing", summary: "From 16th level, Charisma modifier times a day, your channel energy or a cure spell takes only a swift action.", guide: "shaman#quick-healing"),
        (key: "shaman/spirit/nature/companion-animal", name: "Companion Animal", summary: "At 16th level, you gain an animal companion leveled as if you had Boon Companion.", guide: "shaman#companion-animal"),
        (key: "shaman/spirit/nature/manifestation-nature", name: "Manifestation - Nature", summary: "Once a day as a full-round action, change into a plant, animal or humanoid, curing poison, disease and ability damage and healing fully.", guide: "shaman#manifestation-nature"),
        (key: "shaman/spirit/nature/spirit-of-nature", name: "Spirit of Nature", summary: "From 8th level, at 0 HP you stabilize and get fast healing 1 for 1d4 rounds (fast healing 3 from 15th).", guide: "shaman#spirit-of-nature"),
        (key: "shaman/spirit/nature/storm-burst", name: "Storm Burst", summary: "Give a creature within 30 feet 20% concealment for 1 round +1 per 4 levels; 3 + Cha uses a day; from 11th your weapons are Thundering.", guide: "shaman#storm-burst"),
        (key: "shaman/spirit/stone/body-of-earth", name: "Body of Earth", summary: "From 8th level, DR 2/adamantine (5 at 20th) and, three times a day, a 10-foot burst of 1d6 piercing per two levels (Reflex halves).", guide: "shaman#body-of-earth"),
        (key: "shaman/spirit/stone/elemental-form-earth", name: "Elemental Form (Earth)", summary: "From 16th level, once a day, become a Huge earth elemental (Elemental Body IV) for 1 hour per level.", guide: "shaman#elemental-form-earth"),
        (key: "shaman/spirit/stone/manifestation-stone", name: "Manifestation (Stone)", summary: "At 20th level, acid resistance 30, and you can add Reach, Extend or Bolster Spell to acid or Stone spirit spells at no cost.", guide: "shaman#manifestation-stone"),
        (key: "shaman/spirit/stone/touch-of-acid", name: "Touch of Acid", summary: "Melee touch for 1d6 acid +1 per two levels; 3 + Cha uses a day; from 11th your weapons are Corrosive.", guide: "shaman#touch-of-acid"),
        (key: "shaman/spirit/waves/elemental-form-water", name: "Elemental Form (Water)", summary: "From 16th level, once a day, become a Huge water elemental (Elemental Body IV) for 1 hour per level.", guide: "shaman#elemental-form-water"),
        (key: "shaman/spirit/waves/fluid-mastery", name: "Fluid Mastery", summary: "From 8th level, three times a day, a 15-foot cone of 1d4 cold per two levels that bull rushes foes (Reflex halves and negates the push).", guide: "shaman#fluid-mastery"),
        (key: "shaman/spirit/waves/manifestation-waves", name: "Manifestation (Waves)", summary: "At 20th level, cold resistance 30, and you can add Reach, Extend or Bolster Spell to cold or Waves spirit spells at no cost.", guide: "shaman#manifestation-waves"),
        (key: "shaman/spirit/waves/wave-strike", name: "Wave Strike", summary: "Melee touch for 1d6 +1 per two levels plus a bull rush using your Charisma modifier; 3 + Charisma modifier uses a day.", guide: "shaman#wave-strike"),
        (key: "shaman/spirit/wind/elemental-form-wind", name: "Elemental Form (Wind)", summary: "From 16th level, once a day, become a Huge air elemental (Elemental Body IV) for 1 hour per level.", guide: "shaman#elemental-form-wind"),
        (key: "shaman/spirit/wind/manifestation-wind", name: "Manifestation (Wind)", summary: "At 20th level, electricity resistance 30, and you can add Reach, Extend or Bolster Spell to electricity or Wind spirit spells at no cost.", guide: "shaman#manifestation-wind"),
        (key: "shaman/spirit/wind/shocking-touch", name: "Shocking Touch", summary: "Melee touch for 1d6 electricity +1 per two levels; 3 + Cha uses a day; from 11th your weapons are Shock.", guide: "shaman#shocking-touch"),
        (key: "shaman/spirit/wind/spark-soul", name: "Spark Soul", summary: "From 8th level, electricity resistance 10 and, three times a day, a 20-foot line of 1d4 electricity per level (Reflex halves).", guide: "shaman#spark-soul"),
        (key: "shaman/wandering-hex", name: "Wandering Hex", summary: "At 6th and 14th level, a hex slot you can fill from your main spirit's or current wandering spirit's hexes.", guide: "shaman#wandering-hex", daily_choice: true),
        (key: "shaman/wandering-spirit", name: "Wandering Spirit", summary: "From 4th level, bond with a second spirit you can change on each rest and use its ability; its greater and true abilities at 12th and 20th.", guide: "shaman#wandering-spirit", daily_choice: true),
        (key: "shaman/wandering-spirit-greater-ability", name: "Wandering Spirit - Greater Ability", summary: "From 12th level, you also gain your wandering spirit's greater ability.", guide: "shaman"),
        (key: "shaman/wandering-spirit-true-ability", name: "Wandering Spirit - True Ability", summary: "At 20th level, you also gain your wandering spirit's true ability.", guide: "shaman"),
    ],
    selections: [
        (
            key: "shaman/hex",
            name: "Hex",
            summary: "Hexes from the witch's basic list, shaman hexes and your spirit's hexes; their saves use your Wisdom.",
            guide: "shaman#hex",
            option_levels: ["shaman"],
            options: [
                (key: "shaman/hex/air-barrier", name: "Air Barrier", summary: "Wind: +4 armor bonus barrier for 1 hour per level, +2 at 7th and every 4 levels (+12 at 19th); 50% ranged miss chance from 13th.", guide: "shaman#air-barrier", prerequisite: SelectionOption("shaman/spirit/wind")),
                (
                    key: "shaman/hex/battle-master",
                    name: "Battle Master",
                    summary: "Battle: an extra attack of opportunity each round (stacks with Combat Reflexes), Weapon Specialization at 8th, Greater Weapon Focus at 16th.",
                    guide: "shaman#battle-master",
                    parameter: Weapon,
                    prerequisite: Any([Archetype("shaman/wildland-shaman"), SelectionOption("shaman/spirit/battle")]),
                    levels: [
                        (level: 8, chosen_feats: ["weapon-specialization"]),
                        (level: 16, chosen_feats: ["greater-weapon-focus"]),
                    ],
                ),
                (key: "shaman/hex/battle-ward", name: "Battle Ward", summary: "Battle: a touched ally gets +3 deflection to AC that drops by 1 each time it's attacked; +4 at 8th, +5 at 16th.", guide: "shaman#battle-ward", prerequisite: Any([Archetype("shaman/wildland-shaman"), SelectionOption("shaman/spirit/battle")])),
                (key: "shaman/hex/beckoning-chill", name: "Beckoning Chill", summary: "Waves: a creature within 30 feet is entangled for 1 round whenever it takes cold damage, for 1 minute.", guide: "shaman#beckoning-chill", prerequisite: SelectionOption("shaman/spirit/waves")),
                (key: "shaman/hex/bone-lock", name: "Bone Lock", summary: "Bones: stagger a creature within 30 feet for 1 round (Fortitude negates); class level rounds at 8th, no repeat saves at 16th.", guide: "shaman#bone-lock", prerequisite: SelectionOption("shaman/spirit/bones")),
                (key: "shaman/hex/bone-ward", name: "Bone Ward", summary: "Bones: a warded ally gets +2 deflection to AC for class level rounds; +3 for a minute at 8th, +4 for an hour at 16th.", guide: "shaman#bone-ward", prerequisite: SelectionOption("shaman/spirit/bones")),
                (key: "shaman/hex/chant", name: "Chant", guide: "shaman#chant"),
                (key: "shaman/hex/draconic-resilience", name: "Draconic Resilience", summary: "A touched creature is immune to sleep for class level rounds, and to paralysis from 7th level.", guide: "shaman#draconic-resilience"),
                (key: "shaman/hex/entangling-curse", name: "Entangling Curse", summary: "Nature: entangle a creature within 30 feet for Charisma modifier rounds (Reflex negates).", guide: "shaman#entangling-curse", prerequisite: SelectionOption("shaman/spirit/nature")),
                (key: "shaman/hex/fearful-gaze", name: "Fearful Gaze", summary: "Bones: shake a creature within 30 feet for 1 round (Will negates); frightened from 8th, panicked from 16th.", guide: "shaman#fearful-gaze", prerequisite: SelectionOption("shaman/spirit/bones")),
                (key: "shaman/hex/fire-nimbus", name: "Fire Nimbus", summary: "Flame: a creature within 30 feet loses concealment and invisibility and takes -2 on saves vs fire for class level rounds (Will negates).", guide: "shaman#fire-nimbus", prerequisite: SelectionOption("shaman/spirit/flame")),
                (key: "shaman/hex/flame-curse", name: "Flame Curse", summary: "Flame: a creature within 30 feet is vulnerable to fire until the end of your next turn, 1 round longer at 8th and 16th.", guide: "shaman#flame-curse", prerequisite: SelectionOption("shaman/spirit/flame")),
                (key: "shaman/hex/friend-to-animals", name: "Friend to Animals", summary: "Nature: cast Summon Nature's Ally spontaneously like a druid; animals within 30 feet add your Charisma modifier to saves.", guide: "shaman#friend-to-animals", prerequisite: SelectionOption("shaman/spirit/nature")),
                (key: "shaman/hex/fury", name: "Fury", summary: "Target gets +2 morale on attacks and +2 on saves vs fear for Wisdom modifier rounds, +1 more at 8th and 16th.", guide: "shaman#fury"),
                (key: "shaman/hex/hampering-hex", name: "Hampering Hex", summary: "Battle: a creature within 30 feet takes -2 AC and CMD (-4 from 8th) for class level rounds; Will cuts it to 1 round.", guide: "shaman#hampering-hex", prerequisite: Any([Archetype("shaman/wildland-shaman"), SelectionOption("shaman/spirit/battle")])),
                (key: "shaman/hex/hypothermia", name: "Hypothermia", summary: "Frost: the target is fatigued for 2 rounds unless it passes Fortitude, 1 round longer at 8th and 16th.", guide: "shaman#hypothermia", prerequisite: SelectionOption("shaman/spirit/frost")),
                (key: "shaman/hex/intimidating-display", name: "Intimidating Display", summary: "Gives Dazzling Display, usable without a weapon.", guide: "shaman#intimidating-display"),
                (key: "shaman/hex/metal-curse", name: "Metal Curse", summary: "Stone: the target takes -2 AC against metal weapons until your next turn ends; longer and -2 more at 8th and 16th.", guide: "shaman#metal-curse", prerequisite: SelectionOption("shaman/spirit/stone")),
                (key: "shaman/hex/secret", name: "Secret", summary: "Gives you a metamagic feat.", guide: "shaman#secret"),
                (key: "shaman/hex/stone-stability", name: "Stone Stability", summary: "Stone: +4 CMD against bull rush and trip; Trip as a bonus feat at 5th and Greater Trip at 10th.", guide: "shaman#stone-stability", prerequisite: SelectionOption("shaman/spirit/stone")),
                (key: "shaman/hex/vortex-spells", name: "Vortex Spells", summary: "Wind: a confirmed critical with a spell staggers the target for 1 round (1d4 rounds from 11th).", guide: "shaman#vortex-spells", prerequisite: SelectionOption("shaman/spirit/wind")),
                (key: "shaman/hex/ward-of-flame", name: "Ward of Flame", summary: "Flame: a melee attacker hitting the warded ally takes 1d6 fire + half your class level; lasts 1 minute or 1 hit (+1 hit at 8th and 16th).", guide: "shaman#ward-of-flame", prerequisite: SelectionOption("shaman/spirit/flame")),
                (key: "shaman/hex/wind-ward", name: "Wind Ward", summary: "Wind: 20% miss chance on ranged attacks against the warded ally for class level rounds; 1 minute per level at 8th, 50% at 16th.", guide: "shaman#wind-ward", prerequisite: SelectionOption("shaman/spirit/wind")),
            ],
            shared_options: [
                "witch/hex/ameliorating",
                "witch/hex/aura-of-purity",
                "witch/hex/evil-eye",
                "witch/hex/fortune",
                "witch/hex/healing-hex",
                "witch/hex/iceplant",
                "witch/hex/misfortune",
                "witch/hex/nails",
                "witch/hex/protective-luck",
                "witch/hex/slumber",
                "witch/hex/ward",
            ],
        ),
        (
            key: "shaman/spirit",
            name: "Spirit",
            summary: "Your guiding spirit gives abilities at 1st, 8th and 16th level, a Manifestation at 20th, and bonus spells.",
            guide: "shaman#spirit",
            option_levels: ["shaman"],
            options: [
                (
                    key: "shaman/spirit/battle",
                    name: "Battle",
                    summary: "Battle: morale aura for allies, Enemies' Bane at 8th, Paragon of Battle at 16th, Pounce and more HP at 20th; bonus spells like Enlarge Person.",
                    guide: "shaman#battle",
                    levels: [
                        (level: 1, features: ["shaman/spirit/battle/battle-spirit"]),
                        (level: 8, features: ["shaman/spirit/battle/enemies-bane", "shaman/spirit/battle/battle-spirit"]),
                        (level: 16, features: ["shaman/spirit/battle/paragon-of-battle", "shaman/spirit/battle/battle-spirit"]),
                        (level: 20, features: ["shaman/spirit/battle/manifestation-battle"]),
                    ],
                ),
                (
                    key: "shaman/spirit/bones",
                    name: "Bones",
                    summary: "Bones: Touch of the Grave, Shard Soul DR and burst at 8th, incorporeal Shedding Form at 16th, Power Word Kill at 20th.",
                    guide: "shaman#bones",
                    levels: [
                        (level: 1, features: ["shaman/spirit/bones/touch-of-the-grave"]),
                        (level: 8, features: ["shaman/spirit/bones/shard-soul"]),
                        (level: 16, features: ["shaman/spirit/bones/shedding-form"]),
                        (level: 20, features: ["shaman/spirit/bones/manifestation-bones"]),
                    ],
                ),
                (
                    key: "shaman/spirit/flame",
                    name: "Flame",
                    summary: "Flame: Touch of Flames, fire resistance and a cone at 8th, fire elemental form at 16th, free fire metamagic at 20th.",
                    guide: "shaman#flame",
                    levels: [
                        (level: 1, features: ["shaman/spirit/flame/touch-of-flames"]),
                        (level: 8, features: ["shaman/spirit/flame/fiery-soul"]),
                        (level: 16, features: ["shaman/spirit/flame/elemental-form-fire"]),
                        (level: 20, features: ["shaman/spirit/flame/manifestation-flame"]),
                    ],
                ),
                (
                    key: "shaman/spirit/frost",
                    name: "Frost",
                    summary: "Frost: Ice Splinter, cold resistance and a burst at 8th, smilodon form at 16th, cold immunity at 20th; needed for Winter Witch.",
                    guide: "shaman#frost",
                    levels: [
                        (level: 1, features: ["shaman/spirit/frost/ice-splinter"]),
                        (level: 8, features: ["shaman/spirit/frost/frigid-blast"]),
                        (level: 16, features: ["shaman/spirit/frost/guardian-of-the-north"]),
                        (level: 20, features: ["shaman/spirit/frost/manifestation-frost"]),
                    ],
                ),
                (
                    key: "shaman/spirit/life",
                    name: "Life",
                    summary: "Life: Channel positive energy, Healer's Touch at 8th, swift Quick Healing at 16th, immunity to many conditions at 20th.",
                    guide: "shaman#life",
                    levels: [
                        (level: 1, features: ["shaman/spirit/life/channel"]),
                        (level: 8, features: ["shaman/spirit/life/healers-touch"]),
                        (level: 16, features: ["shaman/spirit/life/quick-healing"]),
                        (level: 20, features: ["shaman/spirit/life/manifestation-life"]),
                    ],
                ),
                (
                    key: "shaman/spirit/nature",
                    name: "Nature",
                    summary: "Nature: Storm Burst concealment, Spirit of Nature at 8th, an animal companion at 16th, a restoring form change at 20th.",
                    guide: "shaman#nature",
                    levels: [
                        (level: 1, features: ["shaman/spirit/nature/storm-burst"]),
                        (level: 8, features: ["shaman/spirit/nature/spirit-of-nature"]),
                        (level: 16, features: ["shaman/spirit/nature/companion-animal"]),
                        (level: 20, features: ["shaman/spirit/nature/manifestation-nature"]),
                    ],
                ),
                (
                    key: "shaman/spirit/stone",
                    name: "Stone",
                    summary: "Stone: Touch of Acid, DR/adamantine and a burst at 8th, earth elemental form at 16th, free acid metamagic at 20th.",
                    guide: "shaman#stone",
                    levels: [
                        (level: 1, features: ["shaman/spirit/stone/touch-of-acid"]),
                        (level: 8, features: ["shaman/spirit/stone/body-of-earth"]),
                        (level: 16, features: ["shaman/spirit/stone/elemental-form-earth"]),
                        (level: 20, features: ["shaman/spirit/stone/manifestation-stone"]),
                    ],
                ),
                (
                    key: "shaman/spirit/waves",
                    name: "Waves",
                    summary: "Waves: Wave Strike bull rush, a cold cone that pushes at 8th, water elemental form at 16th, free cold metamagic at 20th.",
                    guide: "shaman#waves",
                    levels: [
                        (level: 1, features: ["shaman/spirit/waves/wave-strike"]),
                        (level: 8, features: ["shaman/spirit/waves/fluid-mastery"]),
                        (level: 16, features: ["shaman/spirit/waves/elemental-form-water"]),
                        (level: 20, features: ["shaman/spirit/waves/manifestation-waves"]),
                    ],
                ),
                (
                    key: "shaman/spirit/wind",
                    name: "Wind",
                    summary: "Wind: Shocking Touch, electricity resistance and a line at 8th, air elemental form at 16th, free electricity metamagic at 20th.",
                    guide: "shaman#wind",
                    levels: [
                        (level: 1, features: ["shaman/spirit/wind/shocking-touch"]),
                        (level: 8, features: ["shaman/spirit/wind/spark-soul"]),
                        (level: 16, features: ["shaman/spirit/wind/elemental-form-wind"]),
                        (level: 20, features: ["shaman/spirit/wind/manifestation-wind"]),
                    ],
                ),
            ],
        ),
    ],
    levels: [
        (level: 1, divine_spell_level: 1, features: ["shaman/orisons", "shaman/spirit-animal"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"], selections: ["shaman/spirit"]),
        (level: 2, divine_spell_level: 1, selections: ["shaman/hex"]),
        (level: 3, divine_spell_level: 2),
        (level: 4, divine_spell_level: 2, features: ["shaman/wandering-spirit"], selections: ["shaman/hex"]),
        (level: 5, divine_spell_level: 3),
        (level: 6, divine_spell_level: 3, features: ["shaman/wandering-hex"]),
        (level: 7, divine_spell_level: 4),
        (level: 8, divine_spell_level: 4, selections: ["shaman/hex"]),
        (level: 9, divine_spell_level: 5),
        (level: 10, divine_spell_level: 5, selections: ["shaman/hex"]),
        (level: 11, divine_spell_level: 6),
        (level: 12, divine_spell_level: 6, features: ["shaman/wandering-spirit-greater-ability"], selections: ["shaman/hex"]),
        (level: 13, divine_spell_level: 7),
        (level: 14, divine_spell_level: 7, features: ["shaman/wandering-hex"]),
        (level: 15, divine_spell_level: 8),
        (level: 16, divine_spell_level: 8, selections: ["shaman/hex"]),
        (level: 17, divine_spell_level: 9),
        (level: 18, divine_spell_level: 9, selections: ["shaman/hex"]),
        (level: 19, divine_spell_level: 9),
        (level: 20, divine_spell_level: 9, features: ["shaman/wandering-spirit-true-ability"], selections: ["shaman/hex"]),
    ],
    archetypes: [
        (
            key: "shaman/possessed-shaman",
            name: "Possessed Shaman",
            summary: "Gets skills from its spirit instead of spirit spells, resists charm and compulsion, but has fewer hexes.",
            guide: "shaman#possessed-shaman",
            features: [
                (key: "shaman/possessed-shaman/crowded-vessel", name: "Crowded Vessel", summary: "When you fail a save against a charm or compulsion effect, you get a second save to resist it.", guide: "shaman#crowded-vessel"),
                (key: "shaman/possessed-shaman/orisons", name: "Orisons", guide: "shaman#possessed-shaman"),
                (key: "shaman/possessed-shaman/shared-skills", name: "Shared Skills", summary: "Pick two skills: your rank in each equals your class level and uses Wisdom; replaces spirit magic, so no spirit spells.", guide: "shaman#shared-skills"),
                (key: "shaman/possessed-shaman/wandering-skills", name: "Wandering Skills", summary: "When bonded to a wandering spirit, pick a skill with rank equal to class level using Wisdom; changeable each rest.", guide: "shaman#wandering-skills"),
                (key: "shaman/possessed-shaman/wandering-spirit-greater-ability", name: "Wandering Spirit - Greater Ability", summary: "From 12th level, you also gain your wandering spirit's greater ability.", guide: "shaman#possessed-shaman"),
                (key: "shaman/possessed-shaman/wandering-spirit-true-ability", name: "Wandering Spirit - True Ability", summary: "At 20th level, you also gain your wandering spirit's true ability.", guide: "shaman#possessed-shaman"),
            ],
            levels: [
                (level: 1, features: ["shaman/possessed-shaman/orisons", "shaman/possessed-shaman/shared-skills", "shaman/spirit-animal"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"], selections: ["shaman/spirit"]),
                (level: 2, features: ["shaman/possessed-shaman/crowded-vessel"]),
                (level: 6, features: ["shaman/possessed-shaman/wandering-skills"]),
                (level: 12, features: ["shaman/possessed-shaman/wandering-spirit-greater-ability"], selections: ["shaman/hex"]),
                (level: 20, features: ["shaman/possessed-shaman/wandering-spirit-true-ability"], selections: ["shaman/hex"]),
            ],
        ),
        (
            key: "shaman/prophet-of-pestilence",
            name: "Prophet of Pestilence",
            summary: "Lord of Nothing DLC disease shaman with the fixed Pestilence spirit, no familiar and fewer hexes; neutral, neutral evil or chaotic evil only.",
            guide: "shaman#prophet-of-pestilence",
            prerequisite: Any([Alignment(TrueNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
            features: [
                (key: "shaman/prophet-of-pestilence/a-thousand-diseases", name: "A Thousand Diseases", summary: "At 20th level, enemies within 30 feet catch the Plague of Abaddon unless they pass Fortitude; diseased ones get no save.", guide: "shaman#a-thousand-diseases"),
                (key: "shaman/prophet-of-pestilence/fatal-disease", name: "Fatal Disease", summary: "From 16th level, saves against your disease spells and abilities are rolled twice, taking the worse.", guide: "shaman#fatal-disease"),
                (key: "shaman/prophet-of-pestilence/mutating-spirit", name: "Mutating Spirit", summary: "At 4th level, immune to sickened and +4 against disease and nausea; at 12th, immune to nausea, poison and disease, with +2 to your disease DCs.", guide: "shaman#mutating-spirit"),
                (key: "shaman/prophet-of-pestilence/orisons", name: "Orisons", guide: "shaman#prophet-of-pestilence"),
                (key: "shaman/prophet-of-pestilence/pestilence-spirit", name: "Pestilence Spirit", summary: "The Prophet of Pestilence's own spirit, open to no one else, with unique disease abilities.", guide: "shaman#pestilence-spirit"),
                (key: "shaman/prophet-of-pestilence/plague-of-abaddon", name: "Plague of Abaddon", summary: "From 2nd level, infect a creature that fails Fortitude with a plague lasting class level rounds or until it saves.", guide: "shaman#plague-of-abaddon"),
                (key: "shaman/prophet-of-pestilence/plagues-caress", name: "Plague\'s Caress", summary: "Melee touch sickens the target for half your class level in rounds (disease); 3 + Charisma modifier uses a day.", guide: "shaman#plagues-caress"),
                (key: "shaman/prophet-of-pestilence/rapid-spread", name: "Rapid Spread", summary: "From 8th level, melee attackers without reach catch the plague unless they pass Fortitude (DC 10 + half level + Wis); plague range 30 feet.", guide: "shaman#rapid-spread"),
            ],
            selections: [
                (
                    key: "shaman/prophet-of-pestilence/carrier-of-disease",
                    name: "Carrier of Disease",
                    summary: "At 2nd level and every four levels after, pick a mutation for the Plague of Abaddon.",
                    guide: "shaman#carrier-of-disease",
                    options: [
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-addle-mind", name: "Plague Mutation: Addle Mind", summary: "From 18th level, needs a mental damage mutation: plague victims are confused.", guide: "shaman#plague-mutation-addle-mind", prerequisite: All([Any([SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-charisma-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-intelligence-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-wisdom-damage")]), ClassLevel(class: "shaman", level: 18)])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-charisma-damage", name: "Plague Mutation: Charisma Damage", summary: "The plague deals 1d4 Charisma damage.", guide: "shaman#plague-mutation-charisma-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage", name: "Plague Mutation: Constitution Damage", summary: "The plague deals 1d4 Constitution damage.", guide: "shaman#plague-mutation-constitution-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-contagiousness", name: "Plague Mutation: Contagiousness", summary: "From 10th level, creatures within 10 feet of a new victim catch the plague too unless they pass Fortitude.", guide: "shaman#plague-mutation-contagiousness", prerequisite: ClassLevel(class: "shaman", level: 10)),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-defenseless-host", name: "Plague Mutation: Defenseless Host", summary: "From 14th level: another -2 on Fortitude, and victims are affected for 1 round by poison or disease even on a successful save.", guide: "shaman#plague-mutation-defenseless-host", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-vulnerable-host")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage", name: "Plague Mutation: Dexterity Damage", summary: "The plague deals 1d4 Dexterity damage.", guide: "shaman#plague-mutation-dexterity-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-drain-body", name: "Plague Mutation: Drain Body", summary: "From 10th level, needs a physical damage mutation: plague victims are sickened and fatigued.", guide: "shaman#plague-mutation-drain-body", prerequisite: All([Any([SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")]), ClassLevel(class: "shaman", level: 10)])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-drain-mind", name: "Plague Mutation: Drain Mind", summary: "From 10th level, needs a mental damage mutation: plague victims are shaken.", guide: "shaman#plague-mutation-drain-mind", prerequisite: All([Any([SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-charisma-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-intelligence-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-wisdom-damage")]), ClassLevel(class: "shaman", level: 10)])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dulled-reactions", name: "Plague Mutation: Dulled Reactions", summary: "From 10th level, with Dexterity Damage: victims take -2 AC, Reflex, and Dex-based attacks, checks and skills.", guide: "shaman#plague-mutation-dulled-reactions", prerequisite: All([ClassLevel(class: "shaman", level: 10), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-erode-body", name: "Plague Mutation: Erode Body", summary: "From 14th level: victims are exhausted and must pass Fortitude to attack or cast, or lose the action and be nauseated 1 round.", guide: "shaman#plague-mutation-erode-body", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-erode-mind", name: "Plague Mutation: Erode Mind", summary: "From 14th level, with all three mental damage mutations: victims' spells and spell-like abilities get -2 DC.", guide: "shaman#plague-mutation-erode-mind", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-charisma-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-intelligence-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-wisdom-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-intelligence-damage", name: "Plague Mutation: Intelligence Damage", summary: "The plague deals 1d4 Intelligence damage.", guide: "shaman#plague-mutation-intelligence-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-muscle-atrophy", name: "Plague Mutation: Muscle Atrophy", summary: "From 14th level, with Muscle Feebleness: plague victims take 2 more Strength damage and their speed drops by 15 feet.", guide: "shaman#plague-mutation-muscle-atrophy", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-muscle-feebleness"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-muscle-feebleness", name: "Plague Mutation: Muscle Feebleness", summary: "From 10th level, with Strength Damage: victims take 2 Strength damage and lose 10 feet of speed.", guide: "shaman#plague-mutation-muscle-feebleness", prerequisite: All([ClassLevel(class: "shaman", level: 10), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-new-strain", name: "Plague Mutation: New Strain", summary: "From 10th level, the plague's ability damage rises a die step (1d4 to 1d6, 1d6 to 1d8); can be taken more than once.", guide: "shaman#plague-mutation-new-strain", repeat: Unlimited, prerequisite: ClassLevel(class: "shaman", level: 10)),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-staggered-body", name: "Plague Mutation: Staggered Body", summary: "From 14th level, with all three physical damage mutations: plague victims are staggered.", guide: "shaman#plague-mutation-staggered-body", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-stiffened-limbs", name: "Plague Mutation: Stiffened Limbs", summary: "From 14th level, with Dulled Reactions: victims make no attacks of opportunity and are flat-footed.", guide: "shaman#plague-mutation-stiffened-limbs", prerequisite: All([ClassLevel(class: "shaman", level: 14), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dexterity-damage"), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-dulled-reactions")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-strength-damage", name: "Plague Mutation: Strength Damage", summary: "The plague deals 1d4 Strength damage.", guide: "shaman#plague-mutation-strength-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-virulence", name: "Plague Mutation: Virulence", summary: "From 18th level, the plague's ability damage doubles to 2d4 or 2d6.", guide: "shaman#plague-mutation-virulence", prerequisite: ClassLevel(class: "shaman", level: 18)),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-vulnerable-host", name: "Plague Mutation: Vulnerable Host", summary: "From 10th level, with Constitution Damage: plague victims take -2 on Fortitude saves.", guide: "shaman#plague-mutation-vulnerable-host", prerequisite: All([ClassLevel(class: "shaman", level: 10), SelectionOption("shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-constitution-damage")])),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-wisdom-damage", name: "Plague Mutation: Wisdom Damage", summary: "The plague deals 1d4 Wisdom damage.", guide: "shaman#plague-mutation-wisdom-damage"),
                        (key: "shaman/prophet-of-pestilence/carrier-of-disease/plague-mutation-withering", name: "Plague Mutation: Withering", summary: "From 14th level, the plague also gives 1 negative level.", guide: "shaman#plague-mutation-withering", prerequisite: ClassLevel(class: "shaman", level: 14)),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["shaman/prophet-of-pestilence/orisons", "shaman/prophet-of-pestilence/pestilence-spirit", "shaman/prophet-of-pestilence/plagues-caress"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"]),
                (level: 2, features: ["shaman/prophet-of-pestilence/plague-of-abaddon"], selections: ["shaman/prophet-of-pestilence/carrier-of-disease"]),
                (level: 4, features: ["shaman/prophet-of-pestilence/mutating-spirit"], selections: ["shaman/hex"]),
                (level: 6, selections: ["shaman/prophet-of-pestilence/carrier-of-disease"]),
                (level: 8, features: ["shaman/prophet-of-pestilence/rapid-spread"], selections: ["shaman/hex"]),
                (level: 10, selections: ["shaman/prophet-of-pestilence/carrier-of-disease"]),
                (level: 12, features: ["shaman/prophet-of-pestilence/mutating-spirit"], selections: ["shaman/hex"]),
                (level: 14, selections: ["shaman/prophet-of-pestilence/carrier-of-disease"]),
                (level: 16, features: ["shaman/prophet-of-pestilence/fatal-disease"], selections: ["shaman/hex"]),
                (level: 18, selections: ["shaman/prophet-of-pestilence/carrier-of-disease"]),
                (level: 20, features: ["shaman/prophet-of-pestilence/a-thousand-diseases"], selections: ["shaman/hex"]),
            ],
        ),
        (
            key: "shaman/shadow-shaman",
            name: "Shadow Shaman",
            summary: "Gains sneak attack, Shadows and Stealth as a class skill, losing three hexes and the wandering spirit.",
            guide: "shaman#shadow-shaman",
            features: [
                (key: "shaman/shadow-shaman/orisons", name: "Orisons", guide: "shaman#shadow-shaman"),
                (key: "shaman/shadow-shaman/shadows", name: "Shadows", summary: "From 4th level, Blur Charisma modifier times a day; Displacement instead from 9th and Greater Invisibility from 14th.", guide: "shaman#shadows"),
                (key: "shaman/shadow-shaman/sneak-attack", name: "Sneak Attack", summary: "+1d6 damage against foes denied Dex or flanked from 3rd level, +1d6 every three levels (+6d6 at 18th).", guide: "shaman#sneak-attack"),
            ],
            levels: [
                (level: 1, features: ["shaman/shadow-shaman/orisons", "shaman/spirit-animal"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"], selections: ["shaman/spirit"]),
                (level: 3, features: ["shaman/shadow-shaman/sneak-attack"]),
                (level: 4, features: ["shaman/shadow-shaman/shadows"]),
                (level: 6, features: ["shaman/shadow-shaman/sneak-attack"]),
                (level: 9, features: ["shaman/shadow-shaman/shadows", "shaman/shadow-shaman/sneak-attack"]),
                (level: 12, features: ["shaman/shadow-shaman/sneak-attack"], selections: ["shaman/hex"]),
                (level: 14, features: ["shaman/shadow-shaman/shadows"]),
                (level: 15, features: ["shaman/shadow-shaman/sneak-attack"]),
                (level: 18, features: ["shaman/shadow-shaman/sneak-attack"], selections: ["shaman/hex"]),
                (level: 20, selections: ["shaman/hex"]),
            ],
        ),
        (
            key: "shaman/spirit-hunter",
            name: "Spirit Hunter",
            summary: "Enchants its weapon and has an object bond instead of a familiar, losing the wandering spirit.",
            guide: "shaman#spirit-hunter",
            features: [
                (key: "shaman/spirit-hunter/object-bond", name: "Object Bond", summary: "Once a day, the bonded object restores one prepared spell.", guide: "shaman#object-bond"),
                (key: "shaman/spirit-hunter/orisons", name: "Orisons", guide: "shaman#spirit-hunter"),
                (key: "shaman/spirit-hunter/spirit-weapon-enchantment", name: "Spirit Weapon Enchantment", summary: "Swift action: +1 weapon enhancement (+5 at 17th) for 1 minute per level, usable for ghost touch or, from 5th, other properties; half level + Wis uses a day.", guide: "shaman#spirit-weapon-enchantment"),
            ],
            levels: [
                (level: 1, features: ["shaman/spirit-hunter/object-bond", "shaman/spirit-hunter/orisons", "shaman/spirit-hunter/spirit-weapon-enchantment"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"], selections: ["shaman/spirit"]),
                (level: 4, selections: ["shaman/hex"]),
                (level: 5, features: ["shaman/spirit-hunter/spirit-weapon-enchantment"]),
                (level: 6),
                (level: 9, features: ["shaman/spirit-hunter/spirit-weapon-enchantment"]),
                (level: 12, selections: ["shaman/hex"]),
                (level: 13, features: ["shaman/spirit-hunter/spirit-weapon-enchantment"]),
                (level: 14),
                (level: 17, features: ["shaman/spirit-hunter/spirit-weapon-enchantment"]),
                (level: 20, selections: ["shaman/hex"]),
            ],
        ),
        (
            key: "shaman/spirit-warden",
            name: "Spirit Warden",
            summary: "Hunts evil spirits: extra necromancy spells, +2 Intimidate, channel against undead and +4 vs death effects; two fewer hexes.",
            guide: "shaman#spirit-warden",
            features: [
                (key: "shaman/spirit-warden/laugh-at-death", name: "Laugh at Death", summary: "From 10th level, +4 insight on saves against death effects.", guide: "shaman#laugh-at-death"),
                (key: "shaman/spirit-warden/orisons", name: "Orisons", guide: "shaman#spirit-warden"),
                (key: "shaman/spirit-warden/rebuke-spirits", name: "Rebuke Spirits", summary: "From 2nd level, channel positive energy only to harm undead, 3 + Charisma modifier times a day.", guide: "shaman#rebuke-spirits"),
                (key: "shaman/spirit-warden/restless-magic", name: "Restless Magic", summary: "Adds spells you can pick, from Doom and Command Undead to Finger of Death, Sunburst and Foresight.", guide: "shaman#restless-magic"),
                (key: "shaman/spirit-warden/unnatural-mien", name: "Unnatural Mien", summary: "+2 on Intimidate checks.", guide: "shaman#unnatural-mien"),
                (key: "shaman/spirit-warden/wandering-spirit-greater-ability", name: "Wandering Spirit - Greater Ability", summary: "From 12th level, you also gain your wandering spirit's greater ability.", guide: "shaman#spirit-warden"),
                (key: "shaman/spirit-warden/wandering-spirit-true-ability", name: "Wandering Spirit - True Ability", summary: "At 20th level, you also gain your wandering spirit's true ability.", guide: "shaman#spirit-warden"),
            ],
            levels: [
                (level: 1, features: ["shaman/spirit-animal", "shaman/spirit-warden/orisons", "shaman/spirit-warden/restless-magic", "shaman/spirit-warden/unnatural-mien"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"], selections: ["shaman/spirit"]),
                (level: 2, features: ["shaman/spirit-warden/rebuke-spirits"]),
                (level: 10, features: ["shaman/spirit-warden/laugh-at-death"]),
                (level: 12, features: ["shaman/spirit-warden/wandering-spirit-greater-ability"], selections: ["shaman/hex"]),
                (level: 20, features: ["shaman/spirit-warden/wandering-spirit-true-ability"], selections: ["shaman/hex"]),
            ],
        ),
        (
            key: "shaman/unsworn-shaman",
            name: "Unsworn Shaman",
            summary: "Bonds only with wandering spirits (two from 6th level) and daily minor spirits for hexes, with no permanent hexes.",
            guide: "shaman#unsworn-shaman",
            features: [
                (key: "shaman/unsworn-shaman/minor-spirit", name: "Minor Spirit", summary: "Each day pick a basic shaman or witch hex, one more every fourth level; from 2nd, a wandering spirit's hex instead.", guide: "shaman#minor-spirit", daily_choice: true),
                (key: "shaman/unsworn-shaman/orisons", name: "Orisons", guide: "shaman#unsworn-shaman"),
                (key: "shaman/unsworn-shaman/wandering-spirit-2", name: "Wandering Spirit 2", summary: "A wandering spirit at 2nd level and a second at 6th, using the bonded spirits' abilities.", guide: "shaman#wandering-spirit-2", daily_choice: true),
                (key: "shaman/unsworn-shaman/wandering-spirit-2-greater-ability", name: "Wandering Spirit 2 - Greater Ability", summary: "From 14th level, you also gain your second wandering spirit's greater ability.", guide: "shaman#unsworn-shaman"),
                (key: "shaman/unsworn-shaman/wandering-spirit-2-true-ability", name: "Wandering Spirit 2 - True Ability", summary: "At 20th level, you also gain your second wandering spirit's true ability.", guide: "shaman#unsworn-shaman"),
                (key: "shaman/unsworn-shaman/wandering-spirit-greater-ability", name: "Wandering Spirit - Greater Ability", summary: "From 10th level, you also gain your wandering spirit's greater ability.", guide: "shaman#unsworn-shaman"),
                (key: "shaman/unsworn-shaman/wandering-spirit-true-ability", name: "Wandering Spirit - True Ability", summary: "From 18th level, you also gain your wandering spirit's true ability.", guide: "shaman#unsworn-shaman"),
            ],
            levels: [
                (level: 1, features: ["shaman/spirit-animal", "shaman/unsworn-shaman/minor-spirit", "shaman/unsworn-shaman/orisons"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"]),
                (level: 2, features: ["shaman/wandering-spirit"]),
                (level: 4, features: ["shaman/unsworn-shaman/minor-spirit"]),
                (level: 6, features: ["shaman/unsworn-shaman/wandering-spirit-2"]),
                (level: 8, features: ["shaman/unsworn-shaman/minor-spirit"]),
                (level: 10, features: ["shaman/unsworn-shaman/wandering-spirit-greater-ability"]),
                (level: 12, features: ["shaman/unsworn-shaman/minor-spirit"]),
                (level: 14, features: ["shaman/unsworn-shaman/wandering-spirit-2-greater-ability"]),
                (level: 16, features: ["shaman/unsworn-shaman/minor-spirit"]),
                (level: 18, features: ["shaman/unsworn-shaman/wandering-spirit-true-ability"]),
                (level: 20, features: ["shaman/unsworn-shaman/minor-spirit", "shaman/unsworn-shaman/wandering-spirit-2-true-ability"]),
            ],
        ),
        (
            key: "shaman/wildland-shaman",
            name: "Wildland Shaman",
            summary: "Half-orc only: the Battle spirit and any animal companion instead of a familiar, with no wandering spirits.",
            guide: "shaman#wildland-shaman",
            prerequisite: Race("half-orc"),
            features: [
                (key: "shaman/wildland-shaman/animal-companion", name: "Animal Companion", summary: "Gives you any animal companion.", guide: "shaman#animal-companion"),
                (key: "shaman/wildland-shaman/battle-hex", name: "Battle Hex", summary: "At 6th and 14th level, a hex slot for a hex with no spirit requirement or with the Battle requirement.", guide: "shaman#battle-hex"),
                (key: "shaman/wildland-shaman/orisons", name: "Orisons", guide: "shaman#wildland-shaman"),
            ],
            selections: [
                (
                    key: "shaman/wildland-shaman/spirit",
                    name: "Spirit (Wildland Shaman)",
                    summary: "The Wildland Shaman's spirit: Battle only.",
                    guide: "shaman#wildland-shaman",
                    option_levels: ["shaman"],
                    options: [],
                    shared_options: [
                        "shaman/spirit/battle",
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["shaman/wildland-shaman/animal-companion", "shaman/wildland-shaman/orisons"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "simple-weapon-proficiency"], selections: ["shaman/wildland-shaman/spirit"]),
