                (level: 17, selections: ["slayer/slayer-talents"]),
                (level: 19, features: ["inquisitor/sanctified-slayer/sneak-attack"]),
                (level: 20, selections: ["slayer/slayer-talents"]),
            ],
        ),
        (
            key: "inquisitor/tactical-leader",
            name: "Tactical Leader",
            summary: "Inquisitor who shares teamwork feats and judgment bonuses with allies, with fewer teamwork feats.",
            guide: "inquisitor#tactical-leader",
            features: [
                (key: "inquisitor/tactical-leader/battle-acumen", name: "Battle Acumen", summary: "From 14th level, gives one ally within 30 feet his judgment bonuses for 1 minute, Wis times a day.", guide: "inquisitor#battle-acumen"),
                (key: "inquisitor/tactical-leader/leaders-words", name: "Leader\'s Words", summary: "Morale bonus equal to half the class level on Persuasion (Diplomacy) checks.", guide: "inquisitor#leaders-words"),
                (key: "inquisitor/tactical-leader/orisons", name: "Orisons", guide: "inquisitor#tactical-leader"),
                (key: "inquisitor/tactical-leader/swift-tactician", name: "Swift Tactician", summary: "From 3rd level, shares his teamwork feats with allies within 30 feet for 3 + half level rounds; swift action from 12th.", guide: "inquisitor#swift-tactician"),
