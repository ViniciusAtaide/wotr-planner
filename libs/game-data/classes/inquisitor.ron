Class(
    key: "inquisitor",
    name: "Inquisitor",
    summary: "Wisdom-based spontaneous divine caster up to 6th level: 3/4 BAB, good Fortitude and Will, all class skills, a domain and judgments.",
    guide: "inquisitor",
    skill_points: 4,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
    prerequisite: Worships,
    spontaneous: true,
    features: [
        (key: "inquisitor/bane", name: "Bane", summary: "From 5th level, swift action for class level rounds a day: weapon gets +2 enhancement and +2d6 damage against a chosen foe.", guide: "inquisitor#bane"),
        (key: "inquisitor/cunning-initiative", name: "Cunning Initiative", summary: "From 2nd level, adds both Wisdom and Dexterity modifiers to initiative.", guide: "inquisitor#cunning-initiative"),
        (key: "inquisitor/exploit-weakness", name: "Exploit Weakness", summary: "From 14th level, confirmed critical hits bypass DR and stop the target's regeneration for 1 round.", guide: "inquisitor#exploit-weakness"),
        (key: "inquisitor/greater-bane", name: "Greater Bane", summary: "From 12th level, Bane deals +4d6 damage per hit.", guide: "inquisitor#greater-bane"),
        (key: "inquisitor/inquisitor-proficiencies", favoured_weapon_proficiency: true, name: "Inquisitor Proficiencies", guide: "inquisitor#inquisitor-proficiencies"),
        (key: "inquisitor/orisons", name: "Orisons", guide: "inquisitor"),
        (key: "inquisitor/second-judgment", name: "Second Judgment", summary: "From 8th level, one use of Judgment pronounces two judgments.", guide: "inquisitor#second-judgment"),
        (key: "inquisitor/solo-tactics", name: "Solo Tactics", summary: "From 3rd level, gets the benefit of his teamwork feats even if allies lack them, as long as their position and actions fit.", guide: "inquisitor#solo-tactics"),
        (key: "inquisitor/stalwart", name: "Stalwart", summary: "From 11th level, a successful Fortitude or Will save against a half-damage effect means no damage; not in heavy armour.", guide: "inquisitor#stalwart"),
        (key: "inquisitor/stern-gaze", name: "Stern Gaze", summary: "Morale bonus equal to half the class level on Perception and Persuasion (Intimidate) checks.", guide: "inquisitor#stern-gaze"),
        (key: "inquisitor/third-judgment", name: "Third Judgment", summary: "From 16th level, one use of Judgment pronounces three judgments.", guide: "inquisitor#third-judgment"),
        (key: "inquisitor/true-judgment", name: "True Judgment", summary: "At 20th level, with a judgment he can make a swift attack whose target saves on Fort (DC 20 + Wis) or dies; a target that saves is immune.", guide: "inquisitor#true-judgment"),
    ],
    selections: [
        (
            key: "inquisitor/domain",
            name: "Domain",
            summary: "Chooses a domain, without its bonus domain spells.",
            deity_domains: Offered,
            guide: "inquisitor",
            option_levels: ["inquisitor"],
            options: [],
            shared_options: [
                "cleric/domain/air",
                "cleric/domain/animal",
                "cleric/domain/artifice",
                "cleric/domain/chaos",
                "cleric/domain/charm",
                "cleric/domain/community",
                "cleric/domain/darkness",
                "cleric/domain/death",
                "cleric/domain/destruction",
                "cleric/domain/earth",
                "cleric/domain/evil",
                "cleric/domain/fire",
                "cleric/domain/glory",
                "cleric/domain/good",
                "cleric/domain/healing",
                "cleric/domain/ice",
                "cleric/domain/knowledge",
                "cleric/domain/law",
                "cleric/domain/liberation",
                "cleric/domain/luck",
                "cleric/domain/madness",
                "cleric/domain/magic",
                "cleric/domain/murder",
                "cleric/domain/nobility",
                "cleric/domain/plant",
                "cleric/domain/protection",
                "cleric/domain/repose",
                "cleric/domain/rune",
                "cleric/domain/scalykind",
                "cleric/domain/strength",
                "cleric/domain/sun",
                "cleric/domain/travel",
                "cleric/domain/trickery",
                "cleric/domain/undead",
                "cleric/domain/war",
                "cleric/domain/water",
                "cleric/domain/weather",
            ],
        ),
        (
            key: "inquisitor/judgment",
            name: "Judgment",
            summary: "Swift action: a judgment's bonus lasts until combat ends; once a day at 1st, twice at 4th, 3 times at 7th, up to 7 at 19th.",
            guide: "inquisitor#judgment",
            options: [
                (key: "inquisitor/judgment/judgement-resiliency", name: "Judgement - Resiliency", summary: "DR 1/magic, +1 per 5 levels; from 10th level it bypasses only the alignment opposite his.", guide: "inquisitor#judgement-resiliency"),
                (key: "inquisitor/judgment/judgement-resistance", name: "Judgement - Resistance", summary: "Resistance 2 to all energy types, +2 per 3 levels.", guide: "inquisitor#judgement-resistance"),
                (key: "inquisitor/judgment/judgment-destruction", name: "Judgment - Destruction", summary: "+1 sacred bonus to damage rolls, +1 per 3 levels.", guide: "inquisitor#judgment-destruction"),
                (key: "inquisitor/judgment/judgment-healing", name: "Judgment - Healing", summary: "Fast healing 1, +1 per 3 levels.", guide: "inquisitor#judgment-healing"),
                (key: "inquisitor/judgment/judgment-justice", name: "Judgment - Justice", summary: "+1 sacred bonus to attack rolls, +1 per 5 levels; doubled on critical confirmation rolls from 10th level.", guide: "inquisitor#judgment-justice"),
                (key: "inquisitor/judgment/judgment-piercing", name: "Judgment - Piercing", summary: "+1 sacred bonus to concentration and caster level checks against spell resistance, +1 per 3 levels.", guide: "inquisitor#judgment-piercing"),
                (key: "inquisitor/judgment/judgment-protection", name: "Judgment - Protection", summary: "+1 sacred bonus to AC, +1 per 5 levels; doubled against critical confirmation rolls from 10th level.", guide: "inquisitor#judgment-protection"),
                (key: "inquisitor/judgment/judgment-purity", name: "Judgment - Purity", summary: "+1 sacred bonus to saving throws, +1 per 5 levels; doubled against curses, diseases and poisons from 10th level.", guide: "inquisitor#judgment-purity"),
                (key: "inquisitor/judgment/judgment-smiting", name: "Judgment - Smiting", summary: "Weapons count as magic for DR, also as his alignment from 6th level and as adamantine from 10th.", guide: "inquisitor#judgment-smiting"),
            ],
        ),
    ],
    levels: [
        (level: 1, divine_spell_level: 1, features: ["inquisitor/inquisitor-proficiencies", "inquisitor/orisons", "inquisitor/stern-gaze"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"], selections: ["inquisitor/domain", "inquisitor/judgment"]),
        (level: 2, divine_spell_level: 1, features: ["inquisitor/cunning-initiative"]),
        (level: 3, divine_spell_level: 1, features: ["inquisitor/solo-tactics"], feat_slots: [Category(Teamwork)]),
        (level: 4, divine_spell_level: 2),
        (level: 5, divine_spell_level: 2, features: ["inquisitor/bane"]),
        (level: 6, divine_spell_level: 2, feat_slots: [Category(Teamwork)]),
        (level: 7, divine_spell_level: 3),
        (level: 8, divine_spell_level: 3, features: ["inquisitor/second-judgment"]),
        (level: 9, divine_spell_level: 3, feat_slots: [Category(Teamwork)]),
        (level: 10, divine_spell_level: 4),
        (level: 11, divine_spell_level: 4, features: ["inquisitor/stalwart"]),
        (level: 12, divine_spell_level: 4, features: ["inquisitor/greater-bane"], feat_slots: [Category(Teamwork)]),
        (level: 13, divine_spell_level: 5),
        (level: 14, divine_spell_level: 5, features: ["inquisitor/exploit-weakness"]),
        (level: 15, divine_spell_level: 5, feat_slots: [Category(Teamwork)]),
        (level: 16, divine_spell_level: 6, features: ["inquisitor/third-judgment"]),
        (level: 17, divine_spell_level: 6),
        (level: 18, divine_spell_level: 6, feat_slots: [Category(Teamwork)]),
        (level: 19, divine_spell_level: 6),
        (level: 20, divine_spell_level: 6, features: ["inquisitor/true-judgment"]),
    ],
    archetypes: [
        (
            key: "inquisitor/faith-hunter",
            name: "Faith Hunter",
            summary: "Inquisitor who smites a hated alignment instead of having a domain.",
            guide: "inquisitor#faith-hunter",
            features: [
                (key: "inquisitor/faith-hunter/orisons", name: "Orisons", guide: "inquisitor#faith-hunter"),
                (key: "inquisitor/faith-hunter/sworn-enemy", name: "Sworn Enemy", summary: "Chooses a hated alignment (Chaotic, Evil, Good or Lawful) opposed to his deity's.", guide: "inquisitor#sworn-enemy"),
                (key: "inquisitor/faith-hunter/sworn-enemy-smite", name: "Sworn Enemy - Smite", summary: "From 6th level, swift smite on a foe of the hated alignment: +4 attack and +half level damage until it dies; +1 use at 10th, 14th, 18th.", guide: "inquisitor#sworn-enemy-smite"),
            ],
            levels: [
                (level: 1, features: ["inquisitor/faith-hunter/orisons", "inquisitor/faith-hunter/sworn-enemy", "inquisitor/inquisitor-proficiencies", "inquisitor/stern-gaze"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"], selections: ["inquisitor/judgment"]),
                (level: 6, features: ["inquisitor/faith-hunter/sworn-enemy-smite"], feat_slots: [Category(Teamwork)]),
            ],
        ),
        (
            key: "inquisitor/judge",
            name: "Judge",
            summary: "Inquisitor who shares judgments and a damage-boosting sentence with the party, losing teamwork feats and Bane.",
            guide: "inquisitor#judge",
            features: [
                (key: "inquisitor/judge/greater-sentence", name: "Greater Sentence", summary: "From 12th level, the party's attacks against a sentenced enemy ignore concealment.", guide: "inquisitor#greater-sentence"),
                (key: "inquisitor/judge/judgment-aura", name: "Judgment Aura", summary: "From 3rd level, swift action shares his judgments with allies within 30 feet until combat ends; once a day, +1 per 6 levels.", guide: "inquisitor#judgment-aura"),
                (key: "inquisitor/judge/orisons", name: "Orisons", guide: "inquisitor#judge"),
                (key: "inquisitor/judge/sentence", name: "Sentence", summary: "From 5th level, swift action: the party deals +1 damage per 3 class levels to a sentenced enemy; once a day, +1 per 5 levels.", guide: "inquisitor#sentence"),
            ],
            levels: [
                (level: 1, features: ["inquisitor/inquisitor-proficiencies", "inquisitor/judge/orisons", "inquisitor/stern-gaze"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"], selections: ["inquisitor/domain", "inquisitor/judgment"]),
                (level: 3, features: ["inquisitor/judge/judgment-aura"]),
                (level: 5, features: ["inquisitor/judge/sentence"]),
                (level: 6),
                (level: 9),
                (level: 12, features: ["inquisitor/judge/greater-sentence"]),
                (level: 15),
                (level: 18),
            ],
        ),
        (
            key: "inquisitor/living-grimoire",
            name: "Living Grimoire",
            summary: "Dance of Masks inquisitor who prepares spells with Intelligence and fights with a holy book, without judgments or Bane.",
            guide: "inquisitor#living-grimoire",
            features: [
                (key: "inquisitor/living-grimoire/blessed-script", name: "Blessed Script", summary: "From 5th level, book hits raise his next spell's caster level and DC by +1 (+2 at 10th, +3 at 16th); spells give the book bane for 2 rounds.", guide: "inquisitor#blessed-script"),
                (key: "inquisitor/living-grimoire/holy-book", name: "Holy Book", summary: "A summoned book that hits as a cold iron light mace with +1 to attack and the Warpriest's Sacred Weapon bonuses.", guide: "inquisitor#holy-book"),
                (key: "inquisitor/living-grimoire/orisons", name: "Orisons", guide: "inquisitor#living-grimoire"),
                (key: "inquisitor/living-grimoire/sacred-word", name: "Sacred Word", summary: "From 4th level, swift action: +1 enhancement or properties on the holy book, +1 per 4 levels (max +5), for half level + Wis minutes a day.", guide: "inquisitor#sacred-word"),
                (key: "inquisitor/living-grimoire/spellbook", name: "Spellbook", summary: "Prepares known spells with Warpriest slots, learning 3 + Int spells at 1st level and 2 per level; Int sets domain DCs and uses.", guide: "inquisitor#spellbook"),
                (key: "inquisitor/living-grimoire/word-of-god", name: "Word of God", summary: "At 20th level, 7 times a day an enemy within 50 feet saves on Fort (DC 20 + Int, +4 after a spell) or dies; otherwise takes 10d6.", guide: "inquisitor#word-of-god"),
            ],
            levels: [
                (level: 1, features: ["inquisitor/inquisitor-proficiencies", "inquisitor/living-grimoire/holy-book", "inquisitor/living-grimoire/orisons", "inquisitor/living-grimoire/spellbook", "inquisitor/stern-gaze"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"], selections: ["inquisitor/domain"]),
                (level: 4, features: ["inquisitor/living-grimoire/sacred-word"]),
                (level: 5, features: ["inquisitor/living-grimoire/blessed-script"]),
                (level: 8, features: ["inquisitor/living-grimoire/sacred-word"]),
                (level: 12, features: ["inquisitor/living-grimoire/sacred-word"], feat_slots: [Category(Teamwork)]),
                (level: 16, features: ["inquisitor/living-grimoire/sacred-word"]),
                (level: 20, features: ["inquisitor/living-grimoire/sacred-word", "inquisitor/living-grimoire/word-of-god"]),
            ],
        ),
        (
            key: "inquisitor/monster-tactician",
            name: "Monster Tactician",
            summary: "Inquisitor who summons monsters as a spell-like ability instead of using judgments.",
            guide: "inquisitor#monster-tactician",
            features: [
                (key: "inquisitor/monster-tactician/orisons", name: "Orisons", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster", name: "Summon Monster", summary: "Casts Summon Monster spells 3 + Wis times a day; summons last 1 minute per level and a new casting ends the previous one.", guide: "inquisitor#summon-monster"),
                (key: "inquisitor/monster-tactician/summon-monster-i", name: "Summon Monster I", summary: "His Summon Monster ability can cast Summon Monster I.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster-ii", name: "Summon Monster II", summary: "His Summon Monster ability can cast Summon Monster II.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster-iii", name: "Summon Monster III", summary: "His Summon Monster ability can cast Summon Monster III.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster-iv", name: "Summon Monster IV", summary: "His Summon Monster ability can cast Summon Monster IV.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster-ix", name: "Summon Monster IX", summary: "His Summon Monster ability can cast Summon Monster IX.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster-v", name: "Summon Monster V", summary: "His Summon Monster ability can cast Summon Monster V.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster-vi", name: "Summon Monster VI", summary: "His Summon Monster ability can cast Summon Monster VI.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster-vii", name: "Summon Monster VII", summary: "His Summon Monster ability can cast Summon Monster VII.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-monster-viii", name: "Summon Monster VIII", summary: "His Summon Monster ability can cast Summon Monster VIII.", guide: "inquisitor#monster-tactician"),
                (key: "inquisitor/monster-tactician/summon-tactics", name: "Summon Tactics", summary: "From 5th level, his summons count as knowing all his teamwork feats.", guide: "inquisitor#summon-tactics"),
            ],
            levels: [
                (level: 1, features: ["inquisitor/inquisitor-proficiencies", "inquisitor/monster-tactician/orisons", "inquisitor/monster-tactician/summon-monster", "inquisitor/monster-tactician/summon-monster-i", "inquisitor/stern-gaze"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"], selections: ["inquisitor/domain"]),
                (level: 3, features: ["inquisitor/monster-tactician/summon-monster-ii", "inquisitor/solo-tactics"], feat_slots: [Category(Teamwork)]),
                (level: 5, features: ["inquisitor/bane", "inquisitor/monster-tactician/summon-monster-iii", "inquisitor/monster-tactician/summon-tactics"]),
                (level: 7, features: ["inquisitor/monster-tactician/summon-monster-iv"]),
                (level: 8),
                (level: 9, features: ["inquisitor/monster-tactician/summon-monster-v"], feat_slots: [Category(Teamwork)]),
                (level: 11, features: ["inquisitor/monster-tactician/summon-monster-vi", "inquisitor/stalwart"]),
                (level: 13, features: ["inquisitor/monster-tactician/summon-monster-vii"]),
                (level: 15, features: ["inquisitor/monster-tactician/summon-monster-viii"], feat_slots: [Category(Teamwork)]),
                (level: 16),
                (level: 17, features: ["inquisitor/monster-tactician/summon-monster-ix"]),
                (level: 20),
            ],
        ),
        (
            key: "inquisitor/sacred-huntsmaster",
            name: "Sacred Huntsmaster",
            summary: "Inquisitor with an animal companion and favoured enemies instead of judgments; cannot take the Animal domain.",
            guide: "inquisitor#sacred-huntsmaster",
            features: [
                (key: "inquisitor/sacred-huntsmaster/animal-companion", name: "Animal Companion", summary: "Gains an animal companion.", guide: "inquisitor#sacred-huntsmaster"),
                (key: "inquisitor/sacred-huntsmaster/favored-enemy", name: "Favored Enemy", summary: "A favoured enemy at 5th level and every 5 levels after.", guide: "inquisitor#favored-enemy"),
                (key: "inquisitor/sacred-huntsmaster/hunter-tactics", name: "Hunter Tactics", summary: "From 3rd level, his animal companion gets his teamwork feats.", guide: "inquisitor#hunter-tactics"),
                (key: "inquisitor/sacred-huntsmaster/orisons", name: "Orisons", guide: "inquisitor#sacred-huntsmaster"),
            ],
            selections: [
                (
                    key: "inquisitor/sacred-huntsmaster/domain",
