        (
            key: "inquisitor/sanctified-slayer",
            name: "Sanctified Slayer",
            summary: "Inquisitor with the Slayer's Studied Target, sneak attack and talents instead of judgments.",
            guide: "inquisitor#sanctified-slayer",
            features: [
                (key: "inquisitor/sanctified-slayer/orisons", name: "Orisons", guide: "inquisitor#sanctified-slayer"),
                (key: "inquisitor/sanctified-slayer/sneak-attack", name: "Sneak Attack", summary: "From 4th level, +1d6 damage against flanked foes or those denied Dexterity to AC, +1d6 per 3 levels (max 6d6 at 19th).", guide: "inquisitor#sneak-attack"),
                (key: "inquisitor/sanctified-slayer/studied-target", name: "Studied Target", summary: "As the Slayer's: move action to study a foe for +1 attack, damage and ability DCs against it, rising with level.", guide: "inquisitor#studied-target"),
                (key: "inquisitor/sanctified-slayer/studied-target-swift", name: "Studied Target (Swift)", summary: "As the Slayer's: Studied Target becomes a swift action.", guide: "inquisitor#sanctified-slayer"),
            ],
            levels: [
                (level: 1, features: ["inquisitor/inquisitor-proficiencies", "inquisitor/sanctified-slayer/orisons", "inquisitor/sanctified-slayer/studied-target", "inquisitor/stern-gaze"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"], selections: ["inquisitor/domain"]),
                (level: 4, features: ["inquisitor/sanctified-slayer/sneak-attack"]),
                (level: 7, features: ["inquisitor/sanctified-slayer/sneak-attack", "inquisitor/sanctified-slayer/studied-target-swift"]),
                (level: 8, selections: ["slayer/slayer-talents"]),
