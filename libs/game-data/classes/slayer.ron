Class(
    key: "slayer",
    blueprint: "c75e0971973957d4dbad24bc7957e4fb",
    name: "Slayer",
    summary: "Full-BAB hunter: 7 HP per level, good Fortitude and Reflex, Studied Target for bonuses against one foe, sneak attack from 3rd level and slayer talents.",
    guide: "slayer",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["athletics", "knowledge-world", "lore-nature", "mobility", "perception", "persuasion", "stealth"],
    features: [
        (key: "slayer/advanced-talents", blueprint: "a33b99f95322d6741af83e9381b2391c", name: "Advanced Talents", summary: "From 10th level, can choose advanced rogue talents.", guide: "slayer#advanced-talents"),
        (key: "slayer/improved-quarry", blueprint: "25e009b7e53f86141adee3a1213af5af", name: "Improved Quarry", summary: "At 19th level, a quarry can be marked as a free action and its attack bonus rises to +4.", guide: "slayer#improved-quarry"),
        (key: "slayer/master-slayer", blueprint: "a26c0279a423fc94cabeea898f4d9f8a", name: "Master Slayer", summary: "At 20th level, a standard-action attack on a studied target forces a Fort save (DC 20 + Int) or death; once per opponent.", guide: "slayer#master-slayer"),
        (key: "slayer/quarry", blueprint: "385260ca07d5f1b4e907ba22a02944fc", name: "Quarry", summary: "From 14th level, standard action to mark one quarry: +2 insight to attack it and every critical hit against it is confirmed.", guide: "slayer#quarry"),
        (key: "slayer/slayer-proficiencies", blueprint: "41cd5ff7ad1bc5848906e050b06d02dc", name: "Slayer Proficiencies", summary: "Proficient with simple and martial weapons, shields, and light and medium armour.", guide: "slayer#slayer-proficiencies"),
        (key: "slayer/slayers-advance", blueprint: "758e04f4568ec3f4c8d1fd83aed06fb9", name: "Slayer\'s Advance", summary: "From 13th level, once a day +30 feet speed for 1 round with no attacks of opportunity; twice a day from 17th.", guide: "slayer#slayers-advance"),
        (key: "slayer/sneak-attack", blueprint: "9b9eac6709e1c084cb18c3a366e0ec87", name: "Sneak Attack", summary: "From 3rd level, +1d6 damage against flanked foes or those denied Dexterity to AC, +1d6 per 3 levels (max 6d6 at 18th).", guide: "slayer#sneak-attack"),
        (key: "slayer/studied-target", blueprint: "09bdd9445ac38044389476689ae8d5a1", name: "Studied Target", summary: "Move action: +1 to weapon attack, damage and slayer ability DCs against the studied foe, +1 more at 5th, 10th, 15th and 20th.", guide: "slayer#studied-target"),
        (key: "slayer/studied-target-swift", blueprint: "40d4f55a5ac0e4f469d67d36c0dfc40b", name: "Studied Target (Swift)", summary: "From 7th level, Studied Target is a swift action.", guide: "slayer#studied-target-swift"),
    ],
    selections: [
        (
            key: "slayer/combat-style",
            name: "Combat Style (Slayer)",
            summary: "A Ranger combat style feat taken as a slayer talent, at most three times: at 2nd or 4th, 6th or 8th, and 10th or later.",
            guide: "slayer#slayer-talents",
