Class(
    key: "slayer",
    name: "Slayer",
    summary: "Full-BAB hunter: 7 HP per level, good Fortitude and Reflex, Studied Target for bonuses against one foe, sneak attack from 3rd level and slayer talents.",
    guide: "slayer",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Good,
    will: Poor,
    class_skills: ["athletics", "knowledge-world", "lore-nature", "mobility", "perception", "persuasion", "stealth"],
    features: [
        (key: "slayer/advanced-talents", name: "Advanced Talents", summary: "From 10th level, can choose advanced rogue talents.", guide: "slayer#advanced-talents"),
        (key: "slayer/improved-quarry", name: "Improved Quarry", summary: "At 19th level, designates a quarry as a free action, and the quarry attack bonus rises to +4.", guide: "slayer#improved-quarry"),
        (key: "slayer/master-slayer", name: "Master Slayer", summary: "At 20th level, a standard-action attack on a studied target forces a Fort save (DC 20 + Int) or death; once per opponent.", guide: "slayer#master-slayer"),
        (key: "slayer/quarry", name: "Quarry", summary: "From 14th level, standard action to mark one quarry: +2 insight to attack it and every critical hit against it is confirmed.", guide: "slayer#quarry"),
        (key: "slayer/slayer-proficiencies", name: "Slayer Proficiencies", summary: "Simple and martial weapons, light and medium armour and shields.", guide: "slayer#slayer-proficiencies"),
        (key: "slayer/slayers-advance", name: "Slayer\'s Advance", summary: "From 13th level, once a day +30 feet speed for 1 round with no attacks of opportunity; twice a day from 17th.", guide: "slayer#slayers-advance"),
        (key: "slayer/sneak-attack", name: "Sneak Attack", summary: "From 3rd level, +1d6 damage against flanked foes or those denied Dexterity to AC, +1d6 per 3 levels (max 6d6 at 18th).", guide: "slayer#sneak-attack"),
        (key: "slayer/studied-target", name: "Studied Target", summary: "Move action: +1 to weapon attack, damage and slayer ability DCs against the studied foe, +1 more at 5th, 10th, 15th and 20th.", guide: "slayer#studied-target"),
        (key: "slayer/studied-target-swift", name: "Studied Target (Swift)", summary: "From 7th level, Studied Target is a swift action.", guide: "slayer#studied-target-swift"),
    ],
    selections: [
        (
            key: "slayer/combat-style",
            name: "Combat Style (Slayer)",
            summary: "A Ranger combat style feat taken as a slayer talent, at most three times: at 2nd or 4th, 6th or 8th, and 10th or later.",
            guide: "slayer#slayer-talents",
            option_levels: ["slayer"],
            only_without_option: true,
            options: [],
            shared_options: [
                "ranger/combat-style-feat/archery-feats",
                "ranger/combat-style-feat/menacing-feats",
                "ranger/combat-style-feat/two-handed-weapon-feats",
                "ranger/combat-style-feat/two-weapon-combat-feats",
                "ranger/combat-style-feat/weapon-and-shield-feats",
            ],
        ),
        (
            key: "slayer/slayer-talents",
            name: "Slayer Talents",
            summary: "From 2nd level, a rogue talent (slayer level counts as rogue level), a Ranger combat style feat, Trapfinding or Slayer Camouflage.",
            guide: "slayer#slayer-talents",
            option_levels: ["inquisitor", "slayer"],
            options: [
                (
                    key: "slayer/slayer-talents/combat-style-feat-10",
                    name: "Combat Style Feat (10th level or later)",
                    summary: "A Ranger combat style feat taken as a slayer talent at 10th level or later.",
                    guide: "slayer#slayer-talents",
                    prerequisite: ClassLevel(class: "slayer", level: 10),
                    levels: [
                        (level: 1, feat_slots: [OptionList(selection: "slayer/combat-style", at_level: 10)], selections: ["slayer/combat-style"]),
                    ],
                ),
                (
                    key: "slayer/slayer-talents/combat-style-feat-2",
                    name: "Combat Style Feat (2nd or 4th level)",
                    summary: "A Ranger combat style feat taken as a slayer talent at 2nd or 4th level.",
                    guide: "slayer#slayer-talents",
                    prerequisite: All([Not(ClassLevel(class: "slayer", level: 6)), ClassLevel(class: "slayer", level: 2)]),
                    levels: [
                        (level: 1, feat_slots: [OptionList(selection: "slayer/combat-style", at_level: 2)], selections: ["slayer/combat-style"]),
                    ],
                ),
                (
                    key: "slayer/slayer-talents/combat-style-feat-6",
                    name: "Combat Style Feat (6th or 8th level)",
                    summary: "A Ranger combat style feat taken as a slayer talent at 6th or 8th level.",
                    guide: "slayer#slayer-talents",
                    prerequisite: All([Not(ClassLevel(class: "slayer", level: 10)), ClassLevel(class: "slayer", level: 6)]),
                    levels: [
                        (level: 1, feat_slots: [OptionList(selection: "slayer/combat-style", at_level: 6)], selections: ["slayer/combat-style"]),
                    ],
                ),
                (key: "slayer/slayer-talents/slayer-camouflage", name: "Slayer Camouflage", summary: "Requires Terrain Mastery and Advanced Talents: can use Stealth in a favoured terrain even without cover.", guide: "slayer#slayer-camouflage", prerequisite: All([Feature(feature: "slayer/advanced-talents", count: 1), SelectionOption("rogue/rogue-talents/terrain-mastery")])),
                (key: "slayer/slayer-talents/trapfinding", name: "Trapfinding", summary: "Trickery becomes a class skill, plus the Rogue's Trapfinding with slayer level as rogue level.", guide: "slayer#trapfinding"),
            ],
            shared_options: [
                "rogue/rogue-talents/blinding-strike",
                "rogue/rogue-talents/canny-observer",
                "rogue/rogue-talents/combat-trick",
                "rogue/rogue-talents/confounding-blades",
                "rogue/rogue-talents/crippling-strike",
                "rogue/rogue-talents/dispelling-attack",
                "rogue/rogue-talents/double-debilitation",
                "rogue/rogue-talents/emboldening-strike",
                "rogue/rogue-talents/familiar",
                "rogue/rogue-talents/fast-stealth",
                "rogue/rogue-talents/focusing-attack-confused",
                "rogue/rogue-talents/focusing-attack-shaken",
                "rogue/rogue-talents/focusing-attack-sickened",
                "rogue/rogue-talents/hunters-surprise",
                "rogue/rogue-talents/improved-evasion",
                "rogue/rogue-talents/intimidating-prowess",
                "rogue/rogue-talents/iron-guts",
                "rogue/rogue-talents/jump-up",
                "rogue/rogue-talents/mystery-seeker",
                "rogue/rogue-talents/opportunist",
                "rogue/rogue-talents/petrifying-strike",
                "rogue/rogue-talents/skill-focus",
                "rogue/rogue-talents/skill-mastery-knowledge",
                "rogue/rogue-talents/skill-mastery-lore",
                "rogue/rogue-talents/skill-mastery-stealth-and-trickery",
                "rogue/rogue-talents/slippery-mind",
                "rogue/rogue-talents/slow-reactions",
                "rogue/rogue-talents/survivalist",
                "rogue/rogue-talents/terrain-mastery",
                "rogue/rogue-talents/trailblazer",
                "rogue/rogue-talents/unbalancing-trick",
                "rogue/rogue-talents/underhanded-trick",
                "rogue/rogue-talents/weakening-wound",
                "rogue/rogue-talents/weapon-focus",
                "rogue/rogue-talents/weapon-snatcher",
                "rogue/rogue-talents/wearying-strike",
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["slayer/slayer-proficiencies", "slayer/studied-target"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
        (level: 2, selections: ["slayer/slayer-talents"]),
        (level: 3, features: ["slayer/sneak-attack"]),
        (level: 4, selections: ["slayer/slayer-talents"]),
        (level: 5),
        (level: 6, features: ["slayer/sneak-attack"], selections: ["slayer/slayer-talents"]),
        (level: 7, features: ["slayer/studied-target-swift"]),
        (level: 8, selections: ["slayer/slayer-talents"]),
        (level: 9, features: ["slayer/sneak-attack"]),
        (level: 10, features: ["slayer/advanced-talents"], selections: ["slayer/slayer-talents"]),
        (level: 11),
        (level: 12, features: ["slayer/sneak-attack"], selections: ["slayer/slayer-talents"]),
        (level: 13, features: ["slayer/slayers-advance"]),
        (level: 14, features: ["slayer/quarry"], selections: ["slayer/slayer-talents"]),
        (level: 15, features: ["slayer/sneak-attack"]),
        (level: 16, selections: ["slayer/slayer-talents"]),
        (level: 17),
        (level: 18, features: ["slayer/sneak-attack"], selections: ["slayer/slayer-talents"]),
        (level: 19, features: ["slayer/improved-quarry"]),
        (level: 20, features: ["slayer/master-slayer"], selections: ["slayer/slayer-talents"]),
    ],
    archetypes: [
        (
            key: "slayer/arcane-enforcer",
            name: "Arcane Enforcer",
            summary: "Slayer with good Reflex and Will who uses arcanist exploits, losing Quarry and three talents.",
            guide: "slayer#arcane-enforcer",
            class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "mobility", "perception", "stealth", "use-magic-device"],
            fort: Some(Poor),
            will: Some(Good),
            features: [
                (key: "slayer/arcane-enforcer/arcane-reservoir", name: "Arcane Reservoir", summary: "A daily reservoir of magical energy holding up to class level + 3 points.", guide: "slayer#arcane-reservoir"),
            ],
            levels: [
                (level: 1, features: ["slayer/arcane-enforcer/arcane-reservoir", "slayer/slayer-proficiencies", "slayer/studied-target"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"], selections: ["arcanist/arcanist-exploits"]),
                (level: 4, selections: ["arcanist/arcanist-exploits"]),
                (level: 7, features: ["slayer/studied-target-swift"], selections: ["arcanist/arcanist-exploits"]),
                (level: 10, features: ["slayer/advanced-talents"], selections: ["arcanist/arcanist-exploits"]),
                (level: 13, selections: ["arcanist/arcanist-exploits", "arcanist/greater-exploits"]),
                (level: 14, selections: ["slayer/slayer-talents"]),
                (level: 16, selections: ["arcanist/arcanist-exploits"]),
                (level: 19, selections: ["arcanist/arcanist-exploits"]),
            ],
        ),
        (
            key: "slayer/bloodseeker",
            name: "Bloodseeker",
            summary: "Dance of Masks evil slayer with a Blood Pool of vampiric powers and spells instead of slayer talents.",
            guide: "slayer#bloodseeker",
            prerequisite: Any([Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
            features: [
                (key: "slayer/bloodseeker/blood-pool", name: "Blood Pool", summary: "From 2nd level, a pool of 2 points (+1 per level) that fuels his powers; DC 10 + half level + Int.", guide: "slayer#blood-pool"),
                (key: "slayer/bloodseeker/bloodlust", name: "Bloodlust", summary: "From 2nd level, each kill gives +1 attack and damage until combat ends, up to half his Intelligence modifier.", guide: "slayer#bloodlust"),
                (key: "slayer/bloodseeker/bloodseekers-cursed-lineage", name: "Bloodseeker\'s Cursed Lineage", summary: "Counts as undead for channel energy effects.", guide: "slayer#bloodseekers-cursed-lineage"),
                (key: "slayer/bloodseeker/carrion-form", name: "Carrion Form", summary: "From 10th level, for 1 Blood Pool point becomes a swarm of undead ravens; damaging foes in this form restores 1 point.", guide: "slayer#carrion-form"),
                (key: "slayer/bloodseeker/master-of-blood", name: "Master of Blood", summary: "At 20th level, Blood Jet and Cone of Blood are empowered and bolstered, the pool grows by 5 and he gets +6 profane Str, Dex and Int.", guide: "slayer#master-of-blood"),
                (key: "slayer/bloodseeker/sharp-teeth", name: "Sharp Teeth", summary: "From 2nd level, a secondary 1d6 bite (1d4 if small); confirmed crits on living foes restore 3 Blood Pool points.", guide: "slayer#sharp-teeth"),
                (key: "slayer/bloodseeker/vampire-bite", name: "Vampire Bite", summary: "From 9th level, bite hits on living foes give him 5 temporary HP and the target a negative level, both stacking.", guide: "slayer#vampire-bite"),
            ],
            selections: [
                (
                    key: "slayer/bloodseeker/nocturnal-abilities",
                    name: "Nocturnal Abilities",
                    summary: "A Blood Pool power, each costing 1 or 2 points.",
                    guide: "slayer#nocturnal-abilities",
                    options: [
                        (key: "slayer/bloodseeker/nocturnal-abilities/blasphemy", name: "Blasphemy", summary: "From 16th level, 2 Blood Pool points: casts Blasphemy.", guide: "slayer#blasphemy"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/blood-healing", name: "Blood Healing", summary: "2 Blood Pool points: fast healing 3 for rounds equal to class level.", guide: "slayer#blood-healing"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/blood-jet", name: "Blood Jet", summary: "1 Blood Pool point: ranged touch attack for 1d4 damage per class level.", guide: "slayer#blood-jet"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/cone-of-blood", name: "Cone of Blood", summary: "1 Blood Pool point: 30-foot cone dealing 1d4 per class level, Reflex for half.", guide: "slayer#cone-of-blood"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/enervation", name: "Enervation", summary: "From 10th level, 2 Blood Pool points: casts Enervation.", guide: "slayer#enervation"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/haste", name: "Haste", summary: "From 8th level, 2 Blood Pool points: casts Haste.", guide: "slayer#haste"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/predatory-might", name: "Predatory Might", summary: "From 6th level, 1 Blood Pool point: +4 profane Strength and +2 profane damage for minutes equal to class level.", guide: "slayer#predatory-might"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/predatory-prowess", name: "Predatory Prowess", summary: "From 6th level, 1 Blood Pool point: +4 profane Dexterity and +2 profane AC for minutes equal to class level.", guide: "slayer#predatory-prowess"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/sense-vitals", name: "Sense Vitals", summary: "2 Blood Pool points: casts Sense Vitals.", guide: "slayer#sense-vitals"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/slow", name: "Slow", summary: "From 8th level, 2 Blood Pool points: casts Slow.", guide: "slayer#slow"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/summon-bloody-bones-beast", name: "Summon Bloody Bones Beast", summary: "From 8th level, 2 Blood Pool points: summons a bloody bones beast for rounds equal to class level.", guide: "slayer#summon-bloody-bones-beast"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/summon-dire-wolves", name: "Summon Dire Wolves", summary: "1 Blood Pool point: summons 1d4 dire wolves for rounds equal to class level.", guide: "slayer#summon-dire-wolves"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/vampiric-shadow-shield", name: "Vampiric Shadow Shield", summary: "From 14th level, 2 Blood Pool points: casts Vampiric Shadow Shield.", guide: "slayer#vampiric-shadow-shield"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/vampiric-touch", name: "Vampiric Touch", summary: "From 8th level, 2 Blood Pool points: casts Vampiric Touch.", guide: "slayer#vampiric-touch"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/wracking-ray", name: "Wracking Ray", summary: "From 14th level, 2 Blood Pool points: casts Wracking Ray.", guide: "slayer#wracking-ray"),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["slayer/bloodseeker/bloodseekers-cursed-lineage", "slayer/slayer-proficiencies", "slayer/studied-target"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["slayer/bloodseeker/blood-pool", "slayer/bloodseeker/bloodlust", "slayer/bloodseeker/sharp-teeth"], selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 4, selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 6, features: ["slayer/sneak-attack"], selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 8, selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 9, features: ["slayer/bloodseeker/vampire-bite", "slayer/sneak-attack"]),
                (level: 10, features: ["slayer/bloodseeker/carrion-form"], selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 12, features: ["slayer/sneak-attack"], selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 14, features: ["slayer/quarry"], selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 16, selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 18, features: ["slayer/sneak-attack"], selections: ["slayer/bloodseeker/nocturnal-abilities"]),
                (level: 20, features: ["slayer/bloodseeker/master-of-blood"], selections: ["slayer/bloodseeker/nocturnal-abilities"]),
            ],
        ),
        (
            key: "slayer/deliverer",
            prerequisite: Worships,
            name: "Deliverer",
            summary: "Slayer serving a deity, strongest against foes two alignment steps from his own.",
            guide: "slayer#deliverer",
            features: [
                (key: "slayer/deliverer/deity", favoured_weapon_proficiency: true, name: "Deity", guide: "slayer#deity"),
                (key: "slayer/deliverer/determined-zeal", name: "Determined Zeal", summary: "Attacking a foe two alignment steps away gives +2 Will saves against it and Diehard until the end of his next turn.", guide: "slayer#determined-zeal"),
                (key: "slayer/deliverer/divine-anathema", name: "Divine Anathema", summary: "From 10th level, +2d6 damage against a studied target two alignment steps from his own.", guide: "slayer#divine-anathema"),
            ],
            levels: [
                (level: 1, features: ["slayer/deliverer/deity", "slayer/slayer-proficiencies", "slayer/studied-target"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["slayer/deliverer/determined-zeal"]),
                (level: 10, features: ["slayer/advanced-talents", "slayer/deliverer/divine-anathema"]),
            ],
        ),
        (
            key: "slayer/executioner",
            name: "Executioner",
            summary: "Slayer specialised in killing humanoids and assassinating unaware targets.",
            guide: "slayer#executioner",
            features: [
                (key: "slayer/executioner/assassinate", name: "Assassinate", summary: "From 10th level, a coup de grace on a studied target outside combat; demoralizes enemies within 30 feet from 14th; 2d6 bleed on survivors from 19th.", guide: "slayer#assassinate"),
                (key: "slayer/executioner/focused-killer", name: "Focused Killer", summary: "Studied Target bonuses are +1 higher against humanoids and 1 lower against other creatures.", guide: "slayer#focused-killer"),
                (key: "slayer/executioner/painful-strike", name: "Painful Strike", summary: "Sneak attack damage forces a Fort save (DC 10 + half level + Int) or sickened for 1d4 rounds.", guide: "slayer#painful-strike"),
            ],
            levels: [
                (level: 1, features: ["slayer/executioner/focused-killer", "slayer/slayer-proficiencies", "slayer/studied-target"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 4, features: ["slayer/executioner/painful-strike"]),
                (level: 10, features: ["slayer/advanced-talents", "slayer/executioner/assassinate"], selections: ["slayer/slayer-talents"]),
                (level: 14, selections: ["slayer/slayer-talents"]),
                (level: 19),
            ],
        ),
        (
            key: "slayer/imitator",
            name: "Imitator",
            summary: "Human slayer who adopts other classes' stances instead of Studied Target, with fewer sneak dice and talents.",
            guide: "slayer#imitator",
            prerequisite: Race("human"),
            features: [
                (key: "slayer/imitator/sneak-attack-imitator", name: "Sneak Attack (Imitator)", summary: "+1d6 sneak attack at 3rd level, +1d6 at 9th and 15th.", guide: "slayer#sneak-attack-imitator"),
            ],
            selections: [
                (
                    key: "slayer/imitator/imitation",
                    name: "Imitation",
                    summary: "Free action: a Fighter, Barbarian, Monk or Rogue stance for 1 minute, half level + Int times a day.",
                    guide: "slayer#imitation",
                    options: [
                        (key: "slayer/imitator/imitation/barbarian-stance", name: "Barbarian Stance", summary: "Temporary HP equal to class level, Uncanny Dodge from 4th and DR 1/- from 7th (+1 per 3 levels, max 5/-).", guide: "slayer#barbarian-stance"),
                        (key: "slayer/imitator/imitation/fighter-stance", name: "Fighter Stance", summary: "+1 attack and damage, +1 per 5 levels (max +5), and Armor Training at 6th and 14th.", guide: "slayer#fighter-stance"),
                        (key: "slayer/imitator/imitation/monk-stance", name: "Monk Stance", summary: "Improved Unarmed Strike, half Int to AC unarmoured, Evasion, magic and cold iron fists, and extra unarmed attacks at 11th and 20th.", guide: "slayer#monk-stance"),
                        (key: "slayer/imitator/imitation/rogue-stance", name: "Rogue Stance", summary: "1d6 sneak attack +1d6 per 3 levels (max 7d6), Evasion at 4th and Uncanny Dodge at 8th.", guide: "slayer#rogue-stance"),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["slayer/slayer-proficiencies"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "martial-weapons-proficiency", "shield-proficiency", "simple-weapon-proficiency"], selections: ["slayer/imitator/imitation"]),
                (level: 3, features: ["slayer/imitator/sneak-attack-imitator"]),
                (level: 4),
                (level: 6, selections: ["slayer/slayer-talents"]),
                (level: 7),
                (level: 9, features: ["slayer/imitator/sneak-attack-imitator"]),
                (level: 10, features: ["slayer/advanced-talents"]),
                (level: 12, selections: ["slayer/slayer-talents"]),
                (level: 13),
                (level: 15, features: ["slayer/imitator/sneak-attack-imitator"]),
                (level: 16),
                (level: 18, selections: ["slayer/slayer-talents"]),
            ],
        ),
        (
            key: "slayer/spawn-slayer",
            name: "Spawn Slayer",
            summary: "Slayer dedicated to fighting large monsters.",
            guide: "slayer#spawn-slayer",
            features: [
                (key: "slayer/spawn-slayer/gain-leverage", name: "Gain Leverage", summary: "From 7th level, CMB and CMD bonus against Large or bigger studied targets: +1 Large, +2 Huge, +4 Gargantuan, +8 Colossal.", guide: "slayer#gain-leverage"),
                (key: "slayer/spawn-slayer/studied-spawn", name: "Studied Spawn", summary: "Studied Target bonuses grow against big foes: +1 vs Large at 5th, +2 vs Huge at 10th, +3 Gargantuan at 15th, +4 Colossal at 20th.", guide: "slayer#studied-spawn"),
            ],
            levels: [
                (level: 5, features: ["slayer/spawn-slayer/studied-spawn"]),
                (level: 7, features: ["slayer/spawn-slayer/gain-leverage"]),
            ],
        ),
        (
            key: "slayer/stygian-slayer",
            name: "Stygian Slayer",
            summary: "Slayer with light armour, invisibility and an incorporeal mist form.",
            guide: "slayer#stygian-slayer",
            features: [
                (key: "slayer/stygian-slayer/invisibiliy", name: "Invisibiliy", summary: "From 4th level, casts Invisibility once a day at his class level, +1 use at 8th and every 4 levels (max 5).", guide: "slayer#stygian-slayer"),
                (key: "slayer/stygian-slayer/shadowy-mist-form", name: "Shadowy Mist Form", summary: "From 10th level, incorporeal for minutes a day equal to level: cannot attack, immune to mundane weapons, half damage from most else.", guide: "slayer#shadowy-mist-form"),
            ],
