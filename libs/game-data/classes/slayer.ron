        (
            key: "slayer/bloodseeker",
            blueprint: "11e473bfb29c42f580b9a801b6771788",
            name: "Bloodseeker",
            summary: "Dance of Masks evil slayer with a Blood Pool of vampiric powers and spells instead of slayer talents.",
            guide: "slayer#bloodseeker",
            prerequisite: Any([Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
            features: [
                (key: "slayer/bloodseeker/blood-pool", blueprint: "11047b71843a4ee2b42d3550a1fd6461", name: "Blood Pool", summary: "From 2nd level, a pool of 2 points (+1 per level) that fuels your powers; DC 10 + half level + Int.", guide: "slayer#blood-pool"),
                (key: "slayer/bloodseeker/bloodlust", blueprint: "703c488da4a34dc883dd7787e8d7ed51", name: "Bloodlust", summary: "From 2nd level, each kill gives +1 attack and damage until combat ends, up to half your Intelligence modifier.", guide: "slayer#bloodlust"),
                (key: "slayer/bloodseeker/bloodseekers-cursed-lineage", blueprint: "737b087cb83448f687cd2d9e8c69e426", name: "Bloodseeker\'s Cursed Lineage", summary: "Counts as undead for channel energy effects.", guide: "slayer#bloodseekers-cursed-lineage"),
                (key: "slayer/bloodseeker/carrion-form", blueprint: "0eb03d23f4744d9aa5a2584f08e4e38b", name: "Carrion Form", summary: "From 10th level, for 1 Blood Pool point becomes a swarm of undead ravens; damaging foes in this form restores 1 point.", guide: "slayer#carrion-form"),
                (key: "slayer/bloodseeker/master-of-blood", blueprint: "5868f4a3414446ac9f5b4ce1aa1995f1", name: "Master of Blood", summary: "At 20th level, Blood Jet and Cone of Blood are empowered and bolstered, the pool grows by 5 and you get +6 profane Str, Dex and Int.", guide: "slayer#master-of-blood"),
                (key: "slayer/bloodseeker/sharp-teeth", blueprint: "1fb15984335a4694a29b0346cac282c2", name: "Sharp Teeth", summary: "From 2nd level, a secondary 1d6 bite (1d4 if small); confirmed crits on living foes restore 3 Blood Pool points.", guide: "slayer#sharp-teeth"),
                (key: "slayer/bloodseeker/vampire-bite", blueprint: "ea6a7bffdf2c43ddbf0ff7cc1bec5b06", name: "Vampire Bite", summary: "From 9th level, bite hits on living foes give you 5 temporary HP and the target a negative level, both stacking.", guide: "slayer#vampire-bite"),
            ],
            selections: [
                (
                    key: "slayer/bloodseeker/nocturnal-abilities",
                    blueprint: "e68a3a764ffd4aff9b303fcf67a9322d",
                    name: "Nocturnal Abilities",
                    summary: "A Blood Pool power, each costing 1 or 2 points.",
                    guide: "slayer#nocturnal-abilities",
                    options: [
                        (key: "slayer/bloodseeker/nocturnal-abilities/blasphemy", blueprint: "02f9d14328f64233aaa30f7b493de059", name: "Blasphemy", summary: "From 16th level, 2 Blood Pool points: casts Blasphemy.", guide: "slayer#blasphemy"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/blood-healing", blueprint: "613a8f55cd2e4570a45cbac3b0feb912", name: "Blood Healing", summary: "2 Blood Pool points: fast healing 3 for rounds equal to class level.", guide: "slayer#blood-healing"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/blood-jet", blueprint: "9f8e0804d4974db0877bf236348d5411", name: "Blood Jet", summary: "1 Blood Pool point: ranged touch attack for 1d4 damage per class level.", guide: "slayer#blood-jet"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/cone-of-blood", blueprint: "a485f2e1a232435e986aea1f74c8e159", name: "Cone of Blood", summary: "1 Blood Pool point: 30-foot cone dealing 1d4 per class level, Reflex for half.", guide: "slayer#cone-of-blood"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/enervation", blueprint: "9b748f01f281406c8517e907cce551db", name: "Enervation", summary: "From 10th level, 2 Blood Pool points: casts Enervation.", guide: "slayer#enervation"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/haste", blueprint: "b2d8de6d91e1426a9cac33e1091f53c0", name: "Haste", summary: "From 8th level, 2 Blood Pool points: casts Haste.", guide: "slayer#haste"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/predatory-might", blueprint: "d5581be0f6124fac900e23398a694750", name: "Predatory Might", summary: "From 6th level, 1 Blood Pool point: +4 profane Strength and +2 profane damage for minutes equal to class level.", guide: "slayer#predatory-might"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/predatory-prowess", blueprint: "845bc5d567a94b95bebac28bd77dbf93", name: "Predatory Prowess", summary: "From 6th level, 1 Blood Pool point: +4 profane Dexterity and +2 profane AC for minutes equal to class level.", guide: "slayer#predatory-prowess"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/sense-vitals", blueprint: "903e9775fc044b98be76833e7cfd3af8", name: "Sense Vitals", summary: "2 Blood Pool points: casts Sense Vitals.", guide: "slayer#sense-vitals"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/slow", blueprint: "8adca4a181cc444da922b5c861f3a86b", name: "Slow", summary: "From 8th level, 2 Blood Pool points: casts Slow.", guide: "slayer#slow"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/summon-bloody-bones-beast", blueprint: "28294c00a938435b86f6468c49ef3969", name: "Summon Bloody Bones Beast", summary: "From 8th level, 2 Blood Pool points: summons a bloody bones beast for rounds equal to class level.", guide: "slayer#summon-bloody-bones-beast"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/summon-dire-wolves", blueprint: "8de40e7babd44419b797cdf51e56e0e0", name: "Summon Dire Wolves", summary: "1 Blood Pool point: summons 1d4 dire wolves for rounds equal to class level.", guide: "slayer#summon-dire-wolves"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/vampiric-shadow-shield", blueprint: "82bd9b37161b4b0493e91856eddfdd03", name: "Vampiric Shadow Shield", summary: "From 14th level, 2 Blood Pool points: casts Vampiric Shadow Shield.", guide: "slayer#vampiric-shadow-shield"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/vampiric-touch", blueprint: "f707fbd648224498b2d8c36a56045dfe", name: "Vampiric Touch", summary: "From 8th level, 2 Blood Pool points: casts Vampiric Touch.", guide: "slayer#vampiric-touch"),
                        (key: "slayer/bloodseeker/nocturnal-abilities/wracking-ray", blueprint: "96089a505a5c4a0fb3ad0a88c9cc1d0a", name: "Wracking Ray", summary: "From 14th level, 2 Blood Pool points: casts Wracking Ray.", guide: "slayer#wracking-ray"),
                    ],
