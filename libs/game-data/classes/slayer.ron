                (key: "slayer/slayer-talents/trapfinding", blueprint: "e3c12938c2f93544da89824fbe0933a5", name: "Trapfinding", summary: "Trickery becomes a class skill, plus the Rogue's Trapfinding with slayer level as rogue level.", guide: "slayer#trapfinding"),
