                (key: "shifter/fiendflesh-shifter/shifter-claws-1d6", blueprint: "19b7335626b3434cbe2af01fb33582ff", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter#fiendflesh-shifter"),
                (key: "shifter/fiendflesh-shifter/shifter-claws-1d8", blueprint: "8d6b338131764a4fb68eaf5b5c6cfe47", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter#fiendflesh-shifter"),
