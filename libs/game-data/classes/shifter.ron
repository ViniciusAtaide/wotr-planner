                (key: "shifter/fiendflesh-shifter/shifter-claws-cold-iron-magic-and-silver", blueprint: "f7996c5b51e348fc9277480d9cc0a88c", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#fiendflesh-shifter"),
