Class(
    key: "shifter",
    name: "Shifter",
    summary: "Shapeshifting melee class (Last Sarkorians DLC) with animal aspects and improving claws; full BAB, 6 HP a level, good Fortitude and Reflex, 3 skill points.",
    guide: "shifter",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Good,
    will: Poor,
    save_exceptions: [(level: 2, save: Reflex, value: 2)],
    class_skills: ["athletics", "lore-nature", "mobility", "perception", "stealth"],
    prerequisite: Any([Alignment(NeutralGood), Alignment(LawfulNeutral), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil)]),
    features: [
        (key: "shifter/chimeric-aspect", name: "Chimeric Aspect", summary: "At 9th level, hold two minor aspects at once.", guide: "shifter#chimeric-aspect"),
        (key: "shifter/defensive-instinct", name: "Defensive Instinct", summary: "From 2nd level, unarmoured: add Wis to AC and CMD (also vs touch and flat-footed), +1 at 4th and every four levels; half Wis in non-metal armour.", guide: "shifter#defensive-instinct"),
        (key: "shifter/final-aspect", name: "Final Aspect", summary: "At 20th level, take the minor forms of all your aspects at once and use major and minor forms at will.", guide: "shifter#final-aspect"),
        (key: "shifter/greater-chimeric-aspect", name: "Greater Chimeric Aspect", summary: "At 14th level, hold three minor aspects at once.", guide: "shifter#greater-chimeric-aspect"),
        (key: "shifter/major-form", name: "Major Form", summary: "From 4th level, take an aspect's major form as a standard action for 1 hour at a time, Shifter level + Wis mod times a day.", guide: "shifter"),
        (key: "shifter/shifter-claws", name: "Shifter Claws", summary: "Swift action outside major form: claws dealing 1d4, rising to 1d10 with a better crit and DR bypass by 19th; shifted primary natural attacks share them.", guide: "shifter#shifter-claws"),
        (key: "shifter/shifter-claws-1-crit-multiplier", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter"),
        (key: "shifter/shifter-claws-1d10", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter"),
        (key: "shifter/shifter-claws-1d6", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter"),
        (key: "shifter/shifter-claws-1d8", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter"),
        (key: "shifter/shifter-claws-adamantine-and-universal", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter"),
        (key: "shifter/shifter-claws-cold-iron-magic-and-silver", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter"),
        (key: "shifter/shifters-fury", name: "Shifter\'s Fury", summary: "From 6th level, full attack with one natural weapon to get iterative attacks; your other natural attacks become secondary.", guide: "shifter#shifters-fury"),
        (key: "shifter/track", name: "Track", summary: "From 2nd level, add half your level to Lore (Nature) checks.", guide: "shifter#track"),
        (key: "shifter/woodland-grace", name: "Woodland Grace", summary: "From 3rd level, ignore difficult terrain, immune to entangled, and +2 AC against attacks of opportunity.", guide: "shifter#woodland-grace"),
    ],
    selections: [
        (
            key: "shifter/shifter-aspect",
            name: "Shifter Aspect",
            summary: "Minor form for 3 + level minutes a day (swift); from 4th, major form for an hour, level + Wis times a day; new aspect at 5th, 10th, 15th and 20th.",
            guide: "shifter#shifter-aspect",
            options: [
                (key: "shifter/shifter-aspect/bear-aspect", name: "Bear Aspect", summary: "Minor: +2 Con (+4 at 8th, +6 at 15th). Major: +10' speed, scent, 1d8 bite and two 1d6 grabbing claws, improving at 8th and 15th.", guide: "shifter#bear-aspect"),
                (key: "shifter/shifter-aspect/boar-aspect", name: "Boar Aspect", summary: "Minor: +2 Fortitude (+4 at 8th, +6 at 15th). Major: +10' speed, scent and a 1d8 gore; powerful charge at 8th, +1 HP a level at 15th.", guide: "shifter#boar-aspect"),
                (key: "shifter/shifter-aspect/dinosaur-aspect", name: "Dinosaur Aspect", summary: "Minor: +2 initiative (+4 at 8th, +6 at 15th). Major: +30' speed, scent, 1d6 bite, two 1d8 talons and pounce; more at 8th and 15th.", guide: "shifter#dinosaur-aspect"),
                (key: "shifter/shifter-aspect/horse-aspect", name: "Horse Aspect", summary: "Minor: Endurance and +5' speed (+15' at 15th). Major: +20' speed, scent, two 1d4 hooves, double damage on charges and overruns.", guide: "shifter#horse-aspect"),
                (key: "shifter/shifter-aspect/lizard-aspect", name: "Lizard Aspect", summary: "Minor: +2 Reflex (+4 at 8th, +6 at 15th). Major: +10' speed (+30' at 8th), scent and a 1d8 grabbing bite.", guide: "shifter#lizard-aspect"),
                (key: "shifter/shifter-aspect/mammoth-aspect", name: "Mammoth Aspect", summary: "Minor: +2 Str (+4 at 8th, +6 at 15th). Major: scent, 1d6 gore, two 1d8 slams, +2 Str and +2 natural armour (+4 at 15th).", guide: "shifter#mammoth-aspect"),
                (key: "shifter/shifter-aspect/spider-aspect", name: "Spider Aspect", summary: "Minor: +2 dodge AC (+4 at 8th, +6 at 15th). Major: tremorsense, a 1d6 bite and a web ranged touch attack that immobilises.", guide: "shifter#spider-aspect"),
                (key: "shifter/shifter-aspect/tiger-aspect", name: "Tiger Aspect", summary: "Minor: +2 Dex (+4 at 8th, +6 at 15th). Major: +10' speed, scent, 2d6 bite, two 2d4 claws, grab and pounce; rake at 15th.", guide: "shifter#tiger-aspect"),
                (key: "shifter/shifter-aspect/wolf-aspect", name: "Wolf Aspect", summary: "Minor: scent and +2 natural attack damage (+4 at 8th, +6 at 15th). Major: +10' speed, scent and a 1d8 bite that can trip for free.", guide: "shifter#wolf-aspect"),
                (key: "shifter/shifter-aspect/wolverine-aspect", name: "Wolverine Aspect", summary: "Minor: +2 HP a level and +2 Con, rising later. Major: +10' speed, scent, 1d6 bite, two 1d8 claws, and rage when damaged.", guide: "shifter#wolverine-aspect"),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["shifter/shifter-claws"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"], selections: ["shifter/shifter-aspect"]),
        (level: 2, features: ["shifter/defensive-instinct", "shifter/track"]),
        (level: 3, features: ["shifter/shifter-claws-cold-iron-magic-and-silver", "shifter/woodland-grace"]),
        (level: 4, features: ["shifter/major-form"]),
        (level: 5, selections: ["shifter/shifter-aspect"]),
        (level: 6, features: ["shifter/shifters-fury"]),
        (level: 7, features: ["shifter/shifter-claws-1d6"]),
        (level: 8),
        (level: 9, features: ["shifter/chimeric-aspect"]),
        (level: 10, selections: ["shifter/shifter-aspect"]),
        (level: 11, features: ["shifter/shifter-claws-1d8"]),
        (level: 12),
        (level: 13, features: ["shifter/shifter-claws-1d10"]),
        (level: 14, features: ["shifter/greater-chimeric-aspect"]),
        (level: 15, selections: ["shifter/shifter-aspect"]),
        (level: 16),
        (level: 17, features: ["shifter/shifter-claws-1-crit-multiplier"]),
        (level: 18),
        (level: 19, features: ["shifter/shifter-claws-adamantine-and-universal"]),
        (level: 20, features: ["shifter/final-aspect"], selections: ["shifter/shifter-aspect"]),
    ],
    archetypes: [
        (
            key: "shifter/child-of-the-manticore",
            name: "Child of the Manticore",
            summary: "Shifter limited to a single Manticore aspect, throwing spikes from their body.",
            guide: "shifter#child-of-the-manticore",
            features: [
                (key: "shifter/child-of-the-manticore/grow-spikes", name: "Grow Spikes", summary: "From 1st level, throw spikes as a ranged attack, dealing 1d4 and improving like Shifter Claws up to 1d10, +1 crit and DR bypass.", guide: "shifter#grow-spikes"),
                (key: "shifter/child-of-the-manticore/grow-spikes-1-crit-multiplier", name: "Grow Spikes (+1 crit multiplier)", summary: "At 17th level, spike attacks gain +1 to their critical multiplier.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-1d10", name: "Grow Spikes (1d10)", summary: "At 13th level, spike attack base damage rises to 1d10.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-1d6", name: "Grow Spikes (1d6)", summary: "At 7th level, spike attack base damage rises to 1d6.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-1d8", name: "Grow Spikes (1d8)", summary: "At 11th level, spike attack base damage rises to 1d8.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-adamantine-and-universal", name: "Grow Spikes (adamantine and universal)", summary: "At 19th level, spike attacks ignore DR/adamantine and DR/-.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-cold-iron-magic-and-silver", name: "Grow Spikes (cold iron, magic and silver)", summary: "At 3rd level, spike attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/manticore-aspect", name: "Manticore Aspect", summary: "Minor form for 3 + level minutes a day: +2 Str and Dex (+8 at 20th); throws two spikes with the first attack at 5th, four at 20th.", guide: "shifter#manticore-aspect"),
                (key: "shifter/child-of-the-manticore/manticore-shape", name: "Manticore Shape", summary: "From 4th level, manticore form for a minute (level + Wis times a day): +10' speed, scent and four 1d6 spike attacks; more at 9th and 14th.", guide: "shifter#manticore-shape"),
            ],
            levels: [
                (level: 1, features: ["shifter/child-of-the-manticore/grow-spikes", "shifter/child-of-the-manticore/manticore-aspect"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["shifter/child-of-the-manticore/grow-spikes-cold-iron-magic-and-silver", "shifter/woodland-grace"]),
                (level: 4, features: ["shifter/child-of-the-manticore/manticore-shape"]),
                (level: 5),
                (level: 7, features: ["shifter/child-of-the-manticore/grow-spikes-1d6"]),
                (level: 9),
                (level: 10),
                (level: 11, features: ["shifter/child-of-the-manticore/grow-spikes-1d8"]),
                (level: 13, features: ["shifter/child-of-the-manticore/grow-spikes-1d10"]),
                (level: 14),
                (level: 15),
                (level: 17, features: ["shifter/child-of-the-manticore/grow-spikes-1-crit-multiplier"]),
                (level: 19, features: ["shifter/child-of-the-manticore/grow-spikes-adamantine-and-universal"]),
                (level: 20),
            ],
        ),
        (
            key: "shifter/dragonblood-shifter",
            name: "Dragonblood Shifter",
            summary: "Shifter who swaps beast aspects for draconic ones and eventually becomes a dragon.",
            guide: "shifter#dragonblood-shifter",
            features: [
                (key: "shifter/dragonblood-shifter/draconic-aspect-selection", name: "Draconic Aspect Selection", summary: "Swift action for 3 + level minutes a day: scent and resistance 5 to a dragon's element, healing you by what it resists; dragon type limited by alignment.", guide: "shifter#draconic-aspect-selection"),
                (key: "shifter/dragonblood-shifter/improved-wyrmshifter", name: "Improved Wyrmshifter", summary: "At 14th level, +4 against sleep and paralysis, and dragon form as Dragonkind II for an hour, level + Wis times a day.", guide: "shifter#improved-wyrmshifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-1-crit-multiplier", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-1d10", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-1d6", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-1d8", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-adamantine-and-universal", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-cold-iron-magic-and-silver", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/wyrmshifter", name: "Wyrmshifter", summary: "At 9th level, +2 against sleep and paralysis, and dragon form as Dragonkind I for a minute at a time, level + Wis times a day.", guide: "shifter#wyrmshifter"),
            ],
            selections: [
                (
                    key: "shifter/dragonblood-shifter/greater-wyrmshifter",
                    name: "Greater Wyrmshifter",
                    summary: "At 20th level, become a dragon at will: +10 Str, +8 Con, +8 natural armour, DR 10/magic, strong natural attacks and a 16d8 breath.",
                    guide: "shifter#greater-wyrmshifter",
                    options: [
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-black-dragon", name: "Breath Weapon (Black Dragon)", summary: "16d8 acid in a 100' line; foes who fail the save take -5 on attack rolls for 2-5 rounds.", guide: "shifter#breath-weapon-black-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-brass-dragon", name: "Breath Weapon (Brass Dragon)", summary: "16d8 fire in a 100' line; allies are unharmed and gain +10' speed and an extra melee attack for 2-5 rounds.", guide: "shifter#breath-weapon-brass-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-bronze-dragon", name: "Breath Weapon (Bronze Dragon)", summary: "16d8 electricity in a 100' line; allies are unharmed and gain +5 dodge AC for 2-5 rounds.", guide: "shifter#breath-weapon-bronze-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-buse-dragon", name: "Breath Weapon (Buse Dragon)", summary: "16d8 electricity in a 100' line; foes who fail the save take -3 on saves for 2-5 rounds.", guide: "shifter#breath-weapon-buse-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-copper-dragon", name: "Breath Weapon (Copper Dragon)", summary: "16d8 acid in a 100' line; allies are unharmed and gain +5 natural armour for 2-5 rounds.", guide: "shifter#breath-weapon-copper-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-gold-dragon", name: "Breath Weapon (Gold Dragon)", summary: "16d8 fire in a 50' cone; allies are healed for the same amount instead.", guide: "shifter#breath-weapon-gold-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-green-dragon", name: "Breath Weapon (Green Dragon)", summary: "16d8 acid in a 50' cone; foes who fail the save take another 16d8 for 2-5 rounds.", guide: "shifter#breath-weapon-green-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-red-dragon", name: "Breath Weapon (Red Dragon)", summary: "16d8 fire in a 50' cone; foes who fail the save take -5 AC for 2-5 rounds.", guide: "shifter#breath-weapon-red-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-silver-dragon", name: "Breath Weapon (Silver Dragon)", summary: "16d8 cold in a 50' cone; allies are unharmed and gain +5 sacred to attack and damage for 2-5 rounds.", guide: "shifter#breath-weapon-silver-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-white-dragon", name: "Breath Weapon (White Dragon)", summary: "16d8 cold in a 50' cone; foes who fail the save are paralysed and take 20 cold a round until a Fortitude save.", guide: "shifter#breath-weapon-white-dragon"),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["shifter/dragonblood-shifter/draconic-aspect-selection", "shifter/shifter-claws"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["shifter/dragonblood-shifter/shifter-claws-cold-iron-magic-and-silver", "shifter/woodland-grace"]),
                (level: 4),
                (level: 5),
                (level: 7, features: ["shifter/dragonblood-shifter/shifter-claws-1d6"]),
                (level: 9, features: ["shifter/dragonblood-shifter/wyrmshifter"]),
                (level: 10),
                (level: 11, features: ["shifter/dragonblood-shifter/shifter-claws-1d8"]),
                (level: 13, features: ["shifter/dragonblood-shifter/shifter-claws-1d10"]),
                (level: 14, features: ["shifter/dragonblood-shifter/improved-wyrmshifter"]),
                (level: 15),
                (level: 17, features: ["shifter/dragonblood-shifter/shifter-claws-1-crit-multiplier"]),
                (level: 19, features: ["shifter/dragonblood-shifter/shifter-claws-adamantine-and-universal"]),
                (level: 20, selections: ["shifter/dragonblood-shifter/greater-wyrmshifter"]),
            ],
        ),
        (
            key: "shifter/feyform-shifter",
            name: "Feyform Shifter",
            summary: "Shifter tied to the First World who gains fey aspects, ankou form and later minor beast aspects.",
            guide: "shifter#feyform-shifter",
            features: [
                (key: "shifter/feyform-shifter/fey-aspect", name: "Fey Aspect", summary: "Swift action for 3 + level minutes a day: DR 1/cold iron and 20% concealment, growing with wings at 5th and mind-affecting save bonuses later.", guide: "shifter#fey-aspect"),
                (key: "shifter/feyform-shifter/fey-shape", name: "Fey Shape", summary: "From 4th level, ankou form for a minute (level + Wis times a day): +20' speed, claw, wing and tail attacks, and sneak attack as a rogue of your level.", guide: "shifter#fey-shape"),
                (key: "shifter/feyform-shifter/fey-shifter", name: "Fey Shifter", summary: "At 9th level, choose a second animal aspect, whose minor form you can hold while in ankou form.", guide: "shifter#fey-shifter"),
                (key: "shifter/feyform-shifter/final-fey-aspect", name: "Final Fey Aspect", summary: "At 20th level, choose a fourth animal aspect; in ankou form you keep the extra aspects' minor forms, and you can use major and minor forms at will.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/greater-fey-shifter", name: "Greater Fey Shifter", summary: "At 14th level, choose a third animal aspect; in ankou form you can hold the minor forms of both extra aspects.", guide: "shifter#greater-fey-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-1-crit-multiplier", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-1d10", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-1d6", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-1d8", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-adamantine-and-universal", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-cold-iron-magic-and-silver", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#feyform-shifter"),
            ],
            selections: [
                (
                    key: "shifter/feyform-shifter/rogue-talent",
                    name: "Rogue Talent",
                    summary: "At 8th and 14th level, choose a rogue talent (not an advanced talent).",
                    guide: "shifter#rogue-talent",
                    option_levels: ["shifter"],
                    options: [],
                    shared_options: [
                        "rogue/rogue-talents/canny-observer",
                        "rogue/rogue-talents/combat-trick",
                        "rogue/rogue-talents/emboldening-strike",
                        "rogue/rogue-talents/fast-stealth",
                        "rogue/rogue-talents/focusing-attack-confused",
                        "rogue/rogue-talents/focusing-attack-shaken",
                        "rogue/rogue-talents/focusing-attack-sickened",
                        "rogue/rogue-talents/intimidating-prowess",
                        "rogue/rogue-talents/iron-guts",
                        "rogue/rogue-talents/jump-up",
                        "rogue/rogue-talents/mystery-seeker",
                        "rogue/rogue-talents/skill-focus",
                        "rogue/rogue-talents/slow-reactions",
                        "rogue/rogue-talents/survivalist",
                        "rogue/rogue-talents/terrain-mastery",
                        "rogue/rogue-talents/trailblazer",
                        "rogue/rogue-talents/unbalancing-trick",
                        "rogue/rogue-talents/underhanded-trick",
                        "rogue/rogue-talents/weakening-wound",
                        "rogue/rogue-talents/weapon-focus",
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["shifter/feyform-shifter/fey-aspect", "shifter/shifter-claws"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["shifter/feyform-shifter/shifter-claws-cold-iron-magic-and-silver", "shifter/woodland-grace"]),
                (level: 4, features: ["shifter/feyform-shifter/fey-shape"]),
                (level: 5),
                (level: 7, features: ["shifter/feyform-shifter/shifter-claws-1d6"]),
                (level: 8, selections: ["shifter/feyform-shifter/rogue-talent"]),
                (level: 9, features: ["shifter/feyform-shifter/fey-shifter"]),
                (level: 10),
                (level: 11, features: ["shifter/feyform-shifter/shifter-claws-1d8"]),
                (level: 13, features: ["shifter/feyform-shifter/shifter-claws-1d10"]),
                (level: 14, features: ["shifter/feyform-shifter/greater-fey-shifter"], selections: ["shifter/feyform-shifter/rogue-talent"]),
                (level: 15),
                (level: 17, features: ["shifter/feyform-shifter/shifter-claws-1-crit-multiplier"]),
                (level: 19, features: ["shifter/feyform-shifter/shifter-claws-adamantine-and-universal"]),
                (level: 20, features: ["shifter/feyform-shifter/final-fey-aspect"]),
            ],
        ),
        (
            key: "shifter/fiendflesh-shifter",
            name: "Fiendflesh Shifter",
            summary: "Worldwound-corrupted shifter who swaps beast forms for fiendish aspects.",
            guide: "shifter#fiendflesh-shifter",
            features: [
                (key: "shifter/fiendflesh-shifter/chimeric-fiend", name: "Chimeric Fiend", summary: "At 9th level, fiendish aspect gains a perk: daemon acid resistance and disease saves, demon cold resistance and +4 damage, or devil +4 AC and Reflex.", guide: "shifter#chimeric-fiend"),
                (key: "shifter/fiendflesh-shifter/fiendish-aspect", name: "Fiendish Aspect", summary: "Swift action for 3 + level minutes a day: a 1d6 gore and DR 1/good, rising to DR 10/good, wings at 5th, and SR 25 at 20th.", guide: "shifter#fiendish-aspect"),
                (key: "shifter/fiendflesh-shifter/fiendish-resilience", name: "Fiendish Resilience", summary: "From 2nd, unarmoured or in light or medium nonmetal armour: +1 natural armour (+1 at 4th, 12th, 20th) and fire and electricity resistance 5 (+10 at 8th, 16th).", guide: "shifter#fiendish-resilience"),
                (key: "shifter/fiendflesh-shifter/greater-chimeric-fiend", name: "Greater Chimeric Fiend", summary: "At 14th level: daemon +4 Con and disease immunity, demon +4 Str and bigger natural attack dice, or devil +4 Dex and blindness immunity.", guide: "shifter#greater-chimeric-fiend"),
                (key: "shifter/fiendflesh-shifter/shifter-claws-1-crit-multiplier", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter#fiendflesh-shifter"),
                (key: "shifter/fiendflesh-shifter/shifter-claws-1d10", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter#fiendflesh-shifter"),
                (key: "shifter/fiendflesh-shifter/shifter-claws-1d6", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter#fiendflesh-shifter"),
                (key: "shifter/fiendflesh-shifter/shifter-claws-1d8", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter#fiendflesh-shifter"),
                (key: "shifter/fiendflesh-shifter/shifter-claws-adamantine-and-universal", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter#fiendflesh-shifter"),
                (key: "shifter/fiendflesh-shifter/shifter-claws-cold-iron-magic-and-silver", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#fiendflesh-shifter"),
            ],
            levels: [
                (level: 1, features: ["shifter/fiendflesh-shifter/fiendish-aspect", "shifter/shifter-claws"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 2, features: ["shifter/fiendflesh-shifter/fiendish-resilience", "shifter/track"]),
                (level: 3, features: ["shifter/fiendflesh-shifter/shifter-claws-cold-iron-magic-and-silver", "shifter/woodland-grace"]),
                (level: 4),
                (level: 5),
                (level: 7, features: ["shifter/fiendflesh-shifter/shifter-claws-1d6"]),
                (level: 9, features: ["shifter/fiendflesh-shifter/chimeric-fiend"]),
                (level: 10),
                (level: 11, features: ["shifter/fiendflesh-shifter/shifter-claws-1d8"]),
                (level: 13, features: ["shifter/fiendflesh-shifter/shifter-claws-1d10"]),
                (level: 14, features: ["shifter/fiendflesh-shifter/greater-chimeric-fiend"]),
                (level: 15),
                (level: 17, features: ["shifter/fiendflesh-shifter/shifter-claws-1-crit-multiplier"]),
                (level: 19, features: ["shifter/fiendflesh-shifter/shifter-claws-adamantine-and-universal"]),
                (level: 20, features: ["shifter/final-aspect"]),
            ],
        ),
        (
            key: "shifter/griffonheart-shifter",
            name: "Griffonheart Shifter",
            summary: "Ulbrig's unique DLC archetype with a griffon aspect and form and bonus combat feats.",
            guide: "shifter#griffonheart-shifter",
            features: [
                (key: "shifter/griffonheart-shifter/griffon-aspect", name: "Griffon Aspect", summary: "For 3 + level minutes a day: +2 Str and allies within 30' get +2 against fear, growing to +8 Str, fear immunity for allies and +6 Will by 20th.", guide: "shifter#griffon-aspect"),
                (key: "shifter/griffonheart-shifter/griffon-form", name: "Griffon Form", summary: "From 4th level, griffon form for a minute: 50' speed, two 1d6 grabbing claws and a 1d8 bite; pounce at 9th and rake at 14th.", guide: "shifter#griffon-form"),
                (key: "shifter/griffonheart-shifter/shifter-claws-1-crit-multiplier", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter#griffonheart-shifter"),
                (key: "shifter/griffonheart-shifter/shifter-claws-1d10", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter#griffonheart-shifter"),
                (key: "shifter/griffonheart-shifter/shifter-claws-1d6", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter#griffonheart-shifter"),
                (key: "shifter/griffonheart-shifter/shifter-claws-1d8", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter#griffonheart-shifter"),
                (key: "shifter/griffonheart-shifter/shifter-claws-adamantine-and-universal", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter#griffonheart-shifter"),
                (key: "shifter/griffonheart-shifter/shifter-claws-cold-iron-magic-and-silver", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#griffonheart-shifter"),
            ],
            levels: [
                (level: 1, features: ["shifter/griffonheart-shifter/griffon-aspect", "shifter/shifter-claws"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"]),
