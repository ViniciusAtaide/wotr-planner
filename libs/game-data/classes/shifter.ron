                (key: "shifter/fiendflesh-shifter/fiendish-aspect", blueprint: "a52705ab3a0644e6922cffe6bbe2b002", name: "Fiendish Aspect", summary: "Swift action for 3 + level minutes a day: a 1d6 gore and DR 1/good, rising to DR 10/good, wings at 5th, and SR 25 at 20th.", guide: "shifter#fiendish-aspect"),
                (key: "shifter/fiendflesh-shifter/fiendish-resilience", blueprint: "cb30a00a269b4d3e9542da1c3a18fab0", name: "Fiendish Resilience", summary: "From 2nd, unarmoured or in light or medium nonmetal armour: +1 natural armour (+1 at 4th, 12th, 20th) and fire and electricity resistance 5 (+10 at 8th, 16th).", guide: "shifter#fiendish-resilience"),
                (key: "shifter/fiendflesh-shifter/greater-chimeric-fiend", blueprint: "5c5cb651ceaf4657a48bb388456acb06", name: "Greater Chimeric Fiend", summary: "At 14th level: daemon +4 Con and disease immunity, demon +4 Str and bigger natural attack dice, or devil +4 Dex and blindness immunity.", guide: "shifter#greater-chimeric-fiend"),
                (key: "shifter/fiendflesh-shifter/shifter-claws-1-crit-multiplier", blueprint: "76b8314a83ff4825a145ac8f7b59d6e4", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter#fiendflesh-shifter"),
