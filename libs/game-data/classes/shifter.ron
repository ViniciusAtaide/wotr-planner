        (
            key: "shifter/wild-effigy",
            name: "Wild Effigy",
            summary: "Shifter whose aspect forms are stone effigies, gaining DR and protection against crits.",
            guide: "shifter#wild-effigy",
            features: [
                (key: "shifter/wild-effigy/armor-plating", name: "Armor Plating", summary: "While shifted, gain DR/- equal to your class level.", guide: "shifter#armor-plating"),
                (key: "shifter/wild-effigy/heart-of-earth", name: "Heart of Earth", summary: "While shifted: ferocity and 25% to ignore crits and precision damage, 50% and petrification immunity at 9th, 75% and bleed immunity at 15th.", guide: "shifter#heart-of-earth"),
                (key: "shifter/wild-effigy/major-form", name: "Major Form", summary: "From 4th level, take an aspect's major form as a standard action for 1 hour at a time, Shifter level + Wis mod times a day.", guide: "shifter#wild-effigy"),
                (key: "shifter/wild-effigy/shifter-claws-1-crit-multiplier", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter#wild-effigy"),
                (key: "shifter/wild-effigy/shifter-claws-1d10", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter#wild-effigy"),
                (key: "shifter/wild-effigy/shifter-claws-1d6", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter#wild-effigy"),
                (key: "shifter/wild-effigy/shifter-claws-1d8", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter#wild-effigy"),
                (key: "shifter/wild-effigy/shifter-claws-adamantine-and-universal", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter#wild-effigy"),
                (key: "shifter/wild-effigy/shifter-claws-cold-iron-magic-and-silver", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#wild-effigy"),
                (key: "shifter/wild-effigy/stoneclaw-strike", name: "Stoneclaw Strike", summary: "From 6th level, spend 1 minute of minor aspect to ignore DR equal to your level for 1 minute.", guide: "shifter#stoneclaw-strike"),
            ],
            levels: [
                (level: 2, features: ["shifter/wild-effigy/armor-plating"]),
