                (level: 14, feat_slots: [CombatFeat]),
                (level: 15, features: ["shifter/griffonheart-shifter/griffon-aspect"]),
                (level: 17, features: ["shifter/griffonheart-shifter/shifter-claws-1-crit-multiplier"]),
                (level: 19, features: ["shifter/griffonheart-shifter/shifter-claws-adamantine-and-universal"]),
                (level: 20, features: ["shifter/final-aspect", "shifter/griffonheart-shifter/griffon-aspect"]),
            ],
        ),
        (
            key: "shifter/rageshaper",
            name: "Rageshaper",
            summary: "Shifter who trades beast forms for rage, growing larger and slamming foes.",
            guide: "shifter#rageshaper",
            features: [
                (key: "shifter/rageshaper/devastating-form", name: "Devastating Form", summary: "Swift action, level times a day: grow one size and rage for 1 minute, with one Ground Slam (1d6 a level to foes in 20', knocking them prone).", guide: "shifter#devastating-form"),
                (key: "shifter/rageshaper/invulnerable-defenses", name: "Invulnerable Defenses", summary: "From 2nd level, unarmoured or in light or medium nonmetal armour: +2 natural armour and DR 2/-, rising to DR 10/- and +4 natural armour at 20th.", guide: "shifter#invulnerable-defenses"),
                (key: "shifter/rageshaper/terrible-slam", name: "Terrible Slam", summary: "At will, two 1d4 slams that deal extra damage to constructs (+5 to +20) and otherwise work like Shifter Claws.", guide: "shifter#terrible-slam"),
                (key: "shifter/rageshaper/terrible-slam-1-crit-multiplier", name: "Terrible Slam (+1 crit multiplier)", summary: "At 17th level, slam attacks gain +1 to their critical multiplier.", guide: "shifter#rageshaper"),
                (key: "shifter/rageshaper/terrible-slam-1d10", name: "Terrible Slam (1d10)", summary: "At 13th level, slam attack base damage rises to 1d10.", guide: "shifter#rageshaper"),
                (key: "shifter/rageshaper/terrible-slam-1d6", name: "Terrible Slam (1d6)", summary: "At 7th level, slam attack base damage rises to 1d6.", guide: "shifter#rageshaper"),
                (key: "shifter/rageshaper/terrible-slam-1d8", name: "Terrible Slam (1d8)", summary: "At 11th level, slam attack base damage rises to 1d8.", guide: "shifter#rageshaper"),
                (key: "shifter/rageshaper/terrible-slam-adamantine-and-universal", name: "Terrible Slam (adamantine and universal)", summary: "At 19th level, slam attacks ignore DR/adamantine and DR/-.", guide: "shifter#rageshaper"),
                (key: "shifter/rageshaper/terrible-slam-cold-iron-magic-and-silver", name: "Terrible Slam (cold iron, magic and silver)", summary: "At 3rd level, slam attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#rageshaper"),
            ],
