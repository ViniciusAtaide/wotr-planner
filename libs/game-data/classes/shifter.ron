Class(
    key: "shifter",
    blueprint: "a406d6ebea5c46bba3160246be03e96f",
    name: "Shifter",
    summary: "Shapeshifting melee class (Last Sarkorians DLC) with animal aspects and improving claws; full BAB, 6 HP a level, good Fortitude and Reflex, 3 skill points.",
    guide: "shifter",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Good,
    will: Poor,
    save_exceptions: [(level: 2, save: Reflex, value: 2)],
    class_skills: ["athletics", "lore-nature", "mobility", "perception", "stealth"],
    prerequisite: Any([Alignment(NeutralGood), Alignment(LawfulNeutral), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil)]),
    features: [
        (key: "shifter/chimeric-aspect", blueprint: "b42b4a58facf4d88b0d341f343bd2e42", name: "Chimeric Aspect", summary: "At 9th level, hold two minor aspects at once.", guide: "shifter#chimeric-aspect"),
        (key: "shifter/defensive-instinct", blueprint: "43295870ce5344ffa718d100b742438e", name: "Defensive Instinct", summary: "From 2nd level, unarmoured: add Wis to AC and CMD (also vs touch and flat-footed), +1 at 4th and every four levels; half Wis in non-metal armour.", guide: "shifter#defensive-instinct"),
        (key: "shifter/final-aspect", blueprint: "5a155f5c3f834a319feab52dc66ee185", name: "Final Aspect", summary: "At 20th level, take the minor forms of all your aspects at once and use major and minor forms at will.", guide: "shifter#final-aspect"),
        (key: "shifter/greater-chimeric-aspect", blueprint: "29b6f12ebb17485fa783f6e284bab6b3", name: "Greater Chimeric Aspect", summary: "At 14th level, hold three minor aspects at once.", guide: "shifter#greater-chimeric-aspect"),
        (key: "shifter/major-form", blueprint: "6e843ca5ae8e41aea17458fb4c16a15d", name: "Major Form", summary: "From 4th level, take an aspect's major form as a standard action for 1 hour at a time, Shifter level + Wis mod times a day.", guide: "shifter"),
        (key: "shifter/shifter-claws", blueprint: "08a8cfba6ae34505a64d6ba00225c4d2", name: "Shifter Claws", summary: "Swift action outside major form: claws dealing 1d4, rising to 1d10 with a better crit and DR bypass by 19th; shifted primary natural attacks share them.", guide: "shifter#shifter-claws"),
        (key: "shifter/shifter-claws-1-crit-multiplier", blueprint: "76b8314a83ff4825a145ac8f7b59d6e4", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter"),
        (key: "shifter/shifter-claws-1d10", blueprint: "024b8248f85d412cb7c520a9f746c547", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter"),
        (key: "shifter/shifter-claws-1d6", blueprint: "19b7335626b3434cbe2af01fb33582ff", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter"),
        (key: "shifter/shifter-claws-1d8", blueprint: "8d6b338131764a4fb68eaf5b5c6cfe47", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter"),
        (key: "shifter/shifter-claws-adamantine-and-universal", blueprint: "28991899db1948d9bdd5f958b4add2d8", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter"),
        (key: "shifter/shifter-claws-cold-iron-magic-and-silver", blueprint: "f7996c5b51e348fc9277480d9cc0a88c", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter"),
        (key: "shifter/shifters-fury", blueprint: "7af3fd83da684a7083d20a751c25b5f4", name: "Shifter\'s Fury", summary: "From 6th level, full attack with one natural weapon to get iterative attacks; your other natural attacks become secondary.", guide: "shifter#shifters-fury"),
        (key: "shifter/track", blueprint: "1fd8085a71c94a2a94266cbeba71a562", name: "Track", summary: "From 2nd level, add half your level to Lore (Nature) checks.", guide: "shifter#track"),
        (key: "shifter/woodland-grace", blueprint: "0217aaa0c3f74dc39643c3e841636625", name: "Woodland Grace", summary: "From 3rd level, ignore difficult terrain, immune to entangled, and +2 AC against attacks of opportunity.", guide: "shifter#woodland-grace"),
    ],
    selections: [
        (
            key: "shifter/shifter-aspect",
            blueprint: "121829d239124685b430f5263031bf83",
            name: "Shifter Aspect",
            summary: "Minor form for 3 + level minutes a day (swift); from 4th, major form for an hour, level + Wis times a day; new aspect at 5th, 10th, 15th and 20th.",
            guide: "shifter#shifter-aspect",
            options: [
                (key: "shifter/shifter-aspect/bear-aspect", blueprint: "73ef2c330ff14e4bb2f5b7300622c552", name: "Bear Aspect", summary: "Minor: +2 Con (+4 at 8th, +6 at 15th). Major: +10' speed, scent, 1d8 bite and two 1d6 grabbing claws, improving at 8th and 15th.", guide: "shifter#bear-aspect"),
                (key: "shifter/shifter-aspect/boar-aspect", blueprint: "9ee4074cbae746ba96463c0b2a562226", name: "Boar Aspect", summary: "Minor: +2 Fortitude (+4 at 8th, +6 at 15th). Major: +10' speed, scent and a 1d8 gore; powerful charge at 8th, +1 HP a level at 15th.", guide: "shifter#boar-aspect"),
                (key: "shifter/shifter-aspect/dinosaur-aspect", blueprint: "b8ba81c46d904603b8fe4d3c361c5d5e", name: "Dinosaur Aspect", summary: "Minor: +2 initiative (+4 at 8th, +6 at 15th). Major: +30' speed, scent, 1d6 bite, two 1d8 talons and pounce; more at 8th and 15th.", guide: "shifter#dinosaur-aspect"),
                (key: "shifter/shifter-aspect/horse-aspect", blueprint: "e8c3d7a903a6433bbcfb3d70c97451ce", name: "Horse Aspect", summary: "Minor: Endurance and +5' speed (+15' at 15th). Major: +20' speed, scent, two 1d4 hooves, double damage on charges and overruns.", guide: "shifter#horse-aspect"),
                (key: "shifter/shifter-aspect/lizard-aspect", blueprint: "534e48fa35914f1d93f8813ff4213729", name: "Lizard Aspect", summary: "Minor: +2 Reflex (+4 at 8th, +6 at 15th). Major: +10' speed (+30' at 8th), scent and a 1d8 grabbing bite.", guide: "shifter#lizard-aspect"),
                (key: "shifter/shifter-aspect/mammoth-aspect", blueprint: "f6d14c560a3d41edbaee68110bd21c62", name: "Mammoth Aspect", summary: "Minor: +2 Str (+4 at 8th, +6 at 15th). Major: scent, 1d6 gore, two 1d8 slams, +2 Str and +2 natural armour (+4 at 15th).", guide: "shifter#mammoth-aspect"),
                (key: "shifter/shifter-aspect/spider-aspect", blueprint: "e3c2c68adaa344aca0354750044611a2", name: "Spider Aspect", summary: "Minor: +2 dodge AC (+4 at 8th, +6 at 15th). Major: tremorsense, a 1d6 bite and a web ranged touch attack that immobilises.", guide: "shifter#spider-aspect"),
                (key: "shifter/shifter-aspect/tiger-aspect", blueprint: "ab2bffed0cc2447fae15ee4e0942578f", name: "Tiger Aspect", summary: "Minor: +2 Dex (+4 at 8th, +6 at 15th). Major: +10' speed, scent, 2d6 bite, two 2d4 claws, grab and pounce; rake at 15th.", guide: "shifter#tiger-aspect"),
                (key: "shifter/shifter-aspect/wolf-aspect", blueprint: "ddf5d65742c842d79f74ac0d5cfbedf5", name: "Wolf Aspect", summary: "Minor: scent and +2 natural attack damage (+4 at 8th, +6 at 15th). Major: +10' speed, scent and a 1d8 bite that can trip for free.", guide: "shifter#wolf-aspect"),
                (key: "shifter/shifter-aspect/wolverine-aspect", blueprint: "4fc5f64d13ce4c0e8258a83ff63c50af", name: "Wolverine Aspect", summary: "Minor: +2 HP a level and +2 Con, rising later. Major: +10' speed, scent, 1d6 bite, two 1d8 claws, and rage when damaged.", guide: "shifter#wolverine-aspect"),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["shifter/shifter-claws"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"], selections: ["shifter/shifter-aspect"]),
        (level: 2, features: ["shifter/defensive-instinct", "shifter/track"]),
        (level: 3, features: ["shifter/shifter-claws-cold-iron-magic-and-silver", "shifter/woodland-grace"]),
        (level: 4, features: ["shifter/major-form"]),
        (level: 5, selections: ["shifter/shifter-aspect"]),
        (level: 6, features: ["shifter/shifters-fury"]),
        (level: 7, features: ["shifter/shifter-claws-1d6"]),
        (level: 8),
        (level: 9, features: ["shifter/chimeric-aspect"]),
        (level: 10, selections: ["shifter/shifter-aspect"]),
        (level: 11, features: ["shifter/shifter-claws-1d8"]),
        (level: 12),
        (level: 13, features: ["shifter/shifter-claws-1d10"]),
        (level: 14, features: ["shifter/greater-chimeric-aspect"]),
        (level: 15, selections: ["shifter/shifter-aspect"]),
        (level: 16),
        (level: 17, features: ["shifter/shifter-claws-1-crit-multiplier"]),
        (level: 18),
        (level: 19, features: ["shifter/shifter-claws-adamantine-and-universal"]),
        (level: 20, features: ["shifter/final-aspect"], selections: ["shifter/shifter-aspect"]),
    ],
    archetypes: [
        (
            key: "shifter/child-of-the-manticore",
            blueprint: "1a51b5856d3b48d78b3e967dc5f20bd6",
            name: "Child of the Manticore",
            summary: "Shifter limited to a single Manticore aspect, throwing spikes from their body.",
            guide: "shifter#child-of-the-manticore",
            features: [
                (key: "shifter/child-of-the-manticore/grow-spikes", blueprint: "554c352806644367a5286b9cae289a37", name: "Grow Spikes", summary: "From 1st level, throw spikes as a ranged attack, dealing 1d4 and improving like Shifter Claws up to 1d10, +1 crit and DR bypass.", guide: "shifter#grow-spikes"),
                (key: "shifter/child-of-the-manticore/grow-spikes-1-crit-multiplier", blueprint: "9afa32537e9a4959818b235c61ecb42e", name: "Grow Spikes (+1 crit multiplier)", summary: "At 17th level, spike attacks gain +1 to their critical multiplier.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-1d10", blueprint: "148e5047cffa42abb50c8f741a53a4c4", name: "Grow Spikes (1d10)", summary: "At 13th level, spike attack base damage rises to 1d10.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-1d6", blueprint: "0d08c683ae7d444a8423062afd181e79", name: "Grow Spikes (1d6)", summary: "At 7th level, spike attack base damage rises to 1d6.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-1d8", blueprint: "146cd9071114489e9d13d56f306a5a7e", name: "Grow Spikes (1d8)", summary: "At 11th level, spike attack base damage rises to 1d8.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-adamantine-and-universal", blueprint: "8b58cbab4a9b416ab540b5f364190c5a", name: "Grow Spikes (adamantine and universal)", summary: "At 19th level, spike attacks ignore DR/adamantine and DR/-.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/grow-spikes-cold-iron-magic-and-silver", blueprint: "732f9a584fac48fbb74a57fc38a6154b", name: "Grow Spikes (cold iron, magic and silver)", summary: "At 3rd level, spike attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#child-of-the-manticore"),
                (key: "shifter/child-of-the-manticore/manticore-aspect", blueprint: "50b0bb6a4c824a06adc5e56c079a0a1d", name: "Manticore Aspect", summary: "Minor form for 3 + level minutes a day: +2 Str and Dex (+8 at 20th); throws two spikes with the first attack at 5th, four at 20th.", guide: "shifter#manticore-aspect"),
                (key: "shifter/child-of-the-manticore/manticore-shape", blueprint: "719be33c87f94ed58414ba3eb5a4b664", name: "Manticore Shape", summary: "From 4th level, manticore form for a minute (level + Wis times a day): +10' speed, scent and four 1d6 spike attacks; more at 9th and 14th.", guide: "shifter#manticore-shape"),
            ],
            levels: [
                (level: 1, features: ["shifter/child-of-the-manticore/grow-spikes", "shifter/child-of-the-manticore/manticore-aspect"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["shifter/child-of-the-manticore/grow-spikes-cold-iron-magic-and-silver", "shifter/woodland-grace"]),
                (level: 4, features: ["shifter/child-of-the-manticore/manticore-shape"]),
                (level: 5, features: ["shifter/child-of-the-manticore/manticore-aspect"]),
                (level: 7, features: ["shifter/child-of-the-manticore/grow-spikes-1d6"]),
                (level: 9, features: ["shifter/child-of-the-manticore/manticore-shape"]),
                (level: 10, features: ["shifter/child-of-the-manticore/manticore-aspect"]),
                (level: 11, features: ["shifter/child-of-the-manticore/grow-spikes-1d8"]),
                (level: 13, features: ["shifter/child-of-the-manticore/grow-spikes-1d10"]),
                (level: 14, features: ["shifter/child-of-the-manticore/manticore-shape"]),
                (level: 15, features: ["shifter/child-of-the-manticore/manticore-aspect"]),
                (level: 17, features: ["shifter/child-of-the-manticore/grow-spikes-1-crit-multiplier"]),
                (level: 19, features: ["shifter/child-of-the-manticore/grow-spikes-adamantine-and-universal"]),
                (level: 20, features: ["shifter/child-of-the-manticore/manticore-aspect"]),
            ],
        ),
        (
            key: "shifter/dragonblood-shifter",
            blueprint: "2d5b06e413a9408cbd5bb999b5a4cc4a",
            name: "Dragonblood Shifter",
            summary: "Shifter who swaps beast aspects for draconic ones and eventually becomes a dragon.",
            guide: "shifter#dragonblood-shifter",
            features: [
                (key: "shifter/dragonblood-shifter/draconic-aspect-selection", blueprint: "c2872505b99c43b8b146ed89ffeb9af5", name: "Draconic Aspect Selection", summary: "Swift action for 3 + level minutes a day: scent and resistance 5 to a dragon's element, healing you by what it resists; dragon type limited by alignment.", guide: "shifter#draconic-aspect-selection"),
                (key: "shifter/dragonblood-shifter/improved-wyrmshifter", blueprint: "5cae07b7e9474d3eb382baa703e82ca8", name: "Improved Wyrmshifter", summary: "At 14th level, +4 against sleep and paralysis, and dragon form as Dragonkind II for an hour, level + Wis times a day.", guide: "shifter#improved-wyrmshifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-1-crit-multiplier", blueprint: "76b8314a83ff4825a145ac8f7b59d6e4", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-1d10", blueprint: "024b8248f85d412cb7c520a9f746c547", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-1d6", blueprint: "19b7335626b3434cbe2af01fb33582ff", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-1d8", blueprint: "8d6b338131764a4fb68eaf5b5c6cfe47", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-adamantine-and-universal", blueprint: "28991899db1948d9bdd5f958b4add2d8", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/shifter-claws-cold-iron-magic-and-silver", blueprint: "f7996c5b51e348fc9277480d9cc0a88c", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#dragonblood-shifter"),
                (key: "shifter/dragonblood-shifter/wyrmshifter", blueprint: "d8e9d249a426400bb47fefa6d0158049", name: "Wyrmshifter", summary: "At 9th level, +2 against sleep and paralysis, and dragon form as Dragonkind I for a minute at a time, level + Wis times a day.", guide: "shifter#wyrmshifter"),
            ],
            selections: [
                (
                    key: "shifter/dragonblood-shifter/greater-wyrmshifter",
                    blueprint: "c676ba5eb744492583d989244c81f127",
                    name: "Greater Wyrmshifter",
                    summary: "At 20th level, become a dragon at will: +10 Str, +8 Con, +8 natural armour, DR 10/magic, strong natural attacks and a 16d8 breath.",
                    guide: "shifter#greater-wyrmshifter",
                    options: [
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-black-dragon", blueprint: "9395529a585147c08623e28ae236805f", name: "Breath Weapon (Black Dragon)", summary: "16d8 acid in a 100' line; foes who fail the save take -5 on attack rolls for 2-5 rounds.", guide: "shifter#breath-weapon-black-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-brass-dragon", blueprint: "c8cbf8d8bef54355bd90088738112ca3", name: "Breath Weapon (Brass Dragon)", summary: "16d8 fire in a 100' line; allies are unharmed and gain +10' speed and an extra melee attack for 2-5 rounds.", guide: "shifter#breath-weapon-brass-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-bronze-dragon", blueprint: "945a4ada761e45f8a973dd25862fbc21", name: "Breath Weapon (Bronze Dragon)", summary: "16d8 electricity in a 100' line; allies are unharmed and gain +5 dodge AC for 2-5 rounds.", guide: "shifter#breath-weapon-bronze-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-buse-dragon", blueprint: "0a75184855e94ca98cd16b0e898605b3", name: "Breath Weapon (Buse Dragon)", summary: "16d8 electricity in a 100' line; foes who fail the save take -3 on saves for 2-5 rounds.", guide: "shifter#breath-weapon-buse-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-copper-dragon", blueprint: "ccfa68636d4a48b195e2422fda823779", name: "Breath Weapon (Copper Dragon)", summary: "16d8 acid in a 100' line; allies are unharmed and gain +5 natural armour for 2-5 rounds.", guide: "shifter#breath-weapon-copper-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-gold-dragon", blueprint: "f7161538989a4e9c9980b4dfb35fdd80", name: "Breath Weapon (Gold Dragon)", summary: "16d8 fire in a 50' cone; allies are healed for the same amount instead.", guide: "shifter#breath-weapon-gold-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-green-dragon", blueprint: "c855de152eda4f029a97c022bdc3a87f", name: "Breath Weapon (Green Dragon)", summary: "16d8 acid in a 50' cone; foes who fail the save take another 16d8 for 2-5 rounds.", guide: "shifter#breath-weapon-green-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-red-dragon", blueprint: "c9e329f4ad974c2e890bd27ca0eaa62d", name: "Breath Weapon (Red Dragon)", summary: "16d8 fire in a 50' cone; foes who fail the save take -5 AC for 2-5 rounds.", guide: "shifter#breath-weapon-red-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-silver-dragon", blueprint: "e8db225fbc68426b8d7e216906c2968b", name: "Breath Weapon (Silver Dragon)", summary: "16d8 cold in a 50' cone; allies are unharmed and gain +5 sacred to attack and damage for 2-5 rounds.", guide: "shifter#breath-weapon-silver-dragon"),
                        (key: "shifter/dragonblood-shifter/greater-wyrmshifter/breath-weapon-white-dragon", blueprint: "5ed93a0d8f3a48beb869feb44589b9f9", name: "Breath Weapon (White Dragon)", summary: "16d8 cold in a 50' cone; foes who fail the save are paralysed and take 20 cold a round until a Fortitude save.", guide: "shifter#breath-weapon-white-dragon"),
                    ],
                ),
            ],
            levels: [
                (level: 1, features: ["shifter/dragonblood-shifter/draconic-aspect-selection", "shifter/shifter-claws"], feats: ["armor-proficiency-light-armor", "armor-proficiency-medium-armor", "shield-proficiency", "simple-weapon-proficiency"]),
                (level: 3, features: ["shifter/dragonblood-shifter/shifter-claws-cold-iron-magic-and-silver", "shifter/woodland-grace"]),
                (level: 4),
                (level: 5),
                (level: 7, features: ["shifter/dragonblood-shifter/shifter-claws-1d6"]),
                (level: 9, features: ["shifter/dragonblood-shifter/wyrmshifter"]),
                (level: 10),
                (level: 11, features: ["shifter/dragonblood-shifter/shifter-claws-1d8"]),
                (level: 13, features: ["shifter/dragonblood-shifter/shifter-claws-1d10"]),
                (level: 14, features: ["shifter/dragonblood-shifter/improved-wyrmshifter"]),
                (level: 15),
                (level: 17, features: ["shifter/dragonblood-shifter/shifter-claws-1-crit-multiplier"]),
                (level: 19, features: ["shifter/dragonblood-shifter/shifter-claws-adamantine-and-universal"]),
                (level: 20, selections: ["shifter/dragonblood-shifter/greater-wyrmshifter"]),
            ],
        ),
        (
            key: "shifter/feyform-shifter",
            blueprint: "1cdfc7d306d1430eac19427539b62091",
            name: "Feyform Shifter",
            summary: "Shifter tied to the First World who gains fey aspects, ankou form and later minor beast aspects.",
            guide: "shifter#feyform-shifter",
            features: [
                (key: "shifter/feyform-shifter/fey-aspect", blueprint: "906fae8f17fd4be98fbea399ae4deb3e", name: "Fey Aspect", summary: "Swift action for 3 + level minutes a day: DR 1/cold iron and 20% concealment, growing with wings at 5th and mind-affecting save bonuses later.", guide: "shifter#fey-aspect"),
                (key: "shifter/feyform-shifter/fey-shape", blueprint: "24a4fb8991344fd5beb2a1a1a517da87", name: "Fey Shape", summary: "From 4th level, ankou form for a minute (level + Wis times a day): +20' speed, claw, wing and tail attacks, and sneak attack as a rogue of your level.", guide: "shifter#fey-shape"),
                (key: "shifter/feyform-shifter/fey-shifter", blueprint: "20efbac7ae764021a629da1bd351140e", name: "Fey Shifter", summary: "At 9th level, choose a second animal aspect, whose minor form you can hold while in ankou form.", guide: "shifter#fey-shifter"),
                (key: "shifter/feyform-shifter/final-fey-aspect", blueprint: "d7bb76c183e245eda8b1074560895806", name: "Final Fey Aspect", summary: "At 20th level, choose a fourth animal aspect; in ankou form you keep the extra aspects' minor forms, and you can use major and minor forms at will.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/greater-fey-shifter", blueprint: "947c8db8b3be4e5f985327ffaf892a6a", name: "Greater Fey Shifter", summary: "At 14th level, choose a third animal aspect; in ankou form you can hold the minor forms of both extra aspects.", guide: "shifter#greater-fey-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-1-crit-multiplier", blueprint: "76b8314a83ff4825a145ac8f7b59d6e4", name: "Shifter Claws (+1 crit multiplier)", summary: "At 17th level, claw attacks gain +1 to their critical multiplier.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-1d10", blueprint: "024b8248f85d412cb7c520a9f746c547", name: "Shifter Claws (1d10)", summary: "At 13th level, claw base damage rises to 1d10.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-1d6", blueprint: "19b7335626b3434cbe2af01fb33582ff", name: "Shifter Claws (1d6)", summary: "At 7th level, claw base damage rises to 1d6.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-1d8", blueprint: "8d6b338131764a4fb68eaf5b5c6cfe47", name: "Shifter Claws (1d8)", summary: "At 11th level, claw base damage rises to 1d8.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-adamantine-and-universal", blueprint: "28991899db1948d9bdd5f958b4add2d8", name: "Shifter Claws (adamantine and universal)", summary: "At 19th level, claw attacks ignore DR/adamantine and DR/-.", guide: "shifter#feyform-shifter"),
                (key: "shifter/feyform-shifter/shifter-claws-cold-iron-magic-and-silver", blueprint: "f7996c5b51e348fc9277480d9cc0a88c", name: "Shifter Claws (cold iron, magic and silver)", summary: "At 3rd level, claw attacks ignore DR/cold iron, DR/magic and DR/silver.", guide: "shifter#feyform-shifter"),
            ],
