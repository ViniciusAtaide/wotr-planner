Class(
    key: "assassin",
    blueprint: "eb284ea8d40a2d045911f525eb96c43d",
    name: "Assassin",
    summary: "Ten-level neutral or evil killer with 3/4 BAB and 5 HP per level: sneak attack, Mark of Death, poisons and an instant-kill attack on marked foes.",
    guide: "prestige-classes#assassin",
    skill_points: 3,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
    prerequisite: All([Any([Alignment(TrueNeutral), Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)]), SkillRanks(skill: "stealth", ranks: 5), CharacterLevel(6)]),
    features: [
        (key: "assassin/alter-ego", blueprint: "18723d73d81e479c93576070fb374b03", name: "Alter Ego", summary: "1 + Int modifier times a day, make mirror-image copies (1, +1 per 3 levels, 3 at 9th); while one is out, you deal sneak damage to every creature.", guide: "prestige-classes#alter-ego"),
        (key: "assassin/cold-minded", blueprint: "dc71af4fbb014aae958c11fa10ec6ab3", name: "Cold Minded", summary: "Saves vs compulsion, emotion, fear and other mind-affecting effects: +2, then +3 from 5th level and +4 from 8th.", guide: "prestige-classes#cold-minded"),
        (key: "assassin/hide-in-plain-sight", blueprint: "fa113a54bc69daf4485ad89315c6cfb6", name: "Hide In Plain Sight", summary: "Being watched no longer stops you from slipping into Stealth.", guide: "prestige-classes#hide-in-plain-sight"),
        (key: "assassin/mark-of-death", blueprint: "7fb63cb0ca6542cc85426332e5ac321d", name: "Mark of Death", summary: "Spend a standard action marking a foe; from then on your attacks on it bypass its DR and resistances.", guide: "prestige-classes#mark-of-death"),
        (key: "assassin/master-assassin", blueprint: "b2bcc7efc9d59af42836bc5ba9e1a5e0", name: "Master Assassin", summary: "Target Assassination drops to a standard action; its hit always counts as a sneak attack, flanked or flat-footed or not.", guide: "prestige-classes#master-assassin"),
        (key: "assassin/master-of-poisons", blueprint: "46f078533d4241b5afa64be3c5201d74", name: "Master of Poisons", summary: "A Fort save no longer fully stops your poison: it still deals its ability damage for 1 round.", guide: "prestige-classes#master-of-poisons"),
        (key: "assassin/poison-use-constitution", blueprint: "4b28d5c267df88743afb272a2a874220", name: "Poison Use - Constitution", summary: "The 4th-level Poison Use step, which the guide's level table names Constitution; its text adds no details.", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-increased-duration", blueprint: "953e47bbeb7c55145884de118f812b28", name: "Poison Use - Increased Duration", summary: "Your poison lasts 1 round longer (gained at 3rd, 6th and 9th level).", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-strength-or-dexterity", blueprint: "8dd826513ba857645b38e918f17b59e6", name: "Poison Use - Strength or Dexterity", summary: "2 x level + 6 doses a day; a coated hit deals 1d4 Str or Dex damage for 4 rounds (Fort DC 10 + level + Int, +2 on a sneak attack).", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-swift", blueprint: "bb7b571cadb6cc147a52431385a40a0d", name: "Poison Use - Swift", summary: "Coat your weapon with poison as a swift action instead of a move action.", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-three-saves-required", blueprint: "0cbb2201a65cb374fb4d73d6c9830b01", name: "Poison Use - Three Saves Required", summary: "Shaking off your poison now takes three passed saves.", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-two-saves-required", blueprint: "0cbb2201a65cb374fb4d73d6c9830b01", name: "Poison Use - Two Saves Required", summary: "Shaking off your poison now takes two passed saves instead of one.", guide: "prestige-classes#poison-use"),
        (key: "assassin/public-execution", blueprint: "0579b74972044b4ab2f88fa74cdc13e2", name: "Public Execution", summary: "Dropping a foe to 0 HP makes a demoralise attempt against every enemy within 30 feet, at +2 if the victim was marked for death.", guide: "prestige-classes#public-execution"),
        (key: "assassin/sneak-attack", blueprint: "9b9eac6709e1c084cb18c3a366e0ec87", name: "Sneak Attack", summary: "Sneak attack of 1d6, growing by 1d6 at levels 3, 5, 7 and 9.", guide: "prestige-classes#sneak-attack-assassin"),
        (key: "assassin/swift-death", blueprint: "bd4ab5d731cc411483011cb33d9077ae", name: "Swift Death", summary: "Mark of Death becomes a swift action.", guide: "prestige-classes#swift-death"),
        (key: "assassin/target-assassination", blueprint: "d86609703c0b37445828a23140385721", name: "Target Assassination", summary: "Full-round attack at -2 on a marked foe that can't see you: it dies on a failed Fort save (DC 10 + level + Int), else takes a crit; shaken 1d4 rounds.", guide: "prestige-classes#target-assassination"),
        (key: "assassin/uncanny-dodge", blueprint: "8f800ed6ce8c42e8a01fd8f3e990c459", name: "Uncanny Dodge", summary: "You're never flat-footed and keep your Dex bonus to AC against invisible attackers; a second source upgrades it to Improved Uncanny Dodge.", guide: "prestige-classes#uncanny-dodge-assassin"),
    ],
    levels: [
        (level: 1, features: ["assassin/mark-of-death", "assassin/sneak-attack", "assassin/target-assassination"]),
        (level: 2, features: ["assassin/cold-minded", "assassin/poison-use-strength-or-dexterity", "assassin/uncanny-dodge"]),
        (level: 3, features: ["assassin/alter-ego", "assassin/poison-use-increased-duration", "assassin/sneak-attack"]),
        (level: 4, features: ["assassin/poison-use-constitution", "assassin/public-execution"]),
        (level: 5, features: ["assassin/cold-minded", "assassin/hide-in-plain-sight", "assassin/poison-use-two-saves-required", "assassin/sneak-attack"]),
        (level: 6, features: ["assassin/poison-use-increased-duration"]),
        (level: 7, features: ["assassin/poison-use-swift", "assassin/sneak-attack", "assassin/swift-death"]),
        (level: 8, features: ["assassin/cold-minded", "assassin/poison-use-increased-duration"]),
        (level: 9, features: ["assassin/poison-use-three-saves-required", "assassin/sneak-attack"]),
        (level: 10, features: ["assassin/master-assassin", "assassin/master-of-poisons"]),
    ],
)
