Class(
    key: "assassin",
    name: "Assassin",
    summary: "Ten-level neutral or evil killer with 3/4 BAB and 5 HP per level: sneak attack, Mark of Death, poisons and an instant-kill attack on marked foes.",
    guide: "prestige-classes#assassin",
    skill_points: 3,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["mobility", "perception", "persuasion", "stealth", "trickery", "use-magic-device"],
    prerequisite: All([Any([Alignment(TrueNeutral), Alignment(LawfulEvil), Alignment(NeutralEvil), Alignment(ChaoticEvil)]), SkillRanks(skill: "stealth", ranks: 5), CharacterLevel(6)]),
    features: [
        (key: "assassin/alter-ego", name: "Alter Ego", summary: "1 + Int modifier times a day, make mirror-image copies (1, +1 per 3 levels, 3 at 9th); while one is out, you deal sneak damage to every creature.", guide: "prestige-classes#alter-ego"),
        (key: "assassin/cold-minded", name: "Cold Minded", summary: "Saves vs compulsion, emotion, fear and other mind-affecting effects: +2, then +3 from 5th level and +4 from 8th.", guide: "prestige-classes#cold-minded"),
        (key: "assassin/hide-in-plain-sight", name: "Hide In Plain Sight", summary: "Being watched no longer stops you from slipping into Stealth.", guide: "prestige-classes#hide-in-plain-sight"),
        (key: "assassin/mark-of-death", name: "Mark of Death", summary: "Spend a standard action marking a foe; from then on your attacks on it bypass its DR and resistances.", guide: "prestige-classes#mark-of-death"),
        (key: "assassin/master-assassin", name: "Master Assassin", summary: "Target Assassination drops to a standard action; its hit always counts as a sneak attack, flanked or flat-footed or not.", guide: "prestige-classes#master-assassin"),
        (key: "assassin/master-of-poisons", name: "Master of Poisons", summary: "A Fort save no longer fully stops your poison: it still deals its ability damage for 1 round.", guide: "prestige-classes#master-of-poisons"),
        (key: "assassin/poison-use-constitution", name: "Poison Use - Constitution", summary: "The 4th-level Poison Use step, which the guide's level table names Constitution; its text adds no details.", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-increased-duration", name: "Poison Use - Increased Duration", summary: "Your poison lasts 1 round longer (gained at 3rd, 6th and 9th level).", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-strength-or-dexterity", name: "Poison Use - Strength or Dexterity", summary: "2 x level + 6 doses a day; a coated hit deals 1d4 Str or Dex damage for 4 rounds (Fort DC 10 + level + Int, +2 on a sneak attack).", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-swift", name: "Poison Use - Swift", summary: "Coat your weapon with poison as a swift action instead of a move action.", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-three-saves-required", name: "Poison Use - Three Saves Required", summary: "Shaking off your poison now takes three passed saves.", guide: "prestige-classes#poison-use"),
        (key: "assassin/poison-use-two-saves-required", name: "Poison Use - Two Saves Required", summary: "Shaking off your poison now takes two passed saves instead of one.", guide: "prestige-classes#poison-use"),
        (key: "assassin/public-execution", name: "Public Execution", summary: "Dropping a foe to 0 HP makes a demoralise attempt against every enemy within 30 feet, at +2 if the victim was marked for death.", guide: "prestige-classes#public-execution"),
        (key: "assassin/sneak-attack", name: "Sneak Attack", summary: "Sneak attack of 1d6, growing by 1d6 at levels 3, 5, 7 and 9.", guide: "prestige-classes#sneak-attack-assassin"),
        (key: "assassin/swift-death", name: "Swift Death", summary: "Mark of Death becomes a swift action.", guide: "prestige-classes#swift-death"),
        (key: "assassin/target-assassination", name: "Target Assassination", summary: "Full-round attack at -2 on a marked foe that can't see you: it dies on a failed Fort save (DC 10 + level + Int), else takes a crit; shaken 1d4 rounds.", guide: "prestige-classes#target-assassination"),
        (key: "assassin/uncanny-dodge", name: "Uncanny Dodge", summary: "You're never flat-footed and keep your Dex bonus to AC against invisible attackers; a second source upgrades it to Improved Uncanny Dodge.", guide: "prestige-classes#uncanny-dodge-assassin"),
    ],
    levels: [
        (level: 1, features: ["assassin/mark-of-death", "assassin/sneak-attack", "assassin/target-assassination"]),
        (level: 2, features: ["assassin/cold-minded", "assassin/poison-use-strength-or-dexterity", "assassin/uncanny-dodge"]),
        (level: 3, features: ["assassin/alter-ego", "assassin/poison-use-increased-duration", "assassin/sneak-attack"]),
        (level: 4, features: ["assassin/poison-use-constitution", "assassin/public-execution"]),
        (level: 5, features: ["assassin/cold-minded", "assassin/hide-in-plain-sight", "assassin/poison-use-two-saves-required", "assassin/sneak-attack"]),
        (level: 6, features: ["assassin/poison-use-increased-duration"]),
        (level: 7, features: ["assassin/poison-use-swift", "assassin/sneak-attack", "assassin/swift-death"]),
        (level: 8, features: ["assassin/cold-minded", "assassin/poison-use-increased-duration"]),
        (level: 9, features: ["assassin/poison-use-three-saves-required", "assassin/sneak-attack"]),
        (level: 10, features: ["assassin/master-assassin", "assassin/master-of-poisons"]),
    ],
)
