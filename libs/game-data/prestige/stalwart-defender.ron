Class(
    key: "stalwart-defender",
    name: "Stalwart Defender",
    summary: "Ten-level tank with full BAB and 7 HP per level: dodge AC, a defensive stance that roots you in place, defensive powers, uncanny dodge and DR up to 5/-.",
    guide: "prestige-classes#stalwart-defender",
    skill_points: 2,
    bab: Full,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["athletics", "perception"],
    prerequisite: All([Feat("dodge"), Feat("toughness"), BaseAttackBonus(7), CharacterLevel(8)]),
    features: [
        (key: "stalwart-defender/ac-bonus", name: "AC Bonus", summary: "+1 dodge AC, plus 1 more per three further class levels (+4 at 10th).", guide: "prestige-classes#ac-bonus"),
        (key: "stalwart-defender/damage-reduction", name: "Damage Reduction", summary: "DR 1/- at 5th level, 3/- at 7th and 5/- at 10th.", guide: "prestige-classes#damage-reduction"),
        (key: "stalwart-defender/defensive-stance", name: "Defensive Stance", summary: "Free action, 4 + Con rounds (+2 per level): +2 dodge AC, +2 attack, damage and Will, 2 temp HP per HD; you can't move and are fatigued after.", guide: "prestige-classes#defensive-stance"),
        (key: "stalwart-defender/improved-uncanny-dodge", name: "Improved Uncanny Dodge", summary: "You can't be flanked; a rogue needs four more rogue levels than your class level to sneak attack you.", guide: "prestige-classes#improved-uncanny-dodge"),
        (key: "stalwart-defender/uncanny-dodge", name: "Uncanny Dodge", summary: "You can't be caught flat-footed or lose Dex to AC against invisible attackers.", guide: "prestige-classes#uncanny-dodge-stalwart-defender"),
    ],
    selections: [
        (
            key: "stalwart-defender/defensive-powers",
            name: "Defensive Powers",
            summary: "At 2nd level and every even level, a power that works while in Defensive Stance.",
            guide: "prestige-classes#defensive-powers",
            options: [
                (key: "stalwart-defender/defensive-powers/clear-mind", name: "Clear Mind", summary: "In stance, reroll a failed Will save and keep the second roll.", guide: "prestige-classes#clear-mind"),
                (key: "stalwart-defender/defensive-powers/fearless-defense", name: "Fearless Defense", summary: "From 4th level: immune to shaken and frightened while in stance.", guide: "prestige-classes#fearless-defense", prerequisite: ClassLevel(class: "stalwart-defender", level: 4)),
                (key: "stalwart-defender/defensive-powers/immobile", name: "Immobile", summary: "From 4th level: add your class level to CMD against bull rush while in stance.", guide: "prestige-classes#immobile", prerequisite: ClassLevel(class: "stalwart-defender", level: 4)),
                (key: "stalwart-defender/defensive-powers/increased-damage-reduction", name: "Increased Damage Reduction", summary: "From 6th level: +1/- DR while in stance; can be taken twice.", guide: "prestige-classes#increased-damage-reduction", repeat: Times(2), prerequisite: ClassLevel(class: "stalwart-defender", level: 6)),
                (key: "stalwart-defender/defensive-powers/internal-fortitude", name: "Internal Fortitude", summary: "Immune to sickened and nauseated while in stance.", guide: "prestige-classes#internal-fortitude"),
                (key: "stalwart-defender/defensive-powers/mighty-resilience", name: "Mighty Resilience", summary: "From 6th level: negate the extra damage of one critical hit or sneak attack while in stance.", guide: "prestige-classes#mighty-resilience", prerequisite: ClassLevel(class: "stalwart-defender", level: 6)),
                (key: "stalwart-defender/defensive-powers/renewed-defense", name: "Renewed Defense", summary: "Once a day in stance, a standard action heals 1d8 per two class levels.", guide: "prestige-classes#renewed-defense"),
                (key: "stalwart-defender/defensive-powers/roused-defense", name: "Roused Defense", summary: "Enter stance while fatigued and ignore fatigue in it, but leave it exhausted for 1 minute per round spent in it.", guide: "prestige-classes#roused-defense"),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["stalwart-defender/ac-bonus", "stalwart-defender/defensive-stance"]),
        (level: 2, selections: ["stalwart-defender/defensive-powers"]),
        (level: 3, features: ["stalwart-defender/uncanny-dodge"]),
        (level: 4, selections: ["stalwart-defender/defensive-powers"]),
        (level: 5, features: ["stalwart-defender/damage-reduction"]),
        (level: 6, selections: ["stalwart-defender/defensive-powers"]),
        (level: 7, features: ["stalwart-defender/improved-uncanny-dodge"]),
        (level: 8, selections: ["stalwart-defender/defensive-powers"]),
        (level: 9),
        (level: 10, selections: ["stalwart-defender/defensive-powers"]),
    ],
)
