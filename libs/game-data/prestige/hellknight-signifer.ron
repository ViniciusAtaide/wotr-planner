Class(
    key: "hellknight-signifer",
    name: "Hellknight Signifer",
    summary: "Ten-level lawful armoured caster with 3/4 BAB, full caster progression and 5 HP per level: heavy armour, Arcane Armor Mastery, less spell failure, True Seeing.",
    guide: "prestige-classes#hellknight-signifer",
    skill_points: 2,
    bab: ThreeQuarters,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "perception", "persuasion"],
    prerequisite: All([Any([Feat("arcane-armor-training"), Feat("warrior-priest")]), Any([SpellLevel(spell_type: Arcane, level: 3), SpellLevel(spell_type: Divine, level: 3)]), Any([Alignment(LawfulGood), Alignment(LawfulNeutral), Alignment(LawfulEvil)]), SkillRanks(skill: "knowledge-arcana", ranks: 5), SkillRanks(skill: "knowledge-world", ranks: 5), SkillRanks(skill: "persuasion", ranks: 2), CharacterLevel(6)]),
    advances: Either,
    features: [
        (key: "hellknight-signifer/arcane-armor-expertise", name: "Arcane Armor Expertise", summary: "Holders of Arcane Armor Training get Arcane Armor Mastery free.", guide: "prestige-classes#arcane-armor-expertise"),
        (key: "hellknight-signifer/assiduous-gaze", name: "Assiduous Gaze", summary: "True Seeing, lasting up to your class level in rounds each day; from 7th level you can trigger it twice a day.", guide: "prestige-classes#assiduous-gaze"),
        (key: "hellknight-signifer/diabolic-harbinger", name: "Diabolic Harbinger", summary: "Blindness, gaze attacks and sight-based effects can't touch you; +2 Persuasion.", guide: "prestige-classes#diabolic-harbinger"),
        (key: "hellknight-signifer/discern-lies", name: "Discern Lies", summary: "Saves against illusion spells get +2.", guide: "prestige-classes#discern-lies"),
        (key: "hellknight-signifer/hellknight-signifer-spellcasting", name: "Hellknight Signifer Spellcasting", summary: "Each level adds spells as a level of the casting class you had before.", guide: "prestige-classes#hellknight-signifer-spellcasting"),
        (key: "hellknight-signifer/infernal-resilience", name: "Infernal Resilience", summary: "Poison immunity plus damage reduction 5/chaotic.", guide: "prestige-classes#infernal-resilience"),
        (key: "hellknight-signifer/signifier-armor-training", name: "Signifier Armor Training", summary: "Full speed in medium or heavy armour, -1 armour check penalty and -5% arcane spell failure; the last two improve again at 8th level.", guide: "prestige-classes#signifer-armor-training"),
    ],
    selections: [
        (
            key: "hellknight-signifer/order",
            name: "Order",
            summary: "Pick a Hellknight order, one of seven.",
            guide: "prestige-classes#order-hellknight-signifer",
            only_without_option: true,
            options: [],
            shared_options: [
                "fighter/armiger/order/order-of-the-chain",
                "fighter/armiger/order/order-of-the-gate",
                "fighter/armiger/order/order-of-the-godclaw",
                "fighter/armiger/order/order-of-the-nail",
                "fighter/armiger/order/order-of-the-pyre",
                "fighter/armiger/order/order-of-the-rack",
                "fighter/armiger/order/order-of-the-scourge",
            ],
        ),
    ],
    levels: [
        (level: 1, advances_arcane: true, advances_divine: true, features: ["hellknight-signifer/hellknight-signifer-spellcasting"], feats: ["armor-proficiency-heavy-armor"], selections: ["hellknight-signifer/order"]),
        (level: 2, advances_arcane: true, advances_divine: true, features: ["hellknight-signifer/arcane-armor-expertise"]),
        (level: 3, advances_arcane: true, advances_divine: true, features: ["hellknight-signifer/signifier-armor-training"]),
        (level: 4, advances_arcane: true, advances_divine: true, features: ["hellknight-signifer/assiduous-gaze"]),
        (level: 5, advances_arcane: true, advances_divine: true),
        (level: 6, advances_arcane: true, advances_divine: true, features: ["hellknight-signifer/discern-lies"]),
        (level: 7, advances_arcane: true, advances_divine: true),
        (level: 8, advances_arcane: true, advances_divine: true, features: ["hellknight-signifer/signifier-armor-training"]),
        (level: 9, advances_arcane: true, advances_divine: true, features: ["hellknight-signifer/infernal-resilience"]),
        (level: 10, advances_arcane: true, advances_divine: true, features: ["hellknight-signifer/diabolic-harbinger"]),
    ],
)
