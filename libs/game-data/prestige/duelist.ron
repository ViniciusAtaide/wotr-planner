Class(
    key: "duelist",
    name: "Duelist",
    summary: "Ten-level finesse fighter with full BAB and 6 HP per level: Int to AC, class level to piercing damage, parry and riposte, initiative and Reflex bonuses.",
    guide: "prestige-classes#duelist",
    skill_points: 3,
    bab: Full,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["mobility", "perception", "persuasion"],
    prerequisite: All([Feat("combat-mobility"), Feat("weapon-finesse"), SkillRanks(skill: "mobility", ranks: 2), BaseAttackBonus(6), CharacterLevel(7)]),
    features: [
        (key: "duelist/acrobatic-movement", name: "Acrobatic Movement", summary: "Difficult terrain no longer slows your movement.", guide: "prestige-classes#acrobatic-movement"),
        (key: "duelist/canny-defense", name: "Canny Defense", summary: "In light or no armour, add your Intelligence bonus as dodge AC, up to 1 point per Duelist level.", guide: "prestige-classes#canny-defense"),
        (key: "duelist/crippling-critical", name: "Crippling Critical", summary: "Confirmed crits add one of: half speed, 1d4 Str or Dex damage, -4 to saves or -4 AC for 1 minute, or 2d6 bleed.", guide: "prestige-classes#crippling-critical"),
        (key: "duelist/deflect-arrows", name: "Deflect Arrows", summary: "The benefit of the Deflect Arrows feat, without needing a free hand.", guide: "prestige-classes#deflect-arrows"),
        (key: "duelist/elaborate-defense", name: "Elaborate Defense", summary: "While fighting defensively, +1 dodge AC per 3 Duelist levels.", guide: "prestige-classes#elaborate-defense"),
        (key: "duelist/enhanced-mobility", name: "Enhanced Mobility", summary: "In light or no armour, +4 AC against attacks of opportunity for moving out of a threatened square.", guide: "prestige-classes#enhanced-mobility"),
        (key: "duelist/grace", name: "Grace", summary: "+2 competence bonus on Reflex saves.", guide: "prestige-classes#grace"),
        (key: "duelist/improved-reaction", name: "Improved Reaction", summary: "+2 to initiative, +4 at 8th level.", guide: "prestige-classes#improved-reaction"),
        (key: "duelist/no-retreat", name: "No Retreat", summary: "Adjacent enemies that take a withdraw action provoke an attack of opportunity.", guide: "prestige-classes#no-retreat"),
        (key: "duelist/parry", name: "Parry", summary: "Hold back one attack of a full attack to roll against a later attack on you or an adjacent ally; beat it and it misses (-4 per size larger, -4 for allies).", guide: "prestige-classes#parry"),
        (key: "duelist/precise-strike", name: "Precise Strike", summary: "With a light or one-handed piercing weapon and a free off hand, add your Duelist level to damage, except against crit-immune foes.", guide: "prestige-classes#precise-strike"),
        (key: "duelist/riposte", name: "Riposte", summary: "After a successful parry, make an attack of opportunity against the attacker if it's within reach.", guide: "prestige-classes#riposte"),
    ],
    levels: [
        (level: 1, features: ["duelist/canny-defense", "duelist/precise-strike"]),
        (level: 2, features: ["duelist/improved-reaction", "duelist/parry"]),
        (level: 3, features: ["duelist/enhanced-mobility"]),
        (level: 4, features: ["duelist/grace"], feats: ["combat-reflexes"]),
        (level: 5, features: ["duelist/riposte"]),
        (level: 6, features: ["duelist/acrobatic-movement"]),
        (level: 7, features: ["duelist/elaborate-defense"]),
        (level: 8),
        (level: 9, features: ["duelist/deflect-arrows", "duelist/no-retreat"]),
        (level: 10, features: ["duelist/crippling-critical"]),
    ],
)
