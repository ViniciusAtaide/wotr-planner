Class(
    key: "duelist",
    blueprint: "4e0ea99612ae87a499c7fb0588e31828",
    name: "Duelist",
    summary: "Ten-level finesse fighter with full BAB and 6 HP per level: Int to AC, class level to piercing damage, parry and riposte, initiative and Reflex bonuses.",
    guide: "prestige-classes#duelist",
    skill_points: 3,
    bab: Full,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["mobility", "perception", "persuasion"],
    prerequisite: All([Feat("combat-mobility"), Feat("weapon-finesse"), SkillRanks(skill: "mobility", ranks: 2), BaseAttackBonus(6), CharacterLevel(7)]),
    features: [
        (key: "duelist/acrobatic-movement", blueprint: "483667247e2441740ad0cff6a67b50e3", name: "Acrobatic Movement", summary: "Difficult terrain no longer slows your movement.", guide: "prestige-classes#acrobatic-movement"),
        (key: "duelist/canny-defense", blueprint: "9a0a447e161207d46829ce2bd8b3cc6f", name: "Canny Defense", summary: "Intelligence bonus as dodge AC, capped at your Duelist level, while in light armour or none.", guide: "prestige-classes#canny-defense"),
        (key: "duelist/crippling-critical", blueprint: "214562b6bb8e34a4b82628ed7c2468c7", name: "Crippling Critical", summary: "Confirmed crits add one of: half speed, 1d4 Str or Dex damage, -4 to saves or -4 AC for 1 minute, or 2d6 bleed.", guide: "prestige-classes#crippling-critical"),
        (key: "duelist/deflect-arrows", blueprint: "c44158612f496fc4b863a0a7691401e3", name: "Deflect Arrows", summary: "Deflect Arrows, without the feat's free-hand requirement.", guide: "prestige-classes#deflect-arrows"),
        (key: "duelist/elaborate-defense", blueprint: "648a0c95ede2e7147a9b319eac86844e", name: "Elaborate Defense", summary: "Fighting defensively adds 1 dodge AC per 3 Duelist levels on top of the usual bonus.", guide: "prestige-classes#elaborate-defense"),
        (key: "duelist/enhanced-mobility", blueprint: "3202d0c7f84303c43935df57a1f804af", name: "Enhanced Mobility", summary: "Leaving a threatened square in light or no armour: +4 AC against the attacks of opportunity it draws.", guide: "prestige-classes#enhanced-mobility"),
        (key: "duelist/grace", blueprint: "03d207de4011f4f4fb871d2dcce8fd56", name: "Grace", summary: "Reflex saves get a +2 competence bonus.", guide: "prestige-classes#grace"),
        (key: "duelist/improved-reaction", blueprint: "d1b7dd3736ca41446aaff9f253768d1d", name: "Improved Reaction", summary: "+2 to initiative, +4 at 8th level.", guide: "prestige-classes#improved-reaction"),
        (key: "duelist/no-retreat", blueprint: "049212ca3b36eeb4c94debb4ef40eaba", name: "No Retreat", summary: "Enemies next to you provoke an attack of opportunity when they use the withdraw action.", guide: "prestige-classes#no-retreat"),
        (key: "duelist/parry", blueprint: "47e9ac1bf9c376e44b64cb5844a5e6a6", name: "Parry", summary: "Hold back one attack of a full attack to roll against a later attack on you or an adjacent ally; beat it and it misses (-4 per size larger, -4 for allies).", guide: "prestige-classes#parry"),
        (key: "duelist/precise-strike", blueprint: "4247758d93b218a43aed6aecc1f50fbb", name: "Precise Strike", summary: "Wielding a light or one-handed piercing weapon, off hand empty, adds your Duelist level to damage; crit-immune foes take no extra.", guide: "prestige-classes#precise-strike"),
        (key: "duelist/riposte", blueprint: "9680cce5b61e36e4499971ca3f794607", name: "Riposte", summary: "A parried attacker within your reach takes an attack of opportunity from you.", guide: "prestige-classes#riposte"),
    ],
    levels: [
        (level: 1, features: ["duelist/canny-defense", "duelist/precise-strike"]),
        (level: 2, features: ["duelist/improved-reaction", "duelist/parry"]),
        (level: 3, features: ["duelist/enhanced-mobility"]),
        (level: 4, features: ["duelist/grace"], feats: ["combat-reflexes"]),
        (level: 5, features: ["duelist/riposte"]),
        (level: 6, features: ["duelist/acrobatic-movement"]),
        (level: 7, features: ["duelist/elaborate-defense"]),
        (level: 8),
        (level: 9, features: ["duelist/deflect-arrows", "duelist/no-retreat"]),
        (level: 10, features: ["duelist/crippling-critical"]),
    ],
)
