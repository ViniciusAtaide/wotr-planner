Class(
    key: "eldritch-knight",
    name: "Eldritch Knight",
    summary: "Ten-level gish with full BAB and 6 HP per level, advancing casting at 9 of 10 levels: counts as fighter for feats, three bonus combat feats, Spell Critical.",
    guide: "prestige-classes#eldritch-knight",
    skill_points: 2,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["athletics", "knowledge-arcana", "knowledge-world", "perception"],
    prerequisite: All([Feat("martial-weapons-proficiency"), SpellLevel(spell_type: Arcane, level: 3), CharacterLevel(6)]),
    counts_as: [(class: "fighter", toward: FeatPrerequisites)],
    features: [
        (key: "eldritch-knight/arcane-spellcasting", name: "Arcane Spellcasting", summary: "From 2nd level, each level adds spells per day as a level of an earlier arcane class.", guide: "prestige-classes#arcane-spellcasting-eldritch-knight"),
        (key: "eldritch-knight/diverse-training", name: "Diverse Training", summary: "Class levels count as fighter levels for feat prerequisites, and as levels of your casting class for that class's feats.", guide: "prestige-classes#diverse-training"),
        (key: "eldritch-knight/spell-critical", name: "Spell Critical", summary: "After a weapon critical hit, your next spell within two rounds is cast as a swift action and doesn't provoke.", guide: "prestige-classes#spell-critical"),
    ],
    levels: [
        (level: 1, features: ["eldritch-knight/diverse-training"], feat_slots: [CombatFeat]),
        (level: 2, advances_arcane: true, features: ["eldritch-knight/arcane-spellcasting"]),
        (level: 3, advances_arcane: true),
        (level: 4, advances_arcane: true),
        (level: 5, advances_arcane: true, feat_slots: [CombatFeat]),
        (level: 6, advances_arcane: true),
        (level: 7, advances_arcane: true),
        (level: 8, advances_arcane: true),
        (level: 9, advances_arcane: true, feat_slots: [CombatFeat]),
        (level: 10, advances_arcane: true, features: ["eldritch-knight/spell-critical"]),
    ],
)
