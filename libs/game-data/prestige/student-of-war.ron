Class(
    key: "student-of-war",
    name: "Student of War",
    summary: "Ten-level tactician with full BAB, 6 HP and 4 skill points per level: Know Your Enemy stances, Int to AC, three bonus combat feats, DR-piercing attacks.",
    guide: "prestige-classes#student-of-war",
    skill_points: 4,
    bab: Full,
    fort: Poor,
    reflex: Poor,
    will: Good,
    save_exceptions: [(level: 4, save: Will, value: 3)],
    class_skills: ["knowledge-arcana", "knowledge-world", "perception"],
    prerequisite: All([Any([FeatFor(feat: "skill-focus", value: Skill("knowledge-arcana")), FeatFor(feat: "skill-focus", value: Skill("knowledge-world")), FeatFor(feat: "skill-focus", value: Skill("lore-nature")), FeatFor(feat: "skill-focus", value: Skill("lore-religion"))]), Feat("combat-expertise"), Feat("dodge"), BaseAttackBonus(5), CharacterLevel(6)]),
    features: [
        (key: "student-of-war/additional-class-skill", name: "Additional Class Skill", summary: "Every odd class level makes one more skill of your choice a class skill.", guide: "prestige-classes#additional-class-skill"),
        (key: "student-of-war/anticipate", name: "Anticipate", summary: "When a passed Will save would halve an attack's damage, you take none instead.", guide: "prestige-classes#anticipate"),
        (key: "student-of-war/deadly-blow", name: "Deadly Blow", summary: "Once Know Your Enemy is active, DR and crit immunity no longer protect foes from your attacks.", guide: "prestige-classes#deadly-blow"),
        (key: "student-of-war/know-your-enemy-swift", name: "Know Your Enemy - Swift", summary: "Know Your Enemy becomes a swift action.", guide: "prestige-classes#know-your-enemy"),
        (key: "student-of-war/mind-over-metal", name: "Mind Over Metal", summary: "AC uses your Intelligence modifier rather than Dexterity, though armour's max Dex cap still holds.", guide: "prestige-classes#mind-over-metal"),
        (key: "student-of-war/nemesis", name: "Nemesis", summary: "A daily 1-minute Bane enchantment on your weapon.", guide: "prestige-classes#nemesis"),
        (key: "student-of-war/telling-blow", name: "Telling Blow", summary: "Strips 5 points from typed damage reduction on your hits; untyped DR and crit-immune creatures are unaffected.", guide: "prestige-classes#telling-blow"),
    ],
    selections: [
        (
            key: "student-of-war/know-your-enemy",
            name: "Know Your Enemy",
            summary: "Move action: a Knowledge or Lore check on a foe gives a stance's insight bonus against it, +1, +2 at 4th and +3 at 7th; switch as a move action.",
            guide: "prestige-classes#know-your-enemy",
            options: [
                (key: "student-of-war/know-your-enemy/defensive-stance-student-of-war", name: "Defensive Stance (Student of War)", summary: "+1 insight bonus to AC and saves versus the studied foe; from 6th level also +3 AC against attacks of opportunity.", guide: "prestige-classes#defensive-stance-student-of-war"),
                (key: "student-of-war/know-your-enemy/martial-stance", name: "Martial Stance", summary: "+1 insight bonus to attack and damage against the studied foe, and +3 to confirm critical hits from 6th level.", guide: "prestige-classes#martial-stance"),
                (key: "student-of-war/know-your-enemy/tactical-stance", name: "Tactical Stance", summary: "Insight bonus (+1, rising with level) to your CMB and CMD in manoeuvres involving the studied foe.", guide: "prestige-classes#tactical-stance"),
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["student-of-war/additional-class-skill"], selections: ["student-of-war/know-your-enemy"]),
        (level: 2, features: ["student-of-war/mind-over-metal"], feat_slots: [CombatFeat]),
        (level: 3, features: ["student-of-war/additional-class-skill", "student-of-war/anticipate"]),
        (level: 4),
        (level: 5, features: ["student-of-war/additional-class-skill"], feat_slots: [CombatFeat]),
        (level: 6, features: ["student-of-war/telling-blow"]),
        (level: 7, features: ["student-of-war/additional-class-skill", "student-of-war/know-your-enemy-swift"]),
        (level: 8, feat_slots: [CombatFeat]),
        (level: 9, features: ["student-of-war/additional-class-skill", "student-of-war/nemesis"]),
        (level: 10, features: ["student-of-war/deadly-blow"]),
    ],
)
