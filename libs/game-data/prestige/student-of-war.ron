Class(
    key: "student-of-war",
    blueprint: "46b1fe9759ea01f4d883b23d8f0aecbb",
    name: "Student of War",
    summary: "Ten-level tactician with full BAB, 6 HP and 4 skill points per level: Know Your Enemy stances, Int to AC, three bonus combat feats, DR-piercing attacks.",
    guide: "prestige-classes#student-of-war",
    skill_points: 4,
    bab: Full,
    fort: Poor,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "perception"],
    components: [
        Requires(condition: ParametrizedFeature("skill-focus", Skill("knowledge-arcana")), group: Any),
        Requires(condition: ParametrizedFeature("skill-focus", Skill("knowledge-world")), group: Any),
        Requires(condition: ParametrizedFeature("skill-focus", Skill("lore-nature")), group: Any),
        Requires(condition: ParametrizedFeature("skill-focus", Skill("lore-religion")), group: Any),
        Requires(condition: Has(Feat("combat-expertise"))),
        Requires(condition: Has(Feat("dodge"))),
        Requires(condition: Stat(stat: BaseAttack, value: 5)),
        Requires(condition: CharacterLevel(6)),
    ],
    levels: [
        (level: 1, features: ["student-of-war/additional-class-skill"], selections: ["student-of-war/know-your-enemy"]),
        (level: 2, features: ["student-of-war/mind-over-metal"], selections: ["combat-feats"]),
        (level: 3, features: ["student-of-war/additional-class-skill", "student-of-war/anticipate"]),
        (level: 4),
        (level: 5, features: ["student-of-war/additional-class-skill"], selections: ["combat-feats"]),
        (level: 6, features: ["student-of-war/telling-blow"]),
        (level: 7, features: ["student-of-war/additional-class-skill", "student-of-war/know-your-enemy-swift"]),
        (level: 8, selections: ["combat-feats"]),
        (level: 9, features: ["student-of-war/additional-class-skill", "student-of-war/nemesis"]),
        (level: 10, features: ["student-of-war/deadly-blow"]),
    ],
)
