Class(
    key: "dragon-disciple",
    name: "Dragon Disciple",
    summary: "Ten-level draconic caster with 3/4 BAB, 3/4 caster progression and 7 HP per level: bloodline levels, +4 Str, +2 Con, +2 Int, natural armour, breath and wings.",
    guide: "prestige-classes#dragon-disciple",
    skill_points: 2,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Poor,
    will: Good,
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "mobility", "perception", "persuasion"],
    prerequisite: All([Any([All([NoOptionFrom("bloodrager/bloodline"), NoOptionFrom("sorcerer/bloodline")]), SelectionOption("sorcerer/bloodline/draconic-black"), SelectionOption("sorcerer/bloodline/draconic-blue"), SelectionOption("sorcerer/bloodline/draconic-brass"), SelectionOption("sorcerer/bloodline/draconic-bronze"), SelectionOption("sorcerer/bloodline/draconic-copper"), SelectionOption("sorcerer/bloodline/draconic-gold"), SelectionOption("sorcerer/bloodline/draconic-green"), SelectionOption("sorcerer/bloodline/draconic-red"), SelectionOption("sorcerer/bloodline/draconic-silver"), SelectionOption("sorcerer/bloodline/draconic-white")]), SkillRanks(skill: "knowledge-arcana", ranks: 5), SpontaneousSpellLevel(spell_type: Arcane, level: 1), CharacterLevel(6)]),
    features: [
        (key: "dragon-disciple/arcane-spellcasting", name: "Arcane Spellcasting", summary: "Adds spells per day as a level of an earlier arcane class at each level from 2nd, except 5th and 9th.", guide: "prestige-classes#arcane-spellcasting-dragon-disciple"),
        (key: "dragon-disciple/blindsense", name: "Blindsense", summary: "Blindsense to 25 feet, 50 feet at 10th level.", guide: "prestige-classes#blindsense"),
        (key: "dragon-disciple/blood-of-dragons", name: "Blood of Dragons", summary: "A sorcerer's Draconic bloodline keeps advancing; anyone else picks a Draconic bloodline whose level is their Dragon Disciple level.", guide: "prestige-classes#blood-of-dragons"),
        (key: "dragon-disciple/breath-weapon", name: "Breath Weapon", summary: "Your bloodline's breath weapon at 3rd level whatever your bloodline level, or one more use a day if you already have it.", guide: "prestige-classes#breath-weapon"),
        (key: "dragon-disciple/constitution-2", name: "Constitution +2", summary: "+2 Constitution.", guide: "prestige-classes#dragon-disciple", ability_bonuses: [Fixed(ability: Constitution, amount: 2)]),
        (key: "dragon-disciple/dragon-bite", name: "Dragon Bite", summary: "Your bloodline claws come with a 1d6 bite attack, which deals +1d6 energy damage from 6th level.", guide: "prestige-classes#dragon-bite"),
        (key: "dragon-disciple/dragon-form", name: "Dragon Form", summary: "Turn into a dragon once a day as Dragonkind I, or twice a day as Dragonkind II from 10th level.", guide: "prestige-classes#dragon-form"),
        (key: "dragon-disciple/intelligence-2", name: "Intelligence +2", summary: "+2 Intelligence.", guide: "prestige-classes#dragon-disciple", ability_bonuses: [Fixed(ability: Intelligence, amount: 2)]),
        (key: "dragon-disciple/natural-ac-1", name: "Natural AC +1", summary: "+1 natural armour to AC.", guide: "prestige-classes#dragon-disciple"),
        (key: "dragon-disciple/strength-2", name: "Strength +2", summary: "+2 Strength.", guide: "prestige-classes#dragon-disciple", ability_bonuses: [Fixed(ability: Strength, amount: 2)]),
        (key: "dragon-disciple/wings", name: "Wings", summary: "The Wings feat at 9th level, even if your bloodline level isn't high enough for it.", guide: "prestige-classes#wings"),
    ],
    selections: [
        (
            key: "dragon-disciple/bloodline",
            name: "Blood of Dragons",
            summary: "For a character without a bloodline: pick one of the ten Draconic bloodlines, levelled by Dragon Disciple levels.",
            guide: "prestige-classes#blood-of-dragons",
            option_levels: ["dragon-disciple"],
            only_without_option: true,
            options: [],
            shared_options: [
                "sorcerer/bloodline/draconic-black",
                "sorcerer/bloodline/draconic-blue",
                "sorcerer/bloodline/draconic-brass",
                "sorcerer/bloodline/draconic-bronze",
                "sorcerer/bloodline/draconic-copper",
                "sorcerer/bloodline/draconic-gold",
                "sorcerer/bloodline/draconic-green",
                "sorcerer/bloodline/draconic-red",
                "sorcerer/bloodline/draconic-silver",
                "sorcerer/bloodline/draconic-white",
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["dragon-disciple/blood-of-dragons", "dragon-disciple/natural-ac-1"], selections: ["dragon-disciple/bloodline"]),
        (level: 2, advances_arcane: true, features: ["dragon-disciple/arcane-spellcasting", "dragon-disciple/dragon-bite", "dragon-disciple/strength-2"], feat_slots: [OptionList(selection: "sorcerer/bloodline")]),
        (level: 3, advances_arcane: true, features: ["dragon-disciple/breath-weapon"]),
        (level: 4, advances_arcane: true, features: ["dragon-disciple/natural-ac-1", "dragon-disciple/strength-2"]),
        (level: 5, features: ["dragon-disciple/blindsense"], feat_slots: [OptionList(selection: "sorcerer/bloodline")]),
        (level: 6, advances_arcane: true, features: ["dragon-disciple/constitution-2"]),
        (level: 7, advances_arcane: true, features: ["dragon-disciple/dragon-form", "dragon-disciple/natural-ac-1"]),
        (level: 8, advances_arcane: true, features: ["dragon-disciple/intelligence-2"], feat_slots: [OptionList(selection: "sorcerer/bloodline")]),
        (level: 9, features: ["dragon-disciple/wings"]),
        (level: 10, advances_arcane: true),
    ],
)
