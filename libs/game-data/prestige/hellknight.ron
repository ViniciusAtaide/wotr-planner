Class(
    key: "hellknight",
    name: "Hellknight",
    summary: "Ten-level lawful heavy-armour warrior with full BAB and 6 HP per level: Smite Chaos, armour training, save bonuses, three Disciplines and fire immunity.",
    guide: "prestige-classes#hellknight",
    skill_points: 2,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["knowledge-world", "perception", "persuasion"],
    prerequisite: All([Any([Alignment(LawfulGood), Alignment(LawfulNeutral), Alignment(LawfulEvil)]), Feat("armor-proficiency-heavy-armor"), SkillRanks(skill: "knowledge-arcana", ranks: 2), SkillRanks(skill: "persuasion", ranks: 5), BaseAttackBonus(5), CharacterLevel(6)]),
    features: [
        (key: "hellknight/armor-training", name: "Armor Training", summary: "Armor Training at 2nd level and every three levels after.", guide: "prestige-classes#armor-training"),
        (key: "hellknight/force-of-will", name: "Force of Will", summary: "+2 to saves against charm, compulsion or fear; each time it's gained it adds a type and raises the old ones, to +6/+4/+2 at 9th level.", guide: "prestige-classes#force-of-will"),
        (key: "hellknight/hells-knight", name: "Hell\'s Knight", summary: "Immune to fire while armoured, and your weapon gains Axiomatic, Flaming Burst or Unholy.", guide: "prestige-classes#hells-knight"),
        (key: "hellknight/infernal-armor", name: "Infernal Armor", summary: "While armoured: +2 to Persuasion, fire resistance 30, and cold and acid resistance 10.", guide: "prestige-classes#infernal-armor"),
        (key: "hellknight/lawbringer", name: "Lawbringer", summary: "Your attacks count as lawful for overcoming damage reduction.", guide: "prestige-classes#lawbringer"),
        (key: "hellknight/smite-chaos", name: "Smite Chaos", summary: "Swift action vs a chaotic foe: +Cha to attack, +2 per level to damage, its DR ignored and +Cha deflection AC against it; 1/day, up to 4/day.", guide: "prestige-classes#smite-chaos"),
    ],
    selections: [
        (
            key: "hellknight/disciplines",
            name: "Disciplines",
            summary: "A Discipline at 3rd, 6th and 9th level, each usable 1, 2 then 3 times a day; their save DCs are 10 + class level + Cha.",
            guide: "prestige-classes#disciplines",
            option_levels: ["hellknight"],
            options: [
                (key: "hellknight/disciplines/censor", name: "Censor", summary: "Smite Chaos can also leave the target mute for 1d4 rounds (Will negates).", guide: "prestige-classes#censor"),
                (key: "hellknight/disciplines/command", name: "Command", summary: "Greater Command as a spell-like ability, at your character level.", guide: "prestige-classes#command"),
                (key: "hellknight/disciplines/fearsomeness", name: "Fearsomeness", summary: "A Persuasion check that would shake a creature within 10 feet frightens it instead.", guide: "prestige-classes#fearsomeness"),
                (key: "hellknight/disciplines/onslaught", name: "Onslaught", summary: "Free action: +10 feet speed and +4 Strength for 1 round, for you and your mount.", guide: "prestige-classes#onslaught"),
                (
                    key: "hellknight/disciplines/pentamic-faith",
                    name: "Pentamic Faith",
                    summary: "Order of the Godclaw only: gain one of eleven domains, with your Hellknight level as its level.",
                    guide: "prestige-classes#pentamic-faith",
                    prerequisite: SelectionOption("fighter/armiger/order/order-of-the-godclaw"),
                    levels: [
                        (level: 1, selections: ["hellknight/pentamic-faith"]),
                    ],
                ),
                (key: "hellknight/disciplines/shackle", name: "Shackle", summary: "Smite Chaos can also slow the target for 1d4 rounds (Will negates).", guide: "prestige-classes#shackle"),
                (key: "hellknight/disciplines/tracker", name: "Tracker", summary: "Summon a wolf for 1 hour, or a hell hound from 9th level.", guide: "prestige-classes#tracker"),
                (key: "hellknight/disciplines/wrack", name: "Wrack", summary: "Standard-action touch attack for 1d6 + Cha damage that staggers for 1d4 rounds on a failed Will save.", guide: "prestige-classes#wrack"),
            ],
        ),
        (
            key: "hellknight/order",
            name: "Order",
            summary: "A character who wasn't an Armiger chooses one of the seven Hellknight orders; an Armiger keeps hers.",
            guide: "prestige-classes#order",
            only_without_option: true,
            options: [],
            shared_options: [
                "fighter/armiger/order/order-of-the-chain",
                "fighter/armiger/order/order-of-the-gate",
                "fighter/armiger/order/order-of-the-godclaw",
                "fighter/armiger/order/order-of-the-nail",
                "fighter/armiger/order/order-of-the-pyre",
                "fighter/armiger/order/order-of-the-rack",
                "fighter/armiger/order/order-of-the-scourge",
            ],
        ),
        (
            key: "hellknight/pentamic-faith",
            name: "Pentamic Faith",
            summary: "The domain: Artifice, Glory, Knowledge, Law, Magic, Nobility, Protection, Rune, Strength, Travel or War.",
            guide: "prestige-classes#pentamic-faith",
            option_levels: ["hellknight"],
            options: [],
            shared_options: [
                "cleric/domain/artifice",
                "cleric/domain/glory",
                "cleric/domain/knowledge",
                "cleric/domain/law",
                "cleric/domain/magic",
                "cleric/domain/nobility",
                "cleric/domain/protection",
                "cleric/domain/rune",
                "cleric/domain/strength",
                "cleric/domain/travel",
                "cleric/domain/war",
            ],
        ),
    ],
    levels: [
        (level: 1, features: ["hellknight/smite-chaos"], selections: ["hellknight/order"]),
        (level: 2, features: ["hellknight/armor-training"]),
        (level: 3, features: ["hellknight/force-of-will"], selections: ["hellknight/disciplines"]),
        (level: 4),
        (level: 5, features: ["hellknight/armor-training"]),
        (level: 6, features: ["hellknight/force-of-will"], selections: ["hellknight/disciplines"]),
        (level: 7, features: ["hellknight/lawbringer"]),
        (level: 8, features: ["hellknight/armor-training"]),
        (level: 9, features: ["hellknight/force-of-will", "hellknight/infernal-armor"], selections: ["hellknight/disciplines"]),
        (level: 10, features: ["hellknight/hells-knight"]),
    ],
)
