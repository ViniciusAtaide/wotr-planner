Class(
    key: "aldori-swordlord",
    name: "Aldori Swordlord",
    summary: "Ten-level Dueling Sword specialist with full BAB and 6 HP per level: Dexterity to damage, demoralising on crits, parry AC and a chance to negate crits.",
    guide: "prestige-classes#aldori-swordlord",
    skill_points: 2,
    bab: Full,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["knowledge-world", "mobility", "perception", "persuasion"],
    prerequisite: All([Feat("dazzling-display"), Feat("weapon-finesse"), FeatFor(feat: "weapon-focus", value: Weapon("dueling-sword")), SkillRanks(skill: "knowledge-world", ranks: 3), SkillRanks(skill: "mobility", ranks: 3), SkillRanks(skill: "perception", ranks: 3), SkillRanks(skill: "persuasion", ranks: 5), CharacterLevel(6)]),
    features: [
        (key: "aldori-swordlord/adaptive-tactics", name: "Adaptive Tactics", summary: "The attack penalty for fighting defensively or Combat Expertise drops by 1 (2 at 8th); beat 10 + an attacker's BAB on Perception for +2 AC against it all fight.", guide: "prestige-classes#adaptive-tactics"),
        (key: "aldori-swordlord/confounding-duelist", name: "Confounding Duelist", summary: "Shatter Confidence's victims also lose insight and competence bonuses, not just morale ones, and take a penalty to attacks and saves.", guide: "prestige-classes#confounding-duelist"),
        (key: "aldori-swordlord/defensive-parry", name: "Defensive Parry", summary: "Full-attacking with a Dueling Sword gives +1 AC versus melee, +2 from 7th level; Aldori Defender levels add to the level count.", guide: "prestige-classes#defensive-parry"),
        (key: "aldori-swordlord/deft-strike", name: "Deft Strike", summary: "Dueling Sword hits add your Dexterity modifier to damage, provided your off hand is empty.", guide: "prestige-classes#deft-strike"),
        (key: "aldori-swordlord/dexterous-duelist", name: "Dexterous Duelist", summary: "Getting up from prone is safe: it provokes no attacks of opportunity.", guide: "prestige-classes#dexterous-duelist"),
        (key: "aldori-swordlord/display-weapon-prowess", name: "Display Weapon Prowess", summary: "Half class level to Persuasion (Intimidate); Dueling Sword Dazzling Display gets +1, and +1 per Greater Weapon Focus, Improved Critical and Specializations.", guide: "prestige-classes#display-weapon-prowess"),
        (key: "aldori-swordlord/greater-saving-slash", name: "Greater Saving Slash", summary: "Crits against you are downgraded to normal hits: 50% chance for melee crits, 25% for ranged ones.", guide: "prestige-classes#greater-saving-slash"),
        (key: "aldori-swordlord/saving-slash", name: "Saving Slash", summary: "Melee crits against you are downgraded to normal hits 25% of the time.", guide: "prestige-classes#saving-slash"),
        (key: "aldori-swordlord/shatter-confidence", name: "Shatter Confidence", summary: "Free-action Persuasion demoralise after a crit, disarm or armour sunder; repeat it on shaken foes each round for -1 attacks and saves and no morale bonuses.", guide: "prestige-classes#shatter-confidence"),
    ],
    levels: [
        (level: 1, features: ["aldori-swordlord/deft-strike"]),
        (level: 2, features: ["aldori-swordlord/display-weapon-prowess"]),
        (level: 3, features: ["aldori-swordlord/defensive-parry"]),
        (level: 4, features: ["aldori-swordlord/adaptive-tactics"]),
        (level: 5, features: ["aldori-swordlord/shatter-confidence"]),
        (level: 6, features: ["aldori-swordlord/saving-slash"]),
        (level: 7, features: ["aldori-swordlord/dexterous-duelist"]),
        (level: 8),
        (level: 9, features: ["aldori-swordlord/greater-saving-slash"]),
        (level: 10, features: ["aldori-swordlord/confounding-duelist"]),
    ],
)
