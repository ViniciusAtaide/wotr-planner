Class(
    key: "aldori-swordlord",
    name: "Aldori Swordlord",
    summary: "Ten-level Dueling Sword specialist with full BAB and 6 HP per level: Dexterity to damage, demoralising on crits, parry AC and a chance to negate crits.",
    guide: "prestige-classes#aldori-swordlord",
    skill_points: 2,
    bab: Full,
    fort: Poor,
    reflex: Good,
    will: Poor,
    class_skills: ["knowledge-world", "mobility", "perception", "persuasion"],
    prerequisite: All([Feat("dazzling-display"), Feat("weapon-finesse"), FeatFor(feat: "weapon-focus", value: Weapon("dueling-sword")), SkillRanks(skill: "knowledge-world", ranks: 3), SkillRanks(skill: "mobility", ranks: 3), SkillRanks(skill: "perception", ranks: 3), SkillRanks(skill: "persuasion", ranks: 5), CharacterLevel(6)]),
    features: [
        (key: "aldori-swordlord/adaptive-tactics", name: "Adaptive Tactics", summary: "Fighting defensively costs 1 less attack (2 less from 8th); a Perception check vs 10 + an attacker's BAB gives +2 AC against it for the fight.", guide: "prestige-classes#adaptive-tactics"),
        (key: "aldori-swordlord/confounding-duelist", name: "Confounding Duelist", summary: "Foes demoralised by Shatter Confidence take a penalty to attacks and saves and lose their morale, insight and competence bonuses.", guide: "prestige-classes#confounding-duelist"),
        (key: "aldori-swordlord/defensive-parry", name: "Defensive Parry", summary: "+1 AC against melee attacks while making a full attack with a Dueling Sword, +2 from 7th level (Aldori Defender levels count).", guide: "prestige-classes#defensive-parry"),
        (key: "aldori-swordlord/deft-strike", name: "Deft Strike", summary: "Adds your Dexterity modifier to damage with a Dueling Sword while your off hand is free.", guide: "prestige-classes#deft-strike"),
        (key: "aldori-swordlord/dexterous-duelist", name: "Dexterous Duelist", summary: "Standing up from prone no longer provokes attacks of opportunity.", guide: "prestige-classes#dexterous-duelist"),
        (key: "aldori-swordlord/display-weapon-prowess", name: "Display Weapon Prowess", summary: "+half class level to Persuasion (Intimidate); Dazzling Display with a Dueling Sword gets +1, plus 1 per related weapon feat you hold (up to four).", guide: "prestige-classes#display-weapon-prowess"),
        (key: "aldori-swordlord/greater-saving-slash", name: "Greater Saving Slash", summary: "50% chance to turn a melee critical hit against you into a normal hit, and 25% for a ranged one.", guide: "prestige-classes#greater-saving-slash"),
        (key: "aldori-swordlord/saving-slash", name: "Saving Slash", summary: "25% chance to turn a melee critical hit against you into a normal hit.", guide: "prestige-classes#saving-slash"),
        (key: "aldori-swordlord/shatter-confidence", name: "Shatter Confidence", summary: "Free-action Persuasion demoralise after a crit, disarm or armour sunder; shaken foes can be pushed each round for a further -1 to attacks and saves.", guide: "prestige-classes#shatter-confidence"),
    ],
    levels: [
        (level: 1, features: ["aldori-swordlord/deft-strike"]),
        (level: 2, features: ["aldori-swordlord/display-weapon-prowess"]),
        (level: 3, features: ["aldori-swordlord/defensive-parry"]),
        (level: 4, features: ["aldori-swordlord/adaptive-tactics"]),
        (level: 5, features: ["aldori-swordlord/shatter-confidence"]),
        (level: 6, features: ["aldori-swordlord/saving-slash"]),
        (level: 7, features: ["aldori-swordlord/dexterous-duelist"]),
        (level: 8),
        (level: 9, features: ["aldori-swordlord/greater-saving-slash"]),
        (level: 10, features: ["aldori-swordlord/confounding-duelist"]),
    ],
)
