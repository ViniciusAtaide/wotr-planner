Class(
    key: "winter-witch",
    name: "Winter Witch",
    summary: "Ten-level frost caster with half BAB, full caster progression and 4 HP per level: higher cold DCs and caster level, hex progression, cold that ignores immunity.",
    guide: "prestige-classes#winter-witch",
    skill_points: 2,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    save_exceptions: [(level: 4, save: Will, value: 3)],
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "persuasion", "use-magic-device"],
    prerequisite: All([Any([Archetype("druid/winter-child"), SelectionOption("shaman/spirit/frost"), SelectionOption("witch/patron/winter")]), Any([SpellLevel(spell_type: Arcane, level: 3), SpellLevel(spell_type: Divine, level: 3)]), SkillRanks(skill: "knowledge-arcana", ranks: 5), CharacterLevel(6)]),
    advances: Either,
    counts_as: [(class: "witch", toward: Feature("witch/grand-hexes")), (class: "witch", toward: Feature("witch/major-hexes"))],
    features: [
        (key: "winter-witch/cold-specialization", name: "Cold Specialization", summary: "Cold spells get +1 DC and fire spells -1 DC, rising to +3/-3 by 10th level.", guide: "prestige-classes#cold-specialization"),
        (key: "winter-witch/freezing-cold", name: "Freezing Cold", summary: "+1 caster level for cold spells, +2 at 6th level.", guide: "prestige-classes#freezing-cold"),
        (key: "winter-witch/frost-power", name: "Frost Power", summary: "Levels stack with shaman or witch levels for hexes, Frost Spirit abilities, major and grand hexes and patron spells.", guide: "prestige-classes#frost-power"),
        (key: "winter-witch/unearthly-cold", name: "Unearthly Cold", summary: "Half the cold damage of your spells ignores resistance and immunity.", guide: "prestige-classes#unearthly-cold"),
        (key: "winter-witch/winter-witch-spellbook", name: "Winter Witch Spellbook", summary: "Each level adds spells as a level of your previous casting class.", guide: "prestige-classes#winter-witch-spellbook"),
    ],
    levels: [
        (level: 1, advances_arcane: true, advances_divine: true, features: ["winter-witch/cold-specialization", "winter-witch/frost-power", "winter-witch/winter-witch-spellbook"]),
        (level: 2, advances_arcane: true, advances_divine: true),
        (level: 3, advances_arcane: true, advances_divine: true, features: ["winter-witch/freezing-cold"]),
        (level: 4, advances_arcane: true, advances_divine: true),
        (level: 5, advances_arcane: true, advances_divine: true),
        (level: 6, advances_arcane: true, advances_divine: true, features: ["winter-witch/freezing-cold"]),
        (level: 7, advances_arcane: true, advances_divine: true),
        (level: 8, advances_arcane: true, advances_divine: true, features: ["winter-witch/unearthly-cold"]),
        (level: 9, advances_arcane: true, advances_divine: true),
        (level: 10, advances_arcane: true, advances_divine: true),
    ],
)
