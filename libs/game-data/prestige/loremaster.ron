Class(
    key: "loremaster",
    name: "Loremaster",
    summary: "Ten-level scholar caster with half BAB, full caster progression and 4 HP per level: five Secrets (spells, feats, talents, saves) and Knowledge bonuses.",
    guide: "prestige-classes#loremaster",
    skill_points: 3,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    save_exceptions: [(level: 4, save: Will, value: 3)],
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "persuasion", "use-magic-device"],
    prerequisite: All([Any([FeatFor(feat: "skill-focus", value: Skill("knowledge-arcana")), FeatFor(feat: "skill-focus", value: Skill("knowledge-world"))]), Any([SpellLevel(spell_type: Arcane, level: 3), SpellLevel(spell_type: Divine, level: 3)]), Any([Feat("metamagic-bolster-spell"), Feat("metamagic-completely-normal-spell"), Feat("metamagic-empower-spell"), Feat("metamagic-extend-spell"), Feat("metamagic-heighten-spell"), Feat("metamagic-intensified-spell"), Feat("metamagic-maximise-spell"), Feat("metamagic-persistent-spell"), Feat("metamagic-piercing-spell"), Feat("metamagic-quicken-spell"), Feat("metamagic-reach-spell"), Feat("metamagic-selective-spell")]), CharacterLevel(6)]),
    advances: Either,
    features: [
        (key: "loremaster/greater-lore", name: "Greater Lore", summary: "+10 to Knowledge (Arcana) checks to identify magic items.", guide: "prestige-classes#greater-lore"),
        (key: "loremaster/lore", name: "Lore", summary: "+half class level to all Knowledge and Lore checks.", guide: "prestige-classes#lore"),
        (key: "loremaster/spellbook-selection", name: "Spellbook Selection", summary: "Gain spells as a level of a spellcasting class you already have.", guide: "prestige-classes#spellbook-selection"),
    ],
    selections: [
        (
            key: "loremaster/secret",
            name: "Secret",
            summary: "At 1st, 3rd, 5th, 7th and 9th level, a new Secret: an extra spell, a feat or talent without its prerequisites, or +2 to a save.",
            guide: "prestige-classes#secret",
            options: [
                (key: "loremaster/secret/cleric-spell", name: "Cleric Spell", summary: "Add a Cleric spell, of a level you can cast, to your spell list.", guide: "prestige-classes#cleric-spell"),
                (key: "loremaster/secret/combat-feat", name: "Combat Feat", summary: "Take any Fighter bonus feat, ignoring its prerequisites, class and level ones included.", guide: "prestige-classes#combat-feat"),
                (key: "loremaster/secret/druid-spell", name: "Druid Spell", summary: "Add a Druid spell to your spell list.", guide: "prestige-classes#druid-spell"),
                (key: "loremaster/secret/fortitude-secret", name: "Fortitude Secret", summary: "+2 to Fortitude saves.", guide: "prestige-classes#fortitude-secret"),
                (key: "loremaster/secret/reflex-secret", name: "Reflex Secret", summary: "+2 to Reflex saves.", guide: "prestige-classes#reflex-secret"),
                (key: "loremaster/secret/rogue-secret", name: "Rogue Secret", summary: "Take any rogue talent, Advanced Talents included, ignoring its prerequisites.", guide: "prestige-classes#rogue-secret"),
                (key: "loremaster/secret/will-secret", name: "Will Secret", summary: "+2 to Will saves.", guide: "prestige-classes#will-secret"),
                (key: "loremaster/secret/wizard-feat", name: "Wizard Feat", summary: "Take any Wizard bonus feat ignoring its prerequisites, except Metamagic (Perfectly Ordinary Spell).", guide: "prestige-classes#wizard-feat"),
                (key: "loremaster/secret/wizard-spell", name: "Wizard Spell", summary: "Add a Wizard spell to your spell list.", guide: "prestige-classes#wizard-spell"),
            ],
        ),
    ],
    levels: [
        (level: 1, advances_arcane: true, advances_divine: true, features: ["loremaster/spellbook-selection"], selections: ["loremaster/secret"]),
        (level: 2, advances_arcane: true, advances_divine: true, features: ["loremaster/lore"]),
        (level: 3, advances_arcane: true, advances_divine: true, selections: ["loremaster/secret"]),
        (level: 4, advances_arcane: true, advances_divine: true),
        (level: 5, advances_arcane: true, advances_divine: true, selections: ["loremaster/secret"]),
        (level: 6, advances_arcane: true, advances_divine: true, features: ["loremaster/greater-lore"]),
        (level: 7, advances_arcane: true, advances_divine: true, selections: ["loremaster/secret"]),
        (level: 8, advances_arcane: true, advances_divine: true),
        (level: 9, advances_arcane: true, advances_divine: true, selections: ["loremaster/secret"]),
        (level: 10, advances_arcane: true, advances_divine: true),
    ],
)
