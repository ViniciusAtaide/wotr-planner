Class(
    key: "loremaster",
    blueprint: "4a7c05adfbaf05446a6bf664d28fb103",
    name: "Loremaster",
    summary: "Ten-level scholar caster with half BAB, full caster progression and 4 HP per level: five Secrets (spells, feats, talents, saves) and Knowledge bonuses.",
    guide: "prestige-classes#loremaster",
    skill_points: 3,
    bab: Half,
    fort: Poor,
    reflex: Poor,
    will: Good,
    save_exceptions: [(level: 4, save: Will, value: 3)],
    class_skills: ["knowledge-arcana", "knowledge-world", "lore-nature", "lore-religion", "persuasion", "use-magic-device"],
    prerequisite: All([Any([FeatFor(feat: "skill-focus", value: Skill("knowledge-arcana")), FeatFor(feat: "skill-focus", value: Skill("knowledge-world"))]), Any([SpellLevel(spell_type: Arcane, level: 3), SpellLevel(spell_type: Divine, level: 3)]), Any([Feat("metamagic-bolster-spell"), Feat("metamagic-completely-normal-spell"), Feat("metamagic-empower-spell"), Feat("metamagic-extend-spell"), Feat("metamagic-heighten-spell"), Feat("metamagic-intensified-spell"), Feat("metamagic-maximise-spell"), Feat("metamagic-persistent-spell"), Feat("metamagic-piercing-spell"), Feat("metamagic-quicken-spell"), Feat("metamagic-reach-spell"), Feat("metamagic-selective-spell")]), CharacterLevel(6)]),
    advances: Either,
    features: [
        (key: "loremaster/greater-lore", blueprint: "d9961b36abaf72d48b154a07e631aac3", name: "Greater Lore", summary: "+10 to Knowledge (Arcana) checks to identify magic items.", guide: "prestige-classes#greater-lore"),
        (key: "loremaster/lore", blueprint: "d0647dc19e74bd543b5069d0e0ab0527", name: "Lore", summary: "Knowledge and Lore checks gain half your class level.", guide: "prestige-classes#lore"),
        (key: "loremaster/spellbook-selection", blueprint: "7a28ab4dfc010834eabc770152997e87", name: "Spellbook Selection", summary: "Gain spells as a level of a spellcasting class you already have.", guide: "prestige-classes#spellbook-selection"),
    ],
    selections: [
        (
            key: "loremaster/secret",
            blueprint: "beeb25d7a7732e14f9986cdb79acecfc",
            name: "Secret",
            summary: "At 1st, 3rd, 5th, 7th and 9th level, a new Secret: an extra spell, a feat or talent without its prerequisites, or +2 to a save.",
            guide: "prestige-classes#secret",
            options: [
                (key: "loremaster/secret/cleric-spell", blueprint: "904ce918c85c9f947910340b956fb877", name: "Cleric Spell", summary: "One Cleric spell joins your spell list; it must be of a level you can already cast.", guide: "prestige-classes#cleric-spell"),
                (key: "loremaster/secret/combat-feat", blueprint: "90f105c8e31a6224ea319e6a810e4af8", name: "Combat Feat", summary: "A free Fighter bonus feat with every prerequisite waived, even fighter-level ones like Weapon Specialization.", guide: "prestige-classes#combat-feat"),
                (key: "loremaster/secret/druid-spell", blueprint: "6b73ba9d8a718fb419a484c6e1b92c6d", name: "Druid Spell", summary: "One Druid spell joins your spell list.", guide: "prestige-classes#druid-spell"),
                (key: "loremaster/secret/fortitude-secret", blueprint: "fae56e4e48847bf4b9d7152531777631", name: "Fortitude Secret", summary: "+2 to Fortitude saves.", guide: "prestige-classes#fortitude-secret"),
                (key: "loremaster/secret/reflex-secret", blueprint: "71aeb0210038d3642aa77e457346d41b", name: "Reflex Secret", summary: "+2 to Reflex saves.", guide: "prestige-classes#reflex-secret"),
                (key: "loremaster/secret/rogue-secret", blueprint: "4b7018b1ed4b27140a5e7adfacaaf9c6", name: "Rogue Secret", summary: "A rogue talent of your choice, Advanced Talents too, with its prerequisites waived.", guide: "prestige-classes#rogue-secret"),
                (key: "loremaster/secret/will-secret", blueprint: "96912c402154b5d438c2438f2ddaca2b", name: "Will Secret", summary: "+2 to Will saves.", guide: "prestige-classes#will-secret"),
                (key: "loremaster/secret/wizard-feat", blueprint: "689959eef3e972e458b52598dcc2c752", name: "Wizard Feat", summary: "A Wizard bonus feat with prerequisites waived; Metamagic (Perfectly Ordinary Spell) isn't offered.", guide: "prestige-classes#wizard-feat"),
                (key: "loremaster/secret/wizard-spell", blueprint: "f97986f19a595e2409cfe5d92bcf697c", name: "Wizard Spell", summary: "One Wizard spell joins your spell list.", guide: "prestige-classes#wizard-spell"),
            ],
        ),
    ],
    levels: [
        (level: 1, advances_arcane: true, advances_divine: true, features: ["loremaster/spellbook-selection"], selections: ["loremaster/secret"]),
        (level: 2, advances_arcane: true, advances_divine: true, features: ["loremaster/lore"]),
        (level: 3, advances_arcane: true, advances_divine: true, selections: ["loremaster/secret"]),
        (level: 4, advances_arcane: true, advances_divine: true),
        (level: 5, advances_arcane: true, advances_divine: true, selections: ["loremaster/secret"]),
        (level: 6, advances_arcane: true, advances_divine: true, features: ["loremaster/greater-lore"]),
        (level: 7, advances_arcane: true, advances_divine: true, selections: ["loremaster/secret"]),
        (level: 8, advances_arcane: true, advances_divine: true),
        (level: 9, advances_arcane: true, advances_divine: true, selections: ["loremaster/secret"]),
        (level: 10, advances_arcane: true, advances_divine: true),
    ],
)
