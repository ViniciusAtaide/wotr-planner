                (key: "barbarian/rage-power/increased-damage-reduction", name: "Increased Damage Reduction", guide: "barbarian#increased-damage-reduction", repeat: Times(3), prerequisite: ClassLevel(class: "barbarian", level: 8)),
                (key: "barbarian/rage-power/inspire-ferocity", name: "Inspire Ferocity", guide: "barbarian#inspire-ferocity", prerequisite: SelectionOption("barbarian/rage-power/reckless-stance")),
                (key: "barbarian/rage-power/internal-fortitude", name: "Internal Fortitude", guide: "barbarian#internal-fortitude", prerequisite: ClassLevel(class: "barbarian", level: 8)),
