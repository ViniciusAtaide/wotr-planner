Class(
    key: "class:barbarian",
    name: "Barbarian",
    guide: "barbarian",
    skill_points: 3,
    class_skills: ["skill:athletics", "skill:lore-nature", "skill:mobility", "skill:perception", "skill:persuasion"],
    prerequisite: Any([Alignment(NeutralGood), Alignment(ChaoticGood), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
    features: [
        (key: "feature:barbarian/barbarian-proficiencies", name: "Barbarian Proficiencies", guide: "barbarian#barbarian-proficiencies"),
        (key: "feature:barbarian/damage-reduction", name: "Damage Reduction", guide: "barbarian#damage-reduction"),
        (key: "feature:barbarian/danger-sense", name: "Danger Sense", guide: "barbarian#danger-sense"),
        (key: "feature:barbarian/fast-movement", name: "Fast Movement", guide: "barbarian#fast-movement"),
        (key: "feature:barbarian/greater-rage", name: "Greater Rage", guide: "barbarian#greater-rage"),
        (key: "feature:barbarian/improved-uncanny-dodge", name: "Improved Uncanny Dodge", guide: "barbarian#improved-uncanny-dodge"),
        (key: "feature:barbarian/indomitable-will", name: "Indomitable Will", guide: "barbarian#indomitable-will"),
        (key: "feature:barbarian/mighty-rage", name: "Mighty Rage", guide: "barbarian#mighty-rage"),
        (key: "feature:barbarian/rage", name: "Rage", guide: "barbarian#rage"),
        (key: "feature:barbarian/tireless-rage", name: "Tireless Rage", guide: "barbarian#tireless-rage"),
        (key: "feature:barbarian/uncanny-dodge", name: "Uncanny Dodge", guide: "barbarian#uncanny-dodge"),
    ],
