                (key: "barbarian/rage-power/crippling-blows", name: "Crippling Blows", guide: "barbarian#crippling-blows", prerequisite: All([ClassLevel(class: "barbarian", level: 8), SelectionOption("barbarian/rage-power/powerful-stance")])),
                (key: "barbarian/rage-power/daemon-totem", name: "Daemon Totem", guide: "barbarian#daemon-totem"),
                (key: "barbarian/rage-power/daemon-totem-greater", name: "Daemon Totem, Greater", guide: "barbarian#daemon-totem-greater"),
                (key: "barbarian/rage-power/daemon-totem-lesser", name: "Daemon Totem, Lesser", guide: "barbarian#daemon-totem-lesser"),
                (key: "barbarian/rage-power/deadly-accuracy", name: "Deadly Accuracy", guide: "barbarian#deadly-accuracy", prerequisite: All([ClassLevel(class: "barbarian", level: 4), SelectionOption("barbarian/rage-power/lethal-stance")])),
                (key: "barbarian/rage-power/fearless-rage", name: "Fearless Rage", guide: "barbarian#fearless-rage", prerequisite: ClassLevel(class: "barbarian", level: 12)),
                (key: "barbarian/rage-power/fiend-totem", name: "Fiend Totem", guide: "barbarian#fiend-totem"),
                (key: "barbarian/rage-power/fiend-totem-greater", name: "Fiend Totem, Greater", guide: "barbarian#fiend-totem-greater"),
