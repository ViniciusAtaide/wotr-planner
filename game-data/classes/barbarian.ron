                (key: "barbarian/rage-power/beast-totem-greater", name: "Beast Totem, Greater", guide: "barbarian#beast-totem-greater", prerequisite: All([ClassLevel(class: "barbarian", level: 10), SelectionOption("barbarian/rage-power/beast-totem")])),
                (key: "barbarian/rage-power/beast-totem-lesser", name: "Beast Totem, Lesser", guide: "barbarian#beast-totem-lesser"),
