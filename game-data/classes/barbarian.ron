Class(
    key: "barbarian",
    name: "Barbarian",
    guide: "barbarian",
    skill_points: 3,
    bab: Full,
    fort: Good,
    reflex: Poor,
    will: Poor,
    class_skills: ["athletics", "lore-nature", "mobility", "perception", "persuasion"],
    prerequisite: Any([Alignment(NeutralGood), Alignment(ChaoticGood), Alignment(TrueNeutral), Alignment(ChaoticNeutral), Alignment(NeutralEvil), Alignment(ChaoticEvil)]),
    features: [
        (key: "barbarian/damage-reduction", name: "Damage Reduction", guide: "barbarian#damage-reduction"),
        (key: "barbarian/danger-sense", name: "Danger Sense", guide: "barbarian#danger-sense"),
        (key: "barbarian/fast-movement", name: "Fast Movement", guide: "barbarian#fast-movement"),
        (key: "barbarian/greater-rage", name: "Greater Rage", guide: "barbarian#greater-rage"),
        (key: "barbarian/improved-uncanny-dodge", name: "Improved Uncanny Dodge", guide: "barbarian#improved-uncanny-dodge"),
        (key: "barbarian/indomitable-will", name: "Indomitable Will", guide: "barbarian#indomitable-will"),
        (key: "barbarian/mighty-rage", name: "Mighty Rage", guide: "barbarian#mighty-rage"),
        (key: "barbarian/rage", name: "Rage", guide: "barbarian#rage"),
        (key: "barbarian/tireless-rage", name: "Tireless Rage", guide: "barbarian#tireless-rage"),
        (key: "barbarian/uncanny-dodge", name: "Uncanny Dodge", guide: "barbarian#uncanny-dodge"),
    ],
    selections: [
