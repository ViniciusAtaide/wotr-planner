                (key: "barbarian/rage-power/lethal-stance", name: "Lethal Stance", guide: "barbarian#lethal-stance"),
                (key: "barbarian/rage-power/powerful-stance", name: "Powerful Stance", guide: "barbarian#powerful-stance"),
                (key: "barbarian/rage-power/protect-vitals", name: "Protect Vitals", guide: "barbarian#protect-vitals", prerequisite: All([ClassLevel(class: "barbarian", level: 8), SelectionOption("barbarian/rage-power/guarded-stance")])),
                (key: "barbarian/rage-power/reckless-stance", name: "Reckless Stance", guide: "barbarian#reckless-stance"),
