Class(
    key: "duelist",
    name: "Duelist",
    guide: "prestige-classes#duelist",
    skill_points: 3,
    class_skills: ["mobility", "perception", "persuasion"],
    prerequisite: All([Feat("combat-mobility"), Feat("weapon-finesse"), SkillRanks(skill: "mobility", ranks: 2), BaseAttackBonus(6), CharacterLevel(7)]),
    features: [
        (key: "duelist/acrobatic-movement", name: "Acrobatic Movement", guide: "prestige-classes#acrobatic-movement"),
        (key: "duelist/canny-defense", name: "Canny Defense", guide: "prestige-classes#canny-defense"),
        (key: "duelist/crippling-critical", name: "Crippling Critical", guide: "prestige-classes#crippling-critical"),
        (key: "duelist/deflect-arrows", name: "Deflect Arrows", guide: "prestige-classes#deflect-arrows"),
        (key: "duelist/elaborate-defense", name: "Elaborate Defense", guide: "prestige-classes#elaborate-defense"),
        (key: "duelist/enhanced-mobility", name: "Enhanced Mobility", guide: "prestige-classes#enhanced-mobility"),
        (key: "duelist/grace", name: "Grace", guide: "prestige-classes#grace"),
        (key: "duelist/improved-reaction", name: "Improved Reaction", guide: "prestige-classes#improved-reaction"),
        (key: "duelist/no-retreat", name: "No Retreat", guide: "prestige-classes#no-retreat"),
        (key: "duelist/parry", name: "Parry", guide: "prestige-classes#parry"),
        (key: "duelist/precise-strike", name: "Precise Strike", guide: "prestige-classes#precise-strike"),
        (key: "duelist/riposte", name: "Riposte", guide: "prestige-classes#riposte"),
    ],
    levels: [
        (level: 1, bab: 1, fort: 0, reflex: 1, will: 0, features: ["duelist/canny-defense", "duelist/precise-strike"]),
        (level: 2, bab: 2, fort: 1, reflex: 1, will: 1, features: ["duelist/improved-reaction", "duelist/parry"]),
        (level: 3, bab: 3, fort: 1, reflex: 2, will: 1, features: ["duelist/enhanced-mobility"]),
        (level: 4, bab: 4, fort: 1, reflex: 2, will: 1, features: ["duelist/grace"], feat_slots: [OneOf(feats: ["combat-reflexes"], ignores_prerequisites: true)]),
        (level: 5, bab: 5, fort: 2, reflex: 3, will: 2, features: ["duelist/riposte"]),
        (level: 6, bab: 6, fort: 2, reflex: 3, will: 2, features: ["duelist/acrobatic-movement"]),
        (level: 7, bab: 7, fort: 2, reflex: 4, will: 2, features: ["duelist/elaborate-defense"]),
        (level: 8, bab: 8, fort: 3, reflex: 4, will: 3),
        (level: 9, bab: 9, fort: 3, reflex: 5, will: 3, features: ["duelist/deflect-arrows", "duelist/no-retreat"]),
        (level: 10, bab: 10, fort: 3, reflex: 5, will: 3, features: ["duelist/crippling-critical"]),
    ],
)
