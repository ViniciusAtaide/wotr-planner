    prerequisite: All([Any([Alignment(LawfulGood), Alignment(LawfulNeutral), Alignment(LawfulEvil)]), Feat("feat:armor-proficiency-heavy-armor"), SkillRanks(skill: "skill:knowledge-arcana", ranks: 2), SkillRanks(skill: "skill:persuasion", ranks: 5), BaseAttackBonus(5), CharacterLevel(6)]),
