        (level: 3, bab: 3, fort: 2, reflex: 1, will: 1, features: ["feature:hellknight/force-of-will"], selections: ["selection:hellknight/disciplines"]),
        (level: 4, bab: 4, fort: 2, reflex: 1, will: 1),
