                (key: "selection:hellknight/disciplines/fearsomeness", name: "Fearsomeness", guide: "prestige-classes#fearsomeness"),
                (key: "selection:hellknight/disciplines/onslaught", name: "Onslaught", guide: "prestige-classes#onslaught"),
                (key: "selection:hellknight/disciplines/pentamic-faith", name: "Pentamic Faith", guide: "prestige-classes#pentamic-faith", prerequisite: SelectionOption("selection:fighter/armiger/order/order-of-the-godclaw")),
                (key: "selection:hellknight/disciplines/shackle", name: "Shackle", guide: "prestige-classes#shackle"),
