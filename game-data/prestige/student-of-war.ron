                (key: "student-of-war/know-your-enemy/martial-stance", name: "Martial Stance", guide: "prestige-classes#martial-stance"),
                (key: "student-of-war/know-your-enemy/tactical-stance", name: "Tactical Stance", guide: "prestige-classes#tactical-stance"),
            ],
        ),
    ],
    levels: [
        (level: 1, bab: 1, fort: 0, reflex: 0, will: 1, features: ["student-of-war/additional-class-skill"], selections: ["student-of-war/know-your-enemy"]),
        (level: 2, bab: 2, fort: 1, reflex: 1, will: 1, features: ["student-of-war/mind-over-metal"], feat_slots: [CombatFeat]),
        (level: 3, bab: 3, fort: 1, reflex: 1, will: 2, features: ["student-of-war/additional-class-skill", "student-of-war/anticipate"]),
