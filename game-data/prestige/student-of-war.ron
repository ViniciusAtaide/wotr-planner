        (level: 8, bab: 8, fort: 3, reflex: 3, will: 4, feat_slots: [CombatFeat]),
        (level: 9, bab: 9, fort: 3, reflex: 3, will: 5, features: ["student-of-war/additional-class-skill", "student-of-war/nemesis"]),
