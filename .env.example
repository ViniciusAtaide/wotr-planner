# Copy to .env (optional). Read by the server at startup.

# The game data folder the server and the MCP server read (default: libs/game-data/).
# GAME_DATA_DIR=libs/seeds/tests/fixtures/game-data

# The port the MCP server (apps/mcp) serves streamable HTTP on, at http://localhost:<port>/mcp, loopback only.
# The app's server always serves it, on 3902 when this is unset; `wotr-mcp` serves HTTP only when this is set, and
# stdio otherwise. .mcp.json connects to 3902.
# WOTR_MCP_PORT=3902
