# Copy to .env. Read by the server at startup and by sqlx's query macros at compile time.
DATABASE_URL=postgres://wotr:wotr@localhost:5434/wotr_planner

# Uncomment to build against the checked-in data/.sqlx metadata instead of a live database.
# SQLX_OFFLINE=true

# The game data folder the seed reads and the server's stale-data check compares against
# (default: game-data/ at the repo root).
# GAME_DATA_DIR=data/tests/fixtures/game-data
