# Copy to .env. Read by the seed and the server at startup, and by sqlx's query macros at compile time.
# The game data database: one SQLite file, relative to the repo root (git-ignored). Without DATABASE_URL the seed
# and the server use this same file, and the query macros the checked-in libs/seeds/.sqlx metadata.
DATABASE_URL=sqlite://wotr-planner.db

# Uncomment to build against the checked-in libs/seeds/.sqlx metadata instead of the database file.
# SQLX_OFFLINE=true

# The game data folder the seed reads and the server's stale-data check compares against
# (default: libs/game-data/).
# GAME_DATA_DIR=libs/seeds/tests/fixtures/game-data

# The port the MCP server (apps/mcp) serves streamable HTTP on, at http://localhost:<port>/mcp, loopback only.
# The app's server always serves it, on 3902 when this is unset; `wotr-mcp` serves HTTP only when this is set, and
# stdio otherwise. .mcp.json connects to 3902.
# WOTR_MCP_PORT=3902
