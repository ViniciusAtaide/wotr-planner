// Hand-written test fixture: small and simplified, not checked against the guide.
[
    (
        key: "human",
        name: "Human",
        summary: "Versatile; +2 to one ability and a bonus feat.",
        guide: "character-creation#human",
        ability_modifiers: [Chosen(amount: 2)],
        feat_slots: [General],
    ),
    (
        key: "elf",
        name: "Elf",
        guide: "character-creation#elf",
        ability_modifiers: [
            Fixed(ability: Dexterity, amount: 2),
            Fixed(ability: Intelligence, amount: 2),
            Fixed(ability: Constitution, amount: -2),
        ],
        subraces: [
            (
                key: "elf/blightborn",
                name: "Blightborn",
                guide: "character-creation#elf-blightborn",
                ability_modifiers: [
                    Fixed(ability: Dexterity, amount: 2),
                    Fixed(ability: Wisdom, amount: 2),
                    Fixed(ability: Constitution, amount: -2),
                ],
            ),
        ],
    ),
    (
        // Ticket 32: a race's own one-feat list (Adaptability: Skill Focus as a bonus feat at 1).
        key: "half-elf",
        name: "Half-Elf",
        guide: "character-creation#half-elf",
        ability_modifiers: [Chosen(amount: 2)],
        feat_slots: [OneOf(list: "half-elf/adaptability")],
        feat_lists: [
            (key: "half-elf/adaptability", name: "Adaptability", guide: "character-creation#half-elf", ignores_prerequisites: true, feats: ["skill-focus"]),
        ],
        // Ticket 35: a subrace's slots replace the race's. Dual Heritage has none; an invented one names the race's
        // list.
        subraces: [
            (key: "half-elf/dual-heritage", name: "Half-Elf (Dual Heritage)", guide: "character-creation#half-elf-dual-heritage", ability_modifiers: [Chosen(amount: 2)]),
            (
                key: "half-elf/adaptable",
                name: "Half-Elf (Adaptable)",
                guide: "character-creation#half-elf",
                ability_modifiers: [Chosen(amount: 2)],
                feat_slots: [OneOf(list: "half-elf/adaptability")],
            ),
        ],
    ),
    (
        key: "dwarf",
        name: "Dwarf",
        guide: "character-creation#dwarf",
        ability_modifiers: [
            Fixed(ability: Constitution, amount: 2),
            Fixed(ability: Wisdom, amount: 2),
            Fixed(ability: Charisma, amount: -2),
        ],
    ),
]
