// Hand-written test fixture: small and simplified, not checked against the guide.
[
    (
        key: "power-attack",
        name: "Power Attack",
        category: Weapon,
        summary: "Trade attack bonus for damage.",
        guide: "feats#power-attack",
        prerequisite: AbilityScore(ability: Strength, score: 13),
    ),
    (
        key: "combat-expertise",
        name: "Combat Expertise",
        category: CombatManoeuvres,
        guide: "feats#combat-expertise",
        prerequisite: AbilityScore(ability: Intelligence, score: 13),
    ),
    (
        key: "two-weapon-fighting",
        name: "Two-Weapon Fighting",
        category: Weapon,
        guide: "feats#two-weapon-fighting",
        prerequisite: AbilityScore(ability: Dexterity, score: 15),
    ),
    (
        key: "improved-two-weapon-fighting",
        name: "Improved Two-Weapon Fighting",
        category: Weapon,
        guide: "feats#improved-two-weapon-fighting",
        prerequisite: All([
            AbilityScore(ability: Dexterity, score: 17),
            Feat("two-weapon-fighting"),
            BaseAttackBonus(6),
        ]),
    ),
    (
        key: "cornugon-smash",
        name: "Cornugon Smash",
        category: Weapon,
        guide: "feats#cornugon-smash",
        prerequisite: All([
            Feat("power-attack"),
            SkillRanks(skill: "persuasion", ranks: 6),
        ]),
    ),
    (
        // "Combat Expertise or Kinetic Warrior + Intelligence 13", read as A or (B and C).
        key: "dirty-trick",
        name: "Dirty Trick",
        category: CombatManoeuvres,
        guide: "feats#dirty-trick",
        prerequisite: Any([
            Feat("combat-expertise"),
            All([
                Feature(feature: "rogue/sneak-attack", count: 1),
                AbilityScore(ability: Intelligence, score: 13),
            ]),
        ]),
    ),
    (
        // "Two of: ..." plus a class level, with a nested choice.
        key: "critical-mastery",
        name: "Critical Mastery",
        category: Weapon,
        guide: "feats#critical-mastery",
        prerequisite: All([
            AtLeast(2, [
                Feat("power-attack"),
                Feat("dirty-trick"),
                Any([
                    Feat("cornugon-smash"),
                    ClassLevel(class: "rogue", level: 3),
                ]),
            ]),
            ClassLevel(class: "fighter", level: 2),
        ]),
    ),
    (
        key: "breadth-of-experience",
        name: "Breadth of Experience",
        category: Skill,
        guide: "feats#breadth-of-experience",
        prerequisite: All([
            Any([Race("elf"), Race("dwarf")]),
            CharacterLevel(2),
        ]),
    ),
    (
        key: "arcane-strike",
        name: "Arcane Strike",
        category: Magic,
        guide: "feats#arcane-strike",
        prerequisite: SpellLevel(spell_type: Arcane, level: 1),
    ),
    (
        key: "outflank",
        name: "Outflank",
        category: Teamwork,
        guide: "feats#outflank",
        prerequisite: All([BaseAttackBonus(4), CasterLevel(1), Alignment(LawfulGood)]),
    ),
    (
        key: "armiger-drill",
        name: "Armiger Drill",
        category: Class,
        guide: "feats#armiger-drill",
        prerequisite: Archetype("fighter/armiger"),
    ),
    (
        key: "toughness",
        name: "Toughness",
        category: Miscellaneous,
        guide: "feats#toughness",
    ),
    (
        key: "dodge",
        name: "Dodge",
        category: Miscellaneous,
        guide: "feats#dodge",
        prerequisite: AbilityScore(ability: Dexterity, score: 13),
    ),
    (
        // Simplified: the game's Crane Style also needs Improved Unarmed Strike.
        key: "crane-style",
        name: "Crane Style",
        category: UnarmedCombat,
        guide: "feats#crane-style",
        prerequisite: Feat("dodge"),
    ),
    (
        key: "crane-wing",
        name: "Crane Wing",
        category: UnarmedCombat,
        guide: "feats#crane-wing",
        prerequisite: All([Feat("crane-style"), Feat("dodge")]),
    ),
]
