// Hand-written test fixture: small and simplified, not checked against the guide.
Class(
    key: "monk",
    name: "Monk",
    summary: "Unarmed martial class whose bonus feats come from its own list.",
    guide: "monk",
    skill_points: 4,
    bab: ThreeQuarters,
    fort: Good,
    reflex: Good,
    will: Good,
    class_skills: ["mobility", "athletics"],
    levels: [
        // A bonus-list slot: Crane Style is on the monk's list, so a monk can take it without Dodge.
        (level: 1, feat_slots: [OneOf(feats: ["crane-style", "dodge"], ignores_prerequisites: true)]),
        (level: 2, feat_slots: [OneOf(feats: ["crane-style", "dodge"], ignores_prerequisites: true)]),
        (level: 3),
    ],
)
